{"translation": "\u300c\u5f7c\u306f\u305d\u3053\u304b\u3089\u51fa\u3066\u3053\u306a\u3044\u3063\u3066\u3001\u8a00\u3063\u3066\u308b\u3093\u3060\u3002\u300d\u3068\u30cb\u30ad\u30d3\u9854\u304c\u81ea\u4fe1\u6e80\u3005\u306b\u9837\u3044\u305f\u3002"}
{"translation": "\u65e2\u306b1\u6642\u959315\u5206\u3082\u3001\u5f7c\u304c\u305d\u3053\u306b\u5165\u3063\u305f\u3002"}
{"translation": "\u3082\u3046\u5f7c\u306e\u3053\u3068\u306f\u7d42\u308f\u3063\u305f\u3002"}
{"translation": "\u5e02\u6c11\u305f\u3061\u306f\u3001\u304c\u308c\u304d\u306e\u4e2d\u306b\u8a70\u307e\u308a\u3001\u9ed2\u304f\u958b\u3044\u305f\u7a74\u3001\u5730\u4e0b\u5ba4\u3078\u306e\u5165\u308a\u53e3\u306b\u74e6\u792b\u304c\u7a4d\u3082\u3063\u305f\u907a\u8de1\u306b\u898b\u5165\u3063\u3066\u9ed9\u3063\u3066\u7acb\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u9ec4\u8272\u3044\u30b3\u30fc\u30c8\u3092\u7740\u305f\u592a\u3063\u305f\u7537\u304c\u4e00\u6b69\u8e0f\u307f\u51fa\u3057\u3001\u3080\u305b\u3073\u7b11\u3044\u3001\u304f\u305f\u3073\u308c\u305f\u30d9\u30ec\u30fc\u5e3d\u3092\u982d\u304b\u3089\u53d6\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u3082\u3046\u5c11\u3057\u5f85\u3064\u3093\u3060\u300d\u3068\u5f7c\u306f\u8a00\u3044\u306a\u304c\u3089\u3001\u307e\u3070\u3089\u306a\u7709\u304b\u3089\u6c57\u3092\u62ed\u3044\u305f\u3002"}
{"translation": "\u300c\u4f55\u306b\u3060\u3063\u3066\uff1f\u300d\u3068\u30cb\u30ad\u30d3\u9762\u304c\u3046\u3063\u3059\u3089\u3068\u7b11\u3063\u305f\u3002"}
{"translation": "\u300c\u305d\u3053\u3001\u5730\u4e0b\u7262\u306b\u306f\u30d0\u30b8\u30ea\u30b9\u30af\u304c\u3044\u308b\u3093\u3060\u3088\u3002"}
{"translation": "\u5fd8\u308c\u305f\u306e\u304b\u3044\u3001\u6751\u9577\uff1f\u300d \u305d\u3053\u306b\u5165\u308b\u8005\u306f\u3001\u3082\u3046\u623b\u308c\u306a\u3044\u3002"}
{"translation": "\u305d\u3053\u3067\u4f55\u4eba\u3082\u304c\u4ea1\u304f\u306a\u3063\u305f\u3093\u3060\u308d\u3046\uff1f \u3053\u3053\u3067\u4f55\u3092\u5f85\u3064\u3079\u304d\u306a\u306e\u304b\uff1f"}
{"translation": "\u300c\u3060\u3063\u3066\u7d04\u675f\u3057\u305f\u3058\u3083\u306a\u3044\u304b\u300d"}
{"translation": "\u592a\u3063\u305f\u7537\u304c\u4e0d\u78ba\u304b\u306b\u3064\u3076\u3084\u3044\u305f\u3002"}
{"translation": "\u3069\u3046\u3057\u3066\u305d\u3093\u306a\u3053\u3068\u306b\u306a\u308b\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u300c\u541b\u305f\u3061\u306f\u751f\u8005\u3068\u7d04\u675f\u3057\u305f\u306e\u3060\u3001\u6751\u9577\u304c\u305d\u3046\u8a00\u3063\u305f\u3002"}
{"translation": "\u306b\u304d\u3073\u9762\u306e\u540c\u5fd7\u3001\u30ec\u30b6\u30fc\u306e\u30a8\u30d7\u30ed\u30f3\u3092\u3064\u3051\u305f\u5de8\u4eba\u306f\u5c60\u6bba\u4eba\u3060\u3063\u305f\u3002"}
{"translation": "\u3067\u3082\u3001\u4eca\u3084\u5f7c\u306f\u6b7b\u3093\u3067\u3044\u308b\u3002"}
{"translation": "\u305d\u308c\u306f\u7a7a\u306e\u592a\u967d\u307b\u3069\u78ba\u304b\u3060\u3002"}
{"translation": "\u5f7c\u304c\u884c\u304f\u5148\u306f\u904b\u547d\u306e\u7834\u6ec5\u3067\u3042\u308b\u3053\u3068\u306f\u3001\u524d\u3082\u3063\u3066\u660e\u767d\u3060\u3063\u305f\u3002"}
{"translation": "\u307e\u3055\u306b\u3001\u5f7c\u4ee5\u524d\u306e\u4ed6\u306e\u4eba\u3005\u3068\u540c\u3058\u3088\u3046\u306b\u3002 \u305d\u308c\u306b\u5f7c\u306f\u93e1\u3055\u3048\u6301\u305f\u305a\u306b\u3001\u305f\u3060\u5263\u3060\u3051\u3092\u6301\u3063\u3066\u884c\u3063\u305f\u306e\u3060\u3002 \u305d\u3057\u3066\u8ab0\u3082\u304c\u77e5\u3063\u3066\u3044\u308b\u901a\u308a\u3001\u30d0\u30b8\u30ea\u30b9\u30af\u306e\u93e1\u3092\u4f7f\u308f\u305a\u306b\u306f\u5f7c\u3092\u5012\u3059\u3053\u3068\u306f\u3067\u304d\u306a\u3044\u3002"}
{"translation": "\u3069\u3046\u3057\u3066\u305d\u3093\u306a\u3053\u3068\u306b\u306a\u308b\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u300c\u304a\u91d1\u3092\u7bc0\u7d04\u3057\u305f\u306d\u3001\u305d\u3046\u8a00\u3063\u305f\u306e\u306f\u306b\u304d\u3073\u9762\u306e\u753a\u9577\u3060\u3002"}
{"translation": "\u30d0\u30b8\u30ea\u30b9\u30af\u306e\u4ee3\u91d1\u3092\u652f\u6255\u3046\u76f8\u624b\u306a\u3093\u3066\u3044\u306a\u3044\u3093\u3060\u304b\u3089\u3002"}
{"translation": "\u5b89\u5fc3\u3057\u3066\u3053\u306e\u9053\u3092\u901a\u308a\u3001\u5bb6\u306b\u5e30\u308a\u306a\u3055\u3044\u3002"}
{"translation": "\u305d\u3057\u3066\u3001\u79c1\u305f\u3061\u306f\u9b54\u6cd5\u4f7f\u3044\u306e\u99ac\u3068\u5bb6\u755c\u3092\u624b\u306b\u5165\u308c\u308b\u3001\u8ca1\u7523\u3092\u7121\u99c4\u306b\u3059\u308b\u306e\u306f\u60dc\u3057\u3044\u304b\u3089\u3060\u3002"}
{"translation": "\u300c\u305d\u3046\u3055\u300d\u3068\u8089\u5c4b\u304c\u8a00\u3063\u305f\u3002"}
{"translation": "\u5143\u6c17\u306a\u725d\u99ac\u3060\u3001\u305d\u3057\u3066\u30e6\u30ad\u3082\u3046\u307e\u304f\u8a70\u3081\u3089\u308c\u3066\u3044\u308b\u3002"}
{"translation": "\u4e2d\u8eab\u3092\u898b\u3066\u307f\u3088\u3046\u3002"}
{"translation": "\u4f55\u3092\u3057\u3066\u308b\u306e\uff1f"}
{"translation": "\u300c\u53e3\u3092\u3064\u3050\u3093\u3067\u3001\u5589\u5143\u306b\u624b\u3092\u5f53\u3066\u3001\u3058\u3083\u306a\u3044\u3068\u816b\u308c\u7269\u306b\u89e6\u308b\u624b\u51fa\u3057\u306f\u3067\u304d\u306a\u3044\u3088\u300d"}
{"translation": "\u30d6\u30c4\u30d6\u30c4\u9854\u306e\u7537\u304c\u8b66\u544a\u3057\u305f\u3002"}
{"translation": "\u300c\u80a5\u3048\u305f\u96cc\u99ac\u3060\u300d\u3068\u3001\u8089\u5c4b\u304c\u7e70\u308a\u8fd4\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u99ac\u3092\u9759\u304b\u306b\u3057\u3066\u304a\u3044\u3066\u306d\u3001\u30c0\u30fc\u30ea\u30f3\u3002"}
{"translation": "\u5c60\u6bba\u4eba\u306f\u3086\u3063\u304f\u308a\u3068\u672a\u77e5\u306e\u8a2a\u554f\u8005\u306b\u5411\u304d\u76f4\u3063\u305f\u3002"}
{"translation": "\u305d\u306e\u8a2a\u554f\u8005\u306f\u3001\u57ce\u58c1\u306e\u5965\u304b\u3089\u4eba\u3005\u306e\u80cc\u5f8c\u304b\u3089\u73fe\u308c\u3001\u5730\u4e0b\u7262\u306e\u5165\u53e3\u5468\u8fba\u306b\u96c6\u307e\u3063\u3066\u3044\u308b\u4eba\u3005\u304b\u3089\u7acb\u3061\u4e0a\u304c\u3063\u305f\u3002"}
{"translation": "\u305d\u306e\u898b\u77e5\u3089\u306c\u4eba\u306f\u3001\u3082\u3058\u3083\u3082\u3058\u3083\u3068\u3057\u305f\u6817\u8272\u306e\u9aea\u3001\u30d6\u30e9\u30a6\u30f3\u306e\u30c1\u30e5\u30cb\u30c3\u30af\u3092\u7dbf\u5165\u308a\u306e\u30ab\u30d5\u30bf\u30f3\u306b\u91cd\u306d\u3066\u7740\u3066\u304a\u308a\u3001\u9ad8\u304f\u99ac\u4e57\u308a\u7528\u306e\u30d6\u30fc\u30c4\u3092\u5c65\u3044\u3066\u3044\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u3001\u4e00\u5207\u306e\u6b66\u5668\u7121\u3057\u3002"}
{"translation": "\u300c\u99ac\u304b\u3089\u96e2\u308c\u308d\u300d\u3068\u5f7c\u306f\u518d\u3073\u8a00\u3044\u3001\u9670\u6e7f\u306a\u7b11\u307f\u3092\u6d6e\u304b\u3079\u305f\u3002"}
{"translation": "\u3069\u3046\u3044\u3046\u3053\u3068\u3060\uff1f \u4ed6\u4eba\u306e\u99ac\u3001\u4ed6\u4eba\u306e\u30e6\u30ab\u3001\u4ed6\u4eba\u306e\u8ca1\u7523\u306b\u3042\u306a\u305f\u306f\u90aa\u60aa\u306a\u76ee\u3092\u5411\u3051\u3001\u3060\u3089\u3057\u306a\u3044\u624b\u3092\u4f38\u3070\u3059\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u305d\u308c\u3067\u3044\u3044\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u306b\u304d\u3073\u3060\u3089\u3051\u306e\u5f7c\u306f\u3001\u3086\u3063\u304f\u308a\u3068\u624b\u3092\u30b3\u30fc\u30c8\u306e\u8107\u4e0b\u306b\u6ed1\u3089\u305b\u3066\u3001\u8089\u5c4b\u3092\u898b\u3064\u3081\u305f\u3002"}
{"translation": "\u8089\u5c4b\u306f\u9837\u304d\u3001\u3055\u3089\u306b\u4e8c\u4eba\u306e\u304c\u3063\u3057\u308a\u3068\u3057\u305f\u77ed\u9aea\u306e\u7537\u305f\u3061\u304c\u3044\u308b\u96c6\u56e3\u306b\u5411\u304b\u3063\u3066\u624b\u3092\u632f\u3063\u305f\u3002"}
{"translation": "\u4e8c\u4eba\u3068\u3082\u4f55\u304b\u68d2\u3092\u6301\u3063\u3066\u3044\u3066\u3001\u305d\u308c\u306f\u8089\u5c4b\u3067\u52d5\u7269\u3092\u6c17\u7d76\u3055\u305b\u308b\u306e\u306b\u4f7f\u3046\u3088\u3046\u306a\u3082\u306e\u3060\u3063\u305f\u3002"}
{"translation": "\u300c\u4f55\u8005\u3060\u3001\u9854\u306b\u30cb\u30ad\u30d3\u306e\u51fa\u305f\u5974\u306f\u79c1\u305f\u3061\u306b\u6559\u3048\u308b\u6a29\u5229\u306a\u3069\u306a\u3044\u306e\u306b\u3001\u8107\u304b\u3089\u624b\u3092\u51fa\u3057\u3066\u3001\u4f55\u304c\u6b63\u3057\u3044\u304b\u4f55\u304c\u6b63\u3057\u304f\u306a\u3044\u304b\u3092\u6559\u3048\u3088\u3046\u3068\u306f\uff1f\u300d"}
{"translation": "\u305d\u308c\u306f\u3042\u306a\u305f\u306b\u306f\u95a2\u4fc2\u306a\u3044\u3001\u30c0\u30fc\u30ea\u30f3\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u6b66\u5668\u3092\u6301\u3063\u3066\u3044\u307e\u305b\u3093\u3002"}
{"translation": "\u305d\u308c\u306b\u5bfe\u3057\u3001\u898b\u77e5\u3089\u306c\u4eba\u306f\u3055\u3089\u306b\u967a\u3057\u3044\u5fae\u7b11\u3092\u898b\u305b\u305f\u3002"}
{"translation": "\u79c1\u306f\u6301\u3063\u3066\u3044\u306a\u3044\u3002"}
{"translation": "\u305d\u306e\u306b\u304d\u3073\u9854\u306e\u30ac\u30ad\u306f\u3001\u8107\u304b\u3089\u624b\u3092\u51fa\u3057\u3001\u9577\u3044\u30ca\u30a4\u30d5\u3082\u4e00\u7dd2\u306b\u73fe\u308c\u305f\u3002"}
{"translation": "\u305d\u308c\u3092\u6301\u305f\u306a\u3044\u306e\u306f\u3068\u3066\u3082\u60aa\u3044\u3067\u3059\u3002"}
{"translation": "\u8089\u5c4b\u3082\u307e\u305f\u3001\u5263\u306e\u3088\u3046\u306b\u9577\u3044\u5305\u4e01\u3092\u53d6\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u5411\u3053\u3046\u306e\u4e8c\u4eba\u304c\u524d\u306b\u9032\u307f\u51fa\u3066\u3001\u68d2\u3092\u6301\u3061\u4e0a\u3052\u305f\u3002"}
{"translation": "\u300c\u79c1\u304c\u904b\u3076\u5fc5\u8981\u306f\u306a\u3044\u300d\u3068\u898b\u77e5\u3089\u306c\u4eba\u306f\u8a00\u3063\u305f\u3001\u305d\u306e\u5834\u304b\u3089\u52d5\u304b\u306a\u3044\u3067\u3002"}
{"translation": "\u79c1\u306e\u9283\u304c\u79c1\u306e\u3042\u3068\u3092\u3064\u3051\u3066\u3044\u308b\u3002"}
{"translation": "\u5ec3\u589f\u304b\u3089\u3001\u67d4\u3089\u304b\u3067\u78ba\u304b\u306a\u8db3\u53d6\u308a\u3067\u3001\u4e8c\u4eba\u306e\u82e5\u3044\u5973\u6027\u304c\u73fe\u308c\u305f\u3002"}
{"translation": "\u3059\u3050\u306b\u7fa4\u8846\u304c\u6563\u308a\u3001\u5f8c\u9000\u3057\u3001\u8584\u307e\u3063\u305f\u3002"}
{"translation": "\u4e21\u65b9\u306e\u5973\u6027\u305f\u3061\u306f\u7b11\u9854\u3092\u6d6e\u304b\u3079\u3066\u3044\u3066\u3001\u30ad\u30e9\u30c3\u3068\u5149\u308b\u6b6f\u3001\u3064\u3076\u3089\u306a\u77b3\u3092\u7d30\u3081\u3001\u305d\u306e\u7aef\u304b\u3089\u8033\u306b\u5411\u304b\u3063\u3066\u5e83\u304c\u308b\u9752\u9ed2\u3044\u30bf\u30c8\u30a5\u30fc\u306e\u5e2f\u304c\u8d70\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u5f37\u976d\u306a\u592a\u3082\u3082\u306e\u7b4b\u8089\u306f\u3001\u30ea\u30f3\u30af\u30b9\u76ae\u3067\u4f5c\u3089\u308c\u305f\u8170\u5468\u308a\u304b\u3089\u8997\u3044\u3066\u304a\u308a\u3001\u305d\u3057\u3066\u3001\u9375\u7db2\u624b\u888b\u306e\u4e0a\u306b\u3042\u308b\u88f8\u3067\u4e38\u3044\u8155\u306b\u306f\u7b4b\u8089\u304c\u6d6e\u304b\u3073\u4e0a\u304c\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u80a9\u304b\u3089\u4e0a\u306b\u3082\u9396\u5e37\u5b50\u3067\u8986\u308f\u308c\u3001\u305d\u3053\u304b\u3089\u5200\u306e\u67c4\u304c\u7a81\u304d\u51fa\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u306b\u304d\u3073\u9854\u306f\u3086\u3063\u304f\u308a\u3068\u3001\u3068\u3066\u3082\u3086\u3063\u304f\u308a\u3068\u819d\u3092\u66f2\u3052\u3001\u5730\u9762\u306b\u30ca\u30a4\u30d5\u3092\u843d\u3068\u3057\u305f\u3002"}
{"translation": "\u304c\u308c\u304d\u306e\u4e2d\u306e\u7a74\u304b\u3089\u77f3\u306e\u30ac\u30bf\u30ac\u30bf\u3068\u3044\u3046\u97f3\u3001\u3056\u308f\u3081\u304d\u304c\u805e\u3053\u3048\u305f\u5f8c\u3001\u6697\u95c7\u304b\u3089\u50b7\u3093\u3060\u58c1\u7aef\u306b\u3057\u304c\u307f\u3064\u304f\u624b\u304c\u73fe\u308c\u305f\u3002"}
{"translation": "\u624b\u306e\u5f8c\u308d\u306b\u306f\u3001\u767d\u304f\u3066\u7149\u74e6\u306e\u7c89\u3092\u307e\u3076\u3057\u305f\u3088\u3046\u306a\u9aea\u306e\u982d\u3001\u9752\u3056\u3081\u305f\u9854\u3001\u80a9\u304b\u3089\u7a81\u304d\u51fa\u305f\u5263\u306e\u67c4\u304c\u6b21\u3005\u306b\u59ff\u3092\u73fe\u3057\u305f\u3002"}
{"translation": "\u7fa4\u8846\u304c\u3056\u308f\u3064\u3044\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u306f\u3001\u80cc\u4e2d\u3092\u4e38\u3081\u3001\u7a74\u304b\u3089\u5947\u5999\u306a\u5f62\u72b6\u3001\u7570\u5f62\u306e\u8089\u4f53\u3092\u53d6\u308a\u51fa\u3057\u3001\u305d\u308c\u306f\u8840\u3067\u67d3\u307f\u8fbc\u3093\u3060\u57c3\u3067\u3075\u304f\u3088\u304b\u3060\u3063\u305f\u3002"}
{"translation": "\u9577\u304f\u3066\u30c8\u30ab\u30b2\u306e\u3088\u3046\u306a\u5c3e\u3092\u6301\u3064\u602a\u7269\u3092\u63b4\u3093\u3067\u3001\u7121\u8a00\u3067\u592a\u3063\u305f\u6751\u9577\u306e\u8db3\u5143\u306b\u6295\u3052\u3064\u3051\u305f\u3002"}
{"translation": "\u6751\u9577\u306f\u5f8c\u305a\u3055\u308a\u3057\u3001\u5012\u308c\u305f\u58c1\u306e\u4e00\u90e8\u306b\u3064\u307e\u305a\u3044\u305f\u3002"}
{"translation": "\u66f2\u304c\u308a\u304f\u306d\u3063\u305f\u9ce5\u306e\u304f\u3061\u3070\u3057\u3001\u8584\u819c\u72b6\u306e\u7ffc\u3001\u9c57\u3067\u8986\u308f\u308c\u305f\u8db3\u306b\u3042\u308b\u938c\u5f62\u306e\u722a\u3092\u898b\u3064\u3081\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u304b\u3064\u3066\u306f\u9bae\u3084\u304b\u306a\u8d64\u8272\u3060\u3063\u305f\u304c\u3001\u73fe\u5728\u306f\u6c5a\u308c\u305f\u8d64\u8910\u8272\u306e\u81a8\u308c\u4e0a\u304c\u3063\u305f\u5589\u4ecf\u3002"}
{"translation": "\u785d\u5b50\u306e\u3088\u3046\u3067\u304f\u307c\u3093\u3060\u76ee\u306b\u3002"}
{"translation": "\u300c\u3053\u3061\u3089\u304c\u30d0\u30b8\u30ea\u30b9\u30af\u3060\u3088\u300d\u3068\u767d\u9aea\u306e\u7537\u304c\u8a00\u3044\u306a\u304c\u3089\u3001\u30ba\u30dc\u30f3\u306e\u57c3\u3092\u6255\u3063\u305f\u3002"}
{"translation": "\u5951\u7d04\u901a\u308a\u306b\u3002"}
{"translation": "\u3069\u3046\u304b\u79c1\u306e200\u30ea\u30f3\u30bf\u30fc\u30eb\u3092\u3002"}
{"translation": "\u6b63\u76f4\u306a\u30de\u30ea\u30f3\u8239\u54e1\u3001\u5f7c\u3089\u306f\u3042\u307e\u308a\u9154\u3063\u3066\u3044\u306a\u3044\u3002"}
{"translation": "\u78ba\u8a8d\u3059\u308b\u3088\u3001\u3068\u3044\u3046\u3053\u3068\u3092\u5148\u306b\u4f1d\u3048\u3066\u304a\u304f\u306d\u3002"}
{"translation": "\u6751\u9577\u306f\u9707\u3048\u308b\u624b\u3067\u888b\u3092\u53d6\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u304c\u3064\u304b\u306e\u9593\u8996\u7dda\u3092\u5468\u56f2\u306b\u79fb\u3057\u3001\u306b\u304d\u3073\u9762\u306e\u7537\u3068\u3001\u5f7c\u306e\u8db3\u5143\u306b\u843d\u3061\u3066\u3044\u308b\u30ca\u30a4\u30d5\u3092\u898b\u305f\u3002"}
{"translation": "\u5f7c\u306f\u8336\u8272\u306e\u30c1\u30e5\u30cb\u30c3\u30af\u3092\u7740\u305f\u7537\u3084\u3001\u30ea\u30b9\u306e\u76ae\u3092\u307e\u3068\u3063\u305f\u5973\u6027\u305f\u3061\u3092\u898b\u3064\u3081\u305f\u3002"}
{"translation": "\u300c\u3044\u3064\u3082\u306e\u901a\u308a\u3060\u306d\u300d\u3068\u5f7c\u306f\u8a00\u3063\u3066\u3001\u9707\u3048\u3066\u3044\u308b\u6751\u9577\u306e\u624b\u304b\u3089\u305f\u3070\u3053\u3092\u53d6\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u3042\u306a\u305f\u305f\u3061\u306e\u305f\u3081\u306b\u50c5\u304b\u306a\u5831\u916c\u3067\u547d\u3092\u304b\u3051\u3066\u3044\u308b\u9593\u306b\u3001\u3042\u306a\u305f\u305f\u3061\u306f\u79c1\u306e\u6301\u3061\u7269\u3092\u7269\u8272\u3057\u3066\u3044\u308b\u3093\u3060\u3002"}
{"translation": "\u3042\u306a\u305f\u305f\u3061\u306f\u3001\u4e00\u4f53\u4f55\u5ea6\u6012\u3089\u305b\u308c\u3070\u6c17\u304c\u6e08\u3080\u3093\u3060\u3002"}
{"translation": "\u5168\u7136\u5909\u308f\u308b\u6c17\u914d\u3092\u898b\u305b\u306a\u3044\u3002"}
{"translation": "\u300c\u624b\u3092\u51fa\u3059\u306a\u300d\u3068\u8089\u5c4b\u306f\u3064\u3076\u3084\u304d\u306a\u304c\u3089\u5f8c\u9000\u3057\u305f\u3002"}
{"translation": "\u68d2\u3092\u6301\u3063\u305f\u5f7c\u3089\u306f\u3068\u3063\u304f\u306b\u4eba\u3054\u307f\u306e\u4e2d\u306b\u6d88\u3048\u3066\u3057\u307e\u3063\u305f\u3002"}
{"translation": "\u3042\u306a\u305f\u306e\u8377\u7269\u306f\u4f55\u3082\u89e6\u3063\u3066\u3044\u307e\u305b\u3093\u3088\u3001\u65e6\u90a3\u69d8\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u306f\u3068\u3066\u3082\u6e80\u8db3\u3052\u306b\u7b11\u3063\u305f\u3002"}
{"translation": "\u305d\u306e\u7b11\u9854\u3092\u898b\u3066\u3001\u9752\u3056\u3081\u305f\u9854\u306b\u54b2\u304d\u8a87\u308b\u307e\u308b\u3067\u5272\u308c\u51fa\u3059\u50b7\u307f\u305f\u3044\u306a\u3082\u306e\u3092\u76ee\u306e\u5f53\u305f\u308a\u306b\u3057\u3001\u7fa4\u8846\u306f\u901f\u3084\u304b\u306b\u6563\u3063\u3066\u3044\u3063\u305f\u3002"}
{"translation": "\u3060\u304b\u3089\u3001\u304a\u5144\u3055\u3093\u3001\u3042\u306a\u305f\u3082\u52d5\u304b\u3055\u308c\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u5b89\u3089\u304b\u306b\u53bb\u308a\u306a\u3055\u3044\u3002"}
{"translation": "\u3067\u3082\u3001\u3059\u3050\u306b\u53bb\u3063\u3066\u304f\u3060\u3055\u3044\u3002"}
