{"translation": "\u305a\u3063\u3068\u305a\u3063\u3068\u5f8c\u306e\u3042\u308b\u65e5\u3001\u5f7c\u5973\u306e\u592b\u306f\u75c5\u9662\u304b\u3089\u623b\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u5f7c\u306f\u771f\u5263\u306a\u8868\u60c5\u3067\u3001\u300c\u6587\u5316\u5927\u9769\u547d\u300d\u306b\u3064\u3044\u3066\u8a9e\u3063\u305f\u3002"}
{"translation": "\u75c5\u9662\u3067\u306f\u6bce\u65e5\u4f1a\u8b70\u304c\u958b\u304b\u308c\u3001\u5f7c\u306b\u5bfe\u3059\u308b\u30d3\u30c3\u30b0\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30dd\u30b9\u30bf\u30fc\u3082\u66f8\u304b\u308c\u3001\u5f7c\u306e\u904e\u53bb\u304c\u554f\u984c\u8996\u3055\u308c\u3066\u3044\u308b\u3068\u8a71\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3068\u3066\u3082\u7dca\u5f35\u3057\u3066\u3044\u3066\u3001\u592b\u304c\u5f7c\u5973\u306b\u3053\u308c\u3089\u306e\u3053\u3068\u3092\u8a71\u3059\u610f\u5473\u304c\u4f55\u306a\u306e\u304b\u308f\u304b\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u5f7c\u5973\u306e\u592b\u306f\u7a81\u7136\u3001\u300c\u3042\u306a\u305f\u306b\u4f55\u3082\u8d77\u3053\u3089\u306a\u3044\u3088\u3002"}
{"translation": "\u79c1\u304c\u5b88\u308b\u304b\u3089\u300d\u3068\u8a00\u3063\u305f\u3002"}
{"translation": "\u3042\u306a\u305f\u306e\u904e\u53bb\u306e\u3053\u3068\u306f\u3001\u4e00\u751f\u601d\u3044\u51fa\u3055\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u3042\u306a\u305f\u306e\u6700\u5927\u306e\u6575\u306f\u3001\u5916\u90e8\u306e\u4eba\u3005\u3067\u306f\u306a\u304f\u3001\u6050\u3089\u304f\u306f\u3042\u306a\u305f\u304c\u5fd8\u308c\u3066\u3057\u307e\u3063\u305f\u7269\u4e8b\u3060\u308d\u3046\u3002"}
{"translation": "\u3082\u3057\u3060\u308c\u304b\u304c\u3042\u306a\u305f\u306b\u8cea\u554f\u3057\u3066\u3082\u3001\u4f55\u3082\u77e5\u3089\u306a\u3044\u3068\u8a00\u3048\u3070\u3044\u3044\u3002"}
{"translation": "\u305d\u3046\u3059\u308c\u3070\u5927\u4e08\u592b\u3060\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u3069\u3053\u306e\u51fa\u8eab\u3067\u3059\u304b\uff1f \u3069\u306e\u6751\u306b\u4f4f\u3093\u3067\u3044\u307e\u3059\u304b\uff1f \u3042\u306a\u305f\u306e\u5e74\u9f62\u306f\u3044\u304f\u3064\u3067\u3059\u304b\uff1f \u3042\u306a\u305f\u306e\u5bb6\u306b\u306f\u4ed6\u306b\u8ab0\u304c\u3044\u307e\u3059\u304b\uff1f \u3042\u306a\u305f\u306f\u3069\u3046\u3084\u3063\u3066\u5ddd\u306b\u843d\u3061\u8fbc\u3093\u3060\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u8239\u304c\u8ee2\u8986\u3057\u305f\u306e\u3067\u3059\u304b\u3001\u305d\u308c\u3068\u3082\u60aa\u8005\u306b\u843d\u3068\u3055\u308c\u305f\u306e\u3067\u3059\u304b\uff1f \u3042\u306a\u305f\u4e00\u4eba\u3060\u3051\u304c\u6c34\u306b\u843d\u3061\u305f\u306e\u3067\u3059\u304b\u3002"}
{"translation": "\u4eba\u3005\u304c\u4ea4\u4e92\u306b\u8cea\u554f\u3092\u6295\u3052\u304b\u3051\u3001\u305d\u308c\u304c\u7a4f\u3084\u304b\u306a\u58f0\u97f3\u3067\u3042\u3063\u3066\u3082\u3001\u305d\u308c\u306f\u307e\u308b\u3067\u4e00\u672c\u4e00\u672c\u306e\u92ed\u3044\u68d8\u304c\u523a\u3059\u3088\u3046\u306b\u5f7c\u5973\u306e\u5fc3\u306f\u77ac\u9593\u7684\u306b\u3068\u3066\u3064\u3082\u306a\u304f\u82e6\u3057\u3093\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306f\u30d9\u30c3\u30c9\u306e\u4e0a\u3067\u4e00\u584a\u306b\u4e38\u307e\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u601d\u3063\u305f\u3001\u300c\u305d\u3046\u3060\u3001\u79c1\u306f\u4e00\u4f53\u3069\u3053\u51fa\u8eab\u306a\u306e\uff1f\u300d \u79c1\u306f\u3069\u3053\u306b\u4f4f\u3093\u3067\u3044\u307e\u3059\u304b\uff1f"}
{"translation": "\u79c1\u306e\u540d\u524d\u306f\u4f55\u3067\u3059\u304b\uff1f \u3069\u3046\u3057\u3066\u79c1\u304c\u5ddd\u306b\u843d\u3061\u308b\u3053\u3068\u306b\u306a\u3063\u305f\u306e\u304b\uff1f \u5f7c\u5973\u306f\u5b8c\u5168\u306b\u5370\u8c61\u3092\u5931\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u3069\u3046\u3057\u3066\u899a\u3048\u3066\u3044\u306a\u3044\u3053\u3068\u306b\u306a\u308b\u306e\u3067\u3059\u304b\uff1f \u306a\u305c\u79c1\u81ea\u8eab\u306e\u3053\u3068\u3055\u3048\u899a\u3048\u3066\u3044\u306a\u3044\u306e\u3060\u308d\u3046\u304b\uff1f \u305d\u308c\u304b\u3089\u5f7c\u5973\u306f\u6ce3\u304d\u51fa\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3001\u300c\u79c1\u306f\u899a\u3048\u3066\u3044\u307e\u305b\u3093\u300d\u3068\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u672c\u5f53\u306b\u899a\u3048\u3066\u3044\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u3067\u4eba\u3005\u306f\u8a00\u3063\u305f\u3001\u300c\u3088\u304f\u8003\u3048\u3066\u3001\u3058\u3063\u304f\u308a\u3068\u8003\u3048\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u300d\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u4eba\u3005\u306b\u3088\u3063\u3066\u5ddd\u304b\u3089\u5f15\u304d\u4e0a\u3052\u3089\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u3042\u306a\u305f\u304c\u5ddd\u306e\u6c34\u304b\u3089\u60f3\u3044\u3092\u99b3\u305b\u59cb\u3081\u308c\u3070\u3001\u601d\u3044\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002"}
{"translation": "\u4eba\u3005\u306e\u8981\u6c42\u306b\u5f93\u3063\u3066\u3001\u5f7c\u5973\u306f\u78ba\u304b\u306b\u6df1\u304f\u601d\u3044\u51fa\u3057\u3066\u307f\u307e\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u5f7c\u5973\u306e\u8003\u3048\u304c\u5ddd\u8fba\u306b\u5230\u9054\u3059\u308b\u3068\u3001\u3056\u308f\u3056\u308f\u3057\u305f\u6c34\u97f3\u304c\u96f7\u306e\u3088\u3046\u306b\u8f5f\u97f3\u3068\u306a\u308a\u3001\u540d\u3082\u306a\u304d\u6050\u6016\u304c\u305d\u306e\u6c34\u97f3\u3068\u5171\u306b\u62bc\u3057\u5bc4\u305b\u3066\u304d\u305f\u3002"}
{"translation": "\u6ce2\u6fe4\u306e\u4e2d\u306b\u306f\u9b54\u9b3c\u304c\u96a0\u308c\u3066\u3044\u308b\u304b\u306e\u3088\u3046\u3067\u3001\u76ee\u306b\u898b\u3048\u305a\u89e6\u308c\u308b\u3053\u3068\u3082\u3067\u304d\u306a\u3044\u3051\u3069\u3001\u5f7c\u5973\u306e\u5fc3\u8eab\u3092\u3058\u308f\u3058\u308f\u3068\u653b\u6483\u3057\u3066\u304f\u308b\u3002"}
{"translation": "\u5f7c\u5973\u306f\u7a81\u7136\u81ea\u5236\u5fc3\u3092\u5931\u3044\u3001\u60b2\u3057\u307f\u3068\u7d76\u53eb\u3067\u5927\u58f0\u3092\u51fa\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u58f0\u306f\u30d2\u30b9\u30c6\u30ea\u30c3\u30af\u3060\u3063\u305f\u3002"}
{"translation": "\u5433\u3068\u3044\u3046\u540d\u5b57\u306e\u533b\u8005\u306f\u3001\u305d\u306e\u597d\u5947\u5fc3\u304b\u3089\u304f\u308b\u4eba\u3005\u3092\u53b3\u3057\u304f\u5236\u6b62\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u3001\u5f7c\u5973\u304c\u523a\u6fc0\u3092\u53d7\u3051\u305f\u53ef\u80fd\u6027\u304c\u3042\u308b\u3068\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306b\u3053\u308c\u4ee5\u4e0a\u8003\u3048\u3055\u305b\u306a\u3044\u3067\u3001\u5f7c\u5973\u304c\u75c5\u6c17\u3092\u6cbb\u3059\u3053\u3068\u3092\u8a31\u3057\u3066\u3042\u3052\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u305d\u308c\u304b\u3089\u3001\u4eba\u3005\u306f\u3082\u3046\u5f7c\u5973\u306b\u8ffd\u6c42\u3057\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u305f\u3060\u3001\u516c\u7136\u3068\u96a0\u308c\u3066\u540c\u60c5\u306e\u53e3\u8abf\u3067\u5f7c\u5973\u306e\u3053\u3068\u3092\u8a71\u3059\u3060\u3051\u3060\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u3068\u3066\u3082\u7f8e\u3057\u3044\u6625\u3067\u3057\u305f\u3002"}
{"translation": "\u3053\u306e\u5973\u6027\u306f\u305a\u3063\u3068\u81ea\u5206\u81ea\u8eab\u3068\u6226\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3082\u3046\u3068\u3066\u3082\u5e74\u3092\u53d6\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u3059\u3079\u3066\u306e\u808c\u304c\u67d4\u3089\u304b\u304f\u5782\u308c\u4e0b\u304c\u3063\u3066\u304a\u308a\u3001\u4e00\u672c\u306e\u307e\u3068\u3082\u306a\u3057\u308f\u3055\u3048\u3082\u6301\u3061\u4e0a\u3052\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u305b\u3093\u3002"}
{"translation": "\u5f7c\u5973\u306e\u9854\u3068\u9996\u306b\u306f\u7d30\u304b\u3044\u50b7\u304c\u305f\u304f\u3055\u3093\u3042\u3063\u305f\u3002"}
{"translation": "\u808c\u304c\u767d\u3044\u305f\u3081\u3001\u3053\u308c\u3089\u306e\u75d5\u8de1\u306f\u6642\u9593\u306e\u5263\u304c\u7121\u9020\u4f5c\u306b\u5f15\u304d\u5bc4\u305b\u308b\u3082\u306e\u3067\u306f\u306a\u304f\u3001\u7e4a\u7d30\u306a\u7b46\u3067\u4e00\u3064\u3072\u3068\u3064\u63cf\u304b\u308c\u308b\u3082\u306e\u3068\u3055\u3048\u898b\u3048\u307e\u3059\u3002"}
{"translation": "\u5f7c\u5973\u306e\u76ee\u306f\u3059\u3067\u306b\u6fc1\u308a\u304d\u3063\u3066\u3044\u305f\u304c\u3001\u7a81\u7136\u898b\u958b\u304b\u308c\u305f\u3068\u304d\u306b\u306f\u3001\u307e\u3060\u4e2d\u304b\u3089\u5149\u304c\u653e\u305f\u308c\u3066\u3044\u308b\u3053\u3068\u304c\u5206\u304b\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5e38\u306b\u4e00\u70b9\u3092\u898b\u3064\u3081\u3066\u307c\u3093\u3084\u308a\u3057\u3066\u3044\u308b\u3001\u307e\u308b\u3067\u4f55\u304b\u3092\u8003\u3048\u8fbc\u3093\u3067\u3044\u308b\u304b\u306e\u3088\u3046\u3067\u3001\u540c\u6642\u306b\u4f55\u3082\u3059\u308b\u3053\u3068\u306a\u304f\u9000\u5c48\u305d\u3046\u3060\u3002"}
{"translation": "\u305d\u308c\u306b\u3088\u308a\u3001\u305f\u307e\u306b\u901a\u884c\u4eba\u304c\u8208\u5473\u6d25\u3005\u3067\u5c0b\u306d\u308b\u3053\u3068\u304c\u3042\u3063\u305f\u3002"}
{"translation": "\u300c\u304a\u3070\u3042\u3055\u3093\u3001\u4f55\u3092\u8003\u3048\u3066\u3044\u308b\u306e\uff1f\u300d"}
{"translation": "\u305d\u306e\u6642\u3001\u5f7c\u5973\u306f\u56f0\u60d1\u3057\u305f\u9854\u3092\u6d6e\u304b\u3079\u3066\u901a\u884c\u4eba\u3092\u898b\u3064\u3081\u3001\u8ab0\u306b\u3082\u805e\u3053\u3048\u306a\u3044\u4f55\u304b\u3092\u307c\u305d\u307c\u305d\u3068\u545f\u3044\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u81ea\u5206\u304c\u4f55\u3092\u8a00\u3063\u305f\u306e\u304b\u308f\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u5b9f\u969b\u3001\u5f7c\u5973\u81ea\u8eab\u3082\u81ea\u5206\u304c\u4f55\u304b\u3092\u601d\u3063\u3066\u3044\u308b\u306e\u304b\u3069\u3046\u304b\u3001\u308f\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u5f7c\u5973\u306f\u305f\u304f\u3055\u3093\u306e\u5947\u5999\u306a\u3082\u306e\u304c\u5fc5\u6b7b\u306b\u5916\u3078\u8df3\u306d\u3066\u3044\u308b\u3053\u3068\u3092\u611f\u3058\u305f\u3060\u3051\u3067\u3001\u81ea\u5206\u306e\u8a18\u61b6\u3092\u63bb\u304d\u7acb\u3066\u3066\u3044\u308b\u304b\u306e\u3088\u3046\u3060\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u3089\u306f\u3001\u5f7c\u5973\u304c\u4e00\u751f\u6daf\u89e6\u308c\u305f\u304f\u306a\u3044\u3082\u306e\u3070\u304b\u308a\u3067\u3001\u5f7c\u5973\u306f\u5fc5\u6b7b\u306b\u62b5\u6297\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u62b5\u6297\u306f\u3001\u98a8\u3092\u901a\u3055\u306a\u3044\u5927\u304d\u306a\u7db2\u306e\u3088\u3046\u3067\u3001\u3044\u3064\u3067\u3082\u7a81\u3063\u8fbc\u3093\u3067\u6765\u308b\u60aa\u9b54\u4e00\u56e3\u3092\u8986\u3044\u96a0\u3057\u3001\u675f\u7e1b\u3057\u3066\u3044\u308b\u304b\u306e\u3088\u3046\u3067\u3059\u3002"}
{"translation": "\u5f7c\u5973\u306e\u4e00\u751f\u3092\u901a\u3058\u3066\u3001\u5e38\u306b\u3053\u306e\u7db2\u3092\u63b4\u3093\u3067\u305d\u308c\u3089\u3068\u95d8\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u592b\u304c\u751f\u304d\u3066\u3044\u305f\u6642\u3001\u5f7c\u306f\u5f7c\u5973\u306b\u8003\u3048\u308b\u3053\u3068\u3092\u63d0\u6848\u3057\u305f\u3002"}
{"translation": "\u4f55\u304b\u3092\u601d\u3044\u3064\u304f\u304b\u3082\u3057\u308c\u306a\u3044\u3068\u3001\u305d\u308c\u3067\u4eba\u3005\u306f\u5b89\u5fc3\u3059\u308b\u3060\u308d\u3046\u3068\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5f7c\u306e\u8a00\u8449\u306b\u8033\u3092\u50be\u3051\u3001\u5fc3\u3092\u843d\u3061\u7740\u3051\u308b\u3088\u3046\u81ea\u5206\u306b\u5f37\u3044\u3001\u4e00\u751f\u61f8\u547d\u601d\u3044\u51fa\u305d\u3046\u3068\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u307b\u307c\u4e00\u77ac\u306e\u3046\u3061\u306b\u3001\u5f7c\u5973\u306e\u5168\u8eab\u306e\u7169\u308f\u3057\u3055\u304c\u7121\u6570\u306e\u92fc\u91dd\u3068\u306a\u3063\u3066\u5674\u5c04\u3059\u308b\u3088\u3046\u306b\u523a\u3055\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u305d\u306e\u5f37\u70c8\u3055\u306f\u51f6\u60aa\u3067\u3001\u5f7c\u5973\u306f\u4e94\u81d3\u516d\u8151\u304c\u88c2\u3051\u308b\u611f\u899a\u3092\u899a\u3048\u305f\u3002"}
{"translation": "\u3053\u306e\u4e00\u77ac\u3001\u5f7c\u5973\u306e\u75db\u307f\u3068\u5026\u6020\u611f\u306f\u3001\u5f7c\u5973\u304c\u606f\u3092\u3064\u304f\u306e\u3082\u96e3\u3057\u3044\u307b\u3069\u3060\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u7d76\u671b\u7684\u306b\u592b\u306b\u5411\u304b\u3063\u3066\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u79c1\u3092\u8ffd\u3044\u8a70\u3081\u306a\u3044\u3067\u3002"}
{"translation": "\u8003\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u305b\u3093\u3002"}
{"translation": "\u8003\u3048\u305f\u3089\u81ea\u5206\u304c\u6b7b\u306c\u3079\u304d\u3060\u3068\u611f\u3058\u307e\u3059\u300d"}
{"translation": "\u5f7c\u5973\u306e\u592b\u306f\u6016\u304c\u3063\u305f\u3002"}
{"translation": "\u4e00\u6642\u306e\u6c88\u9ed8\u306e\u5f8c\u3001\u5f7c\u306f\u5f7c\u5973\u306b\u8a00\u3063\u305f\u3001\u300c\u305d\u308c\u4ee5\u4e0a\u8003\u3048\u308b\u5fc5\u8981\u306f\u306a\u3044\u3002"}
{"translation": "\u4f55\u304b\u5fd9\u3057\u304f\u306a\u308c\u308b\u4ed5\u4e8b\u3092\u63a2\u3057\u3066\u898b\u3066\u3002\u5fd9\u3057\u3055\u304c\u601d\u8003\u3092\u4e71\u3059\u3053\u3068\u3082\u3042\u308b\u3088\u300d"}
{"translation": "\u5f7c\u5973\u306f\u592b\u306e\u8a00\u8449\u3092\u983c\u308a\u306b\u884c\u52d5\u3057\u3001\u6bce\u65e5\u5fd9\u3057\u304f\u904e\u3054\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u5b9f\u969b\u3001\u5f7c\u5973\u306e\u5927\u3057\u305f\u4ed5\u4e8b\u306f\u306a\u304f\u3001\u5f7c\u5973\u306e\u4ed5\u4e8b\u306f\u5bb6\u4e8b\u3092\u3059\u308b\u3053\u3068\u3060\u3051\u3067\u3059\u3002"}
{"translation": "\u5f7c\u5973\u306f\u6bce\u65e5\u6383\u9664\u3084\u6d17\u6fef\u3067\u5fd9\u3057\u304f\u3001\u5bb6\u3092\u3074\u304b\u3074\u304b\u306b\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u5bb6\u306b\u8a2a\u308c\u305f\u3059\u3050\u306e\u4e00\u4eba\u3082\u304c\u300c\u3042\u306a\u305f\u306e\u5bb6\u306f\u672c\u5f53\u306b\u304d\u308c\u3044\u3060\u306d\u300d\u3068\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u592b\u306f\u533b\u8005\u3067\u3001\u305d\u308c\u304c\u5f7c\u5973\u306e\u8a87\u308a\u3067\u3059\u3002"}
{"translation": "\u305d\u3046\u3057\u3066\u3001\u5f7c\u5973\u306e\u751f\u6d3b\u306f\u5f90\u3005\u306b\u6b63\u5e38\u306b\u623b\u3063\u3066\u3044\u3063\u305f\u3002"}
{"translation": "\u4f55\u5e74\u3082\u7d4c\u3063\u3066\u3001\u5f7c\u5973\u306f\u305a\u3063\u3068\u3053\u3093\u306a\u611f\u3058\u3060\u3002"}
{"translation": "\u6bce\u5e74\u306e\u6642\u9593\u306f\u3001\u5f7c\u5973\u306e\u8a18\u61b6\u3084\u5f8c\u306b\u6b8b\u3063\u305f\u3082\u306e\u3092\u5c64\u5c64\u3068\u8986\u3046\u7cbe\u5bc6\u3067\u53b3\u5bc6\u306a\u819c\u306e\u3088\u3046\u3060\u3002"}
{"translation": "\u4e00\u5e74\u306b\u4e00\u679a\u305a\u3064\u3001\u5e74\u3005\u3001\u8584\u304b\u3089\u539a\u3078\u3068\u7a4d\u307f\u91cd\u306a\u308a\u56fa\u307e\u3063\u3066\u677f\u72b6\u306b\u306a\u308a\u3001\u5f7c\u5973\u306e\u610f\u8b58\u6df1\u304f\u96a0\u308c\u3066\u3044\u308b\u9b54\u7269\u5168\u3066\u304c\u5c01\u3058\u8fbc\u3081\u3089\u308c\u305f\u3002"}
{"translation": "\u3067\u3082\u305d\u308c\u304c\u4f55\u306a\u306e\u304b\u3001\u5f7c\u5973\u306f\u5168\u304f\u77e5\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f1952\u5e74\u306e\u6625\u306b\u8a18\u61b6\u3092\u5931\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3053\u308c\u304c\u592b\u306e\u6170\u3081\u3084\u6ce8\u610f\u3060\u3068\u3044\u3046\u3053\u3068\u3092\u7406\u89e3\u3057\u3066\u304a\u3089\u305a\u3001\u3080\u3057\u308d\u5fc3\u306e\u4e2d\u3067\u5f37\u70c8\u306a\u52d5\u63fa\u3092\u899a\u3048\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u592b\u304c\u638c\u63e1\u3057\u3066\u3044\u308b\u3088\u3046\u306b\u3001\u5f7c\u5973\u306e\u6b7b\u6575\u306f\u307b\u3068\u3093\u3069\u6d88\u3048\u3066\u3057\u307e\u3063\u305f\u3088\u3046\u306b\u898b\u3048\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u4e00\u4f53\u4f55\u306a\u306e\u3067\u3057\u3087\u3046\u304b\uff1f"}
{"translation": "\u5f7c\u304c\u79c1\u304c\u77e5\u3089\u306a\u3044\u3053\u3068\u3092\u77e5\u3063\u3066\u3044\u308b\u306f\u305a\u304c\u3042\u308b\u306e\u304b\uff1f"}
{"translation": "\u5f7c\u5973\u304c\u305d\u3046\u601d\u3063\u305f\u3068\u304d\u3001\u6050\u6016\u306e\u606f\u5439\u307e\u3067\u5f7c\u5973\u306e\u9854\u9762\u306b\u8feb\u3063\u3066\u304f\u308b\u3088\u3046\u3067\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u6050\u6016\u306f\u5f7c\u5973\u306e\u3059\u3050\u305d\u3070\u306b\u3042\u3063\u305f\u3002"}
{"translation": "\u65e5\u3005\u3001\u591c\u3005\u3001\u5206\u3005\u3001\u79d2\u79d2\u3002"}
{"translation": "\u305d\u308c\u3086\u3048\u3001\u5f7c\u5973\u306f\u7406\u89e3\u3057\u305f\u3002"}
{"translation": "\u4f55\u5e74\u3082\u306e\u9593\u3001\u5f7c\u5973\u304c\u6df1\u304f\u611b\u3057\u3066\u3044\u305f\u3053\u306e\u4eba\u7269\u306f\u3001\u540c\u6642\u306b\u5f7c\u5973\u304c\u6df1\u304f\u6050\u308c\u3066\u3044\u305f\u4eba\u7269\u3067\u3082\u3042\u3063\u305f\u3002"}
{"translation": "\u306a\u305c\u3060\u308d\u3046\uff1f"}
{"translation": "\u306a\u305c\u5f7c\u5973\u306f\u305d\u306e\u3088\u3046\u306a\u611f\u60c5\u3092\u6301\u3064\u306e\u3060\u308d\u3046\uff1f"}
{"translation": "\u5f7c\u5973\u306f\u6df7\u4e71\u3057\u3066\u3044\u3066\u3001\u7406\u89e3\u3067\u304d\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u305d\u306e\u611f\u60c5\u306f\u78ba\u304b\u306b\u5b58\u5728\u3059\u308b\u3002"}
{"translation": "\u7a93\u306e\u5916\u306e\u6843\u306e\u6728\u306f\u982d\u304b\u3089\u8db3\u5143\u307e\u3067\u30d4\u30f3\u30af\u8272\u306e\u82b1\u3067\u3044\u3063\u3071\u3044\u3060\u3063\u305f\u3002"}
{"translation": "\u4e2d\u5ead\u306e\u58c1\u969b\u306b\u54b2\u304f\u674f\u306e\u82b1\u3082\u4e00\u5217\u767d\u304f\u306a\u308a\u3001\u767d\u3044\u58c1\u3068\u6620\u3048\u5408\u3063\u3066\u9060\u304f\u304b\u3089\u898b\u308b\u3068\u82b1\u306e\u8272\u304c\u307b\u3068\u3093\u3069\u5206\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u3055\u3089\u306b\u9060\u304f\u306b\u3001\u6570\u672c\u306e\u53e4\u3044\u9280\u674f\u304c\u7dd1\u8272\u306e\u8449\u3092\u63fa\u3089\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u5e79\u306f\u592a\u304f\u3066\u5143\u3005\u4f55\u5e74\u306b\u690d\u3048\u305f\u304b\u5206\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u3055\u3089\u306b\u9060\u304f\u3001\u9060\u304f\u3001\u5c71\u306e\u5f71\u304c\u67d4\u3089\u304b\u304f\u8d77\u4f0f\u3057\u3001\u305d\u306e\u8f2a\u90ed\u306f\u82b1\u3073\u3089\u306e\u3088\u3046\u3060\u3002"}
{"translation": "\u4e2d\u5ead\u306e\u9685\u306b\u54b2\u3044\u3066\u3044\u308b\u30b8\u30f3\u30c1\u30e7\u30a6\u30b2\u306e\u82b1\u304c\u3082\u3046\u3059\u3050\u6563\u308b\u3060\u308d\u3046\u304c\u3001\u305d\u306e\u660e\u308b\u3044\u9ec4\u8272\u306e\u82b1\u306f\u307e\u3060\u9bae\u3084\u304b\u306b\u8f1d\u3044\u3066\u3044\u305f\u3002"}
{"translation": "\u4e94\u8272\u306e\u8272\u5f69\u304c\u7a81\u5982\u5f7c\u5973\u306e\u8996\u754c\u306b\u5165\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u6625\u304c\u623b\u308b\u3068\u3001\u9ce5\u305f\u3061\u306f\u5143\u6c17\u3092\u53d6\u308a\u623b\u3057\u3001\u98a8\u304c\u307e\u3060\u51b7\u305f\u3044\u306b\u3082\u304b\u304b\u308f\u3089\u305a\u3001\u5f7c\u3089\u306f\u3053\u306e\u5fae\u7d30\u306a\u5bd2\u3055\u306e\u4e2d\u3067\u6b4c\u3044\u7d9a\u3051\u3066\u3044\u308b\u3088\u3046\u3060\u3002"}
{"translation": "\u3053\u306e\u3088\u3046\u306a\u98a8\u666f\u3068\u97f3\u58f0\u306e\u4e2d\u3067\u3001\u5f7c\u5973\u306f\u3086\u3063\u304f\u308a\u3068\u9759\u307e\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u5f7c\u5973\u304c\u6025\u6d41\u306e\u5ddd\u304b\u3089\u5f15\u304d\u4e0a\u3052\u3089\u308c\u305f\u3068\u304d\u3001\u5f7c\u5973\u306f\u4e00\u5207\u8863\u670d\u3092\u8eab\u306b\u3064\u3051\u3066\u3044\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u982d\u304b\u3089\u3064\u307e\u5148\u307e\u3067\u3001\u5168\u8eab\u304c\u50b7\u3060\u3089\u3051\u3060\u3002"}
{"translation": "\u305d\u308c\u306f\u77f3\u3068\u6fc0\u6d41\u304c\u885d\u7a81\u3057\u305f\u7d50\u679c\u3060\u3002"}
{"translation": "\u5f7c\u5973\u3092\u6551\u3063\u305f\u4eba\u306f\u3001\u6c34\u304c\u5f7c\u5973\u306e\u5168\u8eab\u3092\u771f\u3063\u767d\u306b\u3057\u305f\u3068\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u9ed2\u3044\u306e\u306f\u9aea\u3060\u3051\u3067\u3001\u4e00\u898b\u3059\u308b\u3068\u3069\u3053\u304c\u50b7\u3064\u3044\u3066\u3044\u308b\u306e\u304b\u307e\u3063\u305f\u304f\u308f\u304b\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u5e78\u904b\u306b\u3082\u3001\u8fd1\u304f\u306e\u6751\u3067\u8ecd\u306e\u533b\u5e2b\u305f\u3061\u304c\u8a3a\u5bdf\u3092\u3057\u3066\u3044\u305f\u306e\u3067\u3001\u5f7c\u3089\u306f\u5f7c\u5973\u3092\u76f4\u63a5\u305d\u3053\u306b\u9023\u308c\u3066\u884c\u3063\u305f\u3002"}
{"translation": "\u6551\u6025\u51e6\u7f6e\u306e\u5f8c\u3001\u305d\u306e\u6570\u4eba\u306e\u533b\u8005\u9054\u306f\u5f7c\u5973\u3092\u6025\u3044\u3067\u75c5\u9662\u306b\u623b\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u75c5\u9662\u3067\u534a\u6708\u4ee5\u4e0a\u7d4c\u3063\u3066\u304b\u3089\u3084\u3063\u3068\u610f\u8b58\u3092\u53d6\u308a\u623b\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u304c\u610f\u8b58\u3092\u53d6\u308a\u623b\u3057\u3001\u4eba\u3005\u306e\u8cea\u554f\u306b\u7b54\u3048\u3088\u3046\u3068\u3057\u305f\u3068\u304d\u3001\u7a81\u7136\u6238\u60d1\u3063\u3066\u3057\u307e\u3063\u305f\u3002"}
