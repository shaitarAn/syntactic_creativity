{"translation": "\u5168\u3066\u3092\u5fd8\u308c\u308b\u3053\u3068\u306f\u3001\u78ba\u304b\u306b\u8f9b\u3044\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u3055\u3089\u306b\u60aa\u3044\u306e\u306f\u3001\u4f55\u3082\u5fd8\u308c\u306a\u3044\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u306a\u305c\u306a\u3089\u3001\u5168\u3066\u306e\u77e5\u8b58\u306f\u5fd8\u308c\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u521d\u3081\u3066\u751f\u307e\u308c\u308b\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u5168\u3066\u304c\u533a\u5225\u306a\u304f\u4fdd\u5b58\u3055\u308c\u3001\u96fb\u6c17\u30a8\u30cd\u30eb\u30ae\u30fc\u3092\u6d88\u8cbb\u3059\u308b\u30c7\u30fc\u30bf\u30b9\u30c8\u30ec\u30fc\u30b8\u306e\u3088\u3046\u306b\u306a\u308c\u3070\u3001\u305d\u308c\u306f\u610f\u5473\u3092\u5931\u3044\u3001\u7121\u7528\u306a\u60c5\u5831\u306e\u7121\u79e9\u5e8f\u306a\u96c6\u5408\u4f53\u3068\u5316\u3057\u307e\u3059\u3002"}
{"translation": "\u3059\u3079\u3066\u3092\u4fdd\u5b58\u3059\u308b\u8a18\u61b6\u306f\u3001\u672c\u8cea\u7684\u306b\u306f\u4f55\u3082\u4fdd\u5b58\u3057\u3066\u3044\u306a\u3044\u3002"}
{"translation": "\u305d\u306e\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u5973\u6027\u306f\u3001\u8a18\u61b6\u8853\u3092\u4f7f\u308f\u305a\u306b5\u65e5\u4ee5\u964d\u306e\u6bce\u65e5\u3092\u899a\u3048\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u5fd8\u5374\u306e\u6280\u8853\u306f\u4e0d\u53ef\u80fd\u306a\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u306a\u305c\u306a\u3089\u3001\u3059\u3079\u3066\u306e\u7b26\u53f7\u306f\u5b58\u5728\u3092\u793a\u3057\u3066\u3044\u308b\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u305f\u3068\u3048\u305d\u308c\u304c\u4e0d\u5728\u3092\u6307\u3057\u793a\u3057\u3066\u3044\u3066\u3082\u3002"}
{"translation": "\u30ed\u30fc\u30de\u5e1d\u56fd\u3067damnatio memoriae\u306e\u5224\u6c7a\u3092\u53d7\u3051\u305f\u307b\u3068\u3093\u3069\u5168\u3066\u306e\u4eba\u7269\u306b\u3064\u3044\u3066\u3001\u540d\u524d\u3067\u77e5\u3063\u3066\u3044\u308b\u3068\u767e\u79d1\u4e8b\u5178\u306f\u4e3b\u5f35\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u81ea\u6bba\u306f\u3001\u672a\u6765\u306e\u4e0d\u78ba\u5b9f\u6027\u306b\u6253\u3061\u52dd\u3064\u6700\u3082\u904e\u6fc0\u306a\u624b\u6bb5\u3068\u3057\u3066\u73fe\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u304c\u3001\u305d\u308c\u306f\u77ed\u7e2e\u3055\u308c\u305f\u5b58\u5728\u3068\u3044\u3046\u4ee3\u511f\u3092\u6255\u3046\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u5831\u544a\u306b\u3088\u308c\u3070\u3001\u304b\u3064\u3066\u30b5\u30e2\u30b9\u5cf6\u3067\u30a2\u30a6\u30b0\u30b9\u30c8\u30a5\u30b9\u304c\u53d7\u3051\u53d6\u3063\u305f\u30a4\u30f3\u30c9\u306e\u4f7f\u7bc0\u56e3\u306e\u8d08\u308a\u7269\u306b\u306f\u3001\u864e\u3084\u624b\u306e\u306a\u3044\u82e5\u8005\uff08\u5f7c\u306f\u8db3\u3092\u624b\u306e\u3088\u3046\u306b\u4f7f\u3046\u3053\u3068\u304c\u3067\u304d\u305f\uff09\u3060\u3051\u3067\u306a\u304f\u3001\u30d6\u30e9\u30fc\u30d5\u30de\u30f3\u968e\u7d1a\u51fa\u8eab\u3067\u81ea\u3089\u547d\u3092\u7d76\u3064\u3053\u3068\u3092\u8003\u3048\u3066\u3044\u305f\u30b6\u30eb\u30de\u30ed\u30b9\u3068\u3044\u3046\u7537\u3082\u542b\u307e\u308c\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u5f7c\u304c\u671b\u3080\u901a\u308a\u306e\u751f\u6d3b\u304c\u9001\u308c\u305f\u304b\u3089\u3060\u3001\u3068\u3002"}
{"translation": "\u5f7c\u304c\u4f55\u304b\u4e88\u671f\u3057\u306a\u3044\u3053\u3068\u306b\u906d\u3046\u306e\u3092\u78ba\u5b9f\u306b\u9632\u3050\u305f\u3081\u306b\u3001\u5f7c\u306f\u30a2\u30c6\u30cd\u3067\u7b11\u9854\u3092\u6d6e\u304b\u3079\u3066\u3001\u88f8\u3067\u30aa\u30a4\u30eb\u3092\u5857\u3063\u305f\u307e\u307e\u706b\u306e\u4e2d\u306b\u98db\u3073\u8fbc\u307f\u3001\u751f\u304d\u305f\u307e\u307e\u82e6\u75db\u3092\u4f34\u3063\u3066\u713c\u3051\u6b7b\u306c\u3053\u3068\u7121\u7591\u3060\u3063\u305f\u304c\u3001\u81ea\u5206\u81ea\u8eab\u306e\u6b7b\u3092\u6f14\u51fa\u3057\u3066\u6b74\u53f2\u306b\u540d\u524d\u304c\u8a18\u3055\u308c\u308b\u3053\u3068\u3068\u306a\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u305f\u3060\u3057\u3001\u305d\u308c\u306fCassius Dio\u306e\u30ed\u30fc\u30de\u53f2\u306e\u4e00\u90e8\u5206\u3067\u3042\u308b80\u518a\u3082\u3042\u308b\u672c\u306e\u4e2d\u3067\u5076\u7136\u4fdd\u5b58\u3055\u308c\u305f\u5947\u5999\u306a\u30a8\u30d4\u30bd\u30fc\u30c9\u3068\u3057\u3066\u3060\u3051\u3067\u3059\u3002"}
{"translation": "\u7d50\u5c40\u3001\u307e\u3060\u5b58\u5728\u3059\u308b\u3082\u306e\u5168\u3066\u306f\u5358\u306b\u6b8b\u3063\u3066\u3044\u308b\u3082\u306e\u306b\u3059\u304e\u307e\u305b\u3093\u3002"}
{"translation": "\u751f\u304d\u3066\u3044\u308b\u3068\u3044\u3046\u3053\u3068\u306f\u3001\u5931\u3046\u3053\u3068\u3092\u7d4c\u9a13\u3059\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u307e\u3059\u3002"}
{"translation": "\u300c\u4f55\u304c\u8d77\u3053\u308b\u306e\u3060\u308d\u3046\uff1f\u300d\u3068\u3044\u3046\u7591\u554f\u306f\u3001\u4eba\u985e\u81ea\u4f53\u3088\u308a\u3082\u65b0\u3057\u3044\u3082\u306e\u3067\u306f\u306a\u3055\u305d\u3046\u3067\u3001\u672a\u6765\u304c\u4e88\u6e2c\u4e0d\u53ef\u80fd\u3067\u3042\u308b\u3068\u3044\u3046\u7279\u6027\u306f\u907f\u3051\u3089\u308c\u306a\u304f\u3001\u4e0d\u5b89\u3092\u5f15\u304d\u8d77\u3053\u3057\u307e\u3059\u3002"}
{"translation": "\u3060\u304b\u3089\u3053\u305d\u3001\u6b7b\u306e\u6642\u671f\u3084\u72b6\u6cc1\u3082\u6697\u95c7\u306b\u5305\u307e\u308c\u3066\u3057\u307e\u3044\u307e\u3059\u3002"}
{"translation": "\u8ab0\u304c\u82e6\u3057\u307f\u3092\u4e88\u611f\u3059\u308b\u7518\u3044\u9b54\u8853\u3001\u601d\u8003\u306b\u3088\u308b\u5148\u53d6\u308a\u3067\u6050\u6016\u3092\u9632\u3054\u3046\u3068\u3044\u3046\u904b\u547d\u7684\u306a\u885d\u52d5\u3092\u77e5\u3089\u306a\u3044\u306e\u3067\u3057\u3087\u3046\u304b\uff1f \u4eba\u306f\u60b2\u60e8\u3055\u3092\u4e88\u611f\u3057\u3001\u53ef\u80fd\u306a\u707d\u5bb3\u3092\u60f3\u50cf\u3057\u306a\u304c\u3089\u3001\u81ea\u5206\u81ea\u8eab\u304c\u3072\u3069\u3044\u9a5a\u304d\u304b\u3089\u514d\u308c\u308b\u3068\u8003\u3048\u307e\u3059\u3002"}
{"translation": "\u53e4\u4ee3\u3067\u306f\u3001\u5922\u306f\u6170\u3081\u3092\u7d04\u675f\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u306a\u305c\u306a\u3089\u3001\u30ae\u30ea\u30b7\u30e3\u4eba\u305f\u3061\u306f\u305d\u308c\u304c\u6765\u308b\u3079\u304d\u3082\u306e\u3092\u3001\u795e\u8a17\u306e\u3088\u3046\u306b\u4e88\u8a00\u3057\u3001\u3057\u305f\u304c\u3063\u3066\u672a\u6765\u304b\u3089\u4e0d\u5909\u7684\u306a\u3082\u306e\u3092\u53d6\u308a\u9664\u3051\u306a\u304f\u3068\u3082\u3001\u4e88\u671f\u3057\u306a\u3044\u6050\u6016\u3092\u8efd\u6e1b\u3059\u308b\u3068\u4fe1\u3058\u3066\u3044\u305f\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u6b7b\u306e\u6050\u6016\u304b\u3089\u9003\u308c\u308b\u305f\u3081\u306b\u3001\u81ea\u3089\u547d\u3092\u7d76\u3064\u4eba\u306f\u5c11\u306a\u304f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u904e\u53bb\u3092\u8a18\u61b6\u306b\u7559\u3081\u3001\u5fd8\u5374\u3092\u963b\u6b62\u3059\u308b\u6226\u7565\u306f\u591a\u7a2e\u591a\u69d8\u3067\u3059\u3002"}
{"translation": "\u4f1d\u627f\u3092\u4fe1\u3058\u308b\u306a\u3089\u3001\u79c1\u305f\u3061\u306e\u6b74\u53f2\u8a18\u8ff0\u306e\u521d\u3081\u306b\u306f\u30da\u30eb\u30b7\u30e3\u4eba\u3068\u30ae\u30ea\u30b7\u30e3\u4eba\u3068\u306e\u9593\u306e\u9023\u7d9a\u3059\u308b\u58ca\u6ec5\u7684\u306a\u6226\u4e89\u304c\u7acb\u3061\u3001\u73fe\u5728\u307b\u307c\u5fd8\u308c\u3089\u308c\u3066\u3057\u307e\u3063\u305f\u8a18\u61b6\u8853\u306e\u59cb\u307e\u308a\u306b\u306f\u591a\u304f\u306e\u6b7b\u8005\u3092\u51fa\u3057\u305f\u707d\u5384\u304c\u8d77\u304d\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u306f\u7d00\u5143\u524d5\u4e16\u7d00\u521d\u3081\u306e\u30c6\u30c3\u30b5\u30ea\u30a2\u3067\u3057\u305f\u3002"}
{"translation": "\u4f55\u4e16\u7d00\u3082\u524d\u306b\u3001\u5d29\u58ca\u3059\u308b\u5bb6\u304c\u796d\u308a\u306e\u65e5\u306e\u96c6\u307e\u308a\u5168\u4f53\u3092\u57cb\u846c\u3057\u3001\u552f\u4e00\u306e\u751f\u5b58\u8005\u3067\u3042\u308b\u8a69\u4eba\u30b7\u30e2\u30cb\u30c7\u30b9\u30fb\u30d5\u30a9\u30f3\u30fb\u30b1\u30aa\u30b9\u304c\u935b\u3048\u3089\u308c\u305f\u8a18\u61b6\u529b\u3092\u983c\u308a\u306b\u7cbe\u795e\u7684\u306b\u7834\u58ca\u3055\u308c\u305f\u5efa\u7269\u306b\u518d\u5ea6\u5165\u308b\u3053\u3068\u304c\u3067\u304d\u3001\u30b2\u30b9\u30c8\u306e\u5ea7\u5e2d\u9806\u3092\u547c\u3073\u51fa\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u304c\u539f\u56e0\u3067\u3001\u74e6\u792b\u304b\u3089\u898b\u3064\u304b\u3063\u305f\u907a\u4f53\u306e\u7279\u5b9a\u3059\u308b\u3053\u3068\u304c\u53ef\u80fd\u3068\u306a\u3063\u305f\u3002"}
{"translation": "\u6b7b\u3068\u751f\u306e\u4e8c\u8005\u629e\u4e00\u306b\u5185\u5728\u3059\u308b\u591a\u6570\u306e\u30d1\u30e9\u30c9\u30c3\u30af\u30b9\u306e1\u3064\u306f\u3001\u6545\u4eba\u304c\u4e8c\u5ea6\u3068\u53d6\u308a\u623b\u3059\u3053\u3068\u304c\u3067\u304d\u306a\u3044\u3082\u306e\u3068\u3057\u3066\u8a00\u53ca\u3055\u308c\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u305d\u306e\u55aa\u5931\u3092\u60b2\u3057\u3080\u6c17\u6301\u3061\u304c\u540c\u6642\u306b\u500d\u5897\u3057\u534a\u6e1b\u3055\u308c\u308b\u4e00\u65b9\u3067\u3001\u884c\u65b9\u4e0d\u660e\u8005\u3084\u906d\u96e3\u8005\u306e\u4e0d\u78ba\u5b9a\u306a\u904b\u547d\u306f\u5bb6\u65cf\u3092\u4e0d\u5b89\u306a\u5e0c\u671b\u3068\u5f37\u5236\u7684\u306a\u60b2\u3057\u307f\u304b\u3089\u7121\u79e9\u5e8f\u306a\u6050\u6016\u3078\u5f15\u304d\u8fbc\u307f\u3001\u305d\u308c\u304c\u55aa\u5931\u611f\u3092\u51e6\u7406\u3059\u308b\u3053\u3068\u3082\u751f\u304d\u7d9a\u3051\u308b\u3053\u3068\u3082\u9632\u3044\u3067\u3044\u307e\u3059\u3002"}
{"translation": "\u6b7b\u306e\u65ad\u7d76\u306f\u907a\u7523\u3068\u8a18\u61b6\u306e\u51fa\u767a\u70b9\u3067\u3042\u308a\u3001\u305d\u3057\u3066\u6b7b\u8005\u3078\u306e\u54c0\u60bc\u304c\u3059\u3079\u3066\u306e\u6587\u5316\u3001\u3064\u307e\u308a\u4eca\u3084\u7a81\u304f\u308a\u958b\u3044\u305f\u865a\u7121\u3001\u7a81\u7136\u306e\u9759\u5bc2\u3092\u6b4c\u3084\u7948\u308a\u3084\u7269\u8a9e\u3092\u901a\u3058\u3066\u57cb\u3081\u3046\u308b\u5b8b\u80dc\u6587\u5316\u6e90\u3067\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u3089\u306f\u3044\u305a\u308c\u3082\u4e0d\u5728\u306b\u306a\u3063\u305f\u3082\u306e\u3092\u518d\u5ea6\u559a\u8d77\u3057\u307e\u3059\u3002"}
{"translation": "\u55aa\u5931\u306e\u7d4c\u9a13\u306f\u3001\u6a21\u9020\u7269\u306e\u3088\u3046\u306b\u3001\u5606\u304d\u306e\u5bfe\u8c61\u3068\u306a\u308b\u3082\u306e\u306e\u8f2a\u90ed\u3092\u6d6e\u304b\u3073\u4e0a\u304c\u3089\u305b\u307e\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u3057\u3070\u3057\u3070\u305d\u308c\u306f\u3001\u60b2\u3057\u307f\u306e\u7167\u308b\u5149\u660e\u4e0b\u3067\u6b32\u671b\u306e\u5bfe\u8c61\u3078\u3068\u5909\u8c8c\u3057\u307e\u3059\u3002"}
{"translation": "\u3042\u308b\u3044\u306f\u3001\u300c\u65b0\u30fb\u30d6\u30ec\u30fc\u30e0\u56f3\u66f8\u300d\u30b7\u30ea\u30fc\u30ba\u4e00\u518a\u524d\u6587\u3067\u30cf\u30a4\u30c7\u30eb\u30d9\u30eb\u30b0\u5927\u5b66\u52d5\u7269\u5b66\u6559\u6388\u304c\u8ff0\u3079\u3066\u3044\u305f\u901a\u308a\u3001\u300c\u897f\u6d0b\u4eba\u306b\u306f\u7406\u8ad6\u7684\u306b\u307b\u3068\u3093\u3069\u8aac\u660e\u4e0d\u80fd\u306a\u7279\u6027\u304c\u3042\u308a\u3001\u305d\u308c\u306f\u5931\u3063\u305f\u3082\u306e\u3092\u5b58\u5728\u3059\u308b\u3082\u306e\u4ee5\u4e0a\u306b\u8a55\u4fa1\u3059\u308b\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u3053\u308c\u4ee5\u5916\u3067\u306f\u30ef\u30e9\u30d3\u30fc\u30af\u30b5\u30ea\u79d1\u304b\u3089\u51fa\u3066\u304f\u308b\u5947\u5999\u306a\u9b45\u529b\u3092\u8aac\u660e\u3057\u3088\u3046\u304c\u3042\u308a\u307e\u305b\u3093\u300d"}
{"translation": "\u554f\u984c\u306e\u306a\u3044\u70b9\u306f\u3001\u6b7b\u3068\u305d\u308c\u306b\u4f34\u3046\u3001\u7a81\u5982\u3068\u3057\u3066\u4eba\u306e\u4e0d\u5728\u3078\u3068\u3069\u3046\u5bfe\u51e6\u3059\u308b\u304b\u3001\u907a\u4f53\u304b\u3089\u6240\u6709\u8005\u4e0d\u660e\u306a\u8ca1\u7269\u307e\u3067\u305d\u306e\u907a\u54c1\u3092\u3069\u3046\u6271\u3046\u304b\u3001\u3068\u3044\u3046\u554f\u984c\u304c\u6642\u9593\u306e\u7d4c\u904e\u3068\u5171\u306b\u7b54\u3048\u3092\u6c42\u3081\u884c\u52d5\u3092\u4fc3\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u3053\u308c\u3089\u306e\u610f\u5473\u306f\u5358\u306a\u308b\u76ee\u7684\u3092\u8d85\u8d8a\u3057\u3001\u79c1\u305f\u3061\u306e\u65e9\u671f\u306e\u7956\u5148\u3092\u52d5\u7269\u7684\u9818\u57df\u304b\u3089\u4eba\u9593\u6027\u3078\u5c0e\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u6b7b\u3093\u3060\u540c\u80de\u306e\u907a\u4f53\u3092\u81ea\u7136\u306e\u5206\u89e3\u904e\u7a0b\u306b\u59d4\u306d\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u305d\u308c\u304c\u4e00\u822c\u7684\u306b\u4eba\u9593\u306e\u7279\u6027\u3068\u3055\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u4ed6\u306e\u9ad8\u5ea6\u306a\u52d5\u7269\u3067\u3082\u540c\u69d8\u306e\u884c\u52d5\u304c\u89b3\u5bdf\u3055\u308c\u307e\u3059\u3002"}
{"translation": "\u4f8b\u3048\u3070\u3001\u8c61\u306f\u6b7b\u306b\u304b\u3051\u3066\u3044\u308b\u7fa4\u308c\u306e\u4ef2\u9593\u3092\u898b\u3064\u3051\u308b\u3068\u3001\u4f55\u6642\u9593\u3082\u305d\u306e\u5468\u308a\u306b\u96c6\u307e\u3063\u3066\u9577\u3044\u9f3b\u3067\u89e6\u308a\u7d9a\u3051\u3001\u540c\u6642\u306b\u6fc0\u3057\u304f\u5439\u304d\u9cf4\u3089\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u3057\u3087\u3063\u3061\u3085\u3046\u7121\u529b\u306a\u4f53\u3092\u7acb\u3061\u4e0a\u304c\u3089\u305b\u3088\u3046\u3068\u8a66\u307f\u305f\u5f8c\u3001\u6700\u7d42\u7684\u306b\u306f\u907a\u4f53\u3092\u571f\u3084\u679d\u3067\u8986\u3044\u307e\u3059\u3002"}
{"translation": "\u307e\u305f\u3001\u5f7c\u3089\u306f\u4f55\u5e74\u3082\u306e\u3061\u306b\u307e\u3060\u5b9a\u671f\u7684\u306b\u305d\u306e\u6b7b\u306e\u5834\u6240\u3092\u8a2a\u308c\u308b\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u305d\u308c\u306b\u306f\u9593\u9055\u3044\u306a\u304f\u512a\u308c\u305f\u8a18\u61b6\u529b\u304c\u5fc5\u8981\u3067\u3001\u304a\u305d\u3089\u304f\u79c1\u305f\u3061\u304c\u60f3\u50cf\u3059\u308b\u4ee5\u4e0a\u306b\u5947\u8de1\u7684\u3067\u78ba\u8a8d\u4e0d\u80fd\u306a\u5f7c\u65b9\u3078\u306e\u601d\u60f3\u3082\u4e0d\u53ef\u6b20\u3067\u3059\u3002"}
{"translation": "\u4eca\u3001\u79c1\u304c\u3053\u306e\u672c\u306e\u4ed5\u4e8b\u3092\u307b\u3068\u3093\u3069\u7d42\u3048\u3001\u5206\u89e3\u3084\u7834\u58ca\u306e\u591a\u69d8\u306a\u73fe\u8c61\u304c\u4e3b\u5c0e\u7684\u306a\u5f79\u5272\u3092\u679c\u305f\u3059\u72b6\u6cc1\u3067\u3001\u6b7b\u306b\u5411\u304d\u5408\u3046\u7121\u6570\u306e\u65b9\u6cd5\u306e\u4e00\u3064\u3067\u3042\u308b\u3053\u3068\u3092\u7406\u89e3\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u57fa\u672c\u7684\u306b\u30d8\u30ed\u30c9\u30c8\u30b9\u304c\u8a3c\u8a00\u3057\u305f\u30ab\u30e9\u30c6\u30a3\u30a2\u4eba\u306e\u98a8\u7fd2\u3067\u6b7b\u3093\u3060\u4e21\u89aa\u3092\u98df\u3079\u308b\u3053\u3068\u306b\u9a5a\u3044\u305f\u308a\u3001\u30ae\u30ea\u30b7\u30e3\u4eba\u304c\u81ea\u5206\u305f\u3061\u306e\u89aa\u3092\u713c\u304f\u98a8\u4fd7\u3092\u805e\u3044\u3066\u6050\u6016\u306b\u6e80\u3061\u3066\u3044\u305f\u98a8\u5473\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u306a\u305c\u306a\u3089\u3001\u751f\u547d\u306b\u66f4\u306b\u8fd1\u3044\u306e\u306f\u3001\u6b7b\u3092\u5e38\u306b\u610f\u8b58\u3057\u3066\u3044\u308b\u8005\u306a\u306e\u304b\u3001\u305d\u308c\u3068\u3082\u6b7b\u3092\u8ffd\u3044\u51fa\u3059\u3053\u3068\u306b\u6210\u529f\u3059\u308b\u8005\u306a\u306e\u304b\u3001\u5168\u3066\u304c\u7d42\u308f\u308b\u3068\u3044\u3046\u6050\u308d\u3057\u3044\u60f3\u50cf\u304c\u6050\u308d\u3057\u3044\u306e\u304b\u3001\u305d\u308c\u3068\u3082\u7d42\u308f\u308a\u304c\u7121\u3044\u3053\u3068\u304c\u305d\u3046\u3067\u3042\u308b\u306e\u304b\u3001\u3053\u306e\u554f\u984c\u306b\u3064\u3044\u3066\u306f\u4e92\u3044\u306b\u5bfe\u7acb\u3059\u308b\u610f\u898b\u304c\u591a\u304f\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u3082\u3061\u308d\u3093\u3001\u305d\u308c\u4ee5\u524d\u306b\u3082\u6ce8\u76ee\u3059\u3079\u304d\u5893\u5730\u3092\u3044\u304f\u3064\u304b\u8a2a\u308c\u3066\u3044\u307e\u3057\u305f\uff1a\u4f8b\u3048\u3070\u3001\u9ad8\u3044\u8d64\u30ec\u30f3\u30ac\u306e\u58c1\u3067\u30f4\u30a7\u30cd\u30c4\u30a3\u30a2\u6e56\u306e\u9752\u7dd1\u8272\u306e\u6c34\u304b\u3089\u9ad8\u3005\u3068\u7acb\u3061\u4e0a\u304c\u308b\u6b7b\u8005\u306e\u5cf6\u30b5\u30f3\u30fb\u30df\u30b1\u30fc\u30ec\u3001\u3042\u308b\u3044\u306f\u6bce\u5e74\u30e1\u30ad\u30b7\u30b3\u4eba\u9054\u306b\u3088\u3063\u3066\u795d\u308f\u308c\u308b\u30c7\u30a3\u30a2\u30fb\u30c7\u30fb\u30ed\u30b9\u30fb\u30e0\u30a8\u30eb\u30c8\u30b9\uff08\u6b7b\u8005\u306e\u65e5\uff09\u306e\u65e5\u306b\u306f\u3001\u30aa\u30ec\u30f3\u30b8\u3084\u9ec4\u8272\u3067\u98fe\u3089\u308c\u305f\u5893\u3084\u9032\u884c\u3057\u305f\u8150\u6557\u306b\u3088\u308a\u6c38\u9060\u306b\u7b11\u9854\u304c\u5b9a\u3081\u3089\u308c\u305f\u30ab\u30e9\u30d5\u30eb\u306a\u7802\u7cd6\u3068\u30d1\u30d4\u30a8\u30de\u30b7\u30a7\u88fd\u306e\u30b9\u30ab\u30eb\u3067\u8986\u308f\u308c\u3066\u8cd1\u308f\u3046\u30cf\u30ea\u30a6\u30c3\u30c9\u30d5\u30a9\u30fc\u30a8\u30d0\u30fc\u5893\u5730\u306a\u3069\u3067\u3059\u3002"}
{"translation": "\u6570\u5e74\u524d\u306e\u3042\u308b8\u6708\u306e\u65e5\u3001\u79c1\u306f\u5317\u65b9\u306e\u4e00\u90fd\u5e02\u3092\u8a2a\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u6d77\u306e\u4e00\u90e8\u304c\u5730\u5143\u306e\u5730\u4e2d\u306b\u6df1\u304f\u5165\u308a\u8fbc\u3080\u6700\u5f8c\u306e\u6e7e\u66f2\u90e8\u306b\u4f4d\u7f6e\u3057\u3066\u3044\u3066\u3001\u305d\u306e\u5834\u6240\u306f\u524d\u3005\u304b\u3089\u306e\u6c37\u6cb3\u6642\u4ee3\u3088\u308a\u5b58\u5728\u3057\u307e\u3059\u3002"}
{"translation": "\u6625\u306b\u306f\u30cb\u30b7\u30f3\u3001\u590f\u306b\u306f\u30a6\u30ca\u30ae\u3001\u79cb\u306b\u306f\u30bf\u30e9\u3001\u51ac\u306b\u306f\u30b3\u30a4\u3084\u30ce\u30fc\u30b6\u30f3\u30d1\u30a4\u30af\u3084\u30d6\u30ea\u30fc\u30e0\u306a\u3069\u304c\u898b\u3064\u304b\u308b\u305f\u3081\u305d\u306e\u82e6\u5869\u6c34\u3067\u5b63\u7bc0\u3054\u3068\u306e\u6f01\u696d\u304c\u3042\u308a\u3001\u4eca\u65e5\u3067\u3082\u6f01\u5e2b\u3068\u3044\u3046\u8077\u696d\u304c\u884c\u308f\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u3089\u306e\u7537\u6027\u305f\u3061\u306f\u3001\u305d\u306e\u5bb6\u65cf\u3068\u5171\u306b\u4f55\u4e16\u7d00\u3082\u306e\u9593\u3001\u98a8\u666f\u753b\u306e\u3088\u3046\u306a\u5730\u533a\u306b\u4f4f\u3093\u3067\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u307b\u3068\u3093\u3069\u304c\u4e38\u77f3\u3067\u8217\u88c5\u3055\u308c\u305f2\u3064\u306e\u901a\u308a\u3068\u3001\u7db2\u3092\u5e72\u3059\u5834\u6240\u3001\u305d\u3057\u3066\u4eca\u3084\u8001\u9f62\u306e\u8cb4\u5a66\u4eba\u4e8c\u4eba\u3057\u304b\u4f4f\u3093\u3067\u3044\u306a\u3044\u4fee\u9053\u9662\u304b\u3089\u6210\u308b\u5730\u57df\u3067\u3059\u3002"}
{"translation": "\u8981\u3059\u308b\u306b\u3001\u3053\u308c\u306f\u904e\u53bb\u306e\u66d6\u6627\u3067\u9b45\u529b\u7684\u306a\u6642\u9593\u304c\u307e\u3060\u606f\u3065\u3044\u3066\u3044\u308b\u3068\u932f\u899a\u3057\u3084\u3059\u3044\u3001\u6642\u9593\u304b\u3089\u53d6\u308a\u6b8b\u3055\u308c\u305f\u3088\u3046\u306a\u5834\u6240\u306e\u4e00\u3064\u3067\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u4f4e\u304f\u767d\u304f\u5857\u3089\u308c\u305f\u5bb6\u306e\u524d\u306b\u3042\u308b\u82b1\u76db\u308a\u306e\u30d0\u30e9\u306e\u6728\u3084\u9ad8\u3044\u30de\u30eb\u30d9\uff08\u30a2\u30aa\u30a4\u79d1\uff09\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u306f\u306a\u304f\u3001\u30ab\u30e9\u30d5\u30eb\u306b\u5857\u3089\u308c\u305f\u6728\u88fd\u306e\u30c9\u30a2\u3084\u5efa\u7269\u9593\u3092\u305f\u3060\u901a\u3063\u3066\u77f3\u304c\u3061\u306a\u6d77\u5cb8\u307e\u3067\u76f4\u63a5\u5c0e\u3051\u308b\u7d30\u9053\u306f\u79c1\u306e\u7279\u5225\u306a\u8a18\u61b6\u3068\u3057\u3066\u6b8b\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u3069\u3053\u308d\u304b\u3001\u6751\u306e\u4e2d\u5fc3\u90e8\u306b\u5e02\u5834\u3067\u306f\u306a\u304f\u4e00\u576a\u3060\u3051\u8986\u308f\u308c\u3066\u4e26\u3079\u3089\u308c\u3066\u3044\u305f\u5893\u5730\u304c\u3042\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u590f\u7dd1\u8272\u3067\u82e5\u3005\u3057\u3044\u30dc\u30c0\u30a4\u30b8\u30e5\uff08\u83e9\u63d0\u7956\uff09\u304b\u3089\u5f71\u304c\u5dee\u3057\u305f\u308a\u92f3\u9244\u88fd\u30d7\u30be\u30f3\u3067\u56f2\u307e\u308c\u305f\u3053\u306e\u6240\u306f\u3001\u5546\u54c1\u3092\u73fe\u91d1\u3068\u4ea4\u63db\u3059\u308b\u3053\u3068\u3092\u901a\u5e38\u3059\u308b\u3088\u3046\u306a\u5834\u6240\u3067\u3082\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u305d\u3053\u306f\u6b7b\u8005\u9054\u3082\u571f\u4e2d\u3067\u51fa\u6765\u308b\u4e8b\u304c\u884c\u308f\u308c\u3066\u3001\u201c\u4f11\u3080\u201d\u3068\u3044\u3046\u5e0c\u671b\u7684\u5e7b\u60f3\u304b\u3089\u81ea\u7531\u306b\u547c\u3070\u3070\u8a00\u8449\u3067\u3059\u3002"}
{"translation": "\u6700\u521d\u306f\u4e0d\u6109\u5feb\u611f\u3068\u601d\u308f\u308c\u305f\u79c1\u306e\u9a5a\u304d\u306f\u5927\u304d\u304f\u3001\u307e\u305f\u5897\u3048\u307e\u3057\u305f\u3002"}
{"translation": "\u305f\u3063\u305f\u4e00\u8ed2\u306e\u5973\u6027\u306e\u5bb6\u304c\u6307\u6458\u3055\u308c\u3001\u305d\u306e\u5973\u6027\u304c\u716e\u708a\u304d\u3092\u3057\u306a\u304c\u3089\u65e9\u901d\u3057\u305f\u606f\u5b50\u306e\u5893\u3092\u898b\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3053\u3068\u3001\u305d\u3057\u3066\u4f55\u4e16\u7d00\u306b\u3082\u308f\u305f\u3063\u3066\u3053\u3053\u3067\u846c\u5100\u5100\u5f0f\u3092\u62c5\u5f53\u3057\u3066\u3044\u308b\u6b7b\u8005\u30ae\u30eb\u30c9\u306e\u4f1d\u7d71\u304c\u65e2\u306b\u4ea1\u304f\u306a\u3063\u305f\u4eba\u3005\u3068\u307e\u3060\u751f\u304d\u3066\u3044\u308b\u540c\u4e00\u5bb6\u65cf\u3092\u3053\u308c\u307e\u3067\u30d1\u30b7\u30d5\u30a3\u30c3\u30af\u8af8\u5cf6\u306e\u4f4f\u6c11\u3057\u304b\u77e5\u3089\u306a\u304b\u3063\u305f\u307b\u3069\u4e92\u3044\u306b\u8fd1\u304f\u4fdd\u3064\u3088\u3046\u5c0e\u3044\u3066\u3044\u307e\u3057\u305f\u3002"}
