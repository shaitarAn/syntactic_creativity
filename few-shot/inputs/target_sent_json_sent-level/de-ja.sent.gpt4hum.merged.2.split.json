{"translation": "\u3059\u3079\u3066\u3092\u5fd8\u308c\u308b\u3053\u3068\u306f\u3001\u78ba\u304b\u306b\u6700\u60aa\u306e\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u4ee5\u4e0a\u306b\u60aa\u3044\u3053\u3068\u306f\u3001\u4f55\u3082\u5fd8\u308c\u305a\u306b\u3044\u308b\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u306a\u305c\u306a\u3089\u3059\u3079\u3066\u306e\u77e5\u8b58\u306f\u5fd8\u5374\u306b\u3088\u3063\u3066\u521d\u3081\u3066\u751f\u307f\u51fa\u3055\u308c\u308b\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u3059\u3079\u3066\u304c\u7121\u5dee\u5225\u306b\u4fdd\u5b58\u3055\u308c\u3066\u3044\u308b\u5834\u5408\u3001\u96fb\u529b\u3092\u6d88\u8cbb\u3057\u3066\u30c7\u30fc\u30bf\u3092\u4fdd\u5b58\u3059\u308b\u3088\u3046\u306a\u88c5\u7f6e\u3067\u306f\u3001\u305d\u308c\u306f\u610f\u5473\u3092\u5931\u3044\u3001\u4f7f\u3048\u306a\u3044\u60c5\u5831\u306e\u7121\u79e9\u5e8f\u306a\u96c6\u307e\u308a\u3068\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u3059\u3079\u3066\u3092\u4fdd\u5b58\u3059\u308b\u8a18\u61b6\u306f\u3001\u57fa\u672c\u7684\u306b\u306f\u4f55\u3082\u4fdd\u5b58\u3057\u3066\u3044\u306a\u3044\u3002"}
{"translation": "\u5f7c\u5973\u306f\u8a18\u61b6\u8853\u3092\u4f7f\u308f\u305a\u306b\u30015\u6b73\u304b\u3089\u306e\u6bce\u65e5\u3092\u899a\u3048\u3066\u3044\u308b\u3068\u3044\u3046\u305d\u306e\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u4eba\u306e\u5973\u6027\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u5fd8\u308c\u308b\u305f\u3081\u306e\u6280\u8853\u306f\u4e0d\u53ef\u80fd\u306a\u3053\u3068\u3067\u3042\u308b\u3002"}
{"translation": "\u306a\u305c\u306a\u3089\u3001\u305d\u306e\u3059\u3079\u3066\u306e\u30b5\u30a4\u30f3\u304c\u5b58\u5728\u3092\u793a\u3057\u3066\u3044\u308b\u304b\u3089\u3067\u3042\u308a\u3001\u305d\u308c\u304c\u4f55\u304b\u3092\u6b20\u5728\u3055\u305b\u3066\u6307\u3057\u793a\u3059\u5834\u5408\u3067\u3082\u3067\u3059\u3002"}
{"translation": "\u30ed\u30fc\u30de\u5e1d\u56fd\u3067damnatio memoriae\u306e\u7981\u6b62\u63aa\u7f6e\u306b\u906d\u9047\u3057\u305f\u307b\u3068\u3093\u3069\u3059\u3079\u3066\u306e\u4eba\u3005\u3092\u3001\u767e\u79d1\u4e8b\u5178\u306f\u540d\u524d\u3092\u6319\u3052\u3066\u4e3b\u5f35\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u81ea\u6bba\u306f\u3001\u672a\u6765\u306e\u4e0d\u78ba\u5b9f\u6027\u3092\u52dd\u3064\u6700\u3082\u5fb9\u5e95\u7684\u306a\u624b\u6bb5\u3068\u898b\u3048\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u304c\u3001\u305d\u308c\u306f\u77ed\u7e2e\u3055\u308c\u305f\u5b58\u5728\u3068\u3044\u3046\u4ee3\u511f\u3092\u6255\u3046\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u304b\u3064\u3066\u30b5\u30e2\u30b9\u5cf6\u3067\u30a2\u30a6\u30b0\u30b9\u30c8\u30a5\u30b9\u306b\u30a4\u30f3\u30c9\u306e\u4f7f\u7bc0\u56e3\u304c\u8d08\u308a\u7269\u3092\u3057\u305f\u6642\u3001\u5f7c\u3089\u304c\u6301\u3063\u3066\u304d\u305f\u3082\u306e\u306b\u306f\u864e\u3084\u8155\u306e\u306a\u3044\u82e5\u8005\uff08\u5f7c\u306f\u8db3\u3092\u624b\u306e\u3088\u3046\u306b\u4f7f\u3046\u3053\u3068\u304c\u3067\u304d\u305f\uff09\u3060\u3051\u3067\u306a\u304f\u3001\u30d6\u30e9\u30d5\u30de\u30f3\u968e\u7d1a\u51fa\u8eab\u306e\u30b6\u30eb\u30de\u30ed\u30b9\u3068\u3044\u3046\u7537\u3082\u542b\u307e\u308c\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u81ea\u5206\u81ea\u8eab\u3067\u4eba\u751f\u3092\u7d42\u3048\u308b\u3053\u3068\u3092\u8003\u3048\u3066\u304a\u308a\u3001\u305d\u308c\u306f\u81ea\u5206\u304c\u671b\u3093\u3060\u901a\u308a\u306b\u4e8b\u614b\u304c\u9032\u884c\u3057\u305f\u304b\u3089\u3060\u3068\u4f1d\u3048\u3089\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u4f55\u304b\u4e88\u60f3\u5916\u306e\u4e8b\u304c\u5f7c\u306b\u8d77\u3053\u308b\u306e\u3092\u78ba\u5b9f\u306b\u9632\u3050\u305f\u3081\u3001\u5f7c\u306f\u30a2\u30c6\u30cd\u3067\u7b11\u3063\u3066\u3001\u88f8\u3067\u3001\u6cb9\u3092\u5857\u308a\u3064\u3051\u3066\u706b\u306e\u4e2d\u306b\u98db\u3073\u8fbc\u307f\u3001\u7591\u554f\u306a\u304f\u751f\u304d\u305f\u307e\u307e\u82e6\u75db\u3092\u4f34\u3063\u3066\u713c\u6b7b\u3057\u3001\u81ea\u5206\u3067\u6c7a\u5b9a\u3057\u305f\u6b7b\u306e\u6f14\u51fa\u3068\u3057\u3066\u6b74\u53f2\u306b\u540d\u3092\u523b\u3093\u3060\u3002"}
{"translation": "\u3053\u306e\u30a8\u30d4\u30bd\u30fc\u30c9\u306f\u5947\u5999\u306a\u9038\u8a71\u3068\u3057\u3066\u4e00\u518a\u3060\u3051\u5076\u7136\u4f1d\u3048\u3089\u308c\u3066\u3044\u305f\u304b\u3064\u306680\u518a\u3042\u3063\u305f\u30ab\u30b7\u30a6\u30b9\u30fb\u30c7\u30a3\u30aa\u306e\u30ed\u30fc\u30de\u53f2\u306e1\u7bc0\u304b\u3089\u898b\u51fa\u3055\u308c\u308b\u3002"}
{"translation": "\u7d50\u5c40\u3001\u6b8b\u3063\u3066\u3044\u308b\u5168\u3066\u306f\u305f\u3060\u5358\u306b\u4f59\u3063\u305f\u3082\u306e\u3060\u3051\u3067\u3059\u3002"}
{"translation": "\u751f\u304d\u3066\u3044\u308b\u3068\u3044\u3046\u3053\u3068\u306f\u3001\u640d\u5931\u3092\u7d4c\u9a13\u3059\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u304c\u4f55\u306b\u306a\u308b\u306e\u304b\u3068\u3044\u3046\u7591\u554f\u306f\u3001\u4eba\u985e\u305d\u306e\u3082\u306e\u307b\u3069\u53e4\u3044\u3060\u308d\u3046\u3001\u4f55\u3068\u8a00\u3063\u3066\u3082\u672a\u6765\u306f\u4e88\u898b\u4e0d\u53ef\u80fd\u306a\u6027\u8cea\u3092\u6301\u3064\u3053\u3068\u3067\u7121\u304f\u3057\u3087\u3046\u304c\u306a\u3044\u307b\u3069\u306b\u4e0d\u5b89\u3092\u62b1\u304b\u305b\u3001\u305d\u308c\u6545\u306b\u6b7b\u306e\u6642\u671f\u3084\u72b6\u6cc1\u3092\u95c7\u306b\u5305\u3093\u3067\u3057\u307e\u3044\u307e\u3059\u3002"}
{"translation": "\u8ab0\u304c\u7518\u82e6\u3044\u5148\u884c\u3059\u308b\u60b2\u3057\u307f\u306e\u9632\u5fa1\u9b54\u6cd5\u3001\u4e88\u60f3\u3055\u308c\u308b\u3053\u3068\u3092\u601d\u8003\u529b\u3067\u4e88\u3081\u9632\u3054\u3046\u3068\u3059\u308b\u904b\u547d\u7684\u306a\u885d\u52d5\u3092\u77e5\u3089\u306a\u3044\u3067\u3059\u304b\uff1f \u4eba\u3005\u306f\u5c06\u6765\u306e\u8352\u5ec3\u3092\u4e88\u611f\u3057\u3001\u53ef\u80fd\u6027\u306e\u3042\u308b\u707d\u5bb3\u3092\u60f3\u50cf\u3057\u3001\u305d\u308c\u306b\u3088\u3063\u3066\u4e88\u671f\u3057\u306a\u3044\u60aa\u4e8b\u304b\u3089\u81ea\u5206\u3092\u5b88\u308b\u3060\u308d\u3046\u3068\u601d\u3044\u8fbc\u3080\u3002"}
{"translation": "\u53e4\u4ee3\u3067\u306f\u3001\u5922\u306f\u6170\u3081\u3092\u7d04\u675f\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u306a\u305c\u306a\u3089\u3001\u30ae\u30ea\u30b7\u30e3\u4eba\u305f\u3061\u306f\u5f7c\u3089\u304c\u4e88\u8a00\u3059\u308b\u3088\u3046\u306b\u5922\u3092\u4f1d\u3048\u3001\u672a\u6765\u306e\u51fa\u6765\u4e8b\u3092\u4e88\u8a00\u3057\u3001\u78ba\u5b9a\u7684\u3067\u306f\u3042\u308b\u304c\u672a\u6765\u306e\u4e0d\u78ba\u5b9a\u6027\u3068\u3044\u3046\u6050\u6016\u3092\u53d6\u308a\u9664\u3044\u305f\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u6b7b\u306e\u6050\u6016\u304b\u3089\u9003\u308c\u308b\u305f\u3081\u306b\u81ea\u5206\u306e\u547d\u3092\u7d76\u3064\u4eba\u3082\u5c11\u306a\u304f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u904e\u53bb\u3092\u8a18\u61b6\u306b\u7559\u3081\u3001\u5fd8\u5374\u306b\u963b\u3080\u305f\u3081\u306e\u6226\u7565\u306f\u591a\u7a2e\u591a\u69d8\u3067\u3059\u3002 \u4f1d\u627f\u3092\u4fe1\u3058\u308b\u306a\u3089\u3001\u6211\u3005\u306e\u6b74\u53f2\u8a18\u8ff0\u306e\u6700\u521d\u306b\u306f\u3001\u30da\u30eb\u30b7\u30a2\u4eba\u3068\u30ae\u30ea\u30b7\u30e3\u4eba\u306e\u9593\u3067\u7e70\u308a\u5e83\u3052\u3089\u308c\u305f\u4e00\u9023\u306e\u58ca\u6ec5\u7684\u306a\u6226\u4e89\u304c\u3042\u308a\u3001\u4eca\u65e5\u3067\u306f\u307b\u3068\u3093\u3069\u5fd8\u308c\u53bb\u3089\u308c\u3066\u3057\u307e\u3063\u305f\u8a18\u61b6\u8853\u306e\u59cb\u307e\u308a\u306b\u306f\u591a\u6570\u306e\u72a0\u7272\u8005\u3092\u51fa\u3057\u305f\u4e0d\u904b\u304c\u3042\u308b\u3068\u3055\u308c\u3066\u3044\u307e\u3059\uff1a \u305d\u308c\u306f\u7d00\u5143\u524d5\u4e16\u7d00\u306e\u521d\u3081\u3001\u30c6\u30c3\u30b5\u30ea\u30a2\u3067\u306e\u3053\u3068\u3067\u3057\u305f\u3002 \u3042\u308b\u4e16\u7d00\u3001\u5012\u58ca\u3059\u308b\u5bb6\u304c\u795d\u796d\u306e\u53c2\u52a0\u8005\u5168\u54e1\u3092\u62bc\u3057\u3064\u3076\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u552f\u4e00\u306e\u751f\u5b58\u8005\u3067\u3042\u3063\u305f\u8a69\u4eba\u30b7\u30e2\u30cb\u30c7\u30b9\u30fb\u30aa\u30d6\u30fb\u30ad\u30aa\u30b9\u306f\u5f7c\u306e\u8a13\u7df4\u3055\u308c\u305f\u8a18\u61b6\u529b\u3092\u983c\u308a\u306b\u7cbe\u795e\u7684\u306b\u7834\u58ca\u3055\u308c\u305f\u5efa\u7269\u306b\u518d\u5ea6\u5165\u308a\u3001\u30b2\u30b9\u30c8\u306e\u5ea7\u5e2d\u914d\u7f6e\u3092\u601d\u3044\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u3053\u308c\u306b\u3088\u308a\u3001\u304c\u308c\u304d\u3067\u5909\u5f62\u3057\u305f\u907a\u4f53\u3092\u7279\u5b9a\u3059\u308b\u3053\u3068\u304c\u53ef\u80fd\u3068\u306a\u308a\u307e\u3057\u305f\u3002 \u6b7b\u3068\u751f\u306e\u30a8\u30f3\u30b2\u30fc\u30b8\u30aa\u30d9\u30fc\u30eb\u304b\u3089\u751f\u3058\u308b\u6570\u591a\u306e\u30d1\u30e9\u30c9\u30c3\u30af\u30b9\u306b\u306f\u3001\u6b21\u306e\u3088\u3046\u306a\u3082\u306e\u304c\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u4e00\u65b9\u3067\u4ea1\u304f\u306a\u3063\u305f\u4eba\u3092\u6c7a\u3057\u3066\u53d6\u308a\u623b\u3059\u3053\u3068\u304c\u3067\u304d\u306a\u3044\u5b58\u5728\u3068\u3057\u3066\u6307\u540d\u3059\u308b\u3053\u3068\u306b\u3088\u308a\u3001\u305d\u306e\u55aa\u5931\u3078\u306e\u60bc\u307f\u306f\u540c\u6642\u306b\u500d\u5316\u3057\u534a\u6e1b\u3057\u307e\u3059\u3002"}
{"translation": "\u4e00\u65b9\u3067\u3001\u884c\u65b9\u4e0d\u660e\u8005\u3084\u6d88\u3048\u305f\u4eba\u7269\u306e\u904b\u547d\u304c\u4e0d\u660e\u306a\u5834\u5408\u3001\u5bb6\u65cf\u306f\u6050\u6016\u5fc3\u304b\u3089\u5e0c\u671b\u3092\u62b1\u304d\u3064\u3064\u53d7\u3051\u5165\u308c\u3089\u308c\u3066\u3044\u306a\u3044\u60b2\u3057\u307f\u304b\u3089\u9003\u308c\u3089\u308c\u305a\u3001\u305d\u308c\u306f\u6cbb\u7642\u3082\u751f\u5b58\u3082\u963b\u5bb3\u3057\u307e\u3059\u3002"}
{"translation": "\u6b7b\u306e\u533a\u5207\u308a\u306f\u3001\u907a\u7523\u3068\u8a18\u61b6\u306e\u59cb\u70b9\u3067\u3042\u308a\u3001\u6b7b\u8005\u3078\u306e\u5f14\u3044\u304c\u3059\u3079\u3066\u306e\u6587\u5316\u306e\u6839\u6e90\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u306b\u3088\u308a\u3001\u6025\u306b\u9759\u307e\u308a\u304b\u3048\u3063\u305f\u7a7a\u9593\u3092\u6b4c\u3084\u7948\u308a\u3084\u7269\u8a9e\u3067\u6e80\u305f\u3057\u3001\u3082\u3046\u5b58\u5728\u3057\u306a\u3044\u3082\u306e\u304c\u518d\u5ea6\u6d3b\u6c17\u4ed8\u3051\u3089\u308c\u307e\u3059\u3002"}
{"translation": "\u5931\u308f\u308c\u305f\u7d4c\u9a13\u306f\u3001\u54c0\u308c\u3080\u3079\u304d\u3082\u306e\u306e\u8f2a\u90ed\u3092\u6d6e\u304b\u3073\u4e0a\u304c\u3089\u305b\u308b\u7a7a\u6d1e\u578b\u306e\u5f62\u3068\u306a\u308a\u3001\u307e\u305f\u307e\u308c\u306b\u3067\u306f\u3042\u308b\u3082\u306e\u306e\u3001\u305d\u308c\u306f\u55aa\u5931\u611f\u304c\u7f8e\u5316\u3057\u305f\u5149\u306b\u3088\u3063\u3066\u6b32\u671b\u306e\u5bfe\u8c61\u307e\u3067\u6607\u83ef\u3059\u308b\u3053\u3068\u3059\u3089\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u306f\u307e\u3055\u306b\u65b0\u578b\u30d6\u30e9\u30a4\u30e0\u56f3\u66f8\u9928\u7248\u4e00\u518a\u306e\u5e8f\u6587\u3067\u30cf\u30a4\u30c7\u30eb\u30d9\u30eb\u30b0\u5927\u5b66\u52d5\u7269\u5b66\u6559\u6388\u304c\u8ff0\u3079\u3066\u3044\u305f\u901a\u308a\u3067\u3059\u3002"}
{"translation": "\u300c\u897f\u6d0b\u4eba\u9593\u304c\u7406\u89e3\u3067\u304d\u308b\u7bc4\u56f2\u5916\u3067\u3082\u3042\u308a\u307e\u3059\u304c\u3001\u5f7c\u306f\u5931\u308f\u308c\u305f\u3082\u306e\u3092\u672a\u3060\u5b58\u5728\u3057\u3066\u3044\u308b\u3082\u306e\u3088\u308a\u9ad8\u304f\u8a55\u4fa1\u3057\u307e\u3059\u3002"}
{"translation": "\u305d\u3046\u3067\u306a\u3051\u308c\u3070\u888b\u72fc\u304b\u3089\u767a\u6563\u3059\u308b\u5947\u5999\u306a\u9b45\u529b\u3092\u8aac\u660e\u3057\u304d\u308c\u307e\u305b\u3093\u300d"}
{"translation": "\u6b7b\u3068\u3001\u305d\u308c\u306b\u4f34\u3046\u7a81\u7136\u4eba\u306e\u5b58\u5728\u304c\u6d88\u3048\u53bb\u308b\u4e00\u65b9\u3067\u907a\u7269\u3084\u907a\u4f53\u307e\u3067\u306e\u6240\u6709\u7269\u304c\u6b8b\u3055\u308c\u308b\u3068\u3044\u3046\u554f\u984c\u3078\u3069\u3046\u5411\u304d\u5408\u3046\u304b\u306f\u3001\u6642\u9593\u3092\u7d4c\u3066\u7b54\u3048\u3092\u6c42\u3081\u3089\u308c\u3001\u884c\u52d5\u3092\u5f15\u304d\u8d77\u3053\u3059\u8981\u56e0\u3068\u306a\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u3053\u308c\u3089\u306e\u884c\u70ba\u306f\u5358\u306a\u308b\u76ee\u7684\u3092\u8d85\u3048\u3066\u610f\u7fa9\u3092\u6301\u3061\uff0c\u79c1\u305f\u3061\u306e\u65e9\u3044\u7956\u5148\u304c\u52d5\u7269\u754c\u304b\u3089\u4eba\u9593\u754c\u3078\u8e0f\u307f\u51fa\u3059\u624b\u52a9\u3051\u3068\u306a\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u6b7b\u3093\u3060\u540c\u7a2e\u65cf\u306e\u907a\u4f53\u3092\u81ea\u7136\u306e\u5206\u89e3\u30d7\u30ed\u30bb\u30b9\u306b\u4efb\u305b\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u305d\u308c\u3092\u51e6\u7406\u3059\u308b\u3053\u3068\u306f\u4e00\u822c\u7684\u306b\u4eba\u9593\u306e\u7279\u6027\u3068\u3055\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u4ed6\u306e\u9ad8\u7b49\u52d5\u7269\u3067\u3082\u540c\u3058\u3088\u3046\u306a\u884c\u52d5\u304c\u89b3\u5bdf\u3055\u308c\u307e\u3059\uff1a \u4f8b\u3048\u3070\u3001\u8c61\u306f\u6b7b\u306b\u304b\u3051\u305f\u7fa4\u308c\u306e\u4ef2\u9593\u5468\u56f2\u306b\u96c6\u307e\u308a\u3001\u4f55\u6642\u9593\u3082\u9f3b\u3067\u89e6\u308a\u306a\u304c\u3089\u61a4\u6168\u3057\u3066\u30bf\u30f3\u30dd\u3092\u9cf4\u3089\u3057\u3001\u6700\u7d42\u7684\u306b\u907a\u4f53\u3092\u571f\u3068\u679d\u3067\u8986\u3046\u524d\u306b\u7121\u751f\u547d\u306e\u4f53\u3092\u7acb\u3061\u4e0a\u304c\u3089\u305b\u3088\u3046\u3068\u3057\u3070\u3057\u3070\u8a66\u307f\u307e\u3059\u3002"}
{"translation": "\u307e\u305f\u3001\u5f7c\u3089\u306f\u4f55\u5e74\u3082\u5f8c\u306b\u306a\u3063\u3066\u3082\u5b9a\u671f\u7684\u306b\u305d\u306e\u81e8\u7d42\u306e\u5834\u6240\u3092\u8a2a\u308c\u308b\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u305d\u308c\u306b\u306f\u9593\u9055\u3044\u306a\u304f\u826f\u597d\u306a\u8a18\u61b6\u529b\u304c\u5fc5\u8981\u3067\u3001\u304a\u305d\u3089\u304f\u306f\u4e00\u5b9a\u306e\u3042\u306e\u4e16\u89b3\u304c\u5fc5\u8981\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u305d\u308c\u3092\u79c1\u305f\u3061\u306f\u81ea\u5206\u9054\u306e\u3082\u306e\u3068\u540c\u3058\u304f\u73fe\u5b9f\u5473\u96e2\u308c\u3057\u305f\u3082\u306e\u3068\u3057\u3066\u3001\u540c\u3058\u304f\u78ba\u8a8d\u4e0d\u80fd\u306a\u5f62\u3067\u60f3\u50cf\u3059\u308b\u3053\u3068\u304c\u8a31\u3055\u308c\u307e\u3059\u3002"}
{"translation": "\u3053\u306e\u672c\u306e\u4f5c\u696d\u304c\u307b\u307c\u7d42\u4e86\u3057\u3001\u5206\u89e3\u3068\u7834\u58ca\u306e\u591a\u69d8\u306a\u73fe\u8c61\u304c\u4e3b\u5f79\u3092\u6f14\u3058\u3066\u3044\u308b\u3053\u3068\u3092\u3001\u79c1\u306f\u4eca\u521d\u3081\u3066\u7406\u89e3\u3057\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u306f\u57fa\u672c\u7684\u306b\u6b7b\u3068\u5411\u304d\u5408\u3046\u7121\u6570\u306e\u65b9\u6cd5\u306e\u4e00\u3064\u3067\u3001\u30d8\u30ed\u30c9\u30c8\u30b9\u306b\u8a9e\u3089\u308c\u305fKallatier\u4eba\u306e\u7fd2\u6163\u3067\u306f\u3001\u4ea1\u304f\u306a\u3063\u305f\u89aa\u3092\u98df\u3079\u308b\u5100\u5f0f\u3082\u6050\u308d\u3057\u304f\u601d\u3046\u3060\u3051\u3067\u3042\u308a\u3001\u305d\u308c\u81ea\u4f53\u304c\u30ae\u30ea\u30b7\u30e3\u4eba\u304c\u706b\u846c\u3059\u308b\u98a8\u7fd2\u304b\u3089\u805e\u304f\u3060\u3051\u3067\u3082\u6050\u6016\u611f\u3058\u305f\u3060\u3051\u3067\u3059\u3002"}
{"translation": "\u306a\u305c\u306a\u3089\u3001\u81ea\u5206\u306e\u6b7b\u3092\u7d76\u3048\u305a\u5fc3\u306b\u7559\u3081\u3066\u3044\u308b\u4eba\u304c\u751f\u547d\u306b\u8fd1\u3044\u306e\u304b\u3001\u305d\u308c\u3068\u3082\u6b7b\u3092\u8ffd\u3044\u51fa\u3059\u3053\u3068\u306b\u6210\u529f\u3059\u308b\u4eba\u304c\u8fd1\u3044\u306e\u304b\u3001\u5168\u3066\u304c\u7d42\u308f\u308a\u3092\u8fce\u3048\u308b\u3068\u3044\u3046\u8003\u3048\u65b9\u304c\u6050\u308d\u3057\u3044\u304b\u3001\u305d\u306e\u53cd\u5bfe\u3067\u7d42\u308f\u308a\u304c\u306a\u3044\u65b9\u304c\u6050\u308d\u3057\u3044\u3060\u308d\u3046\u304b\u3001\u3053\u306e\u3088\u3046\u306a\u554f\u984c\u306b\u3064\u3044\u3066\u306f\u898b\u89e3\u304c\u5927\u304d\u304f\u5206\u304b\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3082\u3061\u308d\u3093\u3001\u305d\u308c\u4ee5\u524d\u306b\u4ed6\u306e\u6ce8\u76ee\u3059\u3079\u304d\u5893\u5730\u3092\u8a2a\u308c\u305f\u3053\u3068\u306f\u3042\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u4f8b\u3048\u3070\u3001\u9ad8\u3044\u8d64\u30ec\u30f3\u30ac\u306e\u58c1\u3067\u3001\u30f4\u30a7\u30cd\u30c1\u30a2\u306e\u30e9\u30b0\u30fc\u30f3\u306e\u9752\u7dd1\u8272\u306e\u6c34\u304b\u3089\u305d\u3073\u3048\u7acb\u3064\u7121\u6575\u8981\u585e\u306e\u3088\u3046\u306a\u6b7b\u8005\u306e\u5cf6\u30b5\u30f3\u30fb\u30df\u30b1\u30fc\u30ec\u3084\u3001\u30e1\u30ad\u30b7\u30b3\u4eba\u53e3\u306b\u3088\u3063\u3066\u6bce\u5e74\u884c\u308f\u308c\u308b\u30c7\u30a3\u30a2\u30fb\u30c7\u30fb\u30ed\u30b9\u30fb\u30e0\u30a8\u30eb\u30c8\u30b9\u796d\u308a\u3067\u306e\u30cf\u30ea\u30a6\u30c3\u30c9\u30d5\u30a9\u30fc\u30a8\u30d0\u30fc\u30bb\u30e1\u30bf\u30ea\u30fc\u3067\u751f\u3058\u308b\u6d3e\u624b\u306a\u5e02\u5834\u751f\u6d3b\u3002"}
{"translation": "\u7f8e\u3057\u304f\u98fe\u3089\u308c\u305f\u5893\u77f3\u3068\u3001\u767a\u9054\u3057\u305f\u8150\u6557\u306b\u3088\u3063\u3066\u6c38\u9060\u306b\u82e6\u7b11\u3044\u3055\u305b\u3089\u308c\u308b\u30ab\u30e9\u30d5\u30eb\u306a\u7802\u7cd6\u3084\u7d19\u7c98\u571f\u88fd\u306e\u6b7b\u8005 \u306e\u982d\u84cb\u9aa8\u304c\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u6570\u5e74\u524d\u306e\u3042\u308b8\u6708\u306e\u65e5\u3001\u79c1\u306f\u5317\u90e8\u306e\u90fd\u5e02\u3092\u8a2a\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u3001\u9060\u3044\u6c37\u6cb3\u671f\u306b\u7531\u6765\u3059\u308b\u6d77\u306e\u5165\u308a\u6c5f\u306e\u6700\u5f8c\u306e\u7a81\u51fa\u90e8\u306b\u4f4d\u7f6e\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u306e\u5165\u308a\u6c5f\u306f\u9678\u5730\u306e\u6df1\u90e8\u307e\u3067\u5e83\u304c\u3063\u3066\u304a\u308a\u3001\u6625\u306b\u306f\u30cb\u30b7\u30f3\u3001\u590f\u306b\u306f\u30a6\u30ca\u30ae\u3001\u79cb\u306b\u306f\u30bf\u30e9\u3001\u51ac\u306b\u306f\u30b3\u30a4\u3001\u30d1\u30a4\u30af\u3068\u30d6\u30ea\u30fc\u30e0\u304c\u305d\u306e\u6c7d\u6c34\u3067\u898b\u3064\u304b\u308b\u305f\u3081\u3001\u3053\u3053\u3067\u306f\u73fe\u4ee3\u3067\u3082\u6f01\u5e2b\u3068\u3044\u3046\u8077\u696d\u304c\u884c\u308f\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u3089\u306e\u7537\u305f\u3061\u306f\u3001\u5bb6\u65cf\u3068\u5171\u306b\u4f55\u4e16\u7d00\u3082\u306e\u9593\u3001\u98a8\u666f\u753b\u306e\u3088\u3046\u306a\u5730\u533a\u3092\u4f4f\u307e\u3044\u3068\u3057\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u3001\u77f3\u7573\u306e\u901a\u308a\u304c\u307b\u3093\u306e\u4e8c\u3064\u3042\u308b\u3060\u3051\u3067\u3001\u7db2\u3092\u5e72\u3059\u5834\u6240\u304c\u3042\u308a\u3001\u4fee\u9053\u9662\u65bd\u8a2d\u306f\u3082\u306f\u3084\u8001\u9f62\u304b\u3064\u8cb4\u65cf\u306e\u5973\u6027\u4e8c\u4eba\u3057\u304b\u4f4f\u3093\u3067\u3044\u306a\u3044\u3082\u306e\u3067\u3059\u3002"}
{"translation": "\u8981\u3059\u308b\u306b\u3001\u305d\u308c\u306f\u307e\u308b\u3067\u6642\u9593\u304b\u3089\u53d6\u308a\u6b8b\u3055\u308c\u305f\u3088\u3046\u306a\u5834\u6240\u306e\u4e00\u3064\u3067\u3042\u308a\u3001\u3042\u3044\u307e\u3044\u3067\u9b45\u529b\u7684\u306a\u904e\u53bb\u3092\u751f\u304d\u3066\u3044\u308b\u304b\u306e\u3088\u3046\u306b\u8aa4\u89e3\u3057\u3084\u3059\u3044\u8a98\u60d1\u306b\u9665\u3063\u3066\u3057\u307e\u3046\u5834\u6240\u3067\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u4f4e\u3044\u767d\u304f\u5857\u3089\u308c\u305f\u5bb6\u306e\u524d\u306b\u54b2\u304f\u30d0\u30e9\u306e\u8302\u307f\u3084\u9ad8\u3044\u30de\u30eb\u30f4\u30a1\uff08\u30a2\u30aa\u30a4\u79d1\u306e\u690d\u7269\uff09\u3001\u305d\u306e\u30ab\u30e9\u30d5\u30eb\u306b\u63cf\u304b\u308c\u305f\u6728\u88fd\u306e\u30c9\u30a2\u3084\u3001\u5efa\u7269\u9593\u3092\u901a\u308a\u629c\u3051\u3066\u77f3\u304c\u3061\u306a\u6d77\u5cb8\u3078\u3068\u76f4\u7d50\u3059\u308b\u7d30\u3044\u8def\u5730\u3053\u305d\u304c\u7279\u5225\u306a\u8a18\u61b6\u3068\u3057\u3066\u79c1\u306e\u5fc3\u306b\u6b8b\u3063\u3066\u3044\u308b\u308f\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u305d\u308c\u3088\u308a\u3082\u3001\u9a5a\u304d\u3060\u3063\u305f\u306e\u306f\u79c1\u304c\u96c6\u843d\u306e\u4e2d\u5fc3\u3067\u5e02\u5834\u3067\u306f\u306a\u304f\u5893\u5730\u3092\u898b\u3064\u3051\u305f\u3068\u3044\u3046\u4e8b\u5b9f\u3067\u3059\u3002"}
{"translation": "\u590f\u7dd1\u306e\u82e5\u3044\u83e9\u63d0\u6a39\u306b\u56f2\u307e\u308c\u3001\u92f3\u9244\u88fd\u306e\u67f5\u3067\u9589\u3058\u8fbc\u3081\u3089\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u3053\u3067\u3064\u307e\u308a\u5546\u54c1\u3068\u304a\u91d1\u304c\u4ea4\u63db\u3055\u308c\u308b\u5834\u6240\u3067\u306f\u306a\u304f\u3001\u4ea1\u8005\u305f\u3061\u304c\u571f\u4e2d\u3067\u4e00\u822c\u7684\u306b\u300c\u5b89\u606f\u300d\u3068\u79f0\u3055\u308c\u308b\u884c\u52d5\u3092\u3057\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u79c1\u304c\u6700\u521d\u306b\u4e0d\u5feb\u3060\u3068\u601d\u3063\u305f\u9a5a\u304d\u306f\u5927\u304d\u304f\u3001\u3055\u3089\u306b\u305d\u306e\u9a5a\u304d\u306f\u5897\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u3001\u6599\u7406\u4e2d\u306e\u5973\u6027\u306e\u5bb6\u3092\u6307\u6458\u3055\u308c\u3001\u5f7c\u5973\u304c\u81ea\u5206\u306e\u30ad\u30c3\u30c1\u30f3\u304b\u3089\u65e9\u4e16\u3057\u305f\u606f\u5b50\u306e\u5893\u3092\u898b\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3053\u3068\u306b\u52d8\u4ed8\u304b\u3055\u308c\u305f\u3068\u304d\u306e\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u79c1\u306f\u660e\u3089\u304b\u306b\u306a\u308a\u307e\u3057\u305f\u3001\u4f55\u4e16\u7d00\u3082\u524d\u304b\u3089\u5b58\u5728\u3059\u308b\u3053\u306e\u5730\u65b9\u3067\u55aa\u846c\u5100\u5f0f\u3092\u884c\u3046\u6b7b\u8005\u30ae\u30eb\u30c9\uff08\u4ea1\u8005\u516c\u4f1a\uff09\u306e\u4f1d\u7d71\u304c\u3059\u3067\u306b\u4ea1\u304f\u306a\u3063\u305f\u4eba\u3005\u3068\u307e\u305f\u30b0\u30ea\u30fc\u30f4\u30a3\u30f3\u30b0\uff08\u751f\u8005\uff09\u540c\u4e00\u5bb6\u65cf\u3092\u540c\u3058\u3088\u3046\u306b\u8fd1\u3065\u3051\u3066\u3044\u304f\u3088\u3046\u5c0e\u3044\u3066\u3044\u305f\u3093\u3060\u3001\u305d\u3057\u3066\u79c1\u304c\u3053\u308c\u307e\u3067\u77e5\u3063\u3066\u3044\u305f\u4eba\u3005\u3057\u304b\u305d\u3093\u306a\u98a8\u666f\u77e5\u308a\u307e\u305b\u3093\u3067\u3057\u305f"}
{"translation": "\u4e00\u90e8\u592a\u5e73\u6d0b\u8af8\u5cf6\u3002"}
