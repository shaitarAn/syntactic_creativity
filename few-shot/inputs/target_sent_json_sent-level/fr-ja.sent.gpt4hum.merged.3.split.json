{"translation": "\u524d\u8155\u306b\u984d\u3092\u62bc\u3057\u5f53\u3066\u3001\u982c\u306f\u65b0\u9bae\u306a\u30c6\u30ad\u30b9\u30c8\u306e\u4e0a\u306b\u5bc4\u305b\u308b\u3002 \u30c7\u30b9\u30af\u306e\u6728\u304c\u79c1\u306e\u5fc3\u81d3\u306e\u9f13\u52d5\u3092\u5897\u5e45\u3055\u305b\u307e\u3059\u3002"}
{"translation": "\u53e4\u3044\u30a2\u30fc\u30eb\u30c7\u30b3\u306e\u5bb6\u5177\u306f\u3001\u611f\u60c5\u3084\u75b2\u308c\u3092\u3046\u307e\u304f\u5c0e\u304f\u3002 \u30eb\u30fc\u30eb\u30de\u30f3\uff1f \u30eb\u30eb\uff1f \u5f7c\u306f\u591a\u304f\u306e\u3053\u3068\u3092\u898b\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u79c1\u306f\u5fc3\u306e\u58f0\u3092\u805e\u3044\u3066\u3044\u307e\u3059\u3001\u91d1\u66dc\u65e5\u306e\u53e4\u304d\u5fc3\u306e\u58f0\u3092\u3001\u9759\u5bc2\u306b\u5305\u307e\u308c\u305f\u5bb6\u3067\u3002"}
{"translation": "\u3053\u306e\u6642\u9593\u306b\u306a\u308b\u3068\u307f\u3093\u306a\u5e30\u3063\u3066\u3057\u307e\u3063\u3066\u3001\u79c1\u3060\u3051\u304c\u8239\u4e0a\u306b\u6b8b\u3055\u308c\u3066\u3044\u308b\u3002"}
{"translation": "\u58ca\u6ec5\u7684\u306a\u72b6\u614b\u3060\u3002"}
{"translation": "\u51fa\u767a\u306e\u6e96\u5099\u3092\u3059\u308b\u6c17\u529b\u3082\u6b8b\u3063\u3066\u3044\u306a\u3044\u3002"}
{"translation": "\u9031\u672b\u306b\u6301\u3061\u5e30\u3089\u306d\u3070\u306a\u3089\u306a\u3044\u539f\u7a3f\u306e\u5c71\u3092\u7247\u4ed8\u3051\u308b\u6c17\u529b\u306f\u3082\u3063\u3068\u7121\u3044\u3002"}
{"translation": "\u6bce\u9031\u91d1\u66dc\u65e5\u306e\u3088\u3046\u306b\u3002"}
{"translation": "\u305d\u308c\u306a\u3089\u3042\u306a\u305f\u306f\u77e5\u3063\u3066\u3044\u308b\u3093\u3067\u3059\u306d\u3002"}
{"translation": "\u5f7c\u304c\u305d\u308c\u3092\u3042\u306a\u305f\u306b\u6301\u3063\u3066\u884c\u304f\u3088\u3046\u306b\u79c1\u306b\u8a00\u3063\u305f\u306e\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u306f\u4f55\u3067\u3059\u304b\uff1f \u305d\u308c\u306f\u96fb\u5b50\u66f8\u7c4d\u30ea\u30fc\u30c0\u30fc\u3084\u3001eBook\u3084\u3001iPad\u3001\u79c1\u306b\u306f\u308f\u304b\u3089\u306a\u3044\u3051\u3069\u306d\u3002"}
{"translation": "\u5f7c\u306f\u3001\u9031\u672b\u306b\u5411\u3051\u3066\u3042\u306a\u305f\u306e\u5168\u3066\u306e\u539f\u7a3f\u3092\u305d\u3053\u306b\u5165\u308c\u3066\u304a\u304d\u3001\u305d\u308c\u304c\u3042\u306a\u305f\u306e\u8ca0\u62c5\u3092\u8efd\u304f\u3059\u308b\u3060\u308d\u3046\u3068\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u8aac\u660e\u3057\u307e\u3057\u3087\u3046\u304b\uff1f \u3054\u89a7\u4e0b\u3055\u3044\u3001\u3053\u308c\u306f\u7686\u3055\u3093\u306e\u539f\u7a3f\u304c\u3059\u3079\u3066\u8868\u793a\u3055\u308c\u308b\u753b\u9762\u306e\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002"}
{"translation": "\u5f7c\u3089\u306f\u3001\u507d\u308a\u306e\u672c\u7269\u306e\u6728\u88fd\u3067\u4f5c\u3089\u308c\u305f\u4eee\u60f3\u306e\u68da\u306b\u3044\u307e\u3059\u3002"}
{"translation": "\u3042\u306a\u305f\u304c\u305d\u308c\u3089\u306b\u89e6\u308c\u308b\u3068\u3001\u305d\u308c\u3089\u306f\u958b\u304d\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u306f\u4e00\u7d44\u306b\u306a\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u3092\u4e8c\u65e5\u3067\u5168\u90e8\u8aad\u307f\u7d42\u3048\u308b\u306a\u3093\u3066\u7121\u7406\u3067\u3057\u3087\uff01"}
{"translation": "\u898b\u3066\u304f\u3060\u3055\u3044\u3001\u30c6\u30ad\u30b9\u30c8\u304c\u958b\u304d\u307e\u3059\u3002"}
