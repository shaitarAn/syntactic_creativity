{"translation": "\u300c\u5618\u3064\u304d\u3060\u300d\u3068\u79c1\u306f\u601d\u3063\u305f\u3002"}
{"translation": "\u30ad\u30fc\u30c1\u30a7\u30fc\u30f3\u3068\u5c0f\u6307\u306e\u30ea\u30f3\u30b0\u306f\u3001\u300c\u30d1\u30f3\u5207\u308c\u4e00\u500b\u5206\u306e\u624b\u7d19\u300d\u3068\u306f\u898b\u305f\u76ee\u304c\u3042\u3063\u3066\u3044\u307e\u305b\u3093\u3067\u3057\u305f\u3057\u3001\u30ab\u30df\u30fc\u30b7\u30e7\u30d5\u306e\u9854\u3092\u3001\u308f\u305a\u304b\u306b\u898b\u3048\u308b\u3088\u304f\u89b3\u5bdf\u529b\u306e\u3042\u308b\u76ee\u306b\u6349\u3048\u3089\u308c\u308b\u96f2\u304c\u901a\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u666e\u6bb5\u304b\u3089\u3046\u305d\u3092\u3064\u304f\u3053\u3068\u304c\u5c11\u306a\u3044\u4eba\u3005\u306e\u9854\u4e0a\u3060\u3051\u306b\u898b\u3089\u308c\u308b\u3082\u306e\u3060\u3063\u305f\u3002"}
{"translation": "\u300c\u3042\u306a\u305f\u306e\u7269\u8a9e\u306e\u7b4b\u7acb\u3066\u306f\u4f55\u3067\u3059\u304b\uff1f\u300d\u3068\u79c1\u306f\u5c0b\u306d\u307e\u3057\u305f\u3002"}
{"translation": "\u7269\u8a9e\u306e\u7b4b\u7acb\u3066\u3002"}
{"translation": "\u3069\u3046\u8a00\u3048\u3070\u3044\u3044\u3067\u3057\u3087\u3046\u304b\uff1f"}
{"translation": "\u7b4b\u66f8\u304d\u306f\u65b0\u3057\u304f\u306a\u3044\u3002"}
{"translation": "\u611b\u3001\u6bba\u4eba\u3002"}
{"translation": "\u3042\u306a\u305f\u304c\u8aad\u3093\u3067\u307f\u308c\u3070\u308f\u304b\u308a\u307e\u3059\u3088\u3002"}
{"translation": "\u300c\u88c1\u5224\u5b98\u306e\u624b\u8a18\u304b\u3089\u300d"}
{"translation": "\u30ab\u30df\u30fc\u30b7\u30a7\u30d5\u306f\u89aa\u5207\u306a\u773c\u5dee\u3057\u3067\u79c1\u3092\u898b\u4e0a\u3052\u3001\u9759\u304b\u306b\u7b11\u3063\u305f\u3002"}
{"translation": "\u3046\u3093\u3056\u308a\u3059\u308b\u3088\u3046\u306a\u4ed5\u4e8b\u3002"}
{"translation": "\u5f7c\u306f\u50cd\u304d\u7d9a\u3051\u3001\u6700\u5f8c\u306b\u306f\u624b\u3092\u632f\u3063\u3066\u8f9e\u3081\u3066\u3057\u307e\u3063\u305f\u3002"}
{"translation": "\u79c1\u306e\u4ed5\u4e8b\u3082\u4eca\u306f\u306a\u3044\u3057\u3001\u98df\u3079\u308b\u3082\u306e\u3082\u307b\u3068\u3093\u3069\u306a\u3044\u3002"}
{"translation": "\u3082\u3057\u3001\u79c1\u306e\u7269\u8a9e\u306e\u4fa1\u5024\u3092\u8003\u616e\u305b\u305a\u306b\u5370\u5237\u3059\u308b\u306a\u3089\u3001\u305d\u308c\u306f\u79c1\u306b\u3068\u3063\u3066\u501f\u308a\u4ee5\u4e0a\u306e\u6069\u5bf5\u3068\u306a\u308b\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u79c1\u3092\u52a9\u3051\u3066\u304f\u308c\u308b\u3002"}
{"translation": "\u65b0\u805e\u306f\u6148\u5584\u4e8b\u696d\u3067\u3082\u306a\u3051\u308c\u3070\u3001\u96e3\u6c11\u53ce\u5bb9\u6240\u3067\u3082\u306a\u3044\u3002"}
{"translation": "\u305d\u308c\u306f\u77e5\u3063\u3066\u3044\u307e\u3059\u304c\u3002"}
{"translation": "\u3069\u3046\u304b\u3001\u3054\u89aa\u5207\u306b\u304a\u9858\u3044\u3057\u307e\u3059\u3002"}
{"translation": "\u3068\u3066\u3082\u3046\u308c\u3057\u3044\u3067\u3059\u3002"}
{"translation": "\u4f55\u304b\u304a\u624b\u4f1d\u3044\u3067\u304d\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u304b\uff1f"}
{"translation": "\u300c\u59cb\u307e\u308a\u3064\u3064\u3042\u308b\u6751\u3078\u884c\u304d\u305f\u3044\u3068\u9858\u3063\u3066\u3044\u308b\u8005\u304c\u300d\u3001\u5f7c\u306f\u6073\u7136\u3068\u3057\u305f\u77b3\u3067\u5e8a\u3092\u898b\u3064\u3081\u306a\u304c\u3089\u7d9a\u3051\u305f\uff1a \u300c\u3042\u306a\u305f\u306e\u65b0\u805e\u3067\u5370\u5237\u3057\u305f\u3044\u5c0f\u3055\u306a\u7269\u8a9e\u3092\u79c1\u306f\u6301\u3063\u3066\u304d\u307e\u3057\u305f\u3002\u300d \u300c\u6b63\u76f4\u306b\u7533\u3057\u4e0a\u3052\u307e\u3059\u3001\u7de8\u96c6\u9577\u69d8\uff1a\u79c1\u306f\u79c1\u306e\u5c0f\u8aac\u3092\u8457\u8005\u3068\u3057\u3066\u306e\u540d\u58f0\u3084\u7518\u7f8e\u306a\u79f0\u8cdb\u306e\u305f\u3081\u306b\u66f8\u3044\u305f\u308f\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u300d"}
{"translation": "\u305d\u306e\u3088\u3046\u306a\u826f\u3044\u3053\u3068\u306e\u305f\u3081\u306b\u3001\u79c1\u306f\u3082\u3046\u8001\u3044\u3059\u304e\u305f\u3002"}
{"translation": "\u3060\u304b\u3089\u3001\u79c1\u304c\u8457\u8ff0\u306e\u9053\u306b\u9032\u3080\u306e\u306f\u7d14\u7c8b\u306b\u5546\u696d\u7684\u306a\u52d5\u6a5f\u304b\u3089\u3060\u3002"}
{"translation": "\u7a3c\u304e\u305f\u3044\u3002"}
{"translation": "\u79c1\u306f\u4eca\u3001\u4f55\u3082\u3057\u306a\u304f\u3066\u306f\u306a\u3089\u306a\u3044\u3053\u3068\u306f\u6c7a\u3057\u3066\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u300c\u5b9f\u306f\u3001\u5f7c\u306fS\u5730\u533a\u306e\u6cd5\u5ef7\u8abf\u67fb\u5b98\u3067\u30015\u5e74\u4ee5\u4e0a\u52e4\u52d9\u3057\u3066\u3044\u307e\u3057\u305f\u304c\u3001\u8cc7\u672c\u3092\u7bc9\u304f\u3053\u3068\u3082\u7121\u5b9f\u3092\u4fdd\u3064\u3053\u3068\u3082\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u300d"}
{"translation": "\u300c\u5f7c\u306f\u3044\u3063\u305f\u3044\u3069\u308c\u3060\u3051\u8a71\u3059\u3093\u3060\u308d\u3046\u300d\u3068\u79c1\u306f\u601d\u3044\u306a\u304c\u3089\u3001\u30da\u30f3\u306b\u624b\u3092\u4f38\u3070\u3057\u3001\u305d\u308c\u3067\u77e5\u3089\u305b\u308b\u304b\u306e\u3088\u3046\u306b\u3001\u79c1\u306b\u306f\u4f59\u88d5\u304c\u306a\u3044\u3068\u3002"}
{"translation": "\uff08\u305d\u306e\u5f53\u6642\u3001\u8a2a\u554f\u8005\u305f\u3061\u306f\u672c\u5f53\u306b\u79c1\u306b\u3068\u3063\u3066\u3046\u3063\u3068\u3046\u3057\u304b\u3063\u305f\uff01\uff09 \u300c\u3042\u306a\u305f\u306e\u6642\u9593\u30921\u5206\u3060\u3051\u9802\u304d\u307e\u3059\uff01\u300d"}
{"translation": "\u3068\u5f7c\u306e\u30d2\u30fc\u30ed\u30fc\u306f\u8b1d\u7f6a\u306e\u58f0\u3067\u7d9a\u3051\u307e\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u4f55\u3088\u308a\u3082\u307e\u305a\u81ea\u5df1\u7d39\u4ecb\u3055\u305b\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u6cd5\u5b66\u5019\u88dc\u8005\u3001\u30a4\u30f4\u30a1\u30f3\u30fb\u30da\u30c8\u30ed\u30f4\u30a3\u30c3\u30c1\u30fb\u30ab\u30e0\u30a4\u30b7\u30a7\u30d5\u3001\u5143\u635c\u67fb\u5b98\u3002"}
{"translation": "\u7b46\u8005\u305f\u3061\u306e\u4e00\u54e1\u3067\u3042\u308b\u6804\u8a89\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u305d\u308c\u3067\u3082\u306a\u304a\u3001\u7d14\u7c8b\u306b\u4f5c\u5bb6\u7684\u306a\u76ee\u7684\u3067\u3042\u306a\u305f\u65b9\u306e\u3082\u3068\u3078\u53c2\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u3042\u306a\u305f\u306e\u524d\u306b\u306f\u3001\u81ea\u8eab\u304c\u56db\u5341\u6b73\u8fd1\u3044\u306b\u3082\u95a2\u308f\u3089\u305a\u65b0\u4eba\u3068\u3057\u3066\u53c2\u52a0\u3057\u305f\u3044\u3068\u5e0c\u671b\u3057\u3066\u3044\u308b\u4eba\u7269\u304c\u7acb\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u9045\u3059\u304e\u308b\u3088\u308a\u306f\u307e\u3057\u3060\u3002"}
{"translation": "\u79c1\u306e\u57f7\u52d9\u5ba4\u306b\u5165\u3063\u305f\u5f7c\u306f\u3001\u9762\u98df\u3089\u3063\u3066\u3057\u307e\u3063\u305f\u3002"}
{"translation": "\u5f7c\u306e\u67d4\u3089\u304b\u304f\u654f\u611f\u306a\u6027\u683c\u306f\u3001\u304a\u305d\u3089\u304f\u79c1\u306e\u3057\u304b\u3081\u3063\u3064\u3089\u306a\u4e0d\u6e80\u3052\u306a\u9854\u306b\u30b7\u30e7\u30c3\u30af\u3092\u53d7\u3051\u305f\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u3069\u3046\u304b\u304a\u8a31\u3057\u3092\u3001\u795e\u306e\u540d\u306b\u304a\u3044\u3066\uff01 \u5f7c\u306f\u3001\u67d4\u3089\u304b\u3067\u8c4a\u304b\u306a\u30d0\u30ea\u30c8\u30f3\u58f0\u3067\u59cb\u3081\u305f\u3002"}
{"translation": "\u300c\u901a\u5e38\u306e\u6642\u9593\u5916\u306b\u3001\u3053\u3053\u3078\u98db\u3073\u8fbc\u3093\u3067\u304d\u3066\u3001\u4f8b\u5916\u7684\u306b\u79c1\u306e\u305f\u3081\u306b\u4f5c\u696d\u3092\u3057\u3066\u3082\u3089\u3046\u3088\u3046\u6c42\u3081\u307e\u3059\u3002\u300d"}
{"translation": "\u3042\u306a\u305f\u306f\u3068\u3066\u3082\u5fd9\u3057\u3044\u3067\u3059\u306d\uff01"}
{"translation": "\u3057\u304b\u3057\u3001\u3042\u306a\u305f\u304c\u898b\u3066\u306e\u3068\u304a\u308a\u3001\u7de8\u96c6\u9577\u69d8\u3001\u660e\u65e5\u79c1\u306f\u975e\u5e38\u306b\u91cd\u8981\u306a\u7528\u4e8b\u3067\u30aa\u30c7\u30c3\u30b5\u306b\u884c\u304b\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u3082\u3057\u79c1\u304c\u3053\u306e\u65c5\u884c\u3092\u571f\u66dc\u65e5\u307e\u3067\u9045\u3089\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u306a\u3089\u3001\u81ea\u5206\u3060\u3051\u7279\u5225\u6271\u3044\u3092\u3057\u3066\u3082\u3089\u3046\u3088\u3046\u983c\u3080\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u79c1\u306f\u79e9\u5e8f\u3092\u611b\u3059\u308b\u305f\u3081\u3001\u898f\u5247\u306b\u656c\u610f\u3092\u8868\u3057\u307e\u3059\u3002"}
{"translation": "\u6817\u8272\u306e\u982d\u9aea\u3068\u3072\u3052\u306f\u3001\u7d79\u306e\u3088\u3046\u306b\u67d4\u3089\u304b\u304f\u8c4a\u304b\u3060\u3002"}
{"translation": "\u67d4\u3089\u304b\u3044\u9aea\u304c\u3001\u512a\u3057\u3044\u3001\u7e4a\u7d30\u306a\u3001\u300c\u30b7\u30eb\u30af\u300d\u306e\u3088\u3046\u306a\u9b42\u306e\u8c61\u5fb4\u3067\u3042\u308b\u3068\u8a00\u308f\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u72af\u7f6a\u8005\u3084\u90aa\u60aa\u3067\u9811\u56fa\u306a\u6027\u683c\u306e\u4eba\u3005\u306f\u3001\u5927\u534a\u306e\u5834\u5408\u3001\u9aea\u304c\u786c\u3044\u3002"}
{"translation": "\u305d\u308c\u304c\u672c\u5f53\u3067\u3042\u308b\u304b\u5426\u304b\u306f\u3001\u3055\u3089\u306b\u8aad\u307f\u9032\u3080\u3068\u8aad\u8005\u304c\u898b\u3064\u3051\u308b\u3053\u3068\u306b\u306a\u308b\u3060\u308d\u3046\u3002"}
{"translation": "\u305d\u306e\u9854\u3064\u304d\u3082\u3001\u3042\u308b\u3044\u306f\u3072\u3052\u3067\u3055\u3048\u3082\u3001\u5927\u304d\u306a\u4f53\u3092\u306e\u3063\u3057\u308b\u3053\u306e\u65b9\u306e\u52d5\u4f5c\u307b\u3069\u306b\u306f\u67d4\u3089\u304b\u304f\u512a\u96c5\u306b\u898b\u3048\u306a\u3044\u3002"}
{"translation": "\u305d\u306e\u52d5\u304d\u306b\u306f\u3001\u3057\u3064\u3051\u3089\u308c\u305f\u611f\u3058\u3084\u8efd\u5feb\u3055\u3084\u512a\u7f8e\u3055\u304c\u6ef2\u307f\u51fa\u3066\u304a\u308a\u3001\u8a00\u8449\u3092\u501f\u308a\u308b\u306a\u3089\u305d\u308c\u3069\u3053\u308d\u304b\u3042\u308b\u7a2e\u306e\u5973\u6027\u7684\u306a\u3082\u306e\u3055\u3048\u898b\u53d7\u3051\u3089\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u79c1\u306e\u4e3b\u4eba\u516c\u306b\u306f\u3001\u99ac\u8e44\u3092\u66f2\u3052\u308b\u304b\u3001\u3042\u308b\u3044\u306f\u30b5\u30fc\u30c7\u30a3\u30f3\u7f36\u3092\u63e1\u308a\u3064\u3076\u3059\u3088\u3046\u306a\u529b\u304c\u5fc5\u8981\u306a\u308f\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u305d\u308c\u3067\u3082\u5f7c\u306e\u52d5\u304d\u306e\u4e00\u3064\u4e00\u3064\u304c\u7269\u7406\u7684\u306b\u5f37\u5927\u3067\u3042\u308b\u3053\u3068\u3092\u793a\u3057\u3066\u3044\u307e\u305b\u3093\u3002"}
{"translation": "\u5f7c\u304c\u30c9\u30a2\u30ce\u30d6\u3084\u5e3d\u5b50\u306b\u624b\u3092\u4f38\u3070\u3059\u69d8\u306f\u3001\u8776\u306b\u89e6\u308c\u308b\u3088\u3046\u306a\u512a\u3057\u3055\u3068\u7528\u5fc3\u6df1\u3055\u3067\u3001\u6307\u5148\u304c\u304b\u3059\u304b\u306b\u89e6\u308c\u308b\u7a0b\u5ea6\u3060\u3063\u305f\u3002"}
{"translation": "\u5f7c\u306e\u6b69\u307f\u306f\u97f3\u3092\u7acb\u3066\u305a\u3001\u63e1\u624b\u306f\u529b\u5f31\u3044\u3002"}
{"translation": "\u5f7c\u3092\u898b\u3066\u3044\u308b\u3068\u3001\u30b4\u30ea\u30a2\u30c6\u306e\u3088\u3046\u306b\u5f37\u5927\u306a\u3053\u3068\u3084\u3001\u5f7c\u304c\u4e00\u624b\u3067\u7de8\u96c6\u8005\u305f\u3061\u304c\u4e94\u4eba\u304b\u308a\u3067\u3082\u6301\u3061\u4e0a\u3052\u3089\u308c\u306a\u3044\u7269\u3092\u6301\u3061\u4e0a\u3052\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u306e\u3060\u3068\u3044\u3046\u3053\u3068\u3092\u5fd8\u308c\u3066\u3057\u307e\u3046\u3002"}
{"translation": "\u5f7c\u306e\u8efd\u3084\u304b\u306a\u52d5\u304d\u3092\u898b\u3066\u3044\u308b\u3068\u3001\u5f7c\u304c\u5f37\u304f\u3066\u91cd\u305f\u3044\u3068\u306f\u4fe1\u3058\u3089\u308c\u306a\u3044\u3002"}
{"translation": "\u30b9\u30da\u30f3\u30b5\u30fc\u306a\u3089\u3001\u5f7c\u3092\u512a\u96c5\u3055\u306e\u898b\u672c\u3068\u547c\u3093\u3060\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u305d\u306e\u5168\u9854\u304b\u3089\u306f\u3001\u7d20\u6734\u3055\u3001\u5927\u3089\u304b\u3055\u3001\u7121\u90aa\u6c17\u306a\u6027\u683c\u3001\u771f\u5b9f\u304c\u306b\u3058\u307f\u51fa\u3066\u3044\u308b\u3002"}
{"translation": "\u3082\u3057\u3001\u9854\u304c\u9b42\u306e\u93e1\u3067\u3042\u308b\u3068\u3044\u3046\u3053\u3068\u304c\u5618\u3067\u306f\u306a\u3051\u308c\u3070\u3001\u79c1\u306f\u521d\u3081\u3066\u30ea\u30dc\u30f3\u3092\u3064\u3051\u305f\u7537\u6027\u3068\u4f1a\u3063\u305f\u305d\u306e\u65e5\u306b\u3001\u5f7c\u304c\u5618\u3092\u3064\u304f\u3053\u3068\u304c\u3067\u304d\u306a\u3044\u3068\u65ad\u8a00\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u305f\u3060\u308d\u3046\u3002"}
{"translation": "\u79c1\u306f\u8ced\u3051\u306b\u51fa\u3066\u3082\u3088\u304b\u3063\u305f\u306e\u3060\u308d\u3046\u3002"}
{"translation": "\u79c1\u304c\u8ced\u3051\u306b\u8ca0\u3051\u305f\u304b\u3069\u3046\u304b\u306f\u3001\u8aad\u8005\u304c\u3053\u308c\u304b\u3089\u898b\u308b\u3053\u3068\u306b\u306a\u308b\u3002"}
{"translation": "\u3059\u3067\u306b\u79c1\u304c\u8ff0\u3079\u305f\u3088\u3046\u306b\u3001\u5f7c\u306f\u9ad8\u8eab\u9577\u3067\u80a9\u5e45\u304c\u5e83\u304f\u3001\u4f53\u683c\u304c\u826f\u3044\u3002"}
{"translation": "\u307e\u308b\u3067\u983c\u308a\u306b\u306a\u308b\u4ed5\u4e8b\u99ac\u306e\u3088\u3046\u3060\u3002"}
{"translation": "\u5f7c\u306e\u5168\u8eab\u304c\u5065\u5eb7\u3068\u529b\u5f37\u3055\u3092\u91b8\u3057\u51fa\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u9854\u306f\u30d4\u30f3\u30af\u8272\u3067\u3001\u624b\u306f\u5927\u304d\u304f\u3001\u80f8\u677f\u306f\u5e83\u304f\u7b4b\u8089\u8cea\u3067\u3001\u982d\u9aea\u306f\u5065\u5eb7\u7684\u306a\u5c11\u5e74\u306e\u3088\u3046\u306b\u6fc3\u3044\u3002"}
{"translation": "\u5f7c\u306f40\u6b73\u524d\u5f8c\u3060\u3002"}
{"translation": "\u5f7c\u306f\u65b0\u3057\u304f\u3001\u6700\u8fd1\u4ed5\u7acb\u3066\u4e0a\u3052\u305f\u3089\u3057\u3044\u304a\u3057\u3083\u308c\u306a\u30b9\u30fc\u30c4\u3092\u8eab\u306b\u307e\u3068\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u80f8\u306b\u306f\u5927\u304d\u306a\u91d1\u306e\u9396\u3068\u98fe\u308a\u304c\u3001\u5c0f\u6307\u306b\u306f\u5c0f\u3055\u306a\u4e00\u969b\u8f1d\u304f\u661f\u3005\u306e\u3088\u3046\u306a\u30c0\u30a4\u30e4\u306e\u30ea\u30f3\u30b0\u304c\u3061\u3089\u3064\u3044\u3066\u3044\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u4f55\u3088\u308a\u3082\u91cd\u8981\u3067\u3001\u3042\u3089\u3086\u308b\u5c11\u3057\u3067\u3082\u307e\u3068\u3082\u306a\u5c0f\u8aac\u3084\u7269\u8a9e\u306e\u4e3b\u4eba\u516c\u306b\u3068\u3063\u3066\u975e\u5e38\u306b\u91cd\u8981\u306a\u3053\u3068\u306f\u3001\u5f7c\u306f\u975e\u5e38\u306b\u7f8e\u3057\u3044\u3002"}
{"translation": "\u79c1\u306f\u5973\u6027\u3067\u3082\u82b8\u8853\u5bb6\u3067\u3082\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u79c1\u306f\u7537\u6027\u306e\u7f8e\u3057\u3055\u306b\u3064\u3044\u3066\u3042\u307e\u308a\u7406\u89e3\u3057\u3066\u3044\u306a\u3044\u304c\u3001\u305d\u306e\u7537\u6027\u306e\u5916\u898b\u306f\u79c1\u306b\u5370\u8c61\u3092\u4e0e\u3048\u305f\u3002"}
{"translation": "\u5f7c\u306e\u5927\u304d\u304f\u3066\u7b4b\u8089\u8cea\u306a\u9854\u306f\u305a\u3063\u3068\u79c1\u306e\u8a18\u61b6\u306b\u6b8b\u308b\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u305d\u306e\u9854\u306b\u306f\u3001\u672c\u7269\u306e\u30ae\u30ea\u30b7\u30e3\u306e\u9f3b\u3068\u9f3b\u7b4b\u3001\u8584\u3044\u5507\u3001\u7f8e\u3057\u3044\u9752\u3044\u77b3\u304c\u3042\u308a\u3001\u305d\u306e\u76ee\u306b\u306f\u512a\u3057\u3055\u3068\u4f55\u304b\u540d\u524d\u3092\u4ed8\u3051\u308b\u306e\u304c\u96e3\u3057\u3044\u3082\u306e\u304c\u8f1d\u3044\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u300c\u4f55\u304b\u300d\u306f\u3001\u5c0f\u3055\u306a\u52d5\u7269\u306e\u76ee\u306b\u75db\u307f\u3092\u611f\u3058\u308b\u3068\u304d\u3084\u604b\u3057\u304c\u3063\u3066\u3044\u308b\u3068\u304d\u306b\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}
{"translation": "\u4f55\u304b\u61c7\u9858\u3059\u308b\u3088\u3046\u306a\u3001\u5b50\u4f9b\u3058\u307f\u305f\u3001\u4e0d\u5e73\u3092\u8a00\u308f\u305a\u306b\u8010\u3048\u5fcd\u3076\u3082\u306e\u3002"}
{"translation": "\u72e1\u733e\u3067\u975e\u5e38\u306b\u8ce2\u3044\u4eba\u3005\u306e\u76ee\u306f\u3001\u305d\u3093\u306a\u98a8\u306b\u306f\u306a\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u79c1\u306f\u305f\u3081\u606f\u3092\u3064\u304d\u3001\u30da\u30f3\u3092\u7f6e\u3044\u3066\u3001\u30b3\u30ab\u30fc\u30c9\u306e\u7d33\u58eb\u3092\u5f85\u3061\u59cb\u3081\u305f\u3002"}
{"translation": "\u65b0\u624b\u306e\u4f5c\u5bb6\u3084\u3001\u7de8\u96c6\u90e8\u306e\u79d8\u5bc6\u306b\u660e\u308b\u304f\u306a\u3044\u4e00\u822c\u306e\u4eba\u3005\u306f\u3001\u300c\u7de8\u96c6\u90e8\u300d\u3068\u3044\u3046\u8a00\u8449\u306b\u795e\u8056\u306a\u754f\u6016\u3092\u611f\u3058\u3001\u81ea\u5206\u305f\u3061\u3092\u5c11\u306a\u304f\u3068\u3082\u3057\u3070\u3089\u304f\u5f85\u305f\u305b\u307e\u3059\u3002"}
{"translation": "\u5f7c\u3089\u306f\u7de8\u96c6\u8005\u306e\u300c\u3069\u3046\u305e\u300d\u3068\u3044\u3046\u8a00\u8449\u306e\u5f8c\u3001\u9577\u3044\u54b3\u3092\u3057\u3001\u9f3b\u3092\u3059\u3059\u308a\u3001\u3086\u3063\u304f\u308a\u3068\u30c9\u30a2\u3092\u958b\u3051\u3066\u3055\u3089\u306b\u3086\u3063\u304f\u308a\u3068\u5165\u5ba4\u3057\u3001\u3053\u308c\u304c\u304b\u306a\u308a\u306e\u6642\u9593\u53d6\u3089\u308c\u308b\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u30b3\u30ab\u30fc\u30c9\u3092\u6301\u3064\u7d33\u58eb\u306f\u5f85\u305f\u305b\u308b\u3053\u3068\u306f\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u30a2\u30f3\u30c9\u30ec\u30a4\u304c\u6238\u3092\u9589\u3081\u308b\u306a\u308a\u3001\u79c1\u306e\u57f7\u52d9\u5ba4\u306b\u4e00\u4eba\u306e\u5927\u67c4\u3067\u80a9\u5e45\u306e\u5e83\u3044\u7537\u6027\u304c\u7acb\u3063\u3066\u304a\u308a\u3001\u4e00\u65b9\u306e\u624b\u306b\u306f\u7d19\u3067\u5305\u3093\u3060\u3082\u306e\u3092\u3001\u3082\u3046\u4e00\u65b9\u306e\u624b\u306b\u306f\u30b3\u30ab\u30fc\u30c9\u4ed8\u304d\u306e\u5e3d\u5b50\u3092\u6301\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u79c1\u3068\u306e\u4f1a\u898b\u3092\u5f37\u304f\u6c42\u3081\u3066\u3044\u305f\u305d\u306e\u4eba\u7269\u306f\u3001\u79c1\u306e\u7269\u8a9e\u3067\u306f\u975e\u5e38\u306b\u76ee\u7acb\u3064\u5f79\u5272\u3092\u679c\u305f\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\u306e\u5916\u898b\u3092\u63cf\u5199\u3059\u308b\u5fc5\u8981\u304c\u3042\u308b\u3002"}
{"translation": "1880\u5e74\u306e4\u6708\u306e\u663c\u4e0b\u304c\u308a\u3001\u30a2\u30f3\u30c9\u30ec\u30a4\u3068\u3044\u3046\u8b66\u5099\u54e1\u304c\u79c1\u306e\u30aa\u30d5\u30a3\u30b9\u306b\u5165\u3063\u3066\u304d\u3066\u3001\u8b0e\u3081\u3044\u305f\u614b\u5ea6\u3067\u544a\u3052\u305f\u3002"}
{"translation": "\u3042\u308b\u7d33\u58eb\u304c\u7de8\u96c6\u90e8\u306b\u3084\u3063\u3066\u6765\u3066\u3001\u7de8\u96c6\u8005\u306b\u4f1a\u3046\u3053\u3068\u3092\u5f37\u304f\u6c42\u3081\u3066\u3044\u308b\u3068\u3002"}
{"translation": "\u300c\u9593\u9055\u3044\u306a\u304f\u5f79\u4eba\u3060\u308d\u3046\u3001\u300d\u3068\u30a2\u30f3\u30c9\u30ec\u30a4\u304c\u7d9a\u3051\u305f\u3001"}
{"translation": "\u300c\u52f2\u7ae0\u3064\u304d\u3067\u3002\u300d"}
{"translation": "\u300c\u307e\u305f\u9055\u3046\u6642\u9593\u306b\u6765\u3066\u3082\u3089\u3048\u3001\u3068\u4f1d\u3048\u3066\u304f\u308c\u300d\u3068\u79c1\u306f\u8a00\u3063\u305f\u3002"}
{"translation": "\u4eca\u65e5\u306f\u5fd9\u3057\u3044\u3067\u3059\u3002"}
{"translation": "\u300c\u7de8\u96c6\u8005\u306f\u571f\u66dc\u65e5\u3060\u3051\u53d7\u3051\u5165\u308c\u308b\u3068\u4f1d\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u300d"}
{"translation": "\u5f7c\u306f3\u65e5\u3081\u3082\u6765\u3066\u3001\u3042\u306a\u305f\u306e\u3053\u3068\u3092\u5c0b\u306d\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u5927\u304d\u306a\u4ed5\u4e8b\u3060\u3068\u8a00\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u304a\u9858\u3044\u3059\u308b\u3088\u3046\u306b\u3001\u305d\u3057\u3066\u307b\u3068\u3093\u3069\u6ce3\u304d\u3079\u305d\u3092\u304b\u304f\u3002"}
{"translation": "\u300c\u5f7c\u306f\u571f\u66dc\u65e5\u306b\u90fd\u5408\u304c\u60aa\u3044\u3068\u8a00\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u53d7\u3051\u53d6\u308a\u307e\u3059\u304b\uff1f"}
