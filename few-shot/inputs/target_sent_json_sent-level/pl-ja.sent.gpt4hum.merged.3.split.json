{"translation": "\u300c\u5f7c\u306f\u305d\u3053\u304b\u3089\u51fa\u3066\u3053\u306a\u3044\u3088\u3001\u3068\u79c1\u306f\u7686\u306b\u8a00\u3044\u307e\u3059\u300d\u3068\u30cb\u30ad\u30d3\u9854\u304c\u982d\u3092\u3046\u306a\u305a\u304d\u306a\u304c\u3089\u65ad\u5b9a\u7684\u306b\u8a9e\u3063\u305f\u3002"}
{"translation": "\u5f7c\u304c\u305d\u3053\u306b\u5165\u3063\u305f\u306e\u306f\u3059\u3067\u306b1\u6642\u959315\u5206\u3082\u7d4c\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u3082\u3046\u5f7c\u306e\u3053\u3068\u306f\u7d42\u308f\u308a\u3060\u3002"}
{"translation": "\u5e02\u6c11\u305f\u3061\u306f\u3001\u5ec3\u589f\u306e\u4e2d\u306b\u5bc6\u96c6\u3057\u3001\u5012\u58ca\u3057\u305f\u5730\u4e0b\u5165\u53e3\u3078\u3068\u958b\u3051\u305f\u9ed2\u3044\u7a74\u3092\u898b\u3064\u3081\u3066\u7121\u8a00\u3067\u7acb\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u9ec4\u8272\u306e\u5927\u304d\u306a\u30b3\u30fc\u30c8\u3092\u7740\u305f\u592a\u3063\u305f\u7537\u304c\u8db3\u304b\u3089\u8db3\u3078\u3068\u4f53\u91cd\u3092\u79fb\u3057\u3001\u5589\u3092\u30af\u30ea\u30a2\u3057\u3001\u304f\u3057\u3083\u304f\u3057\u3083\u306b\u306a\u3063\u305f\u30d9\u30ec\u30fc\u5e3d\u3092\u982d\u304b\u3089\u53d6\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u307e\u3060\u5c11\u3057\u5f85\u3061\u307e\u3057\u3087\u3046\u300d\u3068\u5f7c\u306f\u8a00\u3044\u306a\u304c\u3089\u3001\u7a00\u306a\u7709\u6bdb\u304b\u3089\u6ef4\u308b\u6c57\u3092\u306c\u3050\u3063\u305f\u3002"}
{"translation": "\u300c\u4f55\u306e\u305f\u3081\u306b\uff1f\u300d\u3068\u306b\u304d\u3073\u9762\u304c\u9f3b\u3092\u9cf4\u3089\u3057\u305f\u3002"}
{"translation": "\u300c\u3042\u305d\u3053\u3001\u5730\u4e0b\u7262\u306b\u306f\u30d0\u30b8\u30ea\u30b9\u30af\u304c\u3044\u308b\u3093\u3060\u305e\u3001\u753a\u9577\u69d8\u3002"}
{"translation": "\u5fd8\u308c\u3066\u306a\u3044\u3067\u3059\u3088\u306d\uff1f\u300d"}
{"translation": "\u305d\u3053\u306b\u5165\u308b\u8005\u306f\u3082\u3046\u904e\u53bb\u306e\u4eba\u3060\u3002"}
{"translation": "\u305d\u3053\u3067\u4f55\u4eba\u3082\u306e\u4eba\u304c\u4ea1\u304f\u306a\u3063\u305f\u306e\u304b\uff1f"}
{"translation": "\u4f55\u3092\u5f85\u3063\u3066\u3044\u308b\u3093\u3060\uff1f"}
{"translation": "\u300c\u4e88\u5b9a\u304c\u3042\u3063\u305f\u3093\u3067\u3057\u3087\u300d"}
{"translation": "\u592a\u3063\u305f\u7537\u304c\u4e0d\u78ba\u304b\u306a\u58f0\u3067\u3076\u3064\u3076\u3064\u8a00\u3063\u305f\u3002"}
{"translation": "\u3069\u3046\u3057\u3066\u305d\u3046\u306a\u308b\u306e\u304b\uff1f"}
{"translation": "\u300c\u751f\u304d\u3066\u3044\u308b\u4eba\u3068\u30a2\u30dd\u3092\u3068\u3063\u305f\u3093\u3060\u308d\u3046\u3001\u9854\u306b\u5439\u304d\u51fa\u7269\u306e\u3042\u308b\u7537\u306e\u4ef2\u9593\u3001\u5de8\u5927\u306a\u808c\u7740\u3092\u7740\u305f\u5c60\u6bba\u8005\u304c\u98fc\u3044\u4e3b\u306b\u8a00\u3063\u305f\u3002\u300d"}
{"translation": "\u305d\u3057\u3066\u4eca\u5f7c\u306f\u6b7b\u3093\u3067\u3044\u308b\u3001\u305d\u308c\u306f\u7a7a\u306e\u592a\u967d\u304c\u78ba\u5b9f\u306a\u3088\u3046\u306b\u3002"}
{"translation": "\u6700\u521d\u304b\u3089\u5f7c\u304c\u7834\u6ec5\u306e\u9053\u3092\u6b69\u3093\u3067\u3044\u308b\u3053\u3068\u306f\u660e\u3089\u304b\u3067\u3001\u5f7c\u306e\u524d\u306b\u3044\u305f\u4eba\u305f\u3061\u3068\u540c\u3058\u3060\u3002"}
{"translation": "\u5f7c\u306f\u93e1\u3082\u6301\u305f\u305a\u306b\u884c\u3063\u3066\u3057\u307e\u3063\u305f\u3001\u5263\u3060\u3051\u3092\u6301\u3063\u3066\u3002"}
{"translation": "\u305d\u3057\u3066\u30d0\u30b8\u30ea\u30b9\u30af\u3092\u5012\u3059\u305f\u3081\u306b\u306f\u93e1\u306a\u3057\u3067\u306f\u7121\u7406\u3060\u3001\u305d\u308c\u306f\u8ab0\u3082\u304c\u77e5\u3063\u3066\u3044\u308b\u3053\u3068\u3060\u3002"}
{"translation": "\u3069\u3046\u3057\u3066\u305d\u3046\u306a\u308b\u306e\u304b\uff1f"}
{"translation": "\u300c\u4e00\u92ad\u3082\u30b1\u30c1\u3063\u305f\u306a\u3001\u305d\u3046\u3060\u308d\u3046\u3001\u306b\u304d\u3073\u9762\u306e\u6751\u9577\u300d \u3060\u3063\u3066\u3001\u8ab0\u3082\u30d0\u30b8\u30ea\u30b9\u30af\u306e\u4ee3\u91d1\u3092\u6255\u3046\u4eba\u306a\u3093\u3066\u3044\u306a\u3044\u3093\u3060\u304b\u3089\u3002"}
{"translation": "\u3042\u306a\u305f\u9054\u306f\u5b89\u5fc3\u3057\u3066\u305d\u306e\u9053\u3092\u9032\u307f\u3001\u5bb6\u306b\u5e30\u3063\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u305d\u3057\u3066\u3001\u9b54\u8853\u5e2b\u306e\u99ac\u3068\u5bb6\u755c\u306f\u6211\u3005\u304c\u6240\u6709\u3059\u308b\u3053\u3068\u306b\u306a\u308b\u3002"}
{"translation": "\u305d\u306e\u5bcc\u3092\u843d\u3068\u3057\u7a74\u306b\u6368\u3066\u308b\u306e\u306f\u6094\u3057\u3044\u3002"}
{"translation": "\u300c\u3048\u3048\u3001\u305d\u306e\u901a\u308a\u3060\u3088\u300d\u3068\u8089\u5c4b\u304c\u8a00\u3063\u305f\u3002"}
{"translation": "\u5065\u5eb7\u306a\u96cc\u99ac\u3068\u9e7f\u306e\u306c\u3044\u3050\u308b\u307f\u3082\u3088\u304f\u51fa\u6765\u3066\u3044\u308b\u3002"}
{"translation": "\u4e2d\u8eab\u3092\u898b\u3066\u307f\u307e\u3057\u3087\u3046\u3002"}
{"translation": "\u4f55\u3092\u6301\u3063\u3066\u3044\u308b\u3093\u3067\u3059\u304b\uff1f"}
{"translation": "\u300c\u9ed9\u308c\u3002"}
{"translation": "\u304a\u307e\u3048\u305f\u3061\u306f\u95a2\u4e0e\u3057\u306a\u3044\u3067\u3001\u305d\u3046\u3067\u306a\u3051\u308c\u3070\u75db\u307f\u3092\u611f\u3058\u308b\u3060\u308d\u3046\u300d"}
{"translation": "\u3068\u306b\u304d\u3073\u9854\u304c\u8b66\u544a\u3057\u305f\u3002"}
{"translation": "\u300c\u7f8e\u3057\u3044\u96cc\u99ac\u3060\u300d\u3068\u8089\u5c4b\u304c\u7e70\u308a\u8fd4\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u99ac\u3092\u305d\u3063\u3068\u3057\u3066\u304a\u3044\u3066\u3001\u611b\u3057\u3044\u4eba\u3088\u3002"}
{"translation": "\u8089\u5c4b\u306f\u3086\u3063\u304f\u308a\u3068\u3001\u58c1\u306e\u9685\u304b\u3089\u4eba\u3005\u306e\u80cc\u5f8c\u304b\u3089\u73fe\u308c\u305f\u898b\u77e5\u3089\u306c\u65c5\u4eba\u306b\u5411\u304d\u76f4\u3063\u305f\u3002"}
{"translation": "\u305d\u306e\u65c5\u4eba\u306f\u3001\u5730\u4e0b\u7262\u306e\u5165\u308a\u53e3\u5468\u8fba\u306b\u96c6\u307e\u3063\u3066\u3044\u308b\u7fa4\u8846\u304b\u3089\u9038\u8131\u3057\u3066\u51fa\u3066\u6765\u305f\u3002"}
{"translation": "\u305d\u306e\u898b\u77e5\u3089\u306c\u4eba\u306f\u3001\u304f\u305b\u6bdb\u3067\u6fc3\u3044\u6817\u8272\u306e\u9aea\u3092\u3057\u3066\u304a\u308a\u3001\u539a\u624b\u306e\u30ab\u30d5\u30bf\u30f3\u306b\u8336\u8272\u306e\u30c1\u30e5\u30cb\u30c3\u30af\u3092\u7740\u3066\u3001\u9ad8\u3044\u4e57\u99ac\u7528\u306e\u30d6\u30fc\u30c4\u3092\u5c65\u3044\u3066\u3044\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u6b66\u5668\u3082\u306a\u3057\u3002"}
{"translation": "\u300c\u99ac\u304b\u3089\u96e2\u308c\u308d\u300d\u3068\u5f7c\u306f\u518d\u5ea6\u8a00\u3044\u3001\u60aa\u610f\u306b\u6e80\u3061\u305f\u7b11\u9854\u3092\u6d6e\u304b\u3079\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u3069\u3046\u3044\u3046\u3053\u3068\u3060\uff1f \u4ed6\u4eba\u306e\u99ac\u3001\u4ed6\u4eba\u306e\u936c\u3001\u4ed6\u4eba\u306e\u8ca1\u7523\u3001\u305d\u3093\u306a\u3082\u306e\u306b\u3042\u306a\u305f\u306f\u305d\u306e\u60aa\u3073\u308c\u306a\u3044\u76ee\u3092\u3080\u3051\u3066\u3001\u5351\u602f\u306a\u624b\u3092\u4f38\u3070\u3059\u3064\u3082\u308a\u304b\uff1f \u305d\u308c\u306f\u826f\u3044\u306e\u3067\u3059\u304b\uff1f \u306b\u304d\u3073\u9762\u3067\u3001\u3086\u3063\u304f\u308a\u3068\u30b8\u30e3\u30f3\u30d1\u30fc\u306e\u8107\u306b\u624b\u3092\u6ed1\u3089\u305b\u306a\u304c\u3089\u3001\u8089\u5c4b\u3092\u898b\u3064\u3081\u305f\u3002"}
{"translation": "\u8089\u5c4b\u306f\u9837\u304d\u3001\u66f4\u306b\u4e8c\u4eba\u304c\u51fa\u3066\u6765\u305f\u77ed\u304f\u5207\u308a\u63c3\u3048\u3089\u308c\u305f\u9811\u4e08\u306a\u30b0\u30eb\u30fc\u30d7\u306e\u65b9\u3092\u6307\u3057\u305f\u3002"}
{"translation": "\u5f7c\u3089\u4e8c\u4eba\u306f\u68cd\u68d2\u3092\u6301\u3063\u3066\u3044\u307e\u3057\u305f\u3001\u305d\u308c\u306f\u5c60\u6bba\u5834\u3067\u52d5\u7269\u3092\u7a92\u606f\u3055\u305b\u308b\u306e\u306b\u4f7f\u3046\u3088\u3046\u306a\u3082\u306e\u3067\u3059\u3002"}
{"translation": "\u300c\u8ab0\u3060\u3068\u601d\u3063\u3066\u308b\u306e\u304b\uff1f\u541b\u305f\u3061\u300d\u3068\u30cb\u30ad\u30d3\u9762\u304c\u8a00\u3044\u3001\u814b\u304b\u3089\u624b\u3092\u51fa\u3055\u305a\u306b\u3001\u300c\u4f55\u304c\u6b63\u3057\u304f\u3066\u4f55\u304c\u9055\u3046\u306e\u304b\u3001\u6559\u3048\u3066\u304f\u308c\u308b\u306e\u304b\uff1f\u300d"}
{"translation": "\u305d\u308c\u306f\u541b\u306b\u306f\u95a2\u4fc2\u306a\u3044\u3088\u3001\u30c0\u30fc\u30ea\u30f3\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u6b66\u5668\u3092\u6301\u3063\u3066\u3044\u307e\u305b\u3093\u3002"}
{"translation": "\u305d\u306e\u898b\u77e5\u3089\u306c\u4eba\u306f\u3055\u3089\u306b\u76ae\u8089\u306a\u7b11\u307f\u3092\u6d6e\u304b\u3079\u305f\u3002"}
{"translation": "\u7740\u3066\u306a\u3044\u3002"}
{"translation": "\u305d\u306e\u306b\u304d\u3073\u3060\u3089\u3051\u306e\u4e0d\u826f\u304c\u8107\u304b\u3089\u624b\u3092\u51fa\u3057\u3001\u4e00\u7dd2\u306b\u9577\u3044\u30ca\u30a4\u30d5\u3082\u5f15\u304d\u629c\u3044\u305f\u3002"}
{"translation": "\u305d\u308c\u3092\u6301\u3061\u6b69\u304b\u306a\u3044\u306e\u306f\u3068\u3066\u3082\u3088\u304f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u8089\u5c4b\u3082\u307e\u305f\u30ca\u30a4\u30d5\u3092\u5f15\u304d\u629c\u3044\u305f\u3001\u305d\u308c\u306f\u5927\u304d\u306a\u30af\u30ed\u30b9\u30d0\u30fc\u306e\u3088\u3046\u3060\u3063\u305f\u3002"}
{"translation": "\u3042\u306e\u4e8c\u4eba\u306f\u524d\u306b\u9032\u307f\u51fa\u3057\u3001\u68d2\u3092\u632f\u308a\u4e0a\u3052\u305f\u3002"}
{"translation": "\u300c\u79c1\u306f\u6301\u3064\u5fc5\u8981\u304c\u306a\u3044\u300d\u3068\u898b\u77e5\u3089\u306c\u4eba\u306f\u8a00\u3063\u305f\u3001\u305d\u306e\u5834\u304b\u3089\u52d5\u304b\u306a\u3044\u3067\u3002"}
{"translation": "\u79c1\u306e\u6b66\u5668\u304c\u79c1\u306e\u5f8c\u3092\u8ffd\u3044\u304b\u3051\u3066\u304f\u308b\u3002"}
{"translation": "\u5ec3\u589f\u304b\u3089\u3001\u30bd\u30d5\u30c8\u3067\u78ba\u5b9f\u306a\u4e00\u6b69\u3067\u3001\u4e8c\u4eba\u306e\u82e5\u3044\u5973\u6027\u304c\u51fa\u3066\u304d\u305f\u3002"}
{"translation": "\u305d\u306e\u7fa4\u8846\u306f\u3059\u3050\u3055\u307e\u9000\u3044\u3066\u3001\u5f8c\u9000\u3057\u3001\u758e\u3089\u306b\u306a\u3063\u305f\u3002"}
{"translation": "\u4e21\u65b9\u306e\u5973\u306e\u5b50\u304c\u7b11\u9854\u3092\u898b\u305b\u3001\u6b6f\u3092\u3080\u304d\u51fa\u3057\u306b\u3057\u3001\u76ee\u3092\u7d30\u3081\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u773c\u89d2\u304b\u3089\u8033\u306b\u5411\u304b\u3063\u3066\u5e83\u304f\u9752\u3044\u30bf\u30c8\u30a5\u30fc\u306e\u7b4b\u304c\u6d41\u308c\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5f37\u976d\u306a\u817f\u306b\u7b4b\u8089\u304c\u3046\u306d\u308a\u3001\u30ea\u30f3\u30af\u30b9\u306e\u76ae\u819a\u3092\u5305\u307f\u8fbc\u3093\u3060\u80a1\u4e0b\u304b\u3089\u898b\u3048\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u624b\u888b\u3067\u8986\u308f\u308c\u305f\u4e0a\u90e8\u3067\u88f8\u306e\u4e38\u3044\u8155\u3082\u540c\u69d8\u3060\u3063\u305f\u3002"}
{"translation": "\u80a9\u304b\u3089\u4e0a\u306b\u3082\u9396\u5e37\u5b50\u3067\u8986\u308f\u308c\u3001\u305d\u3053\u304b\u3089\u306f\u3055\u3089\u306b\u5200\u306e\u67c4\u304c\u7a81\u304d\u51fa\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u306b\u304d\u3073\u9762\u306f\u3086\u3063\u304f\u308a\u3068\u3001\u6975\u3081\u3066\u9045\u304f\u819d\u3092\u66f2\u3052\u3001\u30ca\u30a4\u30d5\u3092\u5730\u9762\u306b\u843d\u3068\u3057\u305f\u3002"}
{"translation": "\u304c\u308c\u304d\u306e\u7a74\u304b\u3089\u77f3\u304c\u304b\u3061\u3093\u3068\u97f3\u3092\u7acb\u3066\u3001\u3064\u3065\u3044\u3066\u30ac\u30b5\u30b4\u30bd\u3059\u308b\u97f3\u304c\u3042\u3063\u3066\u3001\u305d\u308c\u304b\u3089\u95c7\u304b\u3089\u624b\u304c\u73fe\u308c\u3001\u6b20\u3051\u305f\u58c1\u306e\u7aef\u306b\u3057\u3063\u304b\u308a\u3068\u3064\u304b\u307e\u3063\u305f\u3002"}
{"translation": "\u305d\u306e\u624b\u306e\u5f8c\u308d\u306b\u306f\u3001\u767d\u3044\u9aea\u304c\u30ec\u30f3\u30ac\u8272\u306e\u7c89\u3067\u8986\u308f\u308c\u305f\u982d\u3001\u9752\u3056\u3081\u305f\u9854\u3001\u80a9\u304b\u3089\u7a81\u304d\u51fa\u305f\u5263\u306e\u67c4\u304c\u6b21\u3005\u306b\u73fe\u308c\u305f\u3002"}
{"translation": "\u7fa4\u8846\u304c\u3056\u308f\u3064\u3044\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u306f\u3046\u306a\u3060\u308c\u3001\u7a74\u304b\u3089\u5947\u5999\u306a\u5f62\u3001\u5947\u7570\u306a\u8eab\u4f53\u3092\u5f15\u3063\u5f35\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u8840\u3067\u67d3\u307f\u8fbc\u3093\u3060\u57c3\u3067\u592a\u3089\u305b\u3089\u308c\u3066\u3044\u305f\u3002"}
{"translation": "\u5f7c\u306f\u9577\u3044\u30c8\u30ab\u30b2\u306e\u5c3e\u3092\u63b4\u307f\u3001\u4e00\u8a00\u3082\u767a\u3059\u308b\u3053\u3068\u306a\u304f\u3001\u592a\u3063\u305f\u6751\u9577\u306e\u8db3\u5143\u306b\u305d\u306e\u751f\u7269\u3092\u6295\u3052\u3064\u3051\u305f\u3002"}
{"translation": "\u6751\u9577\u306f\u98db\u3073\u9000\u304d\u3001\u5012\u308c\u305f\u58c1\u306e\u7834\u7247\u306b\u3064\u307e\u305a\u304d\u306a\u304c\u3089\u3001\u6e7e\u66f2\u3057\u305f\u9ce5\u306e\u5634\u3001\u819c\u72b6\u306e\u7ffc\u3001\u305d\u3057\u3066\u9c57\u3067\u8986\u308f\u308c\u305f\u8db3\u306b\u3042\u308b\u938c\u5f62\u306e\u722a\u3092\u898b\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u304b\u3064\u3066\u306f\u7d05\u8272\u3060\u3063\u305f\u304c\u3001\u4eca\u3067\u306f\u6c5a\u308c\u305f\u8d64\u8336\u8272\u306e\u81a8\u3089\u3093\u3060\u5589\u4ecf\u306b\u76ee\u3092\u5411\u3051\u308b\u3002"}
{"translation": "\u30ac\u30e9\u30b9\u306e\u3088\u3046\u306b\u5149\u3063\u3066\u51f9\u3093\u3060\u76ee\u3092\u3002"}
{"translation": "\u300c\u305d\u306e\u30d0\u30b8\u30ea\u30b9\u30af\u3055\u300d\u3068\u767d\u9aea\u306e\u7537\u306f\u8a00\u3044\u306a\u304c\u3089\u3001\u30ba\u30dc\u30f3\u304b\u3089\u307b\u3053\u308a\u3092\u6255\u3063\u305f\u3002"}
{"translation": "\u5951\u7d04\u901a\u308a\u306b\u3002"}
{"translation": "\u3069\u3046\u304b\u79c1\u306e\u4e8c\u767e\u30ea\u30f3\u30bf\u30eb\u3092\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u6b63\u76f4\u306a\u9152\u8c6a\u3067\u3001\u9154\u3044\u304c\u305d\u3093\u306a\u306b\u56de\u3063\u3066\u3044\u306a\u3044\u4eba\u3005\u3002"}
{"translation": "\u8abf\u3079\u3066\u307f\u308b\u3088\u3001\u3068\u5148\u306b\u544a\u3052\u3066\u304a\u304f\u3002"}
{"translation": "\u6751\u9577\u306f\u9707\u3048\u308b\u624b\u3067\u8ca1\u5e03\u3092\u53d6\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u304c\u5468\u56f2\u3092\u898b\u6e21\u3057\u3001\u4e00\u77ac\u3001\u9854\u306b\u30cb\u30ad\u30d3\u306e\u3042\u308b\u7537\u3068\u3001\u5f7c\u306e\u8db3\u5143\u306b\u843d\u3061\u3066\u3044\u305f\u30ca\u30a4\u30d5\u306b\u8996\u7dda\u3092\u7559\u3081\u305f\u3002"}
{"translation": "\u5f7c\u306f\u8336\u8272\u306e\u30c1\u30e5\u30cb\u30c3\u30af\u3092\u7740\u305f\u7537\u3092\u3001\u305d\u3057\u3066\u30ea\u30b9\u306e\u76ae\u3092\u7e8f\u3063\u305f\u5c11\u5973\u305f\u3061\u3092\u898b\u3064\u3081\u305f\u3002"}
{"translation": "\u5f7c\u306f\u9707\u3048\u3066\u3044\u308b\u6751\u9577\u306e\u624b\u304b\u3089\u89b3\u8cde\u9b5a\u3092\u53d6\u308a\u51fa\u3059\u3068\u3001\u3044\u3064\u3082\u901a\u308a\u306b\u8a00\u3063\u305f\u3002"}
{"translation": "\u3042\u306a\u305f\u9054\u306e\u305f\u3081\u306b\u5c11\u984d\u306e\u304a\u91d1\u3067\u547d\u3092\u8ced\u3051\u3066\u3044\u308b\u4e00\u65b9\u3001\u3042\u306a\u305f\u9054\u306f\u79c1\u306e\u6301\u3061\u7269\u306b\u624b\u3092\u51fa\u3057\u3066\u3044\u308b\u3093\u3060\u3002"}
{"translation": "\u3042\u306a\u305f\u305f\u3061\u3001\u4e00\u4f53\u3044\u3064\u306b\u306a\u3063\u305f\u3089\u5909\u308f\u308b\u3093\u3060\u3002"}
{"translation": "\u300c\u89e6\u3089\u306a\u3044\u3067\u300d\u3068\u7cbe\u8089\u5c4b\u306f\u3064\u3076\u3084\u304d\u3001\u5f8c\u305a\u3055\u308a\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u68d2\u3092\u6301\u3063\u305f\u8005\u305f\u3061\u306f\u3001\u65e2\u306b\u4eba\u6df7\u307f\u306b\u7d1b\u308c\u8fbc\u3093\u3067\u3057\u307e\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u3042\u306a\u305f\u306e\u3082\u306e\u306f\u89e6\u3089\u308c\u3066\u3044\u307e\u305b\u3093\u3088\u3001\u65e6\u90a3\u3002"}
{"translation": "\u305d\u306e\u767d\u9aea\u306e\u8001\u4eba\u306f\u5927\u5909\u559c\u3093\u3067\u5fae\u7b11\u3093\u3060\u3002"}
{"translation": "\u305d\u306e\u7b11\u9854\u3092\u898b\u3066\u3001\u9752\u3056\u3081\u305f\u9854\u306b\u54b2\u304f\u958b\u3051\u653e\u305f\u308c\u308b\u50b7\u306e\u3088\u3046\u306b\u3001\u7fa4\u8846\u306f\u6025\u901f\u306b\u6563\u308a\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u3060\u304b\u3089\u5144\u5f1f\u3088\u3001\u3042\u306a\u305f\u3082\u52d5\u63fa\u3059\u308b\u3053\u3068\u306f\u306a\u3044\u3060\u308d\u3046\u3002"}
{"translation": "\u5b89\u3089\u304b\u306b\u53bb\u308a\u306a\u3055\u3044\u3002"}
{"translation": "\u3060\u304c\u3001\u65e9\u304f\u53bb\u3063\u3066\u304f\u308c\u3002"}
