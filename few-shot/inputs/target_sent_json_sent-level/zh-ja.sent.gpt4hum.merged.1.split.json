{"translation": "\u3068\u3066\u3082\u9577\u3044\u6642\u9593\u304c\u7d4c\u3063\u305f\u3042\u308b\u65e5\u3001\u5f7c\u5973\u306e\u592b\u306f\u75c5\u9662\u304b\u3089\u5e30\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u5f7c\u306e\u8868\u60c5\u306f\u53b3\u7c9b\u3067\u3001\u300c\u6587\u5316\u5927\u9769\u547d\u300d\u306b\u3064\u3044\u3066\u8a71\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u75c5\u9662\u3067\u306f\u6bce\u65e5\u4f1a\u8b70\u304c\u958b\u304b\u308c\u3001\u5f7c\u306b\u5bfe\u3057\u3066\u30d3\u30c3\u30b0\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30dd\u30b9\u30bf\u30fc\u3092\u66f8\u3044\u305f\u4eba\u3082\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306e\u6b74\u53f2\u306b\u554f\u984c\u304c\u3042\u308b\u3068\u8a00\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\u5973\u306f\u975e\u5e38\u306b\u7dca\u5f35\u3057\u3066\u3044\u3066\u3001\u592b\u304c\u81ea\u5206\u306b\u3053\u308c\u3089\u306e\u3053\u3068\u3092\u8a71\u3059\u610f\u5473\u304c\u4f55\u306a\u306e\u304b\u308f\u304b\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u5f7c\u5973\u306e\u592b\u306f\u7a81\u7136\u3001\u300c\u541b\u306b\u4f55\u3082\u8d77\u3053\u3089\u306a\u3044\u3088\u3001\u50d5\u304c\u5b88\u308b\u304b\u3089\u300d\u3068\u8a00\u3063\u305f\u3002"}
{"translation": "\u3042\u306a\u305f\u306e\u904e\u53bb\u306e\u3053\u3068\u3092\u3001\u4e00\u751f\u601d\u3044\u51fa\u3055\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u3042\u306a\u305f\u306e\u6700\u5927\u306e\u6575\u306f\u5916\u90e8\u306e\u4eba\u3005\u3067\u306f\u306a\u304f\u3001\u304a\u305d\u3089\u304f\u3042\u306a\u305f\u304c\u899a\u3048\u3066\u3044\u306a\u3044\u3082\u306e\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u3082\u3057\u8ab0\u304b\u304c\u3042\u306a\u305f\u306b\u554f\u3046\u306a\u3089\u3001\u4f55\u3082\u77e5\u3089\u306a\u3044\u3068\u7b54\u3048\u308b\u3060\u3051\u3067\u826f\u3044\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u3069\u3053\u51fa\u8eab\u3067\u3059\u304b\uff1f \u3069\u306e\u6751\u306b\u4f4f\u3093\u3067\u3044\u307e\u3059\u304b\uff1f \u3042\u306a\u305f\u306f\u4f55\u6b73\u3067\u3059\u304b\uff1f \u3042\u306a\u305f\u306e\u5bb6\u306b\u306f\u4ed6\u306b\u8ab0\u304c\u3044\u307e\u3059\u304b\uff1f \u3069\u3046\u3057\u3066\u5ddd\u306b\u843d\u3061\u305f\u306e\uff1f\u30dc\u30fc\u30c8\u304c\u8ee2\u8986\u3057\u305f\u306e\uff1f"}
{"translation": "\u305d\u308c\u3068\u3082\u60aa\u3044\u4eba\u306b\u7a81\u304d\u843d\u3068\u3055\u308c\u305f\u306e\uff1f \u3042\u306a\u305f\u3060\u3051\u304c\u6c34\u306b\u843d\u3061\u307e\u3057\u305f\u304b\u3002"}
{"translation": "\u4eba\u3005\u304c\u5165\u308c\u66ff\u308f\u308a\u7acb\u3061\u66ff\u308f\u308a\u8cea\u554f\u3059\u308b\u4e2d\u3001\u305f\u3060\u4e00\u3064\u306e\u58f0\u3001\u67d4\u3089\u304b\u306a\u58f0\u3067\u3055\u3048\u3082\u7121\u6570\u306e\u91dd\u304c\u5fc3\u3092\u7a81\u304d\u523a\u3059\u3088\u3046\u306a\u6fc0\u75db\u3092\u611f\u3058\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u30d9\u30c3\u30c9\u306e\u4e0a\u3067\u4e38\u307e\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u8003\u3048\u305f\u3001\u300c\u305d\u3046\u3060\u3001\u79c1\u306f\u3069\u3053\u304b\u3089\u6765\u305f\u3093\u3060\u308d\u3046\uff1f\u300d \u79c1\u306f\u3069\u3053\u306b\u4f4f\u3093\u3067\u3044\u307e\u3059\u304b\uff1f \u79c1\u306e\u540d\u524d\u306f\u4f55\u3067\u3059\u304b\uff1f"}
{"translation": "\u306a\u305c\u79c1\u306f\u5ddd\u306b\u843d\u3061\u3066\u3057\u307e\u3063\u305f\u306e\u3060\u308d\u3046\u304b\uff1f \u5f7c\u5973\u306f\u5b8c\u5168\u306b\u5370\u8c61\u3092\u7121\u304f\u3057\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u3069\u3046\u3057\u3066\u899a\u3048\u3066\u3044\u306a\u3044\u306f\u305a\u304c\u3042\u308a\u307e\u3059\u304b\uff1f \u3069\u3046\u3057\u3066\u81ea\u5206\u306e\u3053\u3068\u3055\u3048\u899a\u3048\u3066\u3044\u306a\u3044\u306e\u3060\u308d\u3046\u304b\uff1f \u305d\u308c\u304b\u3089\u5f7c\u5973\u306f\u6ce3\u304d\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3001\u300c\u79c1\u306f\u899a\u3048\u3066\u3044\u306a\u3044\u300d\u3068\u8a00\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u672c\u5f53\u306b\u899a\u3048\u3066\u3044\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u3067\u3001\u307f\u3093\u306a\u304c\u8a00\u3063\u305f\u3001\u300c\u3088\u304f\u8003\u3048\u3066\u3054\u3089\u3093\u3002"}
{"translation": "\u672c\u5f53\u306b\u3088\u304f\u8003\u3048\u3066\u3054\u3089\u3093\u300d\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u5ddd\u304b\u3089\u4eba\u306b\u5f15\u304d\u4e0a\u3052\u3089\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u3042\u306a\u305f\u304c\u5ddd\u306e\u6c34\u304b\u3089\u601d\u3044\u51fa\u305d\u3046\u3068\u3059\u308b\u306a\u3089\u3070\u3001\u591a\u5206\u601d\u3044\u51fa\u305b\u308b\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u5f7c\u5973\u306f\u4eba\u3005\u306e\u8981\u6c42\u306b\u5f93\u3063\u3066\u3001\u305d\u306e\u307e\u307e\u771f\u5263\u306b\u601d\u3044\u51fa\u3059\u3053\u3068\u306b\u306a\u3063\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u5f7c\u5973\u306e\u601d\u5ff5\u304c\u5ddd\u8fba\u306b\u5230\u9054\u3059\u308b\u3068\u3001\u3056\u308f\u3081\u304f\u6c34\u97f3\u304c\u305f\u3060\u3061\u306b\u7206\u96f7\u306e\u3088\u3046\u306b\u9cf4\u308a\u97ff\u304d\u3001\u540d\u524d\u306e\u306a\u3044\u6050\u6016\u611f\u304c\u305d\u306e\u6c34\u97f3\u3068\u4e00\u7dd2\u306b\u62bc\u3057\u5bc4\u305b\u3066\u304d\u305f\u3002"}
{"translation": "\u6ce2\u6fe4\u306e\u4e2d\u306b\u306f\u307e\u308b\u3067\u9b54\u7269\u304c\u5fcd\u3073\u5bc4\u3063\u3066\u3044\u308b\u3088\u3046\u3060\u3063\u305f\u3002"}
{"translation": "\u8996\u899a\u3084\u89e6\u611f\u3067\u306f\u6349\u3048\u3089\u308c\u306a\u3044\u3082\u306e\u304c\u3001\u5f7c\u5973\u306e\u5fc3\u3068\u4f53\u3092\u75db\u70c8\u306b\u8972\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u7a81\u5982\u3068\u3057\u3066\u81ea\u5236\u5fc3\u3092\u5931\u3044\u3001\u58f0\u3092\u4e0a\u3052\u3066\u60b2\u6ce3\u3057\u3001\u305d\u3057\u3066\u53eb\u3093\u3060\u3002"}
{"translation": "\u305d\u306e\u58f0\u306f\u30d2\u30b9\u30c6\u30ea\u30c3\u30af\u3060\u3063\u305f\u3002"}
{"translation": "\u5434\u59d3\u306e\u533b\u8005\u306f\u53b3\u3057\u304f\u597d\u5947\u5fc3\u65fa\u76db\u306a\u4eba\u3005\u3092\u5236\u6b62\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u5f7c\u5973\u304c\u4f55\u3089\u304b\u306e\u523a\u6fc0\u3092\u53d7\u3051\u3066\u3044\u308b\u53ef\u80fd\u6027\u304c\u3042\u308b\u3068\u8a00\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u304c\u3053\u308c\u4ee5\u4e0a\u8003\u3048\u8fbc\u3080\u306e\u306f\u3084\u3081\u3055\u305b\u307e\u3057\u3087\u3046\u3001\u5f7c\u5973\u306b\u9759\u990a\u3055\u305b\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u305d\u308c\u4ee5\u964d\u3001\u4eba\u3005\u306f\u5f7c\u5973\u306b\u3064\u3044\u3066\u8a73\u3057\u304f\u5c0b\u306d\u308b\u3053\u3068\u306f\u306a\u304f\u3001\u5f7c\u5973\u306b\u5bfe\u3057\u3066\u540c\u60c5\u7684\u306a\u53e3\u8abf\u3067\u660e\u308b\u304f\u6697\u3044\u30c8\u30fc\u30f3\u3067\u8a71\u3092\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u3068\u3066\u3082\u7f8e\u3057\u3044\u6625\u3067\u3057\u305f\u3002"}
{"translation": "\u3053\u306e\u5973\u6027\u306f\u305a\u3063\u3068\u81ea\u5206\u81ea\u8eab\u3068\u6226\u3044\u7d9a\u3051\u3066\u3044\u308b\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3082\u3046\u9ad8\u9f62\u3067\u3059\u3002"}
{"translation": "\u5168\u3066\u306e\u76ae\u819a\u304c\u67d4\u3089\u304b\u304f\u4f0f\u305b\u3066\u3044\u308b\u306e\u3067\u3001\u4e00\u672c\u306e\u307e\u3068\u3082\u306a\u3057\u308f\u3055\u3048\u4f5c\u308a\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u306a\u3044\u3002"}
{"translation": "\u5f7c\u5973\u306e\u9854\u3068\u9996\u306b\u306f\u7d30\u304b\u3044\u75d5\u304c\u5bc6\u96c6\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u305d\u306e\u808c\u304c\u767d\u3044\u305f\u3081\u3001\u3053\u308c\u3089\u306e\u75d5\u8de1\u306f\u6642\u9593\u306e\u5200\u304c\u7121\u9020\u4f5c\u306b\u5f15\u304d\u88c2\u3044\u305f\u3088\u3046\u3067\u306f\u306a\u304f\u3001\u3080\u3057\u308d\u7d30\u3044\u7b46\u3067\u3072\u3068\u3064\u305a\u3064\u63cf\u304d\u51fa\u3055\u308c\u305f\u304b\u306e\u3088\u3046\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306e\u76ee\u306f\u3059\u3067\u306b\u66c7\u308a\u304d\u3063\u3066\u3044\u305f\u304c\u3001\u7a81\u7136\u5927\u304d\u304f\u958b\u3051\u308b\u3068\u3001\u307e\u3060\u5149\u304c\u4e2d\u304b\u3089\u5c04\u3059\u3053\u3068\u304c\u898b\u3048\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5e38\u306b\u4e00\u70b9\u3092\u898b\u3064\u3081\u3066\u307c\u3093\u3084\u308a\u3057\u3066\u3044\u308b\u3001\u4f55\u304b\u3092\u601d\u3063\u3066\u3044\u308b\u3088\u3046\u3067\u3001\u305d\u3057\u3066\u307e\u305f\u975e\u5e38\u306b\u9000\u5c48\u3057\u3066\u3044\u308b\u3088\u3046\u3060\u3002"}
{"translation": "\u305d\u306e\u305f\u3081\u3001\u6642\u3005\u901a\u884c\u4eba\u304c\u597d\u5947\u5fc3\u304b\u3089\u300c\u304a\u3070\u3042\u3055\u3093\u3001\u4f55\u3092\u8003\u3048\u3066\u3044\u308b\u306e\uff1f\u300d\u3068\u5c0b\u306d\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u6642\u3001\u5f7c\u5973\u306f\u56f0\u60d1\u3057\u305f\u9854\u3092\u898b\u305b\u3001\u901a\u884c\u4eba\u3092\u898b\u3064\u3081\u3066\u5c0f\u58f0\u3067\u8ab0\u306b\u3082\u805e\u3053\u3048\u306a\u3044\u8a00\u8449\u3092\u3064\u3076\u3084\u304f\u3060\u308d\u3046\u3002"}
{"translation": "\u5f7c\u5973\u306f\u81ea\u5206\u304c\u4f55\u3092\u8a00\u3063\u305f\u306e\u304b\u308f\u304b\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u5b9f\u969b\u3001\u5f7c\u5973\u81ea\u8eab\u3082\u81ea\u5206\u304c\u8003\u3048\u3066\u3044\u308b\u304b\u3069\u3046\u304b\u5206\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u5f7c\u5973\u306f\u305f\u3060\u591a\u304f\u306e\u5947\u5999\u306a\u3082\u306e\u304c\u61f8\u547d\u306b\u5916\u5074\u306b\u8df3\u306d\u3066\u3044\u308b\u3053\u3068\u3092\u611f\u3058\u3001\u5f7c\u5973\u306e\u8a18\u61b6\u3092\u523a\u6fc0\u3057\u3066\u3044\u308b\u3088\u3046\u3067\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u3089\u306f\u3001\u5f7c\u5973\u304c\u751f\u6daf\u3067\u89e6\u308c\u305f\u304f\u306a\u3044\u3082\u306e\u3070\u304b\u308a\u3060\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5fc5\u6b7b\u306b\u62b5\u6297\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u62b5\u6297\u306f\u3001\u98a8\u304c\u901a\u308a\u629c\u3051\u306a\u3044\u5927\u304d\u306a\u30cd\u30c3\u30c8\u306e\u3088\u3046\u3060\u3002"}
{"translation": "\u307e\u308b\u3067\u3001\u3044\u3064\u3067\u3082\u7a81\u7136\u98db\u3073\u51fa\u3059\u9b54\u9b3c\u3092\u8986\u3044\u5c3d\u304f\u3057\u3001\u675f\u7e1b\u3059\u308b\u304b\u306e\u3088\u3046\u3002"}
{"translation": "\u5f7c\u5973\u306e\u4e00\u751f\u306f\u5e38\u306b\u3053\u306e\u7db2\u3092\u632f\u308a\u56de\u3057\u3001\u305d\u308c\u3089\u3068\u95d8\u3044\u7d9a\u3051\u3066\u3044\u305f\u3002"}
{"translation": "\u592b\u304c\u751f\u304d\u3066\u3044\u308b\u3068\u304d\u3001\u5f7c\u5973\u306b\u4f55\u304b\u3092\u601d\u3044\u3064\u304f\u3088\u3046\u63d0\u6848\u3057\u305f\u3053\u3068\u304c\u3042\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u4f55\u304b\u8003\u3048\u51fa\u3059\u3068\u3001\u4eba\u3005\u306f\u5b89\u5fc3\u3059\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002"}
{"translation": "\u5f7c\u306e\u8a00\u8449\u3092\u805e\u304f\u3053\u3068\u3092\u5f7c\u5973\u306f\u9078\u3093\u3060\u3001\u305d\u3057\u3066\u5fc3\u304b\u3089\u81ea\u5206\u81ea\u8eab\u306b\u9759\u304b\u306b\u306a\u308b\u3088\u3046\u306b\u5f37\u3044\u3066\u3001\u5f37\u304f\u601d\u3044\u51fa\u305d\u3046\u3068\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u307b\u3093\u306e\u4e00\u77ac\u3067\u3001\u5168\u8eab\u306e\u4e0d\u5b89\u304c\u7121\u6570\u306e\u91dd\u306e\u3088\u3046\u306b\u7a81\u304d\u523a\u3055\u3063\u3066\u6765\u308b\u3002"}
{"translation": "\u305d\u306e\u529b\u5f37\u3055\u306f\u51f6\u66b4\u3067\u3001\u5f7c\u5973\u306f\u4e94\u81d3\u516d\u8151\u304c\u88c2\u3051\u308b\u3088\u3046\u306a\u611f\u899a\u3092\u899a\u3048\u305f\u3002"}
{"translation": "\u3053\u306e\u77ac\u9593\u3001\u5f7c\u5973\u306e\u75db\u307f\u3068\u75b2\u52b4\u304c\u5f7c\u5973\u306b\u606f\u3092\u6b62\u3081\u3055\u305b\u3066\u3057\u307e\u3046\u307b\u3069\u3060\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u7d76\u671b\u7684\u306b\u592b\u306b\u8a00\u3063\u305f\u3001\u300c\u79c1\u3092\u8ffd\u3044\u8fbc\u307e\u306a\u3044\u3067\u3002"}
{"translation": "\u79c1\u306f\u8003\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u306a\u3044\u3001\u8003\u3048\u308b\u3068\u81ea\u5206\u304c\u6b7b\u306c\u3079\u304d\u3060\u3068\u611f\u3058\u3066\u3057\u307e\u3046\u300d"}
{"translation": "\u5f7c\u5973\u306e\u592b\u306f\u602f\u3048\u3066\u3057\u307e\u3063\u305f\u3002"}
{"translation": "\u4e00\u6642\u306e\u6c88\u9ed8\u306e\u5f8c\u3001\u5f7c\u5973\u306b\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u305d\u308c\u4ee5\u4e0a\u8003\u3048\u308b\u5fc5\u8981\u306f\u306a\u3044\u3002"}
{"translation": "\u4f55\u304b\u81ea\u5206\u306b\u3084\u308b\u3053\u3068\u3092\u898b\u3064\u3051\u3066\u5fd9\u3057\u304f\u3059\u308b\u3068\u3001\u601d\u8003\u304c\u4e71\u308c\u307e\u3059\u3002\u300d"}
{"translation": "\u5f7c\u5973\u306f\u592b\u306e\u8a00\u8449\u306b\u5f93\u3063\u3066\u884c\u52d5\u3057\u3001\u6bce\u65e5\u5fd9\u3057\u304f\u904e\u3054\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u5b9f\u969b\u3001\u5f7c\u5973\u306e\u4ed5\u4e8b\u306f\u7279\u306b\u4f55\u3082\u306a\u304f\u3001\u5f7c\u5973\u306e\u4ed5\u4e8b\u306f\u5bb6\u4e8b\u3092\u3059\u308b\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u5f7c\u5973\u306f\u6bce\u65e5\u3001\u6383\u9664\u3084\u7247\u4ed8\u3051\u306b\u5fd9\u3057\u304f\u3001\u5bb6\u4e2d\u3092\u30d4\u30ab\u30d4\u30ab\u306b\u6574\u3048\u3066\u3044\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u5bb6\u3092\u8a2a\u308c\u305f\u5168\u3066\u306e\u4eba\u304c\u3001\u300c\u3042\u306a\u305f\u306e\u5bb6\u306f\u672c\u5f53\u306b\u304d\u308c\u3044\u3060\u306d\u300d\u3068\u8a00\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u592b\u306f\u533b\u8005\u3067\u3001\u5f7c\u5973\u306f\u305d\u306e\u3053\u3068\u3092\u8a87\u308a\u306b\u601d\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u305d\u3046\u3057\u3066\u3001\u5f7c\u5973\u306e\u751f\u6d3b\u306f\u5f90\u3005\u306b\u6b63\u5e38\u5316\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u4f55\u5e74\u3082\u7d4c\u3063\u305f\u304c\u3001\u5f7c\u5973\u306f\u305a\u3063\u3068\u3053\u306e\u307e\u307e\u3060\u3002"}
{"translation": "\u6bce\u5e74\u306e\u6642\u9593\u306f\u3001\u7d30\u5bc6\u3067\u53b3\u5bc6\u306a\u819c\u306e\u3088\u3046\u306b\u5f7c\u5973\u306e\u8a18\u61b6\u306e\u80cc\u5f8c\u306e\u3082\u306e\u3092\u5c64\u5c64\u306b\u8986\u3044\u96a0\u3057\u3066\u3044\u3063\u305f\u3002"}
{"translation": "\u5e74\u3005\u3001\u4e00\u679a\u305a\u3064\u539a\u307f\u304c\u5897\u3057\u3001\u677f\u306e\u3088\u3046\u306b\u56fa\u307e\u3063\u3066\u3044\u304f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u610f\u8b58\u306e\u5965\u5e95\u306b\u79d8\u3081\u3089\u308c\u305f\u60aa\u9b54\u305f\u3061\u306f\u5168\u3066\u5c01\u3058\u8fbc\u3081\u3089\u308c\u3066\u3044\u3063\u305f\u3002"}
{"translation": "\u3067\u3082\u305d\u308c\u304c\u4f55\u306a\u306e\u304b\u3001\u5f7c\u5973\u306f\u5168\u304f\u77e5\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u304c\u8a18\u61b6\u3092\u5931\u3063\u305f\u306e\u306f1952\u5e74\u306e\u6625\u3067\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3053\u308c\u304c\u592b\u306e\u6170\u3081\u3068\u30ea\u30de\u30a4\u30f3\u30c0\u30fc\u3067\u3042\u308b\u3053\u3068\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u305a\u3001\u5fc3\u306e\u4e2d\u3067\u306f\u305f\u3060\u8f9b\u8fa3\u306a\u52d5\u63fa\u304c\u7d9a\u3044\u3066\u3044\u305f\u3002"}
{"translation": "\u307e\u308b\u3067\u5f7c\u5973\u306e\u592b\u304c\u624b\u306b\u53d6\u308b\u3088\u3046\u306b\u64cd\u3063\u3066\u3044\u305f\u304b\u306e\u3088\u3046\u306b\u3001\u5b8c\u5168\u306b\u59ff\u3092\u6d88\u3057\u304b\u3051\u3066\u3044\u305f\u6b7b\u6575\u304c\u971e\u3093\u3067\u898b\u3048\u308b\u3002"}
{"translation": "\u305d\u308c\u306f\u4e00\u4f53\u4f55\u306a\u306e\u3067\u3057\u3087\u3046\u304b\uff1f"}
{"translation": "\u5f7c\u304c\u79c1\u304c\u77e5\u3089\u306a\u3044\u3053\u3068\u3092\u77e5\u3063\u3066\u308b\u308f\u3051\u306a\u3044\u3067\u3057\u3087\u3046\uff1f"}
{"translation": "\u305d\u3046\u8003\u3048\u3066\u3001\u6050\u308d\u3057\u3044\u6c17\u914d\u304c\u81ea\u5206\u306b\u76f4\u6483\u3059\u308b\u611f\u3058\u3055\u3048\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u6050\u6016\u306f\u5f7c\u5973\u306e\u8eab\u306e\u56de\u308a\u306b\u5b58\u5728\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u65e5\u3005\u591c\u3005\u3001\u5206\u3005\u79d2\u3005\u3002"}
{"translation": "\u305d\u308c\u3067\u5f7c\u5973\u306f\u7406\u89e3\u3057\u305f\u3001\u3053\u308c\u307e\u3067\u306e\u591a\u5e74\u306b\u308f\u305f\u308a\u3001\u5f7c\u5973\u304c\u6df1\u304f\u611b\u3057\u3066\u304d\u305f\u4eba\u304c\u3001\u540c\u6642\u306b\u5f71\u304b\u3089\u5f37\u304f\u6050\u308c\u3066\u3044\u305f\u3060\u3068\u3044\u3046\u3053\u3068\u3092\u3002"}
{"translation": "\u306a\u305c\u3060\u308d\u3046\uff1f"}
{"translation": "\u306a\u305c\u5f7c\u5973\u306f\u305d\u306e\u3088\u3046\u306a\u611f\u899a\u304c\u751f\u3058\u305f\u306e\u304b\uff1f"}
{"translation": "\u5f7c\u5973\u306f\u3068\u3066\u3082\u56f0\u60d1\u3057\u3066\u3044\u3066\u3001\u7406\u89e3\u3067\u304d\u306a\u3044\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u3053\u306e\u611f\u899a\u306f\u78ba\u304b\u306b\u5b58\u5728\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u7a93\u306e\u5916\u306b\u3042\u308b\u6843\u306e\u6728\u306f\u982d\u304b\u3089\u8db3\u307e\u3067\u30d4\u30f3\u30af\u8272\u306e\u82b1\u3067\u4e00\u676f\u3060\u3063\u305f\u3002"}
{"translation": "\u4e2d\u5ead\u306e\u58c1\u8fba\u306e\u674f\u306e\u82b1\u3082\u4e00\u5217\u306b\u767d\u304f\u306a\u308a\u3001\u767d\u3044\u58c1\u3068\u4f75\u305b\u3066\u9060\u304f\u304b\u3089\u3067\u306f\u82b1\u306e\u8272\u304c\u533a\u5225\u3067\u304d\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u3055\u3089\u306b\u9060\u304f\u3067\u306f\u3001\u6570\u672c\u306e\u5927\u304d\u306a\u9280\u674f\u304c\u7dd1\u8272\u306e\u8449\u3092\u63fa\u3089\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u592a\u3044\u5e79\u304b\u3089\u306f\u3001\u305d\u308c\u304c\u3044\u3064\u690d\u3048\u3089\u308c\u305f\u306e\u304b\u63a8\u6e2c\u3059\u308b\u3053\u3068\u306f\u3067\u304d\u306a\u3044\u3002"}
{"translation": "\u305d\u308c\u304c\u66f4\u306b\u9060\u304f\u3078\u7d9a\u3044\u3066\u3044\u304d\u3001\u5c71\u306e\u5f71\u306f\u512a\u96c5\u306b\u8d77\u4f0f\u3057\u3001\u305d\u306e\u8f2a\u90ed\u306f\u82b1\u3073\u3089\u306e\u3088\u3046\u3060\u3063\u305f\u3002"}
{"translation": "\u4e2d\u5ead\u306e\u9685\u306b\u54b2\u3044\u3066\u3044\u308b\u8fce\u6625\u82b1\u306f\u3082\u3046\u3059\u3050\u6563\u308a\u305d\u3046\u3060\u304c\u3001\u305d\u306e\u9bae\u3084\u304b\u306a\u9ec4\u8272\u3044\u82b1\u306f\u307e\u3060\u660e\u308b\u304f\u8f1d\u3044\u3066\u3044\u305f\u3002"}
{"translation": "\u4e94\u5f69\u6591\u6593\u306a\u8272\u5f69\u304c\u7a81\u7136\u5f7c\u5973\u306e\u8996\u91ce\u306b\u98db\u3073\u8fbc\u3093\u3067\u304d\u305f\u3002"}
{"translation": "\u6625\u306b\u623b\u308b\u9ce5\u305f\u3061\u306f\u3001\u3053\u306e\u6642\u3001\u5143\u6c17\u3092\u53d6\u308a\u623b\u3057\u305f\u3088\u3046\u3067\u3059\u3002"}
{"translation": "\u98a8\u304c\u307e\u3060\u51b7\u305f\u3044\u306b\u3082\u304b\u304b\u308f\u3089\u305a\u3001\u5f7c\u3089\u306f\u305d\u306e\u5fae\u7d30\u306a\u5bd2\u3055\u306e\u4e2d\u3067\u6b4c\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u3088\u3046\u306a\u98a8\u666f\u3068\u97f3\u306e\u4e2d\u3067\u3001\u5f7c\u5973\u306f\u3086\u3063\u304f\u308a\u3068\u9759\u3051\u3055\u3092\u53d6\u308a\u623b\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u304c\u6025\u6d41\u304b\u3089\u5f15\u304d\u4e0a\u3052\u3089\u308c\u305f\u6642\u3001\u5f7c\u5973\u306f\u5168\u88f8\u3060\u3063\u305f\u3002"}
{"translation": "\u982d\u304b\u3089\u8db3\u307e\u3067\u3001\u8eab\u4f53\u4e2d\u304c\u50b7\u3060\u3089\u3051\u3060\u3002"}
{"translation": "\u305d\u308c\u306f\u77f3\u3068\u6025\u6d41\u304c\u885d\u7a81\u3057\u305f\u7d50\u679c\u3060\u3002"}
{"translation": "\u5f7c\u5973\u3092\u52a9\u3051\u305f\u4eba\u306f\u3001\u6c34\u3067\u5f7c\u5973\u306e\u5168\u8eab\u304c\u771f\u3063\u767d\u306b\u306a\u308a\u3001\u9aea\u3060\u3051\u304c\u307e\u3060\u9ed2\u3044\u3068\u8a00\u3063\u305f\u3002"}
{"translation": "\u50b7\u304c\u3069\u3053\u306b\u3042\u308b\u306e\u304b\u4e00\u898b\u3067\u306f\u5206\u304b\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u5e78\u904b\u306b\u3082\u8fd1\u304f\u306e\u6751\u3067\u6570\u4eba\u306e\u8ecd\u533b\u304c\u8a3a\u5bdf\u3092\u3057\u3066\u3044\u305f\u306e\u3067\u3001\u5f7c\u3089\u306f\u76f4\u63a5\u5f7c\u5973\u3092\u305d\u3053\u3078\u9023\u308c\u3066\u884c\u3063\u305f\u3002"}
{"translation": "\u7dca\u6025\u5bfe\u5fdc\u306e\u5f8c\u3001\u305d\u306e\u6570\u4eba\u306e\u533b\u5e2b\u306f\u5f7c\u5973\u3092\u7d20\u65e9\u304f\u75c5\u9662\u3078\u9023\u308c\u623b\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u75c5\u9662\u3067\u534a\u6708\u4ee5\u4e0a\u3082\u904e\u3054\u3057\u3066\u304b\u3089\u3088\u3046\u3084\u304f\u610f\u8b58\u3092\u53d6\u308a\u623b\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u304c\u610f\u8b58\u3092\u53d6\u308a\u623b\u3057\u3001\u4eba\u3005\u306e\u8cea\u554f\u306b\u7b54\u3048\u3088\u3046\u3068\u3057\u305f\u3068\u304d\u3001\u7a81\u7136\u832b\u7136\u81ea\u5931\u306b\u306a\u3063\u305f\u3002"}
