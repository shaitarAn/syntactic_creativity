{"translation": "\u300c\u5f7c\u306f\u305d\u3053\u304b\u3089\u51fa\u3066\u6765\u306a\u3044\u3063\u3066\u8a00\u3063\u3066\u308b\u3093\u3060\u300d\u3068\u306b\u304d\u3073\u9762\u304c\u78ba\u4fe1\u306b\u6e80\u3061\u3066\u9837\u3044\u305f\u3002"}
{"translation": "\u65e2\u306b\u5f7c\u304c\u3042\u305d\u3053\u306b\u5165\u3063\u3066\u304b\u30891\u6642\u959315\u5206\u3082\u7d4c\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u3082\u3046\u5f7c\u306f\u7d42\u308f\u3063\u305f\u3002"}
{"translation": "\u753a\u4eba\u305f\u3061\u306f\u3001\u5ec3\u589f\u306e\u4e2d\u306b\u8a70\u3081\u8fbc\u307e\u308c\u3001\u304c\u308c\u304d\u3067\u585e\u304c\u308c\u305f\u5730\u4e0b\u3078\u306e\u5165\u53e3\u3084\u3001\u74e6\u792b\u306e\u5c71\u304b\u3089\u3042\u304f\u3073\u3092\u3057\u3066\u3044\u308b\u9ed2\u3044\u7a74\u3092\u3058\u3063\u3068\u898b\u3064\u3081\u3066\u6c88\u9ed9\u3057\u305f\u3002"}
{"translation": "\u9ec4\u8272\u306e\u539a\u7740\u3092\u3057\u305f\u592a\u3063\u305f\u7537\u304c\u3001\u7247\u8db3\u304b\u3089\u3082\u3046\u4e00\u65b9\u306e\u8db3\u3078\u3068\u4f53\u91cd\u3092\u79fb\u3057\u3001\u54b3\u6255\u3044\u3092\u3057\u305f\u5f8c\u3067\u3001\u304f\u3057\u3083\u304f\u3057\u3083\u306b\u306a\u3063\u305f\u30d9\u30ec\u30fc\u5e3d\u3092\u982d\u304b\u3089\u53d6\u308a\u53bb\u3063\u305f\u3002"}
{"translation": "\u300c\u3082\u3046\u5c11\u3057\u5f85\u3068\u3046\u300d\u3068\u5f7c\u306f\u8a00\u3044\u306a\u304c\u3089\u3001\u6ef2\u3080\u6c57\u3092\u5e0c\u306a\u7709\u6bdb\u3067\u62ed\u3063\u305f\u3002"}
{"translation": "\u300c\u4f55\u306b\u3060\uff1f\u300d\u3068\u30cb\u30ad\u30d3\u9854\u304c\u3042\u3056\u7b11\u3063\u305f\u3002"}
{"translation": "\u3042\u305d\u3053\u3001\u5730\u4e0b\u7262\u306b\u306f\u30d0\u30b8\u30ea\u30b9\u30af\u304c\u3044\u308b\u3093\u3060\u305e\u3002"}
{"translation": "\u5fd8\u308c\u305f\u304b\u3001\u6751\u9577\uff1f"}
{"translation": "\u305d\u3053\u306b\u5165\u308b\u8005\u306f\u3001\u3059\u3067\u306b\u898b\u8fbc\u307f\u304c\u306a\u3044\u3002"}
{"translation": "\u305d\u3053\u3067\u4ea1\u304f\u306a\u3063\u305f\u4eba\u3005\u306f\u5c11\u306a\u304f\u306a\u3044\u306e\u304b\uff1f"}
{"translation": "\u3053\u3053\u3067\u4f55\u3092\u5f85\u3064\u3079\u304d\u306a\u306e\u304b\uff1f"}
{"translation": "\u300c\u3060\u3063\u3066\u3001\u79c1\u305f\u3061\u306f\u7d04\u675f\u3057\u3066\u305f\u3093\u3060\u308d\u300d\u4e0d\u78ba\u304b\u306b\u592a\u3063\u305f\u7537\u304c\u3064\u3076\u3084\u3044\u305f\u3002"}
{"translation": "\u3069\u3046\u3044\u3046\u3053\u3068\u3060\uff1f"}
{"translation": "\u300c\u751f\u8005\u3068\u4ea4\u6e09\u3059\u3079\u304d\u3060\u3063\u305f\u3093\u3060\u3088\u300d\u3001\u306b\u304d\u3073\u9762\u306e\u4ef2\u9593\u304c\u5de8\u6f22\u3067\u30ec\u30b6\u30fc\u30a8\u30d7\u30ed\u30f3\u3092\u7740\u3066\u3044\u308b\u6751\u9577\u306b\u305d\u3046\u8a00\u3063\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u4eca\u3001\u5f7c\u306f\u6b7b\u3093\u3067\u3044\u308b\u3002"}
{"translation": "\u305d\u308c\u306f\u5929\u306e\u592a\u967d\u304c\u78ba\u304b\u306a\u5b58\u5728\u3067\u3042\u308b\u3068\u540c\u3058\u3060\u3002"}
{"translation": "\u5f7c\u304c\u707d\u96e3\u306b\u906d\u3046\u3053\u3068\u306f\u6700\u521d\u304b\u3089\u660e\u3089\u304b\u3067\u3001\u5f7c\u4ee5\u524d\u306e\u4eba\u3005\u3082\u305d\u3046\u3060\u3063\u305f\u3002"}
{"translation": "\u5f7c\u306f\u5263\u3060\u3051\u3092\u6301\u3063\u3066\u3001\u93e1\u3092\u4f7f\u308f\u306a\u3044\u3067\u884c\u3063\u305f\u3093\u3060\u304b\u3089\u3002"}
{"translation": "\u305d\u3057\u3066\u3001\u30d0\u30b7\u30ea\u30b9\u30af\u3092\u6bba\u3059\u306b\u306f\u93e1\u304c\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\u3001\u305d\u308c\u306f\u8ab0\u3082\u304c\u77e5\u3063\u3066\u3044\u308b\u3053\u3068\u3060\u3002"}
{"translation": "\u3069\u3046\u3044\u3046\u3053\u3068\u3060\uff1f"}
{"translation": "\u300c\u4e00\u92ad\u3082\u7bc0\u7d04\u3057\u307e\u3057\u305f\u306d\u3001\u306b\u304d\u3073\u9762\u306e\u90f7\u9577\u304c\u4ed8\u3051\u52a0\u3048\u305f\u3002"}
{"translation": "\u3060\u3063\u3066\u3001\u30d0\u30b8\u30ea\u30b9\u30af\u306e\u4ee3\u91d1\u3092\u6255\u3046\u76f8\u624b\u306a\u3093\u3066\u3044\u306a\u3044\u304b\u3089\u3055\u3002"}
{"translation": "\u5b89\u5fc3\u3057\u3066\u3053\u3053\u304b\u3089\u51fa\u3066\u5e30\u5b85\u3057\u306a\u3055\u3044\u3002"}
{"translation": "\u305d\u3057\u3066\u3001\u6211\u3005\u306f\u9b54\u8853\u5e2b\u306e\u99ac\u3068\u5bb6\u755c\u3092\u596a\u3046\u3002"}
{"translation": "\u8cc7\u7523\u3092\u7121\u99c4\u306b\u3059\u308b\u306e\u306f\u60dc\u3057\u3044\u304b\u3089\u3060\u3002"}
{"translation": "\u300c\u3048\u3048\u3001\u305d\u3046\u3060\u300d\u3068\u8089\u5c4b\u304c\u8a00\u3063\u305f\u3002"}
{"translation": "\u5f37\u58ee\u306a\u96cc\u99ac\u3060\u3001\u305d\u308c\u306b\u30e6\u30ad\u3082\u304b\u306a\u308a\u80a5\u6e80\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u4e2d\u8eab\u3092\u898b\u3066\u307f\u307e\u3057\u3087\u3046\u3002"}
{"translation": "\u4f55\u3092\u3057\u307e\u3057\u305f\u304b\uff1f"}
{"translation": "\u300c\u9ed9\u3063\u3066\u308d\u3001\u65e6\u90a3\u3002"}
{"translation": "\u53e3\u51fa\u3057\u3057\u306a\u3044\u3067\u304f\u308c\u3001\u305d\u3046\u3057\u306a\u304d\u3083\u3053\u3053\u304c\u75db\u3080\u3088\u300d"}
{"translation": "\u3068\u306b\u304d\u3073\u9854\u304c\u8b66\u544a\u3057\u305f\u3002"}
{"translation": "\u300c\u5065\u5eb7\u306a\u99ac\u300d\u3068\u8089\u5c4b\u304c\u7e70\u308a\u8fd4\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u99ac\u3092\u305d\u3063\u3068\u3057\u3066\u304a\u3044\u3066\u304f\u308c\u3001\u611b\u3057\u3044\u4eba\u3088\u3002"}
{"translation": "\u8089\u5c4b\u306f\u3086\u3063\u304f\u308a\u3068\u898b\u77e5\u3089\u306c\u8a2a\u554f\u8005\u306e\u65b9\u306b\u5411\u304d\u76f4\u3063\u305f\u3002"}
{"translation": "\u305d\u306e\u4eba\u7269\u306f\u58c1\u306e\u3059\u304d\u9593\u304b\u3089\u3001\u305d\u3057\u3066\u5165\u53e3\u5468\u8fba\u3067\u96c6\u307e\u3063\u3066\u3044\u305f\u7fa4\u8846\u306e\u80cc\u5f8c\u304b\u3089\u73fe\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u898b\u77e5\u3089\u306c\u7537\u306f\u3001\u30ab\u30fc\u30eb\u3057\u305f\u304d\u308c\u3044\u306a\u6817\u8272\u306e\u9aea\u304c\u7279\u5fb4\u3067\u3001\u539a\u624b\u306e\u7fbd\u7e54\u7269\u306e\u4e0a\u306b\u8336\u8272\u3044\u30c1\u30e5\u30cb\u30c3\u30af\u3092\u7740\u3066\u3001\u9ad8\u304f\u3066\u9a0e\u624b\u7528\u306e\u30d6\u30fc\u30c4\u3092\u5c65\u3044\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u6b66\u5668\u306a\u3057\u3002"}
{"translation": "\u300c\u99ac\u304b\u3089\u96e2\u308c\u308d\u300d\u3068\u5f7c\u306f\u518d\u5ea6\u8a00\u3063\u305f\u3001\u610f\u5730\u60aa\u305d\u3046\u306b\u7b11\u3044\u306a\u304c\u3089\u3002"}
{"translation": "\u305d\u308c\u306f\u3069\u3046\u3044\u3046\u3053\u3068\u3060\uff1f"}
{"translation": "\u300c\u4eba\u306e\u99ac\u3060\u3001\u4eba\u306e\u9ea6\u3060\u3001\u4ed6\u4eba\u306e\u8ca1\u7523\u3060\u305e\u3002"}
{"translation": "\u304a\u524d\u306f\u305d\u306e\u6c5a\u3089\u3057\u3044\u76ee\u3067\u305d\u308c\u3092\u898b\u3064\u3081\u3001\u53e4\u81ed\u3044\u624b\u3092\u4f38\u3070\u3059\u306e\u304b\uff1f\u300d"}
{"translation": "\u305d\u308c\u3067\u3044\u3044\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u306b\u304d\u3073\u9762\u3067\u3001\u3086\u3063\u304f\u308a\u3068\u30b3\u30fc\u30c8\u306e\u8107\u4e0b\u306b\u624b\u3092\u6ed1\u3089\u305b\u306a\u304c\u3089\u3001\u8089\u5c4b\u3092\u898b\u3064\u3081\u305f\u3002"}
{"translation": "\u5c60\u6bba\u8005\u306f\u9837\u304d\u3001\u3055\u3089\u306b2\u4eba\u304c\u77ed\u304f\u4e38\u5208\u308a\u306b\u3057\u305f\u592a\u3063\u305f\u7537\u305f\u3061\u306e\u96c6\u56e3\u304b\u3089\u51fa\u3066\u304f\u308b\u6240\u3092\u6307\u5dee\u3057\u305f\u3002"}
{"translation": "\u5f7c\u3089\u4e8c\u4eba\u306f\u68cd\u68d2\u3092\u6301\u3063\u3066\u3044\u3066\u3001\u305d\u308c\u306f\u5c60\u6bba\u5834\u3067\u52d5\u7269\u3092\u7a92\u606f\u3055\u305b\u308b\u3088\u3046\u306a\u3082\u306e\u3060\u3063\u305f\u3002"}
{"translation": "\u300c\u305d\u3093\u306a\u3053\u3068\u3092\u554f\u3044\u304b\u3051\u308b\u4eba\u306f\u8ab0\u3060\uff1f\u300d"}
{"translation": "\u3068\u30cb\u30ad\u30d3\u9762\u306f\u814b\u304b\u3089\u624b\u3092\u51fa\u3059\u3053\u3068\u306a\u304f\u5c0b\u306d\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u6211\u3005\u306b\u4f55\u304c\u6b63\u3057\u3044\u3067\u3001\u4f55\u304c\u9069\u5207\u3067\u306a\u3044\u306e\u304b\u793a\u3059\u305f\u3081\u306b\uff1f\u300d"}
{"translation": "\u305d\u308c\u306b\u3064\u3044\u3066\u306f\u3001\u541b\u306b\u306f\u95a2\u4fc2\u306a\u3044\u3001\u611b\u3057\u3044\u4eba\u3088\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u6b66\u5668\u3092\u6301\u3063\u3066\u3044\u307e\u305b\u3093\u3002"}
{"translation": "\u305d\u306e\u898b\u77e5\u3089\u306c\u4eba\u306f\u3055\u3089\u306b\u610f\u5730\u60aa\u305d\u3046\u306b\u7b11\u3063\u305f\u3002"}
{"translation": "\u79c1\u306f\u6301\u3063\u3066\u3044\u307e\u305b\u3093\u3002"}
{"translation": "\u305d\u306e\u306b\u304d\u3073\u3060\u3089\u3051\u306e\u4e0d\u826f\u304c\u8107\u304b\u3089\u624b\u3092\u51fa\u3057\u3001\u9577\u3044\u30ca\u30a4\u30d5\u3068\u5171\u306b\u3002"}
{"translation": "\u305d\u308c\u3092\u8eab\u306b\u3064\u3051\u3066\u3044\u306a\u3044\u306e\u306f\u3001\u3068\u3066\u3082\u826f\u304f\u306a\u3044\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u8089\u5c4b\u3082\u307e\u305f\u3001\u77ed\u5263\u306e\u3088\u3046\u306b\u9577\u3044\u5305\u4e01\u3092\u5f15\u304d\u629c\u3044\u305f\u3002"}
{"translation": "\u305d\u306e\u4e8c\u4eba\u306f\u524d\u306b\u9032\u307f\u3001\u68d2\u3092\u632f\u308a\u4e0a\u3052\u305f\u3002"}
{"translation": "\u300c\u50d5\u306f\u904b\u3070\u306a\u304f\u3066\u3082\u3044\u3044\u3088\u300d"}
{"translation": "\u305d\u306e\u898b\u77e5\u3089\u306c\u4eba\u306f\u3001\u8eab\u3058\u308d\u304e\u3082\u3057\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u79c1\u306e\u6b66\u5668\u304c\u79c1\u306e\u5f8c\u3092\u8ffd\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u5ec3\u589f\u304b\u3089\u3001\u67d4\u3089\u304b\u304f\u78ba\u5b9f\u306a\u4e00\u6b69\u3067\u3001\u4e8c\u4eba\u306e\u82e5\u3044\u5973\u6027\u304c\u51fa\u3066\u304d\u305f\u3002"}
{"translation": "\u305d\u306e\u7fa4\u8846\u306f\u3059\u3050\u306b\u5206\u304b\u308c\u3001\u5f8c\u9000\u3057\u3001\u5e0c\u8584\u306b\u306a\u3063\u305f\u3002"}
{"translation": "\u4e8c\u4eba\u306e\u5973\u5b50\u306f\u7b11\u9854\u3092\u6d6e\u304b\u3079\u3001\u6b6f\u3092\u898b\u305b\u306a\u304c\u3089\u76ee\u3092\u7d30\u3081\u3001\u305d\u308c\u306b\u7d9a\u3044\u3066\u8033\u306e\u65b9\u5411\u3078\u5e83\u304c\u308b\u5927\u304d\u306a\u9752\u3044\u5165\u308c\u58a8\u306e\u5e2f\u304c\u63cf\u304b\u308c\u3066\u3044\u305f\u3002"}
{"translation": "\u5f37\u976d\u306a\u592a\u3082\u3082\u306e\u7b4b\u8089\u304c\u30ea\u30f3\u30af\u30b9\u306e\u76ae\u3067\u8986\u308f\u308c\u305f\u8170\u304b\u3089\u306f\u307f\u51fa\u3057\u3001\u307e\u305f\u88f8\u306e\u4e38\u3044\u80a9\u304b\u3089\u91dd\u91d1\u7db2\u306e\u624b\u888b\u307e\u3067\u304c\u898b\u3048\u3066\u3044\u305f\u3002"}
{"translation": "\u80a9\u3092\u8986\u3063\u3066\u3044\u308b\u9396\u5e37\u5b50\u304b\u3089\u3082\u3001\u5200\u306e\u67c4\u304c\u7a81\u304d\u51fa\u3066\u3044\u305f\u3002"}
{"translation": "\u306b\u304d\u3073\u9762\u306f\u3086\u3063\u304f\u308a\u3068\u3001\u975e\u5e38\u306b\u3086\u3063\u304f\u308a\u3068\u819d\u3092\u66f2\u3052\u3001\u5730\u9762\u306b\u30ca\u30a4\u30d5\u3092\u843d\u3068\u3057\u305f\u3002"}
{"translation": "\u304c\u308c\u304d\u306e\u7a74\u304b\u3089\u77f3\u304c\u30ac\u30e9\u30ac\u30e9\u3068\u97f3\u3092\u7acb\u3066\u3001\u305d\u306e\u5f8c\u30c7\u30b3\u30dc\u30b3\u3057\u305f\u58c1\u306b\u63b4\u307e\u3063\u305f\u624b\u304c\u95c7\u304b\u3089\u73fe\u308c\u305f\u3002"}
{"translation": "\u624b\u306e\u5f8c\u308d\u306b\u306f\u3001\u767d\u304f\u3066\u7149\u74e6\u7c89\u3067\u5857\u3089\u308c\u305f\u9aea\u306e\u982d\u3001\u9752\u767d\u3044\u9854\u3001\u80a9\u304b\u3089\u7a81\u304d\u51fa\u308b\u5263\u306e\u67c4\u304c\u6b21\u3005\u3068\u73fe\u308c\u305f\u3002"}
{"translation": "\u7fa4\u8846\u304c\u3056\u308f\u3064\u3044\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u8001\u4eba\u306f\u4e38\u307e\u3063\u3066\u7a74\u304b\u3089\u5947\u5999\u306a\u5f62\u306e\u3001\u5947\u629c\u306a\u4f53\u3092\u5f15\u3063\u5f35\u308a\u51fa\u3059\u3001\u8840\u306b\u6d78\u3057\u305f\u5875\u306b\u3046\u3082\u308c\u305f\u3053\u306e\u3075\u304f\u3088\u304b\u306a\u4f53\u3002"}
{"translation": "\u9577\u3044\u30c8\u30ab\u30b2\u306e\u5c3e\u3092\u3064\u304b\u3093\u3067\u3044\u305f\u602a\u7269\u3092\u3001\u5f7c\u306f\u4e00\u8a00\u3082\u8a00\u308f\u305a\u306b\u592a\u3063\u305f\u6751\u9577\u306e\u8db3\u5143\u306b\u6295\u3052\u3064\u3051\u305f\u3002"}
{"translation": "\u6751\u9577\u306f\u98db\u3073\u9000\u304d\u3001\u5012\u308c\u305f\u58c1\u306e\u4e00\u90e8\u306b\u8db3\u3092\u53d6\u3089\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u6e7e\u66f2\u3057\u305f\u9ce5\u306e\u3088\u3046\u306a\u304f\u3061\u3070\u3057\u3001\u819c\u72b6\u306e\u7ffc\u3001\u305d\u3057\u3066\u9c57\u306b\u8986\u308f\u308c\u305f\u624b\u8db3\u306b\u3042\u308b\u938c\u72b6\u306e\u722a\u3092\u898b\u3064\u3081\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u304b\u3064\u3066\u306f\u7d05\u8272\u3060\u3063\u305f\u304c\u3001\u73fe\u5728\u306f\u6c5a\u308c\u3066\u8d64\u8910\u8272\u3068\u306a\u3063\u3066\u3044\u308b\u3075\u304f\u308c\u305f\u5589\u4ecf\u3002"}
{"translation": "\u30ac\u30e9\u30b9\u306e\u3088\u3046\u306a\u3001\u304f\u307c\u3093\u3060\u76ee\u306b\u3002"}
{"translation": "\u300c\u3053\u3053\u306b\u30d0\u30b8\u30ea\u30b9\u30af\u304c\u3044\u308b\u300d\u3068\u767d\u9aea\u306e\u7537\u6027\u306f\u8a00\u3063\u3066\u3001\u30ba\u30dc\u30f3\u304b\u3089\u307b\u3053\u308a\u3092\u843d\u3068\u3057\u305f\u3002"}
{"translation": "\u5951\u7d04\u901a\u308a\u306b\u3002"}
{"translation": "\u79c1\u306e200\u30ea\u30f3\u30bf\u30fc\u30eb\u3001\u3082\u3057\u304f\u308c\u3089\u308c\u308b\u306a\u3089\u3002"}
{"translation": "\u6b63\u76f4\u306a\u8a34\u8a1f\u624b\u7d9a\u304d\u3092\u884c\u3046\u4eba\u3005\u3001\u307b\u3068\u3093\u3069\u9154\u3063\u6255\u3063\u3066\u3044\u306a\u3044\u4eba\u3005\u3002"}
{"translation": "\u78ba\u8a8d\u3057\u307e\u3059\u3001\u3060\u304b\u3089\u8a00\u3063\u3066\u304a\u304f\u3002"}
{"translation": "\u5f79\u5834\u306e\u4eba\u306f\u3001\u9707\u3048\u308b\u624b\u3067\u8ca1\u5e03\u3092\u53d6\u308a\u51fa\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u306f\u898b\u56de\u3057\u3001\u4e00\u77ac\u3001\u304d\u308c\u3044\u3067\u306f\u306a\u3044\u3082\u306e\u306b\u76ee\u304c\u7559\u307e\u308a\u3001\u8db3\u5143\u306b\u843d\u3061\u3066\u3044\u308b\u30ca\u30a4\u30d5\u3092\u898b\u3064\u3051\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u8336\u8272\u306e\u30c1\u30e5\u30cb\u30c3\u30af\u3092\u7740\u305f\u7537\u3068\u3001\u30ea\u30b9\u306e\u76ae\u3092\u307e\u3068\u3063\u305f\u5973\u6027\u305f\u3061\u3092\u898b\u3064\u3081\u305f\u3002"}
{"translation": "\u300c\u3053\u308c\u3067\u3082\u304f\u308c\u300d\u3068\u5f7c\u306f\u9707\u3048\u308b\u6751\u9577\u306e\u624b\u304b\u3089\u7d19\u5dfb\u304d\u7159\u8349\u3092\u53d6\u308a\u51fa\u3057\u306a\u304c\u3089\u3001\u3044\u3064\u3082\u901a\u308a\u8a00\u3063\u305f\u3002"}
{"translation": "\u3042\u306a\u305f\u65b9\u306e\u305f\u3081\u306b\u3001\u50c5\u304b\u306a\u5831\u916c\u3067\u81ea\u5206\u306e\u547d\u3092\u5371\u967a\u306b\u3055\u3089\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u305d\u308c\u306a\u306e\u306b\u3042\u306a\u305f\u65b9\u306f\u79c1\u306e\u6301\u3061\u7269\u3092\u7269\u8272\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u3042\u3093\u305f\u305f\u3061\u306f\u3001\u3053\u306e\u91ce\u90ce\u3001\u4e00\u4f53\u5168\u4f53\u3069\u3046\u3057\u3066\u5909\u308f\u308b\u3053\u3068\u304c\u3067\u304d\u306a\u3044\u3093\u3060\u3002"}
{"translation": "\u300c\u624b\u3092\u4ed8\u3051\u3066\u306a\u3044\u300d\u3068\u3001\u8089\u5c4b\u306f\u3064\u3076\u3084\u304d\u306a\u304c\u3089\u9000\u3044\u305f\u3002"}
{"translation": "\u3042\u306e\u68d2\u3092\u6301\u3063\u305f\u8005\u305f\u3061\u306f\u3068\u3063\u304f\u306b\u7fa4\u8846\u306b\u6eb6\u3051\u8fbc\u3093\u3067\u3057\u307e\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u3042\u306a\u305f\u306e\u6301\u3061\u7269\u306f\u305d\u306e\u307e\u307e\u3067\u3059\u3088\u3001\u65e6\u90a3\u3055\u3093\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u306f\u3001\u975e\u5e38\u306b\u5b09\u3057\u305d\u3046\u306b\u5fae\u7b11\u3093\u3060\u3002"}
{"translation": "\u305d\u306e\u5fae\u7b11\u307f\u3092\u898b\u3066\u3001\u9752\u3056\u3081\u305f\u9854\u306b\u54b2\u304d\u8a87\u308b\u304b\u306e\u3088\u3046\u306a\u958b\u304f\u50b7\u75cd\u306b\u3001\u4eba\u3005\u306f\u3059\u3050\u306b\u6563\u3089\u3070\u308a\u59cb\u3081\u305f\u3002"}
{"translation": "\u3060\u304b\u3089\u3001\u5144\u5f1f\u3088\u3001\u3042\u306a\u305f\u3082\u307e\u305f\u52d5\u63fa\u3059\u308b\u3053\u3068\u306f\u306a\u3044\u3060\u308d\u3046\u3002"}
{"translation": "\u5e73\u548c\u306b\u53bb\u308a\u306a\u3055\u3044\u3002"}
{"translation": "\u3067\u3082\u3001\u3059\u3050\u306b\u51fa\u3066\u884c\u3063\u3066\u304f\u3060\u3055\u3044\u3002"}
