{"translation": "\u79c1\u306e\u307b\u304a\u306e\u4e0b\u306b\u3042\u308b\u306e\u306f\u604b\u611b\u66f8\u7c21\uff1a\u305d\u3053\u306b\u306f\u7537\u304c\u5973\u6027\u3068\u51fa\u4f1a\u3046\u7269\u8a9e\u304c\u66f8\u304b\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u5f7c\u306f\u65e2\u5a5a\u3067\u3001\u5f7c\u5973\u306b\u306f\u5f7c\u6c0f\u304c\u3044\u307e\u3059\u3002"}
{"translation": "\uff17\u30da\u30fc\u30b8\u8aad\u3093\u3060\u3060\u3051\u3067\u3001\u3059\u3067\u306b\u305d\u306e\u5185\u5bb9\u3092\u5b8c\u5168\u306b\u628a\u63e1\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u4f55\u3082\u79c1\u3092\u9a5a\u304b\u305b\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u4f55\u30f6\u6708\u3082\u524d\u304b\u3089\u3001\u79c1\u306f\u65b0\u3057\u304f\u8aad\u3080\u306e\u3067\u306f\u306a\u304f\u3001\u518d\u8aad\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u300c\u65b0\u4f5c\u300d\u3001\u300c\u30b7\u30fc\u30ba\u30f3\u300d\u3001\u300c\u6587\u5b66\u5fa9\u5e30\u300d\u3001\u300c\u30d2\u30c3\u30c8\u4f5c\u300d\u3001\u300c\u5931\u6557\u300d\u3068\u540d\u4ed8\u3051\u308b\u53e4\u3073\u305f\u6d41\u308c\u306e\u518d\u73fe\u3002"}
{"translation": "\u305d\u308c\u3089\u306f\u5168\u3066\u540c\u3058\u53e4\u3044\u60c5\u5831\u306e\u53cd\u5fa9\u306b\u904e\u304e\u306a\u3044\u3002"}
{"translation": "\u30ea\u30b5\u30a4\u30af\u30eb\u3055\u308c\u308b\u7d19\u3001\u671d\u51fa\u3066\u5915\u65b9\u306b\u306f\u65e2\u306b\u6642\u4ee3\u9045\u308c\u306e\u65b0\u5546\u54c1\u3067\u3044\u3063\u3071\u3044\u306b\u306a\u3063\u3066\u623b\u3063\u3066\u304f\u308b\u30c8\u30e9\u30c3\u30af\u3002"}
{"translation": "\u4f55\u5e74\u3082\u524d\u304b\u3089\u81ea\u5206\u304c\u5091\u4f5c\u3092\u767a\u898b\u3059\u308b\u3068\u3044\u3046\u8003\u3048\u306b\u559c\u3073\u3067\u8df3\u306d\u6b62\u307e\u306a\u3044\u3053\u3068\u3092\u3084\u3081\u3001\u65b0\u305f\u306a\u7537\u6027\u3068\u3057\u3066\u6708\u66dc\u65e5\u306e\u30aa\u30d5\u30a3\u30b9\u306b\u623b\u308b\u4e8b\u306f\u306a\u304f\u306a\u3063\u305f\u306e\u3060\u308d\u3046\u304b\uff1f 20\u6b73\uff1f \u4e09\u5341\u6b73\uff1f \u79c1\u306f\u3001\u6b7b\u306e\u5302\u3044\u304c\u3059\u308b\u3053\u306e\u7a2e\u306e\u5e33\u7c3f\u3092\u6301\u3064\u3053\u3068\u3092\u597d\u307f\u307e\u305b\u3093\u3002"}
{"translation": "\u79c1\u304c\u76ee\u3092\u9589\u3058\u308b\u3068\u3001\u307e\u3076\u305f\u8d8a\u3057\u306b\u30da\u30eb\u30bc\u30eb\u306e\u30e9\u30f3\u30d7\u304b\u3089\u5747\u4e00\u306b\u5e83\u304c\u308b\u9ec4\u8272\u3044\u5149\u304c\u898b\u3048\u307e\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u6b21\u7b2c\u306b\u305d\u308c\u306f\u9ed2\u3044\u5f62\u72b6\u306b\u98f2\u307f\u8fbc\u307e\u308c\u3001\u6d41\u52d5\u7684\u306a\u907a\u8de1\u3084\u30f4\u30a3\u30af\u30c8\u30fc\u30eb\u30fb\u30e6\u30fc\u30b4\u30fc\u306e\u7d75\u753b\u3092\u63cf\u304d\u51fa\u3057\u307e\u3059\u3002"}
{"translation": "\u79c1\u306e\u606f\u306f\u7de9\u3084\u304b\u306b\u306a\u308a\u3001\u5fc3\u81d3\u306e\u9f13\u52d5\u304c\u5c11\u3057\u9759\u307e\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u7720\u308a\u306b\u843d\u3061\u3066\u3082\u3001\u6b7b\u3093\u3067\u3082\u3088\u304f\u306a\u3063\u305f\u3002"}
{"translation": "\u7e4b\u304c\u308c\u305f\u307e\u307e\u6b7b\u306c\u3002"}
{"translation": "\u300c\u5f7c\u306f\u8aad\u307f\u306a\u304c\u3089\u3001\u672c\u306e\u4e2d\u3067\u751f\u304d\u3001\u672c\u306e\u4e2d\u3067\u6b7b\u3093\u3060\u300d\u3068\u8a00\u308f\u308c\u308b\u3060\u308d\u3046\u3002"}
{"translation": "\u3057\u304b\u3057\u5b9f\u969b\u306b\u306f\u3001\u4f55\u3082\u601d\u308f\u305a\u306b\u6b7b\u3093\u3060\u306e\u3060\u308d\u3046\u3002"}
{"translation": "\u672c\u5f53\u306b\u8aad\u66f8\u3092\u697d\u3057\u3093\u3067\u304b\u3089\u3001\u3082\u3046\u3068\u3066\u3082\u9577\u3044\u6642\u9593\u304c\u7d4c\u3063\u3066\u3057\u307e\u3063\u305f\u3002"}
{"translation": "\u3082\u306f\u3084\u300c\u8aad\u3080\u300d\u3068\u3044\u3046\u3053\u3068\u304c\u3067\u304d\u308b\u306e\u304b\u3055\u3048\u81ea\u5206\u306b\u306f\u308f\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u79c1\u306b\u305d\u308c\u304c\u3067\u304d\u308b\u306e\u3060\u308d\u3046\u304b\uff1f"}
{"translation": "\u3082\u3057\u79c1\u304c\u982d\u3092\u6a2a\u306b\u5411\u3051\u308b\u3068\u3001\u5fc3\u81d3\u306e\u9f13\u52d5\u304c\u3088\u308a\u5f37\u304f\u306a\u308a\u3001\u305d\u308c\u304c\u6728\u6750\u3092\u9707\u308f\u305b\u307e\u3059\u3002"}
{"translation": "\u5bb6\u5168\u4f53\u304c\u53e4\u3044\u7d19\u306e\u3088\u3046\u306a\u9759\u5bc2\u306b\u5305\u307e\u308c\u3066\u3044\u308b\u3002"}
{"translation": "\u96ea\u306e\u3088\u3046\u306b\u3001\u672c\u306f\u97f3\u3092\u98f2\u307f\u8fbc\u3080\u3002"}
{"translation": "\u79c1\u306e\u4ed5\u4e8b\u306b\u306f\u305d\u306e\u9999\u308a\u3068\u606f\u82e6\u3057\u3055\u304c\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u3053\u306e\u9759\u3051\u3055\u306e\u4e2d\u3067\u3001\u79c1\u306f\u305d\u308c\u3092\u3088\u308a\u6df1\u304f\u611f\u3058\u307e\u3059\u3002"}
{"translation": "\u4e16\u754c\u306e\u9a12\u97f3\u306b\u623b\u308b\u3053\u3068\u306f\u3001\u5e38\u306b\u8a66\u7df4\u3067\u3042\u308b\u3002"}
{"translation": "\u8ab0\u304c\u3053\u3093\u306a\u6642\u306b\u53e9\u3044\u3066\u3044\u308b\u306e\u3060\u308d\u3046\uff1f"}
{"translation": "\u79c1\u306f\u3053\u306e\u8efd\u304f\u3001\u5c0f\u3055\u304f\u3001\u63a7\u3048\u3081\u306a\u6253\u6483\u3092\u8a8d\u8b58\u3057\u306a\u3044\u3002"}
{"translation": "\u5c0f\u3055\u306a\u624b\u3002"}
{"translation": "\u5165\u3063\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u5f7c\u5973\u304c\u5165\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u79c1\u306f\u5f7c\u5973\u306b\u4e00\u5ea6\u3082\u4f1a\u3063\u305f\u3053\u3068\u304c\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u3059\u3050\u306b\u79c1\u306e\u4e2d\u306b\u90f7\u6101\u304c\u6e80\u3061\u3001\u5bb6\u304c\u307e\u3060\u5c0f\u3055\u304f\u3066\u3001\u5eca\u4e0b\u3067\u5973\u6027\u305f\u3061\u306e\u3075\u304f\u3089\u306f\u304e\u3092\u898b\u305f\u3060\u3051\u3067\u3082\u8ab0\u305d\u308c\u304b\u308f\u304b\u3063\u305f\u6642\u4ee3\u3092\u61d0\u304b\u3057\u304f\u601d\u3044\u51fa\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3044\u3044\u9854\u3092\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u5f7c\u306e\u9a5a\u304d\u306e\u8996\u7dda\u3092\u898b\u308b\u306b\u3001\u79c1\u306e\u9854\u306f\u5c11\u3057\u56f0\u60d1\u3057\u305f\u8868\u60c5\u306b\u306a\u3063\u3066\u3044\u305f\u306b\u9055\u3044\u306a\u3044\u3002"}
{"translation": "\u304a\u305d\u3089\u304f\u3001\u79c1\u306e\u30b8\u30e3\u30b1\u30c3\u30c8\u306e\u8896\u304b\u3089\u8d64\u3044\u8de1\u304c\u79c1\u306e\u982c\u306b\u3064\u3044\u3066\u3057\u307e\u3063\u305f\u3093\u3060\u3002"}
{"translation": "\u90aa\u9b54\u3067\u3059\u304b\uff1f"}
{"translation": "\u3042\u306a\u305f\u304c\u53bb\u3063\u305f\u5f8c\u3082\u3001\u79c1\u306f\u751f\u304d\u7d9a\u3051\u307e\u3059\u3088\u3001\u304a\u5b22\u3055\u3093\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u8ab0\u3067\u3059\u304b\uff1f \u307b\u3089\u3001\u79c1\u304c\u30a4\u30f3\u30bf\u30fc\u30f3\u306a\u3093\u3060\u3088\uff01 \u3069\u306e\u90e8\u7f72\u3067\u3059\u304b\uff1f \u305d\u306e\u3053\u3068\u3092\u8ab0\u304b\u3089\u3082\u805e\u304b\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"}
{"translation": "\u79c1\u305f\u3061\u3001\u30a4\u30f3\u30bf\u30fc\u30f3\u306e\u7686\u3055\u3093\u306b\u306f\u3001\u591a\u304f\u306e\u4ed5\u4e8b\u3092\u3053\u306a\u3059\u306e\u3067\u3001\u30de\u30eb\u30c1\u30bf\u30b9\u30af\u304c\u5fc5\u8981\u306b\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u6607\u7d66\u3092\u5e0c\u671b\u3067\u3059\u304b\uff1f \u3044\u3048\u3001\u79c1\u306f\u4f55\u3082\u5f97\u3066\u3044\u307e\u305b\u3093\u3002"}
{"translation": "\u5f7c\u5973\u306f\u304b\u306a\u308a\u9aea\u3092\u4e71\u3057\u3066\u3044\u3066\u3001\u30b8\u30fc\u30f3\u30ba\u306b\u306f\u7a74\u304c\u3042\u304d\u3001\u4ed6\u306e\u90e8\u5206\u306f\u30ab\u30e9\u30d5\u30eb\u306b\u67d3\u3081\u3089\u308c\u3066\u3044\u308b\u3088\u3046\u3067\u3059\u306d\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5c0f\u67c4\u3067\u3001\u9ed2\u3044\u77b3\u3092\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u611b\u5b0c\u306f\u3042\u308b\u306e\u3067\u3059\u304c\u3001\u7f8e\u4eba\u304b\u3069\u3046\u304b\u3092\u554f\u308f\u308c\u305f\u3089\u6b63\u76f4\u7b54\u3048\u306b\u56f0\u308a\u307e\u3059\u3002"}
{"translation": "\u3082\u3046\u3001\u305d\u3093\u306a\u5973\u306e\u5b50\u305f\u3061\u3092\u8aad\u307f\u89e3\u304f\u3053\u3068\u306f\u3067\u304d\u306a\u3044\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5143\u6c17\u3067\u3059\u3002"}
{"translation": "\u30ce\u30eb\u30de\u30eb\u30b7\u30e5\u30d7\uff1f \u672c\u696d\u306f\u6bce\u5e74\u30ac\u30b9\u30c8\u30f3\u30fb\u30ae\u30e3\u30ea\u30de\u30fc\u30eb1000\u90e8\u3092\u751f\u7523\u3057\u3001\u5f8c\u3067\u305d\u308c\u3092\u3088\u308a\u3088\u304f\u7c89\u7815\u3059\u308b\u305f\u3081\u306e\u6a5f\u68b0\u3067\u3059\u304b\uff1f"}
{"translation": "\u305d\u308c\u306a\u3089\u3001\u3042\u306a\u305f\u306f\u3053\u3053\u3067\u4f55\u3092\u3057\u3066\u3044\u308b\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u79c1\u3082\u672c\u304c\u5927\u597d\u304d\u3067\u3059\uff01"}
{"translation": "\u305d\u3057\u3066\u3001\u305d\u3053\u306b\u306f\u5e83\u5834\u304c\u3042\u3063\u305f\u3002"}
{"translation": "\u79c1\u305f\u3061\u306f\u4f01\u696d\u3067\u30a4\u30f3\u30bf\u30fc\u30f3\u30b7\u30c3\u30d7\u3092\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u7fa9\u52d9\u7684\u306a\u3002"}
{"translation": "\u3042\u306a\u305f\u304c\u79c1\u306e\u30aa\u30d5\u30a3\u30b9\u3067\u4f55\u3092\u3057\u3066\u3044\u308b\u306e\u304b\u3001\u5931\u793c\u3067\u306f\u306a\u3051\u308c\u3070\u6559\u3048\u3066\u3082\u3089\u3048\u307e\u3059\u304b\uff1f"}
{"translation": "\u305d\u308c\u306f\u30e0\u30cb\u30a8\u6c0f\u3001\u5927\u89aa\u5206\u304c\u79c1\u306b\u8a00\u3063\u305f\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u5927\u7d71\u9818\uff1f\u30e0\u30cb\u30a8\uff1f"}
{"translation": "\u3042\u306a\u305f\u306f\u5f7c\u3092\u77e5\u308a\u307e\u305b\u3093\u304b\uff1f"}
{"translation": "\u3068\u3066\u3082\u3044\u3044\u3002"}
{"translation": "\u3044\u3048\u3001\u305d\u308c\u306f\u6587\u5316\u7684\u4f01\u696d\u306e\u7d4c\u55b6\u3067\u3059\u3002"}
{"translation": "\u672c\u5f53\u306b\uff1f\u305d\u3057\u3066\u3001\u3042\u306a\u305f\u304c\u7de8\u96c6\u3092\u7ba1\u7406\u3057\u305f\u3044\u306e\u3067\u3059\u304b\uff1f \u3042\u306a\u305f\u306b\u5e78\u904b\u3092\u7948\u308a\u307e\u3059\u3002"}
{"translation": "\u30b3\u30f3\u30b5\u30fc\u30c8\u3092\u4f01\u753b\u3059\u308b\u307b\u3046\u304c\u3044\u3044\u3067\u3059\u3002"}
{"translation": "\u5ea7\u3063\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u79c1\u306f\u884c\u304b\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3001\u4eca\u65e5\u306f\u91d1\u66dc\u65e5\u3067\u3059\u3002"}
{"translation": "\u3082\u3046\u9045\u3044\u3067\u3059\u3002"}
{"translation": "\u4e94\u5206\u9593\u3002"}
{"translation": "\u30b3\u30f3\u30b5\u30fc\u30c8\u3092\u958b\u50ac\u3057\u3088\u3046\u3068\u304a\u8003\u3048\u3067\u3059\u304b\uff1f"}
{"translation": "\u306f\u3044\u3001\u305d\u308c\u306f\u7d20\u6674\u3089\u3057\u3044\u3001\u97f3\u697d\u3002"}
{"translation": "\u9577\u3044\u9593\u3001\u79c1\u306f\u3061\u3087\u3063\u3068\u3057\u305f\u30ea\u30e9\u30af\u30bc\u30fc\u30b7\u30e7\u30f3\u3084\u9ad8\u63da\u306e\u305f\u3081\u3001\u305d\u3057\u3066\u8133\u3078\u306e\u8840\u6d41\u3092\u591a\u5c11\u5897\u3084\u3059\u305f\u3081\u306b\u305d\u3053\u306b\u8db3\u3092\u7d44\u3093\u3067\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u3067\u3082\u4eca\u3067\u306f\u3001\u7279\u306b\u591c\u3001\u7279\u306b\u91d1\u66dc\u65e5\u306e\u591c\u306a\u3069\u3001\u982d\u3092\u7f6e\u304f\u3053\u3068\u304c\u307e\u3059\u307e\u3059\u591a\u304f\u306a\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u958b\u3044\u305f\u539f\u7a3f\u306e\u4e0a\u306b\u8155\u3092\u7d44\u307f\u3001\u305d\u306e\u4e0a\u306b\u982d\u3092\u7f6e\u304f\u3002"}
{"translation": "\u524d\u8155\u306b\u984d\u3092\u3064\u3051\u3001\u65b0\u9bae\u306a\u30c6\u30ad\u30b9\u30c8\u306e\u4e0a\u306b\u982c\u3092\u6dfb\u3048\u308b\u3002 \u673a\u306e\u6728\u6750\u304c\u79c1\u306e\u5fc3\u81d3\u306e\u9f13\u52d5\u3092\u5897\u5e45\u3055\u305b\u308b\u3002"}
{"translation": "\u53e4\u3044\u30a2\u30fc\u30eb\u30c7\u30b3\u8abf\u306e\u5bb6\u5177\u306f\u611f\u60c5\u3068\u75b2\u52b4\u3092\u4e0a\u624b\u304f\u4f1d\u3048\u308b\u3002 \u30eb\u30fc\u30eb\u30de\u30f3\uff1f \u30eb\u30eb\uff1f \u5f7c\u306f\u305f\u304f\u3055\u3093\u898b\u3066\u304d\u305f\u3002"}
{"translation": "\u79c1\u306f\u81ea\u5206\u306e\u5fc3\u3001\u91d1\u66dc\u65e5\u306e\u53e4\u3044\u5fc3\u3001\u9759\u304b\u306a\u5bb6\u306e\u4e2d\u3067\u6c88\u9ed9\u3059\u308b\u79c1\u306e\u53e4\u3044\u5fc3\u3092\u805e\u304d\u307e\u3059\u3002"}
{"translation": "\u3053\u306e\u6642\u9593\u306b\u306a\u308b\u3068\u3001\u307f\u3093\u306a\u5e30\u3063\u3066\u3057\u307e\u3046\u3002"}
{"translation": "\u79c11\u4eba\u3060\u3051\u304c\u6b8b\u308a\u3001\u75b2\u308c\u679c\u3066\u3066\u30dc\u30fc\u30c8\u306e\u4e0a\u3067\u3075\u3089\u3075\u3089\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u9031\u672b\u306b\u6301\u3061\u5e30\u3089\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\u624b\u7a3f\u306e\u5c71\u3092\u6574\u7406\u3059\u308b\u52c7\u6c17\u304c\u51fa\u306a\u3044\u304b\u3089\u3060\u3002"}
{"translation": "\u6bce\u9031\u91d1\u66dc\u65e5\u306e\u3088\u3046\u306b\u3002"}
{"translation": "\u305d\u308c\u306a\u3089\u3001\u3042\u306a\u305f\u306f\u77e5\u3063\u3066\u3044\u307e\u3059\u306d\u3002"}
{"translation": "\u305d\u308c\u3092\u3042\u306a\u305f\u306b\u6301\u3063\u3066\u304f\u308b\u3088\u3046\u306b\u6307\u793a\u3057\u305f\u306e\u306f\u5f7c\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u306f\u4f55\u3067\u3059\u304b\uff1f \u3048\u3063\u3068\u3001\u305d\u308c\u306f\u96fb\u5b50\u66f8\u7c4d\u30ea\u30fc\u30c0\u30fc\u3084iPad\u306e\u3088\u3046\u306a\u3082\u306e\u3060\u3088\u3002"}
{"translation": "\u4f55\u8a00\u3063\u3066\u308b\u304b\u308f\u304b\u3089\u306a\u3044\u3051\u3069\u3002"}
{"translation": "\u5f7c\u306f\u9031\u672b\u306b\u3042\u306a\u305f\u306e\u3059\u3079\u3066\u306e\u539f\u7a3f\u3092\u305d\u3053\u306b\u5165\u308c\u3001\u305d\u308c\u304c\u3042\u306a\u305f\u306b\u3068\u3063\u3066\u8ca0\u62c5\u3092\u8efd\u6e1b\u3059\u308b\u3060\u308d\u3046\u3068\u79c1\u306b\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u8aac\u660e\u3057\u307e\u3057\u3087\u3046\u304b\uff1f \u3054\u89a7\u304f\u3060\u3055\u3044\u3001\u305d\u308c\u306f\u3042\u306a\u305f\u306e\u539f\u7a3f\u5168\u3066\u3092\u8868\u793a\u3059\u308b\u30b9\u30af\u30ea\u30fc\u30f3\u306e\u3088\u3046\u3067\u3059\u3002"}
{"translation": "\u5f7c\u3089\u306f\u507d\u7269\u306e\u672c\u7269\u306e\u6728\u88fd\u306e\u30d0\u30fc\u30c1\u30e3\u30eb\u306a\u68da\u306b\u3044\u307e\u3059\u3002"}
{"translation": "\u3042\u306a\u305f\u304c\u305d\u308c\u3089\u306b\u89e6\u308c\u308b\u3068\u3001\u305d\u308c\u3089\u306f\u958b\u304d\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u306f\u4e00\u30d1\u30b1\u30c3\u30c8\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u3042\u306a\u305f\u304c\u305d\u308c\u5168\u3066\u30922\u65e5\u9593\u3067\u8aad\u307f\u7d42\u3048\u308b\u306a\u3093\u3066\u3068\u3093\u3067\u3082\u306a\u3044\uff01 \u3054\u89a7\u304f\u3060\u3055\u3044\u3001\u30c6\u30ad\u30b9\u30c8\u304c\u958b\u304d\u307e\u3059\u3002"}
