{"translation": "\u3059\u3079\u3066\u3092\u5fd8\u308c\u308b\u3053\u3068\u306f\u3001\u9593\u9055\u3044\u306a\u304f\u60aa\u3044\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u3055\u3089\u306b\u60aa\u3044\u3053\u3068\u306f\u3001\u4f55\u3082\u5fd8\u308c\u306a\u3044\u3053\u3068\u3067\u3001\u3069\u3093\u306a\u77e5\u8b58\u3082\u307e\u305a\u5fd8\u308c\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u7523\u307f\u51fa\u3055\u308c\u307e\u3059\u3002"}
{"translation": "\u5168\u3066\u304c\u533a\u5225\u306a\u304f\u4fdd\u5b58\u3055\u308c\u308b\u3068\u3001\u96fb\u529b\u3092\u6d88\u8cbb\u3059\u308b\u30c7\u30fc\u30bf\u30b9\u30c8\u30ec\u30fc\u30b8\u306e\u3088\u3046\u306b\u3001\u305d\u308c\u306f\u305d\u306e\u610f\u5473\u3092\u5931\u3044\u3001\u7121\u79e9\u5e8f\u306a\u6709\u7528\u6027\u306e\u306a\u3044\u60c5\u5831\u306e\u96c6\u307e\u308a\u3068\u306a\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3002"}
{"translation": "\u3059\u3079\u3066\u3092\u4fdd\u6301\u3059\u308b\u8a18\u61b6\u306f\u3001\u57fa\u672c\u7684\u306b\u4f55\u3082\u4fdd\u6301\u3057\u306a\u3044\u3002"}
{"translation": "\u305d\u306e\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u4eba\u5973\u6027\u306f\u3001\u8a18\u61b6\u8853\u3092\u4f7f\u308f\u305a\u306b5\u65e5\u4ee5\u964d\u306e\u6bce\u65e5\u3092\u8a73\u7d30\u306b\u899a\u3048\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u5fd8\u5374\u306e\u82b8\u8853\u3068\u3044\u3046\u3082\u306e\u306f\u4e0d\u53ef\u80fd\u306a\u3053\u3068\u3060\u3001\u306a\u305c\u306a\u3089\u5168\u3066\u306e\u7b26\u53f7\u304c\u5b58\u5728\u3092\u8868\u73fe\u3059\u308b\u304b\u3089\u3067\u3042\u308a\u3001\u305d\u308c\u3089\u304c\u4e0d\u5728\u3092\u793a\u3057\u3066\u3044\u305f\u3068\u3057\u3066\u3082\u3002"}
{"translation": "\u30ed\u30fc\u30de\u5e1d\u56fd\u3067damnatio memoriae\u306e\u7981\u6b62\u3092\u53d7\u3051\u305f\u307b\u3068\u3093\u3069\u3059\u3050\u306b\u3001\u767e\u79d1\u4e8b\u5178\u306f\u540d\u524d\u3092\u77e5\u3063\u3066\u3044\u308b\u3068\u4e3b\u5f35\u3057\u307e\u3059\u3002"}
{"translation": "\u81ea\u6bba\u306f\u3001\u672a\u6765\u306e\u4e0d\u78ba\u5b9f\u6027\u306b\u6253\u3061\u52dd\u3064\u6700\u3082\u904e\u6fc0\u306a\u624b\u6bb5\u3068\u898b\u3048\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u304c\u3001\u305d\u308c\u306f\u7e2e\u5c0f\u3055\u308c\u305f\u5b58\u5728\u306e\u4ee3\u511f\u306b\u904e\u304e\u307e\u305b\u3093\u3002"}
{"translation": "\u30aa\u30fc\u30ac\u30b9\u30bf\u30b9\u304c\u30b5\u30e2\u30b9\u5cf6\u3067\u304b\u3064\u3066\u53d7\u3051\u53d6\u3063\u305f\u30a4\u30f3\u30c9\u306e\u4f7f\u7bc0\u56e3\u306e\u8d08\u308a\u7269\u306b\u306f\u3001\u30c8\u30e9\u3068\u3001\u624b\u304c\u306a\u3044\u82e5\u8005\u304c\u8db3\u3092\u624b\u306e\u3088\u3046\u306b\u4f7f\u3048\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u30d6\u30e9\u30fc\u30d5\u30de\u30f3\u968e\u7d1a\u306e\u30b6\u30eb\u30de\u30ed\u30b9\u3068\u3044\u3046\u7537\u3082\u542b\u307e\u308c\u3066\u3044\u305f\u3068\u5831\u544a\u3055\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u7406\u7531\u306f\u5f7c\u304c\u81ea\u8eab\u306e\u4eba\u751f\u3092\u7d42\u308f\u3089\u305b\u308b\u3064\u3082\u308a\u3060\u3063\u305f\u304b\u3089\u3067\u3001\u305d\u308c\u306f\u5f7c\u304c\u671b\u3093\u3060\u901a\u308a\u306b\u9032\u3093\u3067\u3044\u305f\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u4e88\u671f\u305b\u306c\u4f55\u304b\u304c\u5f7c\u306b\u8d77\u3053\u3089\u306a\u3044\u3088\u3046\u306b\u3001\u30a2\u30c6\u30cd\u3067\u5f7c\u306f\u7b11\u9854\u3067\u3001\u88f8\u3067\u3001\u6ce8\u6cb9\u3055\u308c\u3066\u706b\u306e\u4e2d\u306b\u98db\u3073\u8fbc\u307f\u3001\u7591\u3044\u306a\u304f\u751f\u304d\u305f\u307e\u307e\u82e6\u75db\u3092\u4f34\u3063\u3066\u713c\u6b7b\u3057\u3001\u81ea\u5df1\u6c7a\u5b9a\u7684\u306a\u6b7b\u306e\u6f14\u51fa\u304c\u6b74\u53f2\u306b\u540d\u3092\u523b\u307f\u307e\u3057\u305f\u3002"}
{"translation": "\u3082\u3061\u308d\u3093\u305d\u308c\u306f\u30ad\u30e3\u30b7\u30a6\u30b9\u30fb\u30c7\u30a3\u30aa\u306e\u30ed\u30fc\u30de\u53f2\uff08\u304b\u3064\u306680\u518a\u3042\u3063\u305f\u4e00\u9023\u306e\u66f8\u7269\uff09"}
{"translation": "\u4e2d\u3067\u3082\u5947\u5999\u306a\u9038\u8a71\u3068\u3057\u3066\u3060\u3051\u3067\u3059\u304c\u3001\u5185\u5bb9\u306f\u5076\u7136\u306b\u3082\u6b8b\u3055\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u7d50\u5c40\u3001\u6b8b\u3055\u308c\u305f\u3082\u306e\u306f\u3059\u3079\u3066\u3001\u5358\u7d14\u306b\u6b8b\u3063\u305f\u3082\u306e\u3067\u3059\u3002"}
{"translation": "\u751f\u304d\u3066\u3044\u308b\u3068\u3044\u3046\u3053\u3068\u306f\u3001\u640d\u5931\u3092\u7d4c\u9a13\u3059\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u307e\u3059\u3002"}
{"translation": "\u4f55\u304c\u8d77\u3053\u308b\u306e\u304b\u3068\u3044\u3046\u554f\u3044\u306f\u3001\u6050\u3089\u304f\u4eba\u985e\u81ea\u4f53\u3088\u308a\u3082\u65b0\u3057\u304f\u306a\u3044\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u305d\u306e\u7406\u7531\u306f\u3001\u672a\u6765\u304c\u4e88\u6e2c\u4e0d\u53ef\u80fd\u6027\u3092\u6301\u3064\u3068\u540c\u6642\u306b\u3001\u305d\u308c\u304c\u6b7b\u306e\u6642\u671f\u3084\u72b6\u6cc1\u3092\u6697\u95c7\u306e\u4e2d\u306b\u7f6e\u304d\u53bb\u308a\u306b\u3059\u308b\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u3053\u308c\u306f\u3068\u3066\u3082\u907f\u3051\u3089\u308c\u306a\u3044\u3060\u3051\u3067\u306a\u304f\u4e0d\u5b89\u3092\u611f\u3058\u308b\u7279\u6027\u3067\u3059\u3002"}
{"translation": "\u8ab0\u3067\u3082\u3001\u5fae\u5999\u306b\u82e6\u3057\u307f\u306a\u304c\u3089\u5148\u884c\u304d\u306e\u4e8b\u3092\u4e88\u611f\u3059\u308b\u3068\u3044\u3046\u9632\u5fa1\u9b54\u6cd5\u3001\u305d\u3057\u3066\u6050\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u5148\u53d6\u308a\u3057\u3066\u982d\u3067\u601d\u3044\u63cf\u304f\u3053\u3068\u3067\u305d\u308c\u3092\u907f\u3051\u3088\u3046\u3068\u3059\u308b\u904b\u547d\u7684\u306a\u885d\u52d5\u3092\u77e5\u3063\u3066\u3044\u307e\u3059\u304b\uff1f \u4eba\u3005\u306f\u60b2\u60e8\u3055\u3092\u4e88\u611f\u3057\u3001\u60f3\u50cf\u3057\u305f\u707d\u5bb3\u3092\u901a\u3058\u3066\u601d\u3046\u3001\u3068\u3044\u3046\u3053\u3068\u3067\u90aa\u60aa\u306a\u9a5a\u304d\u304b\u3089\u8b77\u3089\u308c\u3066\u3044\u308b\u3088\u3046\u306b\u932f\u899a\u3057\u307e\u3059\u3002"}
{"translation": "\u53e4\u4ee3\u3067\u306f\u5922\u306f\u6170\u3081\u3092\u7d04\u675f\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u30ae\u30ea\u30b7\u30e3\u4eba\u305f\u3061\u306f\u5f7c\u3089\u304b\u3089\u305d\u308c\u3092\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u306a\u305c\u306a\u3089\u3001\u5f7c\u3089\u306f\u795e\u8a17\u306e\u3088\u3046\u306b\u5c06\u6765\u3092\u4e88\u544a\u3057\u3001\u3057\u305f\u304c\u3063\u3066\u672a\u6765\u304b\u3089\u305d\u306e\u4e0d\u53ef\u907f\u6027\u306f\u53d6\u308a\u53bb\u308c\u306a\u3044\u3051\u308c\u3069\u3082\u4e88\u60f3\u5916\u306e\u6050\u6016\u3092\u596a\u3044\u307e\u3059\u3002"}
{"translation": "\u6b7b\u3078\u306e\u6050\u6016\u304b\u3089\u3001\u81ea\u3089\u547d\u3092\u7d76\u3064\u4eba\u3082\u5c11\u306a\u304f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u904e\u53bb\u3092\u4fdd\u6301\u3057\u3001\u5fd8\u5374\u3092\u963b\u6b62\u3059\u308b\u6226\u7565\u306f\u591a\u5c90\u306b\u308f\u305f\u308a\u307e\u3059\u3002 \u4f1d\u627f\u3092\u4fe1\u3058\u308b\u306a\u3089\u3001\u79c1\u305f\u3061\u306e\u6b74\u53f2\u8a18\u8ff0\u306e\u6700\u521d\u306b\u306f\u30da\u30eb\u30b7\u30e3\u3068\u30ae\u30ea\u30b7\u30e3\u306e\u9593\u306b\u7e70\u308a\u5e83\u3052\u3089\u308c\u305f\u4e00\u9023\u306e\u58ee\u7d76\u306a\u6226\u4e89\u304c\u7acb\u3061\u306f\u3060\u304b\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u3001\u4eca\u65e5\u3067\u306f\u307b\u3068\u3093\u3069\u5fd8\u308c\u3089\u308c\u3064\u3064\u3042\u308b\u8a18\u61b6\u8853\u306e\u8d77\u6e90\u306f\u3001\u591a\u304f\u306e\u6b7b\u8005\u3092\u51fa\u3057\u305f\u60b2\u5287\u304b\u3089\u59cb\u307e\u308a\u307e\u3059\uff1a \u305d\u308c\u306f\u7d00\u5143\u524d5\u4e16\u7d00\u306e\u521d\u982d\u3001\u30c6\u30c3\u30b5\u30ea\u30a2\u3067\u3057\u305f\u3002 \u6570\u4e16\u7d00\u524d\u3001\u5012\u58ca\u3057\u305f\u5bb6\u304c\u795d\u5bb4\u306e\u5168\u53c2\u52a0\u8005\u3092\u4e0b\u6577\u304d\u306b\u3057\u3001\u552f\u4e00\u306e\u751f\u5b58\u8005\u3067\u3042\u3063\u305f\u30b1\u30aa\u30b9\u5cf6\u306e\u8a69\u4eba\u30b7\u30e2\u30cb\u30c7\u30b9\u306f\u3001\u5f7c\u306e\u8a13\u7df4\u3055\u308c\u305f\u8a18\u61b6\u529b\u306b\u3088\u3063\u3066\u5fc3\u306e\u4e2d\u3067\u7834\u58ca\u3055\u308c\u305f\u5efa\u7269\u306b\u518d\u3073\u5165\u308a\u3001\u5ba2\u305f\u3061\u306e\u7740\u5e2d\u9806\u3092\u56de\u60f3\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u7d50\u679c\u3001\u907a\u4f53\u306f\u6b8b\u9ab8\u304b\u3089\u7279\u5b9a\u3059\u308b\u3053\u3068\u304c\u53ef\u80fd\u3068\u306a\u308a\u307e\u3057\u305f\u3002 \u6b7b\u3068\u751f\u306e\u4e8c\u8005\u629e\u4e00\u306b\u5185\u5728\u3059\u308b\u6570\u591a\u304f\u306e\u30d1\u30e9\u30c9\u30c3\u30af\u30b9\u306e\u4e2d\u306b\u3001\u6545\u4eba\u304c\u53d6\u308a\u623b\u3059\u3053\u3068\u306e\u3067\u304d\u306a\u3044\u5931\u308f\u308c\u305f\u3082\u306e\u3068\u8a8d\u8b58\u3055\u308c\u308b\u3053\u3068\u3067\u3001\u305d\u306e\u55aa\u5931\u306b\u5bfe\u3059\u308b\u60b2\u3057\u307f\u304c\u540c\u6642\u306b\u500d\u5897\u3057\u534a\u6e1b\u3059\u308b\u3082\u306e\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u306b\u5bfe\u3057\u3066\u4e0d\u660e\u307e\u305f\u306f\u884c\u65b9\u4e0d\u660e\u8005\u306e\u904b\u547d\u306f\u66d6\u6627\u306a\u307e\u307e\u6b8b\u308a\u3001\u89aa\u65cf\u3092\u4e0d\u5b89\u306a\u5e0c\u671b\u3068\u963b\u5bb3\u3055\u308c\u305f\u60b2\u3057\u307f\u304b\u3089\u6210\u308b\u307c\u3093\u3084\u308a\u3057\u305f\u60aa\u5922\u306b\u9589\u3058\u8fbc\u3081\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u306f\u56de\u5fa9\u4f5c\u696d\u3060\u3051\u3067\u306a\u304f\u751f\u304d\u7d9a\u3051\u308b\u3053\u3068\u3055\u3048\u59a8\u3052\u307e\u3059\u3002"}
{"translation": "\u6b7b\u306e\u4e2d\u65ad\u306f\u3001\u907a\u7523\u3068\u8a18\u61b6\u306e\u51fa\u767a\u70b9\u3067\u3042\u308a\u3001\u6b7b\u8005\u3078\u306e\u5606\u304d\u304c\u3042\u3089\u3086\u308b\u6587\u5316\u306e\u6e90\u3067\u3059\u3002"}
{"translation": "\u305d\u3053\u3067\u306f\u6b4c\u3084\u7948\u308a\u3084\u7269\u8a9e\u306b\u3088\u3063\u3066\u3001\u7a81\u7136\u958b\u3044\u305f\u865a\u7121\u3068\u9759\u3051\u3055\u3092\u57cb\u3081\u5408\u308f\u305b\u307e\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u305d\u306e\u4e2d\u3067\u4e0d\u5728\u5150\u304c\u518d\u5ea6\u751f\u304d\u8fd4\u3057\u307e\u3059\u3002 \u5931\u3046\u7d4c\u9a13\u306f\u3001\u907a\u61be\u306e\u5ff5\u3092\u899a\u3048\u308b\u5bfe\u8c61\u306e\u8f2a\u90ed\u3092\u6d6e\u304b\u3073\u4e0a\u304c\u3089\u305b\u308b\u7a7a\u6d1e\u306e\u578b\u3068\u306a\u308a\u3001\u305f\u307e\u306b\u306f\u305d\u308c\u304c\u60b2\u3057\u307f\u306e\u5149\u666f\u3067\u55aa\u5931\u3057\u305f\u3082\u306e\u3092\u6b32\u671b\u3059\u308b\u5bfe\u8c61\u3078\u3068\u5909\u308f\u308a\u307e\u3059\u3002"}
{"translation": "\u3042\u308b\u3044\u306f\u65b0\u3057\u3044\u30d6\u30ec\u30e0\u30e9\u30a4\u30d6\u30e9\u30ea\u30fc\u518a\u5b50\u5ec3\u54c1\u7de8\u96c6\u8005\u3067\u3082\u3042\u308b\u30cf\u30a4\u30c7\u30eb\u30d9\u30eb\u30af\u5927\u5b66\u52d5\u7269\u5b66\u6559\u6388\u81ea\u8eab\u304c\u8ff0\u3079\u3066\u3044\u307e\u3059: \u300c\u897f\u6d0b\u4eba\u306b\u3068\u3063\u3066\u7406\u89e3\u3057\u96e3\u3044\u6027\u8cea\u306e\u4e00\u3064\u306f\u3001\u5f7c\u304c\u5b58\u5728\u3059\u308b\u3082\u306e\u3088\u308a\u3082\u306a\u304f\u3057\u305f\u3082\u306e\u3092\u9ad8\u304f\u8a55\u4fa1\u3057\u3066\u3044\u308b\u70b9\u3067\u3059\u3002"}
{"translation": "\u305d\u3046\u3067\u306a\u3051\u308c\u3070\u3001\u888b\u982d\u72fc\u304b\u3089\u6765\u308b\u4e0d\u601d\u8b70\u306a\u9b45\u529b\u3092\u8aac\u660e\u3059\u308b\u4ed6\u3042\u308a\u307e\u305b\u3093\u3002\u300d"}
{"translation": "\u6b7b\u3068\u305d\u308c\u306b\u4f34\u3046\u554f\u984c\u3001\u3064\u307e\u308a\u4eba\u304c\u7a81\u5982\u3068\u3057\u3066\u4e0d\u5728\u306b\u306a\u308b\u4e00\u65b9\u3067\u305d\u306e\u907a\u7269\u3001\u907a\u4f53\u304b\u3089\u6301\u3061\u4e3b\u306e\u3044\u306a\u3044\u8ca1\u7523\u307e\u3067\u3069\u3046\u53d6\u308a\u6271\u3046\u3079\u304d\u304b\u3068\u3044\u3046\u554f\u984c\u306f\u3001\u6642\u306e\u7d4c\u904e\u3068\u5171\u306b\u7b54\u3048\u3092\u6c42\u3081\u3089\u308c\u3001\u884c\u52d5\u3092\u4fc3\u3057\u305f\u3053\u3068\u306f\u660e\u767d\u3067\u3059\u3002"}
{"translation": "\u305d\u306e\u610f\u5473\u5408\u3044\u306f\u5358\u306a\u308b\u76ee\u7684\u3092\u8d85\u3048\u3066\u304a\u308a\u3001\u6211\u3005\u306e\u65e9\u671f\u306e\u5148\u7956\u305f\u3061\u3092\u52d5\u7269\u7684\u5b58\u5728\u304b\u3089\u4eba\u9593\u7684\u5b58\u5728\u3078\u8eab\u3092\u5f15\u304d\u4e0a\u3052\u3055\u305b\u307e\u3057\u305f\u3002"}
{"translation": "\u540c\u3058\u7a2e\u65cf\u306e\u907a\u4f53\u3092\u81ea\u7136\u306e\u5206\u89e3\u30d7\u30ed\u30bb\u30b9\u306b\u4efb\u305b\u304d\u308a\u306b\u305b\u305a\u3001\u53d6\u308a\u6271\u3046\u3053\u3068\u306f\u4e00\u822c\u7684\u306b\u4eba\u9593\u306e\u7279\u5fb4\u3068\u3055\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u4ed6\u306e\u9ad8\u7b49\u52d5\u7269\u3067\u3082\u540c\u69d8\u306e\u884c\u52d5\u304c\u89b3\u5bdf\u3055\u308c\u307e\u3059\u3002"}
{"translation": "\u305f\u3068\u3048\u3070\u3001\u8c61\u306f\u6b7b\u306b\u3086\u304f\u7fa4\u308c\u306e\u4ef2\u9593\u306e\u5468\u308a\u306b\u96c6\u307e\u308a\u3001\u4f55\u6642\u9593\u3082\u9f3b\u3067\u89e6\u308c\u306a\u304c\u3089\u6fc0\u3057\u304f\u9cf4\u304d\u3001\u751f\u6c17\u306e\u306a\u3044\u4f53\u3092\u518d\u3073\u7acb\u3066\u3088\u3046\u3068\u3057\u3070\u3057\u3070\u8a66\u307f\u307e\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u6700\u7d42\u7684\u306b\u306f\u6b7b\u4f53\u3092\u571f\u3084\u679d\u3067\u8986\u3044\u307e\u3059\u3002"}
{"translation": "\u307e\u305f\u3001\u5f7c\u3089\u306f\u305d\u306e\u6b7b\u306b\u5834\u6240\u3092\u6570\u5e74\u5f8c\u3082\u5b9a\u671f\u7684\u306b\u8a2a\u308c\u308b\u3053\u3068\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u305d\u308c\u306b\u306f\u7591\u3044\u306a\u304f\u826f\u597d\u306a\u8a18\u61b6\u529b\u304c\u5fc5\u8981\u3067\u3042\u308a\u3001\u6050\u3089\u304f\u306f\u6211\u3005\u304c\u7406\u89e3\u3059\u308b\u3053\u3068\u306e\u3067\u304d\u306a\u3044\u5e7d\u970a\u3084\u6b7b\u5f8c\u306e\u4e16\u754c\u306e\u60f3\u50cf\u529b\u304c\u5fc5\u8981\u3067\u3042\u308d\u3046\u3002"}
{"translation": "\u6211\u3005\u81ea\u8eab\u306e\u60f3\u50cf\u529b\u3068\u540c\u3058\u304f\u3089\u3044\u58ee\u5927\u3067\u78ba\u8a8d\u4e0d\u53ef\u80fd\u3060\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u3053\u306e\u672c\u306e\u5236\u4f5c\u3092\u307b\u3068\u3093\u3069\u7d42\u3048\u3066\u3044\u308b\u4eca\u3001\u5206\u89e3\u3084\u7834\u58ca\u306e\u591a\u69d8\u306a\u73fe\u8c61\u304c\u91cd\u8981\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u3066\u3044\u308b\u3053\u3068\u306b\u6c17\u3065\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u3053\u308c\u306f\u6b7b\u306b\u5bfe\u51e6\u3059\u308b\u7121\u6570\u306e\u65b9\u6cd5\u306e1\u3064\u3067\u3042\u308a\u3001\u57fa\u672c\u7684\u306b\u306f\u30d8\u30ed\u30c9\u30c8\u30b9\u304c\u8a3c\u8a00\u3057\u305f\u30ab\u30e9\u30c1\u30e3\u30a4\u4eba\u306e\u7fd2\u6163\u3068\u540c\u3058\u304f\u3089\u3044\u4e0d\u5668\u7528\u3067\u3082\u9762\u5012\u898b\u597d\u304d\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u5f7c\u3089\u306f\u4ea1\u304f\u306a\u3063\u305f\u89aa\u3092\u98df\u3079\u308b\u3053\u3068\u306b\u6163\u308c\u3066\u304a\u308a\u3001\u30ae\u30ea\u30b7\u30e3\u4eba\u304c\u89aa\u3092\u713c\u304f\u3068\u3044\u3046\u4f1d\u7d71\u3092\u805e\u3044\u3066\u6050\u308d\u3057\u304f\u601d\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u306a\u305c\u306a\u3089\u3001\u81ea\u8eab\u306e\u6b7b\u3092\u5e38\u306b\u601d\u3044\u8d77\u3053\u3059\u8005\u304c\u751f\u547d\u306b\u3088\u308a\u8fd1\u3044\u306e\u304b\u3001\u305d\u308c\u3068\u3082\u6b7b\u3092\u8ffd\u3044\u6255\u3046\u3053\u3068\u306b\u6210\u529f\u3059\u308b\u8005\u304c\u305d\u3046\u3067\u3042\u308b\u306e\u304b\u3001\u305d\u306e\u4e0a\u3067\u610f\u898b\u306f\u5927\u304d\u304f\u5206\u304b\u308c\u307e\u3059\u3002"}
{"translation": "\u5168\u3066\u304c\u7d42\u308f\u308b\u3068\u3044\u3046\u60f3\u50cf\u304c\u6050\u308d\u3057\u3044\u306e\u304b\u3001\u305d\u308c\u3068\u3082\u7d42\u308f\u308a\u304c\u306a\u3044\u53ef\u80fd\u6027\u304c\u6050\u308d\u3057\u3044\u306e\u304b\u3068\u3044\u3046\u554f\u984c\u3082\u540c\u69d8\u3067\u3059\u3002"}
{"translation": "\u3082\u3061\u308d\u3093\u3001\u79c1\u306f\u305d\u308c\u4ee5\u524d\u306b\u3082\u4ed6\u306e\u6ce8\u76ee\u3059\u3079\u304d\u5893\u5730\u3092\u8a2a\u308c\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u4f8b\u3048\u3070\u3001\u9ad8\u304f\u8d64\u30ec\u30f3\u30ac\u306e\u58c1\u3067\u56f2\u307e\u308c\u305f\u30f4\u30a7\u30cd\u30c1\u30a2\u306e\u30e9\u30b0\u30fc\u30f3\u304b\u3089\u9752\u7dd1\u8272\u306e\u6c34\u9762\u3092\u7a81\u304d\u7834\u3063\u3066\u305d\u3073\u3048\u7acb\u3064\u6b7b\u8005\u306e\u5cf6\u30b5\u30f3\u30fb\u30df\u30b1\u30fc\u30ec\u3001\u307e\u305f\u306f\u6bce\u5e74\u30e1\u30ad\u30b7\u30b3\u4eba\u304c\u795d\u3046\u300c\u6b7b\u8005\u306e\u65e5\u300d\u306b\u304a\u3051\u308b\u6d3e\u624b\u306a\u5e02\u5834\u9a12\u304e\u3067\u77e5\u3089\u308c\u308b\u30cf\u30ea\u30a6\u30c3\u30c9\u30fb\u30d5\u30a9\u30fc\u30a8\u30d0\u30fc\u5893\u5730\u3002"}
{"translation": "\u305d\u3053\u3067\u306f\u30aa\u30ec\u30f3\u30b8\u9ec4\u8272\u3067\u98fe\u3089\u308c\u305f\u5893\u3084\u9032\u884c\u3059\u308b\u8150\u4e71\u304c\u6c38\u9060\u306b\u7b11\u9854\u3092\u547c\u3073\u899a\u307e\u3059\u30ab\u30e9\u30d5\u30eb\u306b\u67d3\u3081\u3089\u308c\u305f\u7802\u7cd6\u88fd\u3068\u30d1\u30d4\u30a8\u30de\u30b7\u30a7\u88fd\u306e\u6b7b\u8005\u306e\u982d\u84cb\u9aa8\u304c\u898b\u3089\u308c\u307e\u3059\u3002"}
{"translation": "\u6570\u5e74\u524d\u306e\u3042\u308b8\u6708\u306e\u65e5\u306b\u3001\u79c1\u306f\u5317\u90e8\u306e\u90fd\u5e02\u3092\u8a2a\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u6d77\u306e\u6e7e\u66f2\u90e8\u306b\u4f4d\u7f6e\u3057\u3066\u304a\u308a\u3001\u305d\u306e\u6e7e\u66f2\u90e8\u306f\u524d\u3005\u304b\u3089\u306e\u6c37\u6cb3\u6642\u4ee3\u4ee5\u964d\u91ce\u56fd\u5883\u3092\u8d85\u3048\u3066\u5e83\u304c\u3063\u3066\u304a\u308a\u3001\u305d\u306e\u6c7d\u6c34\u3067\u6625\u306b\u306f\u30cb\u30b7\u30f3\u3001\u590f\u306b\u306f\u30a6\u30ca\u30ae\u3001\u79cb\u306b\u306f\u30c0\u30e9\u9b5a\u3001\u51ac\u306b\u306f\u30b3\u30a4\u3084\u30d1\u30a4\u30af\u3084\u30d6\u30ea\u30fc\u30e0\u304c\u898b\u3064\u3051\u3089\u308c\u308b\u305f\u3081\u3001\u305d\u3053\u3067\u306f\u73fe\u5728\u3067\u3082\u6f01\u5e2b\u306e\u8077\u696d\u304c\u55b6\u307e\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u3089\u306e\u7537\u6027\u305f\u3061\u306f\u3001\u5bb6\u65cf\u3068\u5171\u306b\u6570\u4e16\u7d00\u306b\u308f\u305f\u308a\u3001\u98a8\u5149\u660e\u5a9a\u306a\u5730\u533a\u3092\u5c45\u4f4f\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u5730\u533a\u306f\u77f3\u7573\u306e\u9053\u8def\u304c\u307b\u3093\u306e2\u672c\u3001\u6f01\u7db2\u3092\u5e72\u3059\u5834\u6240\u3001\u305d\u3057\u3066\u3082\u30462\u4eba\u306e\u8001\u9f62\u306a\u8cb4\u65cf\u306e\u5973\u6027\u3060\u3051\u304c\u4f4f\u3093\u3067\u3044\u308b\u4fee\u9053\u9662\u304b\u3089\u6210\u308b\u307b\u304b\u306a\u3044\u3067\u3059\u3002"}
{"translation": "\u8981\u3059\u308b\u306b\u3001\u305d\u308c\u306f\u6642\u9593\u304b\u3089\u53d6\u308a\u843d\u3068\u3055\u308c\u305f\u3088\u3046\u306b\u898b\u3048\u308b\u5834\u6240\u306e\u4e00\u3064\u3067\u3001\u305d\u3053\u3067\u306f\u3042\u3044\u307e\u3044\u3067\u3042\u308a\u306a\u304c\u3089\u3082\u9b45\u529b\u7684\u306a\u904e\u53bb\u3092\u751f\u304d\u3066\u3044\u308b\u3082\u306e\u3068\u3057\u3066\u4fdd\u3064\u8a98\u60d1\u306b\u3059\u3050\u306b\u8eab\u3092\u4efb\u305b\u3066\u3057\u307e\u3044\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u79c1\u304c\u7279\u306b\u8a18\u61b6\u306b\u6b8b\u3057\u3066\u3044\u308b\u306e\u306f\u3001\u3072\u3057\u3083\u3052\u305f\u830e\u304b\u3089\u82b1\u54b2\u304f\u30d0\u30e9\u306e\u6728\u3084\u9ad8\u3044\u30de\u30eb\u30d0\u306e\u82b1\u3001\u4f4e\u304f\u767d\u5316\u7ca7\u3092\u65bd\u3055\u308c\u305f\u5bb6\u3005\u306e\u524d\u306b\u3042\u308b\u3082\u306e\u3084\u3001\u8272\u3068\u308a\u3069\u308a\u306b\u63cf\u304b\u308c\u305f\u6728\u88fd\u306e\u6249\u3001\u5efa\u7269\u9593\u3092\u901a\u3063\u3066\u76f4\u63a5\u77f3\u304c\u3061\u306a\u6d77\u5cb8\u7dda\u3078\u3068\u3064\u306a\u304c\u3063\u3066\u3044\u308b\u7d30\u9053\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u305d\u308c\u3088\u308a\u3082\u9a5a\u3044\u305f\u3053\u3068\u306f\u3001\u96c6\u843d\u306e\u4e2d\u592e\u3067\u5e02\u5834\u5834\u6240\u3067\u306f\u306a\u304f\u5893\u5730\u3092\u898b\u3064\u3051\u305f\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u65b0\u7dd1\u306e\u30e4\u30de\u30dc\u30a6\u30b7\u3067\u5f71\u3092\u4f5c\u308a\u51fa\u3057\u3001\u92f3\u9244\u5840\u3067\u56f2\u307e\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3064\u307e\u308a\u901a\u5e38\u5546\u54c1\u4ea4\u63db\u304c\u884c\u308f\u308c\u308b\u5834\u6240\u3060\u3051\u3067\u306a\u304f\u3001\u300c\u5b89\u3089\u304b\u306b\u7720\u3063\u3066\u300d\u304f\u3060\u3055\u3044\u3068\u3044\u3046\u9858\u671b\u304b\u3089\u751f\u3058\u308b\u4fe1\u4ef0\u306f\u7d76\u3048\u96e3\u3044\u5b58\u5728\u3060\u3068\u6559\u308f\u3063\u305f\u571f\u5730\u4e0b\u3067\u6b7b\u8005\u9054\u306f\u898b\u5b88\u3089\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u521d\u3081\u3066\u4e0d\u5b89\u3060\u3068\u601d\u3063\u305f\u9a5a\u304d\u306f\u5927\u304d\u304f\u3001\u307e\u305f\u5897\u3057\u305f\u3002"}
{"translation": "\u79c1\u304c\u65e9\u304f\u4ea1\u304f\u306a\u3063\u305f\u606f\u5b50\u306e\u5893\u3092\u81ea\u5206\u306e\u30ad\u30c3\u30c1\u30f3\u304b\u3089\u898b\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u5973\u6027\u306e\u5bb6\u306b\u6ce8\u610f\u3092\u5411\u3051\u3089\u308c\u305f\u6642\u3001\u4f55\u4e16\u7d00\u306b\u3082\u308f\u305f\u308b\u4f1d\u7d71\u304c\u846c\u5100\u5100\u5f0f\u3092\u62c5\u5f53\u3059\u308b\u3053\u3053\u306b\u3044\u308b\u6b7b\u8005\u30ae\u30eb\u30c9\u3092\u907a\u3057\u3001\u3059\u3067\u306b\u4ea1\u304f\u306a\u308a\u307e\u3060\u751f\u5b58\u3057\u3066\u3044\u308b\u540c\u3058\u5bb6\u65cf\u306e\u9593\u8fd1\u3067\u4fdd\u5b58\u3059\u308b\u3088\u3046\u5c0e\u3044\u3066\u3044\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u4eca\u307e\u3067\u79c1\u304c\u592a\u5e73\u6d0b\u306e\u3042\u308b\u5cf6\u3005\u306e\u4f4f\u6c11\u304b\u3089\u77e5\u3063\u3066\u3044\u305f\u3060\u3051\u3060\u3063\u305f\u3002"}
