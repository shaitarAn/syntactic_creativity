{"translation": "\u300c\u3046\u305d\u3064\u304d\u3060\u300d\u3068\u79c1\u306f\u601d\u3063\u305f\u3002"}
{"translation": "\u30ad\u30fc\u30c1\u30a7\u30fc\u30f3\u3068\u5c0f\u6307\u306e\u6307\u8f2a\u306f\u3001\u4f55\u3068\u304b\u98df\u3079\u3066\u3044\u304f\u305f\u3081\u306e\u624b\u7d19\u3092\u66f8\u3044\u3066\u3044\u308b\u5f7c\u306e\u59ff\u306b\u3061\u3050\u306f\u3050\u3067\u3057\u305f\u3002"}
{"translation": "\u307e\u305f\u3001\u30ab\u30e0\u30b7\u30a7\u30d5\u306e\u9854\u306b\u306f\u3001\u3046\u3063\u3059\u3089\u3068\u611f\u3058\u53d6\u308c\u308b\u5f71\u304c\u4e00\u77ac\u8d70\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u7d4c\u9a13\u8c4a\u5bcc\u306a\u76ee\u3092\u6301\u3064\u8005\u3057\u304b\u6349\u3048\u3089\u308c\u306a\u3044\u7a2e\u985e\u306e\u3082\u306e\u3067\u3001\u3053\u308c\u306f\u901a\u5e38\u5618\u3092\u3064\u304f\u3053\u3068\u304c\u5c11\u306a\u3044\u4eba\u3005\u3060\u3051\u304c\u898b\u305b\u308b\u8868\u60c5\u3067\u3059\u3002"}
{"translation": "\u300c\u3042\u306a\u305f\u306e\u7269\u8a9e\u306e\u7b4b\u66f8\u304d\u306f\u4f55\u3067\u3059\u304b\uff1f\u300d\u3068\u79c1\u306f\u5c0b\u306d\u307e\u3057\u305f\u3002"}
{"translation": "\u7b4b\u66f8\u304d\u3002"}
{"translation": "\u3069\u3046\u8a00\u3063\u3066\u4f1d\u3048\u305f\u3089\u3044\u3044\u3067\u3057\u3087\u3046\u304b\uff1f"}
{"translation": "\u30b9\u30c8\u30fc\u30ea\u30fc\u306f\u65b0\u3057\u304f\u306a\u3044\u3002"}
{"translation": "\u611b\u3001\u6bba\u4eba\u3002"}
{"translation": "\u300c\u305d\u308c\u3092\u8aad\u3081\u3070\u308f\u304b\u308a\u307e\u3059\u3088\u3002\u300d"}
{"translation": "\u300c\u6cd5\u5ef7\u635c\u67fb\u5b98\u306e\u624b\u8a18\u300d"}
{"translation": "\u30ab\u30df\u30fc\u30b7\u30a7\u30d5\u306f\u79c1\u306b\u512a\u3057\u3044\u76ee\u3092\u5411\u3051\u3066\u3001\u9759\u304b\u306b\u7b11\u3063\u305f\u3002"}
{"translation": "\u3046\u3093\u3056\u308a\u3059\u308b\u3088\u3046\u306a\u4ed5\u4e8b\u3002"}
{"translation": "\u3057\u3063\u304b\u308a\u3068\u52e4\u3081\u3066\u3044\u305f\u304c\u3001\u6700\u7d42\u7684\u306b\u306f\u624b\u3092\u632f\u3063\u3066\u8f9e\u3081\u3066\u3057\u307e\u3063\u305f\u3002"}
{"translation": "\u4eca\u306f\u4f55\u3082\u3057\u3066\u3044\u306a\u304f\u3066\u3001\u307b\u3068\u3093\u3069\u98df\u3079\u7269\u3082\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u305d\u3057\u3066\u3001\u3082\u3057\u3082\u79c1\u306e\u5c0f\u8aac\u3092\u3001\u305d\u306e\u4fa1\u5024\u3092\u7121\u8996\u3057\u3066\u51fa\u7248\u3057\u3066\u304f\u308c\u308c\u3070\u3001\u305d\u308c\u306f\u305f\u3060\u306e\u597d\u610f\u4ee5\u4e0a\u306e\u3082\u306e\u306b\u306a\u308b\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u79c1\u3092\u52a9\u3051\u3066\u304f\u3060\u3055\u308b\u3002"}
{"translation": "\u65b0\u805e\u306f\u6148\u5584\u65bd\u8a2d\u3067\u3082\u3001\u4fdd\u8b77\u65bd\u8a2d\u3067\u3082\u306a\u3044\u3002"}
{"translation": "\u305d\u308c\u306f\u77e5\u3063\u3066\u3044\u308b\u3001\u3067\u3082\u3002"}
{"translation": "\u3069\u3046\u304b\u3054\u89aa\u5207\u306b\u3002"}
{"translation": "\u3068\u3066\u3082\u5b09\u3057\u3044\u3067\u3059\u3002"}
{"translation": "\u4f55\u3067\u304a\u624b\u4f1d\u3044\u3067\u304d\u307e\u3059\u304b\uff1f \u59cb\u3081\u308b\u6751\u306b\u5165\u308a\u305f\u3044\u3068\u3044\u3046\u4eba\u306f\u5f7c\u306e\u61c7\u9858\u3059\u308b\u76ee\u3067\u5e8a\u3092\u898b\u3064\u3081\u306a\u304c\u3089\u3001\u8a00\u8449\u3092\u3064\u3065\u3051\u305f\uff1a \u3042\u306a\u305f\u306e\u65b0\u805e\u306b\u63b2\u8f09\u3057\u305f\u3044\u3068\u601d\u3063\u3066\u3001\u5c0f\u3055\u306a\u7269\u8a9e\u3092\u6301\u3063\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u7de8\u96c6\u8005\u306e\u7686\u3055\u3093\u3001\u79c1\u304c\u6b63\u76f4\u306b\u8a00\u308f\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3059\u304c\u3001\u79c1\u304c\u81ea\u5206\u306e\u7269\u8a9e\u3092\u66f8\u3044\u305f\u306e\u306f\u4f5c\u5bb6\u3068\u3057\u3066\u306e\u540d\u8a89\u3084\u7518\u7f8e\u306a\u8a9e\u53e5\u3092\u6c42\u3081\u3066\u306e\u3053\u3068\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u300d"}
{"translation": "\u305d\u306e\u3088\u3046\u306a\u3059\u3070\u3089\u3057\u3044\u7269\u4e8b\u306b\u3064\u3044\u3066\u306f\u3001\u79c1\u306f\u3082\u3046\u5e74\u3092\u3068\u308a\u3059\u304e\u305f\u3002"}
{"translation": "\u3060\u304b\u3089\u3001\u7d14\u7c8b\u306b\u5546\u696d\u7684\u306a\u52d5\u6a5f\u304b\u3089\u3001\u8457\u8ff0\u306e\u9053\u306b\u8db3\u3092\u8e0f\u307f\u5165\u308c\u308b\u306e\u3060\u3002"}
{"translation": "\u7a3c\u304e\u305f\u3044\u3093\u3060\u3002"}
{"translation": "\u300c\u4eca\u306f\u3082\u3046\u3001\u4e00\u5207\u3084\u308b\u3053\u3068\u304c\u306a\u3044\u3002\u300d"}
{"translation": "\u3042\u306a\u305f\u306f\u3054\u5b58\u77e5\u3067\u3057\u3087\u3046\u304b\u3001\u5f7c\u306fS\u5730\u533a\u306e\u6cd5\u5ef7\u8abf\u67fb\u5b98\u3060\u3063\u305f\u3093\u3067\u3059\u3002"}
{"translation": "5\u5e74\u4ee5\u4e0a\u3082\u52e4\u3081\u307e\u3057\u305f\u304c\u3001\u8caf\u91d1\u3082\u307e\u3068\u307e\u3089\u305a\u3001\u7121\u7f6a\u3092\u7dad\u6301\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "\u300c\u5f7c\u306f\u3068\u3066\u3082\u8a71\u3059\u306e\u304c\u591a\u3044\u308f\u306d\u300d"}
{"translation": "\u3068\u3001\u79c1\u306f\u8003\u3048\u306a\u304c\u3089\u3001\u30da\u30f3\u306b\u624b\u3092\u4f38\u3070\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u3067\u5fd9\u3057\u304b\u3063\u305f\u3053\u3068\u3092\u793a\u3057\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\uff08\u305d\u306e\u5f53\u6642\u306f\u3001\u672c\u5f53\u306b\u8a2a\u554f\u8005\u304c\u3046\u3093\u3056\u308a\u3059\u308b\u307b\u3069\u3060\u3063\u305f\u306e\u3060\uff01\uff09 \u300c\u3042\u306a\u305f\u306e\u304a\u6642\u9593\u3092\u4e00\u5206\u3060\u3051\u9802\u304d\u307e\u3059\uff01\u300d\u3068\u79c1\u306e\u4e3b\u4eba\u516c\u306f\u8b1d\u7f6a\u306e\u53e3\u8abf\u3067\u8a71\u3057\u7d9a\u3051\u307e\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u4f55\u3088\u308a\u3082\u307e\u305a\u81ea\u5df1\u7d39\u4ecb\u3055\u305b\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u6cd5\u5b66\u5019\u88dc\u8005\u30a4\u30f4\u30a1\u30f3\u30fb\u30da\u30c8\u30ed\u30f4\u30a3\u30c1\u30fb\u30ab\u30e0\u30a4\u30b7\u30a7\u30d5\u3001\u5143\u635c\u67fb\u5b98\u3002"}
{"translation": "\u7b46\u8005\u3067\u3042\u308b\u65b9\u3005\u306e\u4ef2\u9593\u306b\u6570\u3048\u3089\u308c\u308b\u308f\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u305d\u308c\u3067\u3082\u306a\u304a\u3001\u7d14\u7c8b\u306b\u66f8\u304d\u7269\u306e\u76ee\u7684\u3067\u7686\u69d8\u306e\u3068\u3053\u308d\u3078\u53c2\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u3042\u306a\u305f\u306e\u524d\u306b\u7acb\u3063\u3066\u3044\u308b\u306e\u306f\u3001\u81ea\u5206\u304c\u56db\u5341\u6b73\u8fd1\u3044\u306b\u3082\u304b\u304b\u308f\u3089\u305a\u521d\u7d1a\u8005\u30af\u30e9\u30b9\u306b\u53c2\u52a0\u3057\u305f\u3044\u3068\u601d\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3067\u3082\u3001\u9045\u304f\u3066\u3082\u3057\u306a\u3044\u3088\u308a\u306f\u307e\u3057\u3067\u3059\u3002"}
{"translation": "\u79c1\u306e\u4e8b\u52d9\u6240\u306b\u5165\u3063\u3066\u304d\u305f\u5f7c\u306f\u3001\u6238\u60d1\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u5f7c\u306e\u512a\u3057\u304f\u654f\u611f\u306a\u6027\u683c\u306f\u3001\u304a\u305d\u3089\u304f\u79c1\u306e\u3057\u304b\u3081\u3063\u9762\u3001\u4e0d\u6e80\u3052\u306a\u8868\u60c5\u306b\u30b7\u30e7\u30c3\u30af\u3092\u53d7\u3051\u305f\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u3069\u3046\u304b\u3001\u304a\u8a31\u3057\u304f\u3060\u3055\u3044\uff01"}
{"translation": "\u5f7c\u306f\u305d\u308c\u3092\u67d4\u3089\u304b\u304f\u3001\u901e\u3057\u3044\u30d0\u30ea\u30c8\u30f3\u3067\u59cb\u3081\u305f\u3002"}
{"translation": "\u300c\u79c1\u306f\u6642\u9593\u5916\u306b\u304a\u90aa\u9b54\u3057\u3001\u7686\u3055\u3093\u306b\u79c1\u306e\u305f\u3081\u306b\u4f8b\u5916\u3092\u4f5c\u3089\u305b\u3066\u3057\u307e\u3063\u3066\u3044\u307e\u3059\u3002\u300d"}
{"translation": "\u3042\u306a\u305f\u306f\u3068\u3066\u3082\u5fd9\u3057\u3044\u3067\u3059\u306d\uff01"}
{"translation": "\u3057\u304b\u3057\u3001\u554f\u984c\u306f\u3001\u7de8\u96c6\u9577\u306e\u7686\u69d8\u3001\u660e\u65e5\u79c1\u306f\u3068\u3066\u3082\u91cd\u8981\u306a\u4ed5\u4e8b\u3067\u30aa\u30c7\u30c3\u30b5\u306b\u51fa\u767a\u3059\u308b\u3093\u3067\u3059\u3002"}
{"translation": "\u3053\u306e\u65c5\u884c\u3092\u571f\u66dc\u65e5\u307e\u3067\u9045\u3089\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u308c\u3070\u3001\u78ba\u4fe1\u3057\u3066\u304f\u3060\u3055\u3044\u3001\u79c1\u306f\u3042\u306a\u305f\u306b\u7279\u4f8b\u3092\u4f5c\u3063\u3066\u3082\u3089\u3046\u3088\u3046\u983c\u3080\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "\u79c1\u306f\u898f\u5247\u3092\u5c0a\u91cd\u3057\u307e\u3059\u3001\u306a\u305c\u306a\u3089\u79c1\u306f\u79e9\u5e8f\u3092\u611b\u3057\u3066\u3044\u308b\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u6817\u8272\u306e\u9aea\u3068\u3072\u3052\u306f\u3001\u30b7\u30eb\u30af\u306e\u3088\u3046\u306b\u5bc6\u96c6\u3057\u3066\u3044\u3066\u67d4\u3089\u304b\u3044\u3002"}
{"translation": "\u67d4\u3089\u304b\u3044\u9aea\u306f\u3001\u512a\u3057\u304f\u3066\u7e4a\u7d30\u3067\u3001\u300c\u30b7\u30eb\u30af\u306e\u3088\u3046\u306a\u300d\u5fc3\u306e\u8a3c\u3060\u3068\u8a00\u308f\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u72af\u7f6a\u8005\u3084\u9670\u967a\u3067\u9811\u56fa\u306a\u6027\u683c\u306e\u4eba\u3005\u306f\u3001\u307b\u3068\u3093\u3069\u306e\u5834\u5408\u3001\u786c\u3044\u9aea\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u304c\u672c\u5f53\u306a\u306e\u304b\u3069\u3046\u304b\u3001\u8aad\u8005\u306f\u307e\u305f\u5f8c\u307b\u3069\u898b\u308b\u3053\u3068\u306b\u306a\u308b\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u305d\u306e\u9854\u3064\u304d\u3082\u3001\u9aed\u3082\u3001\u30d0\u30c3\u30b8\u3092\u6301\u3064\u7d33\u58eb\u306e\u4e2d\u3067\u6700\u3082\u512a\u3057\u304f\u3066\u67d4\u3089\u304b\u3044\u306e\u306f\u3001\u5927\u304d\u304f\u91cd\u305f\u3044\u4f53\u306e\u52d5\u304d\u3060\u3063\u305f\u3002"}
{"translation": "\u3053\u308c\u3089\u306e\u52d5\u304d\u306b\u306f\u3001\u793c\u5100\u6b63\u3057\u3055\u3001\u8efd\u3084\u304b\u3055\u3001\u512a\u96c5\u3055\u3001\u305d\u3057\u3066\u8a31\u3057\u3066\u307b\u3057\u3044\u304c\u5c11\u3057\u306e\u5973\u6027\u3089\u3057\u3055\u3055\u3048\u3082\u898b\u3066\u53d6\u308c\u308b\u3002"}
{"translation": "\u79c1\u306e\u4e3b\u4eba\u516c\u306f\u3001\u8e44\u9244\u3092\u66f2\u3052\u305f\u308a\u3001\u30b5\u30fc\u30c7\u30a3\u30f3\u7f36\u3092\u62f3\u3067\u6f70\u3059\u306e\u306b\u5fc5\u8981\u306a\u529b\u306f\u305d\u308c\u307b\u3069\u591a\u304f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u5f7c\u306e\u52d5\u304d\u304b\u3089\u306f\u5f7c\u304c\u8eab\u4f53\u7684\u306b\u5f37\u3044\u3068\u3044\u3046\u3053\u3068\u306f\u4e00\u5207\u611f\u3058\u3089\u308c\u307e\u305b\u3093\u3002"}
{"translation": "\u5f7c\u306f\u30c9\u30a2\u306e\u53d6\u3063\u624b\u3084\u5e3d\u5b50\u3092\u8776\u306b\u89e6\u308c\u308b\u304b\u306e\u3088\u3046\u306b\u3001\u512a\u3057\u304f\u3001\u614e\u91cd\u306b\u3001\u6307\u5148\u3067\u8efd\u304f\u89e6\u308c\u306a\u304c\u3089\u63b4\u307f\u307e\u3059\u3002"}
{"translation": "\u5f7c\u306e\u6b69\u307f\u306f\u97f3\u3092\u7acb\u3066\u305a\u3001\u63e1\u624b\u306f\u5f31\u3044\u3002"}
{"translation": "\u5f7c\u3092\u898b\u3066\u3044\u308b\u3068\u3001\u5f7c\u304c\u30b4\u30ea\u30a2\u30c6\u306e\u3088\u3046\u306b\u5f37\u529b\u3067\u3001\u5f7c\u4e00\u4eba\u3067\u7de8\u96c6\u90e8\u306e\u30a2\u30f3\u30c9\u30ec\u30a4\u305f\u3061\u4e94\u4eba\u304c\u6301\u3061\u4e0a\u3052\u308b\u3053\u3068\u306e\u3067\u304d\u306a\u3044\u4f55\u304b\u3092\u4e00\u624b\u306b\u6301\u3061\u4e0a\u3052\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3053\u3068\u3092\u5fd8\u308c\u3066\u3057\u307e\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\u306e\u8efd\u3084\u304b\u306a\u52d5\u304d\u3092\u898b\u3066\u3044\u308b\u3068\u3001\u5f7c\u304c\u5f37\u304f\u3066\u91cd\u3044\u3068\u306f\u4fe1\u3058\u3089\u308c\u306a\u3044\u3002"}
{"translation": "\u30b9\u30da\u30f3\u30b5\u30fc\u306a\u3089\u5f7c\u3092\u512a\u96c5\u3055\u306e\u6a21\u7bc4\u3068\u3057\u3066\u547c\u3076\u3060\u308d\u3046\u3002"}
{"translation": "\u305d\u306e\u9854\u5168\u4f53\u304b\u3089\u306f\u3001\u7387\u76f4\u3055\u3001\u7d14\u7c8b\u306a\u5927\u3089\u304b\u3055\u3001\u8aa0\u5b9f\u3055\u304c\u6ef2\u307f\u51fa\u3066\u3044\u305f\u3002"}
{"translation": "\u9854\u304c\u9b42\u306e\u93e1\u3067\u3042\u308b\u3068\u3044\u3046\u8a00\u8449\u304c\u5618\u3067\u306f\u306a\u3044\u306e\u306a\u3089\u3001\u521d\u3081\u3066\u30b3\u30ac\u30e9\u30af\u30b7\u30c4\u30b1\u5e3d\u306e\u7d33\u58eb\u306b\u4f1a\u3063\u305f\u305d\u306e\u65e5\u306b\u3001\u79c1\u306f\u5f7c\u304c\u3046\u305d\u3092\u3064\u304f\u3053\u3068\u3092\u77e5\u3089\u306a\u3044\u3068\u78ba\u4fe1\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u305f\u3002"}
{"translation": "\u79c1\u306f\u8ced\u3051\u3092\u3057\u3066\u3082\u3044\u3044\u304f\u3089\u3044\u3060\u3002"}
{"translation": "\u79c1\u304c\u8ced\u3051\u306b\u8ca0\u3051\u305f\u304b\u3069\u3046\u304b\u306f\u3001\u8aad\u8005\u304c\u3053\u308c\u304b\u3089\u898b\u3066\u3044\u304f\u3053\u3068\u306b\u306a\u308b\u3060\u308d\u3046\u3002"}
{"translation": "\u5f7c\u306f\u3001\u3059\u3067\u306b\u8ff0\u3079\u305f\u901a\u308a\u3001\u80cc\u304c\u9ad8\u304f\u3066\u80a9\u304c\u5e83\u304f\u3001\u826f\u3044\u52b4\u50cd\u99ac\u306e\u3088\u3046\u306b\u5065\u5eb7\u7684\u3060\u3002"}
{"translation": "\u5f7c\u306e\u5168\u8eab\u304b\u3089\u306f\u3001\u5065\u5eb7\u3068\u529b\u304c\u306b\u3058\u307f\u51fa\u3066\u3044\u308b\u3002"}
{"translation": "\u9854\u306f\u30d4\u30f3\u30af\u8272\u3067\u3001\u624b\u306f\u5927\u304d\u304f\u3001\u80f8\u306f\u5e83\u304f\u7b4b\u8089\u8cea\u3067\u3001\u9aea\u306e\u6bdb\u306f\u5065\u5eb7\u306a\u5c11\u5e74\u306e\u3088\u3046\u306b\u6fc3\u3044\u3002"}
{"translation": "\u5f7c\u306f40\u6b73\u524d\u5f8c\u3060\u3002"}
{"translation": "\u5f7c\u306f\u304a\u3057\u3083\u308c\u3067\u3001\u6700\u65b0\u306e\u6d41\u884c\u3092\u8ffd\u3063\u3066\u3001\u65b0\u54c1\u306e\u304d\u3061\u3093\u3068\u3057\u305f\u30b9\u30fc\u30c4\u3092\u7740\u3066\u3044\u305f\u3002"}
{"translation": "\u80f8\u306b\u306f\u5927\u304d\u306a\u91d1\u306e\u30c1\u30a7\u30fc\u30f3\u3068\u5c0f\u7269\u304c\u3042\u308a\u3001\u5c0f\u6307\u306b\u306f\u83ef\u3084\u304b\u306a\u661f\u306e\u3088\u3046\u306b\u8f1d\u304f\u5fae\u7d30\u306a\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u306e\u30ea\u30f3\u30b0\u304c\u3061\u3089\u3064\u304f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u4f55\u3088\u308a\u3082\u91cd\u8981\u306a\u3053\u3068\u3067\u3001\u305d\u308c\u306f\u3069\u3093\u306a\u5c0f\u898f\u6a21\u3067\u3082\u307e\u3068\u3082\u306a\u5c0f\u8aac\u3084\u7269\u8a9e\u306e\u4e3b\u4eba\u516c\u306b\u3068\u3063\u3066\u975e\u5e38\u306b\u91cd\u8981\u306a\u3053\u3068\u3067\u3042\u308b\u304c\u3001\u5f7c\u306f\u975e\u5e38\u306b\u7f8e\u3057\u3044\u3002"}
{"translation": "\u79c1\u306f\u5973\u6027\u3067\u3082\u82b8\u8853\u5bb6\u3067\u3082\u306a\u3044\u3002"}
{"translation": "\u79c1\u306f\u7537\u6027\u306e\u7f8e\u3057\u3055\u306b\u3064\u3044\u3066\u3042\u307e\u308a\u7406\u89e3\u3057\u3066\u3044\u306a\u3044\u304c\u3001\u305d\u306e\u30b3\u30b5\u30fc\u30b8\u30e5\u3092\u3064\u3051\u305f\u7d33\u58eb\u306e\u5916\u898b\u306f\u79c1\u306b\u5370\u8c61\u3092\u4e0e\u3048\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306e\u5927\u304d\u306a\u7b4b\u8089\u8cea\u306e\u9854\u306f\u79c1\u306e\u8a18\u61b6\u306b\u6c38\u9060\u306b\u6b8b\u3063\u305f\u3002"}
{"translation": "\u305d\u306e\u9854\u306b\u306f\u3001\u672c\u7269\u306e\u30ae\u30ea\u30b7\u30e3\u4eba\u306e\u9f3b\u3068\u305d\u306e\u51f9\u51f8\u3001\u7d30\u304f\u7f8e\u3057\u3044\u5507\u3001\u305d\u3057\u3066\u512a\u3057\u3055\u3068\u4f55\u304b\u540d\u524d\u3092\u3064\u3051\u308b\u306e\u304c\u96e3\u3057\u3044\u3082\u306e\u304c\u8f1d\u3044\u3066\u3044\u308b\u9752\u3044\u76ee\u3092\u898b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}
{"translation": "\u3053\u306e\u300c\u4f55\u304b\u300d\u306f\u5c0f\u3055\u306a\u52d5\u7269\u306e\u76ee\u306b\u3082\u89b3\u5bdf\u3067\u304d\u307e\u3059\u3001\u305d\u308c\u3089\u304c\u6182\u9b31\u3067\u3042\u308b\u3068\u304d\u3084\u75db\u307f\u3092\u611f\u3058\u3066\u3044\u308b\u6642\u306b\u3002"}
{"translation": "\u4f55\u304b\u3057\u3044\u3068\u3001\u5b50\u4f9b\u306e\u3088\u3046\u306a\u3001\u7d20\u76f4\u306b\u8010\u3048\u5fcd\u3093\u3067\u3044\u308b\u69d8\u5b50\u3002"}
{"translation": "\u7b56\u7565\u5bb6\u3084\u975e\u5e38\u306b\u8ce2\u3044\u4eba\u3005\u306e\u76ee\u306f\u3001\u305d\u3046\u3044\u3046\u8a33\u306b\u306f\u3044\u304b\u306a\u3044\u3002"}
{"translation": "\u79c1\u306f\u305f\u3081\u606f\u3092\u3064\u304d\u3001\u30da\u30f3\u3092\u7f6e\u3044\u3066\u3001\u30b3\u30ab\u30fc\u30c9\u306e\u7d33\u58eb\u3092\u5f85\u3064\u3053\u3068\u306b\u3057\u305f\u3002"}
{"translation": "\u65b0\u9032\u306e\u4f5c\u5bb6\u3084\u3001\u3044\u308f\u3086\u308b\u7de8\u96c6\u90e8\u306e\u79d8\u5bc6\u3092\u77e5\u3089\u306a\u3044\u4eba\u3005\u306f\u3001\u300c\u7de8\u96c6\u300d\u306e\u8a00\u8449\u306b\u8056\u306a\u308b\u754f\u6016\u3092\u611f\u3058\u3066\u3001\u81ea\u5206\u3092\u304b\u306a\u308a\u9577\u3044\u9593\u5f85\u305f\u305b\u308b\u3002"}
{"translation": "\u5f7c\u3089\u306f\u3001\u7de8\u96c6\u9577\u306e\u300c\u3069\u3046\u305e\u300d\u3068\u3044\u3046\u8a00\u8449\u306e\u5f8c\u3001\u9577\u3044\u9593\u54b3\u6255\u3044\u3092\u3057\u305f\u308a\u3001\u9f3b\u3059\u3059\u308a\u3092\u3057\u305f\u308a\u3057\u3001\u3086\u3063\u304f\u308a\u3068\u30c9\u30a2\u3092\u958b\u3051\u3066\u3055\u3089\u306b\u3086\u3063\u304f\u308a\u3068\u90e8\u5c4b\u306b\u5165\u308b\u3053\u3068\u3067\u304b\u306a\u308a\u306e\u6642\u9593\u3092\u6d6a\u8cbb\u3057\u3066\u3057\u307e\u3046\u3002"}
{"translation": "\u300c\u3069\u3046\u305e\u300d"}
{"translation": "\u3057\u304b\u3057\u3001\u30b3\u30ab\u30fc\u30c9\u3092\u3064\u3051\u305f\u7d33\u58eb\u306f\u5f85\u305f\u305b\u306f\u3057\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u30a2\u30f3\u30c9\u30ec\u30a4\u306e\u5f8c\u3067\u6249\u304c\u9589\u307e\u308b\u3068\u3059\u3050\u306b\u3001\u79c1\u306e\u30aa\u30d5\u30a3\u30b9\u306b\u306f\u7d19\u306e\u5305\u307f\u3092\u7247\u624b\u306b\u3001\u3082\u3046\u7247\u65b9\u306e\u624b\u306b\u306f\u77ed\u51a0\u5e3d\u3092\u6301\u3063\u305f\u5927\u67c4\u306a\u7537\u6027\u304c\u7acb\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u79c1\u3068\u306e\u9762\u4f1a\u3092\u57f7\u62d7\u306b\u6c42\u3081\u3066\u304d\u305f\u3042\u306e\u4eba\u306f\u3001\u79c1\u306e\u7269\u8a9e\u306e\u4e2d\u3067\u975e\u5e38\u306b\u5927\u304d\u306a\u5f79\u5272\u3092\u679c\u305f\u3059\u3002"}
{"translation": "\u5f7c\u306e\u98a8\u8c8c\u3092\u63cf\u5199\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"}
{"translation": "1880\u5e74\u306e\u3042\u308b4\u6708\u306e\u663c\u4e0b\u304c\u308a\u3001\u9580\u756a\u306e\u30a2\u30f3\u30c9\u30ec\u30a4\u304c\u79c1\u306e\u30aa\u30d5\u30a3\u30b9\u306b\u5165\u3063\u3066\u304d\u3066\u3001\u4e00\u4eba\u306e\u7d33\u58eb\u304c\u7de8\u96c6\u90e8\u306b\u8a2a\u308c\u3001\u6328\u62f6\u3092\u6c42\u3081\u3066\u5f01"}
{"translation": "\u89e3\u3057\u3066\u3044\u308b\u3068\u795e\u79d8\u7684\u306b\u5831\u544a\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u5f79\u4eba\u3060\u308d\u3046\u3001\u300d\u3068\u30a2\u30f3\u30c9\u30ec\u30a4\u306f\u4ed8\u3051\u52a0\u3048\u305f\u3001"}
{"translation": "\u300c\u7d0b\u7ae0\u4ed8\u304d\u3067\u3002\u300d"}
{"translation": "\u300c\u5f7c\u306b\u4ed6\u306e\u6642\u9593\u306b\u6765\u308b\u3088\u3046\u983c\u3093\u3067\u304f\u308c\u3001\u3068\u79c1\u306f\u8a00\u3063\u305f\u3002\u300d"}
{"translation": "\u4eca\u65e5\u306f\u5fd9\u3057\u3044\u3067\u3059\u3002"}
{"translation": "\u7de8\u96c6\u8005\u306f\u571f\u66dc\u65e5\u3060\u3051\u3057\u304b\u53d7\u3051\u4ed8\u3051\u3066\u3044\u306a\u3044\u3068\u4f1d\u3048\u3066\u3002"}
{"translation": "\u5f7c\u306f\u4e09\u65e5\u9593\u3082\u6765\u3066\u3001\u3042\u306a\u305f\u306b\u5c0b\u306d\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u5927\u304d\u306a\u554f\u984c\u3060\u3068\u8a00\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u304a\u9858\u3044\u3057\u3066\u3001\u307b\u3068\u3093\u3069\u6ce3\u304d\u305d\u3046\u306b\u306a\u308b\u3002"}
{"translation": "\u300c\u571f\u66dc\u65e5\u306b\u306f\u3001\u9032\u884c\u304c\u96e3\u3057\u3044\u3068\u5f7c\u306f\u8a00\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u304a\u53d7\u3051\u53d6\u308a\u306b\u306a\u308a\u307e\u3059\u304b\uff1f"}
