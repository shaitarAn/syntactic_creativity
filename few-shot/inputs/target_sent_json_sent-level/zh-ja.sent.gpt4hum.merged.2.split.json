{"translation": "\u975e\u5e38\u306b\u9577\u3044\u9593\u306e\u3042\u308b\u65e5\u3001\u5f7c\u5973\u306e\u592b\u304c\u75c5\u9662\u304b\u3089\u5e30\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u5f7c\u306e\u8868\u60c5\u306f\u53b3\u7c9b\u3067\u3001\u300c\u6587\u5316\u5927\u9769\u547d\u300d\u306b\u3064\u3044\u3066\u8a9e\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u75c5\u9662\u3067\u306f\u6bce\u65e5\u4f1a\u8b70\u304c\u958b\u304b\u308c\u3001\u5f7c\u306b\u5bfe\u3059\u308b\u30d3\u30e9\u3082\u57f7\u7b46\u3055\u308c\u3001\u5f7c\u306e\u6b74\u53f2\u306b\u554f\u984c\u304c\u3042\u308b\u3068\u8a00\u308f\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3068\u3066\u3082\u7dca\u5f35\u3057\u3066\u3044\u305f\u3001\u592b\u304c\u5f7c\u5973\u306b\u3053\u308c\u3089\u306e\u3053\u3068\u3092\u8a71\u3059\u610f\u5473\u304c\u5206\u304b\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u5f7c\u5973\u306e\u592b\u306f\u7a81\u7136\u3001\u300c\u4f55\u3082\u5fc3\u914d\u306a\u3044\u3001\u50d5\u304c\u5b88\u308b\u304b\u3089\u300d\u3068\u8a00\u3063\u305f\u3002"}
{"translation": "\u3042\u306a\u305f\u306e\u904e\u53bb\u306e\u3053\u3068\u3092\u3001\u4e00\u751f\u601d\u3044\u51fa\u3055\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u3042\u306a\u305f\u306e\u6700\u5927\u306e\u6575\u306f\u4ed6\u4eba\u3067\u306f\u306a\u304f\u3001\u304a\u305d\u3089\u304f\u5fd8\u308c\u3066\u3057\u307e\u3063\u305f\u3082\u306e\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002"}
{"translation": "\u3082\u3057\u8ab0\u304b\u304c\u3042\u306a\u305f\u306b\u4f55\u304b\u805e\u3044\u3066\u304d\u305f\u3089\u3001\u4f55\u3082\u77e5\u3089\u306a\u3044\u3068\u8a00\u3063\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u305d\u308c\u3067\u554f\u984c\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u3069\u3053\u306e\u51fa\u8eab\u3067\u3059\u304b\uff1f \u3069\u306e\u6751\u306b\u4f4f\u3093\u3067\u3044\u307e\u3059\u304b\uff1f \u3042\u306a\u305f\u306f\u4f55\u6b73\u3067\u3059\u304b\uff1f \u3042\u306a\u305f\u306e\u5bb6\u306b\u306f\u4ed6\u306b\u8ab0\u304c\u3044\u307e\u3059\u304b\uff1f \u3042\u306a\u305f\u306f\u3069\u3046\u3057\u3066\u5ddd\u306b\u843d\u3061\u305f\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u30dc\u30fc\u30c8\u304c\u8ee2\u8986\u3057\u305f\u306e\u3067\u3059\u304b\u3001\u305d\u308c\u3068\u3082\u60aa\u3044\u4eba\u306b\u6295\u3052\u3089\u308c\u307e\u3057\u305f\u304b\uff1f \u3042\u306a\u305f\u3060\u3051\u304c\u6c34\u306b\u843d\u3061\u305f\u306e\u3067\u3059\u304b\u3002"}
{"translation": "\u4eba\u3005\u304c\u4ea4\u4ee3\u3067\u8cea\u554f\u3092\u6295\u3052\u304b\u3051\u3001\u58f0\u97f3\u304c\u512a\u3057\u304f\u3066\u3082\u305d\u308c\u306f\u5229\u304d\u68d8\u306e\u3088\u3046\u306b\u5f7c\u5973\u3092\u523a\u3057\u3001\u5f7c\u5973\u306e\u5fc3\u306f\u4e00\u77ac\u306b\u3057\u3066\u6fc0\u75db\u306b\u8972\u308f\u308c\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u30d9\u30c3\u30c9\u306e\u4e0a\u3067\u4e38\u304f\u306a\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u601d\u3063\u305f\u3001\u300c\u305d\u3046\u3060\u3001\u79c1\u306f\u3069\u3053\u304b\u3089\u6765\u305f\u306e\u3060\u308d\u3046\u304b\uff1f\u300d"}
{"translation": "\u79c1\u306f\u3069\u3053\u306b\u4f4f\u3093\u3067\u3044\u307e\u3059\u304b\uff1f \u79c1\u306e\u540d\u524d\u306f\u4f55\u3067\u3059\u304b\uff1f \u3069\u3046\u3057\u3066\u5ddd\u306b\u843d\u3061\u3066\u3057\u307e\u3063\u305f\u306e\uff1f \u5f7c\u5973\u306f\u5b8c\u5168\u306b\u5370\u8c61\u3092\u5931\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u3069\u3046\u3057\u3066\u899a\u3048\u3066\u3044\u306a\u3044\u306e\u3067\u3059\u304b\uff1f \u306a\u305c\u79c1\u306f\u81ea\u5206\u81ea\u8eab\u306e\u3053\u3068\u3055\u3048\u899a\u3048\u3066\u3044\u306a\u3044\u306e\u304b\uff1f \u305d\u308c\u3067\u5f7c\u5973\u306f\u6ce3\u304d\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3001\u300c\u79c1\u306f\u899a\u3048\u3066\u3044\u306a\u3044\u300d\u3068\u8a00\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u672c\u5f53\u306b\u899a\u3048\u3066\u3044\u306a\u3044\u3002"}
{"translation": "\u305d\u308c\u3067\u4eba\u3005\u306f\u8a00\u3063\u305f\u3001\u300c\u3088\u304f\u8003\u3048\u3066\u307f\u3066\u3001\u3058\u3063\u304f\u308a\u3068\u8003\u3048\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u300d\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u8ab0\u304b\u306b\u5ddd\u304b\u3089\u6551\u3044\u51fa\u3055\u308c\u305f\u4eba\u3067\u3059\u3002"}
{"translation": "\u3042\u306a\u305f\u304c\u5ddd\u306e\u6c34\u304b\u3089\u8003\u3048\u59cb\u3081\u308c\u3070\u3001\u3082\u3057\u304b\u3057\u305f\u3089\u601d\u3044\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002"}
{"translation": "\u5f7c\u5973\u306f\u4eba\u3005\u306e\u8981\u6c42\u306b\u5f93\u3063\u3066\u3001\u672c\u5f53\u306b\u771f\u5263\u306b\u601d\u3044\u8fd4\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u5f7c\u5973\u306e\u601d\u8003\u304c\u5ddd\u8fba\u306b\u5230\u9054\u3059\u308b\u3068\u3001\u30b6\u30fc\u30b6\u30fc\u3068\u3044\u3046\u6c34\u97f3\u306f\u96f7\u9cf4\u306e\u3088\u3046\u306b\u8f5f\u97f3\u3092\u7acb\u3066\u3001\u540d\u524d\u306e\u306a\u3044\u6050\u6016\u304c\u6c34\u97f3\u3068\u5171\u306b\u62bc\u3057\u5bc4\u305b\u3066\u304d\u305f\u3002"}
{"translation": "\u6ce2\u6d9b\u306e\u4e2d\u306b\u9b54\u7269\u304c\u96a0\u308c\u3066\u3044\u308b\u304b\u306e\u3088\u3046\u3067\u3001\u898b\u3048\u306a\u304f\u3066\u89e6\u308c\u3089\u308c\u306a\u3044\u3051\u3069\u5f7c\u5973\u306e\u5fc3\u8eab\u3092\u5bb9\u8d66\u306a\u304f\u8972\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u7a81\u7136\u81ea\u5236\u5fc3\u3092\u5931\u3044\u3001\u58f0\u3092\u5927\u306b\u3057\u3066\u82e6\u3057\u3093\u3067\u6ce3\u304d\u53eb\u3093\u3060\u3002"}
{"translation": "\u305d\u306e\u58f0\u306f\u30d2\u30b9\u30c6\u30ea\u30c3\u30af\u3060\u3063\u305f\u3002"}
{"translation": "\u5433\u59d3\u306e\u4e00\u533b\u5e2b\u304c\u3001\u597d\u5947\u5fc3\u304b\u3089\u4eba\u3005\u3092\u53b3\u3057\u304f\u5236\u6b62\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u3001\u5f7c\u5973\u306f\u304a\u305d\u3089\u304f\u30b7\u30e7\u30c3\u30af\u3092\u53d7\u3051\u305f\u3068\u8a00\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306b\u3053\u308c\u4ee5\u4e0a\u8003\u3048\u3055\u305b\u306a\u3044\u3067\u3001\u75c5\u6c17\u3092\u6cbb\u3059\u6642\u9593\u3092\u3042\u3052\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u305d\u308c\u4ee5\u964d\u3001\u4eba\u3005\u306f\u5f7c\u5973\u306b\u3064\u3044\u3066\u306e\u8a6e\u7d22\u3092\u6b62\u3081\u3001\u305f\u3060\u660e\u3089\u304b\u306b\u3082\u6697\u306b\u3082\u5f7c\u5973\u3092\u540c\u60c5\u3059\u308b\u53e3\u8abf\u3067\u8a71\u3057\u5408\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u3068\u3066\u3082\u7f8e\u3057\u3044\u6625\u3067\u3057\u305f\u3002"}
{"translation": "\u3053\u306e\u5973\u6027\u306f\u5e38\u306b\u81ea\u5206\u81ea\u8eab\u3068\u6226\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3082\u3046\u3068\u3066\u3082\u8001\u3044\u3066\u3044\u305f\u3002"}
{"translation": "\u3059\u3079\u3066\u306e\u76ae\u819a\u304c\u67d4\u3089\u304b\u304f\u5bdd\u305d\u3079\u3063\u3066\u3057\u307e\u3044\u3001\u3057\u3063\u304b\u308a\u3068\u3057\u305f\u76ba\u4e00\u3064\u4f5c\u308b\u3053\u3068\u304c\u3067\u304d\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u9854\u3068\u9996\u306f\u7d30\u304b\u306a\u50b7\u3067\u8986\u308f\u308c\u3066\u3044\u308b\u3002"}
{"translation": "\u305d\u306e\u808c\u8272\u304c\u767d\u3044\u305f\u3081\u3001\u3053\u308c\u3089\u306e\u75d5\u8de1\u306f\u6642\u9593\u306e\u5200\u304c\u7121\u9020\u4f5c\u306b\u5f15\u304d\u3064\u3051\u305f\u3082\u306e\u3067\u306f\u306a\u304f\u3001\u3080\u3057\u308d\u7d30\u3044\u7b46\u3067\u4e00\u7b46\u305a\u3064\u4e01\u5be7\u306b\u63cf\u304d\u51fa\u3055\u308c\u305f\u3088\u3046\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306e\u773c\u306f\u3059\u3067\u306b\u6fc1\u308a\u304d\u3063\u3066\u3044\u305f\u304c\u3001\u7a81\u7136\u5927\u304d\u304f\u958b\u3051\u305f\u6642\u3001\u4e2d\u304b\u3089\u5149\u675f\u304c\u51fa\u3066\u3044\u308b\u306e\u3092\u307e\u3060\u898b\u308b\u3053\u3068\u304c\u3067\u304d\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5e38\u306b\u4e00\u7b87\u6240\u3092\u898b\u3064\u3081\u3001\u307c\u3093\u3084\u308a\u3068\u3057\u3066\u3044\u308b\u3088\u3046\u3067\u3001\u4f55\u304b\u3092\u8003\u3048\u3066\u3044\u308b\u3088\u3046\u306b\u3082\u898b\u3048\u3001\u307e\u305f\u5168\u304f\u9000\u5c48\u306a\u69d8\u5b50\u3067\u3082\u3042\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u306b\u3064\u3044\u3066\u6642\u6298\u901a\u884c\u4eba\u304c\u597d\u5947\u5fc3\u304b\u3089\u300c\u304a\u3070\u3042\u3055\u3093\u3001\u4f55\u8003\u3048\u3066\u3044\u308b\u306e\uff1f\u300d\u3068\u805e\u304f\u3053\u3068\u304c\u3042\u308b\u3002"}
{"translation": "\u305d\u306e\u6642\u3001\u5f7c\u5973\u306f\u56f0\u60d1\u3057\u305f\u9854\u3092\u9732\u308f\u306b\u3057\u3001\u901a\u884c\u4eba\u3092\u898b\u3064\u3081\u3001\u8ab0\u306b\u3082\u805e\u3053\u3048\u306a\u3044\u4f55\u304b\u3092\u3064\u3076\u3084\u304f\u3060\u308d\u3046\u3002"}
{"translation": "\u5f7c\u5973\u306f\u81ea\u5206\u304c\u4f55\u3092\u8a00\u3063\u305f\u306e\u304b\u5206\u304b\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u5b9f\u306f\u3001\u5f7c\u5973\u81ea\u8eab\u3082\u81ea\u5206\u304c\u4f55\u3092\u8003\u3048\u3066\u3044\u308b\u306e\u304b\u3088\u304f\u308f\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u5f7c\u5973\u306f\u6570\u3048\u5207\u308c\u306a\u3044\u307b\u3069\u306e\u5947\u5999\u306a\u3082\u306e\u304c\u5fc5\u6b7b\u3067\u5916\u306b\u98db\u3073\u51fa\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u611f\u3058\u3001\u305d\u308c\u304c\u5f7c\u5973\u306e\u8a18\u61b6\u3092\u304b\u304d\u7acb\u3066\u3066\u3044\u308b\u3088\u3046\u3060\u3002"}
{"translation": "\u305d\u3057\u3066\u305d\u308c\u3089\u306f\u3001\u5f7c\u5973\u304c\u4e00\u751f\u89e6\u308c\u305f\u304f\u306a\u3044\u7269\u4e8b\u3067\u3042\u308b\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5fc5\u6b7b\u306b\u62b5\u6297\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u62b5\u6297\u306f\u3001\u98a8\u3092\u901a\u3055\u306a\u3044\u5927\u304d\u306a\u7db2\u306e\u3088\u3046\u3067\u3001\u3044\u3064\u3067\u3082\u98db\u3073\u51fa\u3057\u3066\u304f\u308b\u4e00\u7fa4\u306e\u60aa\u9b54\u3092\u304b\u3076\u305b\u3066\u675f\u7e1b\u3059\u308b\u304b\u306e\u3088\u3046\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306e\u4e00\u751f\u3092\u901a\u3058\u3066\u3001\u5e38\u306b\u3053\u306e\u7db2\u3092\u6301\u3061\u3001\u305d\u308c\u3089\u3068\u95d8\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u592b\u304c\u751f\u304d\u3066\u3044\u308b\u6642\u3001\u5f7c\u306f\u4f55\u304b\u3092\u8003\u3048\u308b\u3053\u3068\u3092\u63d0\u6848\u3057\u305f\u3002"}
{"translation": "\u3082\u3057\u4f55\u304b\u3092\u601d\u3044\u3064\u3051\u3070\u3001\u5fc3\u304c\u843d\u3061\u7740\u304f\u304b\u3082\u3057\u308c\u306a\u3044\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5f7c\u306e\u8a00\u3046\u3053\u3068\u306b\u5f93\u3044\u3001\u672c\u5f53\u306b\u81ea\u5206\u3092\u843d\u3061\u7740\u304b\u305b\u3066\u3001\u601d\u3044\u51fa\u3059\u305f\u3081\u306b\u4e00\u751f\u61f8\u547d\u306b\u52aa\u529b\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u307b\u3093\u306e\u4e00\u77ac\u3067\u3001\u5168\u8eab\u306e\u82db\u7acb\u3061\u306f\u7121\u6570\u306e\u91dd\u304c\u98db\u3073\u6563\u3063\u3066\u523a\u3057\u8fbc\u3080\u3088\u3046\u306b\u611f\u3058\u3089\u308c\u3001\u305d\u306e\u5f37\u3055\u306f\u51c4\u307e\u3058\u304f\u3001\u5f7c\u5973\u306b\u4e94\u81d3\u516d\u8151\u304c\u88c2\u3051\u308b\u3088\u3046\u306a\u611f\u899a\u3092\u4e0e\u3048\u305f\u3002"}
{"translation": "\u305d\u306e\u77ac\u9593\u3001\u5f7c\u5973\u306e\u82e6\u3057\u307f\u3068\u75b2\u308c\u304c\u5f7c\u5973\u3092\u606f\u82e6\u3057\u3044\u72b6\u614b\u306b\u8ffd\u3044\u8fbc\u3093\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306f\u7d76\u671b\u7684\u306b\u592b\u306b\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u79c1\u3092\u8ffd\u3044\u8a70\u3081\u306a\u3044\u3067\u3002"}
{"translation": "\u8003\u3048\u3089\u308c\u306a\u3044\u3002"}
{"translation": "\u8003\u3048\u308b\u3068\u3001\u81ea\u5206\u304c\u6b7b\u306c\u3079\u304d\u3060\u3068\u611f\u3058\u308b\u300d\u5f7c\u5973\u306e\u592b\u306f\u602f\u3048\u3066\u3057\u307e\u3063\u305f\u3002"}
{"translation": "\u9ed9\u3063\u3066\u3057\u3070\u3089\u304f\u8003\u3048\u305f\u5f8c\u3001\u5f7c\u306f\u5f7c\u5973\u306b\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u305d\u308c\u306a\u3089\u3082\u3046\u8003\u3048\u308b\u3053\u3068\u306f\u306a\u3044\u3002"}
{"translation": "\u81ea\u5206\u3067\u51fa\u6765\u308b\u3053\u3068\u3092\u898b\u3064\u3051\u3066\u3001\u5fd9\u3057\u304f\u52d5\u304f\u3053\u3068\u3067\u601d\u8003\u3092\u906e\u65ad\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u300d"}
{"translation": "\u5f7c\u5973\u306f\u592b\u306e\u8a00\u8449\u306b\u5f93\u3063\u3066\u884c\u52d5\u3057\u3001\u6bce\u65e5\u5fd9\u3057\u304f\u904e\u3054\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u5b9f\u969b\u3001\u5f7c\u5973\u306b\u306f\u7279\u5225\u306a\u4ed5\u4e8b\u304c\u3042\u308b\u308f\u3051\u3067\u306f\u306a\u304f\u3001\u5f7c\u5973\u306e\u4e3b\u306a\u4ed5\u4e8b\u306f\u5bb6\u4e8b\u3092\u3059\u308b\u3053\u3068\u3067\u3042\u308b\u3002"}
{"translation": "\u5f7c\u5973\u306f\u6bce\u65e5\u5fd9\u3057\u304f\u6383\u9664\u3084\u7247\u4ed8\u3051\u3092\u3057\u3066\u3001\u5bb6\u306e\u4e2d\u3092\u304d\u308c\u3044\u306b\u7dad\u6301\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u5bb6\u3092\u8a2a\u308c\u305f\u4eba\u3005\u306f\u7686\u3001\u3042\u306a\u305f\u306e\u304a\u5bb6\u306f\u672c\u5f53\u306b\u7dba\u9e97\u3067\u3059\u306d\u3068\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u592b\u306f\u533b\u8005\u3067\u3001\u305d\u308c\u3092\u8a87\u308a\u306b\u601d\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u3053\u306e\u3088\u3046\u306b\u3001\u5f7c\u5973\u306e\u751f\u6d3b\u306f\u5c11\u3057\u305a\u3064\u901a\u5e38\u306b\u623b\u3063\u305f\u3002"}
{"translation": "\u4f55\u5e74\u3082\u3001\u5f7c\u5973\u306f\u305a\u3063\u3068\u3053\u306e\u3088\u3046\u3067\u3057\u305f\u3002"}
{"translation": "\u6bce\u5e74\u306e\u6642\u9593\u306f\u3001\u5f7c\u5973\u306e\u8a18\u61b6\u306e\u80cc\u5f8c\u306b\u3042\u308b\u3082\u306e\u3092\u5c64\u5c64\u306b\u8986\u3046\u3001\u5fae\u7d30\u3067\u5bc6\u306a\u819c\u306e\u3088\u3046\u3060\u3002"}
{"translation": "\u4e00\u5e74\u4e00\u679a\u3001\u5e74\u3005\u91cd\u306d\u3089\u308c\u3066\u3001\u8584\u304b\u3089\u539a\u3078\u3068\u51dd\u7e2e\u3055\u308c\u677f\u306b\u306a\u308b\u3002"}
{"translation": "\u5f7c\u5973\u306e\u610f\u8b58\u6df1\u304f\u306b\u6f5c\u3093\u3067\u3044\u308b\u60aa\u9b54\u305f\u3061\u306f\u3059\u3079\u3066\u5c01\u3058\u8fbc\u3081\u3089\u308c\u305f\u3002"}
{"translation": "\u3067\u3082\u305d\u308c\u304c\u4f55\u306a\u306e\u304b\u3001\u5f7c\u5973\u306f\u5168\u304f\u77e5\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u304c\u8a18\u61b6\u3092\u5931\u3063\u305f\u306e\u306f1952\u5e74\u306e\u6625\u3060\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3053\u308c\u304c\u592b\u306e\u6170\u3081\u3068\u30ea\u30de\u30a4\u30f3\u30c0\u30fc\u3067\u3042\u308b\u3053\u3068\u3092\u7406\u89e3\u3057\u3066\u3044\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u5fc3\u306e\u4e2d\u3067\u306f\u3080\u3057\u308d\u6fc0\u3057\u304f\u52d5\u63fa\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u592b\u304c\u3059\u3067\u306b\u624b\u4e2d\u306b\u53ce\u3081\u3066\u3044\u308b\u304b\u306e\u3088\u3046\u306b\u3001\u307b\u3068\u3093\u3069\u6d88\u3048\u3066\u3057\u307e\u3063\u305f\u96a0\u308c\u6575\u304c\u898b\u3048\u306a\u3044\u304b\u306e\u3088\u3046\u3060\u3002"}
{"translation": "\u305d\u308c\u306f\u4e00\u4f53\u5168\u4f53\u4f55\u306a\u306e\u304b\uff1f \u5f7c\u304c\u79c1\u304c\u77e5\u3089\u306a\u3044\u3053\u3068\u3092\u77e5\u3063\u3066\u3044\u308b\u306f\u305a\u304c\u3042\u308b\u306e\u304b\uff1f\u3068\u5f7c\u5973\u304c\u601d\u3063\u305f\u6642\u3001\u5b9f\u969b\u306b\u6050\u6016\u306e\u606f\u5439\u3092\u611f\u3058\u3066\u304d\u305f\u3002"}
{"translation": "\u305d\u306e\u6050\u6016\u306f\u5f7c\u5973\u306e\u3059\u3050\u305d\u3070\u306b\u3042\u3063\u305f\u3002"}
{"translation": "\u663c\u3082\u591c\u3082\u3001\u6bce\u5206\u6bce\u79d2\u3002"}
{"translation": "\u305d\u308c\u3067\u5f7c\u5973\u306f\u7406\u89e3\u3057\u305f\u3001\u9577\u5e74\u306b\u308f\u305f\u308a\u3001\u5f7c\u5973\u304c\u6df1\u304f\u611b\u3057\u3066\u3044\u308b\u4eba\u306f\u3001\u540c\u6642\u306b\u5f7c\u5973\u304c\u3068\u3066\u3082\u6050\u308c\u3066\u3044\u308b\u4eba\u3060\u3068\u3002"}
{"translation": "\u306a\u305c\u3060\u308d\u3046\uff1f"}
{"translation": "\u5f7c\u5973\u306f\u306a\u305c\u3053\u3093\u306a\u611f\u899a\u3092\u62b1\u3044\u3066\u3057\u307e\u3046\u306e\u304b\uff1f"}
{"translation": "\u5f7c\u5973\u306f\u6df7\u4e71\u3057\u3066\u304a\u308a\u3001\u7406\u89e3\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u305d\u306e\u611f\u899a\u306f\u78ba\u304b\u306b\u5b58\u5728\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u7a93\u306e\u5916\u306e\u6843\u306e\u6728\u306f\u3001\u30d4\u30f3\u30af\u8272\u306e\u82b1\u304c\u3044\u3063\u3071\u3044\u54b2\u3044\u3066\u3044\u308b\u3002"}
{"translation": "\u5ead\u306e\u58c1\u6cbf\u3044\u306e\u674f\u306e\u82b1\u3082\u4e00\u5217\u306b\u767d\u304f\u306a\u308a\u3001\u767d\u3044\u58c1\u3068\u4e00\u7dd2\u306b\u914d\u7f6e\u3055\u308c\u3066\u3001\u9060\u304f\u304b\u3089\u306f\u82b1\u306e\u8272\u304c\u5206\u304b\u3089\u306a\u304f\u306a\u3063\u305f\u3002"}
{"translation": "\u3055\u3089\u306b\u9060\u304f\u306b\u3001\u6570\u672c\u306e\u8001\u9280\u674f\u304c\u78a7\u7dd1\u306e\u8449\u3092\u63fa\u3089\u3057\u3066\u304a\u308a\u3001\u305d\u306e\u592a\u304f\u529b\u5f37\u3044\u6728\u5e79\u304b\u3089\u306f\u690d\u3048\u3089\u308c\u305f\u5e74\u4ee3\u3092\u63a8\u6e2c\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u306a\u3044\u3002"}
{"translation": "\u3069\u3093\u3069\u3093\u9060\u304f\u3078\u3001\u5c71\u3005\u306e\u5f71\u304c\u67d4\u3089\u304b\u304f\u8d77\u4f0f\u3057\u3066\u3001\u8f2a\u90ed\u306f\u82b1\u3073\u3089\u306e\u3088\u3046\u3060\u3002"}
{"translation": "\u5ead\u306e\u89d2\u306b\u54b2\u3044\u3066\u3044\u308b\u8fce\u6625\u82b1\u306f\u307b\u3068\u3093\u3069\u6563\u308a\u304b\u3051\u3066\u3044\u307e\u3059\u304c\u3001\u305d\u306e\u9bae\u3084\u304b\u306a\u9ec4\u8272\u306e\u82b1\u3073\u3089\u306f\u4f9d\u7136\u3068\u3057\u3066\u8f1d\u3044\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u4e94\u5f69\u7d1b\u3005\u3068\u3057\u305f\u8272\u5f69\u304c\u7a81\u7136\u5f7c\u5973\u306e\u76ee\u306b\u5165\u3063\u305f\u3002"}
{"translation": "\u6625\u306b\u623b\u308b\u9ce5\u305f\u3061\u306f\u3001\u3053\u306e\u6642\u70b9\u3067\u7cbe\u795e\u3092\u632f\u308a\u7d5e\u3063\u3066\u3044\u308b\u3088\u3046\u3060\u3002"}
{"translation": "\u98a8\u306f\u307e\u3060\u51b7\u305f\u3055\u3092\u6301\u3063\u3066\u3044\u308b\u304c\u3001\u305d\u308c\u3089\u306e\u9ce5\u306f\u3053\u306e\u5fae\u304b\u306a\u51b7\u6c17\u306e\u4e2d\u3067\u6b4c\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u3053\u3093\u306a\u98a8\u666f\u3068\u97f3\u58f0\u306e\u4e2d\u3067\u3001\u5f7c\u5973\u306f\u5f90\u3005\u306b\u9759\u307e\u308a\u8fd4\u3063\u3066\u3044\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u304c\u6025\u6d41\u304b\u3089\u5f15\u304d\u63da\u3052\u3089\u308c\u305f\u6642\u3001\u5f7c\u5973\u306f\u4e00\u4e1d\u4e5f\u7121\u304f\u88f8\u4f53\u3060\u3063\u305f\u3002"}
{"translation": "\u982d\u304b\u3089\u8db3\u307e\u3067\u3001\u8eab\u4f53\u4e2d\u304c\u50b7\u3060\u3089\u3051\u3060\u3002"}
{"translation": "\u305d\u308c\u306f\u77f3\u3068\u6fc0\u6d41\u304c\u3076\u3064\u304b\u3063\u305f\u7d50\u679c\u3060\u3002"}
{"translation": "\u5f7c\u5973\u3092\u52a9\u3051\u305f\u8005\u306f\u3001\u5f7c\u5973\u304c\u6c34\u306b\u6d78\u3051\u3089\u308c\u3066\u5168\u8eab\u304c\u767d\u304f\u306a\u308a\u3001\u9aea\u306e\u6bdb\u3060\u3051\u304c\u9ed2\u3044\u3068\u8a00\u3063\u305f\u3002"}
{"translation": "\u521d\u3081\u3066\u898b\u305f\u6642\u306f\u50b7\u53e3\u304c\u3069\u3053\u306b\u3042\u308b\u306e\u304b\u5206\u304b\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u6570\u4eba\u306e\u8ecd\u533b\u304c\u5076\u7136\u8fd1\u304f\u306e\u6751\u3067\u8a3a\u5bdf\u3092\u3057\u3066\u3044\u305f\u305f\u3081\u3001\u5f7c\u3089\u306f\u3059\u3050\u306b\u5f7c\u5973\u3092\u305d\u3053\u3078\u9023\u308c\u3066\u884c\u3063\u305f\u3002"}
{"translation": "\u6551\u6025\u51e6\u7f6e\u306e\u5f8c\u3001\u305d\u306e\u6570\u4eba\u306e\u533b\u5e2b\u305f\u3061\u306f\u5f7c\u5973\u3092\u7d20\u65e9\u304f\u75c5\u9662\u3078\u623b\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u75c5\u9662\u3067\u534a\u6708\u4ee5\u4e0a\u3082\u7d4c\u3063\u3066\u304b\u3089\u3084\u3063\u3068\u610f\u8b58\u3092\u53d6\u308a\u623b\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u304c\u610f\u8b58\u3092\u53d6\u308a\u623b\u3057\u3001\u4eba\u3005\u306e\u8cea\u554f\u306b\u7b54\u3048\u3088\u3046\u3068\u3057\u305f\u3068\u304d\u3001\u7a81\u7136\u5446\u7136\u3068\u3057\u3066\u3057\u307e\u3063\u305f\u3002"}
