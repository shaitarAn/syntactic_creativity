{"translation": "\u3059\u3079\u3066\u3092\u5fd8\u308c\u308b\u3053\u3068\u306f\u78ba\u304b\u306b\u8f9b\u3044\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u306a\u306b\u3082\u304b\u3082\u5fd8\u308c\u306a\u3044\u3053\u3068\u306e\u65b9\u304c\u3055\u3089\u306b\u60aa\u3044\u3002"}
{"translation": "\u306a\u305c\u306a\u3089\u3001\u3042\u3089\u3086\u308b\u77e5\u8b58\u306f\u307e\u305a\u5fd8\u5374\u306b\u3088\u3063\u3066\u751f\u307f\u51fa\u3055\u308c\u308b\u304b\u3089\u3060\u3002"}
{"translation": "\u5168\u3066\u304c\u533a\u5225\u7121\u304f\u4fdd\u5b58\u3055\u308c\u3066\u3044\u308b\u5834\u5408\u3001\u4f8b\u3048\u3070\u96fb\u529b\u3092\u6d88\u8cbb\u3059\u308b\u30c7\u30fc\u30bf\u30b9\u30c8\u30ec\u30fc\u30b8\u306e\u3088\u3046\u306a\u5834\u5408\u3001\u305d\u308c\u306f\u305d\u306e\u610f\u5473\u3092\u5931\u3044\u3001\u6574\u7406\u3055\u308c\u3066\u3044\u306a\u3044\u4f7f\u3048\u306a\u3044\u60c5\u5831\u306e\u96c6\u7a4d\u3068\u5316\u3059\u3002"}
{"translation": "\u3059\u3079\u3066\u3092\u4fdd\u5b58\u3059\u308b\u8a18\u61b6\u306f\u3001\u672c\u8cea\u7684\u306b\u4f55\u3082\u4fdd\u5b58\u3057\u306a\u3044\u3002"}
{"translation": "1980\u5e742\u67085\u65e5\u4ee5\u964d\u306e\u6bce\u65e5\u3092\u7279\u6b8a\u306a\u8a18\u61b6\u8853\u6280\u6cd5\u306a\u3057\u3067\u601d\u3044\u8d77\u3053\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u306e\u5973\u6027\u306f\u3001\u5f7c\u5973\u81ea\u8eab\u306b\u7d76\u3048\u305a\u5d29\u308c\u843d\u3061\u3066\u304f\u308b\u601d\u3044\u51fa\u306e\u30a8\u30b3\u30fc\u5ba4\u306b\u56da\u308f\u308c\u3066\u3044\u307e\u3059 - \u5f7c\u5973\u306f\u30a2\u30c3\u30c6\u30a3\u30ab\u5730\u65b9\u306e\u5c06\u8ecd\u30c6\u30df\u30b9\u30c8\u30af\u30ec\u30b9\u3068\u540c\u3058\u5b58\u5728\u3067\u3059,"}
{"translation": "\u5f7c\u306f\u6545\u90f7\u306e\u5e02\u6c11\u305d\u308c\u305e\u308c\u3092\u540d\u524d\u3067\u547c\u3073\u51fa\u305b\u305f\u4eba\u7269\u3067\u3001\u8a18\u61b6\u8853\u5e2b\u30b7\u30e2\u30cb\u30c7\u30b9\u306b\u5bfe\u3057\u3066\u306f\u3001\u300c\u5fd8\u308c\u308b\u82b8\u8853\u300d\u3092\u7fd2\u3046\u3053\u3068\u3092\u6c42\u3081\u305f\uff1a\u300c\u79c1\u304c\u899a\u3048\u3066\u304a\u304d\u305f\u304f\u306a\u3044\u3082\u306e\u307e\u3067\u3082\u304c\u79c1\u306e\u8a18\u61b6\u306b\u7559\u307e\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u79c1\u304c\u5fd8\u308c\u305f\u3044\u3082\u306e\u306f\u5fd8\u308c\u3089\u308c\u307e\u305b\u3093\u300d\u3002"}
{"translation": "\u3068\u3053\u308d\u304c\u3001\u5fd8\u5374\u306e\u6280\u6cd5\u3068\u3044\u3046\u3082\u306e\u306f\u4e0d\u53ef\u80fd\u306a\u5b58\u5728\u3067\u3059, \u306a\u305c\u306a\u3089\u3070\u5168\u3066\u306e\u7b26\u53f7\u305d\u306e\u90fd\u5ea6\u73fe\u5728\u5316\u3057\u793a\u3055\u3055\u308c\u308b\u304b\u3089\u3067\u3059, \u305d\u308c\u304c\u4e0d\u5728\u3092\u793a\u3057\u3066\u3044\u3088\u3046\u3068\u3082\u3002"}
{"translation": "\u30ed\u30fc\u30de\u5e1d\u56fd\u6642\u4ee3\u306b\u540d\u8a89\u6bc0\u640d\uff08damnatio memoriae\uff09\u304b\u3089\u9003\u4ea1\u3057\u305f\u8005\u9054\u3059\u3079\u3066\u304b\u3089\u8a00\u3048\u3070\uff0c\u5f7c\u7b49\u81ea\u8eab\u3092\u540d\u524d\u4ed8\u304d\u3067\u77e5\u308b\u3053\u3068\u304c\u3067\u304d\u308b\uff0c\u305d\u308c\u304c\u4e8b\u5178\u3060\u3002"}
{"translation": "\u81ea\u6c7a\u306f\u3001\u672a\u77e5\u306e\u672a\u6765\u306b\u5bfe\u3059\u308b\u52dd\u5229\u3092\u3082\u305f\u3089\u3059\u6700\u3082\u629c\u672c\u7684\u306a\u624b\u6bb5\u3068\u3057\u3066\u898b\u3048\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u304c\u3001\u305d\u308c\u306f\u751f\u547d\u306e\u77ed\u7e2e\u3068\u3044\u3046\u4ee3\u511f\u3092\u6255\u3063\u3066\u306e\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u304b\u3064\u3066\u30aa\u30fc\u30ac\u30b9\u30bf\u30b9\u304c\u30b5\u30e2\u30b9\u5cf6\u3067\u30a4\u30f3\u30c9\u306e\u4f7f\u7bc0\u56e3\u3092\u62db\u304d\u5165\u308c\u305f\u969b\u3001\u305d\u306e\u8d08\u308a\u7269\u306b\u306f\u305f\u3060\u4e00\u5339\u306e\u864e\u3084\u8155\u304c\u306a\u3044\u9752\u5e74\u304c\u3044\u3066\u3001\u5f7c\u306f\u81ea\u5206\u306e\u8db3\u3092\u624b\u307f\u305f\u3044\u306b\u4f7f\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u307e\u305f\u30d6\u30e9\u30fc\u30de\u30f3\u6559\u5f92\u5c64\u304b\u3089\u6765\u305f\u30b6\u30eb\u30de\u30ed\u30b9\u3068\u3044\u3046\u7537\u3082\u8d08\u3089\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u3053\u306e\u4eba\u7269\u306f\u5f7c\u81ea\u8eab\u3067\u306f\u307e\u3063\u305f\u304f\u4e88\u671f\u3057\u306a\u3044\u4f55\u4e8b\u304b\u304b\u3089\u9003\u907f\u3059\u308b\u76ee\u7684\u3067\u3001\u4eba\u751f\u305d\u306e\u901a\u308a\u9032\u884c\u3057\u3066\u51fa\u53e3\u3057\u304b\u306a\u304f\u601d\u3063\u6797\u7b11\u9854\u3067\u706b\u4e2d\u3078\u98db\u3073\u8fbc\u3080\u5148\u7acb\u3063\u3066\u88f8\u8eab\u306b\u6cb9\u5857\u3066\u7528\u3044\u3064\u3064\u30a2\u30c6\u30cd\u3067\u7121\u6b8b\u306a\u59ff\u3067\u713c\u304d\u3042\u304c\u3053\u308c\u4ee5\u4e0a\u671b\u3093\u3060\u6b7b\u5f8c\u884c\u65b9\u4e0d\u660e\u306b\u3057\u307e\u3057\u305f, \u305d\u3057\u3066\u5076\u7136\u308f\u305a\u304b\u3067\u3082\u73fe\u5728\u6c17\u4f9b\u3055\u308c\u308b, \u30ab\u30c3\u30b7\u30a6\u30b9\u30fb\u30c7\u30a3\u30aa\u30fc\u30ba\u66fe\u5802\u4e86\u5927\u30a8\u30a4\u30c6\u30a3\u4f59\u5b9a\u7406\u53f2\u8005\u8cc7\u6599\u5e33\u30e9\u30fc\u30de\u30f3\u5217\u4f1d\u8cc7\u6599\u8a18\u9332\u304b\u3089\u65b0\u3057\u304f\u73fe\u5b58\u3059\u308b\u30d1\u30fc\u30c8\u4ee5\u5916\u3053\u306e\u7279\u7570\u6027\u30a8\u30d4\u30bd\u30fc\u30c9\u305d\u306e\u5b58\u5728\u3092\u77e5\u308b\u3053\u3068\u305f\u304f\u308f\u304b\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u5b9f\u969b\u3001\u305d\u306e\u5f8c\u306b\u6b8b\u3063\u3066\u3044\u308b\u3082\u306e\u304c\u3001\u305f\u3060\u5358\u7d14\u306b\u751f\u304d\u6b8b\u3063\u3066\u3044\u308b\u3082\u306e\u3060\u3051\u3067\u3059\u3002"}
{"translation": "\u751f\u304d\u3066\u3044\u308b\u3068\u3044\u3046\u3053\u3068\u306f\u3001\u5931\u3046\u3053\u3068\u3092\u7d4c\u9a13\u3059\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u307e\u3059\u3002"}
{"translation": "\u300c\u3053\u308c\u304b\u3089\u3069\u3046\u306a\u308b\u306e\u304b\u300d\u3068\u3044\u3046\u554f\u3044\u306f\u3001\u304a\u305d\u3089\u304f\u4eba\u985e\u304c\u8a95\u751f\u3057\u3066\u4ee5\u6765\u306e\u53e4\u3044\u554f\u3044\u3067\u3042\u308a\u3001\u672a\u6765\u304c\u4e88\u6e2c\u4e0d\u80fd\u3067\u3042\u308b\u3068\u3044\u3046\u4e0d\u53ef\u907f\u304b\u3064\u4e0d\u5b89\u306a\u7279\u6027\u304c\u5b58\u5728\u3057\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u3086\u3048\u306b\u6b7b\u306e\u6642\u523b\u3084\u4e8b\u60c5\u3082\u95c7\u306b\u5305\u307e\u308c\u305f\u307e\u307e\u3067\u3059\u3002"}
{"translation": "\u3060\u308c\u3082\u304c\u7518\u82e6\u4e21\u9762\u306e\u5099\u3048\u82e6\u3092\u4f53\u9a13\u305b\u305a\u306b\u306f\u304a\u3089\u305a\u3001\u305d\u308c\u5373\u3061\u601d\u8003\u7684\u306b\u5148\u56de\u308a\u3059\u308b\u3053\u3068\u3067\u61f8\u5ff5\u3057\u305f\u4e8b\u8c61\u3092\u9632\u304e\u305f\u3044\u3068\u3044\u3046\u81f4\u547d\u7684\u306a\u885d\u52d5\u3067\u3059\u3002"}
{"translation": "\u4eba\u3005\u306f\u707d\u5bb3\u3092\u4e88\u77e5\u3057\u3001\u53ef\u80fd\u306a\u707d\u5384\u3092\u60f3\u50cf\u3057\u3001\u305d\u3046\u3057\u3066\u81ea\u5206\u81ea\u8eab\u3092\u60aa\u8cea\u306a\u9a5a\u304d\u304b\u3089\u9003\u308c\u3089\u308c\u308b\u3088\u3046\u306b\u601d\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u53e4\u4ee3\u3067\u306f\u5922\u304c\u6170\u3081\u306e\u7d04\u675f\u3092\u3059\u308b\u5834\u5408\u3082\u3042\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u30ae\u30ea\u30b7\u30e3\u4eba\u306f\u5922\u304b\u3089\u672a\u6765\u540c\u69d8\u30aa\u30e9\u30af\u30eb\uff08\u795e\u8a17\uff09\u304c\u73fe\u308c\u5730\u7344\\(\u30c0\u30a6\u30f3\\)\u3055\u308c\u88ab\u5bb3\u570f\u5916\u3060\u3063\u305f\u672a\u6765\u4e0d\u5be9\u8005\u65b9\u5411\\(\\)\u8972\u6483\u914d\u5e03\u3057\u3063\u304b\u308a\u8089\\x \\(\u6b20\u3051\u3066\\)\u305f\u3060\u671f\u5f85\u5f37\u304f\u8a00\u6613\u51e1(`"}
{"translation": "\u904e\u53bb\u3092\u4fdd\u5b58\u3057\u3001\u5fd8\u5374\u3092\u963b\u6b62\u3059\u308b\u6226\u7565\u306f\u591a\u69d8\u3067\u3059\u3002"}
{"translation": "\u4f1d\u627f\u306b\u4fe1\u3058\u308b\u306a\u3089\u3070\u3001\u6211\u3005\u306e\u6b74\u53f2\u8a18\u8ff0\u306e\u59cb\u307e\u308a\u306b\u306f\u30da\u30eb\u30b7\u30e3\u4eba\u3068\u30ae\u30ea\u30b7\u30e3\u4eba\u3068\u306e\u9593\u306e\u58ca\u6ec5\u7684\u306a\u6226\u4e89\u304c\u9023\u306a\u308a\u3001\u307b\u307c\u5fd8\u308c\u53bb\u3089\u308c\u305f\u8a18\u61b6\u8853\u306e\u59cb\u307e\u308a\u306b\u306f\u591a\u304f\u306e\u72a0\u7272\u8005\u3092\u51fa\u3057\u305f\u707d\u5bb3\u304c\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u306f\u7d00\u5143\u524d5\u4e16\u7d00\u521d\u982d\u3001\u30c6\u30c3\u30b5\u30ea\u30a2\u3067\u8d77\u3053\u3063\u305f\u4e8b\u4ef6\u3067\u3001\u5012\u58ca\u3057\u305f\u5bb6\u304c\u796d\u65e5\u306e\u96c6\u4f1a\u5168\u4f53\u3092\u62bc\u3057\u6f70\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u552f\u4e00\u751f\u304d\u6b8b\u3063\u305f\u8a69\u4eba\u30b7\u30e2\u30cb\u30c7\u30b9\u30fb\u30aa\u30d6\u30fb\u30b1\u30aa\u30b9\u306f\u8a13\u7df4\u3055\u308c\u305f\u8a18\u61b6\u529b\u304a\u9670\u3067\u7c89\u3005\u306b\u306a\u3063\u305f\u5efa\u7269\u306b\u5fc3\u7cbe\u795e\u7684\u518d\u5165\u9580\u4e8b\u304c\u53ef\u80fd\u6210\u3057\u3042\u3061\u7686\u3055\u3093\u3067\u306f\u5ba2\u5e2d\u914d\u5217\u56de\u60f3\u6b21\u7b2c\u7686\u3055\u3093\u907a\u9aa8\u7279\u5b9a\u51fa\u6765\u6848\u307e\u3057\u305f\u3002"}
{"translation": "\u6b7b\u3068\u751f\u3068\u3044\u3046\u4e8c\u5f8b\u80cc\u53cd\u3057\u3066\u3044\u308b\u3082\u306e\u304b\u4e2d\u5206\u5b50\u3057\u3054\u304f\u6570\u591a\u3044\u30d1\u30e9\u30c9\u30c3\u30af\u30b9\u306a\u4e2d\u4e00\u3064\u606f\u707d\u798d\u70ba\u3082\u30e4\u30c4\u6d88\u3048\u5931\u308f\u308c\u518d\u5ea6\u3053\u308c\u7269\u4e8b\u6d41\u884c\u8a00\u8449\u30e0\u76f4\u308b\u6642\u7136\u305d\u306e\u5f7c\u90e8\u54c1\u5931\u3046\u54c0\u679c\u500d\u65b9\u5411\u304b\u534a\u5206 \u65b9\u901a\u77e5\u3042\u308b\u6642\u6b4c\u821e\u5439\u5504\u305f\u65b9\u904e\u53bb\u898b\u5f53\u60bd\u5531\u7e01\u3042\u308b\u8005\u5bb6\u65cf\u6f14\u8272\u6050\u308d\u3057\u632f\u308a\u5922\u8272\u6df7\u5728\u6b64\u308c\u5e0c\u671b\u88ab\u8a31\u65ad\u3055\u308c\u5931\u308f\u308c\u3086\u304f\u3002"}
{"translation": "\u3053\u308c\u306f\u3001\u3082\u3068\u3081\u65e5\u5e38\u751f\u6d3b\u51e6\u7406\u59a8\u788d\u304a\u304d\u5374\u3002"}
{"translation": "\u6b7b\u306e\u7dda\u306f\u907a\u7523\u3068\u8a18\u61b6\u306e\u51fa\u767a\u70b9\u3067\u3042\u308a\u3001\u6b7b\u8005\u306e\u5606\u304d\u306f\u3001\u3059\u3079\u3066\u306e\u6587\u5316\u306e\u6e90\u6cc9\u3067\u3042\u308b\u3002"}
{"translation": "\u305d\u306e\u6587\u5316\u306b\u3088\u3063\u3066\u3001\u7a81\u7136\u306e\u6c88\u9ed9\u3068\u306a\u3063\u305f\u5e83\u304c\u3063\u305f\u7a7a\u6d1e\u3092\u3001\u6b4c\u3084\u7948\u308a\u3084\u7269\u8a9e\u3067\u57cb\u3081\u5c3d\u304f\u3057\u3001\u4e0d\u5728\u306e\u3082\u306e\u3092\u518d\u3073\u751f\u304d\u8fd4\u3089\u305b\u308b\u3002"}
{"translation": "\u55aa\u5931\u4f53\u9a13\u306f\u307e\u308b\u3067\u4e2d\u7a7a\u578b\u91d1\u578b\uff08\u30db\u30ed\u30fc\u30d5\u30a9\u30fc\u30e0\uff09\u304c\u547c\u3073\u7269\u3068\u306a\u3063\u305f\u8f2a\u90ed\u3092\u969b\u7acb\u305f\u305b\u3066\u898b\u305b\u307e\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u3057\u3070\u3057\u3070\u54c0\u60bc\u611f\u60c5Understanding the abstract in der Verkl\u00e4rung des Lichts of pain \u304c\u6b32\u671bobject \u306eobject \u306btransform\u3057\u307e\u3059\u3002"}
{"translation": "\u307e\u305f\u3001\u300c\u65b0\u30d6\u30ec\u30fc\u30e0\u56f3\u66f8\u9928\u300d\u30b7\u30ea\u30fc\u30ba\u3067\u306f\u30cf\u30a4\u30c7\u30eb\u30d9\u30eb\u30c8\u5927\u5b66\u53d6\u6750\u30d7\u30ed\u30d5\u30a7\u30c3\u30b5\u30fc\u306f\u4ee5\u4e0aZoologie \u6559Professor \u30d5\u30a9\u30a2\u30ef\u30fc\u30c9 fa profTheorban folktale \u4e00\u822c\u52a9\u5e73 aux livres\u4e00\u518a\u524d\u8ff0\u5982\u662f\uff1a\u7406\u6027\u7684\u306b\u5e7e\u6210\u529fclable\u3002"}
{"translation": "Eigenschaften des westlichen Menschen zu geh\u00f6ren, i\u3002e\u3002"}
{"translation": "\"Verlorenes h\u00f6her bewertet als noch Bestehendes\": andersrum merkw\u00fcrdige Faszination \u00fc \u043d erkl\u00e4rend erkl\u00e4nes Beutelwolf ausgeht\u3002"}
{"translation": "\u6b7b\u3068\u305d\u308c\u306b\u4f34\u3046\u554f\u984c\u3001\u3059\u306a\u308f\u3061\u4e00\u4eba\u306e\u4eba\u9593\u304c\u7a81\u7136\u4e0d\u5728\u306b\u306a\u308a\u3064\u3064\u540c\u6642\u306b\u305d\u306e\u907a\u7559\u54c1\u3001\u6b7b\u4f53\u304b\u3089\u6240\u6709\u8005\u4e0d\u660e\u306e\u8ca1\u7523\u307e\u3067\u304c\u5b58\u5728\u3059\u308b\u72b6\u6cc1\u306b\u3069\u3046\u5bfe\u51e6\u3059\u308b\u304b\u306f\u3001\u6642\u9593\u306e\u7d4c\u904e\u3068\u3068\u3082\u306b\u7b54\u3048\u3092\u6c42\u3081\u308b\u3053\u3068\u3092\u8feb\u3063\u3066\u884c\u52d5\u3092\u5f15\u304d\u8d77\u3053\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u610f\u7fa9\u306f\u5358\u306a\u308b\u76ee\u7684\u3060\u3051\u3067\u306f\u8db3\u308a\u305a\u3001\u79c1\u305f\u3061\u306e\u5148\u7956\u305f\u3061\u3092\u52d5\u7269\u7684\u9818\u57df\u304b\u3089\u4eba\u9593\u7684\u9818\u57df\u3078\u79fb\u884c\u3055\u305b\u307e\u3057\u305f\u3002"}
{"translation": "\u540c\u65cf\u306e\u4ea1\u9ab8\u3092\u305f\u3060\u81ea\u7136\u754c\u306e\u5206\u89e3\u904e\u7a0b\u306b\u4efb\u305b\u308b\u3060\u3051\u3067\u306a\u304f\u53d6\u308a\u6271\u3046\u3053\u3068\u304c\u4e00\u822c\u7684\u3060\u3068\u3055\u308c\u3066\u3044\u307e\u3059\u304c\u3001\u3053\u308c\u306f\u4eba\u9593\u7279\u6709\u306e\u7fd2\u6027\u3067\u3042\u308d\u3046\u3002"}
{"translation": "\u305d\u308c\u3067\u3082\u9ad8\u7b49\u52d5\u7269\u3067\u3082\u540c\u69d8\u306a\u632f\u308b\u821e\u3044\u304c\u89b3\u5bdf\u3055\u308c\u307e\u3059\uff1a\u305f\u3068\u3048\u3070\u8c61\u306f\u7015\u6b7b\u5185\u8535\u30e1\u30f3\u30d0\u30fc\u3082\u4e00\u304b\u6240\u96c6\u307e\u308a\u9577\u6642\u9593\u5f7c\u3089\u529b\u5f37\u304f\u89e6\u308c\u6642\u3005\u6012\u3063\u3066\u3044\u3066\u305d\u3057\u3066\u3088\u304f\u8a66\u307f\u5f7c\u3089\u518d\u5ea6\u7acb\u3068\u3046\u3066\u3053\u306e\u660f\u7761\u4f53\u3042\u3063\u3055\u308a\u68c4\u3066\u5730\u9762\u307e\u305f\u679d\u7a4d\u304a\u57ce\u307e\u3059\u5b66\u8005\u305f\u3061\u306f\u52e2\u529b\u4ea1\u9ab8\u8a2a\u554f\u5e38\u7f6e\u30c7\u5893\u5730\u4f55\u5e74-\u4ed6\u65b9\u6839\u6c17\u5fc5\u8981\u78ba\u304b\u601d\u8003\u91cd\u8981\u5b85\u79f0\u3069\u3093\u3069\u3093\u5927\u304d\u7406\u60f3\u5f62\u8c61\u6211\u3005\u3093\u904e\u3054\u3059\u8a31\u3057\u4e00\u7dd2\u4fe1\u3058\u304b\u308c\u308b\u65b9\u6cd5\u5c02\u6709\u4f7f\u7528\u91cf\u4e16\u306b\u79c1\u305f\u3061\u306e\u3082\u306e\u3068\u99ac\u9e7f\u3052\u3066\u304f\u3089\u3044\u304c\u307e\u3060\u3042\u308a\u3001\u305d\u3057\u3066\u540c\u69d8\u306b\u78ba\u8a8d\u3067\u304d\u307e\u305b\u3093\u3002"}
{"translation": "\u3053\u306e\u66f8\u7269\u306b\u304a\u3051\u308b\u4f5c\u696d\u304c\u3001\u5206\u89e3\u3068\u7834\u58ca\u306e\u591a\u69d8\u306a\u73fe\u8c61\u304c\u91cd\u8981\u306a\u5f79\u5272\u3092\u679c\u305f\u3059\u4e00\u65b9\u3067\u3001\u307b\u3068\u3093\u3069\u7d42\u4e86\u3057\u3066\u521d\u3081\u3066\u79c1\u306f\u6c17\u4ed8\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u6b7b\u3068\u5411\u304d\u5408\u3046\u7121\u6570\u306e\u65b9\u6cd5\u306e\u4e2d\u306e\u305f\u3060\u3072\u3068\u3064\u3067\u3042\u308a\u3001\u57fa\u672c\u7684\u306b\u306f\u30d8\u30ed\u30c9\u30c8\u30b9\u304c\u8a3c\u8a00\u3057\u305f\u30ab\u30e9\u30c6\u30a3\u65cf\u306e\u7fd2\u6163\u3067\u3042\u3063\u305f\u4ea1\u304f\u306a\u3063\u305f\u4e21\u89aa\u3092\u98df\u3079\u308b\u3053\u3068\u3001\u305d\u3057\u3066\u30ae\u30ea\u30b7\u30e3\u4eba\u304c\u81ea\u5206\u305f\u3061\u3092\u713c\u304f\u98a8\u4fd7\u3092\u805e\u3044\u3066\u6050\u6016\u306b\u6e80\u3061\u3066\u3044\u305f\u3053\u3068\u3088\u308a\u3082\u4e0d\u5668\u7528\u3084\u7121\u795e\u7d4c\u3067\u306f\u306a\u3044\u3001\u3068\u3044\u3046\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u5e38\u6642\u6b7b\u306b\u3064\u3044\u3066\u8003\u3048\u7d9a\u3051\u308b\u8005\u304c\u751f\u547d\u306b\u8fd1\u3044\u304b\u3001\u307e\u305f\u306f\u305d\u308c\u3092\u6291\u5236\u3059\u308b\u3053\u3068\u306b\u6210\u529f\u3059\u308b\u8005\u304c\u751f\u547d\u306b\u8fd1\u3044\u304b\u3069\u3046\u304b- \u305d\u308c\u3082\u300c\u3059\u3079\u3066\u304c\u7d42\u308f\u308b\u300d\u3068\u3044\u3046\u60f3\u50cf\u304b\u3089\u304f\u308b\u6050\u6016\u611f\u3084\u3001\u300c\u4f55\u3082\u7d42\u308f\u3089\u306a\u3044\u300d\u3068\u3044\u3046\u8003\u3048\u65b9\u540c\u69d8- \u4eba\u3005\u306e\u610f\u898b\u306f\u5927\u304d\u304f\u7570\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u3082\u3061\u308d\u3093\u3001\u305d\u308c\u4ee5\u524d\u306b\u3082\u4ed6\u306e\u6ce8\u76ee\u3059\u3079\u304d\u5893\u5730\u3092\u8a2a\u308c\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u4f8b\u3048\u3070\u3001\u30f4\u30a7\u30cd\u30c1\u30a2\u306e\u30e9\u30b0\u30fc\u30f3\u306e\u9752\u7dd1\u8272\u306e\u6c34\u304b\u3089\u9ad8\u3044\u8d64\u30ec\u30f3\u30ac\u58c1\u3067\u56f2\u307e\u308c\u305f\u6b7b\u8005\u5cf6\u30b5\u30f3\u30fb\u30df\u30b1\u30fc\u30ec\u304c\u76ee\u899a\u3081\u308b\u304b\u306e\u3088\u3046\u306b\u3001\u3042\u308b\u3044\u306f\u6bce\u5e74\u30e1\u30ad\u30b7\u30b3\u4eba\u4f4f\u6c11\u304c\u795d\u3046\u30c7\u30a3\u30a2\u30fb\u30c7\u30fb\u30ed\u30b9\u30fb\u30e0\u30a8\u30eb\u30c8\u30b9\uff08\u6b7b\u8005\u306e\u65e5\uff09\u306b\u306f\u3001\u30aa\u30ec\u30f3\u30b8\u8272\u3068\u9ec4\u8272\u304c\u98fe\u3089\u308c\u305f\u5893\u3068\u3001\u9032\u884c\u3057\u305f\u8150\u6557\u306b\u3088\u308a\u6c38\u9060\u306b\u7b11\u9854\u3092\u6d6e\u304b\u3079\u3066\u3044\u308b\u9bae\u3084\u304b\u306a\u8272\u3068\u7d19\u88fd\u7c98\u571f\u88fd\u306e\u982d\u84cb\u9aa8\u3067\u8cd1\u308f\u3063\u6070\u597d\u898b\u7269\u611f\u304c\u3042\u3075\u308c\u3066\u3044\u308b\u30cf\u30ea\u30a6\u30c3\u30c9\u30d5\u30a9\u30fc\u30a8\u30d0\u30fc\u30bb\u30e1\u30bf\u30ea\u30fc\u3002"}
{"translation": "\u3057\u304b\u3057\u305d\u3053\u3067\u5b9f\u73fe\u3057\u305f\u79c1\u304c\u8a8d\u8b58\u3059\u308b\u3053\u3068\u3060\u3051\u3067\u306f\u5de8\u5927\u306a\u7406\u60f3\u50cf \u2013"}
{"translation": "\u3064\u307e\u308a\u6b7b\u3092\u524d\u9762\u306b\u51fa\u3057\u3066\u751f\u304d\u308b\u2013\u305d\u306e\u8c61\u5fb4\u3067\u3057\u304b\u306a\u3044\u7279\u5225\u306a\u57fa\u790e\u8a2d\u8a08 -\u5186\u3068\u56db\u89d2\u5f62\u9593\u59a5\u5354\u70b9- \u306e\u672c\u8cea\u7684\u306a\u539f\u578b\u304b\u3089\u79c1\u3092\u63fa\u3055\u3076\u3063\u305f\u6f01\u6751\u306e\u5893\u5730\u4ee5\u4e0a\u306b\u5fc3\u6253\u3064\u54c0\u6101\u306f\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "\u79c1\u306f\u9577\u304f\u4fe1\u3058\u8fbc\u3093\u3067\u3044\u305f\u3053\u306e\u5834\u6240\u3067\u3001\u305d\u306e\u30c7\u30f3\u30de\u30fc\u30af\u8a9e\u306e\u540d\u524d\u304c\u300c\u5c0f\u3055\u306a\u5cf6\u300d\u3042\u308b\u3044\u306f\u300c\u6c34\u306b\u56f2\u307e\u308c\u3066\u300d\u3092\u610f\u5473\u3059\u308b\u3088\u3046\u306b\u3001\u751f\u547d\u3078\u306e\u89aa\u8fd1\u611f\u304c\u9ad8\u307e\u308b\u3002"}
{"translation": "\u307e\u3055\u306b\u4f4f\u4eba\u9054\u306f\u6587\u5b57\u901a\u308a\u6b7b\u8005\u3092\u5f7c\u3089\u306e\u4e2d\u592e\u306b\u9023\u308c\u3066\u304d\u305f\u304b\u3089\u3053\u305d\u3002"}
{"translation": "\u305d\u308c\u3067\u3082\u30a2\u30fc\u30d0\u30f3\u30b9\u30da\u30fc\u30b9\u304c\u5f80\u3005\u7121\u79e9\u5e8f\u7684\u306a\u62e1\u5927\u3067\u5893\u5730\u3092\u518d\u53d6\u5f97\u3057\u305f\u5f8c\u3067\u3055\u3048\u3001\u666e\u901a\u3067\u306f\u79c1\u9054\u306e\u6696\u304b\u3044\u5730\u65b9\u2500\u5171\u540c\u4f53\u81ea\u4f53\u304b\u3089\u5e02\u9580\u5916\u3078\u8ffd\u653e\u3055\u308c\u308b\u6700\u3082\u5185\u5074\u304b\u3089\u3002"}
{"translation": "\u6570\u5e74\u524d\u306e\u3042\u308b8\u6708\u306e\u65e5\u3001\u79c1\u306f\u5317\u90e8\u306e\u753a\u3092\u8a2a\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u753a\u306f\u6d77\u5ce1\u304c\u6700\u5f8c\u306b\u5e83\u304c\u3063\u3066\u3044\u308b\u6240\u306b\u3042\u308a\u3001\u6c37\u6cb3\u671f\u304b\u3089\u9061\u3063\u3066\u5730\u65b9\u5168\u4f53\u306b\u53ca\u3076\u6d77\u6e7e\u3067\u3001\u305d\u306e\u6c7d\u6c34\u3067\u306f\u6625\u306b\u306f\u30cb\u30b7\u30f3\u3001\u590f\u306b\u306f\u30a6\u30ca\u30ae\u3001\u79cb\u306b\u306f\u30bf\u30e9\u3001\u51ac\u306b\u306f\u30b3\u30a4\u3084\u30d1\u30a4\u30af\u3084\u30d6\u30ea\u30fc\u30e0\u306a\u3069\u304c\u898b\u3089\u308c\u307e\u3059\u3002"}
{"translation": "\u3053\u306e\u305f\u3081\u3053\u3053\u3067\u306f\u6f01\u5e2b\u3068\u3057\u3066\u751f\u696d\u3092\u7acb\u3066\u3066\u3044\u308b\u4eba\u3005\u3082\u3044\u307e\u3060\u5b58\u5728\u3057\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u3089\u306e\u7537\u305f\u3061\u306f\u5bb6\u65cf\u3068\u5171\u306b\u4f55\u4e16\u7d00\u3082\u7f8e\u3057\u3044\u5730\u533a\u3092\u4f4f\u307e\u308f\u305b\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u3089\u5730\u533a\u306f\u77f3\u7573\u306e\u9053\u8def\u304c\u4e8c\u672c\u3042\u308a\u3001\u6f01\u7db2\u7528\u306e\u4e7e\u71e5\u5834\u6240\u3068\u4fee\u9053\u9662\u65bd\u8a2d\uff08\u73fe\u5728\u3067\u306f2\u4eba\u5e74\u914d\u8cb4\u65cf\u5973\u6027\u3057\u304b\u4f4f\u3093\u3067\u304a\u3089\u305a\uff09\u3057\u304b\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u4e00\u8a00\u3067\u8a00\u3048\u3070\u6642\u4ee3\u304b\u3089\u53d6\u308a\u6b8b\u3055\u308c\u305f\u3088\u3046\u306a\u5834\u6240\u3067\u3059\uff0c\u904e\u53bb\u3092\u8607\u3048\u3089\u305b\u308b\u8a66\u307f\u304c\u985e\u63a8\u7684\u3067\u3082\u9b54\u6cd5\u7684\u3067\u3082\u306a\u304f\uff0c\u751f\u304d\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u79c1\u304c\u7279\u5225\u601d\u3044\u51fa\u3057\u3066\u3044\u308b\u4e8b\u67c4\u3068\u3044\u3046\u3082\u306e\u3067\u3059\u3002"}
{"translation": "\u30ed\u30fc\u30ba\u30fb\u30b9\u30c8\u30c3\u30af\u3084\u9ad8\u304f\u6574\u3063\u305f\u30de\u30eb\u30d0\u30b9\u3058\u3083\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u3055\u3055\u3084\u304b\u3060\u3051\u3069\u30ab\u30eb\u30ad\u5165\u9798\u3057\u305f\u5bb6\u3005\u524d\u65b9 \u3002 \u3084\u5f69\u8272\u3055\u308c\u6728\u88fd\u30c9\u30a2\u3064\u306a\u304c\u308a\u3082\uff0c\u5efa\u7269\u306e\u9593\u3067\u76f4\u63a5\u77f3\u306e\u6d77\u5cb8\u3078\u901a\u3058\u308b\u7d30\u3044\u901a\u8def\u3067\u3082\u7121\u304f \uff0c\u79c1\u306f\u305d\u3053\u3067\u306f\u4ea4\u6613\u6240\u3068\u306a\u308b\u3079\u304d\u3060\u3063\u305f\u5834\u6240\u306b\u5893\u5730\u3092\u898b\u3064\u3051\u3066\u3057\u307e\u3063\u305f\u3053\u3068\u3002"}
{"translation": "\u590f\u306e\u65b0\u7dd1\u3067\u8986\u308f\u308c\u3001\u92f3\u9244\u88fd\u306e\u30d5\u30a7\u30f3\u30b9\u3067\u56f2\u307e\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3059\u306a\u308f\u3061\u3001\u4e00\u822c\u7684\u306b\u5546\u54c1\u304c\u73fe\u91d1\u3068\u4ea4\u63db\u3055\u308c\u308b\u305d\u306e\u5834\u6240\u3067\u3001\u6b7b\u8005\u304c\u5730\u4e0b\u3067\u3082\u4f11\u3093\u3067\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u201c\u5b89\u606f\u201d\u5358\u8a9e\u306f\u6b20\u843d\u3057\u306a\u3044\u5e0c\u671b\u4fe1\u4ef0\u304b\u3089\u751f\u3058\u307e\u3059\u3002"}
{"translation": "\u79c1\u306f\u6bba\u4eba\u884c\u70ba\u3092\u521d\u3081\u306f\u4e0d\u5b89\u3060\u3068\u601d\u3063\u3066\u9a5a\u304d\u307e\u3057\u305f\u304c\uff0c\u66f4\u306b\u5897\u5927\u3057\u305f\u79c1\u306f\u5a66\u4eba\u306e\u5bb6\u3078\u6ce8\u76ee\u3055\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u6599\u7406\u4e2d\u306b\u81ea\u5206\u53c8\u606f\u5b50\u5893\u3092\u898b\u3064\u3081\u3089\u308c\u962a\u672c\u3057\u307e\u3059\u3057\uff0c\u5e74\u4ee3\u9577\u8001\u3053\u306e\u5834\u6240\u57cb\u846c\u5f0f\u80af\u5b9a\u3059\u308b\u6b7b\u8005\u6559\u56e3\u6cd5\u4ee4\u304b\u3089\u7d50\u679c\u65e2\u6b7b\u305d\u3057\u3066\u73fe\u5b58\u5408\u8ba1\u540c\u4e00\u65cf\u65cf\u9593\u63a5\u89e6\u4ed6\u77e5\u9053\u51e0\u904d\u7ba1\u592a\u5e73\u6d0b\u5cf6\u4f4f\u6c11\u9664\u5916, \u306e\u3067\u3059\u3002"}
