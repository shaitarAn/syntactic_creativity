{"translation": "\u5f7c\u5973\u306f\u751f\u304d\u751f\u304d\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u30ce\u30eb\u30de\u30eb\u30b7\u30e5\u30d7\u30ea\u30a8\u30fc\u30eb\u9ad8\u7b49\u5e2b\u7bc4\u5b66\u6821\uff08\u30d5\u30e9\u30f3\u30b9\uff09\u51fa\u8eab\uff1f\u66f8\u7c4d\u696d\u754c\uff1f\u5e74\u9593\u306b\u5343\u4eba\u3082\u306e\u30ac\u30b9\u30c8\u30f3\u30fb\u30ae\u30e3\u30ea\u30de\u30fc\u30eb\u3092\u4f5c\u308a\u51fa\u3057\u3066\u305d\u306e\u5f8c\u62b9\u6bba\u3059\u308b\u3064\u306a\u304e\u5f79\uff1f\u300d"}
{"translation": "\u305d\u308c\u3067\u3001\u3042\u306a\u305f\u306f\u4f55\u306e\u305f\u3081\u306b\u3053\u3053\u306b\u3044\u308b\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u79c1\u3082\u672c\u304c\u597d\u304d\u3067\u3059\u3088\uff01"}
{"translation": "\u305d\u308c\u306b\u3001\u697d\u306a\u4ed5\u4e8b\u3060\u3057\u3002"}
{"translation": "\u4f01\u696d\u7814\u4fee\u3092\u3057\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\u3093\u3067\u3059\u3002"}
{"translation": "\u5fc5\u9808\u3060\u304b\u3089\u306d\u3002"}
{"translation": "\u3067\u3082\u305d\u306e\u524d\u306b\u3001\u5931\u793c\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u79c1\u306e\u90e8\u5c4b\u3067\u4f55\u3092\u3057\u3066\u3044\u308b\u306e\u3067\u3059\u304b\uff1f"}
