{"translation": "\u5c0f\u3055\u306a\u624b\u306e\u4eba\u306b\u9055\u3044\u306a\u3044\u3002"}
{"translation": "\u3069\u3046\u305e\u5165\u3063\u3066\u3002"}
{"translation": "\u5f7c\u5973\u304c\u5165\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u79c1\u306f\u5f7c\u5973\u3092\u898b\u305f\u3053\u3068\u304c\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u5927\u6614\u3001\u4f1a\u793e\u304c\u307e\u3060\u5c0f\u3055\u3044\u9803\u3001\u5eca\u4e0b\u3067\u307f\u3093\u306a\u306e\u3075\u304f\u3089\u306f\u304e\u304b\u3089\u9854\u3092\u8a8d\u8b58\u3067\u304d\u305f\u65e5\u3005\u3092\u61d0\u304b\u3057\u304f\u601d\u3046\u6c17\u6301\u3061\u304c\u6e67\u304d\u4e0a\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u771f\u9762\u76ee\u305d\u3046\u3060\u3063\u305f\u3002"}
