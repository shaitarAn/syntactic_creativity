{"translation": "\u3088\u304f\u77e5\u3063\u3066\u308b\u3088\u3002"}
{"translation": "\u3044\u3048\u3001\u6587\u5316\u4e8b\u696d\u306e\u7ba1\u7406\u3067\u3059\u3002"}
{"translation": "\u672c\u5f53\u306b\uff1f\u305d\u3057\u3066\u3001\u3042\u306a\u305f\u306f\u51fa\u7248\u3092\u7ba1\u7406\u3057\u305f\u3044\u3068\u601d\u3063\u3066\u3044\u307e\u3059\u304b\uff1f"}
{"translation": "\u305d\u308c\u306a\u3089\u3070\u5e78\u904b\u3092\u7948\u308a\u307e\u3059\u3002"}
{"translation": "\u79c1\u306f\u30b3\u30f3\u30b5\u30fc\u30c8\u3092\u4f01\u753b\u3059\u308b\u65b9\u304c\u826f\u3044\u3068\u601d\u3044\u307e\u3059\u3002"}
{"translation": "\u5e2d\u306b\u5ea7\u3063\u3066\u304f\u3060\u3055\u3044\u3002"}
