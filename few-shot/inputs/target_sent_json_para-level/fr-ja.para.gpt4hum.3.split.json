{"translation": "\u79c1\u306e\u982c\u306e\u4e0b\u306b\u3042\u308b\u306e\u306f\u604b\u611b\u5c0f\u8aac\u3067\u3059\uff1a\u305d\u308c\u306f\u65e2\u5a5a\u8005\u3067\u3042\u308b\u7537\u304c\u5973\u6027\u3068\u51fa\u4f1a\u3046\u8a71\u3067\u3001\u5f7c\u5973\u306b\u306f\u3059\u3067\u306b\u5f7c\u6c0f\u304c\u3044\u307e\u3059\u3002"}
{"translation": "\u79c1\u306f\u305d\u308c\u30927\u30da\u30fc\u30b8\u3060\u3051\u8aad\u307f\u307e\u3057\u305f\u304c\u3001\u3059\u3067\u306b\u5168\u3066\u899a\u3048\u3066\u3057\u307e\u3063\u305f\u3002"}
{"translation": "\u3082\u3046\u4f55\u3082\u610f\u5916\u306a\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u9577\u3044\u9593\u3001\u79c1\u306f\u65b0\u3057\u3044\u672c\u3092\u8aad\u3080\u3053\u3068\u306a\u304f\u3001\u540c\u3058\u672c\u3070\u304b\u308a\u3092\u8aad\u307f\u8fd4\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u300c\u65b0\u520a\u300d\u3001\u300c\u5b63\u7bc0\u300d\u3001\u300c\u6587\u5b66\u754c\u306e\u8a71\u984c\u300d\u3001\u300c\u30d9\u30b9\u30c8\u30bb\u30e9\u30fc\u300d\u300c\u5931\u6557\u4f5c\u300d\u30fb\u30fb\u30fb\u305d\u3057\u3066\u307e\u305f\u5931\u6557\u4f5c\u3002\u3053\u308c\u3089\u5168\u3066\u304b\u3089\u62bd\u8c61\u5316\u3055\u308c\u305f\u53e4\u81ed\u3044\u5185\u5bb9\u3057\u304b\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u300c\u30ea\u30b5\u30a4\u30af\u30eb\u30fb\u30da\u30fc\u30d1\u30fc\u300d\u3001\u671d\u4e00\u756a\u306b\u5009\u5eab\u3092\u51fa\u767a\u3057\u305f\u30c8\u30e9\u30c3\u30af\u304c\u5915\u65b9\u306b\u306a\u3063\u3066\u300c\u65b0\u5546\u54c1\u300d\u3068\u5171\u306b\u5009\u5eab\u3078\u623b\u308b\u3002\u3002\u3002\u305d\u306e\u5546\u54c1\u9054\u3082\u3059\u3050\u6614\u7269\u3068\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u4f55\u5e74\u3082\u524d\u304b\u3089\u3001\u79c1\u304c\u5091\u4f5c\u3092\u767a\u898b\u3059\u308b\u3053\u3068\u306b\u559c\u3073\u3092\u565b\u307f\u3057\u3081\u3001\u6708\u66dc\u65e5\u306b\u306f\u65b0\u305f\u306a\u4eba\u9593\u3068\u3057\u3066\u30aa\u30d5\u30a3\u30b9\u306b\u623b\u308b\u3053\u3068\u3092\u6b62\u3081\u305f\u306e\u3060\u308d\u3046\u304b\uff1f"}
{"translation": "20\u5e74\u524d\uff1f30\u5e74\u524d\uff1f\u79c1\u306f\u305d\u306e\u3088\u3046\u306a\u6b7b\u3092\u4e88\u611f\u3055\u305b\u308b\u8a08\u7b97\u3092\u6301\u3064\u3053\u3068\u304c\u597d\u304d\u3067\u306f\u306a\u3044\u3002"}
{"translation": "\u76ee\u3092\u9589\u3058\u308c\u3070\u3001\u307e\u3076\u305f\u8d8a\u3057\u306b\u4e00\u69d8\u306b\u9ec4\u8272\u304f\u5149\u308b\u30d1\u30fc\u30bc\u30eb\u306e\u30e9\u30f3\u30d7\u306e\u5149\u304c\u898b\u3048\u308b\u3002"}
{"translation": "\u305d\u3057\u3066\u9ed2\u3044\u5f71\u5f62\u304c\u305d\u306e\u4e2d\u3078\u4fb5\u5165\u3057\u3001\u79fb\u308a\u5909\u308f\u308b\u5ec3\u589f\u3084\u30f4\u30a3\u30af\u30c8\u30fc\u30eb\u30fb\u30e6\u30fc\u30b4\u30fc\u306e\u7d75\u67c4\u30da\u30f3\u753b\u5f62\u6210\u3059\u308b\u3002"}
{"translation": "\u606f\u306f\u3086\u3063\u304f\u308a\u3068\u306a\u308a\u3001\u5fc3\u81d3\u306e\u9f13\u52d5\u3082\u5c11\u3057\u3060\u3051\u843d\u3061\u7740\u304f\u3002"}
