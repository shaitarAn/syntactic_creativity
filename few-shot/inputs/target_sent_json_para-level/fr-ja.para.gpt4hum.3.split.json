{"translation": "\u5bb6\u5168\u4f53\u304c\u53e4\u3044\u7d19\u306e\u9759\u5bc2\u306b\u5305\u307e\u308c\u3066\u3044\u308b\u3002"}
{"translation": "\u96ea\u306e\u3088\u3046\u306b\u3001\u672c\u306f\u97f3\u3092\u98f2\u307f\u8fbc\u3080\u3002"}
{"translation": "\u79c1\u306e\u4ed5\u4e8b\u306f\u305d\u306e\u9999\u308a\u3068\u7a92\u606f\u611f\u3092\u6301\u3063\u3066\u3044\u308b\u3002"}
