{"translation": "\u3082\u3046\u9045\u3044\u6642\u9593\u3067\u3059\u306d\u3002"}
{"translation": "\u4e94\u5206\u3060\u3051\u3067\u3057\u3087\u3046\u304b\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u30b3\u30f3\u30b5\u30fc\u30c8\u306e\u4f01\u753b\u3092\u3057\u305f\u304c\u308b\u306e\u3067\u3059\u306d\uff1f"}
{"translation": "\u305d\u3046\u3067\u3059\u3001\u97f3\u697d\u304c\u826f\u3044\u3093\u3067\u3059\u3088\u306d\u3002"}
{"translation": "\u9577\u3044\u9593\u3001\u79c1\u306f\u6c17\u6674\u3089\u3057\u3084\u5c11\u3057\u306e\u9ad8\u63da\u611f\u3001\u8133\u3078\u306e\u8840\u6d41\u3092\u5897\u3084\u3059\u305f\u3081\u306b\u8db3\u3092\u7d44\u3093\u3067\u3053\u308c\u306b\u5ea7\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u4eca\u3067\u306f\u3001\u7279\u306b\u591c\u3001\u7279\u306b\u91d1\u66dc\u306e\u591c\u306b\u306f\u982d\u3092\u7f6e\u304f\u3053\u3068\u304c\u307e\u3059\u307e\u3059\u591a\u304f\u306a\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u79c1\u306f\u958b\u304b\u308c\u305f\u539f\u7a3f\u306e\u4e0a\u306b\u8155\u3092\u7d44\u307f\u3001\u305d\u306e\u4e0a\u306b\u982d\u3092\u7f6e\u304d\u307e\u3059\u3002"}
{"translation": "\u524d\u8155\u304c\u984d\u304b\u3089\u7a81\u304d\u51fa\u3066\u3044\u3066\u3001\u65b0\u9bae\u306a\u6587\u7ae0\u304c\u982c\u3068\u63a5\u89e6\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u30c7\u30b9\u30af\u306e\u6728\u6750\u304c\u5fc3\u81d3\u306e\u9f13\u52d5\u3092\u5897\u5e45\u3057\u307e\u3059\u3002"}
{"translation": "\u30a2\u30fc\u30eb\u30c7\u30b3\u8abf\u306e\u53e4\u3044\u5bb6\u5177\u304c\u611f\u60c5\u3068\u75b2\u52b4\u3092\u3088\u304f\u4f1d\u3048\u3066\u304f\u308c\u307e\u3059\u306d\uff1f \u30eb\u30fc\u30eb\u30de\u30f3\uff1f \u30ec\u30eb\u30fc\uff1f \u5f7c\u306f\u8272\u3005\u898b\u3066\u304d\u305f\u3053\u3068\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u79c1\u306f\u81ea\u5206\u306e\u5fc3\u81d3\u97f3\u3092\u8074\u304d\u5165\u308a\u307e\u3059\u3002"}
{"translation": "\u91d1\u66dc\u65e5\u7528\u8001\u6210\u3057\u305f\u5fc3\u81d3\u97f3\u3067\u3059, \u305d\u308c\u4ee5\u5916\u5bb6\u4e2d\u9759\u307e\u308a\u8fd4\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u306e\u6642\u523b\u3067\u306f\u3082\u3046\u8ab0\u3078\u3082\u3044\u307e\u305b\u3093\u304b\u3089 , \u79c1\u3060\u3051\u8239\u5185\u3067\u7559\u307e\u308b, \u4e0b\u6c34\u4ee5\u5f8c\u305f\u3060\u3061\u56e0\u307f\u4e8c\u5ea6\u3068\u3059\u308b\u52c7\u6c17\u64cd\u3068\u3046\u9031\u672b\u6301\u53c2\u6b69\u884c \u5343\u5c0b \u5de5\u5834\u4efb\u52d9\u6301\u53c2\u6b69\u884c\u6240\u8981\u539f\u7a3f\u5854\u3002"}
{"translation": "\u305d\u308c\u3069\u3053\u308d\u304b\u6bce\u9031\u672b\u3002"}
{"translation": "\u305d\u308c\u306a\u3089\u3054\u627f\u77e5\u3060\u3002"}
{"translation": "\u3053\u308c\u3092\u6e21\u3059\u3088\u3046\u306b\u3068\u5f7c\u304b\u3089\u8a00\u308f\u308c\u305f\u3093\u3067\u3059\u3002"}
{"translation": "\u3053\u308c\u4f55\u304b\u3063\u3066\uff1f"}
{"translation": "\u307e\u3042\u3001\u96fb\u5b50\u30d6\u30c3\u30af\u30ea\u30fc\u30c0\u30fc\u3001eBook\u3001iPad\u3001\u4f55\u3060\u304b\u79c1\u306b\u3082\u3088\u304f\u5206\u304b\u3089\u306a\u3044\u3067\u3059\u3051\u3069\u306d\u3002"}
{"translation": "\u9031\u672b\u306e\u9593\u306b\u3042\u306a\u305f\u304c\u5fc5\u8981\u3068\u3059\u308b\u5168\u3066\u306e\u539f\u7a3f\u3092\u3053\u308c\u306b\u5165\u308c\u305f\u3068\u8a00\u3063\u3066\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u3067\u8eab\u4f53\u7684\u8ca0\u62c5\u3082\u5c11\u306a\u304f\u3066\u3059\u3080\u3067\u3057\u3087\u3046\u3063\u3066\u3002"}
{"translation": "\u8aac\u660e\u3057\u307e\u3059\u304b\uff1f"}
{"translation": "\u898b\u3066\u304f\u3060\u3055\u3044\u3001\u30b9\u30af\u30ea\u30fc\u30f3\u4e0a\u3067\u5168\u3066\u306e\u539f\u7a3f\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002"}
{"translation": "\u507d\u7269\u306e\u6728\u88fd\u672c\u68da\u307f\u305f\u3044\u306a\u4eee\u60f3\u30d5\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u4e0a\u3067\u3059\u306d\u3002"}
{"translation": "\u30bf\u30c3\u30c1\u3059\u308b\u3053\u3068\u3067\u958b\u3051\u3089\u308c\u307e\u3059\u306d \u4e00\u676f\u3042\u308a\u307e\u3059\u3088\uff0c\u304d\u3063\u3068\u4e8c\u65e5\u9593\u3067\u306f\u8aad\u307f\u7d42\u3048\u308b\u3053\u3068\u306f\u7121\u7406\u3060\u308d\u3046\uff01\u898b\u3066\u304f\u3060\u3055\u3044\uff0c\u30c6\u30ad\u30b9\u30c8\u306f\u958b\u304d\u307e\u3059\u3088\u3002"}
