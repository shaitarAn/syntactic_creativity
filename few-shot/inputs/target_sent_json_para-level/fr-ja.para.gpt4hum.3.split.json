{"translation": "\u9a12\u304c\u3057\u3044\u4e16\u754c\u306b\u623b\u308b\u3053\u3068\u306f\u5e38\u306b\u8a66\u7df4\u3067\u3042\u308b\u3002"}
{"translation": "\u8ab0\u304c\u30ce\u30c3\u30af\u3057\u3066\u308b\u3093\u3060\u308d\u3046\uff1f"}
