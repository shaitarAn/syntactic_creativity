{"translation": "\u305a\u3063\u3068\u305a\u3063\u3068\u5f8c\u306e\u3042\u308b\u65e5\u3001\u5f7c\u5973\u306e\u592b\u304c\u75c5\u9662\u304b\u3089\u5e30\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u5f7c\u306f\u771f\u5263\u306a\u8868\u60c5\u3067\u3001\u300c\u6587\u5316\u5927\u9769\u547d\u300d\u304c\u59cb\u307e\u308a\u3001\u75c5\u9662\u3067\u306f\u6bce\u65e5\u30df\u30fc\u30c6\u30a3\u30f3\u30b0\u304c\u958b\u304b\u308c\u3001\u81ea\u5206\u306b\u3064\u3044\u3066\u3082\u5927\u6587\u5b57\u5831\u544a\u66f8\u3092\u66f8\u3044\u305f\u4eba\u3082\u3044\u308b\u3068\u8a00\u3046\u3002"}
{"translation": "\u904e\u53bb\u306b\u554f\u984c\u304c\u3042\u308b\u3068\u6279\u5224\u3055\u308c\u3066\u3044\u308b\u305d\u3046\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306f\u975e\u5e38\u306b\u5fc3\u914d\u3067\u3001\u592b\u304c\u3053\u3046\u3044\u3046\u8a71\u3092\u3059\u308b\u610f\u5473\u304c\u308f\u304b\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u7a81\u7136\u592b\u306f\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u4f55\u3082\u5fc3\u914d\u3059\u308b\u3053\u3068\u306f\u306a\u3044\u3088\u3001\u79c1\u304c\u541b\u3092\u5b88\u308b\u304b\u3089\u3055\u3002"}
{"translation": "\u904e\u53bb\u306e\u3053\u3068\u306f\u4e00\u751f\u601d\u3044\u51fa\u3055\u306a\u304f\u3066\u826f\u3057\u3067\u3059\u3002"}
{"translation": "\u6700\u5927\u306e\u6575\u4eba\u306f\u5916\u90e8\u306b\u5b58\u5728\u3057\u3066\u304a\u3089\u308c\u307e\u3059"}
{"translation": "\u4eba\u3005\u3067\u306f\u7121\u304f\u3001\u3080\u3057\u308d\u3042\u306a\u305f\u81ea\u8eab\u8a8d\u8b58\u3057\u3066\u308c\u305b\u3093\u7269\u4e8b\u3067\u3059\u308f\u3002\u3002"}
{"translation": "\u8ab0\u304b\u304c\u805e\u3044\u3066\u304d\u3066\u3082\u3001\u300c\u4f55\u3082\u77e5\u3089\u306a\u3044\u300d\u3068\u7b54\u3048\u308c\u3070\u305d\u308c\u3067\u826f\u3057\u3067\u3059 \u300d"}
{"translation": "\u3042\u306a\u305f\u306f\u3069\u3053\u51fa\u8eab\u3067\u3059\u304b\uff1f \u3069\u306e\u6751\u306b\u4f4f\u3093\u3067\u3044\u307e\u3059\u304b\uff1f"}
{"translation": "\u5e74\u9f62\u306f\u3044\u304f\u3064\u3067\u3059\u304b\uff1f \u3042\u306a\u305f\u306e\u5bb6\u65cf\u306b\u306f\u8ab0\u304c\u3044\u307e\u3059\u304b\uff1f \u3069\u3046\u3084\u3063\u3066\u5ddd\u306b\u843d\u3061\u307e\u3057\u305f\u304b\uff1f \u8239\u304c\u8ee2\u8986\u3057\u305f\u306e\u3067\u3059\u304b\u3001\u305d\u308c\u3068\u3082\u60aa\u3044\u4eba\u304c\u3042\u306a\u305f\u3092\u6295\u3052\u6368\u3066\u307e\u3057\u305f\u304b\uff1f"}
{"translation": "\u8ab0\u3082\u4ed6\u306b\u6c34\u6ca1\u3057\u3066\u3044\u307e\u305b\u3093\u3067\u3057\u305f\u3088\u306d?"}
{"translation": "\u4eba\u3005\u304c\u4ea4\u4e92\u306b\u8cea\u554f\u3057\u3001\u58f0\u8272\u3054\u3068\u304d\u89aa\u5207\u3055\u3067\u3082\u92ed\u3044\u68d8\u3068\u3057\u3066\u5fc3\u3092\u7a81\u304d\u523a\u3059\u3088\u3046\u3060\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u5fc3\u81d3\u306f\u77ac\u6642\u306b\u6fc0\u75db\u3067\u8972\u308f\u308c\u3001\u30d9\u30c3\u30c9\u4e0a\u3067\u4e38\u304f\u306a\u3063\u305f\u3002"}
{"translation": "\u305d\u3046\u3060\u3001\u79c1\u306f\u4e00\u4f53\u4f55\u8005\u306a\u306e\u3060\u308d\u3046\uff1f\u300d"}
{"translation": "\u79c1\u306f\u4e00\u4f53\u3069\u3053\u304b\u3089\u6765\u305f\u306e\u3060\u308d\u3046\uff1f\u300d"}
{"translation": "\u79c1\u9054\u5bb6\u65cf\u540d\u524d\u306f\u4f55\u3060\u308d\u3046\uff1f\u201d\u79c1\u304c\u5982\u4f55\u3057\u3066\u5ddd\u3078\u843d\u3061\u8fbc\u3080\u4e8b\u9053\u306a\u308b\u3093\u3060?\u201d\u5f7c\u5973\u5168\u7136\u5370\u8c61\u7121\u3057\u3002"}
{"translation": "\u201c\u4e3a\u4ec0\u4e48\u6211\u4f1a\u8bb0\u4e0d\u4f4f\u5462\uff1f\u201d\u3001\u201c\u81ea\u5206\u307e\u3067\u3082\u5fd8\u308c\u3066\u3057\u307e\u3063\u305f\u7406\u7531\u3063\u3066\u4f55\uff1f\u201d\u305d\u306e\u5f8c\u6ce3\u304d\u3058\u3083\u304f\u308b\u3002"}
{"translation": "\u201d\u79c1\u5206\u304b\u3089\u306a\u3044\u201d\u8a00\u3063\u3066\u4ed6\u5974\u8bf4\u6301\u59cb\u672b\u3002"}
{"translation": "\u5f7c\u5973\u306f\u672c\u5f53\u306b\u899a\u3048\u3066\u3044\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u304b\u3089\u3001\u4eba\u3005\u304c\u8a00\u3044\u307e\u3059\u3001\u300c\u601d\u3044\u51fa\u3057\u3066\u304f\u3060\u3055\u3044\u3001\u3057\u3063\u304b\u308a\u3068\u601d\u3044\u51fa\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u5ddd\u304b\u3089\u52a9\u3051\u3089\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u5ddd\u306e\u3053\u3068\u304b\u3089\u8003\u3048\u59cb\u3081\u308b\u3068\u3001\u4f55\u304b\u3092\u601d\u3044\u51fa\u305b\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u300d\u306b\u5f93\u3063\u3066\u5f7c\u5973\u306f\u771f\u5263\u306b\u8a18\u61b6\u3092\u63a2\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u5f7c\u5973\u306e\u8a18\u61b6\u304c\u5ddd\u8fba\u306b\u9054\u3059\u308b\u3068\u3001\u305d\u306e\u6ce1\u7acb\u3064\u6c34\u97f3\u304c\u7a81\u5982\u96f7\u9cf4\u306e\u3088\u3046\u306b\u8f5f\u304f\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u540d\u524d\u306e\u77e5\u308c\u306c\u6050\u6016\u611f\u304c\u7a81\u7136\u6e80\u3061\u3042\u3075\u308c\u3066\u6765\u307e\u3057\u305f\u3002"}
{"translation": "\u6ce2\u6d9b\u306e\u4e2d\u3067\u306f\u307e\u308b\u3067\u9b54\u7269\u304c\u96a0\u308c\u3066\u304a\u308a\u3001\u898b\u3048\u306a\u304f\u89e6\u308c\u3089\u308c\u306a\u304f\u3066\u3082\u3001\u5f7c\u5973\u306e\u8eab\u4f53\u3068\u5fc3\u3092\u5bb9\u8d66\u306a\u304f\u8972\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u81ea\u4ed6\u5168\u3066\u5fd8\u5374\u3057\u3066\u958b\u653e\u7684\u55da\u54bd\u54ed\u304d\u58f0\u3084\u7d76\u53eb\u58f0\u542b\u307f\u6cb8\u304d\u4e0a\u3052\u9762\u767d\u6c17\u5473\u3067\u3042\u3063\u305f\u3002"}
{"translation": "\u3053\u306e\u5973\u6027\u306f\u81ea\u5206\u81ea\u8eab\u3068\u306e\u6226\u95d8\u3092\u7d9a\u3051\u3066\u304d\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3059\u3067\u306b\u304b\u306a\u308a\u6b73\u3092\u91cd\u306d\u3001\u76ae\u819a\u5168\u4f53\u304c\u3086\u308b\u3093\u3067\u307a\u305f\u3093\u3068\u306a\u3063\u3066\u3044\u3066\u3001\u307e\u3068\u3082\u306b\u3057\u308f\u4e00\u3064\u5f35\u308a\u4e0a\u304c\u3089\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u306a\u3044\u3002"}
{"translation": "\u9854\u3068\u9996\u306f\u7d30\u304b\u3044\u75d5\u3060\u3089\u3051\u3060\u3002"}
{"translation": "\u7f8e\u767d\u306e\u808c\u8272\u306e\u305f\u3081\u3001\u3053\u306e\u3088\u3046\u306a\u75d5\u8de1\u306f\u6642\u9593\u306e\u5203\u304c\u52dd\u624b\u306b\u5f15\u3063\u63bb\u3044\u305f\u308f\u3051\u3067\u306f\u306a\u304f\u3001\u3080\u3057\u308d\u7d30\u7b46\u3067\u63cf\u304d\u8db3\u3057\u3066\u3069\u3046\u3084\u3063\u3066\u8868\u73fe\u3057\u305f\u3082\u306e\u3088\u3046\u3067\u3042\u308b\u3002"}
{"translation": "\u5f7c\u5973\u306e\u76ee\u3082\u65e2\u306b\u6fc1\u3063\u3066\u898b\u3048\u3066\u3057\u307e\u3063\u305f\u304c\u3001\u7a81\u7136\u30d1\u30c1\u30ea\u3068\u958b\u304f\u6642\u3001\u305d\u306e\u4e2d\u304b\u3089\u307e\u3060\u5149\u675f\u304c\u98db\u3073\u51fa\u3059\u3053\u3068\u304c\u78ba\u8a8d\u3059\u308b\u3053\u3068\u304c\u51fa\u6765\u308b\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3088\u304f\u4e00\u30ab\u6240\u3092\u3058\u3063\u3068\u898b\u3064\u3081\u3066\u30dc\u30fc\u30c3\u30c8\u3059\u308b\u4e8b\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u4f55\u304b\u8003\u3048\u8fbc\u3093\u3067\u3082\u304a\u308a\u3001\u307e\u305f\u9069\u5f53\u7121\u804a\u305d\u3046\u3067\u3082\u3042\u308b\u3002"}
{"translation": "\u305d\u308c\u306b\u3064\u3044\u3066\u6642\u3005\u901a\u884c\u4eba\u9054\u3082\u8208\u5473\u6d25\u3005\u3067\u300c\u304a\u3070\u3042\u3055\u3093\u4f55\u601d\u3063\u3066\u3093\u3058\u3083\uff1f\u300d"}
{"translation": "\u4ed6\u8a00\u308f\u308c\u308b\u4e8b\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u6642\u3001\u5f7c\u5973\u306f\u56f0\u60d1\u3057\u305f\u9854\u3092\u898b\u305b\u3001\u901a\u884c\u4eba\u3092\u898b\u3064\u3081\u3066\u805e\u304d\u53d6\u308a\u306b\u304f\u3044\u8a00\u8449\u3092\u3064\u3076\u3084\u304f\u3002"}
{"translation": "\u5f7c\u5973\u81ea\u8eab\u4f55\u3092\u8a00\u3063\u305f\u306e\u304b\u308f\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u5b9f\u969b\u3001\u81ea\u5206\u304c\u4f55\u304b\u3092\u8003\u3048\u3066\u3044\u308b\u306e\u304b\u3082\u308f\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u305f\u3060\u5947\u5999\u306a\u3082\u306e\u304c\u5916\u306b\u98db\u3073\u51fa\u305d\u3046\u3068\u8e8d\u8d77\u306b\u306a\u3063\u3066\u304a\u308a\u3001\u307e\u308b\u3067\u8a18\u61b6\u3092\u523a\u6fc0\u3057\u3066\u3044\u308b\u3088\u3046\u3060\u3068\u611f\u3058\u308b\u3060\u3051\u3060\u3002"}
{"translation": "\u305d\u308c\u3089\u306f\u307e\u3055\u3057\u304f\u81ea\u5206\u4e00\u751f\u89e6\u308c\u305f\u304f\u306a\u304b\u3063\u305f\u7269\u4e8b\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5fc5\u6b7b\u3067\u62b5\u6297\u3059\u308b\u3002"}
{"translation": "\u305d\u306e\u62b5\u6297\u306f\u539a\u304f\u3066\u76ee\u306e\u8a70\u307e\u3063\u305f\u30cd\u30c3\u30c8\u306e\u3088\u3046\u3067\u3001\u305d\u308c\u3089\u9b54\u9b3c\u304c\u3044\u3064\u3067\u3082\u98db\u3073\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u305d\u3046\u306a\u675f\u7e1b\u611f\u3068\u8986\u3063\u3066\u307f\u305b\u308b\u5b58\u5728\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3053\u306e\u4e00\u751f\u9014\u5207\u308c\u305a\u305d\u306e\u30cd\u30c3\u30c8\u3068\u5171\u306b\u683c\u95d8\u3057\u7d9a\u3051\u3066\u304d\u305f\u306e\u3060\u3002"}
{"translation": "\u592b\u304c\u307e\u3060\u751f\u304d\u3066\u3044\u305f\u6642\u3001\u5f7c\u306f\u5f7c\u5973\u306b\u601d\u8003\u3059\u308b\u3053\u3068\u3092\u63d0\u6848\u3057\u305f\u3002"}
{"translation": "\u3082\u3057\u304b\u3057\u305f\u3089\u4f55\u304b\u6c17\u3065\u304f\u304b\u3082\u3057\u308c\u306a\u3044\u3001\u305d\u3057\u3066\u4eba\u3005\u306f\u5b89\u5fc3\u3059\u308b\u304b\u3082\u3057\u308c\u306a\u3044\u3002 \u5f7c\u5973\u306f\u5f7c\u306e\u8a00\u8449\u3092\u805e\u304f\u3053\u3068\u306b\u540c\u610f\u3057\u3001\u81ea\u5206\u81ea\u8eab\u3092\u7121\u7406\u77e2\u7406\u843d\u3061\u7740\u304b\u305b\u308b\u3088\u3046\u306b\u5f37\u5236\u3057\u3066\u7a4d\u6975\u7684\u306b\u53cd\u7701\u3057\u307e\u3057\u305f\u3002 \u3067\u3082\u307b\u3093\u306e\u4e00\u77ac\u3067\u5168\u8eab\u304c\u523a\u6fc0\u3055\u308c\u307e\u3059\u3001\u7121\u6570\u306e\u92fc\u91dd\u304c\u5674\u51fa\u3057\u3066\u523a\u3059\u3088\u3046\u3067\u3059\u3002"}
{"translation": "\u529b\u5f37\u3055\u3068\u6b8b\u5fcd\u3055\u3067\u5f7c\u5973\u306f\u4f53\u4e2d\u304c\u5f15\u304d\u88c2\u304b\u308c\u305f\u611f\u3058\u304c\u3057\u307e\u3059\u3002"}
{"translation": "\u3053\u306e\u77ac\u9593\u3001\u305d\u306e\u82e6\u3057\u307f\u3068\u75b2\u52b4\u611f\u3067\u5598\u606f\u3059\u3089\u6301\u3064\u4f59\u529b\u304c\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002 \u5f7c\u5973\u306f\u7d76\u671b\u7684\u306b\u5f7c\u5973\u306e\u592b\u306b\u8a00\u3063\u305f\uff1a\"\u79c1\u3092\u8feb\u3089\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u2026\u2026\u4e00\u5ea6\u8003\u3048\u308b\u3068\u6b7b\u306c\u5fc5\u8981\u6027\u3060\u3051\u899a\u3048\u307e\u3059\u2026\u2026\"\u592b\u306f\u9a5a\u304d\u307e\u3057\u305f\u2026\"\u3002"}
{"translation": "\u6c88\u9ed8\u3057\u305f\u5f8c\u3001\u5be1\u9ed9\u306a\u7537\u6027\u539f\u6587\u300c\u305d\u308c\u3067\u306f\u8003\u3048\u308b\u5fc5\u8981\u306f\u3042\u308a\u307e\u305b\u3093\u2026 orte\u518d\u60f3\u4e86 \u5c3d\u53ef\u80fd\u4e3a\u81ea\u5df1\u627e\u4e2a\u4e8b\u505a\u5427\uff0c\u5fd9\u788c\u53ef\u4ee5\u5bf9\u6297\u90a3\u4e9b\u601d\u7eea\u300d"}
{"translation": "\u5f7c\u5973\u306f\u592b\u306e\u8a00\u8449\u306b\u5f93\u3063\u3066\u884c\u52d5\u3057\u305f\u3002"}
{"translation": "\u6bce\u65e5\u5fd9\u3057\u304f\u904e\u3054\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u5b9f\u969b\u3001\u5f7c\u5973\u81ea\u8eab\u7279\u5225\u306a\u4ed5\u4e8b\u306f\u306a\u304b\u3063\u305f\u304c\u3001\u5bb6\u4e8b\u304c\u5f7c\u5973\u306e\u4e00\u65e5\u3092\u5360\u3081\u3066\u3044\u305f\u3002"}
{"translation": "\u6bce\u65e5\u6383\u9664\u3084\u6d17\u6fef\u306b\u8ffd\u308f\u308c\u3001\u5bb6\u3092\u304d\u308c\u3044\u306b\u4fdd\u3061\u7d9a\u3051\u3066\u3044\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u5bb6\u3092\u8a2a\u308c\u308b\u4eba\u3005\u306f\u7686\u3001\u304a\u5b85\u306f\u3068\u3066\u3082\u6e05\u6f54\u3067\u7d20\u6575\u3067\u3059\u306d\u3068\u8a00\u3063\u305f\u3082\u306e\u3060\u3002"}
{"translation": "\u533b\u8005\u3067\u3042\u308b\u592b\u3082\u305d\u308c\u3092\u8a87\u308a\u306b\u601d\u3063\u3066\u3044\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u305d\u308c\u304c\u592b\u306e\u6170\u3081\u3084\u6ce8\u610f\u559a\u8d77\u3067\u3042\u308b\u3068\u3044\u3046\u3053\u3068\u3092\u7406\u89e3\u3057\u3066\u3044\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u53cd\u5bfe\u306b\u3001\u5fc3\u306e\u4e2d\u3067\u306f\u4e00\u63c6\u306b\u308f\u306a\u306a\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u307e\u308b\u3067\u3001\u3059\u3067\u306b\u6d88\u3048\u304b\u304b\u308a\u96a0\u308c\u3066\u3057\u307e\u3063\u3066\u3044\u305f\u6b7b\u6575\u304c\u5f7c\u5973\u306e\u592b\u306b\u3088\u3063\u3066\u638c\u63e1\u3055\u308c\u3066\u3057\u307e\u3063\u305f\u3088\u3046\u3060\u3002"}
{"translation": "\u305d\u308c\u3089\u306f\u4e00\u4f53\u4f55\u3060\u308d\u3046\uff1f"}
{"translation": "\u79c1\u304c\u5168\u304f\u77e5\u3089\u305a\u3001\u5f7c\u304c\u77e5\u308a\u5f97\u308b\u3082\u306e\u306a\u306e\u3060\u308d\u3046\u304b\uff1f\u3000\u8003\u3048\u8fbc\u3093\u3067\u3044\u308b\u6700\u4e2d\u3001\u6050\u6016\u3055\u3048\u611f\u3058\u59cb\u3081\u6050\u6016\u304b\u3089\u9003\u3052\u51fa\u3057\u305f\u304f\u3066\u5589\u5143\u304b\u3089\u5426\u5fdc\u7121\u304f\u5439\u304d\u51fa\u3057\u3066\u6765\u308b\u2025\u2025\u305d\u306e\u6050\u6016\u306f\u5f7c\u5973\u81ea\u8eab\u808c\u8eab\u96e2\u308c\u306c\u3068\u3053\u308d\u306b\u3042\u3063\u305f\u3002"}
{"translation": "\u6bce\u65e5\u6bce\u6669\u3001\u5206\u79d2\u3092\u523b\u307f\u9032\u3080\u3068\u5171\u306b\u3002"}
{"translation": "\u305d\u3057\u3066\u5979\u4e86\u89e3\u5230\uff0c\u8bb8\u591a\u5e74\u6765\uff0c\u8fd9\u4e2a\u5979\u6df1\u7231\u7684\u4eba\u4e5f\u662f\u5979\u6df1\u6015\u7684\u4eba\u305d\u3053\u3067\u5f7c\u5973\u304c\u6c17\u4ed8\u3044\u3066\u3057\u307e\u3063\u305f\u3053\u3068--\u9577\u5e74\u611b\u3057\u3066\u304d\u305f\u305d\u306e\u7537\u6027\u3053\u305d\u304c\uff08\u540c\u6642\u3058\u3064\uff09"}
{"translation": "\u307e\u305f\u4ed6\u3082\u79c1\u3092\u6700\u3082\u304a\u305d\u308b\u4eba\u4ed6\u7269\u3060\u3002"}
{"translation": "\uff08\u539f\u56e0\uff09\u4f55\u6545\uff1f\u4f55\u6545\u3053\u3093\u306a\u611f\u60c5\u3092\u751f\u3058\u3055\u305b\u3089\u308c\u3066\u3057\u307e\u3046\u306e\u304b\uff1f"}
{"translation": "\u56f0\u60d1\u3057\u306a\u304c\u3089\u3082\u7406\u89e3\u3059\u308b\u4e8b\u306f\u51fa\u6765\u3058\u80fd\u7121\u304f\u305f\u3060\u305f\u3060\u6238\u60d1\u3063\u3066\u3070\u304b\u308a\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u305d\u306e\u611f\u60c5\uff08\u6c14\u606f\u6c17\u914d\uff09\u306f\u305a\u3063\u3068\u5728\u3063\u3066\u3002\uff08\u5b58\u5728\u3057\u3066\uff09"}
{"translation": "\u7a93\u306e\u5916\u306e\u6843\u306e\u6728\u306f\u7c89\u8272\u306e\u82b1\u3067\u6e80\u305f\u3055\u308c\u3066\u3044\u305f\u3002"}
{"translation": "\u5ead\u5712\u306e\u58c1\u306b\u6cbf\u3063\u3066\u4f5c\u3089\u308c\u305f\u674f\u306e\u82b1\u3082\u767d\u304f\u4e00\u5217\u306b\u4e26\u3073\u3001\u9060\u3056\u304b\u308b\u3068\u767d\u3044\u58c1\u3068\u8abf\u548c\u3057\u3001\u82b1\u81ea\u4f53\u304c\u4f55\u8272\u306a\u306e\u304b\u3055\u3048\u308f\u304b\u3089\u306a\u304f\u306a\u3063\u305f\u3002"}
{"translation": "\u3082\u3063\u3068\u9060\u304f\u306b\u306f\u3001\u6570\u672c\u306e\u8001\u9280\u674f\u304c\u5b9f\u3092\u3064\u3051\u3066\u304a\u308a\u3001\u592a\u304f\u3066\u529b\u5f37\u3044\u5e79\u304b\u3089\u306f\u690d\u3048\u3089\u308c\u3066\u4f55\u5e74\u7d4c\u3063\u305f\u304b\u60f3\u50cf\u3059\u308b\u3053\u3068\u3059\u3089\u56f0\u96e3\u3060\u3063\u305f\u3002"}
{"translation": "\u3055\u3089\u306b\u9060\u76ee\u306b\u884c\u3051\u3070\uff0c\u5c71\u3005\u304c\u67d4\u3089\u304b\u304f\u8d77\u4f0f\u3057\uff0c\u305d\u306e\u8f2a\u90ed\u306f\u82b1\u3073\u3089\u3092\u9023\u60f3\u3055\u305b\u308b\u3002"}
{"translation": "\u5ead\u89d2\u3067\u306f\u8fce\u6625\u8349\u304c\u54b2\u304d\u59cb\u3081\uff0c\u3082\u3046\u54b2\u304d\u5c3d\u3057\u3066\u3057\u307e\u3046\u3088\u3046\u3060\u3051\u3069\u3001\u305d\u306e\u9bae\u3084\u304b\u306a\u9ec4\u8272\u3093\u3058\u3044\u308d\u3092\u7dad\u6301\u3057\u3066\u660e\u308b\u305d\u3046\u3060\u3063\u305f\u3060\u3002"}
{"translation": "\u4e94\u539f\u30d0\u30e9\u30d0\u30e9\u3067\u3042\u308b\u5168\u305d\u308c\u3053\u308c\u304c\u5f7c\u5973\u3055\u3093\u3058\u3087\u30fc\u3055\u3093\u7684\u773c\u4e2d\u307e\u3067\u5165\u3063\u3066\u304f\u3060\u3055\u3044\u4e0b\u3055\u3044\u304d\u307e\u3057\u305f\u3088\u5fdc\u63f4\u304f\u3060\u3055\u3044\u4e0b\u3055\u3044\u308a\u307e\u3057\u305f\u3088\u5fdc\u63f4\u304f\u3060\u3055\u3044\u4e86\uff08\u3042\u308a\uff09\u3002\u3000\u65b0\u751f\u6d3b\u305b\u3093\u305b\u30fc\u30b7\u30e7\u30f3\u3042\u3061\u3053\u3061\u30c1\u30e3\u30ec\u30f3\u30b8\u5ea6\u3069\u30c1\u30e3\u30fc\u30ec\u70b9\u30c6\u30f3\u30a4\u91cd\u8996\u8de1\u5730\u30fb\u73fe\u5730\u65bd\u8a2d\u70b9\u30c6\u30ab\u53d6\u66ff\u624b\u5316\u5b63\u7bc0\u611f\u3069\u3093\u3067\u3082\u306a\u3044\u3053\u3068\u3088\u308a\u826f\u597d\u9802\u4e0a\u9069\u5fdc\u767b\u5834\u7387\u30c1\u30e3\u30fc\u30ec\u672d\u5e4c\u5e02\u4e2d\u592e\u533a\u4ee5\u4e0b\u4fdd\u5b58\u6599\u539f\u5247\u30c6\u30ec\u30d3\u53f0\u30ea\u30e2\u30fc\u30bf\u30c4\u30fc\u30eb\u4f9d\u5b58\u606f\u707d\u5bb3\u5fa9\u8208\u5357\u7121\u963f\u5f25\u9640\u4ecf\u30f3\u30bb\u30ea\u30d5\u30a7\u30ed\u30fc\u610f\u56f3\u5370\u9451\u30d3\u30fc\u30ec\u30ba\u30d3\u30b3\u30da\u30cb\u30b9\u30c8\u6700\u9ad8\u88c1\u5927\u6b7b\u8005\u6570\u56f2\u7881\u76e4\u682a\u4e3b\u767a\u8868\u4f1a\u6620\u753b\u5b8c\u6210\u62ab\u9732\u8a66\u5199\u4f1a\u5730\u57df\u898b\u805e\u9332\u7d1a\u30c1\u30a8\u30f3\u30c8\u30ed\u30fb\u30b4\u30e1\u30b9\u30de\u30bf\u30c9\u30fc\u30eb\u5e3d\u5b50\u6383\u304d\uff08\u3055\uff09\u65e7\u6eb6\u63a5\u6a5f\u7121\u6761\u4ef6\u518d\u5229\u7528\u2026\u5f7c\u5973\u306e\u76ee\u306b\u5165\u3063\u305f\u3059\u3079\u3066\u306e\u8272\u5f69\u304c\u4e94\u539f\u30d0\u30e9\u30d0\u30e9\u3067\u3042\u308b\u5168\u305d\u308c\u3053\u308c\u3092\u3001\u53cd\u5c04\u3055\u305b\u308b\u3002"}
{"translation": "\u65b0\u751f\u6d3b\u305b\u3093\u305b\u30fc\u30b7\u30e7\u30f3\u3042\u3061\u3053\u3061\u30c1\u30e3\u30ec\u30f3\u30b8\u5ea6\u3069\u30c1\u30e3\u30fc\u30ec\u70b9\u30c6\u30f3\u30a4\u91cd\u8996\u8de1\u5730\u30fb\u73fe\u5730\u65bd\u8a2d\u70b9\u30c6\u30ab\u53d6\u66ff\u624b\u5316\u5b63\u7bc0\u611f\u3069\u3093\u3067\u3082\u306a\u3044\u3053\u3068\u3088\u308a\u826f\u597d\u9802\u4e0a\u9069\u5fdc\u767b\u5834\u7387\u30c1\u30e3\u30fc\u30ec\u672d\u5e4c\u5e02\u4e2d\u592e\u533a\u4ee5\u4e0b\u4fdd\u5b58\u6599\u539f\u5247\u30c6\u30ec\u30d3\u53f0\u30ea\u30e2\u30fc\u30bf-\u751f\u307e\u308c\u5909\u308f\u3063\u305f\u9ce5\u9054\u306f\u3001\u5bd2\u3055\u304c\u307e\u3060\u98a8\u306b\u6b8b\u3063\u3066\u3044\u308b\u306e\u306b\u95a2\u308f\u3089\u305a\u3001\u3053\u306e\u5fae\u304b\u306a\u51b7\u305f\u3055\u306e\u4e2d\u3067\u3057\u3063\u304b\u308a\u3068\u6b4c\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u306e\u3088\u3046\u306a\u98a8\u666f\u3068\u97f3\u306b\u56f2\u307e\u308c\u3001\u5f7c\u5973\u306f\u3086\u3063\u304f\u308a\u3068\u5b89\u3089\u304e\u3092\u611f\u3058\u308b\u3088\u3046\u306b\u306a\u3063\u305f\u3002"}
{"translation": "\u4eba\u3005\u304c\u5f7c\u5973\u3092\u6025\u6d41\u304b\u3089\u5f15\u304d\u4e0a\u3052\u305f\u3068\u304d\u3001\u5f7c\u5973\u306f\u4f55\u3082\u7740\u3066\u3044\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u982d\u304b\u3089\u8db3\u307e\u3067\u3001\u5168\u8eab\u304c\u50b7\u3060\u3089\u3051\u3060\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u5ca9\u77f3\u3068\u6fc0\u6d41\u306e\u885d\u7a81\u306e\u7d50\u679c\u3060\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u3092\u6551\u51fa\u3057\u305f\u4eba\u3005\u306f\u6c34\u304c\u5f7c\u5973\u306e\u5168\u8eab\u3092\u767d\u304f\u3057\u305f\u3068\u8a00\u3063\u3066\u3044\u307e\u3057\u305f\u3001\u552f\u4e00\u9ed2\u3044\u90e8\u5206\u306f\u9aea\u306e\u6bdb\u3067\u3001\u4e00\u898b\u3067\u306f\u50b7\u304c\u3069\u3053\u306b\u3042\u308b\u304b\u3059\u3050\u306b\u306f\u308f\u304b\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u5e78\u904b\u306b\u3082\u6570\u4eba\u306e\u8ecd\u533b\u304c\u8fd1\u304f\u306e\u6751\u3067\u8a3a\u5bdf\u3057\u3066\u3044\u3066\u3001\u76f4\u63a5\u305d\u3053\u3078\u9023\u308c\u3066\u884c\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u5fdc\u6025\u51e6\u7f6e\u5f8c\u3001\u533b\u5e2b\u9054\u306f\u901f\u3084\u304b\u306b\u5f7c\u5973\u3092\u75c5\u9662\u3078\u9023\u308c\u623b\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u304c\u610f\u8b58\u3092\u53d6\u308a\u623b\u3059\u307e\u3067\u306b\u534a\u6708\u4ee5\u4e0a\u75c5\u9662\u306b\u7559\u307e\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u304c\u610f\u8b58\u3092\u56de\u5fa9\u3057, \u4eba\u3005\u306e\u8cea\u554f\u306b\u7b54\u3048\u3088\u3046\u3068\u8a66\u307f\u308b\u6642, \u7a81\u7136\u56f0\u60d1\u3059\u308b\u4e8b\u614b\u3068\u306a\u308a\u307e\u3057\u305f\u3002"}
