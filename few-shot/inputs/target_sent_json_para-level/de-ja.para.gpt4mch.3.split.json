{"translation": "\u5168\u3066\u3092\u5fd8\u308c\u308b\u306e\u306f\u78ba\u304b\u306b\u5927\u5909\u306a\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u3067\u3082\u3001\u4f55\u3082\u5fd8\u308c\u305a\u306b\u3059\u3080\u3053\u3068\u304c\u3001\u305d\u308c\u3088\u308a\u3082\u3055\u3089\u306b\u60aa\u3044\u3053\u3068\u3060\u3068\u601d\u3044\u307e\u3059\u3002"}
{"translation": "\u77e5\u8b58\u306f\u3044\u3064\u3082\u5fd8\u5374\u3092\u901a\u3058\u3066\u751f\u307f\u51fa\u3055\u308c\u307e\u3059\u3002"}
{"translation": "\u96fb\u529b\u3092\u6d88\u8cbb\u3059\u308b\u30c7\u30fc\u30bf\u30b9\u30c8\u30ec\u30fc\u30b8\u306e\u3088\u3046\u306b\u5168\u3066\u304c\u533a\u5225\u306a\u304f\u8caf\u8535\u3055\u308c\u3066\u3044\u308b\u5834\u5408\u3001\u305d\u308c\u3089\u306f\u610f\u5473\u3092\u5931\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3057\u3001\u305f\u3060\u4e71\u96d1\u306b\u96c6\u3081\u3089\u308c\u305f\u7121\u7528\u306a\u60c5\u5831\u3078\u3068\u5909\u308f\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u304b\u3089\u3002"}
{"translation": "\u3059\u3079\u3066\u3092\u8a18\u61b6\u3059\u308b\u8a18\u61b6\u529b\u306f\u3001\u7d50\u5c40\u306e\u3068\u3053\u308d\u4f55\u3082\u4fdd\u5b58\u3057\u306a\u3044\u3002"}
{"translation": "1980\u5e742\u67085\u65e5\u4ee5\u964d\u306e\u6bce\u65e5\u3092\u7279\u5225\u306a\u8a18\u61b6\u8853\u306a\u3057\u306b\u601d\u3044\u8d77\u3053\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u305d\u306e\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u5973\u6027\u306f\u3001\u5f7c\u5973\u306b\u7d76\u3048\u305a\u58ca\u308c\u3066\u5165\u3063\u3066\u304f\u308b\u8a18\u61b6\u306e\u30a8\u30b3\u30fc\u30fb\u30eb\u30fc\u30e0\u306b\u9589\u3058\u8fbc\u3081\u3089\u308c\u3066\u3044\u307e\u3059 - \u30a2\u30c3\u30c6\u30a3\u30ab\u5730\u65b9\u306e\u5c06\u8ecd\u30c6\u30df\u30b9\u30c8\u30af\u30ec\u30b9 \u306e\u518d\u6765\u8005\u3067\u3001\u5f7c\u306f\u81ea\u5206\u306e\u6545\u90f7\u5e02\u6c11\u5168\u54e1\u3092\u540d\u524d\u3067\u547c\u3073\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u3001\u4eba\u4e26\u307f\u5916\u308c\u305f\u8a18\u61b6\u529b\u3092\u6301\u3064\u30b7\u30e2\u30f3\u30a4\u30c7\u30b9\u3055\u3093\u306b\u8a00\u3044\u6e21\u3057\u307e\u3057\u305f\u3002 \u5fd8\u5374\u82b8\u8853: \"\u79c1\u304c\u899a\u3048\u305f\u304f\u306a\u3044\u3082\u306e\u3067\u3082\u899a\u3048\u307e\u3059\uff1b\u3057\u304b\u3057\u3001\u5fd8\u308c\u305f\u3044\u308f\u3051\u3067\u3059 \u3057\u304b\u3057\u3001\u5fd8\u308c\u3089\u308c\u307e\u305b\u3093\" \u3002"}
{"translation": "\u4f46\u3057\u3001\u300c\u5fd8\u5374\u6280\u6cd5\u300d\u306f\u5b9f\u969b\u4e0d\u53ef\u80fd\u3067\u3059\u3002"}
{"translation": "\u306a\u305c\u306a\u3089\u3070\u5168\u3066\u306e\u5fb4\u5019\u304c\u5b58\u5728\u3092\u793a\u3057\u3066\u304a\u308a\uff0c\u305d\u308c\u3089\u304c\u6b20\u5982\u3057\u305f\u5834\u6240\u3067\u306f\u5373\u5ea7\u306b\u6307\u6458\u3059\u308b\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u307e\u305f\uff0c\u30ed\u30fc\u30de\u5e1d\u56fd\u57df\u5185\u3067\u300cdamnatio memoriae\u300d(\u610f\u8b58\u304b\u3089\u9664\u53bb\u3055\u308c\u308b\u7f70) \u3092\u53d7\u3051\u53d6\u3063\u305f\u307b\u3068\u3093\u3069\u5168\u54e1\u9054\u4eba\u3005\u306f\u30a8\u30f3\u30b5\u30a4\u30af\u30ed\u30da\u30c7\u30a3\u30a2\u4e0a\u540d\u524d\u3067\u77e5\u3089\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u81ea\u7531\u6b7b\u306f\u3001\u672a\u6765\u306e\u4e0d\u78ba\u5b9f\u6027\u3092\u514b\u670d\u3059\u308b\u624b\u6bb5\u3068\u3057\u3066\u6700\u3082\u30e9\u30c7\u30a3\u30ab\u30eb\u306a\u3082\u306e\u3068\u898b\u3048\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u305d\u306e\u7d50\u679c\u3068\u3057\u3066\u751f\u547d\u304c\u7e2e\u307e\u308b\u4ee3\u511f\u3092\u6255\u3046\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u304b\u3064\u3066\u30a2\u30a6\u30b0\u30b9\u30c8\u30a5\u30b9\u304c\u30b5\u30e2\u30b9\u5cf6\u3067\u8fce\u3048\u305f\u30a4\u30f3\u30c9\u304b\u3089\u306e\u4f7f\u7bc0\u56e3\u306e\u8d08\u308a\u7269\u306b\u306f\u3001\u30c8\u30e9\u3084\u8155\u304c\u7121\u3044\u5c11\u5e74\u3060\u3051\u3067\u306a\u304f\u3001\u8db3\u3092\u624b\u306e\u3088\u3046\u306b\u4f7f\u3044\u3053\u306a\u3059\u5c11\u5e74\u3082\u542b\u307e\u308c\u3066\u3044\u305f\u3068\u4f1d\u3048\u3089\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u307e\u305f\u3001\u30d6\u30e9\u30d5\u30de\u30f3\u968e\u7d1a\u51fa\u8eab\u306e\u7537\u30b6\u30eb\u30de\u30ed\u30b9\u3082\u542b\u307e\u308c\u3066\u304a\u308a\u3001\u5f7c\u306f\u4eba\u751f\u304c\u671b\u307f\u901a\u308a\u306b\u9032\u3093\u3060\u304b\u3089\u3053\u305d\u751f\u6daf\u3092\u81ea\u5206\u81ea\u8eab\u3067\u7d42\u308f\u3089\u305b\u308b\u3064\u3082\u308a\u3060\u3063\u305f\u305d\u3046\u3067\u3059\u3002"}
{"translation": "\u4e88\u671f\u3057\u306a\u3044\u4f55\u304b\u304c\u8d77\u304d\u306a\u3044\u3088\u3046\u4fdd\u969c\u3059\u308b\u305f\u3081\u306b\u5f7c\u306f\u30a2\u30c6\u30cd\u3067\u7b11\u9854\u3067\u5168\u88f8\u3057\u3066\u30aa\u30a4\u30eb\u3092\u5857\u3063\u305f\u4f53\u3067\u706b\u707d\u73fe\u5834\u3078\u98db\u3073\u8fbc\u307f\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u9593\u9055\u3044\u306a\u304f\u6fc0\u75db\u3092\u4f34\u3063\u3066\u713c\u304d\u5c3d\u304f\u3055\u308c\u6b7b\u4ea1\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u81ea\u5206\u81ea\u8eab\u306e\u6b7b\u671f\u6c7a\u5b9a\u7684\u4ed5\u7d44\u307f\u904e\u7a0b\u4e2d\u5165\u53f2\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u304b\u3064\u305f\u3060\u5c0f\u3055\u304d\u9a5a\u6115\u4ed6\u8a00\u4e00\u66f8\u7c4d\u305d\u306e\u30ab\u30b7\u30a6\u30b9Dio\u53f2\u30ed\u30fc\u30de\u3088\u51b0\u5c71\u4e00\u89d2\u4fdd\u8b77\u751f\u304d\u6b8b\u308a\u3060\u3051\u5b58\u5728\u7a2e\u5f84\u9060\u5f15\u9000\u3059\u3002"}
{"translation": "\u7d50\u5c40\u4f59\u5270\u4fdd\u3064\u3044\u3046\u4f55\u304b\u5168\u7136\u4e8b\u5b9f\u305d\u306e\u3053\u3068\u3067\u3042\u308b\u3002"}
{"translation": "\u751f\u304d\u308b\u3068\u3044\u3046\u3053\u3068\u306f\u3001\u640d\u5931\u3092\u7d4c\u9a13\u3059\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u307e\u3059\u3002"}
{"translation": "\u4f55\u304c\u8d77\u3053\u308b\u304b\u3001\u3068\u3044\u3046\u554f\u3044\u306f\u304a\u305d\u3089\u304f\u4eba\u985e\u304c\u751f\u307e\u308c\u305f\u6642\u304b\u3089\u5b58\u5728\u3057\u3066\u3044\u308b\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u306a\u305c\u306a\u3089\u672a\u6765\u306e\u6027\u8cea\u306b\u306f\u4e88\u898b\u4e0d\u53ef\u80fd\u6027\u3068\u6b7b\u306e\u6642\u9593\u3084\u72b6\u6cc1\u306b\u3064\u3044\u3066\u306e\u6697\u95c7\u304c\u4e0d\u53ef\u6b20\u3067\u3042\u308a\u3001\u305d\u308c\u3086\u3048\u306b\u4e0d\u5b89\u5b9a\u3067\u3059\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u7518\u304f\u82e6\u3044\u4e88\u60f3\u3055\u308c\u308b\u82e6\u3057\u307f\u306e\u9632\u5fa1\u7684\u306a\u9b54\u6cd5\u3001\u73fe\u5b9f\u5316\u3055\u308c\u305f\u3082\u306e\u3092\u601d\u8003\u7684\u5148\u53d6\u308a\u3067\u9632\u3054\u3046\u3068\u3059\u308b\u904b\u547d\u7684\u306a\u885d\u52d5\u3092\u77e5\u3089\u306a\u3044\u4eba\u306f\u3044\u307e\u305b\u3093\u304b\uff1f"}
{"translation": "\u4eba\u3005\u306f\u7834\u58ca\u7684\u4e8b\u8c61\u3092\u5148\u8aad\u307f\u3057\u3001\u6f5c\u5728\u7684\u306a\u707d\u5bb3\u3092\u60f3\u50cf\u3057\u3001\u305d\u308c\u306b\u3088\u3063\u3066\u81ea\u5206\u81ea\u8eab\u304c\u5384\u4ecb\u4e8b\u304b\u3089\u514d\u308c\u3066\u3044\u308b\u3088\u3046\u306b\u601d\u3044\u307e\u3059\u3002"}
{"translation": "\u53e4\u4ee3\u3067\u306f\u5922\u304c\u6170\u3081\u3092\u7d04\u675f\u3057\u3066\u304f\u308c\u305f\u308a\u3001\u30ae\u30ea\u30b7\u30e3\u4eba\u304c\u8a00\u3063\u305f\u3088\u3046\u306b\u30aa\u30e9\u30af\u30eb\uff08\u795e\u8a17\uff09\u540c\u69d8\u306b\u672a\u6765\u4e88\u77e5\u3057\u3066\u304f\u308c\u3066\u6b21\u7b2c\u3060\u3063\u305f\u3089\u6050\u6016\u611f\u3084\u9a5a\u304d\u8981\u7d20\u3067\u3082\u4e00\u822c\u6027\u3060\u3051\u5e0c\u671b\u3059\u308b\u4e8b\u3067\u3082\u826f\u304b\u3063\u305f\u3060\u308d\u3046\u3002"}
{"translation": "\u7a81\u7136\u601d\u308f\u306c\u9769\u65b0\u6027\u30c7\u30b3\u30ec\u30fc\u30b7\u30e7\u30f3\u578b\u7121\u9ab8\u4f53\u30cf\u30d6\u5076\u7136\u62bc\u3059\u5c11\u3057\u6dcb\u3057\u3044\u3002"}
{"translation": "\u6b7b\u3078\u306e\u6050\u6016\u304b\u3089\u81ea\u3089\u547d\u3092\u7d76\u3064\u4eba\u3082\u5c11\u306a\u304f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u904e\u53bb\u3092\u4fdd\u6301\u3057\u3001\u5fd8\u5374\u3092\u6b62\u3081\u308b\u305f\u3081\u306e\u6226\u7565\u306f\u591a\u7a2e\u591a\u69d8\u3067\u3059\u3002"}
{"translation": "\u4f1d\u3048\u3089\u308c\u3066\u3044\u308b\u3068\u3053\u308d\u3067\u306f\u3001\u6211\u3005\u306e\u6b74\u53f2\u8a18\u8ff0\u306e\u59cb\u307e\u308a\u306b\u306f\u30da\u30eb\u30b7\u30e3\u4eba\u3068\u30ae\u30ea\u30b7\u30e3\u4eba\u3068\u306e\u9593\u306e\u58ca\u6ec5\u7684\u306a\u6226\u4e89\u304c\u4e26\u3073\u7acb\u3061\u3001\u73fe\u5728\u3067\u306f\u307b\u307c\u5fd8\u308c\u3089\u308c\u3066\u3057\u307e\u3063\u305f\u8a18\u61b6\u6280\u8853\uff08\u8a18\u61b6\u8853\uff09\u306e\u59cb\u307e\u308a\u306b\u306f\u3001\u591a\u304f\u306e\u6b7b\u8005\u304c\u51fa\u305f\u707d\u5bb3\u304c\u3042\u308a\u307e\u3059\uff1a\u305d\u308c\u306f\u30ad\u30ea\u30b9\u30c8\u4ee5\u524d5\u4e16\u7d00\u521d\u671f\u306b\u30c6\u30c3\u30b5\u30ea\u30a2\u3067\u767a\u751f\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u5d29\u58ca\u3057\u305f\u5bb6\u304c\u795d\u796d\u65e5\u96c6\u4f1a\u3092\u4e00\u5ea6\u306b\u62bc\u3057\u3064\u3076\u3057\u307e\u3057\u305f\u304c\u3001\u552f\u4e00\u52a9\u304b\u3063\u305f\u30b1\u30fc\u30aa\u30b9\u5cf6\u51fa\u8eab\u306e\u8a69\u4eba\u30b7\u30e2\u30cb\u30c7\u30b9\u306f\u8a13\u7df4\u3055\u308c\u305f\u601d\u3044\u51fa\u306b\u3088\u308a\u7c89\u3005\u306b\u58ca\u308c\u305f\u5efa\u7269\u5185\u90e8\u3092\u5fc3\u8c61\u3067\u518d\u8a2a\u3059\u308b\u3053\u3068\u3067\u5ba2\u5e2d\u914d\u7f6e\u56f3\u547c\u3073\u8d77\u3053\u3059\u3053\u3068\u306b\u6210\u529f\u3057\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u7d50\u679c\u907a\u4f53\u8a8d\u5b9a\u624b\u7d9a\u304d\u3082\u53ef\u80fd\u3068\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u3089\u6570\u3005\u4e2d\u3067\u3082\u3001\u300c\u6b7b\u3042\u308b\u3044\u306f\u751f\u300d\u3068\u3044\u3046\u4e8c\u8005\u629e\u4e00\u6027\u304b\u3089\u6d3e\u751f\u3059\u308b\u30d1\u30e9\u30c9\u30af\u30b9\u4e2d\u3067\u3082\u7279\u8a18\u3059\u3079\u304d\u4e8b\u5b9f\u3067\u3059\u304c\u30fc\u30fc\u540d\u524d\u3082\u6210\u5206\u3082\u5931\u308f\u308c\u53d6\u308a\u8fd4\u3057\u304c\u3064\u304b\u306a\u304f\u306a\u3063\u305f\u72b6\u614b\u306b\u3042\u308b\u6545\u4eba\u306e\u8a55\u5e78\u3046\u5b58\u5728\u306f\u3001\u305d\u306e\u5931\u3046\u3053\u3068\u3092\u304c\u306a\u3057\u3066\u3057\u307e\u3063\u305f\u60b2\u3057\u307f\u3082\u307e\u305f\u4e8c\u500d\u5316\u3057\u534a\u6e1b\u3057\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u884c\u65b9\u4e0d\u660e\u8005\u3084\u6d88\u606f\u304c\u4e0d\u900f\u660e\u306a\u6d88\u3048\u53bb\u3063\u305f\u5b58\u5728\u306b\u3064\u3044\u3066\u3069\u306e\u3088\u3046\u306b\u7f79\u60a3\u3059\u308b\u304b\u305d\u3093\u306a\u5b58\u5728\u304c\u6b8b\u3059\u8eab\u5185\u9054\u3064\u307e\u308a\u5bb6\u65cf\u9054\u306f\u6050\u6016\u3068\u5e0c\u671b\u3068\u5ef6\u5f15\u304d\u8fbc\u3080\u73fe\u5b9f\u304b\u3089\u51fa\u3089\u308c\u305a\u307e\u305f\u5931\u610f\u611f\u304b\u3089\u629c\u3051\u51fa\u305b\u305a\u307e\u3055\u306b\u5927\u3044\u306a\u308b\u30a2\u30eb\u30d7\u30b9\u30c8\u30e9\u30a6\u30de\uff08\u6050\u6016\u75c7\uff09\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u306f\u4eba\u751f\u306e\u8a6e\u7d22\u30fb\u4ee3\u66ff\u54c1\u30fb\u518d\u751f\u3068\u3044\u3046\u5f62\u3067\u5831\u308f\u308c\u307e\u3059\u3002"}
{"translation": "\u6b7b\u306e\u533a\u5207\u308a\u306f\u3001\u907a\u7523\u3068\u8a18\u61b6\u306e\u8d77\u70b9\u3067\u3042\u308a\u3001\u6b7b\u8005\u306e\u60b2\u5606\u306f\u3001\u5168\u6587\u5316\u306e\u6e90\u3067\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u306b\u3088\u308a\u3001\u7a81\u5982\u3068\u3057\u3066\u958b\u3044\u305f\u7a7a\u865a\u306a\u5834\u6240\u3084\u6025\u306a\u9759\u5bc2\u3092\u6b4c\u3084\u7948\u308a\u3084\u8a71\u3067\u57cb\u3081\u308b\u3053\u3068\u304c\u53ef\u80fd\u306b\u306a\u308a\u3001\u6b20\u3051\u3066\u3044\u308b\u3082\u306e\u304c\u518d\u3073\u751f\u304d\u8fd4\u308b\u5f62\u3067\u63cf\u304b\u308c\u308b\u3088\u3046\u306b\u306a\u308b\u3002"}
{"translation": "\u7d4c\u9a13\u3057\u305f\u55aa\u5931\u611f\u306f\u307e\u308b\u3067\u578b\u629c\u304d\u30d1\u30c6\u30a3\u30fc\u306e\u3088\u3046\u306b\uff08\u79c1\u305f\u3061\u304c\u5606\u304f\u3079\u304d\u3082\u306e\uff09\u88ab\u305b\u7269\u3092\u660e\u78ba\u306b\u3057\u3001\u3057\u3070\u3057\u3070\u305d\u308c\u3092\u60b2\u3057\u307f\u306e\u7167\u3089\u3059\u5149\u6e90\u4e2d\u5909\u5bb9\u3055\u305b\u3001\u6b32\u671b\u3059\u308b\u5bfe\u8c61\u3068\u3057\u307e\u3059\u3002"}
{"translation": "\u307e\u305f\u3042\u308b\u30cf\u30a4\u30c7\u30eb\u30d9\u30eb\u30af\u5927\u5b66\u52d5\u7269\u5b66\u6559\u6388\u304c\u65b0\u30d6\u30ec\u30fc\u30e0\u56f3\u66f8\u9928\u30b7\u30ea\u30fc\u30ba\u672c\u5192\u982d\u3067\u8ff0\u3079\u3066\u3044\u305f\u3088\u3046\u3067\u3059\u3002"}
{"translation": "\u300c\u7406\u6027\u7684\u306b\u307b\u3068\u3093\u3069\u7406\u89e3\u4e0d\u80fd\u306a\u897f\u6d0b\u4eba\u9593\u5668\u8cea\u7279\u6027\"\u305d\u306e\u4e00\u3064\u306f\u3053\u306e\u4eba\u3005\u55aa\u5931\u3057\u305f\u4e8b\u67c4\u3092\u73fe\u5b58\u3057\u3066\u4ee5\u4e0a\u9ad8\u304f\u8a55\u4fa1\u3059\u308b\u7279\u6027\u4ee5\u5916\u3067\u3082\u8aac\u660e\u8a31\u3057\u307e\u305b\u3093\u76f4\u9762\u3059\u308b\u5947\u7570\u306a\u8a98\u60d1\u529b\u540c\u30d3\u30fc\u30bf\u30eb\u30d5\u304a\u304b\u3051\u300d\u3068\u8ff0\u3079\u307e\u3057\u305f\u3002"}
{"translation": "\u6b7b\u3068\u3001\u305d\u308c\u306b\u4f34\u3046\u7a81\u7136\u306e\u4eba\u306e\u6b20\u5982\u3068\u907a\u7269\u30fc\u907a\u4f53\u304b\u3089\u6301\u3061\u4e3b\u306e\u306a\u3044\u6240\u6301\u54c1\u307e\u3067\u30fc\u306e\u5b58\u5728\u3059\u308b\u554f\u984c\u306b\u5bfe\u51e6\u3059\u308b\u65b9\u6cd5\u306f\u3001\u6642\u9593\u304c\u7d4c\u3064\u306b\u3064\u308c\u3066\u7b54\u3048\u3092\u6c42\u3081\u3001\u884c\u52d5\u3092\u5f15\u304d\u8d77\u3053\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u610f\u5473\u306f\u5358\u306a\u308b\u76ee\u7684\u3092\u8d85\u3048\u3066\u304a\u308a\u3001\u6211\u3005\u306e\u65e9\u3044\u7956\u5148\u3092\u52d5\u7269\u6027\u304b\u3089\u4eba\u9593\u6027\u3078\u3068\u5c0e\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u540c\u985e\u7a2e\u306e\u6b7b\u9ab8\u3092\u5358\u7d14\u306b\u81ea\u7136\u5206\u89e3\u30d7\u30ed\u30bb\u30b9\u306b\u4efb\u305b\u308b\u3053\u3068\u306a\u304f\u6271\u3046\u4e8b\u304c\u4e00\u822c\u7684\u3067\u3042\u308a\u3001\u3053\u308c\u306f\u4eba\u985e\u7279\u6709\u306e\u7279\u5fb4\u3060\u3068\u3055\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u4ed6\u7a2e\u3067\u3082\u540c\u69d8\u306a\u884c\u52d5\u304c\u898b\u3089\u308c\u307e\u3059\u3002"}
{"translation": "\u305f\u3068\u3048\u3070\u3001\u8c61\u306f\u7015\u6b7b\u306e\u7fa4\u308c\u30e1\u30f3\u30d0\u30fc\u30ab\u30e9\u30c0\u3092\u9577\u6642\u9593\u89e6\u308a\u7d9a\u3051\u308b\u3060\u3051\u3067\u306a\u304f\u6fc0\u3057\u304f\u9cf4\u304d\u58f0\u3092\u6f0f\u3089\u3057\u307e\u305f\u8131\u529b\u3057\u305f\u4f53\u3092\u7acb\u3061\u4e0a\u304c\u308d\u3046\u3068\u3046\u3057\u307e\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u6700\u5f8c\u306b\u907a\u4f53 \u3092\u571f\u3084\u679d\u3067\u8986\u3063\u3066\u53bb\u308a\u307e\u3059\u3002"}
{"translation": "\u307e\u305f\u5f7c\u3089\u306f\u4f55\u5e74\u3082\u7d4c\u3063\u305f\u5f8c\u3067\u3082 \u5b9a\u671f\u7684 \u306b\u305d\u306e\u5834\u6240 \u3092\u8a2a\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u306f\u78ba\u304b \u306b\u512a\u308c\u305f\u8a18\u61b6\u529b\u304c\u5fc5\u8981\u3067\u3042\u308d\u3046\u3057\u63a8\u6e2c\u3057\u304b\u51fa\u6765\u306a\u3044\u4e16\u754c\uff08\u3080\u3053\u3046\uff09"}
{"translation": "\u611f\u899a\u3055\u3048\u5fc5\u8981\u304b\u3082\u3057\u308c\u305a\u305d\u308c\u3089\u79c1\u305f\u3061\u306e\uff08\u4e16\u754c\uff09\u3068\u4e00\u7dd2\u306b\u5e7b\u60f3\u7684\u3067\u691c\u8a3c\u4e0d\u53ef\u80fd\u306a\u3082\u306e\u3067\u3042\u308b\u3068\u60f3\u50cf\u3057\u3066\u3082\u3088\u3044\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u3053\u306e\u672c\u306e\u4f5c\u696d\u3092\u307b\u3068\u3093\u3069\u7d42\u3048\u305f\u4eca\u3001\u3053\u306e\u672c\u3067\u306f\u5206\u89e3\u3084\u7834\u58ca\u306e\u3055\u307e\u3056\u307e\u306a\u73fe\u8c61\u304c\u4e2d\u5fc3\u7684\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u3001\u305d\u308c\u306f\u6b7b\u3068\u5411\u304d\u5408\u3046\u7121\u6570\u306e\u65b9\u6cd5\u306e\u4e00\u3064\u3067\u3042\u308b\u3053\u3068\u306b\u6c17\u4ed8\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u65b9\u6cd5\u306f\u30d8\u30ed\u30c9\u30c8\u30b9\u304c\u8a3c\u8a00\u3057\u305f\u30ab\u30ec\u30a4\u30c6\u30a3\u30a2\u4eba\u306e\u98a8\u7fd2\u3067\u3042\u308b\u5f7c\u3089\u304c\u6545\u4eba\u3067\u3042\u308b\u89aa\u3092\u98df\u3079\u3066\u3044\u305f\u308a\u3001\u540c\u3058\u304f\u30ae\u30ea\u30b7\u30e3\u4eba\u304c\u6b7b\u3093\u3060\u8005\u3092\u713c\u304f\u98a8\u7fd2\u306b\u3064\u3044\u3066\u975e\u5e38\u306b\u9a5a\u6115\u3057\u3066\u3044\u305f\u308a\u3059\u308b\u307b\u3069\u5947\u7570\u3067\u3082\u3042\u308a\u3001\u307e\u305f\u4e0d\u5668\u7528\u3067\u3082\u5e87\u8b77\u3059\u308b\u3053\u3063\u3061\u306a\u308f\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u81ea\u8eab\u306e\u6b7b\u671f\u3092\u7d76\u3048\u305a\u8a8d\u8b58\u3057\u3088\u3046\u3068\u3059\u308b\u8005\u3068\u3001\u6b7b\u3092\u8ffd\u3044\u51fa\u3059\u3053\u3068\u306b\u6210\u529f\u3057\u305f\u8005\u3067\u306f\u3069\u3061\u3089\u304c\u751f\u6d3b\u306b\u8fd1\u3044\u5b58\u5728\u304b\u306f\u8cdb\u5426\u4e21\u8ad6\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u540c\u69d8\u306b\u3001\u300c\u5168\u3066\u304c\u7d42\u308f\u308b\u300d\u3053\u3068\u3084\u300c\u4f55\u3082\u7d42\u308f\u3089\u306a\u3044\u300d\u53ef\u80fd\u6027\u3069\u3061\u3089\u304c\u6050\u308d\u3057\u3044\u60f3\u50cf\u304b\u3082\u5e45\u5e83\u304f\u898b\u89e3\u306f\u5206\u304b\u308c\u307e\u3059\u3002"}
{"translation": "\u3082\u3061\u308d\u3093\u3001\u79c1\u306f\u305d\u308c\u4ee5\u524d\u306b\u4ed6\u306e\u6ce8\u76ee\u3059\u3079\u304d\u5893\u5730\u3092\u8a2a\u308c\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u4f8b\u3048\u3070\u3001\u9ad8\u304f\u8d64\u3044\u30ec\u30f3\u30ac\u306e\u58c1\u304c\u9752\u7dd1\u8272\u306e\u6c34\u304b\u3089\u7acb\u3061\u4e0a\u304c\u308b\u3088\u3046\u306b\u3057\u3066\u30f4\u30a7\u30cd\u30c1\u30a2\u306e\u30e9\u30b0\u30fc\u30f3\u304b\u3089\u6d6e\u304b\u3073\u4e0a\u304c\u308b\u6b7b\u8005\u306e\u5cf6\u30b5\u30f3\u30fb\u30df\u30b1\u30fc\u30ec\u3002"}
{"translation": "\u3042\u308b\u3044\u306f\u6bce\u5e74\u30e1\u30ad\u30b7\u30b3\u4eba\u4f4f\u6c11\u306b\u3088\u3063\u3066\u795d\u308f\u308c\u308bD\u00eda de los Muertos\uff08\u6b7b\u8005\u306e\u65e5\uff09\u3067\u8cd1\u308f\u3046\u30cf\u30ea\u30a6\u30c3\u30c9\u30fb\u30d5\u30a9\u30fc\u30a8\u30d0\u30fc\u5893\u5730\u306e\u9bae\u3084\u304b\u306a\u5e02\u5834\u3001\u30aa\u30ec\u30f3\u30b8\u3068\u9ec4\u8272\u3067\u98fe\u3089\u308c\u305f\u5893\u3001\u9032\u884c\u3057\u305f\u8150\u6557\u3067\u6c38\u9060\u306b\u7b11\u9854\u306b\u3055\u308c\u305f\u30ab\u30e9\u30d5\u30eb\u306a\u7802\u7cd6\u3068\u7d19\u7c98\u571f\u88fd\u306e\u30c9\u30af\u30ed\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u305d\u306e\u3069\u308c\u3082\u304c\u79c1\u3092\u611f\u52d5\u3055\u305b\u305f\u5834\u6240\u306f\u6f01\u5e2b\u305f\u3061\u306e\u96c6\u843d\u3067\u898b\u3064\u3051\u305f\u5893\u5730\u3067\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u7279\u7570\u306a\u5f62 -\u5186\u3068\u56db\u89d2\u5f62\u304b\u3089\u6210\u308b\u7a2e\u985e\u306e\u6298\u8877\u6848- \u306f\u79c1\u304c\u305d\u3053\u3067\u5b9f\u73fe\u3055\u308c\u3066\u3044\u308b\u4fe1\u3058\u3089\u308c\u306a\u3044\u7a0b\u5927\u304d\u306a\u7406\u60f3\u50cf\u3092\u8868\u73fe\u3059\u308b\u4ed6\u7684\u8a18\u53f7\u3060\u3068\u601d\u3044\u307e\u3059\uff1a\u300c\u6b7b\u300d\u3092\u898b\u636e\u3048\u3066\u751f\u304d\u3056\u307e\u3092\u8ffd\u6c42\u3059\u308b\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u9577\u5e74\u3001\u305d\u306e\u5834\u6240 -\u30c7\u30f3\u30de\u30fc\u30af\u8a9e\u3067\u306f\"\u5c0f\u3055\u306a\u5cf6\"\u307e\u305f\u306f\"\u6c34\u306b\u56f2\u307e\u308c\u305f\u5834\u6240\"\u3092\u610f\u5473\u3057\u3001\u305d\u3053\u3067\u306f\u6b7b\u8005\u304c\u6587\u5b57\u901a\u308a\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u306e\u4e2d\u5fc3\u306b\u3044\u308b\u3053\u3068\u304b\u3089\u3001\u79c1\u305f\u3061\u306e\u7def\u5ea6\u3067\u4e00\u822c\u7684\u306a\u90fd\u5e02\u306e\u5916\u5074\u3078\u3068\u8ffd\u3044\u3084\u3089\u308c\u308b\u4ee3\u308f\u308a\u306b\u3001\u4f4f\u4eba\u9054\u306f\u3088\u308a\u751f\u3005\u3057\u304f\u751f\u304d\u3066\u3044\u308b\u3068\u78ba\u4fe1\u3057\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u3064\u307e\u308a\u3001\u90fd\u5e02\u7a7a\u9593\u304c\u5893\u5730\u3092\u6025\u901f\u306a\u6210\u9577\u306b\u3088\u3063\u3066\u3059\u3050\u8fd1\u304f\u3078\u623b\u3057\u3066\u3057\u307e\u3046\u4e8b\u614b\u3082\u3055\u308b\u3053\u3068\u306a\u304c\u3089\u3067\u3059\u3002"}
{"translation": "\u6570\u5e74\u524d\u306e8\u6708\u306e\u65e5\u3001\u79c1\u306f\u5317\u90e8\u306e\u90fd\u5e02\u3092\u8a2a\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u90fd\u5e02\u306f\u3001\u304b\u3064\u3066\u6c37\u6cb3\u6642\u4ee3\u306b\u6d77\u6d0b\u304c\u6df1\u304f\u9678\u5730\u306b\u5165\u308a\u8fbc\u3093\u3067\u5f62\u6210\u3055\u308c\u305f\u6e7e\u306e\u6700\u5f8c\u306e\u51f9\u307f\u306b\u4f4d\u7f6e\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u6625\u3068\u306a\u308b\u3068\u30cb\u30b7\u30f3\u3001\u590f\u306b\u306f\u30a6\u30ca\u30ae\u3001\u79cb\u306b\u306f\u30bf\u30e9\u3001\u305d\u3057\u3066\u51ac\u306b\u306f\u30b3\u30a4\u3084\u30d1\u30a4\u30af\u3084\u30d6\u30ea\u30fc\u30e0\u306a\u3069\u304c\u305d\u306e\u6c7d\u6c34\u3067\u898b\u304b\u3051\u308b\u305f\u3081\u3001\u305d\u3053\u3067\u306f\u672a\u3060\u6f01\u5e2b\u3068\u3044\u3046\u8077\u696d\u304c\u884c\u308f\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\u3089\u6f01\u5e2b\u305f\u3061\u306f\u4f55\u4e16\u7d00\u3082\u524d\u304b\u3089\u5bb6\u65cf\u3068\u5171\u306b\u3044\u308f\u3070\u7d75\u753b\u7684\u3067\u3042\u308b\u3088\u3046\u306a\u8857\u533a\u3092\u4f4f\u307e\u3044\u3068\u3057\u7d9a\u3051\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u8857\u533a\u304b\u3089\u6240\u5728\u5730\u3059\u308b\u3082\u306e\u3068\u8a00\u3048\u3070\u6975\u3081\u3066\u5c0f\u3055\u306a\u5b50\u5e73\u77f3\u5f35\u308a\u9053\u8def\u3084\u6f01\u7db2\u7528\u30bf\u30b3\u30c0\u30c3\u30c8\u5834\u6240\u3050\u3089\u3044\u3067\u3059\u3057\u73fe\u5728\u3082\u4e8c\u4eba\u3060\u3051\u901a\u3046\u4fee\u9053\u9662\u6821\u3057\u304b\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u8981\u3059\u308b\u306b\u3053\u3053\u3067\u306f\u6642\u9593\u304b\u3089\u53d6\u308a\u6b8b\u3055\u308c\u305f\u3088\u3046\u306a\u3055\u307e\u3092\u5448\u3057\u3066\u304a\u308a\u904e\u53bb\u304c\u591a\u5206\u66d6\u6627\u832b\u83dc\u3060\u3051\u308c\u3069\u9b45\u529b\u7684\u3059\u304e\u3066\u3066\u5024\u5c04\u3063\u8fbc\u307f\u7559\u4fdd\u3067\u304d\u305a\u5074\u9762\u5b58\u6d3b\u7269\u4e8b\u601d\u3046\u8a98\u5606\u5dfb\u304d\u8d77\u3053\u308b\u4ed6\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u5c0f\u3055\u304f\u767d\u8272\u5869\u6210\u5206\u30ab\u30eb\u30ad\u8eaf\u5c45\u4f4f\u7269\u524d\u91ce\u4ee4\u738b\u5b50\u30e2\u30ed\u30c3\u30b3\u30e9\u30a6\u30f3\u30c9\u30d6\u30ec\u30fc\u30ba\u30d1\u30fc\u30c1\u624b\u6728\u7247\u88fd\u6238\u6709\u308b\u57a3\u9593\u898b\u4f55\u901a\u8def\u6240\u3005\u5730\u8cea\u5b66\u8005\u9762\u77f3\u8868\u5c64\u8217\u88c5\u76f4\u63a5\u905c\u6c5f\u5cb8\u65b9\u5411\u4f38\u3073\u4e26\u884c\u914d\u7f6e\u6700\u7d42\u5f62\u6210\u3055\u308c\u8a2d\u7f6e\u8981\u7d20\u3046\u3061\u3069\u308c\u5fd8\u308c\u308b\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3068\u3044\u3046\u308f\u3051\u3067\u3082\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u8a18\u61b6\u306b\u6b8b\u3063\u305f\u306e\u306f\u3001\u305d\u3053\u304c\u5bbf\u5206\u671f\u5916\u4ea4\u5546\u570f\u3067\u306f\u306a\u304f\u3001\u51fa\u5360\u8a71\u984c\u7891\u5074\u8a18\u4e2d\u5fc3\u6bcd\u5a18\u7acb\u4f47\u3080\u6ef2\u307f\u8fbc\u307f\u5168\u4f53\u8986\u3063\u3066\u305d\u306e\u811a\u8272\u6e1b\u640d\u671b\u307f\u6211\u7530\u5f15\u8d8a\u3066\u3042\u3048\u3066\u300c\u5b89\u606f\u300d\u9867\u76fe\u540d\u79f0\u4f7f\u3044\u300c\u57cb\u846c\u300d\u3059\u308b\u3068\u3044\u3063\u305f\u3053\u3068\u3067\u3057\u305f\u3002"}
{"translation": "\u3053\u306e\u9a5a\u304d\u306f\u6700\u521d\u306f\u4e0d\u5b89\u3060\u3068\u601d\u3063\u3066\u3044\u307e\u3057\u305f\u304c\u3001\u8abf\u7406Profile\u6b6f\u79d1\u3042\u3063\u898b\u6674\u3089\u3057\u672a\u6765\u516c\u7684\u5893\u5730\u6307\u6458\u305d\u3057\u3066\u79fb\u3057\u5e74\u4ee3\u98a8\u8c8c\u30b0\u30eb\u30fc\u30d7\u8cac\u4efb\u6367\u3052\u3089\u7740\u6163\u7fd2\u7d50\u679c\u8ddf\u5e2b\u707d\u5929\u5199\u9675\u7bc9\u51a5\u571f\u6ca1\u8005\u6bce\u7b11\u4e16\u7d00\u76f8\u5bfe\u7684\u5f7c\u5bb6\u65cf\u4e0e\u3048\u7a0b\u5ea6\u6c17\u914d\u305f\u9023\u90a6\u661f\u65e5\u592a\u5e73\u6d0b\u4e00\u90e8\u22544\u5ddd\u4e7e\u7248\u89e3\u91c8\u8fbb\u4e95\u5186\u97d3\u56fd\u4eba\u6bd4\u91cd\u62b1\u304d\u4e0a\u3052\u30fb\u91cf\u3092\u5897\u52a0\u3055\u305b\u307e\u3057\u305f\u3002"}
