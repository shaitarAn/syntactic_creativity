{"translation": "\u300c\u3046\u305d\u3064\u3051\uff01\u300d\u3068\u79c1\u306f\u601d\u3063\u305f\u3002"}
{"translation": "\u30d6\u30ec\u30ed\u30c3\u30af\u3084\u5c0f\u6307\u306b\u306f\u3081\u305f\u30ea\u30f3\u30b0\u306f\u3001\u300c\u30d1\u30f3\u304f\u305a\u4e00\u6b20\u7247\u306e\u305f\u3081\u306b\u300d\u3068\u3044\u3046\u624b\u7d19\u3068\u307e\u3063\u305f\u304f\u77db\u76fe\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u305d\u308c\u306b\u30ab\u30df\u30b7\u30a7\u30d5\u306e\u9854\u3092\u3088\u304e\u308b\u308f\u305a\u304b\u3067\u3082\u898b\u3048\u308b\u96f2\u306f\u3001\u7d4c\u9a13\u8005\u306e\u773c\u306b\u6349\u3048\u3089\u308c\u308b\u3082\u306e\u3067\u3001\u305d\u308c\u306f\u6ec5\u591a\u306b\u4eba\u3005\u304c\u5618\u3092\u3064\u3044\u3066\u3044\u308b\u6642\u3060\u3051\u898b\u3089\u308c\u308b\u3082\u306e\u3060\u3002"}
{"translation": "\u300c\u3042\u306a\u305f\u306e\u7269\u8a9e\u306e\u30d7\u30ed\u30c3\u30c8\u306f\u4f55\u3067\u3059\u304b\uff1f\u300d\u3068\u79c1\u304c\u5c0b\u306d\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u30d7\u30ed\u30c3\u30c8\u3002\u3002\u3002"}
{"translation": "\u3069\u3046\u304a\u4f1d\u3048\u3059\u308c\u3070\u3088\u3044\u3067\u3057\u3087\u3046\uff1f"}
{"translation": "\u65b0\u9bae\u3055\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u611b\u3068\u6bba\u4eba\u3067\u3059\u3002"}
{"translation": "\u8aad\u3093\u3067\u307f\u3066\u304f\u3060\u3055\u3044\u3001\u3054\u89a7\u306b\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u201c\u5211\u4e8b\u88dc\u4f50\u5b98\u30e1\u30e2\u201d\u304b\u3089\u3067\u3059\u300d"}
{"translation": "\u30ab\u30e0\u30a4\u30b7\u30a7\u30d5\u306f\u305d\u306e\u512a\u3057\u3044\u77b3\u3067\u79c1\u3092\u898b\u4e0a\u3052\u3001\u305d\u3063\u3068\u7b11\u3063\u305f\u3002"}
{"translation": "\u3046\u3093\u3056\u308a\u3059\u308b\u4ed5\u4e8b\u3060\u3002"}
{"translation": "\u305b\u3063\u305b\u3068\u50cd\u304d\u3001\u632f\u308a\u6255\u3063\u3066\u3084\u3081\u3066\u3057\u307e\u3063\u305f\u3002"}
{"translation": "\u4eca\u306f\u4f55\u3082\u3084\u308b\u3053\u3068\u304c\u306a\u304f\u3001\u98df\u3079\u308b\u3082\u306e\u3055\u3048\u307b\u3068\u3093\u3069\u306a\u3044\u3002"}
{"translation": "\u3082\u3057\u3042\u306a\u305f\u304c\u79c1\u306e\u7269\u8a9e\u3092\u5370\u5237\u3057\u3066\u304f\u308c\u308c\u3070\uff08\u79c1\u306e\u9577\u6240\u3092\u7121\u8996\u3057\u3066\u3067\u3082\uff09\u3001\u305d\u308c\u306f\u5358\u306a\u308b\u52a9\u3051\u4ee5\u4e0a\u306e\u3082\u306e\u306b\u306a\u308b\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u79c1\u3092\u52a9\u3051\u3066\u304f\u308c\u307e\u3059\u3002"}
{"translation": "\u65b0\u805e\u306f\u6148\u5584\u4e8b\u696d\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3001\u305d\u308c\u306f\u5947\u5999\u306b\u30db\u30b9\u30d4\u30bf\u30ea\u30c6\u30a3\u30fc\u304c\u3042\u308b\u5bb6\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u79c1\u306f\u305d\u308c\u3092\u7406\u89e3\u3057\u3066\u3044\u307e\u3059\u304c\u3001\u3069\u3046\u304b\u3054\u89aa\u5207\u306b\u304a\u9858\u3044\u3057\u307e\u3059\u3002"}
{"translation": "\u300c\u5927\u5909\u3046\u308c\u3057\u3044\u3002"}
{"translation": "\u4f55\u304b\u304a\u624b\u4f1d\u3044\u3067\u304d\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u304b\uff1f\u300d\u3068\u521d\u5fc3\u8005\u30af\u30e9\u30b9\u306b\u53c2\u52a0\u3057\u305f\u304f\u3066\u7acb\u3061\u6b62\u307e\u3063\u305f\u4eba\u306f\u3001\u81ea\u5206\u306e\u8a34\u3048\u308b\u3088\u3046\u306a\u77b3\u3067\u5e8a\u3092\u898b\u3064\u3081\u306a\u304c\u3089\u8a00\u8449\u3092\u7d9a\u3051\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u79c1\u306f\u3042\u306a\u305f\u306e\u65b0\u805e\u306b\u63b2\u8f09\u3057\u3066\u307b\u3057\u3044\u5c0f\u3055\u306a\u7269\u8a9e\u3092\u6301\u3063\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u6b63\u76f4\u306b\u8a00\u3044\u307e\u3059\u304c\u3001\u7de8\u96c6\u8005\u3055\u3093\u3001\u79c1\u304c\u3053\u306e\u7269\u8a9e\u3092\u66f8\u3044\u305f\u76ee\u7684\u306f\u4f5c\u5bb6\u3068\u3057\u3066\u540d\u58f0\u3092\u5f97\u308b\u3053\u3068\u3084\u7518\u7f8e\u306a\u8cdb\u8f9e\u3092\u53d7\u3051\u308b\u305f\u3081\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u3053\u308c\u3089\u306e\u7d20\u6674\u3089\u3057\u3044\u3082\u306e\u306b\u5bfe\u3059\u308b\u8208\u596e\u306f\u3059\u3067\u306b\u6b73\u3092\u53d6\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u7d14\u7c8b\u306b\u5546\u696d\u7684\u52d5\u6a5f\u304b\u3089\u4f5c\u5bb6\u306e\u9053\u3078\u9032\u3080\u3064\u3082\u308a\u3067\u3059\u3002"}
{"translation": "\u304a\u91d1\u304c\u6b32\u3057\u3044\u3093\u3067\u3059\u3002"}
{"translation": "\u73fe\u5728\u3001\u79c1\u306f\u5168\u304f\u4ed5\u4e8b\u304c\u7121\u3044\u3093\u3067\u3059\u3088\u3002"}
{"translation": "\u88c1\u5224\u5b98\u635c\u67fb\u54e1\u3060\u3063\u305f\u3093\u3067\u3059\u3001S\u5730\u533a\u30675\u5e74\u4ee5\u4e0a\u52d9\u3081\u307e\u3057\u305f\u3051\u3069\u3001\u8caf\u91d1\u3082\u4e00\u6587\u7121\u304f\u3001\u307e\u305f\u7d14\u771f\u3055\u3082\u4fdd\u3066\u307e\u305b\u3093\u3067\u3057\u305f\u300d"}
{"translation": "\u300c\u305d\u308c\u306b\u3057\u3066\u3082\u5f7c\u306f\u591a\u304f\u3092\u8a71\u3059\u306d\u300d\u3068\u79c1\u306f\u601d\u3044\u3001\u30da\u30f3\u306b\u624b\u3092\u4f38\u3070\u3057\u3001\u305d\u308c\u3067\u81ea\u5206\u304c\u5fd9\u3057\u3044\u3053\u3068\u3092\u793a\u3057\u305f\u3002"}
{"translation": "\uff08\u305d\u306e\u6642\u3001\u8a2a\u554f\u8005\u305f\u3061\u306f\u79c1\u306b\u3068\u3063\u3066\u672c\u5f53\u306b\u3046\u3063\u3068\u3046\u3057\u304b\u3063\u305f\uff01\uff09"}
{"translation": "\u300c\u3042\u306a\u305f\u304b\u3089\u306f\u307b\u3093\u306e\u4e00\u77ac\u3060\u3051\u304a\u6642\u9593\u3092\u3044\u305f\u3060\u304d\u307e\u3059\uff01\u300d\u3068\u3001\u79c1\u306e\u4e3b\u4eba\u516c\u306f\u8b1d\u7f6a\u306e\u610f\u5473\u3092\u8fbc\u3081\u3066\u58f0\u3092\u7d9a\u3051\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u3057\u304b\u3057\u3001\u4f55\u3088\u308a\u3082\u5148\u306b\u81ea\u5df1\u7d39\u4ecb\u3055\u305b\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u6cd5\u5b66\u8005\u30a4\u30f4\u30a1\u30f3\u30fb\u30da\u30c8\u30ed\u30d3\u30c3\u30c1\u30fb\u30ab\u30fc\u30df\u30fc\u30b7\u30a7\u30d5\u3067\u3059\u3002"}
{"translation": "\u5143\u635c\u67fb\u5b98\u3067\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u66f8\u304f\u3053\u3068\u304c\u4ed5\u4e8b\u306e\u4eba\u3005\u306e\u4ef2\u9593\u5165\u308a\u3092\u3059\u308b\u6a5f\u4f1a\u306f\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u304c\u3001\u305d\u308c\u3067\u3082\u306a\u304a\u7d14\u7c8b\u306a\u4f5c\u5bb6\u5fd7\u5411\u3067\u3042\u306a\u305f\u306e\u6240\u3078\u3084\u3063\u3066\u6765\u307e\u3057\u305f\u3002"}
{"translation": "\u3042\u306a\u305f\u306e\u524d\u306b\u7acb\u3064\u7537\u6027\u306f\u3001\u300c\u59cb\u3081\u308b\u300d\u6b32\u671b\u304c\u3042\u308a\u307e\u3059, 40\u6b73\u8fd1\u304f\u307e\u3067\u9054\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u306a\u304c\u3089\u3001\u300c\u9045\u3059\u304e\u308b\u300d\u65b9\u304c\u300c\u5168\u304f\u7121\u3044\u300d\u3088\u308a\u826f\u3044\u3067\u3059\u304b\u3089\u300d\u3068\u5f7c\u306f\u8a00\u3063\u305f\u3002"}
{"translation": "\u5f7c\u304c\u79c1\u306e\u4e8b\u52d9\u5ba4\u306b\u5165\u3063\u305f\u3068\u304d\u3001\u5f7c\u306f\u6df7\u4e71\u3057\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u304a\u305d\u3089\u304f\u3001\u79c1\u306e\u3057\u304b\u3081\u3063\u3064\u3089\u306a\u4e0d\u6e80\u305d\u3046\u306a\u9854\u304c\u5f7c\u306e\u654f\u611f\u3067\u7e4a\u7d30\u306a\u6027\u683c\u3092\u30b7\u30e7\u30c3\u30af\u3055\u305b\u305f\u306e\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u300c\u3069\u3046\u304b\u304a\u8a31\u3057\u304f\u3060\u3055\u3044\uff01\u300d\u3068\u5f7c\u306f\u3084\u308f\u3089\u304b\u304f\u8c4a\u304b\u306a\u30d0\u30ea\u30c8\u30f3\u30dc\u30a4\u30b9\u3067\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u79c1\u306f\u3042\u306a\u305f\u306b\u6642\u9593\u3092\u7121\u7406\u306b\u53d6\u3063\u3066\u3082\u3089\u3044\u3001\u7279\u4f8b\u3092\u4f5c\u3063\u3066\u3082\u3089\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u3068\u3066\u3082\u5fd9\u3057\u3044\u3067\u3059\u306d\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u3053\u3053\u3067\u554f\u984c\u304c\u3042\u308a\u307e\u3059\u3001\u7de8\u96c6\u8005\u69d8\uff1a\u660e\u65e5\u3001\u975e\u5e38\u306b\u91cd\u8981\u306a\u7528\u4e8b\u3067\u30aa\u30c7\u30c3\u30b5\u306b\u51fa\u767a\u3057\u307e\u3059\u3002"}
{"translation": "\u4eca\u56de\u306e\u65c5\u884c\u3092\u571f\u66dc\u65e5\u307e\u3067\u5ef6\u671f\u3059\u308b\u53ef\u80fd\u6027\u304c\u3042\u308c\u3070\u3001\u4fe1\u3058\u3066\u304f\u3060\u3055\u3044\u3001\u7279\u5225\u63aa\u7f6e\u3092\u304a\u9858\u3044\u3059\u308b\u3064\u3082\u308a\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u79c1\u306f\u898f\u5247\u306b\u670d\u5f93\u3057\u307e\u3059\uff0c\u3060\u304b\u3089\u3053\u305d\u79e9\u5e8f\u3092\u611b\u3057\u3066\u3044\u307e\u3059\u300d"}
{"translation": "\u5f7c\u306e\u6817\u8272\u306e\u9aea\u3068\u3072\u3052\u306f\u3001\u30b7\u30eb\u30af\u306e\u3088\u3046\u306b\u6fc3\u304f\u3066\u67d4\u3089\u304b\u3044\u3002"}
{"translation": "\u67d4\u3089\u304b\u3044\u9aea\u306f\u3001\u67d4\u3089\u304b\u3067\u512a\u3057\u304f\u300c\u30b7\u30eb\u30af\u300d\u306e\u3088\u3046\u306a\u5fc3\u3092\u8868\u3059\u30b5\u30a4\u30f3\u3060\u3068\u8a00\u308f\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5927\u90e8\u5206\u306e\u72af\u7f6a\u8005\u3084\u90aa\u60aa\u3067\u9811\u56fa\u306a\u6027\u683c\u3092\u6301\u3064\u4eba\u3005\u306f\u3001\u786c\u3044\u9aea\u304c\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u304c\u771f\u304b\u3069\u3046\u304b\u3092\u8aad\u8005\u306b\u518d\u5ea6\u307f\u308b\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u9854\u9762\u8868\u60c5\u3084\u3072\u3052\u3001\u4f55\u3082\u5f7c\u304c\u30ea\u30dc\u30f3\u4ed8\u304d\u30b8\u30e3\u30b1\u30c3\u30c8\u3067\u3042\u308c\u3070\u305d\u308c\u4ee5\u4e0a\u306b\u67d4\u548c\u3067\u30c7\u30ea\u30b1\u30fc\u30c8\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u5927\u304d\u304f\u3066\u91cd\u305f\u3044\u4f53\u306e\u305d\u306e\u52d5\u304d\u3067\u3059\u3002"}
{"translation": "\u305d\u306e\u52d5\u4f5c\u304b\u3089\u4e01\u5be7\u3055\u3001\u8efd\u5feb\u3055\u3001\u512a\u96c5\u3055\u3055\u3048\u9006\u306a\u3089\u3054\u3081\u3093\u306a\u3055\u3044\u3053\u306e\u8a00\u8449\u4e00\u90e8\u5973\u6027\u3089\u3057\u3055\u304c\u898b\u3048\u307e\u3059\u3002"}
{"translation": "\u5f7c\u81ea\u8eab\u3042\u308b\u7a0b\u5ea6\u529b\u4e0a\u624b\u304f\u66f2\u3051\u308b\u99ac\u8e44\u5f62\u307e\u305f\u5fc3\u5909\u6b4c\u8a5e\u5c11\u91cf\u7bc0\u7d04\u88c5\u7f6e\u793a\u3055\u308c\u305f\u4e2d\u30d7\u30ed\u30da\u30e9\u63e1\u624b\u3059\u308b\u3053\u3068\u304c\u5fc5\u8981\u3067\u3059"}
{"translation": "\u3057\u304b\u3057\u9593\u7537\u751f\u7406\u5b66\u4e0a\u5f37\u529b\u793a\u3057\u3066\u5c45\u7121\u3057\u30c9\u30a2\u30ce\u30d6\u307e\u305f\u5e3d\u5b50\u53d6\u6271\u3063\u3066\u9069\u5ea6\u975e\u5e38\u63a5\u89e6\u30fb\u30d5\u30a1\u30a4\u30d0\u30fc\u30b9\u30ab\u30e9\u30fc\u30d0\u30bf\u30d5\u30e9\u30a4:\u511f\u5374\u304a\u305d\u308d\u3057\u6307\u653e\u5c04\u6295\u5f71\u5f0f\u9759\u9ed9\u30b9\u30c6\u30c3\u30d7\u63e1\u624b\u5f31\u7b4b\u3002"}
{"translation": "\u5f7c\u3092\u898b\u3066\u3044\u308b\u3068\u5fd8\u308c\u3066\u3057\u307e\u3046\u3001\u5f7c\u306f\u30b4\u30ea\u30a2\u30c6\u306e\u3088\u3046\u306b\u5f37\u5927\u3067\u529b\u5f37\u304f\u3001\u4e00\u3064\u306e\u624b\u30675\u4eba\u306e\u7de8\u96c6\u59d4\u54e1\u4f1a\u306e\u30a2\u30f3\u30c9\u30ec\u30a4\u304c\u6319\u3052\u3089\u308c\u306a\u3044\u3082\u306e\u3092\u6301\u3061\u4e0a\u3052\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}
{"translation": "\u898b\u305d\u306e\u8efd\u3084\u304b\u306a\u52d5\u304d\u3092\u4fe1\u3058\u3089\u308c\u307e\u305b\u3093\u5f7c\u304c\u6115\u7136\u3068\u91cd\u8005\u3067\u3059\u30b9\u30da\u30f3\u30b5\u30fc\u304a\u305d\u3089\u304f\u547c\u3070\u3060\u3055\u3044\u9996\u5c3e\u826f\u304f\u5b8c\u4e86\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u9854\u5168\u4f53\u304b\u3089\u306f\u5358\u7d14\u3055\u3001\u5e83\u7bc4\u3067\u8aa0\u5b9f\u306a\u6027\u8cea\u3001\u771f\u5b9f\u304c\u6e67\u304d\u4e0a\u304c\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u9854\u304c\u9b42\u306e\u93e1\u3060\u3068\u8a00\u3046\u306a\u3089\u3070\u3001\u79c1\u306f\u521d\u3081\u3066\u3053\u306e\u30b3\u30ab\u30fc\u30c9\u3064\u304d\u306e\u7d33\u58eb\u306b\u51fa\u4f1a\u3063\u305f\u65e5\u306b\u5f7c\u304c\u5618\u3092\u3064\u304f\u3053\u3068\u306f\u3067\u304d\u306a\u3044\u3068\u5fc3\u304b\u3089\u4fe1\u3058\u3089\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u79c1\u306f\u3082\u3061\u308d\u3093\u8ced\u3051\u306b\u51fa\u3066\u3082\u826f\u304b\u3063\u305f\u304f\u3089\u3044\u3067\u3059\u3002"}
{"translation": "\u305d\u306e\u8ced\u3051\u3092\u79c1\u304c\u52dd\u3064\u304b\u8ca0\u3051\u308b\u304b\u3001\u8aad\u8005\u306e\u7686\u3055\u3093\u306f\u3053\u308c\u304b\u3089\u898b\u308b\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u5f7c\u306f\u5148\u307b\u3069\u8ff0\u3079\u305f\u3088\u3046\u306b\u3001\u80cc\u304c\u9ad8\u304f\u80a9\u5e45\u304c\u5e83\u304f\u3001\u4f53\u306f\u3057\u3063\u304b\u308a\u3057\u3066\u304a\u308a\u3001\u826f\u3044\u50cd\u304d\u99ac\u306e\u3088\u3046\u3067\u3059\u3002"}
{"translation": "\u5f7c\u306e\u5168\u8eab\u304b\u3089\u306f\u5065\u5eb7\u3068\u529b\u3092\u611f\u3058\u3055\u305b\u307e\u3059\u3002"}
{"translation": "\u9854\u8272\u306f\u30d4\u30f3\u30af\u306b\u8fd1\u304f\u3001\u624b\u306f\u5927\u304d\u304f\u3001\u80f8\u677f\u306f\u5e83\u3044\u9aa8\u592a\u3067\u7b4b\u8089\u8cea\u3067\u3042\u308a\u3001\u9aea\u306e\u6bdb\u3082\u5065\u5eb7\u306a\u5c11\u5e74\u306e\u3088\u3046\u306b\u6fc3\u3044\u3067\u3059\u3002"}
{"translation": "\u5f7c\u306f40\u6b73\u9803\u3060\u3068\u601d\u3044\u307e\u3059\u3002"}
{"translation": "\u7740\u98fe\u3063\u3066\u304a\u308a\u6700\u65b0\u30e2\u30fc\u30c9\u306e\u30d5\u30ec\u30c3\u30b7\u30e5\u306a\u30b8\u30e3\u30fc\u30b8\u30fc\u30c6\u30a4\u30e9\u30fc\u30c9\u30b9\u30fc\u30c4\u3092\u8eab\u306b\u307e\u3068\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u80f8\u5143\u306b\u5927\u304d\u306a\u91d1\u88fd\u30c1\u30a7\u30fc\u30f3\u3068\u30d5\u30a1\u30c3\u30b7\u30e7\u30ca\u30d6\u30eb\u306a\u30d6\u30ec\u30ed\u30c3\u30af\u304c\u3042\u308a\u3001\u6b4c\u59eb\u6307\u8f2a\u306b\u5c0f\u3055\u3044\u660e\u308b\u3044\u661f\u3005\u304c\u9583\u5149\u3092\u653e\u3061\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u4f55\u3088\u308a\u91cd\u8981\u306a\u3053\u3068-\u305d\u3057\u3066\u305d\u306e\u5c0f\u8aac\u3084\u7269\u8a9e\u5185\u3067\u4efb\u610f\u7684\u30d2\u30fc\u30ed\u30fc\u30ba\u305f\u3081\u305d\u308c\u4f59\u7a0b\u975e\u5e38\u8b58\u3067\u306f\u30fb\u5f7c\u7279\u5225\u7537\u6027\u7f8e\u5bb9\u7684\u7f8e\u3057\u3044\u3067\u3059\u3002"}
{"translation": "\u79c1\u81ea\u8eab \u5973\u6027\u307e\u305f\u82b8\u8853\u5bb6\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u304b\u3089, \u7537\u6027\u7f8e\u5bb9\u77e5\u308c\u308a\u5c11\u3057\u3060\u3051\u3066\u308f\u304b\u3063\u305f\u3060\u3051\u3069,\u7740\u5263\u52f2\u7ae0\u3055\u3093\u5916\u89b3\u79c1\u5370\u8c61\u5f37\u77ed\u606f\u611f\u529b\u3057\u307e\u3059\u3002"}
{"translation": "\u5f7c\u5927\u69cb\u9020\u96c4\u98a8\u6eb6\u89e3\u9854 \u52b4\u82e6\u5370\u8c61\u79c1\u6c38\u304f\u5fc3\u306b\u7559\u307e\u308a\u307e\u3059\u3002"}
{"translation": "\u672c\u9854\u3067\u3042\u306a\u305f\u771f\u5b9f\u30ae\u30ea\u30b7\u30e3\u4eba\u9f3b\u91ce\u5c71\u304b\u3089\u5c0f\u3055\u306a\u51f8\u90e8,\u7d30\u53e3\u5507,\u7f8e\u3057\u3044\u30d6\u30eb\u30fc\u76ee\u3092\u898b\u304b\u3051\u307e\u3059\u3002"}
{"translation": "\u5f7c\u3089\u306e\u80f8\u306b\u306f\u5584\u826f\u3055\u3068\u4f55\u304b\u304c\u5149\u3063\u3066\u304a\u308a\u3001\u305d\u308c\u306b\u9069\u5207\u306a\u540d\u524d\u3092\u3064\u3051\u308b\u306e\u306f\u56f0\u96e3\u3067\u3059\u3002"}
{"translation": "\u3053\u306e\u300c\u4f55\u304b\u300d\u306f\u3001\u5c0f\u52d5\u7269\u306e\u76ee\u3067\u898b\u3066\u53d6\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}
{"translation": "\u5f7c\u3089\u304c\u6182\u3046\u3064\u3067\u3042\u3063\u305f\u308a\u82e6\u75db\u3092\u611f\u3058\u3066\u3044\u305f\u308a\u3059\u308b\u6642\u3067\u3059\u3002"}
{"translation": "\u300c\u6c42\u3081\u308b\u3082\u306e\u300d\u3001\u300c\u5e7c\u5c11\u300d\u3001\u300c\u9ed9\u3063\u3066\u8010\u3048\u5fcd\u3076\u3082\u306e\u300d\u3068\u3067\u3082\u3044\u3046\u3079\u304d\u3060\u308d\u3046\u304b\uff1f"}
{"translation": "\u8ce2\u304f\u3066\u975e\u5e38\u306b\u8061\u660e\u306a\u4eba\u3005\u306f\u3001\u307e\u308c\u306b\u305d\u3093\u306a\u773c\u5dee\u3057\u3092\u6301\u3061\u5408\u308f\u305b\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u79c1\u306f\u305f\u3081\u606f\u3092\u3064\u304d\u3001\u30da\u30f3\u3092\u7f6e\u3044\u3066\u3001\u30b3\u30ab\u30fc\u30c9\u306e\u3064\u3044\u305f\u7d33\u58eb\u3092\u5f85\u3061\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u65b0\u9032\u306e\u4f5c\u5bb6\u3084\u4e00\u822c\u7684\u306b\u7de8\u96c6\u90e8\u306e\u79d8\u5bc6\u306b\u901a\u3058\u3066\u3044\u306a\u3044\u4eba\u3005\u306f\u3001\u300c\u7de8\u96c6\u90e8\u300d\u3068\u3044\u3046\u8a00\u8449\u304c\u51fa\u308b\u3068\u795e\u8056\u306a\u6050\u6016\u306b\u304a\u3073\u3048\u3066\u3057\u307e\u3046\u3053\u3068\u304b\u3089\u3001\u5f7c\u3089\u81ea\u8eab\u3092\u5f85\u305f\u305b\u308b\u6642\u9593\u3082\u5c11\u306a\u304f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u5f7c\u3089\u306f\u3001\u300c\u3069\u3046\u305e\u300d\u3068\u3044\u3046\u7de8\u96c6\u9577\u306e\u547c\u3073\u639b\u3051\u5f8c\u3001\u3057\u3070\u3089\u304f\u54b3\u304d\u8fbc\u3093\u3060\u308a\u3001\u9f3b\u3092\u304b\u3093\u3060\u308a\u3057\u3066\u6642\u9593\u3092\u6d78\u3057,\u30c9\u30a2\u30aa\u30fc\u30d7\u30f3\u3059\u308b\u30b9\u30d4\u30fc\u30c9\u3082\u9045\u304f,\u307e\u305f\u305d\u306e\u30b9\u30d4\u30fc\u30c9\u3067\u5165\u3063\u3066\u304f\u308b\u306e\u304c\u666e\u901a\u3067,\u305d\u308c\u306b\u3088\u3063\u3066\u304b\u306a\u308a\u591a\u304f\u306e\u6642\u9593\u304c\u596a\u308f\u308c\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u306a\u304c\u3089, \u30b3\u30ab\u30fc\u30c9\u3064\u304d\u7d33\u58eb\u30ed\u30c3\u30af\u30ce\u30fc\u30c8\u306f\u81ea\u5206\u81ea\u8eab\u304c\u671f\u5f85\u3055\u305b\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "\u30a2\u30f3\u30c9\u30ec\u30a4\u5f8c\u308dcribed\u9589\u3058\u30c9\u30a2\u30c1\u30e3\u30f3\u30d9\u30eb\u77e5\u3063\u898b\u3042\u5b9f\u304bassuit\u4e0e\u3048\u3061\u6253\u624b\u5915\u307f\u3063\u30ad\u30d3\u5358_\u6301\u30b3\u30ab\u30fcdrankcap\u3055\u308c\u4fddshuffle\u5eca\u7740\u7269\u3002"}
{"translation": "\u3053\u306e\u3088\u3046\u306b\u79c1\u3068\u4f1a\u898b\u3059\u308b\u3053\u3068\u6295with\u6210\u679c\u7269back\u7684man\u610fthing\u305d\u91cd\u5927\u30ed\u30fc\u30eb\u3002"}
{"translation": "\u663e\u5916\u98db\u65ad\ud558unavoid\u5b83\u5fc5\u9700\u54c1\u5c3a\u5bf8\u5f69\u8272\u5176fit\u8868f-termination\u7684\u5730\u65b9"}
{"translation": "1880\u5e74\u306e4\u6708\u306e\u3042\u308b\u65e5\u3001\u30a2\u30f3\u30c9\u30ec\u30a4\u3068\u3044\u3046\u8b66\u5099\u54e1\u304c\u79c1\u306e\u30aa\u30d5\u30a3\u30b9\u306b\u5165\u3063\u3066\u304d\u3066\u3001\u306a\u3093\u3068\u3082\u795e\u79d8\u7684\u306b\u544a\u3052\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u7de8\u96c6\u90e8\u306b\u4f55\u304b\u3057\u3089\u306e\u7d33\u58eb\u304c\u8a2a\u308c\u3066\u3044\u3066\u3001\u7de8\u96c6\u9577\u3068\u306e\u9762\u4f1a\u3092\u5f37\u304f\u6c42\u3081\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u304a\u305d\u3089\u304f\u5f79\u4eba\u3067\u3057\u3087\u3046\uff0c\u5f7c\u306f\u52f2\u7ae0\u3092\u3064\u3051\u3066\u3044\u307e\u3059\u300d\u3068\u30a2\u30f3\u30c9\u30ec\u30a4\u306f\u4ed8\u3051\u52a0\u3048\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u4ed6\u306e\u6642\u9593\u306b\u6765\u308b\u3088\u3046\u306b\u4f1d\u3048\u306a\u3055\u3044\u3002"}
{"translation": "\u300d\u79c1\u306f\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u4eca\u65e5\u306f\u5fd9\u3057\u3044\u3002\u571f\u66dc\u65e5\u3060\u3051\u7a93\u53e3\u3092\u958b\u653e\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u4f1d\u3048\u306a\u3055\u3044\u3002"}
{"translation": "\u300c\u3057\u304b\u3057\u5f7c\u306f3\u65e5\u524d\u306b\u3082\u6765\u305f\u3093\u3067\u3059\uff0c\u3042\u306a\u305f\u304c\u3069\u3053\u304b\u3067\u4e91\u3063\u305f\u3093\u3067\u3059\u3002"}
{"translation": "\u5927\u4e8b\u306a\u7528\u4ef6\u3060\u304b\u3089\u6765\u305f\u305d\u3046\u3067\u3059\u3002\u5fc5\u6b7b\u3067\u983c\u307f\u307e\u3059\uff0c\u6ce3\u304d\u305d\u3046\u3059\u3089\u3044\u307e\u3059\u3002"}
{"translation": "\u201c\u571f\u66dc\u65e5\u3067\u306f\u90fd\u5408\u304c\u3064\u304b\u306a\u3044\u3002\u3002\u3002"}
{"translation": "\u201d \u305d\u308c\u3058\u3083\u9762\u4f1a\u3055\u305b\u307e\u3059\uff1f\u300d"}
