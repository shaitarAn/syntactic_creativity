{"translation": "\u300c\u5618\u3064\u304d\u3060\uff01\u300d\u3068\u79c1\u306f\u601d\u3063\u305f\u3002"}
{"translation": "\u30d6\u30ec\u30ed\u30c3\u30af\u3068\u5c0f\u6307\u306e\u30ea\u30f3\u30b0\u306f\u3001\u30d1\u30f3\u5207\u308c\u306e\u305f\u3081\u306e\u624b\u7d19\u3068\u3042\u307e\u308a\u3046\u307e\u304f\u5408\u308f\u306a\u304b\u3063\u305f\u3057\u3001\u30ab\u30e0\u30a4\u30b7\u30a7\u30d5\u306e\u9854\u306b\u306f\u3001\u7d4c\u9a13\u8c4a\u5bcc\u306a\u76ee\u3067\u6349\u3048\u3089\u308c\u308b\u5fae\u7d30\u306a\u3001\u307b\u3093\u306e\u4e00\u77ac\u901a\u308a\u904e\u304e\u308b\u96f2\u304c\u6d6e\u304b\u3093\u3067\u3044\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u307b\u3068\u3093\u3069\u5618\u3092\u3064\u304f\u4eba\u3005\u306e\u9854\u306b\u3057\u304b\u898b\u3089\u308c\u306a\u3044\u3082\u306e\u3060\u3002"}
{"translation": "\u300c\u3042\u306a\u305f\u304c\u66f8\u304f\u8a71\u306e\u30c6\u30fc\u30de\u306f\u4f55\u3067\u3059\u304b\uff1f\u300d"}
{"translation": "\u79c1\u304c\u5c0b\u306d\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u30c6\u30fc\u30de\u3067\u3059\u304b\u3002"}
{"translation": "\u3069\u3046\u8aac\u660e\u3057\u305f\u3089\u826f\u3044\u3067\u3057\u3087\u3046\u304b\uff1f"}
{"translation": "\u30c6\u30fc\u30de\u81ea\u4f53\u306f\u4f55\u3082\u65b0\u3057\u304f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u611b\u60c5\u3068\u6bba\u4eba\u3067\u3059\u3002"}
{"translation": "\u3042\u306a\u305f\u3060\u3051\u8aad\u3093\u3067\u307f\u3066\u304f\u3060\u3055\u3044\u3001\u305d\u3053\u3067\u5206\u304b\u308b\u3067\u3057\u3087\u3046\u300d \u300c\u88c1\u5224\u5b98\u88dc\u4f50\u5b98\u30e1\u30e2\u300d"}
{"translation": "\u30ab\u30df\u30fc\u30b7\u30a7\u30d5\u306f\u512a\u3057\u3044\u76ee\u3067\u79c1\u3092\u898b\u4e0a\u3052\u3001\u9759\u304b\u306b\u7b11\u3063\u305f\u3002"}
{"translation": "\u9000\u5c48\u306a\u4ed5\u4e8b\u3060\u3063\u305f\u3002"}
{"translation": "\u4f55\u5e74\u3082\u50cd\u304d\u7d9a\u3051\u3001\u6700\u7d42\u7684\u306b\u306f\u624b\u3092\u632f\u308a\u53bb\u3063\u3066\u8f9e\u8077\u3057\u305f\u306e\u3067\u3059\u3002"}
{"translation": "\u4eca\u306f\u4f55\u3082\u3059\u308b\u3053\u3068\u304c\u306a\u304f\u3001\u98df\u3079\u308b\u3082\u306e\u3059\u3089\u307b\u3068\u3093\u3069\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u3067\u3059\u304b\u3089\u3001\u3042\u306a\u305f\u304c\u79c1\u306e\u7269\u8a9e\u3092\u305d\u306e\u4fa1\u5024\u3092\u7121\u8996\u3057\u3066\u5370\u5237\u3057\u3066\u304f\u308c\u308c\u3070\u3001\u305f\u3060\u306e\u6069\u6075\u4ee5\u4e0a\u306e\u3053\u3068\u3092\u3059\u308b\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u306f\u79c1\u306b\u52a9\u3051\u3066\u304f\u308c\u308b\u3068\u3044\u3046\u610f\u5473\u3067\u3067\u3059\u3002"}
{"translation": "\u65b0\u805e\u793e\u306f\u6148\u5584\u56e3\u4f53\u3067\u3082\u53d7\u3051\u5165\u308c\u6240\u3067\u3082\u3042\u308a\u307e\u305b\u3093\u3001\u305d\u308c\u306f\u308f\u304b\u3063\u3066\u3044\u307e\u3059\u304c\u3002\u3002\u3002"}
{"translation": "\u305d\u3046\u3055\u305b\u3066\u304f\u3060\u3055\u3044\u3002\u201d"}
{"translation": "\u300c\u5927\u5909\u559c\u3070\u3057\u3044\u3002"}
{"translation": "\u4f55\u304b\u304a\u624b\u4f1d\u3044\u3067\u304d\u308b\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u304b\uff1f\u300d"}
{"translation": "\u305d\u3057\u3066\u5f7c\u306f\u5f15\u304d\u7d9a\u304d\u3001\u305d\u306e\u50ac\u4fc3\u3059\u308b\u76ee\u3067\u5e8a\u3092\u898b\u3064\u3081\u306a\u304c\u3089\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u79c1\u306f\u3042\u306a\u305f\u306b\u3001\u6211\u3005\u306e\u65b0\u805e\u306b\u63b2\u8f09\u3057\u305f\u304f\u601d\u3046\u5c0f\u3055\u306a\u7269\u8a9e\u3092\u304a\u6301\u3061\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u7de8\u96c6\u9577\u69d8\u3001\u79c1\u306f\u6b63\u76f4\u306b\u7533\u3057\u4e0a\u3052\u307e\u3059\u304c\u3001\u3053\u306e\u7269\u8a9e\u3092\u66f8\u3044\u305f\u52d5\u6a5f\u306f\u4f5c\u8005\u3068\u3057\u3066\u306e\u540d\u58f0\u3084\u7f8e\u597d\u306e\u97f3\u8272\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u3053\u308c\u3089\u7d20\u6674\u3089\u3057\u3044\u3082\u306e\u306b\u3064\u3044\u3066\u306f\u65e2\u306b\u6b73\u3092\u91cd\u306d\u3059\u304e\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u308f\u3051\u3067\u3082\u3046\u5546\u696d\u7684\u306a\u52d5\u6a5f\u304b\u3089\u4f5c\u5bb6\u6d3b\u52d5\u3092\u59cb\u3081\u307e\u3057\u305f - \u304a\u91d1\u304c\u5fc5\u8981\u3060\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u73fe\u5728\u79c1\u306f\u78ba\u56fa\u305f\u308b\u4ed5\u4e8b\u3082\u6301\u3063\u3066\u3044\u307e\u3059\u307e\u305b\u3093\u3002"}
{"translation": "\u4ee5\u524dS\u5730\u533a\u3067\u88c1\u5224\u5b98\u3068\u3057\u3066\u77e5\u3063\u3066\u3044\u307e\u3059\u304c\u4e94\u5e74\u4ee5\u4e0a\u52d9\u3081\u307e\u3057\u305f\u304c,\u8ca1\u7523\u3082\u5f97\u3089\u308c\u305a,\u7121\u4e8b\u6545\u4fdd\u8a3c\u8cc7\u683c\u3059\u3089\u4fdd\u3066\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u300d"}
{"translation": "\u300c\u307e\u3042\u3001\u3088\u304f\u8a71\u3059\u4eba\u3060\u306a\u300d\u3068\u79c1\u306f\u601d\u3044\u306a\u304c\u3089\u30da\u30f3\u3092\u53d6\u308a\u59cb\u3081\u3001\u305d\u308c\u3067\u81ea\u5206\u304c\u5fd9\u3057\u3044\u3053\u3068\u3092\u793a\u3057\u305f\u3002"}
{"translation": "\uff08\u3042\u306e\u3053\u308d\u6765\u5ba2\u306b\u306f\u3046\u3093\u3056\u308a\u3057\u3066\u3044\u305f\uff09"}
{"translation": "\u300c\u4e00\u5206\u9593\u3060\u3051\u3067\u3082\u304a\u6642\u9593\u3092\u304f\u3060\u3055\u3044\u300d\u3068\u3001\u8a71\u4e3b\u306e\u7537\u6027\u306f\u8a31\u3057\u3092\u8acb\u3046\u3088\u3046\u306a\u58f0\u3067\u7d9a\u3051\u305f\u3002"}
{"translation": "\u300c\u3060\u304c\u4f55\u3088\u308a\u3082\u3001\u81ea\u5df1\u7d39\u4ecb\u3059\u308b\u3053\u3068\u3092\u8a31\u53ef\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u79c1\u306e\u540d\u524d\u306f\u30a4\u30f4\u30a1\u30f3\u30fb\u30da\u30c8\u30ed\u30f4\u30a3\u30c1\u30fb\u30ab\u30e0\u30a3\u30b7\u30a7\u30d5\u3001\u6cd5\u5b66\u58eb\u3067\u5143\u88c1\u5224\u8abf\u67fb\u5b98\u3067\u3059\u3002"}
{"translation": "\u4f5c\u5bb6\u306e1\u54e1\u306b\u5c5e\u3059\u308b\u540d\u8a89\u306f\u306a\u3044\u3067\u3059\u304c\u3001\u305d\u308c\u3067\u3082\u7d14\u7c8b\u306b\u57f7\u7b46\u76ee\u7684\u3067\u304a\u4f3a\u3044\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u56db\u5341\u6b73\u8fd1\u304f\u3068\u3044\u3046\u8eab\u304b\u3089\u5171\u611f\u8005\u3068\u3057\u3066\u7acb\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\"\u9045\u304f\u3066\u3082\u30de\u30b7\"\u3067\u3059\u304b\u3089\u306d\u300d"}
{"translation": "\u5f7c\u304c\u79c1\u306e\u4e8b\u52d9\u5ba4\u306b\u5165\u3063\u305f\u3068\u304d\u3001\u5f7c\u306f\u5c11\u3057\u52d5\u63fa\u3057\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u304a\u305d\u3089\u304f\u3001\u79c1\u306e\u3057\u304b\u3081\u9762\u3068\u4e0d\u6a5f\u5acc\u306a\u8868\u60c5\u304c\u5f7c\u306e\u7e4a\u7d30\u3067\u654f\u611f\u306a\u6027\u683c\u3092\u30b7\u30e7\u30c3\u30af\u3055\u305b\u305f\u3093\u3058\u3083\u306a\u3044\u3067\u3057\u3087\u3046\u304b\u3002"}
{"translation": "\u300c\u5927\u5909\u7533\u3057\u8a33\u3042\u308a\u307e\u305b\u3093\uff01\u795e\u69d8\u306e\u540d\u306b\u304a\u3044\u3066\u300d\u3068\u5f7c\u306f\u67d4\u3089\u304b\u304f\u8c4a\u304b\u306a\u30d0\u30ea\u30c8\u30f3\u58f0\u3067\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u7121\u793c\u3092\u627f\u77e5\u3067\u3001\u7d04\u675f\u3055\u308c\u305f\u6642\u523b\u4ee5\u5916\u306b\u3042\u306a\u305f\u306e\u5143\u3092\u8a2a\u308c\u3001\u4f8b\u5916\u7684\u306b\u3042\u3064\u304b\u3044\u307e\u3059\u3088\u3046\u8981\u8acb\u3057\u307e\u3059\u3002"}
{"translation": "\u3069\u308c\u307b\u3069\u5fd9\u3057\u304f\u3055\u308c\u3066\u964d\u308b\u3053\u3068\u3067\u3059\u30fb\u30fb\u30fb"}
{"translation": "\u3067\u3082\u307b\u3089\u3001\u554f\u984c\u306f\u3053\u308c\u3067\u3059\u3088"}
{"translation": "\u5c02\u52d9\uff1a \u79c1\u306f\u660e\u65e5\u975e\u5e38\u306b\u91cd\u8981\u306a\u4e8b\u60c5\u304b\u3089\u30aa\u30c7\u30c3\u30b5\u3078\u51fa\u767a\u3059\u308b\u4e88\u5b9a\u3060\u304b\u3089\u3002"}
{"translation": "\u3053\u306e\u65c5\u884c\u3092\u571f\u66dc\u65e5\u307e\u3067\u5ef6\u671f\u3059\u308b\u6a5f\u4f1a\u3055\u3048\u3042\u308c\u3070\u3001\u78ba\u4fe1\u3057\u3066\u3044\u307e\u3059\u304c\u3001\u300c\u9060\u616e\u3057\u307e\u3059\u300d\u3084\u3063\u3066\u3082\u7686\u3055\u3093\u7279\u4f8b\u3092\u6c42\u3081\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3057\u306d\u3002"}
{"translation": "\u79c1\u81ea\u8eab\u898f\u5247\u3084\u898f\u7a0b\u6df1\u304f\u5c0a\u91cd\u3057\u307e\u3059\u2015\u4f55\u6545\u305d\u308c\u3089\u304c\u79e9\u5e8f\u305d\u306e\u3082\u306e\u3060\u304b\u3089\u3068\u3046\u3061\u3042\u3051\u307e\u3059\u300d"}
{"translation": "\u305d\u306e\u305f\u3066\u304c\u307f\u306e\u3088\u3046\u306a\u6817\u8272\u306e\u9aea\u3068\u3072\u3052\u306f\u3001\u96f2\u4e39\u306e\u3088\u3046\u306b\u8c4a\u304b\u3067\u67d4\u3089\u304b\u3044\u3002"}
{"translation": "\u8a00\u308f\u308c\u3066\u3044\u308b\u3053\u3068\u306b\u306f\u3001\u67d4\u3089\u304b\u3044\u9aea\u306f\u3001\u5fc3\u304c\u512a\u3057\u304f\u3066\u7e4a\u7d30\u3067\u3001\u300c\u30b7\u30eb\u30af\u306e\u3088\u3046\u306a\u300d\u4eba\u9593\u6027\u3092\u793a\u3059\u3082\u306e\u3060\u3068\u3044\u3046\u3002"}
{"translation": "\u72af\u7f6a\u8005\u3084\u60aa\u8005\u3001\u9811\u56fa\u306a\u6027\u683c\u3092\u6301\u3064\u4eba\u3005\u306b\u306f\u5927\u62b5\u786c\u3044\u9aea\u304c\u3042\u308b\u3068\u3044\u3046\u3002"}
{"translation": "\u3053\u308c\u304c\u672c\u5f53\u304b\u3069\u3046\u304b\u306f\u8aad\u8005\u306b\u307e\u305f\u898b\u305b\u307e\u3057\u3087\u3046\u3002"}
{"translation": "\u9854\u3064\u304d\u3067\u3082\u3072\u3052\u3067\u3082\u4f55\u4e00\u3064\u5f7c\u81ea\u8eab\u3092\u7518\u7f8e\u3055\u3084\u512a\u96c5\u3055\u3067\u6575\u308f\u305b\u308b\u3053\u3068\u304c\u3067\u304d\u306a\u3044\u3082\u306e\u304c\u3042\u308b\u3068\u3059\u308c\u3070\u3001\u305d\u308c\u306f\u5f7c\u306e\u5927\u304d\u304f\u91cd\u539a\u306a\u4f53\u8eaf\u306e\u52d5\u304d\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u3089\u629c\u3051\u3066\u6ed1\u308a\u51fa\u3059\u6240\u4f5c\uff08\u305d\u305d\uff09\u304b\u3089\u6d17\u7df4\u3055\u308c\u305f\u4e0a\u54c1\u3055\u3084\u6c17\u3061\u3081\u3093\u3055\u3084\u50cf\u7709\u5909\u3048\u3053\u306e\u8868\u73fe\u3092\u304a\u3086\u308b\u3057\u304f\u3060\u3055\u3044\u5225\u7a2e\u500b\u4f53\u80cc\u5973\u6027\u6027\u3059\u308b\u4e8b\u3067\u3059\u3002"}
{"translation": "\u8e44\u9244\u5c48\u3080\u52a9\u3051\u305f\u308a\u30b5\u30fc\u30c7\u30a4\u30f3\u30dc\u30c3\u30af\u30b9\u63e1\u624b\u5c0f\u6307\u3064\u3076\u3057\u305f\u308a\u3059\u308b\u305d\u308c\u7a0b\u5ea6\u529b\u8cbb\u8cbb\u91d1\u5316\u5fc5\u8981\u3057\u3066\u5f7c\u4f55\u52dd\u6c17\u53ea\u5805\u5ba4\u85cf\u767b\u5965\u5f37\u58ee\u305d\u7247\u5074\u63e1\u624b\u80cc\u9762\u8868\u793a\u7279\u7570\u7269\u7406\u5b66\u529b\u7279\u7570\u6027\u3002"}
{"translation": "\u30c9\u30a2\u30ce\u30d6\u53c8\u306f\u5e3d\u5b50\u6301\u3061\u4e0a\u3052\u305f\u3044\u3068\u3059\u308b\u3068\u3001\u307e\u308b\u3067\u8776\u304b\u3089\u898b\u639b\u3051\u305f\u304b\u306e\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u624b\u53e3\u306f\u7e4a\u7d30\u3067\u3001\u7528\u5fc3\u6df1\u304f\u3001\u6307\u5148\u3060\u3051\u3067\u89e6\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\u306e\u6b69\u307f\u306f\u97f3\u3092\u7acb\u3066\u305a\u3001\u63e1\u624b\u306f\u5f31\u3044\u3067\u3059\u3002"}
{"translation": "\u5f7c\u3092\u898b\u3066\u3044\u308b\u3068\u8c6a\u96c4\u756a\u53f7\u56fa\uff08\u7b11\uff09\u308a\u5199\u50cf\u91ce\u529b\u5341\u8db3\u60f3\u5b9a\u610f\u5473\u3057\u307e\u3059\u6642\u4e94\u4eba\u7de8\u96c6\u9577\u90e8\u5c4b\u8077\u56fa\u3057\u3087\u3057\u3088\u3063\u7389\u6c82\u6210\u529f\u6b21\u7b2c\u5965\u529b\u51fa\u8cbb\u3057\u3066\u4e00\u3064\u8155\u529b\u89e6\u308c\u767b\u5186\u9ad8\u91cd\u821e\u9054\u6607\u4e16\u6240\u5316\u66b4\u5909\u525b\u5065\u3086\u3048\u3042\u308b\u3053\u3068\u3092\u5fd8\u308c\u307e\u3059\u3002"}
{"translation": "\u4f55\u4fe1\u3058\u96e3\u3044\u3053\u4e8b\u3055\u3089\u3001\u3001\u512a\u96c5\u672c\u4f53\u59ff\u52e2\u4e0b\u8096\u50cf\u4e21\u65b9\u5206\u5e03\u7167\u660e\u5229\u56e0\u5f79\u4eba\u7121\u9813\u7740\u53cb\u543e\u5bb6\u6765\u5ddd\u3072\u5b5f\u6309\u6b04\u6975\u5c0f"}
{"translation": "\u305d\u306e\u9854\u5168\u4f53\u304b\u3089\u306f\u3001\u7d14\u7c8b\u3067\u5e83\u3044\u5fc3\u3092\u6301\u3064\u4e0b\u4eba\u3089\u3057\u3055\u3001\u771f\u5b9f\u304c\u6e67\u304d\u51fa\u3066\u3044\u308b\u304b\u306e\u3088\u3046\u3067\u3042\u3063\u305f\u3002"}
{"translation": "\u3082\u3057\u3001\u9854\u304c\u9b42\u306e\u93e1\u3060\u3068\u8a00\u3046\u306e\u304c\u5618\u3067\u306f\u306a\u3044\u306a\u3089\u3001\u521d\u3081\u3066\u3053\u306e\u7d0b\u7ae0\u4ed8\u304d\u6c0f\u3068\u51fa\u4f1a\u3063\u305f\u65e5\u306b\u306f\u5f7c\u304c\u5618\u3092\u3064\u304f\u3053\u3068\u306a\u3069\u7d76\u5bfe\u306b\u3042\u308a\u3048\u306a\u3044\u3068\u3046\u3051\u3042\u3063\u3066\u3055\u3048\u826f\u304b\u3063\u305f\u3057\u3001\u305d\u308c\u3069\u3053\u308d\u304b\u8ced\u3051\u3059\u3089\u3057\u3066\u3082\u826f\u304b\u3063\u305f\u306b\u3061\u304c\u3044\u306a\u3044\u3002"}
{"translation": "\u79c1\u304c\u305d\u306e\u8ced\u3051\u306b\u8ca0\u3051\u308b\u304b\u52dd\u3064\u304b\u306f\u8aad\u3080\u8005\u8af8\u541b\u81ea\u8eab\u304a\u76ee\u306b\u898b\u308b\u307e\u3067\u3002"}
{"translation": "\u5f7c\u306b\u3064\u3044\u3066\u65e2\u306b\u8ff0\u3079\u305f\u3088\u3046\u306b\u3001\u8eab\u9577\u304c\u9ad8\u304f\u80a9\u5e45\u5e83\u304f\u3001\u826f\u8cea\u306e\u4ed5\u4e8b\u99ac\u3068\u540c\u69d8\u3001\u5168\u8eab\u304b\u3089\u306f\u5065\u5eb7\u3068\u529b\u5f37\u3055\u3092\u653e\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u30d4\u30f3\u30af\u8272\u306e\u9854\u7acb\u3061\u3001\u5927\u304d\u306a\u624b\u3001\u5e83\u3044\u7b4b\u8089\u8cea\u306a\u80f8\u90e8\u3001\u5fc3\u5065\u3084\u304b\u306a\u5c11\u5e74\u306e\u3088\u3046\u306a\u592a\u304f\u3075\u3055\u3075\u3055\u3057\u305f\u9aea\u3002"}
{"translation": "\u5e74\u9f62\u306f40\u6b73\u4ee5\u4e0b\u3067\u3059\u3002"}
{"translation": "\u5f7c\u306f\u65b0\u3057\u304f\u6700\u8fd1\u7e2b\u88fd\u3055\u308c\u305f\u30b9\u30bf\u30a4\u30ea\u30c3\u30b7\u30e5\u3067\u6700\u65b0\u30d5\u30a1\u30c3\u30b7\u30e7\u30f3\u7684\u306a\u670d\u88c5\u3092\u3057\u3066\u304a\u308a\u307e\u3059\u3002"}
{"translation": "\u80f8\u5143\u306b\u306f\u5927\u304d\u306a\u30b4\u30fc\u30eb\u30c9\u30c1\u30a7\u30fc\u30f3\u3068\u30d6\u30ec\u30ed\u30c3\u30af\u304c\u5782\u308c\u4e0b\u304c\u308a\u5c0f\u6307\u306b\u306f\u5c0f\u3055\u3044\u660e\u308b\u3044\u661f\u3005\u306e\u3088\u3046\u306b\u8f1d\u304f\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u306e\u30ea\u30f3\u30b0\u304c\u5149\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u306a\u304c\u3089\u4f55\u3088\u308a\u91cd\u8981\u3067\u3042\u308a\u4f55\u5352\u898b\u9003\u305b\u307e\u305b\u3093\u305d\u306e\u90e8\u5206\u3053\u305d\u7269\u8a9e\u307e\u305f\u306f\u5c0f\u8aac\u5185\u5168\u3066\u4e00\u4eba\u3082\u6b20\u304b\u3055\u305a\u52c7\u6562\u30d2\u30fc\u30ed\u30fc\u9054\u7279\u5fb4\u5c31\u4e2d\u6700\u3082\u91cd\u8981\u90e8\u5206 \u5f7c\u304c\u975e\u5e38\u306b\u7f8e\u3057\u304b\u3063\u305f\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u79c1\u306f\u305f\u3081\u606f\u3092\u3064\u3044\u3066\u30da\u30f3\u3092\u7f6e\u304d\u3001\u30b3\u30ab\u30fc\u30c9\uff08\u5236\u5e3d\u306e\u98fe\u308a\uff09\u306e\u3042\u308b\u7d33\u58eb\u304c\u6765\u308b\u306e\u3092\u5f85\u3061\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u65b0\u9032\u4f5c\u5bb6\u3084\u7de8\u96c6\u8005\u306e\u79d8\u5bc6\u306b\u8a73\u3057\u304f\u306a\u3044\u4e00\u822c\u4eba\u306f\u3001\u300c\u7de8\u96c6\u300d\u306b\u805e\u304f\u3068\u795e\u8056\u306a\u6050\u6016\u306b\u9665\u308a\u3001\u81ea\u5206\u304c\u7740\u304f\u307e\u3067\u76f8\u5f53\u6642\u9593\u5f85\u305f\u305b\u307e\u3059\u3002"}
{"translation": "\u5f7c\u3089\u306f\u3001\u300c\u3069\u3046\u305e\u300d\u3068\u3044\u3046\u7de8\u96c6\u8005\u306e\u5408\u56f3\u5f8c\u3001\u9577\u3044\u9593\u54b3\u6255\u3044\u3057\u305f\u308a\u9f3b\u6c34\u3092\u304b\u3093\u3060\u308a\u3057\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u304b\u3089\u3086\u3063\u304f\u308a\u3068\u30c9\u30a2\u3092\u958b\u3051\u3001\u3055\u3089\u306b\u3086\u3063\u304f\u308a\u3068\u90e8\u5c4b\u306b\u5165\u3063\u3066\u304d\u3066\u6642\u9593\u3092\u6d6a\u8cbb\u3059\u308b\u3082\u306e\u3067\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u30b3\u30ab\u30fc\u30c9\u4ed8\u304d\u306e\u7d33\u58eb\u306f\u79c1\u305f\u3061\u304c\u5f85\u3064\u3053\u3068\u306a\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u30a2\u30f3\u30c9\u30ec\u30a4\u304c\u30c9\u30a2\u3092\u9589\u3058\u308b\u524d\u305f\u3060\u4e2d\u3067\u3001\u79c1\u306f\u9ad8\u8eab\u9577\u304a\u3088\u3073\u5e83\u80a9\u306a\u7537\u6027\u7acb\u4f4d\u30aa\u30d5\u30a3\u30b9\u5185\u90e8\u4e00\u89d2; \u5f7c\u7247\u624b\u7d19\u985e\u5dfb\u7269\u6301\u53c2\u4ed6\u65b9\u624b\u30b3\u30ab\u30fc\u30c9\u88c5\u7740\u30ad\u30e3\u30c3\u30d7\u63e1\u884c\u52d5\u3057\u3066\u307e\u3059\u3067\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u3088\u3046\u306b\u79c1\u3068\u4f1a\u3046\u3053\u3068\u304c\u6210\u529f\u3057\u304d\u3063\u305f\u4eba\u7269\u2014\u2014\u4e3b\u8981\u5f79\u5272\u6f14\u5287\u79c1\u8a71\u76ee\u6ce8\u76ee\u3059\u3046\u3082\u65b0\u3057\u7269\u8a9e-- \u5916\u898b\u8a18\u8ff0\u5fc5\u9808\u3057\u3066\u3042\u308a\u307e\u3057\u305f"}
{"translation": "1880\u5e74\u306e4\u6708\u306e\u3042\u308b\u663c\u4e0b\u304c\u308a\u3001\u8b66\u5099\u54e1\u30a2\u30f3\u30c9\u30ec\u30a4\u304c\u79c1\u306e\u57f7\u52d9\u5ba4\u306b\u5165\u3063\u3066\u304d\u3066\u3001\u4e0d\u601d\u8b70\u305d\u3046\u306b\u5831\u544a\u3057\u305f\u3002"}
{"translation": "\u4f55\u304b\u91cd\u8981\u306a\u7d33\u58eb\u304c\u7de8\u96c6\u90e8\u3092\u8a2a\u308c\u3001\u7de8\u96c6\u9577\u306b\u4f1a\u3044\u305f\u3044\u3068\u5207\u671b\u3057\u3066\u3044\u308b\u3088\u3046\u3060\u3063\u305f\u3002"}
{"translation": "\u300c\u304a\u305d\u3089\u304f\u5f79\u4eba\u3060\u308d\u3046\u300d\u3068\u30a2\u30f3\u30c9\u30ec\u30a4\u306f\u4ed8\u3051\u52a0\u3048\u3001\u300c\u30d0\u30c3\u30b8\u3092\u7740\u3051\u3066\u3044\u307e\u3059\u300d\u3002"}
{"translation": "\u300c\u5f7c\u306b\u4ed6\u306e\u6642\u9593\u306b\u6765\u3066\u3082\u3089\u3044\u306a\u3055\u3044\u300d\u3068\u79c1\u306f\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u4eca\u65e5\u306f\u5fd9\u3057\u3044\u3002"}
{"translation": "\u571f\u66dc\u65e5\u3060\u3051\u3057\u304b\u53d7\u3051\u4ed8\u3051\u3066\u3044\u307e\u305b\u3093\u3088\u3068\u4f1d\u3048\u3066\u304f\u3060\u3055\u3044\u300d\u3002"}
{"translation": "\u3057\u304b\u3057\u5f7c\u306f\u300c\u305d\u306e\u7537\u6027\u306f\u3059\u3067\u306b3\u5ea6\u8a2a\u308c\u3001\u3042\u306a\u305f\u3092\u5c0b\u306d\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u5927\u4e8b\u306a\u8a71\u304c\u3042\u308b\u3068\u4e3b\u5f35\u3057\u6ce3\u304d\u305d\u3046\u3067\u3059\u3002"}
{"translation": "\u571f\u66dc\u65e5\u3058\u3083\u90fd\u5408\u304c\u60aa\u304f\u4e00\u523b\u3082\u65e9\u304f\u4f1a\u308f\u306d\u3070\u3068\u8a00\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u8fce\u3048\u307e\u3059\u304b\uff1f\u300d"}
