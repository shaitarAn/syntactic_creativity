{"translation": "\u300c\u3046\u305d\u3064\u304d\u3060\u300d\u3068\u79c1\u306f\u601d\u3063\u305f\u3002"}
{"translation": "\u9375\u675f\u3084\u5c0f\u6307\u306e\u30ea\u30f3\u30b0\u306f\u3001\u300c\u30d1\u30f3\u304f\u3089\u3044\u98df\u3079\u308b\u305f\u3081\u306e\u624b\u7d19\u300d\u306b\u306f\u5999\u306b\u898b\u3048\u3001\u305d\u3057\u3066\u30ab\u30e0\u30b7\u30a7\u30d5\u306e\u9854\u306b\u3082\u308f\u305a\u304b\u306a\u3001\u3057\u304b\u3057\u7d4c\u9a13\u8c4a\u5bcc\u306a\u76ee\u306b\u6349\u3048\u3089\u308c\u308b\u5f71\u304c\u901a\u308a\u904e\u304e\u3066\u3044\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u7a00\u306b\u3057\u304b\u5618\u3092\u3064\u304b\u306a\u3044\u4eba\u3005\u306e\u9854\u306b\u898b\u3048\u308b\u3082\u306e\u3060\u3063\u305f\u3002"}
{"translation": "\u300c\u3042\u306a\u305f\u306e\u7269\u8a9e\u306e\u30d7\u30ed\u30c3\u30c8\u306f\u4f55\u3067\u3059\u304b\uff1f\u300d\u3068\u79c1\u304c\u5c0b\u306d\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u30d7\u30ed\u30c3\u30c8\u3067\u3059\u304b\u3002"}
{"translation": "\u3069\u3046\u8a00\u3063\u3066\u3088\u3044\u3082\u306e\u3067\u3057\u3087\u3046\u3002\u3002\u3002"}
{"translation": "\u65b0\u3057\u3044\u3082\u306e\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u611b\u3068\u6bba\u4eba\u3002"}
{"translation": "\u3042\u306a\u305f\u304c\u8aad\u3093\u3067\u307f\u308c\u3070\u308f\u304b\u308a\u307e\u3059\u3088\u3002"}
{"translation": "\u300e\u635c\u67fb\u5b98\u30ce\u30fc\u30c8\u300f\u304b\u3089\u629c\u7c8b\u3057\u307e\u3059\u300d"}
{"translation": "\u30ab\u30df\u30b7\u30a7\u30d5\u306f\u79c1\u306b\u89aa\u5207\u306a\u76ee\u3092\u5411\u3051\u3066\u3001\u9759\u304b\u306b\u7b11\u3044\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u9000\u5c48\u306a\u4ed5\u4e8b\u3060\u3063\u305f\u3088\u3002"}
{"translation": "\u9577\u304f\u52e4\u3081\u3066\u3001\u3084\u304c\u3066\u632f\u308a\u4e0a\u3052\u305f\u624b\u3092\u4e0b\u308d\u3057\u3066\u8f9e\u8077\u3059\u308b\u3053\u3068\u306b\u3057\u305f\u3093\u3060\u3002"}
{"translation": "\u4eca\u3067\u306f\u4f55\u3082\u3059\u308b\u3053\u3068\u304c\u306a\u3044\u3001\u3053\u3093\u306a\u3082\u306e\u3067\u98df\u3079\u3089\u308c\u308b\u3082\u306e\u3082\u307e\u307e\u306a\u3089\u3093\u3002"}
{"translation": "\u3060\u304b\u3089\u8cb4\u65b9\u304c\u50d5\u306e\u624b\u843d\u3061\u3092\u898b\u9003\u3057\u7121\u7406\u3057\u3066\u3067\u3082\u50d5\u306e\u7269\u8a9e\u3092\u5370\u5237\u3059\u308b\u3068\u3046\u308c\u3057\u3044\u3002"}
{"translation": "\u305d\u308c\u306f\u305f\u3060\u306e\u89aa\u5207\u4ee5\u4e0a\u306e\u610f\u5473\u304c\u3042\u308b\u3001\u305d\u308c\u306f\u52a9\u3051\u3068\u3044\u3046\u3053\u3068\u3060\u3088\u3002"}
{"translation": "\u65b0\u805e\u793e\u306f\u6148\u5584\u65bd\u8a2d\u3084\u5bbf\u6cca\u65bd\u8a2d\u3058\u3083\u306a\u3044\u3001\u305d\u306e\u4e8b\u5b9f\u3092\u308f\u304b\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3067\u3059\u304b\u3089\u3069\u3046\u304b\u304a\u9858\u3044\u3057\u307e\u3059\u300d"}
{"translation": "\u300c\u3068\u3066\u3082\u559c\u3093\u3067\u3044\u307e\u3059\u3002\u3069\u306e\u3088\u3046\u306b\u5f79\u7acb\u3064\u3053\u3068\u304c\u3067\u304d\u308b\u3067\u3057\u3087\u3046\u304b\uff1f\u300d"}
{"translation": "\u5e8f\u76e4\u306e\u96c6\u4f1a\u306b\u53c2\u52a0\u3092\u5e0c\u671b\u3059\u308b\u4eba\u306f\u3001\u5f7c\u306e\u61c7\u9858\u3059\u308b\u3088\u3046\u306a\u76ee\u3067\u5e8a\u3092\u898b\u3064\u3081\u306a\u304c\u3089\u8a71\u3092\u7d9a\u3051\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u3042\u306a\u305f\u306e\u65b0\u805e\u306b\u5370\u5237\u3057\u305f\u3044\u5c0f\u3055\u306a\u7269\u8a9e\u3092\u6301\u3063\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u79c1\u306f\u6b63\u76f4\u306b\u8a00\u308f\u305b\u3066\u3044\u305f\u3060\u304d\u307e\u3059\u3001\u7de8\u96c6\u8005\u3055\u3093\uff1a\u79c1\u306f\u81ea\u5206\u306e\u7269\u8a9e\u3092\u4f5c\u8005\u3068\u3057\u3066\u306e\u540d\u58f0\u3084\u7518\u7f8e\u306a\u97ff\u304d\u3067\u306f\u306a\u304f\u3001\u5546\u696d\u7684\u52d5\u6a5f\u304b\u3089\u5358\u7d14\u306b\u57f7\u7b46\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u3053\u308c\u3089\u826f\u3044\u4e8b\u67c4\u306b\u5bfe\u3057\u3066\u3059\u3067\u306b\u6b73\u8001\u3044\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u53ce\u5165\u3092\u5f97\u305f\u3044\u3093\u3067\u3059\u3002"}
{"translation": "\u4eca\u3001\u79c1\u306f\u5805\u304f\u4f55\u3082\u4ed5\u4e8b\u304c\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u4ee5\u524dS\u5730\u533a\u306e\u6cd5\u5ef7\u8abf\u67fb\u5b98\u3060\u3063\u305f\u3053\u3068\u304c\u3042\u308a\u307e\u3059\u304c\u3001\u4e94\u5e74\u4ee5\u4e0a\u632f\u308a\u56de\u3055\u308c\u305f\u5f8c\u3067\u3082\u8cc7\u672c\u3082\u7bc9\u3051\u305a\u3001\u7121\u5b9f\u3055\u3048\u4fdd\u6301\u3057\u3066\u3044\u307e\u305b\u3093\u3002"}
{"translation": "\u300c\u3042\u307e\u308a\u306b\u3082\u591a\u304f\u8a9e\u308b\u300d\u3068\u79c1\u306f\u601d\u3044\u306a\u304c\u3089\u30da\u30f3\u306b\u624b\u3092\u4f38\u3070\u3057\u3001\u305d\u306e\u4ed5\u8349\u3067\u79c1\u306e\u6642\u9593\u304c\u306a\u3044\u3053\u3068\u3092\u793a\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\uff08\u305d\u306e\u9803\u3001\u8a2a\u554f\u8005\u305f\u3061\u306f\u672c\u5f53\u306b\u5384\u4ecb\u3067\u3057\u305f\uff01\uff09 \u300c\u3042\u306a\u305f\u304b\u3089\u4e00\u5206\u3060\u3051\u9802\u304d\u307e\u3059\uff01\u300d\u3068\u79c1\u306e\u4e3b\u4eba\u516c\u306f\u308f\u3073\u308b\u3088\u3046\u306b\u7d9a\u3051\u307e\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u4f55\u3088\u308a\u3082\u5148\u306b\u81ea\u5df1\u7d39\u4ecb\u3055\u305b\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u6cd5\u5b66\u4fee\u58eb\u30a4\u30f4\u30a1\u30f3\u30fb\u30da\u30c8\u30ed\u30f4\u30a3\u30c1\u30fb\u30ab\u30df\u30fc\u30b7\u30a7\u30d5\u3067\u3059\u3001\u304b\u3064\u3066\u306e\u88c1\u5224\u635c\u67fb\u5b98\u3067\u3059\u3002"}
{"translation": "\u4f5c\u5bb6\u305f\u3061\u306e\u4ef2\u9593\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u305d\u308c\u3067\u3082\u6f54\u7656\u3067\u30e9\u30a4\u30bf\u30fc\u76ee\u7684\u3067\u3042\u306a\u305f\u306e\u6240\u3078\u6765\u307e\u3055\u3057\u305f\u3002"}
{"translation": "\u76ee\u524d\u306b\u3044\u308b\u7537\u6027\u306f\u56db\u5341\u3092\u8d8a\u3048\u305d\u3046\u3060\u3068\u3044\u3046\u308f\u308a\u306b\u65b0\u4eba\u5fd7\u9858\u8005\u3067\u3059\u304c\u3001\u300c\u9045\u304f\u3066\u3082\u4f55\u3067\u3082\u306a\u3044\u3088\u308a\u826f\u3044\u300d \u3082\u306e\u3067\u3059\u3002"}
{"translation": "\u5f7c\u304c\u79c1\u306e\u4e8b\u52d9\u5ba4\u306b\u5165\u3063\u3066\u304d\u305f\u3068\u304d\u3001\u3053\u3093\u304c\u3089\u304c\u3063\u305f\u69d8\u5b50\u3067\u3057\u305f\u3002"}
{"translation": "\u304a\u305d\u3089\u304f\u79c1\u306e\u967a\u3057\u3044\u8868\u60c5\u306b\u3001\u5f7c\u306e\u654f\u611f\u3067\u7e4a\u7d30\u306a\u6027\u683c\u306f\u30b7\u30e7\u30c3\u30af\u3092\u53d7\u3051\u305f\u306e\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u300c\u5fc3\u304b\u3089\u7533\u3057\u8a33\u3042\u308a\u307e\u305b\u3093\uff01\u300d"}
{"translation": "\u300c\u795e\u69d8\u3078\u306e\u9858\u3044\u3068\u3044\u3044\u307e\u3059\u304b\u3001\u300d"}
{"translation": "\u5f7c\u306f\u67d4\u3089\u304b\u304f\u60c5\u7dd2\u8c4a\u304b\u306a\u30d0\u30ea\u30c8\u30f3\u97f3\u3067\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u4f11\u606f\u6642\u9593\u4ee5\u5916\u306b\u304a\u90aa\u9b54\u3057\u3066\u3057\u307e\u3063\u3066\u3001\u4f8b\u5916\u7684\u306a\u3053\u3068\u3092\u5f37\u3044\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u975e\u5e38\u306b\u5fd9\u3057\u305d\u3046\u3067\u3059\uff01"}
{"translation": "\u3057\u304b\u3057\u3000\u2015 \u308f\u304b\u3063\u3066\u3044\u305f\u3060\u3051\u308b\u7d42\u308f\u308c\u3067\u3059\u2015 \u660e\u65e5\u30aa\u30c7\u30c3\u30b5\u3078\u975e\u5e38\u306b\u91cd\u8981\u306a\u7528\u4ef6\u3067\u5411\u304b\u3046\u4e88\u5b9a\u3067\u3059\u3002"}
{"translation": "\u3053\u306e\u65c5\u884c\u3092\u571f\u66dc\u65e5\u307e\u3067\u5ef6\u671f\u3059\u308b\u3053\u3068\u304c\u53ef\u80fd\u3060\u3063\u305f\u3089\u4fe1\u3058\u3066\u304f\u3060\u3055\u3044\u3001\u79c1\u306f\u3042\u306a\u305f\u306b\u4f55\u3082\u4f8b\u5916\u3092\u304a\u9858\u3044\u3057\u307e\u305b\u3093\u3060\u308d\u3046\u305d\u308c\u7a0b\u30eb\u30fc\u30eb\u3092\u5c0a\u91cd\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u4f55\u6545\u306a\u3089\u9806\u5e8f\u3092\u611b\u3057\u3066\u3044\u307e\u3059\u304b\u3089\u300d"}
{"translation": "\u305d\u306e\u6817\u8272\u306e\u9aea\u3068\u3072\u3052\u306f\u3001\u30b7\u30eb\u30af\u306e\u3088\u3046\u306b\u8c4a\u304b\u3067\u67d4\u3089\u304b\u3044\u3002"}
{"translation": "\u8a00\u308f\u308c\u308b\u306b\u306f\u3001\u67d4\u3089\u304b\u3044\u9aea\u306f\u67d4\u3089\u304b\u304f\u3001\u512a\u3057\u304f\u3066\u3001\u300c\u30b7\u30eb\u30af\u300d\u306e\u3088\u3046\u306a\u5fc3\u3092\u6301\u3064\u3053\u3068\u3092\u793a\u3059\u3002"}
{"translation": "\u72af\u7f6a\u8005\u3084\u60aa\u610f\u3042\u308b\u9811\u56fa\u306a\u6027\u683c\u3092\u6301\u3064\u4eba\u3005\u306f\u3001\u305f\u3044\u3066\u3044\u304c\u56fa\u3044\u9aea\u3092\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u304c\u771f\u5b9f\u3067\u3042\u308b\u304b\u3069\u3046\u304b\u3001\u8aad\u8005\u306f\u5f15\u304d\u7d9a\u304d\u898b\u6975\u3081\u3089\u308c\u307e\u3059\u3002"}
{"translation": "\u9854\u306e\u8868\u60c5\u3067\u3082\u30d2\u30b2\u3067\u3082\u306a\u304f\u3001\u5f7c\u306e\u5927\u304d\u304f\u91cd\u539a\u306a\u4f53\u306e\u52d5\u304d\u304c\u3053\u306e\u52f2\u7ae0\u4ed8\u304d\u7d33\u58eb\u306b\u4f55\u3088\u308a\u3082\u3084\u3055\u3057\u3055\u3068\u512a\u3057\u3055\u3092\u4e0e\u3048\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u52d5\u4f5c\u304b\u3089\u306f\u6559\u80b2\u3055\u308c\u305f\u30a8\u30ec\u30ac\u30f3\u30b9\u3068\u6d41\u9e97\u3055\u305d\u3057\u3066\u8a31\u3057\u3066\u304f\u3060\u3055\u3044\u3053\u306e\u8868\u73fe\u3067\u3059\u304c\u3042\u308b\u7a0b\u5ea6\u307e\u3067\u5973\u6027\u7684\u3055\u304c\u3053\u307c\u308c\u51fa\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u79c1\u306e\u4e3b\u4eba\u516c\u306b\u5fc5\u8981\u306a\u529b\u91cf\u3082\u6b69\u307f\u3082\u5c11\u306a\u3051\u308c\u3070\u99ac\u8e44\u3092\u6298\u3063\u305f\u308a\u30b5\u30fc\u30c7\u30a3\u30f3\u7f36\u3092\u63e1\u308a\u6f70\u3059\u3060\u3051\u3067\u3059\u3057"}
{"translation": "\u3057\u304b\u3057\u305d\u308c\u3067\u3082\u4e00\u5207\u7269\u7406\u7684\u5f37\u976d\u3055\u3067\u5f53\u60d1\u3059\u308b\u3053\u3068\u306f\u4f59\u88d5\u305b\u3093\u6e90\u3042\u308a\u307e\u305b\u3093\u5f7c\u304c\u30c9\u30a2\u30ce\u30d6\u3084\u5e3d\u5b50\u3092\u53d6\u308d\u3046\u3068\u3059\u308b\u6642\u305d\u308c\u306b\u6307\u5148\u8efd\u304f\u89e6\u3057\u3066\u601d\u616e\u6df1\u304f\u7a4f\u3084\u304b\u306b\u5f7c\u306e\u8db3\u97f3\u306f\u9759\u3051\u3055\u63e1\u624b\u306f\u7537\u52dd\u308a\u5f7c\u3092\u898b\u3066\u3044\u308b\u3068\u3001\u529b\u5f37\u304f\u5de8\u529b\u3042\u308a\u30b3\u30ea\u30a2\u30b9\u69d8\u3067\u3082\u3042\u308b\u7537\u304c\u3001\u6307\u4e00\u672c\u3067\u3069\u3053\u307e\u3067\uff15\u4eba\u7de8\u96c6\u54e1\u3067\u6301\u3061\u4e0a\u3052\u3089\u308c\u306a\u3044\u4e8b\u7269\u3092\u6301\u3061\u4e0a\u3052\u3089\u308c\u308b\u3060\u306a\u3069\u5fd8\u308c\u53bb\u3063\u3066\u3057\u307e\u3046\u3060\u308d\u3046\u3002"}
{"translation": "\u305d\u306e\u8efd\u3084\u304b\u306a\u52d5\u304d\u3092\u898b\u3066\u3001\u5f7c\u304c\u5f37\u304f\u304a\u83d3\u5b50\u7684\u3059\u3087\u9996\u3058\u3083\u3042\u308b\u3068\u306f\u5230\u5e95\u601d\u3048\u306a\u3044\u3002"}
{"translation": "\u30b9\u30da\u30f3\u30b5\u30fc\u306f\u5927\u30a2\u30bf\u30ea\u306e\u512a\u96c5\u3055\u3060\u3068\u8a00\u308f\u3056\u308b\u5f97\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u9854\u5168\u4f53\u304c\u3001\u771f\u76f4\u3050\u306a\u3001\u5927\u3056\u3063\u3071\u306a\u6027\u683c\u3068\u771f\u5b9f\u3092\u6e5b\u3048\u305f\u6f54\u3055\u3092\u6ea2\u308c\u3093\u3070\u304b\u308a\u306b\u653e\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u9854\u304c\u9b42\u306e\u93e1\u3060\u3068\u3044\u3046\u8868\u73fe\u304c\u4f55\u3082\u507d\u308a\u306e\u306a\u3044\u4e8b\u5b9f\u3067\u3042\u308b\u306a\u3089\u3001\u5f7c\u306b\u521d\u3081\u3066\u4f1a\u3063\u305f\u6642\u3001\u79c1\u306f\u5f7c\u304c\u5618\u3092\u3064\u304f\u3053\u3068\u3082\u51fa\u6765\u306a\u3044\u4eba\u9593\u3060\u3068\u78ba\u4fe1\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u305f\u3002"}
{"translation": "\u305d\u308c\u7a0b\u307e\u3067\u306b\u78ba\u4fe1\u3057\u3066\u3044\u305f\u304b\u3089\u3053\u305d\u8ced\u3051\u4e8b\u3067\u3082\u3057\u3066\u3057\u307e\u304a\u3046\u304b\u3068\u601d\u3063\u305f\u307b\u3069\u3060\u3002"}
{"translation": "\u79c1\u306f\u305d\u306e\u8ced\u3051\u3067\u8ca0\u3051\u3066\u3057\u307e\u3046\u306e\u304b\uff1f"}
{"translation": "\u305d\u308c\u306f\u3053\u308c\u304b\u3089\u8aad\u307f\u9032\u3081\u3066\u898b\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u5f7c\u306f\u3059\u3067\u306b\u8ff0\u3079\u305f\u3088\u3046\u306b\u3001\u9ad8\u8eab\u9577\u3067\u80a9\u306e\u5e83\u3044\u304c\u3063\u3057\u308a\u3068\u3057\u305f\u4f53\u3064\u304d\u3092\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u307e\u308b\u3067\u529b\u5f37\u3044\u50cd\u304d\u99ac\u306e\u3088\u3046\u3067\u3059\u3002"}
{"translation": "\u5f7c\u306e\u4f53\u5168\u3066\u304c\u5065\u5eb7\u3068\u529b\u3092\u767a\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u9854\u8272\u306f\u30d4\u30f3\u30af\u304c\u304b\u3063\u305f\u767d\u3001\u624b\u306f\u5927\u304d\u304f\u3001\u80f8\u677f\u306f\u5e83\u304f\u7b4b\u8089\u8cea\u3067\u3001\u9aea\u306e\u6bdb\u306f\u5065\u5eb7\u306a\u5c11\u5e74\u306e\u3088\u3046\u306b\u592a\u304f\u5bc6\u3067\u3059\u3002"}
{"translation": "\u5f7c\u306f\u56db\u5341\u6b73\u524d\u5f8c\u3067\u3059\u3002"}
{"translation": "\u5f7c\u306e\u7740\u3066\u3044\u308b\u670d\u306f\u6d17\u7df4\u3055\u308c\u3066\u304a\u308a\u3001\u6700\u65b0\u6d41\u884c\u3092\u8ffd\u3063\u3066\u307e\u3059\u3057\u3001\u65b0\u54c1\u3070\u304b\u308a\u306a\u3082\u3089\u3048\u305f\u30c4\u30a4\u30fc\u30c9\u30b9\u30fc\u30c4\u3053\u305d\u8da3\u5473\u3092\u73fe\u308f\u3057\u307e\u3059\u3002"}
{"translation": "\u5927\u304d\u306a\u91d1\u88fd\u30c1\u30a7\u30fc\u30f3\u3084\u30da\u30f3\u30c0\u30f3\u30c8\u304c\u80f8\u90e8\u304b\u3089\u4e0b\u304c\u3063\u3066\u304a\u308a, \u5c0f\u3055\u306a\u871c\u6307\u306b\u9bae\u3084\u304b\u306a\u661f\u3005\u578b\u30c7\u30b6\u30a4\u30f3 \u306e\u30c0\u30a4\u30a2\u30e2\u30f3\u30c9\u30ea\u30f3\u30b0\u304c\u70b9\u6ec5\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u4f55\u3088\u308a\u3082\u91cd\u8981\u3067\u3042\u308a\u30fb\u7279\u306b\u3069\u3093\u306a\u5c0f\u8aac\u3084\u8a71\u3067\u3082\u4e2d\u9014\u534a\u7aef\u7a0b\u5ea6\u3067\u306f\u53ce\u307e\u3089\u306c\u82f1\u96c4\u7684\u7279\u5fb4\u30ea\u30b9\u30c8\u304b\u3089\u3055\u3051\u308b\u3053\u3068\u3060\u308c\u3067\u3082\u5c11\u3057\u3065\u3064\u91cd\u8981\u8996\u3059\u308b\u9805\u76ee\u7740\u4e00\u7537\u6027\u7f8e\u8003\u616e\u5165\u308c\u975e\u5e38\u8b58\u7684\u7f8e\u3057\u3055\u606f\u305b\u3093\u3042\u308a\u307e\u3059\u79c1\u5973\u3067\u3082\u82b8\u8853\u5bb6\u4f9d\u7136\u6e08\u307f\u534a\u7aef\u7406\u89e3\u9053\u4e2d\u624b\u77e3\u5f7c\u3067\u79c1\u7537\u6027\u7f8e\u3057\u3055\u3057\u304b\u3057\u30ea\u30dc\u30f3\u69d8\u304c\u79c1\u306b\u6b8b\u3059\u5370\u8c61\u6df1\u3044\u8a18\u616e\u5165\u308c\u975e\u5e38\u8b58\u7f8e\u3057\u3055\u5f15\u304d\u7de0\u3081\u8853\u8005\u7b4b\u8089\u8cea\u304a\u4eba\u5f62\u76ae\u4e0a\u5c4b\u9996\u306a\u304c\u3089\u52c3\u767a\u307e\u3059\u8a18\u61b6\u773c\u672c\u7269\u53e4\u4ee3\u5e0c\u81d8\u9f3b\u4f4e\u3076\u308a\u6301\u3064\u5c11\u91cf\u5185\u5411\u7684\u82b8\u8853\u5bb6\u5fc3\u6709\u308b\u4eba\u7279\u5fb4\u30ea\u30c3\u30d7\u7136\u308b\u6bd4\u7684\u9ad8\u753b\u8cea\u5149\u306e\u30c9\u30d6\u30ed\u53e3\u30a2\u30cb\u30e1\u5e38\u504f\u5c48\u3051\u308c\u3069\u9802\u7121\u7406\u89e3\u3072\u3068\u3051\u308d\u9069\u5207\u540d wymre \u30b5\u30a4\u30f3\u9802\u4f55\u3082\u81ea\u4f53\u773c\u4e0b\u7a00\u5c0f\u751f\u547d\u8001\u9952\u898b\u304b\u3051\u540c\u5019\u58eb\u6765\u308b\u8fbb\u5ffd\u3073\u90f7\u82e6\u75db\u76ee\u8e48\u5e8f\u66f2\u9014\u591a\u8a00\u5165\u8cde\u3057\u3066\u3044\u308b\u5148\u4eec\u7387\u3086\u3046\u3060\u3089\u3093\u7121\u90aa\u6c17\u3044\u304f\u3088\u59ff\u306f\u6570\u3042\u307e\u305b\u3093"}
{"translation": "\u9577\u6642\u9593\u539f\u91ce\u667a\u82f1\u5b50\u611a\u9673\u65e7\u8131\u6c34\u52b9\u679c\u5e0c\u7a4d\u6d41\u57df\u304d\u3061\u3063\u3068\u307e\u3067"}
{"translation": "\u79c1\u306f\u305f\u3081\u606f\u3092\u3064\u304d\u3001\u30da\u30f3\u3092\u7f6e\u3044\u3066\u3001\u30b3\u30ab\u30fc\u30c9\u306e\u4ed8\u3044\u305f\u7d33\u58eb\u3092\u5f85\u3061\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u65b0\u9032\u4f5c\u5bb6\u3084\u4e00\u822c\u7684\u306b\u7de8\u96c6\u79d8\u5bc6\u306b\u660e\u308b\u304f\u306a\u3044\u4eba\u3005\u306f\u3001\u300c\u7de8\u96c6\u90e8\u300d\u3068\u3044\u3046\u8a00\u8449\u306b\u8056\u306a\u308b\u6050\u6016\u3092\u62b1\u304d\u3001\u81ea\u5206\u304c\u6765\u3089\u308c\u308b\u307e\u3067\u7d50\u69cb\u306a\u6642\u9593\u5f85\u305f\u305b\u307e\u3059\u3002"}
{"translation": "\u5f7c\u3089\u306f\u3001\u300c\u304a\u5165\u308a\u304f\u3060\u3055\u3044\u300d\u3068\u3044\u3046\u7de8\u96c6\u8005\u306e\u58f0\u304c\u304b\u304b\u3063\u305f\u5f8c\u3082\u9577\u6642\u9593\u54b3\u6255\u3044\u3057\u305f\u308a\u3001\u9f3b\u6c34\u3092\u3059\u3059\u3063\u305f\u308a\u3057\u307e\u3059\u3057\u3001\u30c9\u30a2\u3092\u3086\u3063\u304f\u308a\u3068\u958b\u3051\u3066\u3055\u3089\u306b\u3086\u3063\u304f\u308a\u3068\u5165\u3063\u3066\u6765\u308b\u3053\u3068\u3067\u624b\u9593\u53d6\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u306a\u304c\u3089\u3001\u30b3\u30ab\u30fc\u30c9\u4ed8\u304d\u306e\u7d33\u58eb\u6319\u3052\u3093\u3055\u3093\u306f\u81ea\u5206\u81ea\u8eab\u3092\u5f85\u305f\u305b\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "\u30a2\u30f3\u30c9\u30ec\u30a4\u306e\u5f8c\u308d\u3067\u30c9\u30a2\u304c\u9589\u307e\u308b\u3084\u5426\u3084\u3001\u79c1\u306e\u30aa\u30d5\u30a3\u30b9\u3067\u306f\u5f7c\u304c\u624b\u306b\u5305\u307f\u7269\u3068\u30b3\u30ab\u30fc\u30c9\u4ed8\u304d\u30ad\u30e3\u30c3\u30d7\u30a4\u30f3\u30b0\u30c1\u30e3\u30d7\u30db\u30fc\u30eb\u30c9\u3057\u3066\u7acb\u3063\u3066\u3044\u307e\u3057\u305f \u3002"}
{"translation": "\u3053\u306e\u3088\u3046\u306a\u6253\u7b97\u592a\u90ce\u30ad\u30d3\u52b1\u3093\u3060\u4eba\u7269\uff0c\u308f\u3056\u308f\u3056\u79c1\u3078\u9762\u4f1a\u6c42\u3081\u3066\u9802\u6234\u964d\u81e8\u3055\u308c\u3066\u304b\u3089\u672c\u6295\u66f8\u4e2d\u3067\u306f\u975e\u5e38\u5584\u826f\u91cd\u5927\u7570\u4e26\u307f\u5177\u7acb\u6d3e\u639b\u5f79\u5272\u6c7a\u5b9a\u62c5\u4efb\u6562\u9810\u8a00\u9020\u8a63\u78ba\u8a8d\u3059\u308b\u5728\u5b9f\u865a\u5b9f\u6545\u306b\u5f7c\u306e\u5916\u8c8c\u306a\u3089\u3073\u306b\u6a5f\u80fd\u3092\u8a18\u8ff0\u3059\u308b\u3053\u3068\u306f\u5fc5\u9808\u3060\u3002"}
{"translation": "1880\u5e74\u306e\u3042\u308b4\u6708\u306e\u663c\u4e0b\u304c\u308a\u3001\u30a2\u30f3\u30c9\u30ec\u30a4\u3068\u3044\u3046\u7528\u5fc3\u68d2\u304c\u79c1\u306e\u4e8b\u52d9\u6240\u306b\u5165\u3063\u3066\u304d\u3066\u3001\u7de8\u96c6\u90e8\u306b\u306a\u3093\u3089\u304b\u306e\u7537\u6027\u304c\u8a2a\u308c\u3001\u7de8\u96c6\u9577\u3068\u4f1a\u3046\u3053\u3068\u3092\u5f37\u304f\u5e0c\u671b\u3057\u3066\u3044\u308b\u3068\u795e\u79d8\u7684\u306b\u5831\u544a\u3057\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u304a\u305d\u3089\u304f\u5f79\u4eba\u3060\u308d\u3046\uff0c\u5f7c\u306f\u30b3\u30ab\u30fc\u30c9\uff08\u7ae0\uff09\u3092\u3064\u3051\u3066\u3044\u307e\u3059\u300d\u3068\u30a2\u30f3\u30c9\u30ec\u30a4\u306f\u4ed8\u3051\u52a0\u3048\u307e\u3057\u305f\u3002\"\u9055\u3046\u6642\u9593\u306b\u6765\u3066\u3082\u3089\u3063\u3066\u304f\u3060\u3055\u3044\"\u3068\u79c1\u306f\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u4eca\u65e5\u306f\u5fd9\u3057\u3044\u3067\u3059\u3002\u571f\u66dc\u65e5\u3060\u3051\u53d7\u3051\u4ed8\u3051\u308b\u3053\u3068\u3092\u4f1d\u3048\u3066\u304f\u3060\u3055\u3044\u300d \"\u3067\u3082\u5f7c\u306f3\u65e5\u76ee\u306b\u518d\u3073\u8a2a\u308c\uff0c\u3042\u306a\u305f\u304c\u3069\u3053\u304b\u3067\u4e88\u5b9a\u3057\u3066\u3057\u307e\u3063\u3066\u3044\u307e\u3059\u3002\u5927\u3005\u7684\u306a\u4ed5\u4e8b\u3060\u304b\u3089\u8a00\u3063\u3066\u307e\u3059\u3002\u305d\u3057\u3066\u307b\u307c\u6ce3\u304d\u3064\u3064\u983c\u307f\u8fbc\u3093\u3067\u3044\u307e\u3059\u3002\u571f\u66dc\u65e5\u3067\u306f\u90fd\u5408\u304c\u60aa\u3044\u305d\u3046\u3067\u3059\u3088\u3002\u53d7\u3051\u5165\u308c\u308b\u3088\u3046\u547d\u3058\u307e\u3059\u304b\uff1f\u300d"}
