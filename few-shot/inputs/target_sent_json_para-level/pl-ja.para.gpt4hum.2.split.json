{"translation": "\u300c\u3042\u3044\u3064\u306f\u3082\u3046\u51fa\u3066\u3053\u308c\u306a\u3044\u3063\u3066\u3001\u8a00\u3063\u3066\u308b\u3093\u3060\u3088\u300d"}
{"translation": "\u3068\u306b\u304d\u3073\u9762\u306e\u7537\u304c\u81ea\u4fe1\u6e80\u3005\u306b\u9837\u304d\u306a\u304c\u3089\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u3082\u3046\u4e00\u6642\u959315\u5206\u3082\u305d\u3053\u306b\u5165\u308a\u8fbc\u3093\u3067\u308b\u3002"}
{"translation": "\u7d42\u308f\u308a\u3060\u308d\u3046\u306d\u300d\u3002"}
{"translation": "\u5e02\u6c11\u305f\u3061\u306f\u3001\u5ec3\u589f\u306e\u4e2d\u3067\u5bc6\u96c6\u3057\u3001\u9ed9\u7136\u3068\u898b\u3064\u3081\u3066\u3044\u305f\u3002"}
{"translation": "\u74e6\u792b\u306e\u4e2d\u304b\u3089\u958b\u3044\u305f\u9ed2\u3044\u7a74\u3092\u3001\u5730\u4e0b\u5ba4\u3078\u3068\u7d9a\u304f\u57cb\u307e\u3063\u305f\u5165\u53e3\u3092\u3058\u3063\u3068\u898b\u3064\u3081\u3066\u3044\u305f\u3060\u3051\u3060\u3063\u305f\u3002"}
{"translation": "\u592a\u3063\u3061\u3087\u3067\u9ec4\u8272\u306e\u30b3\u30fc\u30c8\u3092\u7740\u305f\u7537\u304c\u7247\u8db3\u304b\u3089\u7247\u8db3\u3078\u4f53\u91cd\u3092\u79fb\u3057\u306a\u304c\u3089\u54b3\u6255\u3044\u3057\u3001\u304f\u3057\u3083\u304f\u3057\u3083\u306b\u306a\u3063\u305f\u30d9\u30ec\u30fc\u5e3d\u3092\u982d\u304b\u3089\u53d6\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u307e\u3060\u3057\u3070\u3089\u304f\u5f85\u3068\u3046\u300d\u5f7c\u306f\u7a00\u306a\u7709\u6bdb\u304b\u3089\u6c57\u3092\u62ed\u3063\u305f\u3002"}
{"translation": "\u300c\u4f55\u3092\u5f85\u3064\u3093\u3060\uff1f\u300d\u306b\u304d\u3073\u9854\u304c\u3075\u304d\u3060\u3057\u305f\u3002"}
{"translation": "\u300c\u5730\u4e0b\u7262\u306b\u306f\u30d0\u30b8\u30ea\u30b9\u30af\u304c\u3044\u308b\u3001\u5fd8\u308c\u305f\u304b\u3057\u3089\u4ee3\u5b98\u69d8\uff1f\u8ab0\u3082\u304c\u305d\u306e\u4e2d\u306b\u5165\u3063\u305f\u77ac\u9593\u3001\u547d\u53d6\u308a\u3067\u3059\u3002"}
{"translation": "\u4f55\u4eba\u3082\u306e\u8005\u304c\u305d\u3053\u3067\u547d\u3092\u843d\u3068\u3057\u3066\u304d\u307e\u3057\u305f\u3088\u3002"}
{"translation": "\u305d\u308c\u3058\u3083\u3042\u3001\u3069\u3046\u3057\u3066\u5f85\u3064\u3093\u3067\u3059\uff1f\u300d\u4e0d\u78ba\u304b\u306a\u58f0\u3067\u592a\u3063\u305f\u7537\u6027\u304c\u545f\u3044\u305f\u300c\u6211\u3005\u306f\u7d04\u675f\u3057\u305f\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u304b\u3002"}
{"translation": "\u300c\u3069\u3046\u3044\u3046\u3053\u3068\uff1f\u751f\u304d\u3066\u3044\u308b\u4eba\u7269\u3068\u7d04\u675f\u3092\u4ea4\u308f\u3057\u305f\u306e\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u304b"}
{"translation": "\u4ee3\u5b98\u6bbf\u300d"}
{"translation": "\u30cb\u30ad\u30d3\u9854\u306e\u53cb\u4eba\u3067\u3001\u9769\u306e\u89e3\u4f53\u7528\u30a8\u30d7\u30ed\u30f3\u3092\u7740\u3066\u3044\u308b\u5de8\u6f22\u304c\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u3057\u304b\u3057\u4eca\u3067\u306f\u5f7c\u306f\u6b7b\u3093\u3067\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u306f\u7a7a\u306b\u592a\u967d\u304c\u6607\u3063\u3066\u3044\u308b\u3088\u3046\u306b\u660e\u767d\u3067\u3059\u3002"}
{"translation": "\u3042\u3089\u304b\u3058\u3081\u77e5\u3063\u3066\u3044\u307e\u3057\u305f\u3088\u3001\u547d\u53d6\u308a\u306a\u904b\u547d\u304a\u308d\u3046\u3068\u3059\u308b\u3053\u3068\u3082\u3001\u3001\u4ed6\u306e\u5148\u884c\u8005\u307f\u305f\u304f\u771f\u5263\u75be\u8d70\u3059\u308b\u3053\u3068\u3082\u77e5\u3063\u3066\u304a\u308a\u307e\u3059\u3002"}
{"translation": "\u5b9f\u969b\u5f7c\u306f\u93e1\u3055\u3048\u6301\u3063\u3066\u884c\u304b\u305a,\u305f\u3060\u5263\u3060\u3051\u6301\u3063\u3066\u884c\u304d\u307e\u3057\u305f\u3088\u306d \u3002"}
{"translation": "\u93e1\u7121\u3057\u3067\u30d0\u30b8\u30ea\u30b9\u30af\u3092\u5012\u3059\u65b9\u6cd5\u306a\u3069\u7686\u77e5\u3063\u3066\u3044\u307e\u3059 \u3082\u3061\u308d\u3093\u305d\u3093\u306a\u3053\u3068\u306f\u7121\u7406\u3067\u3059\u3088\u300d\u3068\u3002"}
{"translation": "\u3042\u306a\u305f\u304c\u305f\u306f\u307b\u3093\u306e\u5c11\u984d\u3092\u7bc0\u7d04\u3057\u305f\u3001\u30cb\u30ad\u30d3\u9762\u304c\u4ed8\u3051\u52a0\u3048\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u30d0\u30b8\u30ea\u30b9\u30af\u306b\u652f\u6255\u3046\u8005\u3082\u3044\u307e\u305b\u3093\u304b\u3089\u306d\u3002"}
{"translation": "\u5b89\u5fc3\u3057\u3066\u5bb6\u306b\u5e30\u308a\u306a\u3055\u3044\u3002"}
{"translation": "\u305d\u3057\u3066\u3001\u6211\u3005\u304c\u9b54\u5973\u306e\u99ac\u3068\u5bb6\u755c\u3092\u5f15\u304d\u53d6\u308a\u307e\u3059\u3002"}
{"translation": "\u8cc7\u7523\u3092\u653e\u68c4\u3059\u308b\u306e\u306f\u60dc\u3057\u3044\u3053\u3068\u3067\u3059\u304b\u3089\u306d\u3002"}
{"translation": "\u300c\u305d\u3046\u3060\u300d\u3068\u8089\u5c4b\u304c\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u826f\u8cea\u306e\u96cc\u99ac\u3060\u3057\u3001\u888b\u3082\u7d50\u69cb\u8a70\u307e\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u4e2d\u8eab\u3092\u3061\u3087\u3063\u3068\u898b\u3066\u307f\u308b\u304b\u300d"}
{"translation": "\u300c\u305d\u308c\u3069\u3046\u3044\u3046\u3053\u3068\uff1f\u4f55\uff1f\u9ed9\u308c\u3070\u5c40\u9577\u3060\uff01\u3053\u308c\u4ee5\u4e0a\u53e3\u51fa\u3057\u306a\u300d\u30cb\u30ad\u30d3\u9762\u306f\u8b66\u544a\u3057\u305f\u3002"}
{"translation": "\u300c\u826f\u8cea\u306e\u96cc\u99ac\u300d\u3068\u8089\u5c4b\u306f\u7e70\u308a\u8fd4\u3057\u305f\u3002"}
{"translation": "\u300c\u3042\u306e\u99ac\u3092\u3061\u3087\u3063\u3068\u843d\u3061\u7740\u304b\u305b\u3066\u304f\u308c\u308b\uff1f\u300d\u8089\u5c4b\u306f\u3086\u3063\u304f\u308a\u3068\u58c1\u304b\u3089\u73fe\u308c\u305f\u898b\u77e5\u3089\u306c\u8a2a\u554f\u8005\u306b\u5411\u304b\u3063\u3066\u632f\u308a\u8fd4\u3063\u305f\u3002"}
{"translation": "\u8a2a\u554f\u8005\u304a\u3088\u305d\u4eba\u3005\u304c\u7d50\u96c6\u3057\u3066\u62d8\u7f6e\u6240\u3078\u771f\u5263\u306b\u5165\u308d\u3046\u3068\u3059\u308b\u4e00\u65b9\u3067\u5f7c(\u8a2a\u554f\u8005)\u306f\u58c1\u304b\u3089\u59ff\u3092\u73fe\u308f\u3059\u3002"}
{"translation": "\u305d\u306e\u7537\u306f\u30ab\u30fc\u30eb\u304c\u5dfb\u304b\u308c\u305f\u3001\u6fc3\u3044\u6817\u8272\u306e\u9aea\u3092\u6301\u3063\u3066\u304a\u308a\u3001\u8336\u8272\u306e\u30c1\u30e5\u30cb\u30c3\u30af\u3092\u539a\u7740\u3057\u305f\u30ab\u30d5\u30bf\u30f3\u306e\u4e0a\u306b\u8eab\u306b\u307e\u3068\u3044\u3001\u9ad8\u304f\u3066\u4e57\u99ac\u7528\u306e\u30d6\u30fc\u30c4\u3092\u5c65\u3044\u3066\u3044\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u6b66\u5668\u306f\u4e00\u5207\u306a\u3057\u3002"}
{"translation": "\u5f7c\u304c\u518d\u3073\u300c\u99ac\u304b\u3089\u96e2\u308c\u308d\u300d\u3068\u8a00\u3046\u3068\u304d\u3001\u76ae\u8089\u3063\u307d\u304f\u7b11\u3063\u305f\u3002"}
{"translation": "\u300c\u3069\u3046\u3044\u3046\u308f\u3051\u3060\uff1f\u4ed6\u4eba\u306e\u99ac\u3001\u4ed6\u4eba\u306e\u30b8\u30e5\u30ad\uff08\u8eca\u8f2a\uff09\u3001\u4ed6\u4eba\u306e\u6240\u6709\u7269\u306b\u5bfe\u3057\u3066\u8caa\u6b32\u306a\u76ee\u3067\u898b\u3064\u3081\u3001\u6c5a\u3089\u308f\u3057\u3044\u624b\u3092\u4f38\u3070\u3059\u3093\u3060\uff1f\u305d\u3093\u306a\u3053\u3068\u304c\u8a31\u3055\u308c\u308b\u306f\u305a\u304b\uff1f\u300d"}
{"translation": "\u9762\u76b0\u3060\u3089\u3051\u3067\u5c11\u3057\u305a\u3064\u4e0a\u7740\u306e\u88fe\u304b\u3089\u624b\u3092\u5165\u308c\u308b\u7537\u6027\u304c\u5c60\u6bba\u8005\uff08\u4ed5\u5207\u3063\u3066\u308b\u7537\uff09\u306b\u9854\u3092\u5411\u3051\u307e\u3057\u305f\u3002"}
{"translation": "\u5c60\u6bba\u8005\u306f\u9837\u304d\u3001\u30b0\u30eb\u30fc\u30d7\u304b\u30892\u4eba\u51fa\u3066\u6765\u3066\u6b32\u3057\u3044\u65b9\u5411\u306b\u5408\u56f3\u3057\u305f\u3002"}
{"translation": "\u5f7c\u3089\u4e8c\u4eba\u3082\u540c\u69d8\u306b\u77ed\u304f\u5208\u308a\u8fbc\u307e\u308c\u305f\u5c0f\u67c4\u306a\u59ff\u3060\u3063\u305f\u3002"}
{"translation": "\u3069\u3061\u3089\u3082\u725b\u6bba\u3057\u5834\u3067\u52d5\u7269\u3092\u6c17\u7d76\u3055\u305b\u308b\u3088\u3046\u306a\u68cd\u68d2\u3092\u6301\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u300c\u4f55\u8005\u3060\u3068\u8a00\u3046\u306e\u304b\uff1f\u300d\u3068\u3001\u306b\u304d\u3073\u9762\u306e\u7537\u304c\u814b\u304b\u3089\u624b\u3092\u51fa\u3055\u305a\u306b\u305f\u305a\u306d\u305f\u3002"}
{"translation": "\u300c\u6211\u3005\u304c\u4f55\u3092\u3059\u308b\u3079\u304d\u3067\u3001\u4f55\u3092\u3057\u306a\u3044\u65b9\u304c\u826f\u3044\u306e\u304b\u3001\u7686\u3055\u3093\u306b\u3069\u3046\u3053\u3046\u8a00\u308f\u308c\u308b\u7b4b\u5408\u3044\u306f\u306a\u3044\u3002"}
{"translation": "\u3042\u3093\u305f\u306b\u306f\u95a2\u4fc2\u306a\u3044\u3088\u3001\u53ef\u611b\u5c0f\u3002"}
{"translation": "\u6b66\u5668\u6301\u3063\u3066\u306a\u3044\u3060\u308d\uff1f\u771f\u5b9f\u3060\u308d\uff1f\u300d\u898b\u77e5\u3089\u306c\u4eba\u306f\u4e00\u5c64\u610f\u5730\u60aa\u304f\u7b11\u3063\u305f\u3002"}
{"translation": "\u300c\u6301\u3063\u3066\u306a\u3044\u3088\u3002"}
{"translation": "\u305d\u308c\u306f\u30de\u30ba\u30a4\u300d\u3068\u3001\u30cb\u30ad\u30d3\u9762\u306f\u8107\u304b\u3089\u624b\uff08\u305d\u3057\u3066\u305d\u308c\u3068\u5171\u306b\u9577\u5263\uff09\u3092\u53d6\u308a\u51fa\u3057\u305f\u3001\u300c\u304a\u307e\u3048\u3089\u6b66\u5668\u3082\u3063\u3066\u306a\u3093\u3066\u5927\u5909\u4e0d\u5229\u3060\u3002"}
{"translation": "\u8089\u5c4b\u3082\u30ca\u30a4\u30d5\u3092\u629c\u304d\u51fa\u3057\u305f\u3059\u308b\u3069\u304f\u3066\u9577\u30fc\u3044\u3084\u3064\u3060\u3002"}
{"translation": "\u4e8c\u4eba\u9023\u4e2d\u3082\u524d\u9032\u3057\u30d0\u30fc\u30eb\u3092\u63b2\u3052\u3066\u7acb\u3063\u305f\u3002"}
{"translation": "\u300c\u81ea\u5206\u3067\u6301\u3064\u5fc5\u8981\u304c\u7121\u3048\u3093\u300d\u898b\u77e5\u3089\u306c\u304a\u5ba2\u3055\u3093\u8a00\u3063\u305f\u3001\u305d\u306e\u5834\u304b\u3089\u52d5\u304b\u3055\u3059\u306e\u300c\u4ffa\u81ea\u8eab\u304c\u6b66\u5668\u3067\u3042\u308a\u7d9a\u3051\u308b\u3055\u300d"}
{"translation": "\u5ec3\u589f\u304b\u3089\u3001\u67d4\u3089\u304b\u304f\u3001\u78ba\u5b9f\u306a\u8db3\u53d6\u308a\u3067\u4e8c\u4eba\u306e\u82e5\u3044\u5973\u6027\u304c\u73fe\u308c\u305f\u3002"}
{"translation": "\u7fa4\u8846\u306f\u3059\u3050\u306b\u958b\u304d\u3001\u5f15\u304d\u8fd4\u3057\u3001\u3053\u307e\u3054\u307e\u3057\u305f\u3002"}
{"translation": "\u4e21\u65b9\u306e\u5973\u6027\u306f\u5fae\u7b11\u307f\u306a\u304c\u3089\u6b6f\u3092\u898b\u305b\u3066\u76ee\u3092\u7d30\u3081\u3001\u305d\u306e\u4e00\u7aef\u304b\u3089\u8033\u307e\u3067\u5e83\u3044\u9752\u8272\u306e\u30bf\u30c8\u30a5\u30fc\u5e2f\u304c\u7bc9\u304b\u308c\u3066\u3044\u308b\u3002"}
{"translation": "\u5f37\u5065\u306a\u811a\u90e8\u5206\u306b\u306f\u7b4b\u8089\u304c\u3046\u306d\u308a\u4e0a\u3052\u7363\u76ae\u30b9\u30ab\u30fc\u30c8\u304b\u3089\u8997\u304f\u4e00\u65b9\u3001\u92fc\u7db2\u306e\u624b\u888b\u4e0a\u306e\u4e38\u3005\u3068\u3057\u305f\u88f8\u306e\u8155\u3082\u307e\u305f\u305d\u3046\u3060\u3063\u305f\u3002"}
{"translation": "\u4fdd\u8b77\u3055\u308c\u305f\u80a9\u304b\u3089\u306f\u30b5\u30fc\u30d9\u30eb\uff08\u5200\uff09\u306e\u63e1\u308a\u624b\u304c\u7a81\u304d\u51fa\u3066\u3044\u308b\u3002"}
{"translation": "\u3042\u306e\u306b\u304d\u3073\u9854\u306e\u7537\u306f\u3086\u3063\u304f\u308a\u3068\u3001\u3068\u3066\u3082\u3086\u3063\u304f\u308a\u3068\u819d\u3092\u66f2\u3052\u3001\u5730\u9762\u306b\u30ca\u30a4\u30d5\u3092\u653e\u308a\u6295\u3052\u305f\u3002"}
{"translation": "\u304c\u308c\u304d\u306e\u7a74\u304b\u3089\u77f3\u304c\u3054\u308d\u3054\u308d\u3068\u97f3\u3092\u7acb\u3066\u308b\u9a12\u97f3\u304c\u805e\u3053\u3048\u305f\u3002"}
{"translation": "\u305d\u306e\u5f8c\u3001\u6697\u95c7\u304b\u3089\u58c1\u306e\u6b20\u3051\u305f\u7e01\u306b\u3064\u304b\u307e\u3063\u3066\u51fa\u3066\u304d\u305f\u624b\u304c\u73fe\u308c\u305f\u3002"}
{"translation": "\u305d\u308c\u304b\u3089\u6b21\u3005\u3068\u767d\u3044\u9aea\u304c\u30ec\u30f3\u30ac\u7c89\u3067\u307e\u3060\u3089\u306b\u306a\u308a\u3001\u9752\u3056\u3081\u305f\u9854\u3001\u80a9\u8d8a\u3057\u306b\u898b\u3048\u308b\u5263\u306e\u67c4\u3002"}
{"translation": "\u4eba\u3005\u306f\u3056\u308f\u3081\u3044\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u304c\u3001\u8eab\u3092\u5c48\u3081\u3066\u7a74\u306e\u4e2d\u304b\u3089\u5947\u5999\u306a\u5f62\u3092\u5f15\u304d\u305a\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u8840\u306b\u6d78\u3055\u305b\u305f\u5875\u3067\u80a5\u5927\u5316\u3057\u305f\u3053\u3068\u8c61\u3063\u305f\u4f53\u3002"}
{"translation": "\u9577\u3044\u30c8\u30ab\u30b2\u306e\u3088\u3046\u306a\u5c3e\u3067\u305d\u306e\u751f\u7269\u3092\u3064\u304b\u307f\u3001\u7121\u8a00\u3067\u592a\u3063\u305f\u6751\u9577\u306e\u8db3\u5143\u306b\u6295\u3052\u843d\u3068\u3057\u305f\u3002"}
{"translation": "\u6751\u9577\u306f\u9a5a\u3044\u3066\u5f8c\u308d\u306b\u98db\u3073\u8df3\u306d\u3001\u58ca\u308c\u305f\u77f3\u58c1\u306b\u3064\u307e\u3065\u304d\u306a\u304c\u3089\u6e7e\u66f2\u3057\u305f\u9ce5\u306e\u304f\u3061\u3070\u3057\u3001\u76ae\u819c\u72b6\u306e\u7fbd\u6839\u3001\u305d\u3057\u3066\u30a6\u30ed\u30b3\u3067\u8986\u308f\u308c\u305f\u722a\u304c\u938c\u5f62\u306b\u66f2\u304c\u308b\u624b\u8db3\u3092\u898b\u8a70\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u3059\u308b\u3069\u3046\u5439\u304d\u51fa\u308b\u9996\u7b4b\u306f\u4e00\u5ea6\u7d05\u8272\u3060\u3063\u305f\u3060\u308d\u3046\u304c\u4eca\u3067\u306f\u6c5a\u3089\u3057\u304f\u8d64\u8336\u8272\u3060\u3002"}
{"translation": "\u305d\u3057\u3066\u30ac\u30e9\u30b9\u8cea\u3067\u51f9\u3093\u3060\u773c\u3082\u540c\u3058\u3088\u3046\u306b\u898b\u3064\u3081\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u3053\u308c\u304c\u30d0\u30b8\u30ea\u30b9\u30af\u3060\u300d\u3068\u3001\u767d\u9aea\u306e\u7537\u304c\u8a00\u3044\u306a\u304c\u3089\u30ba\u30dc\u30f3\u304b\u3089\u57c3\u3092\u6255\u3063\u305f\u3002"}
{"translation": "\u300c\u5951\u7d04\u901a\u308a\u3060\u3002"}
{"translation": "\u50d5\u306e200\u30ea\u30f3\u30bf\u30eb\u3092\u9802\u3051\u308c\u3070\u300d\u771f\u5263\u306b\u3001\u3068\u3044\u3046\u306b\u306f\u3042\u307e\u308a\u53e9\u304b\u308c\u3066\u3053\u305d\u306e\u30ea\u30f3\u30bf\u30eb\u3002"}
{"translation": "\u78ba\u8a8d\u3055\u305b\u3066\u3082\u3089\u3046\u305e\u3001\u3068\u524d\u3082\u3063\u3066\u544a\u3052\u308b\u3002"}
{"translation": "\u6751\u9577\u306f\u9707\u3048\u308b\u624b\u3067\u8ca1\u5e03\u3092\u6301\u3061\u51fa\u3057\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u306f\u5468\u56f2\u3092\u898b\u56de\u3057\u3001\u4e00\u77ac\u3060\u3051\u306b\u304d\u3073\u9762\u306e\u7537\u3084\u5f7c\u306e\u8db3\u5143\u306b\u6a2a\u305f\u308f\u308b\u30ca\u30a4\u30d5\u306b\u76ee\u3092\u7559\u3081\u305f\u3002"}
{"translation": "\u8336\u8272\u306e\u30c1\u30e5\u30cb\u30c3\u30af\u59ff\u306e\u7537\u3084\u91ce\u751f\u7363\u76ae\u670d\u7740\u7528\u8005\u9054\u304c\u5404\u3005\u6ce8\u8996\u3057\u3066\u3044\u305f\u305d\u306e\u72b6\u6cc1\u3082\u898b\u3048\u3059\u308b\u3088\u3046\u6c17\u914d\u3067\u5bdf\u3057\u305f\u5f8c\u308d\u59ff\u3092\u3002"}
{"translation": "\u300c\u3044\u3064\u3082\u306e\u3088\u3046\u306b\u300d\u3068\u5f7c\u306f\u9707\u3048\u308b\u6751\u9577\u306e\u624b\u304b\u3089\u30d1\u30a4\u30d7\u3092\u53d6\u308a\u51fa\u3059\u3002"}
{"translation": "\u300c\u5b89\u3044\u91d1\u306e\u305f\u3081\u306b\u547d\u3092\u8ced\u3051\u3066\u3044\u308b\u3093\u3060\u3002"}
{"translation": "\u305d\u306e\u9593\u306b\u3042\u3093\u305f\u305f\u3061\u306f\u50d5\u306e\u6301\u3061\u7269\u306b\u624b\u3092\u4ed8\u3051\u3066\u3002\u3002\u3002"}
{"translation": "\u4f55\u5e74\u7d4c\u3063\u3066\u3082\u3001\u4e00\u5411\u306b\u5909\u308f\u3089\u306a\u3044\u306a\u3002\u300d\u3068\u3001\u5f7c\u306f\u3057\u3083\u304c\u307f\u3053\u3080\u8089\u5c4b\u3092\u898b\u3064\u3081\u305f\u3002"}
{"translation": "\u300c\u307e\u3063\u305f\u304f\u89e6\u308c\u3066\u306a\u3044\u3088\u300d\u3068\u8089\u5c4b\u304c\u5f8c\u305a\u3055\u308a\u3057\u3066\u3076\u3064\u3076\u3064\u3068\u8a00\u3046\u3002"}
{"translation": "\u30d0\u30c3\u30c8\u3092\u6301\u3063\u305f\u8005\u305f\u3061\u306f\u3068\u3046\u306b\u7fa4\u8846\u306e\u4e2d\u306b\u6eb6\u3051\u8fbc\u3093\u3067\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u8ab0\u3082\u3042\u306a\u305f\u65b9\u306e\u3082\u306e\u306b\u306f\u89e6\u308c\u3066\u304a\u3089\u305b\u3093\u3001\u304a\u4e3b\u69d8\u300d\u8001\u4eba\u306f\u5fae\u7b11\u307f\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u7b11\u9854\u304c\u84bc\u767d\u304d\u76ae\u819a\u4e0a\u3067\u958b\u82b1\u3059\u308b\u50b7\u53e3\u898b\u3048\u308b\u3068\u3001\u7fa4\u96c6\u304c\u6025\u901f\u9000\u6563\u3057\u59cb\u3081\u307e\u3059\u3002"}
{"translation": "\u300c\u3060\u304b\u3089\u5f1f\u3088\u3001\u541b\u3053\u305d\u5b89\u5168\u3060\u308d\u3046\u3002\u5e73\u548c\u88cf\u3067\u53bb\u3063\u3066\u304f\u3060\u3055\u3044\u3002\u305f\u3060\u3057\u65e9\u304f\u53bb\u3063\u3066\u9802\u304d\u307e\u3059\u3088\u3046\u300d"}
