{"translation": "\u300c\u3042\u3044\u3064\u306f\u3082\u3046\u51fa\u3066\u3053\u308c\u306a\u3044\u3063\u3066\u3001\u8a00\u3063\u3066\u308b\u3093\u3060\u3088\u300d"}
{"translation": "\u3068\u306b\u304d\u3073\u9762\u306e\u7537\u304c\u81ea\u4fe1\u6e80\u3005\u306b\u9837\u304d\u306a\u304c\u3089\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u3082\u3046\u4e00\u6642\u959315\u5206\u3082\u305d\u3053\u306b\u5165\u308a\u8fbc\u3093\u3067\u308b\u3002"}
{"translation": "\u7d42\u308f\u308a\u3060\u308d\u3046\u306d\u300d\u3002"}
{"translation": "\u5e02\u6c11\u305f\u3061\u306f\u3001\u5ec3\u589f\u306e\u4e2d\u3067\u5bc6\u96c6\u3057\u3001\u898b\u5165\u3063\u3066\u4f55\u3082\u8a00\u308f\u305a\u3001\u305d\u306e\u7a74\u3068\u3044\u3046\u7a74\u304b\u3089\u751f\u3058\u308b\u95c7\u3092\u898b\u3064\u3081\u3066\u3044\u305f\u3002"}
{"translation": "\u5730\u4e0b\u5165\u53e3\u306e\u74e6\u792b\u3092\u773a\u3081\u306a\u304c\u3089\u3002"}
{"translation": "\u9ec4\u8272\u306e\u30b3\u30fc\u30c8\u3092\u7740\u305f\u592a\u3063\u305f\u7537\u304c\u8db3\u304b\u3089\u8db3\u3078\u3068\u4f53\u91cd\u3092\u79fb\u3057\u3001\u54b3\u6255\u3044\u3057\u305f\u5f8c\u3067\u5f7c\u306f\u6f70\u308c\u305f\u30d9\u30ec\u30fc\u5e3d\u3092\u982d\u304b\u3089\u53d6\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u3082\u3046\u3057\u3070\u3089\u304f\u5f85\u3068\u3046\u300d\u5f7c\u306f\u7a00\u306a\u7709\u6bdb\u304b\u3089\u6c57\u3092\u62ed\u3063\u305f\u3002"}
{"translation": "\u300c\u4f55\u3092\u5f85\u3064\u3093\u3060\uff1f\u300d\u306b\u304d\u3073\u9854\u304c\u3075\u304d\u3060\u3057\u305f\u3002"}
{"translation": "\u300c\u5730\u4e0b\u7262\u306b\u306f\u30d0\u30b8\u30ea\u30b9\u30af\u304c\u3044\u308b\u3001\u5fd8\u308c\u305f\u304b\u3057\u3089\u4ee3\u5b98\u69d8\uff1f\u8ab0\u3067\u3082\u5165\u308c\u3070\u4e8c\u5ea6\u3068\u51fa\u3066\u3053\u308c\u306a\u3044\u3002"}
{"translation": "\u4eba\u9593\u304c\u4f55\u4eba\u6b7b\u3093\u3060\u3053\u3068\u304b\u3002"}
{"translation": "\u3060\u304b\u3089\u4f55\u3092\u5f85\u3064\u3063\u3066\u3044\u3046\u306e\u3088\uff1f\u300d\u304a\u307e\u3048\u305f\u3061\u3067\u6c7a\u3081\u305f\u3060\u308d\u3046\u3001\u592a\u9f13\u5439\u3055\u3093\u304c\u4e0d\u5b89\u305d\u3046\u306b\u3064\u3076\u3084\u3044\u305f\u3002"}
{"translation": "\u300c\u305d\u3046\u3059\u308b\u3063\u3066\uff1f\u751f\u8005\u3067\u8a71\u305b\u3066\u307e\u3057\u305f\u308f\u3088\u306d\u3002\u300d\u30c7\u30d6\u306e\u53cb\u4eba\u3082\u8a00\u3063\u305f\u3001\u300c\u3042\u306e\u771f\u65b0\u3057\u3044\u30ec\u30b6\u30fc\u30a8\u30d7\u30ed\u30f3\u3092\u7740\u305f\u5de8\u6f22\u3067\u3059\u3088\u3001\u4eca\u3084\u5f7c\u306f\u6b7b\u3093\u3067\u3044\u307e\u3059\u3001\u305d\u308c\u306f\u5929\u7a7a\u306e\u592a\u967d\u4e26\u307f\u306b\u660e\u767d\u3067\u3059\u3002"}
{"translation": "\u4ed6\u8005\u3068\u540c\u3058\u904b\u547d\u306b\u5411\u304b\u3063\u3066\u9032\u3080\u3053\u3068\u306f\u6700\u521d\u304b\u3089\u5206\u304b\u3063\u3066\u307e\u3057\u305f\u308f\u3088\u3002"}
{"translation": "\u3042\u3061\u3089\u3055\u3093\u3054\u7528\u610f\u3042\u3055\u3044\u307e\u305b\u3093\u3067\u3057\u305f\u308f\u3051\uff1f"}
{"translation": "\u305f\u3060\u5263\u4e00\u672c\u3057\u304b\u6301\u3061\u8fbc\u307e\u306a\u304b\u3063\u305f\u3057\u3001\u3001\u305d\u308c\u3067\u306f\u30d0\u30b8\u30ea\u30b9\u30af\u3055\u3048\u6bba\u3059\u3053\u3068\u3082\u51fa\u6765\u306a\u3044\u3001\u8ab0\u3067\u3082\u305d\u308c\u304f\u3089\u3044\u77e5\u3063\u3066\u307e\u3059\u308f"}
{"translation": "\u3042\u306a\u305f\u304c\u305f\u306f\u307b\u3093\u306e\u5c11\u984d\u3092\u7bc0\u7d04\u3057\u305f\u3001\u30cb\u30ad\u30d3\u9762\u306e\u6751\u9577\u306f\u4ed8\u3051\u52a0\u3048\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u3001\u8ab0\u3082\u30d0\u30b8\u30ea\u30b9\u30af\u306b\u652f\u6255\u3044\u3092\u3059\u308b\u4eba\u7269\u306f\u3044\u307e\u305b\u3093\u3002"}
{"translation": "\u5b89\u5fc3\u3057\u3066\u5bb6\u306b\u5e30\u308a\u306a\u3055\u3044\u3002"}
{"translation": "\u9b54\u6cd5\u4f7f\u3044\u306e\u99ac\u3068\u8ca1\u7523\u306f\u79c1\u305f\u3061\u304c\u5f15\u304d\u53d6\u308b\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u8cb4\u91cd\u306a\u3082\u306e\u3092\u653e\u68c4\u3059\u308b\u308f\u3051\u306b\u306f\u3044\u304b\u306a\u3044\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u305d\u3046\u3060\u3001\u8089\u5c4b\u304c\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u898b\u4e8b\u306a\u96cc\u99ac\u3060\u3057\u3001\u8377\u8eca\u3082\u3061\u3083\u3093\u3068\u8a70\u3081\u3089\u308c\u3066\u308b\u3088\u306d\u3002"}
{"translation": "\u4e2d\u8eab\u3092\u8997\u3053\u3046\u304b\u300d\u3001\u300c\u3069\u3046\u3057\u3066?\u4f55\u3092\u8003\u3048\u3066?\u300d\u3001\u300c\u9ed9\u308c\u3001\u6751\u9577\u65b0\u53c2\u8005\u304b\u3089\u76ee\u7acb\u3064\u3053\u3068\u307b\u3069\u5371\u967a\u306a\u3053\u3068\u306f\u7121\u3044\u300d\u3068\u30cb\u30ad\u30d3\u9762\u304c\u8b66\u544a\u3002"}
{"translation": "\u300c\u898b\u4e8b\u306a\u96cc\u99ac\u300d\u8089\u5c4b\u304c\u7e70\u308a\u8fd4\u3057\u305f\u3002"}
{"translation": "\u300c\u305d\u306e\u99ac\u3092\u653e\u3063\u3066\u304a\u304f\u3053\u3068\u4f4d\u983c\u3080\u308f\u3088\u300d\u300c\u8089\u5c4b\u3055\u3093\u300d \u4e0d\u5be9\u8005\u304c\u58c1\u89d2\u304b\u3089\u51fa\u3066\u304d\u3066\u304a\u3058\u3055\u3093\u304b\u3089\u6ce8\u610f\u3055\u308c\u611b\u79f0\uff08\u7565\u79f0\uff09\u3067\u547c\u3070\u308c\u4e0d\u81ea\u7136 \u658e\u5834\u30fb\u96c6\u4f1a\u6240\u5165\u53e3\u5468\u8fba\u7a81\u5982\u767b\u5834 \u6210\u4eba\u7537\u6027\u76f8\u624b\u4eba\u3005\u80cc\u5f8c\u5373\u6642\u5fdc\u7b54\u6c42\u4e73 \u614e\u91cd \u6ce8\u610f \u51a0\u90e8\u5206\u602a\u8a1d\u6146\u7768\u307f\u30c1\u30e9\u898b \u811a\u7560\u6d69\u5b50 \u8fd4\u9867 \u9013\u4fe1\u7701 \u4eba\u7269\u7d39\u4ecb\u304c\u5fc5\u8981"}
{"translation": "\u305d\u306e\u7537\u306f\u30ab\u30fc\u30eb\u304c\u8c4a\u304b\u3067\u6817\u8272\u306e\u9aea\u3001\u8336\u8272\u3044\u30c1\u30e5\u30cb\u30c3\u30af\u3092\u8eab\u306b\u307e\u3068\u3063\u3066\u304a\u308a\u3001\u5185\u5074\u306b\u306f\u30d1\u30c7\u30a3\u30f3\u30b0\u304c\u8a70\u3081\u3089\u308c\u305f\u30ab\u30d5\u30bf\u30f3\u3001\u305d\u3057\u3066\u9ad8\u3044\u4e57\u99ac\u7528\u306e\u30d6\u30fc\u30c4\u3092\u5c65\u3044\u3066\u3044\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u6b66\u5668\u306f\u4e00\u5207\u6301\u3063\u3066\u3044\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u518d\u5ea6\u300c\u99ac\u304b\u3089\u96e2\u308c\u308d\u300d\u3068\u5f7c\u306f\u8a00\u3044\u3001\u60aa\u610f\u306b\u6e80\u3061\u305f\u7b11\u307f\u3092\u6d6e\u304b\u3079\u305f\u3002"}
{"translation": "\u300c\u306a\u308b\u307b\u3069\u306d\uff1f"}
{"translation": "\u4ed6\u4eba\u306e\u99ac\u3001\u4ed6\u4eba\u306e\u8377\u7269\u3001\u4ed6\u4eba\u306e\u6240\u6709\u7269\u3002"}
{"translation": "\u305d\u3057\u3066\u541b\u304c\u305d\u308c\u3089\u306b\u5bfe\u3057\u3066\u81ea\u5206\u306e\u6b32\u6df1\u3044\u76ee\u3092\u5411\u3051\u3001\u5351\u8ce4\u306a\u624b\u3092\u4f38\u3070\u3059\u3060\u304b\u3089\uff1f\u300d\u3068\u5f7c\u306f\u7d9a\u3051\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u305d\u308c\u304c\u6b63\u3057\u3044\u3053\u3068\u3060\u3068\u601d\u3046\u304b\uff1f\u300d"}
{"translation": "\u9854\u9762\u96ea\u6d1e\u7621\u6027\u3067\u3086\u3063\u304f\u308a\u814b\u4e0b\u306b\u624b\u3092\u6ed1\u308a\u8fbc\u307e\u305b\u308b\u7537\u6027\u304c\u5c60\u6bba\u5e2b\u65b9\u5411\u306b\u8996\u7dda\u6295\u3058\u307e\u3059\u3002"}
{"translation": "\u5c60\u6bba\u5e2b\u65b9\u5411\u90e8\u9996\u9837\u304d\uff14\u56de\u547d\u4ee4\u305d\u3063\u3061\u767a\u5c04\u4e8c\u304a\u3053\u540d\u524d\u3059\u308b\u4fe1\u6101\u3084\u3093\u305b\u3051\u8fd4\u623b\u4fe1\u771f\u5263\u758a\u8a69\u5e73\u58cc\u5fdc\u4e09(\u5c71\u7530)\u540d144\u4e16"}
{"translation": "\u300c\u4f55\u8005\u3060\u3068\u8a00\u3046\u306e\u304b\uff1f\u300d\u3068\u3001\u306b\u304d\u3073\u9762\u306e\u7537\u304c\u814b\u304b\u3089\u624b\u3092\u51fa\u3055\u305a\u306b\u5c0b\u306d\u305f\u3002"}
{"translation": "\u300c\u3057\u3063\u304b\u308a\u63e1\u624b\u3082\u305b\u305a\u306b\u3001\u306a\u3093\u3067\u3082\u8a31\u3055\u308c\u308b\u3063\u3066\u3053\u3068\u3067\u3082\u3042\u3063\u305f\u3089\u3069\u3046\u3059\u308b\uff1f\u3053\u3061\u3089\u306e\u4e8b\u60c5\u306b\u53e3\u3092\u631f\u307e\u306a\u3044\u3067\u304f\u308c\u308b\uff1f\u300d \u5916\u56fd\u4eba\u306f\u3055\u3089\u306b\u51b7\u7b11\u3092\u6d6e\u304b\u3079\u3001\u300c\u6b66\u5668\u306f\u6301\u3063\u3066\u3044\u307e\u305b\u3093\u300d\u3068\u7b54\u3048\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u60aa\u4ee3\u5b98\u3060\u3063\u305f\u3002"}
{"translation": "\u30cb\u30ad\u30d3\u9762\u304c\u8107\u304b\u3089\u9577\u3044\u30ca\u30a4\u30d5\u3092\u53d6\u308a\u51fa\u3057\u3001\u300c\u304a\u524d\u305f\u3061\u306f\u6b66\u5668\u3092\u643a\u5e2f\u3057\u3066\u306a\u3044\u3068\u3044\u3046\u3053\u3068\u304c\u554f\u984c\u3060\u300d\u3068\u8a9e\u308a\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u5927\u5de5\u304c\u541b\u3082\u540c\u3058\u304f\u9577\u30fc\u3044\u30ca\u30a4\u30d5\u3001\u307e\u308b\u3067\u5200\u307f\u305f\u3044\u306a\u3084\u3064\u3092\u53d6\u308a\u51fa\u3057\u305f\u77ac\u9593\u3001\u4ed6\u306e\u4e8c\u4eba\u3082\u524d\u9032\u3057\u68cd\u68d2\u3092\u6319\u3052\u3066\u6765\u305f\u3002"}
{"translation": "\u300c\u79c1\u304c\u6b66\u5668\u3092\u6301\u3064\u5fc5\u8981\u306f\u306a\u3044\u300d"}
{"translation": "\u5916\u56fd\u4eba\u306f\u9759\u6b62\u3057\u3066\u8a00\u3063\u305f\u3001\u300c\u79c1\u306e\u6b66\u5668\u306f\u79c1\u306e\u5f8c\u308d\u306b\u4ed8\u3044\u3066\u6765\u307e\u3059\u3002"}
{"translation": "<ERROR>"}
{"translation": "\u3042\u306e\u306b\u304d\u3073\u9854\u306e\u7537\u306f\u3086\u3063\u304f\u308a\u3068\u3001\u3068\u3066\u3082\u3086\u3063\u304f\u308a\u3068\u819d\u3092\u66f2\u3052\u3001\u5730\u9762\u306b\u30ca\u30a4\u30d5\u3092\u653e\u308a\u6295\u3052\u305f\u3002"}
{"translation": "\u304c\u308c\u304d\u306e\u7a74\u304b\u3089\u77f3\u304c\u3054\u308d\u3054\u308d\u3068\u97f3\u3092\u7acb\u3066\u308b\u9a12\u97f3\u304c\u805e\u3053\u3048\u305f\u3002"}
{"translation": "\u305d\u306e\u5f8c\u3001\u6697\u95c7\u304b\u3089\u58c1\u306e\u6b20\u3051\u305f\u7e01\u306b\u3064\u304b\u307e\u3063\u3066\u3044\u308b\u624b\u304c\u73fe\u308c\u305f\u3002"}
{"translation": "\u305d\u306e\u624b\u306b\u7d9a\u3044\u3066\u30ec\u30f3\u30ac\u7c89\u3067\u767d\u304f\u306a\u3063\u305f\u9aea\u306e\u982d\u90e8\u3001\u9752\u767d\u3044\u9854\u3001\u80a9\u304b\u3089\u7a81\u304d\u51fa\u3057\u305f\u5263\u306e\u67c4\u304c\u9806\u756a\u306b\u898b\u3048\u3066\u304d\u305f\u3002"}
{"translation": "\u4eba\u3005\u306f\u3056\u308f\u3081\u304d\u59cb\u3081\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u304c\u3001\u8eab\u3092\u5c48\u3081\u3066\u7a74\u306e\u4e2d\u304b\u3089\u5947\u5999\u306a\u5f62\u3092\u5f15\u304d\u305a\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u8840\u306b\u6d78\u3055\u305b\u305f\u5875\u3067\u80a5\u5927\u5316\u3057\u305f\u3053\u3068\u8c61\u3063\u305f\u4f53\u3002"}
{"translation": "\u5909\u308f\u308a\u679c\u3066\u305f\u751f\u304d\u7269\u3092\u9577\u304f\u4f38\u3073\u308b\u30c8\u30ab\u30b2\u306e\u3088\u3046\u306a\u5c3e\u3067\u3064\u304b\u307f\u3001\u4e00\u8a00\u3082\u8a00\u308f\u305a\u306b\u592a\u3063\u305f\u7bc4\u7587\u306e\u8db3\u5143\u306b\u653e\u3063\u305f\u3002"}
{"translation": "\u7bc4\u7587\u306f\u9a5a\u3044\u3066\u98db\u3073\u9000\u304d\u3001\u5012\u308c\u305f\u58c1\u7247\u306b\u8db3\u3092\u53d6\u3089\u308c\u3064\u307e\u3065\u3044\u3061\u3083\u3063\u305f\u3053\u3068\u3060\u3051\u898b\u3066\u3001\u6e7e\u66f2\u3057\u305f\u9ce5\u306e\u5634\u5f62\u72b6\u3084\u819c\u7d44\u7e54\u98db\u819c\u3001\u305d\u3057\u3066\u30a6\u30ed\u30b3\u3067\u8986\u308f\u308c\u305f\u8db3\u5143\u306b\u3042\u308b\u938c\u5f62\u722a\u3092\u898b\u4e0a\u3052\u305f\u3060\u3051\u3060\u3002"}
{"translation": "\u304b\u3064\u3066\u306f\u771f\u7d05\u8272\u3060\u3063\u305f\u81a8\u3089\u3093\u3060\u5589\u4ecf\u3082\u3001\u3044\u307e\u3067\u306f\u6ce5\u8272\u6df7\u3058\u308a\u306b\u306a\u3063\u3066\u3057\u307e\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u5149\u6ca2\u304c\u3042\u3063\u3066\u51f9\u3093\u3060\u76ee\u3082\u305d\u3046\u3002"}
{"translation": "\u300c\u3053\u308c\u304c\u30d0\u30b8\u30ea\u30b9\u30af\u3060\u300d\u3068\u3001\u767d\u9aea\u306e\u7537\u304c\u8a00\u3044\u306a\u304c\u3089\u30ba\u30dc\u30f3\u304b\u3089\u57c3\u3092\u6255\u3063\u305f\u3002"}
{"translation": "\u300c\u53d6\u308a\u6c7a\u3081\u306e\u901a\u308a\u3060\u3002"}
{"translation": "\u79c1\u306e200\u30ea\u30f3\u30bf\u30fc\u30eb\u3092\u3057\u3063\u304b\u308a\u6255\u3063\u3066\u3082\u3089\u304a\u3046\u3002"}
{"translation": "\u304d\u3061\u3093\u3068\u3057\u305f\u30ea\u30f3\u30bf\u30fc\u30eb\u3092\u3053\u3053\u305e\u3068\u3044\u3046\u6642\u306b\u4f7f\u3048\u308b\u3088\u3046\u306a\u3082\u306e\u3067\u306d\u3002"}
{"translation": "\u8abf\u67fb\u3059\u308b\u3064\u3082\u308a\u3060\u3068\u4f1d\u3048\u3066\u304a\u304f\u300d"}
{"translation": "\u5e02\u9577\u306f\u9707\u3048\u308b\u624b\u3067\u888b\u304b\u3089\u8ca8\u5e63\u3092\u53d6\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u306f\u5468\u56f2\u3092\u898b\u6e21\u3057\u3001\u305d\u306e\u8996\u7dda\u306f\u4e00\u77ac\u3001\u8db3\u5143\u306b\u843d\u3061\u3066\u3044\u305f\u30ca\u30a4\u30d5\u3084\u30cb\u30ad\u30d3\u9854\u306e\u7537\u5973\u306b\u7559\u307e\u3063\u305f\u3002"}
{"translation": "\u8336\u8272\u3044\u30c1\u30e5\u30cb\u30c3\u30af\u59ff\u306e\u7537\u3084\u91ce\u751f\u30ad\u30c4\u30cd\u76ae\u88c5\u675f\u3067\u8eab\u3092\u5305\u3093\u3060\u5973\u6027\u305f\u3061\u306b\u76ee\u79fb\u308a\u3057\u3064\u3064\u898b\u56de\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u300c\u3044\u3064\u3082\u306e\u3088\u3046\u306b\u300d\u3068\u5f7c\u306f\u8a00\u3044\u3001\u9707\u3048\u308b\u6751\u9577\u306e\u624b\u304b\u3089\u7159\u8349\u3092\u53d6\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u300c\u308f\u305a\u304b\u306a\u91d1\u306e\u305f\u3081\u306b\u79c1\u304c\u3042\u306a\u305f\u305f\u3061\u306e\u547d\u3092\u5371\u967a\u306b\u3055\u3089\u3057\u3066\u3044\u308b\u4e00\u65b9\u3067\u3001\u3042\u306a\u305f\u305f\u3061\u306f\u79c1\u306e\u7269\u306b\u624b\u3092\u3064\u3051\u3066\u3044\u308b\u3002"}
{"translation": "\u307e\u3063\u305f\u304f\u3001\u3042\u306a\u305f\u304c\u305f\u306f\u5909\u308f\u3089\u306a\u3044\u306d\u300d"}
{"translation": "\u8089\u5c4b\u306f\u524d\u9032\u305b\u305a\u545f\u304d\u3001\u5f8c\u9000\u3057\u305f\u3002"}
{"translation": "\u68d2\u3067\u6b66\u88c5\u3057\u305f\u8005\u9054\u306f\u65e2\u306b\u4eba\u6df7\u307f\u306b\u7d1b\u308c\u3066\u3057\u307e\u3063\u305f\u3002"}
{"translation": "\u300c\u3042\u306a\u305f\u3060\u3051\u306e\u7269\u54c1\u3067\u3059\u3088\u3001\u304a\u3058\u3055\u307e\u300d\u767d\u9aea\u306e\u7537\u6027\u304c\u5b09\u3057\u305d\u3046\u306b\u5fae\u7b11\u3093\u3060\u3002"}
{"translation": "\u305d\u306e\u7b11\u9854\u3092\u898b\u3066\u3001\u84bc\u767d\u306a\u9854\u8272\u3067\u75db\u3005\u3057\u304f\u54b2\u304d\u8a87\u308b\u3053\u306e\u72b6\u6cc1\u304b\u3089\u3001\u7fa4\u8846\u306f\u6025\u901f\u306b\u89e3\u6563\u3057\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u3060\u304b\u3089\u3053\u305d\uff65\uff65\uff65\uff65\u5144\u5f1f\u3088\uff65\uff65\uff65\uff65"}
{"translation": "\u8cb4\u65b9\u3082\u89e6\u308c\u3089\u308c\u308b\u4e8b\u306f\u7121\u304f\uff65\uff65\uff65"}
{"translation": "\u5b89\u5fc3\u3057\u3066\u53bb\u3063\u3066\u304f\u3060\u3055\u3044\uff65\uff65\uff65"}
{"translation": "\u3057\u304b\u3057\u6025\u3044\u3067\u53bb\u3063\u3066\u3061\u3087\u3046\u3060\u3055\u3044_\u3002"}
