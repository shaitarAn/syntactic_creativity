{"translation": "\u300c\u5f7c\u306f\u305d\u3053\u304b\u3089\u51fa\u3066\u3053\u308c\u306a\u3044\u3063\u3066\u3001\u8a00\u3063\u3066\u308b\u3093\u3060\u3088\u300d\u3068\u30cb\u30ad\u30d3\u9854\u306e\u9752\u5e74\u304c\u3001\u78ba\u4fe1\u306b\u6e80\u3061\u305f\u58f0\u3067\u9996\u3092\u632f\u3063\u305f\u3002"}
{"translation": "\u300c\u3082\u30461\u6642\u959315\u5206\u3082\u3042\u305d\u3053\u306b\u5165\u308a\u8fbc\u3093\u3067\u3044\u308b\u3002"}
{"translation": "\u3082\u3046\u3060\u3081\u3060\u308d\u3046\u3068\u601d\u3046\u300d"}
{"translation": "\u753a\u306e\u4eba\u3005\u306f\u5ec3\u589f\u306e\u4e2d\u3067\u5bc6\u96c6\u3057\u3001\u9ed9\u3063\u3066\u304f\u305a\u308c\u305f\u5165\u53e3\u304b\u3089\u5e83\u304c\u308b\u5730\u4e0b\u5ba4\u3078\u3068\u81f3\u308b\u6697\u95c7\u306b\u898b\u3064\u3081\u3066\u3044\u305f\u3002"}
{"translation": "\u592a\u3063\u305f\u7537\u306f\u9ec4\u8272\u3044\u30b3\u30fc\u30c8\u3092\u7740\u3066\u7247\u8db3\u304b\u3089\u7247\u8db3\u3078\u3068\u4f53\u91cd\u3092\u79fb\u3057\u3001\u5589\u3092\u30ab\u30e9\u30ea\u3068\u9cf4\u3089\u3057\u3066\u982d\u304b\u3089\u304f\u3061\u3083\u3063\u3068\u3057\u305f\u30d9\u30ec\u30fc\u5e3d\u3092\u53d6\u308a\u4e0a\u3052\u305f\u3002"}
{"translation": "\u300c\u307e\u3060\u5f85\u3068\u3046\u300d\u5f7c\u306f\u73cd\u3057\u3044\u307e\u3086\u3052\u306b\u3064\u3044\u305f\u6c57\u3092\u62ed\u3044\u306a\u304c\u3089\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u4f55\u3092\u5f85\u3064\u3093\u3060\uff1f\u300d\u3068\u3001\u3067\u304d\u3082\u306e\u9762\u306e\u7537\u304c\u5632\u7b11\u3057\u305f\u3002"}
{"translation": "\u300c\u5730\u4e0b\u7262\u306b\u306f\u30d0\u30b8\u30ea\u30b9\u30af\u304c\u3044\u308b\u3093\u3058\u3083\u306a\u304b\u3063\u305f\u304b\u3001\u304a\u524d\u3089\u5fd8\u308c\u305f\u306e\u304b\uff1f"}
{"translation": "\u8ab0\u3067\u3082\u305d\u3053\u306b\u5165\u308c\u3070\u7d42\u308f\u308a\u3060\u3088\u3002"}
{"translation": "\u4f55\u4eba\u3082\u4eba\u9593\u304c\u305d\u3053\u3067\u679c\u3066\u3066\u304d\u305f\u3093\u3058\u3083\u306a\u3044\u304b\uff1f\u4f55\u3092\u5f85\u3063\u3066\u308b\u3063\u3066\u3044\u3046\u3093\u3060\uff1f"}
{"translation": "\u6211\u3005\u306f\u7d04\u675f\u3057\u305f\u306f\u305a\u3060\u308d\u3046\u300d\u3068\u4e0d\u78ba\u5b9f\u3055\u306b\u6e80\u3061\u305f\u58f0\u3067\u592a\u3063\u3061\u3087\u304c\u4f4e\u304f\u3064\u3076\u3084\u3044\u305f\u3002"}
{"translation": "\u300c\u305d\u308c\u306a\u3089\u3069\u3046\u3057\u3066\u308b\uff1f\u300d\u5bb9\u8c8c\u306e\u7537\u306e\u4ef2\u9593\u3001\u76ae\u88fd\u306e\u8089\u5c4b\u30a8\u30d7\u30ed\u30f3\u3092\u7740\u3051\u3066\u7acb\u6d3e\u3055\u305b\u3066\u300c\u751f\u8eab\u3067\u3082\u7d04\u675f\u3057\u305f\u3063\u3066\u8a00\u3063\u3066\u308b\u308f\u3051\u304b\u3002"}
{"translation": "\u4eca\u3084\u5f7c\u306f\u6b7b\u4eba\u3060\u3002"}
{"translation": "\u305d\u308c\u306f\u5929\u7a7a\u306b\u3042\u308b\u65e5\u3068\u540c\u3058\u3088\u3046\u306b\u78ba\u5b9a\u7684\u3060\u3088\u3002"}
{"translation": "\u59cb\u3081\u304b\u3089\u5206\u304b\u3063\u3066\u305f\u3060\u308d\u3046\u3001\u3053\u306e\u9053\u6b69\u307f\u7d9a\u3051\u308c\u3070\u5371\u967a\u3059\u308b\u9053\u884c\u304f\u8005\u3068\u3057\u3066\u3001\u4ed6\u8005\u6570\u591a\u304f\u9078\u629e\u3057\u3066\u304d\u305f\u5b58\u5728\u3068\u540c\u69d8\u8272\u8c37\u8d77\u3053\u3059\u3088\u3046\u9078\u3073\u53d6\u3063\u305f\u3060\u308d\uff1f"}
{"translation": "\u307e\u305f\u5f7c\u7279\u4f8b\u7121\u93e1\u6301\u53c2\u3055\u308c\u5b9f\u969b\u5263\u5fc5\u8981\u6240\u6709\u52d5\u5411\u8a66\u3059\u884c\u52d5\u9032\u3081\u3066\u3057\u307e\u3063\u305f\u3060\u308d\u3057\u304b\u3057\u4e00\u822c\u5e38\u8b58\u53ca\u3073\u5168\u3066\u306e\u4eba\u3005\u3082\u77e5\u308b\u3068\u304a\u308a\u3057\u304b\u3057\u93e1\u7121\u3057\u3067\u306f\u30d0\u30b8\u30ea\u30b9\u30af\u8ca0\u304b\u305b\u3046\u4e8b\u306f\u4e0d\u53ef\u80fd\u3001\u305d\u308c\u8ab0\u3067\u3082\u77e5\u3063\u3066\u3044\u308b\u3060\u308d\u3046\u3002"}
{"translation": "\u300c\u3042\u306a\u305f\u305f\u3061\u306f\u4e00\u6587\u3092\u7bc0\u7d04\u3057\u305f\u300d\u3068\u3001\u76ae\u819a\u75c5\u306e\u7537\u304c\u52a0\u3048\u305f\u3002"}
{"translation": "\u300c\u3044\u305a\u308c\u306b\u305b\u3088\u3001\u30d0\u30b8\u30ea\u30b9\u30af\u306b\u652f\u6255\u3046\u4eba\u306f\u3044\u306a\u3044\u3002"}
{"translation": "\u3060\u304b\u3089\u5b89\u5fc3\u3057\u3066\u5bb6\u306b\u5e30\u308a\u306a\u3055\u3044\u3002"}
{"translation": "\u305d\u3057\u3066\u6211\u3005\u306f\u9b54\u6cd5\u4f7f\u3044\u306e\u99ac\u3068\u5bb6\u755c\u3092\u624b\u306b\u5165\u308c\u308b\u3060\u308d\u3046\u3001\u5bcc\u3092\u7121\u99c4\u306b\u3059\u308b\u306e\u306f\u6094\u3057\u3044\u3082\u306e\u3060\u3002"}
{"translation": "\u305d\u306e\u898b\u77e5\u3089\u306c\u4eba\u306f\u8336\u8272\u3063\u307d\u3044\u6fc3\u3044\u9aea\u3092\u8c4a\u304b\u306b\u5dfb\u304b\u305b\u3001\u539a\u5730\u306e\u30c1\u30e5\u30cb\u30c3\u30af\u306b\u9ad8\u9774\u3092\u5c65\u3044\u3066\u3044\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u6b66\u5668\u306f\u6301\u3063\u3066\u3044\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u300c\u99ac\u304b\u3089\u9000\u3051\u300d\u3068\u5f7c\u306f\u518d\u3073\u8a00\u3063\u305f\u304c\u3001\u305d\u308c\u3068\u540c\u6642\u306b\u7370\u731b\u306a\u7b11\u307f\u3092\u6d6e\u304b\u3079\u305f\u3002"}
{"translation": "\u300c\u3069\u3046\u3044\u3046\u3053\u3068\u3060\uff1f \u99ac\u3082\u88c5\u5099\u3082\u4ed6\u4eba\u306e\u6240\u6709\u7269\u3060\u3068\u3044\u3046\u306e\u306b\u3001\u541b\u306f\u91ce\u86ee\u306a\u773c\u5dee\u3057\u3067\u305d\u308c\u3089\u3092\u898b\u4e0a\u3052\u308b\u3093\u3060\u3002"}
{"translation": "\u305d\u3057\u3066\u5351\u3057\u3080\u304f\u308d\u30dc\u30ed\u30dc\u30ed\u306e\u624b\u3092\u4f38\u3070\u3059\uff1f \u305d\u308c\u304c\u8a31\u3055\u308c\u308b\u3053\u3068\u3060\u308d\u3046\u304b\uff1f\u300d"}
{"translation": "\u9762\u76b0\u9854\u304c\u3086\u3063\u304f\u308a\u3068\u8863\u670d\u306e\u4e0b\u304b\u3089\u624b\u3092\u5f15\u304d\u51fa\u3057\u306a\u304c\u3089\u5c60\u6bba\u8005\u3092\u898b\u3064\u3081\u305f\u3002"}
{"translation": "\u5c60\u6bba\u8005\u306f\u9837\u304d\u3001\u4e8c\u4eba\u304c\u96c6\u56e3\u304b\u3089\u629c\u3051\u51fa\u3066\u304f\u308b\u65b9\u5411\u306b\u5408\u56f3\u3057\u305f\u3002"}
{"translation": "\u9aa8\u592a\u3067\u77ed\u9aea\u306e\u4e8c\u4eba\u5171\u68cd\u68d2\u3092\u6301\u3063\u3066\u304a\u308a\u3001\u305d\u306e\u68cd\u68d2\u306f\u8089\u5c4b\u5834\u3067\u52d5\u7269\u3092\u6bb4\u308b\u9053\u5177\u3068\u540c\u3058\u3082\u306e\u3060\u3063\u305f\u3002"}
{"translation": "\u300c\u8ab0\u3060\u3068\u5224\u65ad\u3057\u3066\u3044\u308b\u306e\u304b\uff1f\u300d"}
{"translation": "\u30cb\u30ad\u30d3\u3060\u3089\u3051\u306e\u7537\u306f\u3001\u8155\u3092\u304f\u3055\u3044\u304b\u3089\u51fa\u3055\u305a\u306b\u3001\u6211\u3005\u304c\u4f55\u304c\u826f\u304f\u3066\u4f55\u304c\u60aa\u3044\u306e\u304b\u3092\u6c7a\u3081\u308b\u8cc7\u683c\u304c\u3042\u308b\u3093\u3060\u3068\u554f\u3044\u8a70\u3081\u305f\u3002"}
{"translation": "\u300c\u3042\u306a\u305f\u306b\u306f\u95a2\u4fc2\u306a\u3044\u308f\u3088\u3001\u30c0\u30fc\u30ea\u30f3\u3002"}
{"translation": "\u6b66\u5668\u306f\u6301\u3063\u3066\u307e\u3059\u304b\uff1f\u300d\u898b\u77e5\u3089\u306c\u4eba\u7269\u306f\u66f4\u306b\u76ae\u8089\u3063\u305f\u7b11\u307f\u3092\u6d6e\u304b\u3079\u3001\u300c\u6301\u3063\u3066\u307e\u305b\u3093\u300d\u3068\u7b54\u3048\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u305d\u308c\u306f\u826f\u304f\u306a\u3044\u300d"}
{"translation": "\u30cb\u30ad\u30d3\u3060\u3089\u3051\u306e\u7537\u306f\u3001\u9577\u5927\u306a\u30ca\u30a4\u30d5\u3068\u5171\u306b\u8155\u3092\u3086\u3063\u304f\u308a\u5f15\u304d\u51fa\u3057\u305f\u3002"}
{"translation": "\u300c\u6b66\u5668\u3092\u6301\u3063\u3066\u306a\u3044\u3053\u3068\u306f\u975e\u5e38\u306b\u60aa\u3044\u3053\u3068\u3067\u3059\u3088\u3002"}
{"translation": "\u300d\"\u8089\u5c4b\"\u3082\u30b3\u30eb\u30c7\u30e9\u30b9\u306e\u3088\u3046\u306a\u9577\u5927\u30ca\u30a4\u30d5\u3092\u53d6\u308a\u51fa\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u4ed6\u4e8c\u4eba\u3082\u524d\u9032\u3057\u59cb\u3081\u3066\u68d2\u3092\u63e1\u308a\u3057\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u79c1\u3082\u3057\u304b\u3057\u3066\u3000\u30fc \u6301\u3064\u5fc5\u8981\u3042\u308a\u307e\u305b\u3093\u300d\u3068\u898b\u77e5\u3089\u306c\u7537\u6027\u8a00\u3063\u305f\u5f7c\u304c\u52d5\u3058\u3059\u3046\u4e8b\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f,\u300c\u50d5\u306e\u6b66\u5668\u3002"}
{"translation": "setHeadered \u79c1\u611f \u30d5\u30a9\u30ed\u30ef\u30fc\u611b\u3059\u76bf\u3067\u3059\uff40"}
{"translation": "\u5ec3\u589f\u304b\u3089\u3001\u67d4\u3089\u304b\u304f\u3066\u78ba\u304b\u306a\u30b9\u30c6\u30c3\u30d7\u3067\u3001\u4e8c\u4eba\u306e\u82e5\u3044\u5973\u6027\u304c\u51fa\u3066\u304d\u305f\u3002"}
{"translation": "\u3059\u3050\u306b\u7fa4\u8846\u304c\u5206\u304b\u308c\u3001\u5f8c\u9000\u3057\u3001\u5e0c\u8584\u306b\u306a\u3063\u305f\u3002"}
{"translation": "\u4e21\u65b9\u306e\u5973\u6027\u306f\u7b11\u9854\u3067\u5149\u308b\u6b6f\u3092\u898b\u305b\u3001\u76ee\u3092\u7d30\u3081\u3066\u3001\u5e83\u304f\u9752\u3044\u30bf\u30c8\u30a5\u30fc\u306e\u7dda\u304c\u8033\u307e\u3067\u8d70\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u529b\u5f37\u3044\u592a\u817f\u304b\u3089\u898b\u3048\u308b\u7b4b\u8089\u304c\u52d5\u304d\u3001\u904b\u3076\u30ea\u30f3\u30b9\u30ad\u30f3\u304b\u3089\u898b\u3048\u3066\u304d\u305f\u3002"}
{"translation": "\u9811\u4e08\u306a\u88f8\u306e\u4e38\u307f\u3092\u5e2f\u3073\u305f\u8155\u4e0a\u90e8\u306f\u96fb\u6c17\u30cd\u30c3\u30c8\u306e\u624b\u888b\u3088\u308a\u3082\u9ad8\u304f\u63fa\u308c\u308b\u3088\u3046\u306b\u898b\u3048\u307e\u3057\u305f\u3002"}
{"translation": "\u9396\u5e37\u5b50\u3067\u3082\u8986\u308f\u308c\u3066\u3044\u308b\u80a9\u304b\u3089\u306f\u30b5\u30fc\u30d9\u30eb\u306e\u67c4\u304c\u7a81\u304d\u51fa\u3057\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u306b\u304d\u3073\u9854\u306f\u3086\u3063\u304f\u308a\u3068\u819d\u3092\u66f2\u3052\u3001\u5730\u9762\u306b\u30ca\u30a4\u30d5\u3092\u843d\u3068\u3057\u305f\u3002"}
{"translation": "\u74e6\u792b\u306e\u7a74\u304b\u3089\u306f\u77f3\u304c\u8ee2\u3052\u308b\u97f3\u3001\u3056\u308f\u3064\u304d\u304c\u97ff\u304d\u3001\u305d\u306e\u5f8c\u3067\u95c7\u304b\u3089\u624b\u304c\u58c1\u306e\u6b20\u3051\u305f\u90e8\u5206\u306b\u3057\u304c\u307f\u3064\u3044\u3066\u73fe\u308c\u305f\u3002"}
{"translation": "\u624b\u306e\u5f8c\u306b\u306f\u767d\u304f\u3001\u30ec\u30f3\u30ac\u7c89\u3067\u8986\u308f\u308c\u305f\u6bdb\u9aea\u306e\u982d\u90e8\u304c\u9806\u756a\u306b\u73fe\u308c\u3001\u6b21\u3044\u3067\u9752\u3056\u3081\u305f\u9854\u3068\u80a9\u8d8a\u3057\u306b\u7a81\u304d\u51fa\u308b\u5263\u67c4\u304c\u898b\u3048\u3066\u6765\u305f\u3002"}
{"translation": "\u7fa4\u8846\u306f\u3056\u308f\u3081\u3044\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u3001\u732b\u80cc\u306b\u306a\u3063\u305f\u7537\u304c\u7a74\u304b\u3089\u5947\u5999\u306a\u5f62\u3001\u602a\u5947\u306a\u8089\u4f53\u3092\u5f15\u304d\u305a\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u8840\u3067\u67d3\u307f\u8fbc\u3093\u3060\u7c89\u5875\u3067\u80a5\u5927\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u305d\u306e\u4f3c\u975e\u52d5\u7269\u3092\u9577\u304f\u3001\u8725\u8734\u306e\u3088\u3046\u306a\u5c3e\u3067\u3064\u304b\u307f\u3001\u4f55\u3082\u8a00\u308f\u305a\u306b\u592a\u3063\u305f\u753a\u9577\u306e\u8db3\u5143\u306b\u6295\u3052\u4e0b\u3057\u305f\u3002"}
{"translation": "\u753a\u9577\u306f\u98db\u3073\u9000\u304d\u3001\u5012\u308c\u3066\u3044\u308b\u58c1\u306e\u7834\u7247\u306b\u3064\u307e\u305a\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u6e7e\u66f2\u3057\u305f\u9ce5\u306e\u5634\u3068\u819c\u8cea\u306e\u7ffc\u3068\u9c57\u3067\u8986\u308f\u308c\u305f\u8db3\u5148\u306b\u3042\u308b\u938c\u5f62\u722a\u3092\u898b\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u304b\u3064\u3066\u771f\u7d05\u3060\u3063\u305f\u304c\u73fe\u5728\u3067\u306f\u6c5a\u3089\u3057\u3044\u8336\u8272\u3068\u5316\u3057\u3066\u3044\u308b\u88c2\u3051\u76ee\u8d77\u3053\u3063\u305f\u5589\u4ecf\u304c\u81a8\u3089\u3093\u3067\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u900f\u660e\u3067\u7a81\u51fa\u3059\u308b\u773c\u7403\u3082\u3042\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u3053\u308c\u304c\u30d0\u30b8\u30ea\u30b9\u30af\u3060\u300d\u3068\u767d\u9aea\u306e\u7537\u304c\u8a00\u3044\u3001\u30ba\u30dc\u30f3\u304b\u3089\u307b\u3053\u308a\u3092\u6255\u3063\u305f\u3002"}
{"translation": "\u300c\u5951\u7d04\u901a\u308a\u3060\u3002"}
{"translation": "\u79c1\u306e200\u30ea\u30f3\u30bf\u30eb\u3001\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3057\u307e\u3059\u3002"}
{"translation": "\u3061\u3083\u3093\u3068\u3057\u305f\u30ea\u30f3\u30bf\u30eb\u3060\u3088\u3001\u3042\u307e\u308a\u4f7f\u308f\u308c\u3066\u306a\u3044\u3082\u306e\u3002"}
{"translation": "\u78ba\u8a8d\u3059\u308b\u304b\u3089\u3001\u305d\u306e\u3064\u3082\u308a\u3067\u306a\u3002"}
{"translation": "\u982d\u76ee\u306f\u9707\u3048\u308b\u624b\u3067\u8ca1\u5e03\u3092\u53d6\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u306f\u5468\u56f2\u3092\u898b\u56de\u3057\u3001\u4e00\u77ac\u3001\u5f7c\u306e\u8db3\u5143\u306b\u843d\u3061\u3066\u3044\u308b\u30ca\u30a4\u30d5\u306b\u8996\u7dda\u3092\u6b62\u3081\u305f\u3002"}
{"translation": "\u8336\u8272\u306e\u30c1\u30e5\u30cb\u30c3\u30af\u306b\u8eab\u3092\u5305\u3080\u7537\u3084\u30e9\u30a4\u30c1\u30e7\u30a6\u76ae\u3092\u7740\u305f\u5973\u6027\u305f\u3061\u306b\u76ee\u3092\u5411\u3051\u305f\u3002"}
{"translation": "\u300c\u3044\u3064\u3082\u306e\u3088\u3046\u306b\u300d\u5f7c\u306f\u8a00\u3063\u305f\u3001\u753a\u9577\u306e\u9707\u3048\u308b\u624b\u304b\u3089\u677e\u660e\u3092\u53d6\u308a\u51fa\u3057\u3066\u3002"}
{"translation": "\u50d5\u3089\u306f\u308f\u305a\u304b\u306a\u5831\u916c\u3067\u547d\u3092\u8ced\u3057\u3066\u3044\u308b\u304c\u3001\u3042\u306a\u305f\u305f\u3061\u306f\u4e00\u65b9\u3067\u50d5\u3089\u306e\u7269\u306b\u624b\u3092\u51fa\u305d\u3046\u3068\u3059\u308b\u3002"}
{"translation": "\u8cb4\u65b9\u305f\u3061\u304c\u5909\u308f\u308b\u3053\u3068\u306f\u6c7a\u3057\u3066\u306a\u3044\u3060\u308d\u3046\u3001\u305d\u306e\u75ab\u75c5\u6301\u3061\u5171\u3068\u540c\u69d8\u306b\u3002"}
{"translation": "\u624b\u3064\u304b\u305a\u3060\u3088\u3068\u8089\u5c4b\u304c\u56c1\u304d\u306a\u304c\u3089\u5f8c\u9000\u3057\u305f\u3002"}
{"translation": "\u68cd\u68d2\u3092\u6301\u3064\u9023\u4e2d\u306f\u3059\u3067\u306b\u4eba\u3005\u306e\u9593\u306b\u6eb6\u3051\u8fbc\u3093\u3067\u3057\u307e\u3063\u3066\u4e45\u3057\u3044\u3002"}
{"translation": "\u300c\u541b\u305f\u3061\u306e\u7269\u306f\u624b\u4ed8\u304b\u305a\u3067\u3059\u3088\u3001\u65e6\u90a3\u300d\u3068\u767d\u9aea\u306e\u7537\u304c\u5fae\u7b11\u3093\u3060\u3002"}
{"translation": "\u305d\u306e\u5fae\u7b11\u307f\u3092\u898b\u3066\u3001\u9752\u767d\u304f\u9854\u8272\u5510\u7a81\u7684\u306b\u50b7\u53e3\u304b\u3089\u958b\u82b1\u3059\u308b\u3088\u3046\u306a\u7b11\u9854\u3067\u7fa4\u8846\u8868\u793a\u59cb\u3081\u901f\u3084\u304b\u306b\u6563\u308a\u53bb\u3063\u3066\u884c\u3063\u305f\u3002"}
{"translation": "\u300c\u305d\u308c\u3086\u3048\u5144\u5f1f\u3055\u3093\u3001\u3042\u306a\u305f\u3082\u89e6\u308c\u3089\u308c\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u5e73\u7a4f\u88e1\u53bb\u308a\u307e\u3059\u3088\u3046\u3059\u3002\u3057\u304b\u3057\u65e9\u304f\u7acb\u3061\u53bb\u3063\u3066\u304f\u3060\u3055\u3044\u300d"}
