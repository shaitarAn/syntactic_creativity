{"translation": "\u79c1\u306e\u982c\u306e\u4e0b\u306b\u3042\u308b\u3053\u306e\u4e00\u518a\u306f\u3001\u604b\u611b\u5c0f\u8aac\u3067\u3059\uff1a\u305d\u308c\u306f\u65e2\u5a5a\u8005\u306e\u7537\u6027\u304c\u4e00\u4eba\u306e\u5973\u6027\u306b\u51fa\u4f1a\u3046\u3068\u3044\u3046\u7269\u8a9e\u3067\u3001\u5f7c\u5973\u3082\u307e\u305f\u604b\u4eba\u304c\u3044\u308b\u3068\u3044\u3046\u3002"}
{"translation": "\u4e03\u30da\u30fc\u30b8\u3092\u8aad\u3093\u3060\u3060\u3051\u3067\u3001\u3082\u3046\u79c1\u306f\u7269\u8a9e\u3092\u5fc3\u304b\u3089\u7406\u89e3\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u4f55\u3082\u79c1\u3092\u9a5a\u304b\u305b\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u6708\u65e5\u304c\u7d4c\u3064\u306b\u3064\u308c\u3066\u3001\u79c1\u306f\u65b0\u3057\u3044\u3053\u3068\u3092\u8aad\u3080\u3053\u3068\u3088\u308a\u3082\u518d\u8aad\u3059\u308b\u3053\u3068\u304c\u5897\u3048\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u65b0\u520a\u300d\u3001\u300c\u5b63\u7bc0\u300d\u3001\u300c\u6587\u5b66\u306e\u79cb\u300d\u3001\u300c\u30d2\u30c3\u30c8\u4f5c\u300d\u3001\u300c\u4e0d\u4f5c\u300d\u3068\u79f0\u3055\u308c\u308b\u7d20\u6750\u3067\u540c\u3058\u53e4\u3073\u305f\u30b9\u30fc\u30d7\u3092\u4f5c\u308a\u51fa\u3059\u3002"}
{"translation": "\u305d\u308c\u3089\u306f\u30ea\u30b5\u30a4\u30af\u30eb\u3055\u308c\u308b\u7d19\u5207\u308c\u306b\u904e\u304e\u306a\u3044\u3002"}
{"translation": "\u300c\u65b0\u3057\u3044\u672c\u300d\u3068\u3057\u3066\u671d\u306b\u5bb6\u3092\u51fa\u3066\u591c\u5e30\u3063\u3066\u304f\u308b\u30c8\u30e9\u30c3\u30af\u5c71\u7a4d\u307f\u306e\u5c0f\u8aac\u305f\u3061\u306f\u3059\u3067\u306b\u6642\u4ee3\u9045\u308c\u3067\u3059\u3002"}
{"translation": "\u4f55\u5e74\u3082\u524d\u304b\u3089\u3001\u65b0\u3057\u3044\u5091\u4f5c\u3092\u767a\u898b\u3059\u308b\u3068\u3044\u3046\u559c\u3073\u306b\u98db\u3073\u8df3\u306d\u308b\u3053\u3068\u306f\u3084\u3081\u3066\u3001\u6708\u66dc\u65e5\u306b\u65b0\u305f\u306a\u4eba\u9593\u3068\u3057\u3066\u30aa\u30d5\u30a3\u30b9\u306b\u623b\u308b\u306e\u3060\u308d\u3046\u304b\uff1f"}
{"translation": "\u4e8c\u5341\u5e74\uff1f\u4e09\u5341\u5e74\uff1f\u79c1\u306f\u305d\u306e\u3088\u3046\u306a\u6b7b\u3092\u4e88\u611f\u3055\u305b\u308b\u8a08\u7b97\u3092\u3059\u308b\u306e\u304c\u597d\u304d\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u76ee\u3092\u9589\u3058\u308c\u3070\u3001\u77bc\u8d8a\u3057\u306b\u5747\u4e00\u306a\u9ec4\u8272\u3044\u30da\u30eb\u30bc\u30eb\u306e\u30e9\u30f3\u30d7\u306e\u5149\u304c\u898b\u3048\u3001\u305d\u3057\u3066\u9ed2\u3044\u5f62\u304c\u305d\u308c\u3092\u4fb5\u98df\u3057\u307e\u3059\u3002"}
{"translation": "\u52d5\u304f\u5ec3\u589f\u3092\u7bc9\u304d\u3042\u3052\u305f\u308a\u3001\u30d3\u30af\u30c8\u30fc\u30eb\u30fb\u30e6\u30fc\u30b4\u30fc\u306e\u30c7\u30b6\u30a4\u30f3\u3067\u8986\u3063\u305f\u308a\u3057\u307e\u3059\u3002"}
{"translation": "\u606f\u304c\u9045\u304f\u306a\u308a\u3001\u5fc3\u81d3\u3082\u5c11\u3057\u843d\u3061\u7740\u304d\u307e\u3059\u3002"}
{"translation": "\u7720\u3063\u3066\u3057\u307e\u3063\u3066\u3082\u3044\u3044\u3067\u3059\u3057\u3001\u6b7b\u3093\u3067\u3082\u69cb\u308f\u306a\u3044\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u6587\u5b57\u901a\u308a\u300c\u672c\u8aad\u307f\u300d\u3067\u901d\u304f\u308f\u3051\u3067\u3059\u304b\u3089\u3002"}
{"translation": "\u300c\u5f7c\u306f\u751f\u6daf\u8aad\u66f8\u5bb6\u3067\u3042\u308a\u7d9a\u3051\u3001\u8aad\u307f\u7269\u3068\u5171\u306b\u6b7b\u3093\u3060\u300d\u3068\u8a00\u308f\u308c\u308b\u3067\u3057\u3087\u3046\u304c\u3001\u5b9f\u969b\u306b\u306f\u4f55\u3082\u5922\u60f3\u3057\u3066\u304a\u3089\u305a\u305f\u3060\u901d\u3063\u3066\u3057\u307e\u3063\u305f\u3060\u3051\u304b\u3082\u77e5\u308c\u307e\u305b\u3093\u3002"}
{"translation": "\u305d\u3057\u3066\u9577\u3044\u9593\u5b9f\u8cea\u7684\u306a\u8aad\u66f8\u304b\u3089\u624b\u3092\u5f15\u3044\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u300c\u547c\u3093\u3060\u5185\u5bb9\u300d\u307e\u305f\u306f\u300c\u7406\u89e3\u3057\u305f\u5185\u5bb9\u300d\u7b49\u540d\u524d\u3064\u3051\u3089\u308c\u305f\u3053\u3068\u67c4\u7a76\u6975\u7684\u306b\u8aad\u3080\u3068\u306f\u3069\u3046\u3044\u3046\u4e8b\u304b\u3001\u3069\u3046\u3084\u3063\u3066\u305d\u308c\u3092\u5b9f\u8df5\u3059\u308c\u3070\u3088\u3044\u304b\u3001\u6216\u3044\u306f\u81ea\u5206\u306b\u305d\u306e\u80fd\u529b\u304c\u3042\u308b\u306e\u304b\uff1f\u982d\u3092\u6a2a\u306b\u5411\u3051\u308b\u3068\u5fc3\u81d3\u304c\u3082\u3063\u3068\u30c9\u30ad\u30f3\u30c9\u30ad\u30f3\u3057\u3001\u6728\u6750\u304c\u9707\u3048\u307e\u3059\u3002"}
{"translation": "\u5bb6\u5168\u4f53\u304c\u53e4\u3044\u7d19\u306e\u3088\u3046\u306a\u9759\u3051\u3055\u306b\u5305\u307e\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u96ea\u306e\u3088\u3046\u306b\u3001\u672c\u306f\u97f3\u3092\u5438\u53ce\u3057\u307e\u3059\u3002"}
{"translation": "\u79c1\u306e\u4ed5\u4e8b\u306b\u306f\u72ec\u81ea\u306e\u9999\u308a\u3068\u6d88\u97f3\u52b9\u679c\u304c\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u9999\u308a\u306f\u3053\u306e\u9759\u3051\u3055\u306e\u4e2d\u3067\u3088\u308a\u826f\u304f\u611f\u3058\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}
{"translation": "\u4e16\u754c\u306e\u9a12\u97f3\u3078\u623b\u308b\u3053\u3068\u306f\u3044\u3064\u3082\u8a66\u7df4\u3067\u3059\u3002"}
{"translation": "\u8ab0\u304c\u30ce\u30c3\u30af\u3057\u3066\u3044\u308b\u306e\u3060\u308d\u3046\uff1f"}
{"translation": "\u8efd\u304f\u3066\u5c0f\u3055\u3044\u3001\u63a7\u3048\u3081\u306a\u30ce\u30c3\u30af\u97f3\u306f\u8a8d\u8b58\u3067\u304d\u306a\u3044\u3002"}
{"translation": "\u5c0f\u3055\u306a\u624b\u304b\u3002"}
{"translation": "\u5165\u3063\u3066\u304d\u3066\u3002"}
{"translation": "\u5f7c\u5973\u304c\u5165\u3063\u3066\u304f\u308b\u3002"}
{"translation": "\u79c1\u306f\u5f7c\u5973\u3092\u898b\u305f\u3053\u3068\u304c\u306a\u3044\u3002"}
{"translation": "\u3059\u3050\u306b\u61d0\u304b\u3057\u3055\u304c\u8fbc\u307f\u4e0a\u3052\u3066\u6765\u305f\u3001\u5bb6\u304c\u307e\u3060\u5c0f\u3055\u304f\u3066\u5eca\u4e0b\u3067\u5168\u3066\u306e\u5973\u306e\u5b50\u9054\u3092\u305d\u306e\u811a\u3067\u8a8d\u8b58\u3057\u3066\u3044\u305f\u6642\u4ee3\u3078\u306e\u61d0\u304b\u3057\u3055\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306f\u597d\u611f\u7684\u305d\u3046\u3060\u3063\u305f\u3002"}
{"translation": "\u9a5a\u304d\u6c17\u5473\u306e\u76ee\u3092\u898b\u308b\u3068\u3001\u79c1\u3082\u5c11\u3057\u9a5a\u304b\u305b\u308b\u3088\u3046\u306a\u9854\u3092\u3057\u3066\u3044\u305f\u306e\u3060\u308d\u3046\u304b\u3002"}
{"translation": "\u6050\u3089\u304f\u30b8\u30e3\u30b1\u30c3\u30c8\u8896\u304b\u3089\u8d64\u3044\u8de1\u304c\u81ea\u5206\u306e\u982c\u306b\u3064\u3044\u3066\u3057\u307e\u3063\u305f\u3060\u3051\u304b\u3082\u3057\u308c\u306a\u3044\u3051\u308c\u3069\u3002"}
{"translation": "\u300c\u90aa\u9b54\u3067\u3057\u3087\u3046\u304b\uff1f"}
{"translation": "\u79c1\u306f\u3042\u306a\u305f\u304c\u901a\u308a\u904e\u304e\u308b\u306e\u3092\u751f\u304d\u5ef6\u3073\u307e\u3059\u3088\u3001\u304a\u5b22\u3055\u3093\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u4f55\u8005\uff1f"}
{"translation": "\u3042\u3001\u79c1\u3001\u30a4\u30f3\u30bf\u30fc\u30f3\u306a\u3093\u3067\u3059\uff01"}
{"translation": "\u3069\u306e\u90e8\u9580\u306b\uff1f\u305d\u308c\u304c\u8a00\u308f\u308c\u3066\u307e\u305b\u3093\u3002"}
{"translation": "\u3060\u3063\u3066\u3001\u30a6\u30c1\u307f\u305f\u3044\u306a\u30a4\u30f3\u30bf\u30fc\u30f3\u307b\u3069\u8272\u3005\u3068\u50cd\u304b\u3055\u308c\u308b\u3082\u306e\u306f\u3044\u307e\u305b\u3093\u304b\u3089\u3001\u4f55\u3092\u3084\u3089\u3055\u308c\u3066\u3082\u3053\u306a\u305b\u308b\u65b9\u304c\u826f\u3044\u3067\u3059\u3088\u306d\u3002"}
{"translation": "\u6607\u7d66\u5e0c\u671b\u3067\u3059\u304b\uff1f\u3044\u3048\u3001\u79c1\u306b\u306f\u4f55\u3082\u652f\u6255\u308f\u308c\u3066\u307e\u305b\u3093\u304b\u3089\u300d"}
{"translation": "\u5f7c\u5973\u306e\u9aea\u306f\u5c11\u3057\u4e71\u308c\u3066\u3044\u308b\u3088\u3046\u306b\u898b\u3048\u3001\u30b8\u30fc\u30f3\u30ba\u306b\u306f\u7a74\u304c\u7a7a\u3044\u3066\u3044\u307e\u3059\u304c\u3001\u4ed6\u306e\u90e8\u5206\u304b\u3089\u898b\u308b\u3068\u8272\u3068\u308a\u3069\u308a\u3067\u3059\u3002"}
{"translation": "\u8eab\u9577\u306f\u4f4e\u304f\u3001\u76ee\u3064\u304d\u306f\u9ed2\u3005\u3068\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u597d\u5370\u8c61\u3092\u53d7\u3051\u307e\u3059\u304c\u3001\u5b9f\u969b\u306b\u53ef\u611b\u3089\u3057\u3044\u304b\u3069\u3046\u304b\u3092\u79c1\u304c\u8a00\u3046\u3053\u3068\u306f\u96e3\u3057\u3044\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u305d\u3046\u3044\u3046\u5973\u6027\u9054\u3092\u7406\u89e3\u3059\u308b\u80fd\u529b\u3082\u79c1\u306b\u306f\u306a\u304f\u306a\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5143\u6c17\u3067\u3059\u306d\u3002"}
{"translation": "\u30d5\u30e9\u30f3\u30b9\u9ad8\u7b49\u5e2b\u7bc4\u5b66\u6821 \u51fa\u8eab\u3067\u3057\u3087\u3046\u304b\uff1f"}
{"translation": "\u305d\u308c\u3068\u3082\u672c\u5c4b\u3055\u3093\u306e\u4ed5\u4e8b\uff1f"}
{"translation": "\u6bce\u5e741000\u518a\u307b\u3069\u3082\u306e\u672c\u3092\u4f5c\u3063\u305f\u5f8c\u3067\u7834\u68c4\u3059\u308b\u3088\u3046\u306a\u56f3\u66f8\u696d\u754c\u3067\u50cd\u3044\u3066\u3044\u307e\u3059\u304b\uff1f"}
{"translation": "\u305d\u308c\u306a\u3089\u3042\u306a\u305f\u306f\u3053\u3053\u3067\u4f55\u3092\u3057\u3066\u3044\u308b\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u79c1\u3082\u672c\u304c\u597d\u304d\u3067\u3059\uff01"}
{"translation": "\u305d\u3057\u3066\u3001\u3053\u3053\u306b\u7a7a\u304d\u304c\u3042\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u4f01\u696d\u3067\u30a4\u30f3\u30bf\u30fc\u30f3\u30b7\u30c3\u30d7\u3092\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u7fa9\u52d9\u3060\u3063\u305f\u306e\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u3067\u3001\u79c1\u306e\u30aa\u30d5\u30a3\u30b9\u3067\u4f55\u3092\u3055\u308c\u3066\u3044\u308b\u3093\u3067\u3059\u304b\uff1f"}
{"translation": "\u5931\u793c\u3058\u3083\u306a\u3051\u308c\u3070\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u30e0\u30cb\u30a8\u6c0f\u3001\u5927\u7d71\u9818\u304c\u8a00\u3063\u3066\u304f\u308c\u305f\u3068\u3002"}
{"translation": "\u5927\u7d71\u9818\uff1f\u30e0\u30cb\u30a8\u6c0f\uff1f\u5f7c\u3092\u77e5\u3089\u306a\u3044\u3093\u3067\u3059\u304b\uff1f"}
{"translation": "\u3042\u307e\u308a\u306b\u3082\u3088\u304f\u77e5\u3063\u3066\u3044\u307e\u3059\u3088\u3002"}
{"translation": "\u3044\u3048\u3001\u6587\u5316\u4e8b\u696d\u306e\u7d4c\u55b6\u3067\u3059\u3002"}
{"translation": "\u672c\u5f53\u306b\uff1f\u305d\u3057\u3066\u3042\u306a\u305f\u306f\u51fa\u7248\u3092\u7ba1\u7406\u3057\u305f\u3044\u3068\u601d\u3063\u3066\u3044\u307e\u3059\u304b\uff1f\u305d\u308c\u306a\u3089\u304a\u5e78\u305b\u3092\u7948\u308a\u307e\u3059\u3002"}
{"translation": "\u79c1\u306f\u30b3\u30f3\u30b5\u30fc\u30c8\u3092\u958b\u50ac\u3059\u308b\u65b9\u304c\u597d\u304d\u3067\u3059\u3002"}
{"translation": "\u5ea7\u3063\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u79c1\u306f\u51fa\u304b\u3051\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3001\u4eca\u65e5\u306f\u91d1\u66dc\u65e5\u3067\u3059\u304b\u3089\u3002"}
{"translation": "\u9045\u304f\u306a\u308a\u307e\u3057\u305f\u306d\u3002"}
{"translation": "\uff15\u5206\u3060\u3051\u3067\u69cb\u3044\u307e\u305b\u3093\u3088\u3002"}
{"translation": "\u3042\u306a\u305f\u304c\u30b3\u30f3\u30b5\u30fc\u30c8\u3092\u624b\u639b\u3051\u305f\u3044\u3068\u3044\u3046\u306e\u3067\u3059\u306d\uff1f"}
{"translation": "\u3046\u3093\u3001\u305d\u308c\u306f\u826f\u3044\u8003\u3048\u3060\u3001\u97f3\u697d\u306f\u7d20\u6674\u3089\u3057\u3044\u3082\u306e\u3060\u304b\u3089\u306d\u3002"}
{"translation": "\u9577\u3044\u9593\u3001\u79c1\u306f\u5c11\u3057\u30ea\u30e9\u30c3\u30af\u30b9\u3057\u3001\u6c17\u6301\u3061\u3092\u9ad8\u3081\u3001\u8133\u306b\u3082\u3046\u5c11\u3057\u8840\u3092\u9001\u308b\u305f\u3081\u306b\u3053\u306e\u4e0a\u3067\u8db3\u3092\u7d44\u3093\u3067\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u4eca\u3067\u306f\u3001\u982d\u3092\u7f6e\u304f\u3053\u3068\u304c\u307e\u3059\u307e\u3059\u983b\u7e41\u306b\u306a\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u7279\u306b\u591c\u306f\u305d\u3046\u3067\u3059\u3001\u7279\u306b\u91d1\u66dc\u65e5\u306e\u591c\u3067\u3059\u3002"}
{"translation": "\u539f\u7a3f\u304c\u958b\u304b\u308c\u3066\u3044\u308b\u30a2\u30fc\u30e0\u30ec\u30b9\u30c8\u306b\u624b\u3092\u7d44\u3093\u3067\u984d\u3068\u524d\u8155\u3092\u7f6e\u304d\u307e\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u9bae\u3084\u304b\u306a\u30c6\u30af\u30b9\u30c8\u306e\u4e0a\u3067\u306f\u982c\u3082\u307e\u305f\u5b89\u606f\u3057\u307e\u3059\u3002"}
{"translation": "\u30c7\u30b9\u30af\u306e\u6728\u6750\u306f\u79c1\u306e\u5fc3\u62cd\u6570\u5897\u5927\u3055\u305b\u307e\u3059\u3002"}
{"translation": "\u53e4\u3073\u305f\u30a2\u30fc\u30eb\u30c7\u30b3\u69d8\u5f0f\u306e\u5bb6\u5177\u306f\u611f\u60c5\u3084\u75b2\u52b4\u611f\u30b8\u30e7\u30a4\u30f3\u30c8\u3059\u308b\u9053\u5177\u3068\u3057\u3066\u826f\u597d\u306a\u50cd\u304d\u3060\u308f\u3057\u307e\u3059 \u3002"}
{"translation": "\u30eb\u30fc\u30eb\u30de\u30f3\uff1f\u30ec\u30eb\u30fc\uff1f\u5f7c\u306f\u305f\u304f\u3055\u3093\u306e\u3053\u3068\u76ee\u6483\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u79c1\u304c\u9759\u5bc2\u3057\u305f\u5bb6\u5ead\u751f\u6d3b\u4e2d\u3088\u308a\u81ea\u8eab\u8001\u5316\u9032\u884c\u3059\u308b\u3068\u3046\u308d\u3064\u304f\u5fc3\u97f3\u63a2\u7d22\u8074\u3044\u3066\u3086\u3063\u304f\u308a\u81e8\u3080\u3067\u3059\u3088 \u529b\u5f37\u3055\u6b8b\u3063\u3066\u3044\u307e\u305b\u3093\u3057\u304b\u3057\u7686\u7acb\u3061\u53bb\u3063\u3066\u884c\u304d\u307e\u3059"}
{"translation": "\u4e00\u4eba\u53f0\u5730\u3078\u5370\u5237\u66f8\u7c4d \u898b\u8fbc\u307f\u4f11\u6687\u671f\u9593\u53d6\u5f97\u5e0c\u671b\u3059\u308b\u305f\u3081\u52a0\u5de5\u9020\u4f5c\u3042\u308b\u5834\u6240\u5468\u77e5\u53ce\u675f\u57df \u597d\u4f8b\uff1a\u6bce\u9031\u91d1\u66dc\u65e5\u671f\u5f85\u3055\u308c\u3066\u3044\u307e\u3059"}
{"translation": "\u305d\u308c\u306a\u3089\u3054\u5b58\u3058\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u5f7c\u304c\u3053\u308c\u3092\u304a\u5c4a\u3051\u3059\u308b\u3088\u3046\u306b\u8a00\u3063\u305f\u3093\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u3067\u3053\u308c\u3063\u3066\u4f55\u3067\u3059\u304b\uff1f"}
{"translation": "\u3048\u30fc\u3068\u3001\u96fb\u5b50\u66f8\u7c4d\u30ea\u30fc\u30c0\u30fc\u304b\u3001\u96fb\u5b50\u30d6\u30c3\u30af\u304b\u3001iPad \u304b\u308f\u304b\u3089\u306a\u3044\u3093\u3067\u3059\u3088\u3002"}
{"translation": "\u3042\u306a\u305f\u306e\u5168\u3066\u306e\u30de\u30cb\u30e5\u30b9\u30af\u30ea\u30d7\u30c8\u3092\u9031\u672b\u7528\u306b\u5168\u90e8\u5165\u308c\u3066\u304f\u308c\u305f\u3063\u3066\u8a00\u3063\u3066\u307e\u3057\u305f\u3057\u3001\u305d\u308c\u306a\u3089\u5c11\u3057\u3060\u3051\u8377\u7269\u304c\u8efd\u304f\u306a\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u306d\u3002"}
{"translation": "\u8aac\u660e\u306f\u5fc5\u8981\u3067\u3059\u304b\uff1f"}
{"translation": "\u898b\u3066\u304f\u3060\u3055\u3044\u3001\u3053\u308c\u306f\u3042\u306a\u305f\u306e\u30de\u30cb\u30e5\u30b9\u30af\u30ea\u30d7\u30c8\u304c\u5168\u3066\u8f09\u305b\u3089\u308c\u305f\u30b9\u30af\u30ea\u30fc\u30f3\u307f\u305f\u3044\u306a\u3082\u306e\u3067\u3059\u3088\u3002"}
{"translation": "\u3053\u3053\u30d0\u30fc\u30c1\u30e3\u30eb\u68da\u306b\u672c\u7269\u305d\u3063\u304f\u308a\u306e\u6728\u88fd\u98a8\u30a8\u30c6\u30fc\u30b8\u30a7\u30a2\u4e0a\u306b\u7f6e\u3044\u3066\u3042\u308a\u307e\u3059\u304b\u3089\u306d\u3002"}
{"translation": "\u89e6\u308b\u3068\u958b\u304d\u307e\u3059\u3088\u3002"}
{"translation": "\u5c71\u307b\u3069\u3042\u308a\u307e\u3059\u3088\uff01"}
{"translation": "\u4e8c\u65e5\u9593\u3067\u5168\u3066\u8aad\u3080\u3053\u3068\u306f\u7d76\u5bfe\u7121\u7406\u3060\u3068\u601d\u3044\u307e\u3059\u3051\u3069\uff01"}
{"translation": "\u898b\u3066\u304f\u3060\u3055\u3044\u3001\u6587\u7ae0\u90e8\u5206\u304c\u958b\u304d\u307e\u3059\u304b\u3089\u306d"}
