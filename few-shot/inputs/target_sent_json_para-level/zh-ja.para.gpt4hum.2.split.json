{"translation": "\u305a\u3063\u3068\u305a\u3063\u3068\u5f8c\u306e\u3042\u308b\u65e5\u3001\u5f7c\u5973\u306e\u592b\u304c\u75c5\u9662\u304b\u3089\u5e30\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u5f7c\u306f\u771f\u5263\u306a\u8868\u60c5\u3067\u300c\u6587\u5316\u5927\u9769\u547d\u300d\u304c\u59cb\u307e\u308a\u3001\u75c5\u9662\u3067\u306f\u6bce\u65e5\u4f1a\u8b70\u304c\u958b\u304b\u308c\u3001\u5f7c\u306b\u5bfe\u3059\u308b\u30d3\u30c3\u30b0\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u30ba\u30dd\u30b9\u30bf\u30fc\u3082\u66f8\u304b\u308c\u3066\u304a\u308a\u3001\u5f7c\u306e\u6b74\u53f2\u306b\u554f\u984c\u304c\u3042\u308b\u3068\u8a00\u308f\u308c\u3066\u3044\u308b\u3068\u8a71\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u975e\u5e38\u306b\u7dca\u5f35\u3057\u3001\u592b\u304c\u3053\u308c\u3089\u3092\u8a9e\u3063\u3066\u3044\u308b\u3053\u3068\u304c\u4f55\u3092\u610f\u5473\u3059\u308b\u306e\u304b\u5206\u304b\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u7a81\u7136\u3001\u592b\u306f\u3001\u300c\u541b\u306b\u306f\u4f55\u3082\u554f\u984c\u306f\u306a\u3044\u3088\u3002"}
{"translation": "\u50d5\u304c\u541b\u3092\u5b88\u308b\u304b\u3089\u306d\u3002"}
{"translation": "\u904e\u53bb\u306e\u3053\u3068\u306a\u3093\u3066\u4e00\u751f\u601d\u3044\u51fa\u3055\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u5927\u6575\u306f\u5916\u90e8\u304b\u3089\u304f\u308b\u8005\u3067\u306f\u7121\u304f\u3001\u6050\u3089\u304f\u5fd8\u308c\u53bb\u3089\u308c\u305f\u4e8b\u67c4\u3060\u308d\u3046\u300d\u3068\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u8ab0\u304b\u304c\u805e\u3044\u3066\u304d\u305f\u3089\u3001\u300c\u4f55\u3082\u77e5\u3089\u305a\u300d\u3060\u3068\u7b54\u3048\u3066\u307f\u308b\u3093\u3060\u3002"}
{"translation": "\u305d\u308c\u3060\u3051\u3067\u5341\u5206\u3060\u3088\u300d\u3068\u4ed8\u3051\u52a0\u3048\u307e\u3057\u305f\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u3069\u3053\u304b\u3089\u304d\u305f\u306e\u3067\u3059\u304b\uff1f \u3069\u306e\u6751\u306b\u4f4f\u3093\u3067\u3044\u307e\u3059\u304b\uff1f \u3042\u306a\u305f\u306f\u4f55\u6b73\u3067\u3059\u304b\uff1f \u5bb6\u65cf\u306b\u306f\u8ab0\u304c\u3044\u307e\u3059\u304b\uff1f \u3069\u3046\u3084\u3063\u3066\u5ddd\u306b\u843d\u3061\u8fbc\u3093\u3060\u306e\u3067\u3059\u304b\uff1f \u8239\u304c\u8ee2\u8986\u3057\u305f\u306e\u3067\u3059\u304b\u3001\u305d\u308c\u3068\u3082\u60aa\u8005\u304c\u3042\u306a\u305f\u3092\u6295\u3052\u5165\u308c\u305f\u306e\u3067\u3059\u304b\uff1f \u6c34\u96e3\u4e8b\u6545\u306b\u906d\u3063\u305f\u306e\u306f\u3042\u306a\u305f\u3060\u3051\u3067\u3059\u304b\u3002"}
{"translation": "\u4eba\u3005\u306f\u6b21\u3005\u3068\u8cea\u554f\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u58f0\u97f3\u304c\u512a\u3057\u304f\u3066\u3082\u3001\u305d\u308c\u305e\u308c\u304c\u523a\u3059\u3088\u3046\u306a\u75db\u307f\u3092\u4f34\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u5fc3\u81d3\u306f\u7a81\u5982\u3068\u3057\u3066\u305b\u308a\u4e0a\u304c\u308b\u75db\u307f\u306b\u8972\u308f\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u30d9\u30c3\u30c9\u3067\u8eab\u3092\u4e38\u3081\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u305d\u3046\u3060\u306d\u3001\u79c1\u306f\u4e00\u4f53\u3069\u3053\u304b\u3089\u6765\u305f\u3093\u3060\u308d\u3046\u30fb\u30fb\u30fb"}
{"translation": "\u79c1\u304c\u4f4f\u3080\u5834\u6240\u3063\u3066\u4f55\u51e6\uff1f\u300d"}
{"translation": "\u79c1\u81ea\u8eab\u4f55\u3068\u3044\u3046\u540d\u524d\u3060\u3063\u3051\uff1f\u300d"}
{"translation": "\u300c\u3069\u3046\u3057\u3066\u5ddd\u306b\u843d\u3061\u8fbc\u3093\u3060\u3093\u3060\u308d\u3046\uff1f\u300d \u5168\u304f\u601d\u3044\u51fa\u305b\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "\u300c \u4e00\u4f53\u3069\u3046\u3057\u3066\u8a18\u61b6\u51fa\u6765\u306a\u3044\u3093\u3060\u308d\u3046\u30fb\u30fb\u30fb"}
{"translation": "\u81ea\u5206\u81ea\u8eab\u3055\u3048\u3082\u5fd8\u308c\u308b\u3088\u3046\u306a\u4e8b\u3063\u3066\u6709\u308b\u306e\uff1f\u300d"}
{"translation": "\u305d\u3053\u3067\u5f7c\u5973\u306f\u6ce3\u304d\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u601d\u3044\u51fa\u305b\u307e\u305b\u3093\u2026\u300d \u3082\u8a00\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u672c\u5f53\u306b\u4f55\u3082\u899a\u3048\u3066\u3044\u306a\u3044\u3002"}
{"translation": "\u3060\u304b\u3089\u4eba\u3005\u306f\u8a00\u3063\u305f\u3001\u300c\u601d\u3044\u51fa\u3057\u3066\u307f\u3066\u3001\u3057\u3063\u304b\u308a\u3068\u601d\u3044\u51fa\u3057\u3066\u307f\u3066\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u5ddd\u304b\u3089\u52a9\u3051\u51fa\u3055\u308c\u305f\u3093\u3060\u3088\u3002"}
{"translation": "\u5ddd\u306e\u6c34\u304b\u3089\u8003\u3048\u59cb\u3081\u308b\u3068\u3001\u4f55\u304b\u601d\u3044\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u300d\u3002"}
{"translation": "\u5f7c\u5973\u306f\u4eba\u3005\u306e\u8981\u6c42\u306b\u5fdc\u3058\u3066\u771f\u5263\u306b\u56de\u60f3\u3092\u8a66\u307f\u305f\u304c\u3001\u305d\u306e\u8003\u3048\u304c\u5ddd\u8fba\u306b\u9054\u3059\u308b\u3068\u30b7\u30e3\u30ef\u30fc\u97f3\u304c\u96f7\u306e\u3088\u3046\u306b\u8f5f\u97f3\u3092\u7acb\u3066\u3001\u540d\u72b6\u3057\u304c\u305f\u3044\u6050\u6016\u611f\u304c\u6c34\u97f3\u3068\u5171\u306b\u62bc\u3057\u5bc4\u305b\u308b\u3002"}
{"translation": "\u6ce2\u9593\u3067\u306f\u307e\u308b\u3067\u60aa\u9b54\u304c\u96a0\u308c\u3066\u304a\u308a\u3001\u898b\u3048\u305a\u89e6\u308c\u305a\u306a\u3089\u3093\u3082\u306e\u3060\u3051\u3069\u3001\u5f7c\u5973\u306e\u5fc3\u8eab\u3092\u6fc0\u3057\u304f\u8972\u3046\u3002"}
{"translation": "\u5f7c\u5973\u306f\u7a81\u5982\u5236\u5fa1\u4e0d\u80fd\u306b\u9665\u308a\u3001\u58f0\u9ad8\u3089\u304b\u306b\u6ce3\u304d\u5d29\u308c\u59cb\u3081\u53eb\u3073\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u58f0\u639b\u3051\u795e\u7d4c\u8cea\u3067\u3059 \u5434\u6c0f\u533b\u5e2b\u4e00\u4eba\u53b3\u91cd\u3055\u307e\u3063\u3066\u597d\u5947\u5fc3\u65fa\u76db\u306a\u4eba\u3005\u3084\u98fc\u6b62\u4e86\u8a00\u3046\u300c\u5979\u53ef\u80fd\u53d7\u5230\u523a\u6fc0\uff0c\u4e0d\u8ba9\u5979\u518d\u53bb\u60f3\u4e86\uff0c\u8ba9\u5979\u517b\u75c5\u5427\u300d\u305d\u3053\u3067\u5c31\u662f\u660e\u6697\u3064\u90fd\u7528\u8bdd\u9898\u7231\u601c\u7684\u8a9e\u8abf\u8a0e\u8ad6\u7740\u5979\u3002"}
{"translation": "\u305d\u308c\u306f\u3068\u3066\u3082\u7f8e\u3057\u3044\u6625\u3067\u3057\u305f\u3002"}
{"translation": "\u3053\u306e\u5973\u6027\u306f\u305a\u3063\u3068\u81ea\u5206\u81ea\u8eab\u3068\u6226\u3044\u7d9a\u3051\u3066\u3044\u308b\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3082\u3046\u9ad8\u9f62\u3060\u3002"}
{"translation": "\u3059\u3079\u3066\u306e\u808c\u304c\u3086\u308b\u3084\u304b\u306b\u305f\u308b\u3093\u3067\u304a\u308a\u3001\u304d\u3061\u3093\u3068\u3057\u305f\u3057\u308f\u3055\u3048\u3082\u6301\u3061\u4e0a\u304c\u3089\u306a\u3044\u3002"}
{"translation": "\u5f7c\u5973\u306e\u9854\u3084\u9996\u306b\u306f\u7d30\u304b\u306a\u75d5\u8de1\u304c\u5bc6\u96c6\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u808c\u8272\u304c\u767d\u304f\u3001\u3053\u308c\u3089\u306e\u75d5\u8de1\u306f\u6642\u9593\u306e\u5200\u304c\u7121\u9020\u4f5c\u306b\u523b\u307f\u3064\u3051\u305f\u3082\u306e\u3067\u306f\u306a\u304f\u3001\u7d30\u7b46\u3067\u4e00\u7b46\u4e00\u7b46\u63cf\u304d\u51fa\u3055\u308c\u305f\u3088\u3046\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306e\u76ee\u3082\u3059\u3067\u306b\u6fc1\u3063\u3066\u3057\u307e\u3063\u3066\u3044\u308b\u304c\u3001\u7a81\u7136\u5927\u304d\u304f\u958b\u3051\u3070\u307e\u3060\u5149\u8292\u3092\u653e\u3064\u3053\u3068\u304c\u51fa\u6765\u308b\u304b\u3089\u4e0d\u601d\u8b70\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3057\u304d\u308a\u306b\u4f55\u51e6\u304b\u306b\u91d8\u4ed8\u3051\u3067\u982d\u3092\u7a7a\u3063\u307d\u306b\u3057\u3066\u5ea7\u3063\u3066\u304a\u308a\u3001\u601d\u7d22\u6df1\u305d\u3046\u3067\u3082\u3042\u308a\u9000\u5c48\u53ad\u4e16\u305d\u3046\u3067\u3082\u3042\u3063\u305f\u901a\u884c\u4eba\u3057\u304d\u308a\u306a\u597d\u5947\u5fc3\u304b\u3089\u3001\u300c\u304a\u5a46\u3055\u3093\u3001\u4f55\u8003\u3048\u3066\u3044\u307e\u3059\uff1f\u300d \u3068\u6642\u3005\u8a0a\u304b\u308c\u8bf7\u6c42\u3089\u308c\u305f\u3053\u3068\u3082\u3042\u3063\u305f\u3002"}
{"translation": "www"}
{"translation": "\u305d\u306e\u6642\u3001\u5f7c\u5973\u306f\u5446\u7136\u3068\u3057\u305f\u9854\u3092\u3057\u3066\u901a\u884c\u4eba\u3092\u898b\u3064\u3081\u3001\u8ab0\u306b\u3082\u805e\u3053\u3048\u306a\u3044\u3088\u3046\u306a\u58f0\u3067\u4f55\u304b\u3092\u3064\u3076\u3084\u304f\u3002"}
{"translation": "\u5f7c\u5973\u81ea\u8eab\u304c\u4f55\u3092\u8a00\u3063\u305f\u306e\u304b\u3001\u3055\u3048\u5206\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u5b9f\u969b\u3001\u5f7c\u5973\u81ea\u8eab\u304c\u4f55\u304b\u3092\u8003\u3048\u3066\u3044\u308b\u306e\u304b\u3069\u3046\u304b\u3055\u3048\u5206\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u305f\u3060\u611f\u3058\u308b\u3060\u3051\u3060\u3001\u5947\u5999\u306a\u7269\u304c\u5f37\u304f\u5916\u3078\u8df3\u306d\u51fa\u305d\u3046\u3068\u3059\u308b\u611f\u899a\u3001\u305d\u308c\u306f\u307e\u308b\u3067\u81ea\u5206\u306e\u8a18\u61b6\u306b\u89e6\u767a\u3055\u308c\u305f\u3082\u306e\u306e\u3088\u3046\u3060\u3002"}
{"translation": "\u305d\u3057\u3066\u305d\u308c\u3089\u306f\u6b63\u306b\u5f7c\u5973\u304c\u751f\u6daf\u307e\u3063\u305f\u304f\u63a5\u89e6\u3057\u305f\u304f\u3082\u7121\u3044\u4e8b\u67c4\u2026\u601d\u308f\u305a\u3059\u3054\u304f\u62b5\u6297\u3059\u308b\u611f\u3058\u3060\u3002\u3002"}
{"translation": "\u5f7c\u5973\u306e\u62b5\u6297\u306f\u5927\u304d\u306a\u30cd\u30c3\u30c8\u30a6\u30a3\u30fc\u30af\u540c\u7136\u3067\u3042\u308a\u3001\u4e00\u5207\u6f0f\u6d29\u305b\u306c\u72b6\u614b\u3067\u6050\u308d\u3057\u6c17\u8005\u9054\u8db3\u63bb\u304d\u56de\u3057\u3066\u552f\u4e00\u9003\u308c\u3089\u308c\u308b\u7a74\u6240\u3055\u3048\u76ee\u6307\u3059\u9a19\u308a\u30d7\u30ed\u30bb\u30b9\u3059\u3089\u898f\u5236\u3057\u7d9a\u3051\u3066\u3002\u3002"}
{"translation": "\u305d\u3093\u306a\u4eba\u751f\u5168\u4f53\u901a\u3057\u3066\u6301\u3061\u6b69\u304d\u7d76\u5bfe\u653e\u68c4\u3057\u306a\u3044\u3053\u306e\u30cd\u30c3\u30c8\u2015\u3053\u308c\u304b\u3089\u81ea\u5206\u5b58\u5728\u3084\u3063\u3066\u6765\u3066\u672c\u8cea\u7684\u9b31\u96c1\u95d8\u4e89\u6271\u308f\u308c\u65e2\u5b58\u3080\u78ba\u5b9a\u5834\u6240\u3068\u76f8\u624b\u95a2\u4fc2\u885d\u7a81\u5efa\u7acb\u5f0f\u4e0d\u502b\u5236\u7d04\u578b\u4eee\u60f3\u4e57\u308a\u8d8a\u3048\u671f\u305b\u306c\u884c\u52d5\u8fc7\u7a0b\u4e2d\u8eab\u5168\u3066\u9650\u5b9a\u3055\u305b\u3089\u308c\u308b\u3002"}
{"translation": "\u65e6\u90a3\u304c\u751f\u304d\u3066\u3044\u308b\u6642\u3001\u5f7c\u5973\u304c\u4f55\u304b\u3092\u8003\u3048\u51fa\u3059\u3068\u5fc3\u304c\u5b89\u307e\u308b\u304b\u3082\u3057\u308c\u306a\u3044\u3068\u63d0\u6848\u3057\u305f\u3053\u3068\u304c\u3042\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u305d\u306e\u8a00\u8449\u3092\u53d7\u3051\u5165\u308c\u3001\u771f\u5263\u306b\u5fc3\u3092\u843d\u3061\u7740\u304b\u305b\u3001\u982d\u3092\u4f7f\u3063\u3066\u601d\u8003\u3059\u308b\u3088\u3046\u52aa\u529b\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u307b\u307c\u4e00\u77ac\u3067\u3001\u4f53\u4e2d\u306e\u82db\u7acb\u3061\u306f\u7121\u6570\u306e\u91dd\u91d1\u306e\u3088\u3046\u306b\u308f\u304d\u4e0a\u304c\u308a\u3001\u5f37\u70c8\u306a\u52e2\u3044\u3067\u5f7c\u5973\u306b\u7a81\u304d\u523a\u3055\u308a\u3001\u5185\u81d3\u3059\u3079\u3066\u304c\u5f15\u304d\u88c2\u304b\u308c\u308b\u611f\u899a\u306b\u8972\u308f\u308c\u305f\u3002"}
{"translation": "\u305d\u306e\u77ac\u9593\u5f7c\u5973\u306f\u6fc0\u3057\u3044\u75b2\u52b4\u611f\u3068\u5171\u306b\u606f\u3082\u7d76\u3048\u7d76\u3048\u3060\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u7d76\u671b\u7684\u306a\u9854\u3067\u65e6\u90a3\u3055\u3093\u306b\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u79c1\u3092\u8ffd\u3044\u8a70\u3081\u306a\u3044\u3067\u3002"}
{"translation": "\u79c1\u306f\u3053\u308c\u4ee5\u4e0a\u8003\u3048\u3089\u308c\u306a\u3044\u3002"}
{"translation": "\u8003\u3048\u59cb\u3081\u308b\u3068\u81ea\u5206\u81ea\u8eab\u304c\u6b7b\u306c\u3079\u304d\u3060\u3068\u611f\u3058\u3066\u3057\u307e\u3046\u300d"}
{"translation": "\u305d\u308c\u304b\u3089\u5f7c\u5973\u306e\u592b\u306f\u9a5a\u304f\u3053\u3068\u3057\u304d\u308a\u3060\u3063\u305f\u3002"}
{"translation": "\u4e00\u77ac\u3082\u9ed9\u3063\u3066\u304b\u3089\u8a00\u3063\u3066\u304f\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u3067\u306f\u3001\u3082\u3046\u4f55\u3082\u5fd8\u6c17\u4f38\u3070\u3059\u5fc5\u8981\u3042\u308a\u307e\u305b\u3093\u3001\u3001\u81ea\u5206\u81ea\u8eab\u3067\u697d\u3057\u3080\u3053\u3068\u898b\u3064\u3051\u51fa\u3057\u3066\u304f\u3060\u3055\u3044, \u614c\u305f\u3060\u3057\u304f\u904e\u3054\u3057\u3066\u304a\u3051\u3070\u601d\u8def\u30d2\u30c3\u30c8\u3055\u3093\u3056\u3093\u6df7\u4e71\u3055\u305b\u305f\u306b\u9055\u3044\u306a\u3044\u3002\u300d"}
{"translation": "\u5f7c\u5973\u306f\u592b\u306e\u8a00\u8449\u306b\u5f93\u3063\u3066\u884c\u52d5\u3057\u3001\u6bce\u65e5\u5fd9\u3057\u304f\u904e\u3054\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u5b9f\u969b\u3001\u5f7c\u5973\u304c\u4f55\u304b\u7279\u5225\u306a\u4ed5\u4e8b\u3092\u6301\u3063\u3066\u3044\u305f\u308f\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u5f7c\u5973\u306e\u4ed5\u4e8b\u3068\u306f\u5bb6\u4e8b\u305d\u306e\u3082\u306e\u3067\u3057\u305f\u3002"}
{"translation": "\u6bce\u65e5\u3001\u6383\u9664\u3084\u6d17\u6fef\u306b\u5fd9\u3057\u304f\u904e\u3054\u3057\u3001\u5bb6\u3092\u304d\u308c\u3044\u306b\u4fdd\u3064\u3053\u3068\u3067\u4e00\u65e5\u304c\u7d42\u308f\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u5bb6\u306b\u6765\u308b\u8005\u5168\u3066\u304c\u3001\u300c\u3042\u306a\u305f\u306e\u5bb6\u306f\u672c\u5f53\u306b\u6e05\u6f54\u3067\u3059\u306d\u300d\u3068\u8a00\u3046\u3060\u308d\u3046\u3002"}
{"translation": "\u5f7c\u5973\u306e\u592b\u306f\u533b\u8005\u3067\u3001\u305d\u308c\u3092\u8a87\u308a\u306b\u601d\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u3093\u306a\u308f\u3051\u3067\u5c11\u3057\u305a\u3064\u5e73\u7a4f\u306a\u751f\u6d3b\u3092\u53d6\u308a\u623b\u3057\u3066\u884c\u3063\u305f\u5f7c\u5973,\u4f55\u5e74\u9593\u3082\u305d\u3093\u306a\u751f\u6d3b\u304c\u7d9a\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u5e74\u3005\u91cd\u306d\u308b\u6642\u9593\u5e2f\uff0c\u90fd\u5fc3\u90e8\u4e00\u679a\u305a\u3064\u7d30\u65ad\u7684\u4e25\u5b9e\u7684\u819c\u8986\u76d6\u4e86\u5979\u8a18\u61b6\u88e1\u7684\u6771\u897f\u3002"}
{"translation": "\u4e00\u5e74\u53c8\u4e00\u5e74\uff0c\u7531\u6dfa\u800c\u6e0a\uff0c\u51dd\u7d50\u6210\u677f\uff0c\u90a3\u4e9b\u6df1\u85cf\u5728\u5979\u610f\u8b58\u91cc\u7684\u9b3c\u602a\u7edf\u7edf\u88ab\u5c01\u5370\u4e86\u4e0b\u53bb\u3002"}
{"translation": "\u5f7c\u5973\u306f\u305d\u308c\u304c\u592b\u306e\u6170\u3081\u3084\u6ce8\u610f\u559a\u8d77\u3067\u3042\u308b\u3053\u3068\u3092\u7406\u89e3\u3067\u304d\u305a\u3001\u5fc3\u306e\u4e2d\u3067\u306f\u3080\u3057\u308d\u5f37\u70c8\u306a\u52d5\u63fa\u304c\u8d70\u3063\u305f\u3002"}
{"translation": "\u307e\u308b\u3067\u3001\u5f7c\u5973\u306e\u592b\u304c\u638c\u63e1\u3057\u3066\u3044\u308b\u304b\u306e\u3088\u3046\u306b\u3001\u96a0\u308c\u3066\u307b\u3068\u3093\u3069\u6d88\u3048\u53bb\u3063\u305f\u304b\u3068\u601d\u308f\u308c\u308b\u6575\u304c\u611f\u3058\u3089\u308c\u305f\u3002"}
{"translation": "\u4e00\u4f53\u4f55\u3060\u3063\u305f\u306e\u3060\u308d\u3046\uff1f"}
{"translation": "\u79c1\u304c\u77e5\u3089\u306a\u3044\u4e8b\u8c61\u3092\u5f7c\u306f\u77e5\u3063\u3066\u3044\u308b\u306e\u304b\uff1f"}
{"translation": "\u8003\u3048\u3066\u3044\u308b\u6642\u3059\u3089\u3001\u6050\u6016\u611f\u304c\u76f4\u6483\u3059\u308b\u6c17\u914d\u3092\u611f\u3058\u3066\u3057\u307e\u3063\u305f\u3002"}
{"translation": "\u305d\u306e\u6050\u6016\u306f\u5e38\u306b\u8eab\u8fd1\u306b\u3042\u3063\u305f\u3002"}
{"translation": "\u663c\u3082\u591c\u3082\u3001\u5206\u3005\u79d2\u3005\u3002"}
{"translation": "\u305d\u3053\u3067\u5f7c\u5973\u306f\u7406\u89e3\u3057\u305f\u3001\u4f55\u5e74\u3082\u524d\u304b\u3089\u3053\u306e\u7537\u6027\u306f\u611b\u3057\u3066\u3044\u305f\u3060\u3051\u3067\u306f\u306a\u304f\u6050\u308c\u3066\u3044\u3053\u306e\u4eba\u7269\u3067\u3082\u3042\u3063\u305f\u3068\u3044\u3046\u3053\u3068\u3092\u3002"}
{"translation": "\u306a\u305c\u305d\u3046\u601d\u3048\u3066\u3057\u307e\u3046\u3093\u3060\u308d\u3046\uff1f\u7279\u5225\u306a\u6c17\u6301\u3061\u304b\u3089\u751f\u3058\u308b\u8ff7\u60d1\u3055\u3084\u6df7\u4e71\u304b\u3089\u3069\u3046\u3057\u3066\u5f7c\u5973\u81ea\u8eab\u3067\u3082\u308f\u304b\u3089\u306a\u304f\u306a\u308a\u307e\u3059\u3002\u3002\u3002"}
{"translation": "\u3057\u304b\u3057\u78ba\u304b\u306b\u305d\u306e\u611f\u60c5\u306f\u5b58\u5728\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u7a93\u306e\u5916\u306e\u6843\u306e\u6728\u306f\u3001\u982d\u304b\u3089\u8db3\u5143\u307e\u3067\u30d4\u30f3\u30af\u8272\u306e\u82b1\u3067\u98fe\u3089\u308c\u3066\u3044\u308b\u3002"}
{"translation": "\u5ead\u306e\u58c1\u969b\u306b\u54b2\u3044\u3066\u3044\u308b\u674f\u306e\u82b1\u3082\u3001\u4e00\u5217\u306b\u767d\u304f\u306a\u308a\u3001\u767d\u3044\u58c1\u3068\u91cd\u306a\u3063\u3066\u3057\u307e\u3063\u305f\u70ba\u306b\u9060\u304f\u304b\u3089\u306f\u82b1\u8272\u304c\u308f\u304b\u3089\u306a\u3044\u307b\u3069\u3060\u3002"}
{"translation": "\u3055\u3089\u306b\u9060\u304f\u306b\u898b\u3048\u308b\u6570\u672c\u306e\u8001\u9280\u674f\u306f\u7dd1\u8272\u6fc3\u539a\u306a\u8449\u3092\u63fa\u3089\u3057\u3066\u304a\u308a\u3001\u592a\u976d\u305d\u3046\u306a\u5e79\u304b\u3089\u4f55\u5e74\u524d\u306b\u305d\u308c\u304c\u683d\u57f9\u3055\u308c\u305f\u304b\u63a8\u6e2c\u3059\u308b\u3053\u3068\u306f\u96e3\u3057\u3044\u3002"}
{"translation": "\u3055\u3089\u3055\u3089\u9060\u304f\u5c71\u3005\u304c\u8edf\u3089\u304b\u304f\u8d77\u4f0f\u3057\u3001\u305d\u306e\u8f2a\u90ed\u306f\u307e\u308b\u3067\u82b1\u5f01\u307f\u305f\u3044\u3060\u3002"}
{"translation": "\u7384\u95a2\u89d2\u3042\u305f\u308a\u3067\u54b2\u304d\u8a87\u3063\u3066\u8548\u840e\u305d\u3046\u306a\u8fce\u6625\u8349\uff08\u30ed\u30a6\u30d0\u30a4\uff09 \u306e\u660e\u308b\u9ec4\u8272\u304c\u6fc0\u3057\u304f\u5149\u3063\u3066\u898b\u3048\u307e\u3059\u3002"}
{"translation": "\u4e94\u3064\u8272\u9678\u3082\u9019\u5165\u601d\u5fc3\u9858\u3061\u8996\u91ce\u4e2d\u5448\u73fe\u5448\u73fe\u51fa\u660e\u4eae\u7684\u9ec4\u8272\u5374\u4f9d\u7136\u95ea\u70c1\u7740\u660e\u4eae\u3002"}
{"translation": "\u9bae\u3084\u304b\u3055\u304c\u7a81\u7136\u5f7c\u5973\u306e\u8996\u91ce\u306b\u62bc\u3057\u5bc4\u305b\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u30e1\u30e2\u30ea\u30a2\u30eb\u611f\u6c17\u4ed9\u80fd\u898b\u8b8a\u5f97\u9a55\u50b2\u81ea\u8c6a\u5373\u4f7f\u98a8\u4f9d\u820a\u5e36\u8457\u5bd2\u610f\uff0c\u4f46\u4ed6\u5011\u537b\u5728\u5bd2\u610f\u4e2d\u5805\u5b9a\u5730\u97f3\u9ad8\u5531\u6b4c\uff0c\u4e16\u754c\u5145\u6eff\u5e0c\u671b\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3053\u306e\u3088\u3046\u306a\u98a8\u666f\u3068\u97f3\u306e\u4e2d\u3067\u3001\u3086\u3063\u304f\u308a\u3068\u5b89\u9759\u306b\u306a\u3063\u3066\u3044\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u304c\u6025\u6d41\u304b\u3089\u5f15\u304d\u4e0a\u3052\u3089\u308c\u305f\u3068\u304d\u3001\u4e00\u4e1d\u3082\u7eb1\u3082\u306a\u3057\u3002"}
{"translation": "\u982d\u304b\u3089\u8db3\u5148\u307e\u3067\u3001\u5168\u8eab\u306b\u50b7\u304c\u3042\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u5ca9\u77f3\u3068\u6fc0\u3057\u3044\u6c34\u6d41\u306e\u885d\u7a81\u306e\u7d50\u679c\u3060\u3088\u3002"}
{"translation": "\u5f7c\u5973\u3092\u6551\u52a9\u3057\u305f\u4eba\u3005\u306f\u3001\u6c34\u304c\u5f7c\u5973\u3092\u771f\u3063\u767d\u306b\u892a\u305b\u3066\u3001\u9ed2\u3044\u9aea\u3060\u3051\u6b8b\u3057\u3066\u3001\u3069\u3053\u306b\u50b7\u304c\u3042\u308b\u304b\u4e00\u76ee\u3067\u306f\u308f\u304b\u3089\u306a\u304b\u3063\u305f\u3068\u8a00\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5e78\u904b\u306b\u3082\u3001\u8fd1\u304f\u306e\u6751\u3067\u8a3a\u7642\u4e2d\u3060\u3063\u305f\u6570\u540d\u306e\u8ecd\u533b\u304c\u3044\u3066\uff0c\u5f7c\u3089\u306f\u307e\u305a\u5f7c\u5973\u3092\u305d\u306e\u5834\u6240\u306b\u76f4\u63a5\u9023\u308c\u3066\u884c\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u5fdc\u6025\u51e6\u7f6e\u5f8c\uff0c\u305d\u306e\u6570\u540d\u306e\u30c9\u30af\u30bf\u30fc\u306f\u76f4\u3061\u306b\u5f7c\u5973\u3092\u75c5\u9662\u3078\u623b\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u534a\u6708\u4ee5\u4e0a\u7d4c\u3063\u3066\u304b\u3089\u3084\u3063\u3068\u76ee\u899a\u3081\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\uff0c\u4eba\u3005\u306e\u8cea\u554f\u306b\u7b54\u3048\u3088\u3046\u3068\u3057\u305f\u969b\uff0c\u5510\u7a81\u306b\u8a00\u8449\u3092\u5931\u3044\u307e\u3059\u3002"}
