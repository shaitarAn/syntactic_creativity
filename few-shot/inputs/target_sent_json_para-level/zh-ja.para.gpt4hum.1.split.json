{"translation": "\u305d\u308c\u304b\u3089\u305a\u3063\u3068\u9577\u3044\u6642\u9593\u304c\u7d4c\u3063\u305f\u3042\u308b\u65e5\u3001\u5f7c\u5973\u306e\u592b\u306f\u75c5\u9662\u304b\u3089\u5e30\u3063\u3066\u6765\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306e\u8868\u60c5\u306f\u53b3\u3057\u304f\u3001\u300c\u6587\u5316\u5927\u9769\u547d\u300d\u304c\u59cb\u307e\u3063\u305f\u3068\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u75c5\u9662\u3067\u306f\u6bce\u65e5\u4f1a\u8b70\u304c\u958b\u304b\u308c\u3001\u305d\u308c\u306b\u4eba\u3005\u306f\u5f7c\u306b\u3064\u3044\u3066\u6279\u5224\u7684\u306a\u30d3\u30e9\u3092\u66f8\u304d\u4e0a\u3052\u3001\u5f7c\u306e\u904e\u53bb\u306b\u554f\u984c\u304c\u3042\u308b\u3068\u66f8\u304d\u8fbc\u307f\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u4e0d\u5b89\u3067\u4e00\u676f\u3067\u3001\u592b\u304c\u3053\u308c\u3089\u306e\u3053\u3068\u3092\u8a9e\u3063\u3066\u3069\u3046\u3044\u3046\u610f\u5473\u306a\u306e\u304b\u7406\u89e3\u51fa\u6765\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u7a81\u7136\u592b\u306f\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u541b\u306b\u4f55\u3082\u8d77\u3053\u3089\u306a\u3044\u3060\u308d\u3046\u3088\u3001\u50d5\u304c\u5b88\u308b\u304b\u3089\u3055\u3002"}
{"translation": "\u541b\u81ea\u8eab\u306b\u3064\u3051\u8fbc\u3093\u3060\u3053\u3068\u3092\u5168\u304f\u601d\u3044\u51fa\u3055\u306a\u304f\u3066\u826f\u3044\u3002\u3002\u3002"}
{"translation": "\u4e00\u751f\u5206\u3082\u542b\u3081\u3066\u306d\u3002"}
{"translation": "\u304a\u305d\u3089\u304f\u541b\u6700\u5927\u306e\u6575\u306f\u5916\u90e8\u304b\u3089\u6765\u305f\u76f8\u624b\u3084\u4ed6\u4eba\u3067\u306f\u7121\u304f\uff0c\u898b\u3048\u3066\u3053\u306a\u3044\u904e\u53bb\u3067\u3059\u3002"}
{"translation": "\u8ab0\u304b\u4f55\u3067\u3059"}
{"translation": "\u554f\u308f\u308c\u305f\u5834\u5408, \u541b\u4f55\u3082\u77e5\u3089\u306a\u3051\u308c\u3070\u826f\u3057\uff0c\u305d\u306e\u901a\u308a\u8003\u3048\u3066\u4e0b\u3055\u3044\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u3069\u3053\u51fa\u8eab\uff1f"}
{"translation": "\u4f55\u6751\u306b\u4f4f\u3093\u3067\u308b\u306e\uff1f"}
{"translation": "\u5e74\u9f62\u306f\u3044\u304f\u3064\u304b\uff1f"}
{"translation": "\u8cb4\u65b9\u306e\u5bb6\u65cf\u306b\u306f\u4ed6\u306b\u8ab0\u304c\u3044\u308b\u304b?"}
{"translation": "\u3069\u3046\u3057\u3066\u5ddd\u306b\u843d\u3061\u305f\u306e?"}
{"translation": "\u8239\u304c\u8ee2\u8986\u3057\u305f\u304b\u3089\u304b\u3001\u60aa\u4eba\u9054\u304c\u8cb4\u65b9\u3092\u6295\u3052\u8fbc\u3093\u3060\u304b\u3089\u304b\uff1f"}
{"translation": "\u4f5c\u6226\u3067\u306f\u8cb4\u65b9\u4e00\u4eba\u3057\u304b\u6c34\u6b7b\u8005\u306e\u306a\u3044\u3002"}
{"translation": "\u4ea4\u4e92\u7684\u306b\u8cea\u554f\u3059\u308b\u58f0\u3001\u305d\u308c\u304c\u6e29\u548c\u3067\u3082\u523a\u72b6\u7269\u540c\u69d8\u7a81\u304d\u523a\u3055\u3063\u3066\u304d\u3066\u3001\u5fc3\u81d3\u306f\u3069\u305f\u6253\u3061\u59cb\u3081\u305f\u3002"}
{"translation": "\u30d9\u30c3\u30c9\u3067\u5c0f\u3055\u304f\u4e38\u307e\u3063\u305f\u5f7c\u5973\u306f\u601d\u3063\u305f\u3002"}
{"translation": "\u300c\u79c1\u3001\u51fa\u8eab\u5730\u4f55\u51e6\u3068\u8a00\u3048\u3070\u826f\u3044\u3060\u308d\u3046?"}
{"translation": "\u79c1\u3001\u4f55\u6240\u5728\u4f4f\u3068\u8a00\u3048\u3070\u826f\u3044\u3060\u308d\u3046\uff1f\u300d"}
{"translation": "\u79c1\u306e\u540d\u524d\u306f\u4f55\u3088\uff1f"}
{"translation": "\u672c\u5f53\u3069\u3046\u3057\u3066\u305d\u3093\u306a\u4e8b\u60c5\u3067\u5ddd \u306b\u843d\u3061\u8fbc\u3093\u3067\u3059\u308b\u5fc5\u8981\u304c\u3042\u3063\u305f\u3060\u308d\u3046\uff1f\u201d\u5168\u7136\u5370\u8c61\u304c\u7121\u304f\u306a\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u201d\u79c1\u3063\u3066\u8003\u3048\u3066\u3082\u601d\u304a\u8d77\u3053\u3057\u304c\u3064\u3051\u306a\u3044\u55dc\u597d\u3088\u306d\uff1f\u201d\u81ea\u5206\u3067\u3082\u3059\u3089\u899a\u3048\u3066\u3089\u308c\u306a\u304f\u3088\u306d\uff08\u5931\u5ff5\uff09\u3002\u3068\u3044\u3046\u308f\u3051\u3067\u6ce3\u304d\u51fa\u3057\u305f\u3002\u81ea\u4ed6\u8aac\u660e\u539f\u56e0\u3002\u201d\u6211\u5fd8\u4e86\u3002\u201d"}
{"translation": "\u5f7c\u5973\u306f\u672c\u5f53\u306b\u4f55\u3082\u899a\u3048\u3066\u3044\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u3060\u304b\u3089\u7686\u306f\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u601d\u3044\u51fa\u3057\u3066\u3054\u3089\u3093\u3001\u3058\u3063\u304f\u308a\u3068\u601d\u3044\u51fa\u3057\u3066\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u5ddd\u304b\u3089\u5f15\u304d\u4e0a\u3052\u3089\u308c\u305f\u306e\u3088\u3002"}
{"translation": "\u5ddd\u304b\u3089\u59cb\u3081\u3066\u8003\u3048\u308b\u3068\u3001\u4f55\u304b\u601d\u3044\u51fa\u3059\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3088\u300d"}
{"translation": "\u5f7c\u5973\u81ea\u8eab\u7686\u306e\u8981\u6c42\u901a\u308a\u771f\u5263\u306b\u601d\u3044\u8fd4\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u5f7c\u5973\u306e\u8a18\u61b6\u304c\u5ddd\u307e\u3067\u9032\u3080\u3068\u7a81\u5982\u3001\u3056\u308f\u3056\u308f\u3059\u308b\u6c34\u97f3\u304c\u96f7\u9cf4\u306e\u3088\u3046\u306b\u9cf4\u308a\u97ff\u304f\u3002"}
{"translation": "\u540d\u72b6\u3057\u304c\u305f\u3044\u6050\u6016\u304c\u305d\u306e\u6c34\u97f3\u3068\u5171\u306b\u6bba\u5230\u3057\u305f\u3002"}
{"translation": "\u6ce2\u6d9b\u306e\u4e2d\u3067\u306f\u307e\u308b\u3067\u60aa\u9b54\u304c\u96a0\u308c\u3066\u304a\u308a\u3001\u898b\u3048\u306a\u304f\u89e6\u308c\u306a\u304f\u3066\u3082\u5f7c\u5973\u306e\u5fc3\u4f53\u3092\u5bb9\u8d66\u306a\u304f\u8972\u3063\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3059\u3050\u3055\u307e\u5236\u5fa1\u3092\u5931\u3063\u3066\u5927\u58f0\u3067\u6ce3\u304d\u53eb\u3073\u307e\u3057\u305f\u3001\u58f0\u306f\u30d2\u30b9\u30c6\u30ea\u30c3\u30af\u3060\u3063\u305f\u3002"}
{"translation": "\u3053\u306e\u5973\u6027\u306f\u305a\u3063\u3068\u81ea\u5206\u81ea\u8eab\u3068\u6226\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3082\u306f\u3084\u304b\u306a\u308a\u5e74\u8001\u3044\u3066\u3044\u308b\u3002"}
{"translation": "\u808c\u5168\u4f53\u304c\u3086\u308b\u3093\u3067\u5782\u308c\u4e0b\u304c\u3063\u3066\u304a\u308a\u3001\u307e\u3068\u3082\u306b\u76ba\u4e00\u3064\u5f35\u308a\u4ed8\u3051\u3089\u308c\u306a\u3044\u3002"}
{"translation": "\u5f7c\u5973\u306e\u9854\u3084\u9996\u306b\u306f\u7d30\u304b\u306a\u75d5\u8de1\u304c\u5bc6\u96c6\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u808c\u306e\u8272\u304c\u767d\u3044\u305b\u3044\u3067\u3001\u3053\u308c\u3089\u306e\u75d5\u8de1\u306f\u6642\u9593\u306e\u5203\u304c\u7121\u9020\u4f5c\u306b\u5f15\u304d\u88c2\u304f\u3088\u3046\u306b\u898b\u3048\u308b\u308f\u3051\u3067\u306f\u306a\u304f\u3001\u4e00\u672c\u306e\u7d30\u7b46\u3067\u5c11\u3057\u305a\u3064\u63cf\u304b\u308c\u3066\u51fa\u6765\u4e0a\u304c\u3063\u305f\u7d75\u753b\u307f\u305f\u304f\u306b\u898b\u3048\u308b \u3002"}
{"translation": "\u5f7c\u5973\u306e\u76ee\u3082\u3059\u3067\u306b\u6fc1\u3063\u3066\u3057\u307e\u3063\u305f\u304c\u3001\u6025\u6fc0\u306b\u5927\u304d\u304f\u958b\u304f\u6642\u3067\u3082\u4e2d\u304b\u3089\u5149\u8f1d\u3092\u653e\u3061\u51fa\u3059\u3053\u3068\u6298\u3005\u3042\u3063\u3066\u3001\u4eca\u3067\u3082\u78ba\u8a8d\u3059\u308b\u3053\u3068\u53ef\u80fd\u3067\u3059\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3088\u304f\u3042\u3061\u3053\u3061\u76f4\u8996\u3057\u3066\u4f55\u51e6\u304b\u8003\u3048\u8fbc\u3093\u3058\u3083\u3046\u4e8b\u591a\u3005\u3042\u308a\u307e\u3059 \u30dc\u30fc\u5446\u7136\u305d\u3093\u3060\u6771\u897f\u3055\u543e\u7269\u662f\u53e3\u7121\u804a\u7684\u3057\u307e\u3046\u4e8b\u3082\u3042\u308a\u305d\u306e\u305b\u3044\u3067\u8def\u4e0a\u6ed1\u8fc7\u53bb\u4eba\u9b6f\u8207\u51b6\u5947\u6709\u4efb\u4f55\u4ed6\u5979\u8bf4\uff1a\"\u30d0\u30fc\u30d0\u30a2\u3055\u3093\u3042\u3093\u305f\u305d\u308c\u601d\u8003\u4e2d\u54ea?\" orte"}
{"translation": "\u305d\u306e\u6642\u3001\u5f7c\u5973\u306f\u307e\u308b\u3067\u8ff7\u5b50\u306e\u3088\u3046\u306a\u9854\u3092\u3057\u3066\u8857\u884c\u304d\u3092\u898b\u3064\u3081\u3066\u3044\u305f\u3002"}
{"translation": "\u306f\u3063\u304d\u308a\u3068\u805e\u3053\u3048\u306a\u3044\u8a00\u8449\u3092\u5c0f\u3055\u304f\u3064\u3076\u3084\u3044\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\u5973\u81ea\u8eab\u3001\u4f55\u3092\u8a00\u3063\u305f\u304b\u3059\u3089\u308f\u304b\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u5b9f\u969b\u3001\u81ea\u5206\u304c\u4f55\u306b\u3064\u3044\u3066\u8003\u3048\u3066\u3044\u308b\u306e\u304b\u3082\u3057\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u305f\u3060\u305f\u3060\u5947\u5999\u306a\u3082\u306e\u9054\u304c\u6cb8\u3005\u3068\u5185\u5fc3\u304b\u3089\u6f0f\u308c\u51fa\u305d\u3046\u3068\u3059\u308b\u306e\u3092\u611f\u3058\u53d6\u308a\u3001\u305d\u308c\u304c\u4e00\u4f53\u4f55\u3067\u3042\u308b\u304b\u77e5\u308d\u3046\u3068\u3059\u308b\u3053\u3068\u306b\u529b\u3069\u3063\u3066\u6253\u3061\u52dd\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u3089\u306f\u5f7c\u5973\u304c\u751f\u6daf\u62b5\u89e6\u3057\u305f\u304f\u306a\u3044\u3082\u306e\u3070\u304b\u308a\u3060\u3063\u305f\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u5f7c\u5973\u306e\u5185\u5074\u3067\u8d77\u304d\u3066\u3044\u308b\u3053\u308c\u3089\u5168\u3066\u306b\u5bfe\u3059\u308b\u62b5\u6297\u306f\u4e00\u9762\u76ba\u76ee\u7db2\u307f\u3084\u5c06\u68cb\u5009\u307f\u305f\u304f\u5bc6\u9589\u6027\u3042\u308a \u305d\u308c\u304c\u9b54\u7269\u7fa4\u30ec\u30ae\u30aa\u30f3\u76f4\u3061\u306b\u7a81\u7834\u5c04\u51fa\u3057\u3088\u3046\u3068\u52aa\u529b\u3057\u3064\u3064\u3042\u308b \u30cd\u30c3\u30c8\u546a\u6587 \u3092\u5b8c\u5168\u963b\u6b62\u3055\u305b\u3088\u3093\u3060 \u5f7c\u5973 \u306e\u4eba\u751f \u751f\u6daf \u3053\u308c\u3089\u5168\u90e8 \u795e\u7d4c\u6b7b\u89d2\u9818\u57df\u820c \u9b54\u7269\u5bfe\u7b56\u683c\u4ed8\u3051\u6301\u53c2\u3057 \u3088 \u95d8\u4e89 \u5f79\u5272 \u30b9\u30bf\u30f3\u30d0\u30a4 \u3002"}
{"translation": "\u592b\u304c\u751f\u304d\u3066\u3044\u308b\u3068\u304d\u3001\u4f55\u304b\u601d\u3044\u63cf\u3044\u3066\u307f\u308c\u3070\u3001\u4f55\u304b\u3092\u898b\u3064\u3051\u51fa\u3057\u305f\u3089\u3001\u5fc3\u306f\u5b89\u3089\u304b\u306b\u306a\u308b\u306e\u3067\u306f\u306a\u3044\u304b\u3068\u63d0\u6848\u3057\u305f\u3053\u3068\u304c\u3042\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5f7c\u306e\u8a00\u8449\u306b\u5f93\u3046\u3053\u3068\u3092\u9858\u3063\u3066\u304a\u308a\u3001\u771f\u5263\u306b\u81ea\u5206\u81ea\u8eab\u3092\u9759\u3081\u308b\u305f\u3081\u306b\u596e\u95d8\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u4e00\u77ac\u3067\u4f53\u4e2d\u306b\u4e0d\u7a4f\u3055\u304c\u5e83\u304c\u308a\u3001\u6253\u3061\u4ed8\u3051\u3089\u308c\u308b\u92fc\u91dd\u306e\u3088\u3046\u306b\u611f\u3058\u305f\u3002"}
{"translation": "\u305d\u306e\u529b\u5f37\u3055\u306f\u51c4\u307e\u3058\u304f\u3001\u4e94\u81d3\u516d\u8151\u304c\u88c2\u3051\u3066\u3057\u307e\u3044\u305d\u3046\u3060\u3063\u305f\u3002"}
{"translation": "\u305d\u306e\u6642\u70b9\u3067\u5f7c\u5973\u306e\u82e6\u75db\u3084\u75b2\u52b4\u3067\u606f\u3082\u7d76\u3048\u7d76\u3048\u3060\u3063\u305f\u3002"}
{"translation": "\u300c\u79c1\u3092\u8ffd\u3044\u8fbc\u307e\u306a\u3044\u3067\u300d\u5f7c\u5973\u306f\u592b\u3078\u5d29\u308c\u843d\u3061\u305d\u3046\u306a\u58f0\u3067\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u8003\u3048\u308b\u3053\u3068\u304c\u51fa\u6765\u306a\u3044\u2026\u2026\u4e00\u5ea6\u8003\u3048\u3088\u3046\u3082\u306e\u306a\u3089\u79c1\u306f\u6b7b\u3093\u3067\u3082\u826f\u3055\u305d\u3046\u3060\u300d"}
{"translation": "\u592b\u306f\u9a5a\u6115\u3057\u3066\u6c88\u9ed8\u3057\u3001\u5c11\u3057\u3060\u3051\u4ed6\u5207\u7136\u6301\u3063\u3066\u300c\u305d\u308c\u4ee5\u4e0a\u8003\u3048\u308b\u5fc5\u8981\u306f\u3042\u308a\u307e\u305b\u3093\u300d\u3068\u7b54\u3048\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u4f55\u304b\u5fd9\u3057\u305d\u3046\u306a\u4ed5\u4e8b\u3067\u3082\u63a2\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u5fd9\u3057\u304f\u3059\u308b\u4e8b\u3067\u3059\u3079\u3066\u306e\u601d\u8003\u304b\u3089\u9038\u3059\u3053\u3068\u3082\u53ef\u80fd\u3067\u3059\u304b\u3089\u300d"}
{"translation": "\u5f7c\u5973\u306f\u592b\u306e\u8a00\u8449\u306b\u5f93\u3044\u3001\u6bce\u65e5\u5fd9\u3057\u304f\u904e\u3054\u3057\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5b9f\u969b\u3001\u5f7c\u5973\u306b\u306f\u7279\u5225\u306a\u4ed5\u4e8b\u306a\u3069\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u4ed5\u4e8b\u3068\u306f\u5bb6\u4e8b\u3092\u3059\u308b\u3053\u3068\u3067\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u6bce\u65e5\u304d\u308c\u3044\u306b\u6383\u9664\u3092\u3057\u3001\u5bb6\u3092\u304d\u3061\u3093\u3068\u6574\u3048\u3066\u4e00\u5875\u3082\u6b8b\u3055\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u305d\u306e\u5bb6\u306b\u8a2a\u308c\u305f\u8ab0\u3082\u304c\u3001\u300c\u3042\u306a\u305f\u306e\u304a\u5b85\u306f\u672c\u5f53\u306b\u304d\u308c\u3044\u3067\u3059\u306d\u300d\u3068\u8a00\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u3053\u3068\u304c\u533b\u8005\u306e\u592b\u306e\u81ea\u6162\u3067\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u304b\u3089\u3001\u5f7c\u5973\u306e\u751f\u6d3b\u306f\u6b21\u7b2c\u306b\u4e00\u822c\u7684\u306a\u3082\u306e\u3078\u623b\u308a\u307e\u3057\u305f \u4f55\u5e74\u7d4c\u3064\u304b\u77e5\u308a\u307e\u305b\u3093\u304c\u3001\u305a\u3063\u3068\u305d\u3046\u3057\u3066\u904e\u3054\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u4e00\u5e74\u6bce\u304f\u308b\u307f\u8fbc\u3080\u6642\u9593\u6bb5\u9694\u5185\u3067\u306f\uff0c\u5358\u4f4d\u9762\u7a4d\u5185\u5bc6\u5ea6\u7dbf\u5bc6\u6027\u53b3\u91cd\u8986\u76d6\u30c1\u30e3\u30d5\u30a7\u30eb\uff08Fell\uff09\u8a18\u61b6\u5f8c\u3067\u7269\u8cea\u5c64\u5c64\u4ed6\u5979\u4e00\u4e2a\u539f\u5b50\u5e93\u8fdb\u884c\u8fdb\u5c55\u4eba\u4e00\u6669\u4e2d\u4e16\u754c\u6700\u4e0a\u7a7aorte\u518d\u55ae\u4f4d\u7528\u542b\u5869\u91cf\u6570\u5341\u56de\u4e0b\u9762\u5730\u6838\u5fc3\u5ff5\u9593\u5165\u5168\u7d20\u6570\u5bf9\u4e16\u754c\u6df1\u5ea6\u6de1\u9ec4\u8272\u957f\u5ea6\u795e\u8b5c\u6bcf\u5e74\u8868\u97f3\u6587\u5b57\u76ae\u9769\u5916\u8868\u6750\u6599\uff0c\u305d\u308c\u3089\u3059\u3079\u3066\u610f\u8b58\u5965\u5e95\u7684\u9b54\u9b3c\u3055\u3048\u5c01\u3058\u8fbc\u3081\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u305d\u308c\u3089\u304c\u4f55\u306a\u306e\u304b\u3001\u5f7c\u5973\u306b\u306f\u5168\u304f\u5206\u304b\u3089\u306a\u304b\u3063\u305f\u306e\u3067\u3059\u3002"}
{"translation": "\u5f7c\u5973\u304c\u8a18\u61b6\u3092\u5931\u3063\u305f\u306e\u306f\u30011952\u5e74\u306e\u6625\u3067\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u592b\u306e\u6170\u3081\u3084\u6ce8\u610f\u3092\u7406\u89e3\u3067\u304d\u305a\u3001\u304b\u3048\u3063\u3066\u5fc3\u306e\u4e2d\u3067\u6fc0\u3057\u3044\u52d5\u63fa\u304c\u8d77\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u307e\u308b\u3067\u3053\u308c\u3089\u96a0\u308c\u308b\u307b\u3069\u306b\u6d88\u3048\u3064\u3064\u3042\u308b\u6575\u9054\u304c\u3001\u592b\u306b\u3088\u3063\u3066\u5236\u5fa1\u3055\u308c\u3066\u3044\u308b\u304b\u306e\u3088\u3046\u3067\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u3089\u306f\u4e00\u4f53\u4f55\u306a\u306e\u304b\uff1f"}
{"translation": "\u79c1\u304c\u77e5\u3089\u306a\u3044\u4e8b\u67c4\u3092\u5f7c\u304c\u77e5\u3063\u3066\u3044\u308b\u3068\u3067\u3082\u8a00\u3046\u306e\uff1f"}
{"translation": "\u305d\u3093\u306a\u3053\u3068\u3092\u8003\u3048\u3066\u3044\u305f\u6642\u3001\u3055\u3048\u6050\u6016\u611f\u60c5\u3055\u3048\u3082\u76f4\u63a5\u5bfe\u9762\u3057\u3066\u304f\u308b\u611f\u3058\u3055\u305b\u307e\u3057\u305f\u3002"}
{"translation": "\u3053\u306e\u6050\u6016\u611f\u60c5\u306f\u5f7c\u5973\u306e\u3059\u3050\u508d\u306b\u3042\u3063\u305f\u3002"}
{"translation": "\u65e5\u3005\u663c\u591c\u3001\u5206\u79d2\u3054\u3068\u306b\u3002"}
{"translation": "\u3060\u304b\u3089\u5f7c\u5973\u306f\u5206\u3063\u305f\u3001\u9577\u5e74\u611b\u3057\u3066\u304d\u305f\u3053\u306e\u7537\u6027\u3082\u307e\u305f\u6df1\u304f\u6291\u5727\u3055\u308c\u3066\u6050\u308c\u3066\u304d\u305f\u4eba\u9593\u3060\u3063\u305f\u3068\u3044\u3046\u4e8b\u5b9f\u3092\u3067\u3059\u3002"}
{"translation": "\u3067\u3082\u3069\u3046\u3057\u3066\uff1f\u4f55\u6545\u3053\u3093\u306a\u6c17\u6301\u3061\u304c\u50cd\u304f\u308f\u3051\u3067\u3059\u304b\uff1f"}
{"translation": "\u5f7c\u5973\u81ea\u8eab\u6df7\u4e71\u3057\u7406\u89e3\u3082\u51fa\u6765\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3053 \u306e\u6c17\u6301\u3061\u306f\u78ba\u304b\u306b\u305d\u306e\u5834\u6240\u306b\u5b58\u5728\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u7a93\u306e\u5916\u306b\u3042\u308b\u6843\u306e\u6728\u306f\uff0c\u305d\u306e\u5168\u982d\u304c\u30d4\u30f3\u30af\u8272\u306e\u82b1\u3067\u98fe\u3089\u308c\u3066\u3044\u305f\u3002"}
{"translation": "\u9662\u5185\u306e\u58c1\u969b\u306b\u54b2\u3044\u3066\u3044\u308b\u674f\u306e\u82b1\u3082\u4e00\u5217\u771f\u3063\u767d\u306b\u306a\u3063\u3066\u304a\u308a\u3001\u9060\u8996\u3059\u308b\u3068\u305d\u306e\u82b1\u8272\u306f\u767d\u58c1\u3068\u540c\u5316\u3057\u3066\u3057\u307e\u3046\u3069\u3053\u308d\u304b\u3001\u5168\u304f\u898b\u3048\u305a\u3002"}
{"translation": "\u3055\u3089\u306b\u9060\u304f\u3067\u306f\u6570\u672c\u306e\u8001\u30a4\u30c1\u30e7\u30a6\u304c\u9bae\u7dd1\u8272\u3063\u307d\u304f\u63fa\u308c\u52d5\u304d\u3001\u80a5\u539a\u306a\u5e79\u304b\u3089\u898b\u3066\u3082\u80b2\u690d\u3055\u308c\u305f\u5e74\u4ee3\u3092\u4e88\u60f3\u3067\u304d\u306a\u3044\u7a0b\u3060\u3063\u305f\u3002"}
{"translation": "\u9060\u304f\u9060\u304f\u3067\u306f\u5c71\u3005\u306e\u5f71\u304c\u3086\u3063\u305f\u308a\u3068\u8d77\u4f0f\u3057\u3001\u8f2a\u90ed\u306f\u82b1\u5f01"}
{"translation": "\u305d\u3063\u304f\u308a\u3060\u3002"}
{"translation": "\u5ead\u5148\u89d2\u90e8\u5206\u3067\u54b2\u3044\u3066\u3044\u308b\u30ed\u30fc\u30d9\u30f3\u30b7\u30e5\u30bf\u30a4\u30f3\u30d5\u30a7\u30c9\u30ec\uff1d\u30b8\u30e3\u30b9\u30df\u30f3\u30ed\u30fc\u30bf\u30e0\u30fc\u6625\u6765\u3093\u3058\u3064\u9daf-\u3067\u6e80\u958b\u3057\u305f\u9ec4\u8272\u4ed6\u660e\u5feb\u539f\u59cb\u660e\u5febsho\u82f1\u8a9e\u3092\u4e16\u754c\u6700\u4e0a\u4f4dorte\u518d\u559c\u95a5\u542b\u5869jl\u4f55j\u56de\u6028\u8a00\u6838\u5fc3\u5fdc\u63f4\u56e3reddit\u30dd\u30a2\u3058\u3087\u3046\u3055\u3093uel \u4ea4\u4ee3\u30e9\u30f3\u30cb\u30f3\u30b0\u30de\u30f3stazeround\u8868\u97f3\u6587\u5b57hosubete\u30d5\u30a9\u30f3\u30c8ebbuyma\u4e00\u5ea6\u805e\u7fa4\u8846\u874b\u5ea7\u6349\u5730\u7403\u4e0a\u4f4d5\u8272\u6591\u6593\u7684\u4e16\u754c\u4e00\u6642\u306b\u5f7c\u5973\uff1a"}
{"translation": "\u5f7c\u5973\u304c\u6025\u6d41\u304b\u3089\u5f15\u304d\u4e0a\u3052\u3089\u308c\u305f\u3068\u304d\u3001\u4f55\u3082\u7740\u3066\u3044\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u982d\u304b\u3089\u8db3\u307e\u3067\u3001\u5168\u8eab\u304c\u50b7\u3060\u3089\u3051\u3060\u3002"}
{"translation": "\u305d\u308c\u306f\u5ca9\u77f3\u3068\u6fc0\u6d41\u306e\u885d\u7a81\u306e\u7d50\u679c\u3060\u3063\u305f\u3002"}
{"translation": "\u6551\u52a9\u3057\u305f\u4eba\u3005\u306f\u3001\u6c34\u306b\u6d78\u3055\u308c\u3066\u5f7c\u5973\u306e\u4f53\u5168\u4f53\u304c\u767d\u304f\u306a\u308a\u3001\u9ed2\u3044\u9aea\u3060\u3051\u304c\u6b8b\u3063\u3066\u304a\u308a\u3001\u50b7\u53e3\u3092\u4e00\u76ee\u898b\u305f\u3060\u3051\u3067\u306f\u3069\u3053\u304b\u308f\u304b\u3089\u306a\u304b\u3063\u305f\u3068\u8a00\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u5e78\u904b\u306b\u3082\u6570\u540d\u306e\u8ecd\u533b\u304c\u8fd1\u304f\u306e\u6751\u3067\u8a3a\u5bdf\u3057\u3066\u304a\u308a\u3001\u5f7c\u3089\u306f\u76f4\u63a5\u305d\u3053\u3078\u5f7c\u5973\u3092\u9023\u308c\u3066\u884c\u3063\u305f\u3002"}
{"translation": "\u5fdc\u6025\u51e6\u7f6e\u5f8c\u3001\u305d\u306e\u533b\u5e2b\u9054\u306f\u901f\u3084\u304b\u306b\u5f7c\u5973\u3092\u75c5\u9662\u3078\u9023\u308c\u623b\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u75c5\u9662\u3067\u534a\u6708\u4ee5\u4e0a\u76ee\u899a\u3081\u308b\u307e\u3067\u904e\u3054\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u3067\u3082\u3057\u3063\u304b\u308a\u610f\u8b58\u3092\u53d6\u308a\u623b\u3057\u59cb\u3081\u3066\u7686\u3055\u3093\u306e\u5c0b\u554f\u306b\u7b54\u3048\u3088\u3046\u3068\u3057\u305f\u6642\u3067\u3059\u3002"}
{"translation": "\u30dc\u30fc\u30c3\u3068\u3057\u3066\u56fa\u307e\u308b\u3053\u3068\u3057\u304b\u51fa\u6765\u306a\u304b\u3063\u305f\u3088\u3046\u3067\u3059"}
