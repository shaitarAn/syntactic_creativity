{"translation": "\u79c1\u306e\u982c\u306e\u4e0b\u306b\u3042\u308b\u3053\u306e\u672c\u306f\u604b\u611b\u5c0f\u8aac\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u306f\u65e2\u5a5a\u8005\u306e\u7537\u304c\u5973\u6027\u3068\u51fa\u4f1a\u3046\u8a71\u3067\u3001\u5f7c\u5973\u306b\u306f\u3059\u3067\u306b\u5f7c\u6c0f\u304c\u3044\u307e\u3059\u3002"}
{"translation": "\u79c1\u306f\u3059\u3067\u306b\u305d\u306e7\u30da\u30fc\u30b8\u3092\u8aad\u3093\u3060\u3060\u3051\u3067\u5fc3\u304b\u3089\u7406\u89e3\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u4f55\u3082\u9a5a\u304f\u3053\u3068\u306a\u3093\u3066\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u305a\u3063\u3068\u4ee5\u524d\u304b\u3089\u3001\u65b0\u305f\u306a\u6587\u7ae0\u3092\u8aad\u3080\u3053\u3068\u3067\u306f\u306a\u304f\u518d\u8aad\u3059\u308b\u3053\u3068\u3057\u304b\u3057\u3066\u3044\u307e\u305b\u3093\u3002"}
{"translation": "\u300c\u65b0\u520a\u300d\u3068\u547c\u3070\u308c\u308b\u53e4\u5178\u7684\u306a\u3082\u306e\u3001\u30b7\u30fc\u30ba\u30f3\u3054\u3068\u306e\u3082\u306e\u3001\u300c\u6587\u5b66\u300d\u56f3\u66f8\u3001\u6210\u529f\u4f5c\u3084\u5931\u6557\u4f5c\u3002"}
{"translation": "\u3076\u3064\u3051\u3089\u308c\u305f\u308a\u96fb\u5149\u77f3\u706b\u3055\u305b\u3089\u308c\u307e\u3059\u3002"}
{"translation": "\u7d19\u3092\u30ea\u30b5\u30a4\u30af\u30eb\u3057\u3001\u671d\u51fa\u767a\u3057\u591c\u5e30\u3063\u3066\u304f\u308b\u6e80\u676f\u306e\u30c8\u30e9\u30c3\u30af\u3002"}
{"translation": "\u300c\u6700\u65b0\u300d\u304c\u65e9\u3005\u53cd\u6642\u4ee3\u7684\u3002"}
{"translation": "\u4f55\u5e74\u3082\u306e\u9593\u3001\u79c1\u304c\u5091\u4f5c\u3092\u767a\u898b\u3057\u3001\u65b0\u305f\u306a\u4eba\u9593\u3068\u3057\u3066\u6708\u66dc\u65e5\u306b\u30aa\u30d5\u30a3\u30b9\u306b\u623b\u308b\u3053\u3068\u306b\u5bfe\u3057\u3066\u559c\u3073\u3092\u611f\u3058\u308b\u3053\u3068\u3092\u6b62\u3081\u3066\u3057\u307e\u3063\u305f\u306e\u3060\u308d\u3046\u304b\uff1f"}
{"translation": "20\u5e74\uff1f30\u5e74\uff1f\u79c1\u306f\u6b7b\u81ed\u6f02\u3046\u3088\u3046\u306a\u305d\u306e\u3088\u3046\u306a\u8a08\u7b97\u304c\u597d\u304d\u3067\u306f\u306a\u3044\u3002"}
{"translation": "\u76ee\u3092\u9589\u3058\u308c\u3070\u30d1\u30fc\u30bc\u30eb\u306e\u30e9\u30f3\u30d7\u304b\u3089\u5747\u4e00\u306b\u9ec4\u8272\u304f\u5149\u308b\u5149\u304c\u77bc\u8d8a\u3057\u306b\u898b\u3048\u3001\u305d\u306e\u5f8c\u3067\u9ed2\u3044\u5f62\u304c\u305d\u308c\u3092\u8986\u3044\u59cb\u3081\u3001\u79fb\u308a\u5909\u308f\u308b\u907a\u8de1\u3084\u30f4\u30a3\u30af\u30c8\u30fc\u30eb\u30fb\u30e6\u30b4\u30fc\u306e\u7d75\u753b\u304c\u898b\u3048\u3066\u304f\u308b\u3002"}
{"translation": "\u606f\u304c\u843d\u3061\u7740\u304d\u3001\u5fc3\u62cd\u6570\u304c\u5c11\u3057\u305a\u3064\u6e1b\u5c11\u3059\u308b\u3002"}
{"translation": "\u79c1\u306f\u7720\u308a\u8f9e\u4e16\u3059\u308b\u3053\u3068\u3082\u53ef\u80fd\u3060\u3002"}
{"translation": "\u300c\u5f7c\u306f\u8aad\u66f8\u4e2d\u3067\u751f\u304d\u3066\u304d\u305f\u3088\u3046\u306b\u672c\u306e\u4e2d\u3067\u6b7b\u3093\u3060\u300d\u3068\u8a00\u308f\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u5b9f\u969b\u7684\u306b\u306f\u5358\u7d14\u7121\u610f\u5473 \u800c\u6765\u306e\u5922\u4e2d\u3067\u4ea1\u304f\u306a\u3063\u305f\u3060\u308d\u3046\u3002"}
{"translation": "\u5b9f\u969b\u7684\u306b\u306f\u9577\u3089\u304f\u771f\u5263\u6210\u529f\u80fd\u8aad\u66f8\u3057\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u300c\u672c\u5f53 bout \u306e\u8aad\u307f\u65b9\u300d\u3055\u3048\u4eca\u3067\u306f\u7406\u89e3\u4e0d\u80fd\u305d\u3057\u3066\u3067\u3042\u308d\u3046\u304b\uff1f"}
{"translation": "\u4f5c\u6cd5\u3059\u3089\u5931\u3063\u3066 \u3044\u305d\u308c \u308b \u72b6\u614b \u3060 \u9053\u7406 \u308d \u4e86 \u6b64 \u56f0\u96e3 \u3002"}
{"translation": "\u6545\u610f \u5074 \u4e0b\u7a4d\u4e0b\u4f4d \u6307\u793a \u3068 \u767a\u8a00 \u3002"}
{"translation": "\u4e2d\u65ad \u306e\u3069 or \u8eab\u4f53 \u500d \u3002"}
{"translation": "\u305d\u306e\u5bb6\u306f\u307e\u308b\u3054\u3068\u53e4\u3044\u7d19\u306e\u9759\u3051\u3055\u306b\u5305\u307e\u308c\u3066\u3044\u308b\u3002"}
{"translation": "\u96ea\u304c\u305d\u3046\u3067\u3042\u308b\u3088\u3046\u306b\u3001\u672c\u306f\u97f3\u3092\u98f2\u307f\u8fbc\u3080\u3002"}
{"translation": "\u79c1\u306e\u4ed5\u4e8b\u306b\u306f\u305d\u308c\u81ea\u4f53\u306e\u9999\u308a\u3068\u6291\u3048\u304c\u305f\u3044\u611f\u60c5\u304c\u3042\u308a\u3001\u3053\u306e\u9759\u5bc2\u306e\u4e2d\u3067\u305d\u308c\u3092\u4e00\u5c64\u6df1\u304f\u5438\u3044\u8fbc\u3080\u3053\u3068\u304c\u3067\u304d\u308b\u3002"}
{"translation": "\u4e16\u754c\u306e\u55a7\u9a12\u3078\u623b\u308b\u3053\u3068\u306f\u5e38\u306b\u56f0\u96e3\u306a\u8a66\u7df4\u3060\u3002"}
{"translation": "\u8ab0\u304c\u30ce\u30c3\u30af\u3057\u3066\u3044\u308b\u306e\u3060\u308d\u3046\uff1f"}
{"translation": "\u3053\u306e\u8efd\u3084\u304b\u3067\u5c0f\u3055\u306a\u3001\u63a7\u3048\u3081\u306a\u30ce\u30c3\u30af\u306f\u898b\u77e5\u3089\u306c\u3082\u306e\u3060\u3002"}
{"translation": "\u5c0f\u3055\u306a\u624b\u304b\u3002"}
{"translation": "\u5165\u308a\u306a\u3055\u3044\u3002"}
{"translation": "\u5f7c\u5973\u304c\u5165\u3063\u3066\u304f\u308b\u3002"}
{"translation": "\u521d\u3081\u3066\u898b\u308b\u9854\u3060\u3002"}
{"translation": "\u3059\u3050\u306b\u61d0\u304b\u3057\u3055\u304c\u3053\u307f\u4e0a\u3052\u3066\u304d\u305f\u3001\u5bb6\u304c\u307e\u3060\u5c0f\u3055\u304f\u3066\u3001\u5eca\u4e0b\u3067\u3080\u304f\u3080\u304f\u3068\u3057\u305f\u8db3\u3092\u898b\u308c\u3070\u5168\u54e1\u3092\u8b58\u5225\u3067\u304d\u305f\u9803\u3092\u601d\u3044\u51fa\u3059\u61d0\u304b\u3057\u3055\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3044\u3044\u9854\u7acb\u3061\u3092\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u9a5a\u304d\u306e\u8272\u3092\u5e2f\u3073\u305f\u5f7c\u5973\u306e\u8996\u7dda\u304b\u3089\u3059\u308b\u3068\u3001\u79c1\u306e\u8868\u60c5\u306f\u591a\u5c11\u9a12\u304c\u3057\u3044\u3076\u3064\u3051\u3089\u308c\u65b9\u3055\u308c\u3066\u3057\u307e\u3063\u305f\u3060\u308d\u3046\u3002"}
{"translation": "\u304a\u305d\u3089\u304f\u79c1\u306e\u30b8\u30e3\u30b1\u30c3\u30c8\u8896\u304b\u3089\u6765\u308b\u8d64\u307f\u304c\u982c\u306b\u62bc\u3057\u4ed8\u3051\u3089\u308c\u3066\u3002"}
{"translation": "\u90aa\u9b54\u3057\u3066\u307e\u3059\u304b\uff1f"}
{"translation": "\u3042\u306a\u305f\u304c\u901a\u308a\u904e\u304e\u305f\u5f8c\u3082\u79c1\u306f\u751f\u304d\u3066\u3044\u307e\u3059\u3088\u3001\u304a\u5b22\u3055\u3093\u3002"}
{"translation": "\u305d\u3063\u3061\u306f\u4f55\u8005\u306a\u306e\uff1f\u304a\u30fc\u3001\u79c1\u30a4\u30f3\u30bf\u30fc\u30f3\u3067\u3059\uff01"}
{"translation": "\u3069\u306e\u90e8\u7f72\u306b\uff1f\u305d\u308c\u306f\u8a00\u308f\u308c\u3066\u3044\u307e\u305b\u3093\u3002"}
{"translation": "\u77e5\u3063\u3066\u308b\u3067\u3057\u3087\u3046\u3001\u79c1\u305f\u3061\u30a4\u30f3\u30bf\u30fc\u30f3\u306f\u3068\u3066\u3082\u591a\u304f\u306e\u4ed5\u4e8b\u3092\u3053\u306a\u3059\u304b\u3089\u591a\u624d\u3067\u3042\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3088\u306d\u3002"}
{"translation": "\u6607\u7d66\u3092\u671b\u3093\u3067\u3044\u307e\u3059\u304b\uff1f"}
{"translation": "\u3044\u3048\u3001\u73fe\u6bb5\u968e\u3067\u306f\u4f55\u3082\u8cb0\u3063\u3066\u3044\u307e\u305b\u3093\u304b\u3089\u3002"}
{"translation": "\u5f7c\u5973\u306f\u982d\u304c\u5c11\u3057\u30dc\u30b5\u30dc\u30b5\u3067\u3001\u30b8\u30fc\u30f3\u30ba\u306f\u7a74\u3060\u3089\u3051\u3001\u4ed6\u306e\u90e8\u5206\u306f\u8272\u3065\u3044\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5c0f\u67c4\u3067\u3001\u9ed2\u3044\u76ee\u3092\u3057\u3066\u3044\u3066\u89aa\u3057\u307f\u3084\u3059\u3044\u3067\u3059\u304c\u3001\u5f7c\u5973\u304c\u53ef\u611b\u3044\u304b\u3069\u3046\u304b\u3092\u8a00\u3046\u306e\u306f\u96e3\u3057\u3044\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u79c1\u306b\u3068\u3063\u3066\u3082\u3001\u3053\u3046\u3044\u3046\u5973\u6027\u305f\u3061\u3092\u7406\u89e3\u3059\u308b\u3053\u3068\u3082\u96e3\u3057\u304f\u306a\u3063\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u751f\u547d\u529b\u306b\u6e80\u3061\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u30d5\u30e9\u30f3\u30b9\u56fd\u7acb\u9ad8\u7b49\u5e2b\u7bc4\u5b66\u6821\u51fa\u8eab\u3067\u3059\u304b\uff1f"}
{"translation": "\u305d\u308c\u3068\u3082\u66f8\u7c4d\u7523\u696d\u306e\u30d7\u30ed\u30d5\u30a7\u30c3\u30b7\u30e7\u30ca\u30eb\u3067\u3042\u308a\u7d9a\u3051\u308b\u305f\u3081\u306b\u6bce\u5e74\u6570\u5343\u4eba\u306eGaston Gallimard\uff08\u8457\u540d\u306a\u30d5\u30e9\u30f3\u30b9\u306e\u51fa\u7248\u793e\u793e\u9577\uff09\u3089\u3092\u4f5c\u308a\u4e0a\u3052\u308b\u56f3\u66f8\u95a2\u9023\u6a5f\u5668\uff1f"}
{"translation": "\u305d\u308c\u3067\u3053\u3053\u3067\u4f55\u3092\u3057\u3066\u3044\u308b\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u79c1\u3082\u672c\u304c\u5927\u597d\u304d\u306a\u3093\u3067\u3059\uff01"}
{"translation": "\u305d\u308c\u304b\u3089\u3001\u7a7a\u304d\u304c\u3042\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u4f01\u696d\u3067\u306e\u30a4\u30f3\u30bf\u30fc\u30f3\u30b7\u30c3\u30d7\u3092\u884c\u3046\u5fc5\u8981\u304c\u3042\u3063\u305f\u3093\u3067\u3059\u3002"}
{"translation": "\u7fa9\u52d9\u7684\u306b\u3002"}
{"translation": "\u305d\u308c\u3067\u306f\u3001\u304a\u5c0b\u306d\u3057\u307e\u3059\u304c\u79c1\u306e\u30aa\u30d5\u30a3\u30b9\u3067\u4f55\u3092\u3055\u308c\u3066\u3044\u308b\u3093\u3067\u3059\u304b\uff1f"}
{"translation": "\u30e0\u30cb\u30a8\u6c0f\u3001\u90e8\u9580\u8cac\u4efb\u8005\u306b\u6307\u793a\u3055\u308c\u305f\u304b\u3089\u3067\u3059\u3068\u3002"}
{"translation": "\u90e8\u9580\u8cac\u4efb\u8005\uff1f\u30e0\u30cb\u30a8\u6c0f\uff1f\u5f7c\u3092\u77e5\u3063\u3066\u3044\u307e\u3059\u304b\uff1f"}
{"translation": "\u3088\u304f\u77e5\u3063\u3066\u3044\u307e\u3059\u3088\u3002"}
{"translation": "\u3044\u3048\u3001\u6587\u5316\u4e8b\u696d\u306e\u904b\u55b6\u3067\u3059\u3002"}
{"translation": "\u672c\u5f53\u306b\uff1f\u305d\u3057\u3066\u3001\u3042\u306a\u305f\u306f\u51fa\u7248\u3092\u7ba1\u7406\u3057\u305f\u3044\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u305d\u308c\u306a\u3089\u5e78\u904b\u3092\u7948\u308a\u307e\u3059\u3002"}
{"translation": "\u79c1\u306f\u30b3\u30f3\u30b5\u30fc\u30c8\u3092\u4f01\u753b\u3059\u308b\u65b9\u304c\u826f\u3044\u3068\u601d\u3044\u307e\u3059\u3002"}
{"translation": "\u5ea7\u3063\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u79c1\u306f\u884c\u304b\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\u3001\u4eca\u65e5\u306f\u91d1\u66dc\u65e5\u3067\u3059\u304b\u3089\u3002"}
{"translation": "\u3082\u3046\u9045\u3044\u3067\u3059\u3057\u3002"}
{"translation": "\u4e94\u5206\u3060\u3051\u304a\u9858\u3044\u3057\u307e\u3059\u3002"}
{"translation": "\u3042\u306a\u305f\u304c\u30b3\u30f3\u30b5\u30fc\u30c8\u3092\u4f01\u753b\u3057\u305f\u3044\u3093\u3067\u3059\u306d\uff1f"}
{"translation": "\u305d\u3046\u3060\u306d\u3001\u97f3\u697d\u3063\u3066\u7d20\u6674\u3089\u3057\u3044\u3082\u306e\u3088\u306d\u3002"}
{"translation": "\u9577\u3044\u9593\u3001\u5c11\u3057\u306e\u30ea\u30e9\u30af\u30bc\u30fc\u30b7\u30e7\u30f3\u3084\u9ad8\u63da\u611f\u306e\u305f\u3081\u3001\u305d\u3057\u3066\u8133\u306b\u3082\u3046\u5c11\u3057\u8840\u3092\u9001\u308b\u305f\u3081\u306b\u3053\u306e\u4e0a\u3067\u8db3\u3092\u7d44\u3093\u3067\u304d\u307e\u3057\u305f\u304c\u3001\u4eca\u3067\u306f\u982d\u3092\u3053\u3053\u306b\u7f6e\u304f\u3053\u3068\u304c\u307e\u3059\u307e\u3059\u591a\u304f\u306a\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u7279\u306b\u591c\u3001\u7279\u306b\u91d1\u66dc\u65e5\u306e\u591c\u3067\u3059\u3002"}
{"translation": "\u69cb\u60f3\u4e2d\u306e\u539f\u7a3f\u306e\u4e0a\u3067\u8155\u3092\u4ea4\u5dee\u3055\u305b\u3066\u982d\u3092\u305d\u3053\u3078\u8a17\u3057\u307e\u3059\u3002"}
{"translation": "\u984d\u306f\u8155\u304b\u3089\u97ff\u304d\u6e21\u308a\u307e\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u65b0\u9bae\u306a\u6587\u7ae0\u306f\u982c\u304b\u3089\u611f\u3058\u53d6\u308a\u307e\u3059\u3002"}
{"translation": "\u30c7\u30b9\u30af\u306e\u6728\u304c\u79c1\u306e\u5fc3\u81d3\u306e\u9f13\u52d5\u3092\u5897\u5e45\u3055\u305b\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u30a2\u30fc\u30eb\u30c7\u30b3\u69d8\u5f0f\u306e\u53e4\u3044\u5bb6\u5177\u306f\u611f\u60c5\u3068\u75b2\u52b4\u3092\u826f\u597d\u306b\u4f1d\u3048\u3066\u304f\u308c\u307e\u3059\u3002"}
{"translation": "\u30eb\u30fc\u30eb\u30de\u30f3\uff1f\u30ec\u30eb\u30fc\uff1f\u305d\u308c\u306f\u8003\u3048\u3089\u308c\u307e\u305b\u3093\u306d\u3002"}
{"translation": "\u300c\u79c1\u300d\u306f\u81ea\u5206Businessman\u3067\u3042\u308b\u2764\ufe0f\u5fc3\u81d3\u300c\u79c1\u300d\u91d1\u66dc\u65e5\u3055\u3093"}
{"translation": "\u305d\u308c\u306a\u3089\u3042\u306a\u305f\u306f\u77e5\u3063\u3066\u3044\u307e\u3059\u306d\u3002"}
{"translation": "\u5f7c\u304c\u79c1\u306b\u3053\u3093\u306a\u3082\u306e\u3092\u6301\u3063\u3066\u304d\u3066\u304f\u308c\u3068\u8a00\u3063\u305f\u3093\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u3067\u3053\u308c\u306f\u4f55\u3067\u3059\u304b\uff1f"}
{"translation": "\u3048\u3048\u3001\u3053\u308c\u306f\u96fb\u5b50\u30d6\u30c3\u30af\u30ea\u30fc\u30c0\u30fc\u3001\u96fb\u5b50\u66f8\u7c4d\u3001iPad\u3001\u308f\u304b\u3089\u306a\u3044\u3051\u3069\u3002"}
{"translation": "\u5f7c\u304c\u3042\u306a\u305f\u306e\u5168\u3066\u306e\u30de\u30cb\u30e5\u30b9\u30af\u30ea\u30d7\u30c8\u3092\u9031\u672b\u4e2d\u306b\u5165\u308c\u3066\u304a\u3044\u305f\u3068\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u3067\u6301\u3061\u904b\u3073\u304c\u697d\u306b\u306a\u308b\u3088\u3046\u3067\u3059\u3088\u3002"}
{"translation": "\u8aac\u660e\u3057\u307e\u3059\u304b\uff1f"}
{"translation": "\u898b\u3066\u304f\u3060\u3055\u3044\u3001\u3053\u308c\u306f\u5168\u90e8\u30de\u30cb\u30e5\u30b9\u30af\u30ea\u30d7\u30c8\u304c\u66f8\u304b\u308c\u305f\u753b\u9762\u307f\u305f\u3044\u306a\u3082\u306e\u3067\u3059\u306d\u3002"}
{"translation": "\u507d\u7269\u306e\u672c\u7269\u305d\u3063\u304f\u308a\u306e\u6728\u88fd\u68da\u306b\u7f6e\u304b\u308c\u3066\u307e\u3059\u3088\u3002"}
{"translation": "\u89e6\u308b\u3060\u3051\u3067\u958b\u304d\u307e\u3059\u3088\u3002"}
{"translation": "\u7d50\u69cb\u6ca2\u5c71\u3042\u308a\u307e\u3059\u306d\u3002"}
