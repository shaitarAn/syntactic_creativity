{"translation": "\u3059\u3079\u3066\u3092\u5fd8\u308c\u308b\u3053\u3068\u306f\u78ba\u304b\u306b\u60aa\u3044\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u4ee5\u4e0a\u306b\u60aa\u3044\u306e\u306f\u3001\u4f55\u3082\u304b\u3082\u5fd8\u308c\u306a\u3044\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u306a\u305c\u306a\u3089\u3001\u77e5\u8b58\u306f\u3059\u3079\u3066\u5fd8\u5374\u304b\u3089\u751f\u307e\u308c\u308b\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u96fb\u529b\u3092\u6d88\u8cbb\u3059\u308b\u30c7\u30fc\u30bf\u30b9\u30c8\u30ec\u30fc\u30b8\u306e\u3088\u3046\u306b\u3001\u3059\u3079\u3066\u304c\u7121\u5dee\u5225\u306b\u4fdd\u5b58\u3055\u308c\u305f\u5834\u5408\u3001\u305d\u306e\u5185\u5bb9\u306f\u610f\u5473\u3092\u5931\u3044\u3001\u6574\u7406\u3055\u308c\u3066\u3044\u306a\u3044\u4f7f\u3048\u306a\u3044\u60c5\u5831\u306e\u96c6\u7a4d\u4f53\u3068\u306a\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3002"}
{"translation": "\u3059\u3079\u3066\u3092\u4fdd\u5b58\u3059\u308b\u8a18\u61b6\u306f\u3001\u6839\u672c\u7684\u306b\u4f55\u3082\u4fdd\u5b58\u3057\u3066\u3044\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "1980\u5e742\u67085\u65e5\u4ee5\u964d\u306e\u6bce\u65e5\u3092\u4e00\u3064\u6b8b\u3089\u305a\u601d\u3044\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u306e\u5973\u6027\u306f\u3001\u7d76\u3048\u305a\u5f7c\u5973\u306b\u62bc\u3057\u5bc4\u305b\u7d9a\u3051\u308b\u8a18\u61b6\u306e\u30a8\u30b3\u30fc\u30eb\u30fc\u30e0\uff08\u53cd\u97ff\u5ba4\uff09\u306b\u56da\u308f\u308c\u3066\u3044\u307e\u3059 \u2014 \u30a2\u30c3\u30c6\u30a3\u30ab\u5730\u65b9\u306e\u5c06\u8ecd\u30c6\u30df\u30b9\u30c8\u30af\u30ec\u30b9\u304c\u518d\u73fe\u3055\u308c\u305f\u4eba\u7269\u3067\u3042\u308a\u3001\u5f7c\u306f\u81ea\u5206\u306e\u6545\u90f7\u5e02\u6c11\u5168\u54e1\u3092\u540d\u524d\u3054\u3068\u306b\u77e5\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u5f7c\u306f\u62bd\u8c61\u5316\u6280\u8853\u5bb6\u30b5\u30a4\u30e2\u30cb\u30c6\u30b9\u306b\u4f1d\u3048\u3055\u305b\u305f\u3001\u300c\u79c1\u306f\u3080\u3057\u308d\u5fd8\u5374\u306e\u82b8\u8853\u3092\u5b66\u3073\u305f\u3044\u3068\u6b32\u671b\u3059\u308b\u3053\u3068\u3053\u305d\u610f\u56f3\u3057\u3066\u3044\u308b: \"\u79c1\u304c\u899a\u3048\u3066\u304a\u304d\u305f\u304f\u306a\u3044\u3053\u3068\u3082\u542b\u3081\u3066\u3001\u79c1\u304c\u4fdd\u6301\u3057\u3066\u3057\u307e\u3046\u3082\u308d\u3082\u308d\uff1b\u3057\u304b\u3057\u3001\u79c1\u304c\u5fd8\u308c\u3088\u3046\u3068\u601d\u3046\u3053\u3093\u3069\u3082\u5fd8\u308c\u3089\u308c\u306a\u304b\u3063\u305f\u300d\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u907a\u5fd8\u82b8\u8853\u306f\u4e0d\u53ef\u80fd\u306a\u4e8b\u67c4\u3067\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u306f\u3059\u3079\u3066\u306e\u5146\u5019\u304c\u5b58\u5728\u305d\u306e\u3082\u306e\u3092\u793a\u3059\u304b\u3089\u3067\u3059, \u305d\u308c\u3089\u5146\u5019\u81ea\u8eab\uff0c\u5f7c\u3089\u81ea\u8eab\u4f53\u73fe\u3057\u305f\u6b20\u5e2d\u4eba\u7269\u6307\u793a\u3059\u308b\u5834\u5408\u3067\u3082\u3042\u308b\u3002"}
{"translation": "\u30ed\u30fc\u30de\u5e1d\u56fd\u5168\u4f53\u304b\u3089\u8a18\u61b6\u306e\u546a\u3044\u3001damnatio memoriae\u3092\u53d7\u3051\u305f\u307b\u3068\u3093\u3069\u3059\u3079\u3066\u306e\u8005\u306f\u3001\u767e\u79d1\u4e8b\u5178\u304c\u540d\u524d\u3092\u77e5\u3063\u3066\u3044\u308b\u3068\u4e3b\u5f35\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u81ea\u6c7a\u306f\u3001\u672a\u6765\u306e\u4e0d\u78ba\u304b\u3055\u3092\u6253\u3061\u52dd\u3064\u305f\u3081\u306e\u6700\u3082\u904e\u6fc0\u306a\u624b\u6bb5\u3068\u3057\u3066\u898b\u3089\u308c\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u304c\u3001\u305d\u306e\u4ee3\u511f\u306f\u77ed\u3044\u751f\u6daf\u3067\u3059\u3002"}
{"translation": "\u30b5\u30e2\u30b9\u5cf6\u3067\u30aa\u30fc\u30ac\u30b9\u30bf\u30b9\u304c\u4e00\u5ea6\u30a4\u30ae\u30ea\u30b9\u306e\u4f7f\u7bc0\u304b\u3089\u53d7\u3051\u53d6\u3063\u305f\u8d08\u7269\u306b\u306f\u3001\u864e\u3084\u4e21\u8155\u306e\u306a\u3044\u5c11\u5e74\u3060\u3051\u3067\u306a\u304f\u3001\u5f7c\u81ea\u8eab\u306e\u4eba\u751f\u3092\u7d42\u308f\u3089\u305b\u308b\u3053\u3068\u3092\u8003\u3048\u3066\u3044\u305f\u30d6\u30e9\u30fc\u30de\u30ca\u968e\u7d1a\u51fa\u8eab\u306e\u30b6\u30eb\u30de\u30ed\u30b9\u3068\u3044\u3046\u7537\u3082\u542b\u307e\u308c\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u4eba\u751f\u304c\u671b\u307f\u901a\u308a\u306b\u9032\u3093\u3060\u3053\u3068\u3092\u7406\u7531\u306b\u6b7b\u306c\u3053\u3068\u3092\u8003\u3048\u307e\u3057\u305f\u3002"}
{"translation": "\u4e88\u671f\u3057\u306a\u3044\u4f55\u4e8b\u304b\u306b\u898b\u821e\u308f\u308c\u308b\u3053\u3068\u304c\u7121\u304f\u78ba\u5b9f\u306b\u3059\u308b\u305f\u3081\u3001\u5f7c\u306f\u7b11\u9854\u3067\u88f8\u4f53\u30fb\u5857\u6cb9\u3057\u305f\u72b6\u614b\u3067\u30a2\u30c6\u30cd\u3067\u306f\u706b\u4e2d\u3078\u98db\u3073\u8fbc\u307f\u307e\u3057\u305f\u3002"}
{"translation": "\u9593\u9055\u3044\u306a\u304f\u713c\u3051\u721b\u308c\u3066\u751f\u304d\u306a\u304c\u3089\u82e6\u3057\u3093\u3060\u5f8c\u3001\u81ea\u5df1\u6c7a\u5b9a\u7684\u6b7b\u4ea1\u6f14\u51fa\u4f53\u9a13\u8005\u3068\u3057\u3066\u6b74\u53f2\u8868\u73fe\u5165\u308a\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u30ab\u30c3\u30b7\u30a6\u30b9\u30fb\u30c7\u30a3\u30aa\u306e\u30ed\u30fc\u30de\u53f2\uff08\u5168\u90e8\u306780\u518a\u304b\u3089\u6210\u308a\u7acb\u3063\u3066\u304a\u308a\u4f59\u5206\u672c\uff09\u5185\u90e8\u3067\u306f\u5947\u5929\u6bcd\u9047\u8a71\u3067\u3059\u3063\u3071\u7a0b\u5ea6\u3057\u304b\u8a00\u53ca\u3055\u308c\u3066\u3044\u306a\u3044\u3082\u306e\u306e\u3001\u305d\u306e\u4e2d\u8eab\u306f\u5076\u7136\u4fdd\u5b58\u3055\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u7d50\u5c40\u3001\u6b8b\u3063\u3066\u3044\u308b\u5168\u3066\u3067\u3059\u3079\u3066\u5358\u4f4d\u58f2\u5272\u308c\u3067\u3059\u3002"}
{"translation": "\u751f\u304d\u3066\u3044\u308b\u3068\u3044\u3046\u3053\u3068\u306f\u3001\u640d\u5931\u3092\u7d4c\u9a13\u3059\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u307e\u3059\u3002"}
{"translation": "\u4f55\u304c\u8d77\u3053\u308b\u306e\u304b\u3068\u3044\u3046\u554f\u3044\u306f\u3001\u4eba\u985e\u81ea\u4f53\u3088\u308a\u3082\u82e5\u304f\u306a\u3044\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u672a\u6765\u306b\u306f\u4e88\u77e5\u53ef\u80fd\u6027\u3092\u8d85\u3048\u305f\u4e0d\u53ef\u907f\u3067\u3042\u308a\u306a\u304c\u3089\u4e0d\u5feb\u306a\u7279\u6027\u304c\u5b58\u5728\u3059\u308b\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u305d\u306e\u305f\u3081\u3001\u6b7b\u306e\u6642\u671f\u3084\u72b6\u6cc1\u3082\u95c7\u306e\u4e2d\u306b\u3042\u308b\u306e\u3067\u3059\u3002"}
{"translation": "\u8ab0\u3060\u3063\u3066\u7518\u82e6\u3044\u4e8b\u524d\u845b\u85e4\u3001\u3064\u307e\u308a\u6050\u308c\u3089\u308c\u3066\u601d\u3046\u6050\u6016\u3092\u4e8b\u524d\u306b\u8003\u3048\u9632\u304e\u305f\u3044\u3068\u3044\u3046\u81f4\u547d\u7684\u306a\u885d\u52d5\u3092\u907f\u3051\u308b\u546a\u8853\u3092\u77e5\u308a\u307e\u305b\u3093\u304b\uff1f"}
{"translation": "\u4eba\u3005\u306f\u58ca\u6ec5\u7684\u306a\u4e8b\u8c61\u3092\u4e88\u611f\u3057\u3001\u53ef\u80fd\u6027\u306e\u3042\u308b\u707d\u5bb3\u3092\u60f3\u50cf\u3057\u3001\u305d\u3046\u3059\u308b\u3053\u3068\u3067\u9a5a\u304d\u304b\u3089\u9003\u308c\u3089\u308c\u308b\u3060\u308d\u3046\u3068\u4fe1\u3058\u307e\u3059\u3002"}
{"translation": "\u53e4\u4ee3\u3067\u306f\u5922\u304c\u6170\u3081\u63d0\u4f9b\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u795e\u8a17\u306e\u3088\u3046\u306b\u672a\u6765\u3092\u4e88\u8a00\u3057\u305f\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u3089\u306f\u672a\u6765\u304b\u3089\u5909\u308f\u3089\u306c\u3082\u306e\u3067\u306f\u7121\u304f\uff0c\u7a81\u7136\u9a5a\u304b\u3055\u308c\u308b\u6050\u6016\u611f\u3060\u3051\u53d6\u308a\u9664\u304d\u307e\u3057\u305f\uff08\u30ae\u30ea\u30b7\u30e3\u4eba"}
{"translation": "\u904e\u53bb\u3092\u4fdd\u6301\u3057\u3001\u5fd8\u5374\u3092\u9632\u3050\u6226\u7565\u306f\u591a\u7a2e\u591a\u69d8\u3067\u3059\u3002"}
{"translation": "\u4f1d\u627f\u3092\u4fe1\u3058\u308b\u306a\u3089\u3070\u3001\u79c1\u305f\u3061\u306e\u6b74\u53f2\u8a18\u8ff0\u306e\u59cb\u307e\u308a\u306b\u306f\u30da\u30eb\u30b7\u30e3\u4eba\u3068\u30ae\u30ea\u30b7\u30e3\u4eba\u3068\u306e\u9593\u306e\u7834\u58ca\u7684\u306a\u6226\u4e89\u304c\u9023\u306a\u308a\u3001\u4eca\u65e5\u3067\u306f\u307b\u3068\u3093\u3069\u5fd8\u308c\u53bb\u3089\u308c\u305f\u8a18\u61b6\u8853\u306e\u8d77\u6e90\u306f\u591a\u304f\u306e\u6b7b\u8005\u3092\u51fa\u3057\u305f\u4e8b\u6545\u306b\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u306f\u524d\u30ad\u30ea\u30b9\u30c85\u4e16\u7d00\u521d\u982d\u306b\u30c6\u30c3\u30b5\u30ea\u30a2\u3067\u767a\u751f\u3057\u305f\u3001\u5012\u58ca\u3059\u308b\u5bb6\u304c\u4e00\u56e3\u306e\u796d\u308a\u53c2\u52a0\u8005\u5168\u54e1\u3092\u62bc\u3057\u3064\u3076\u3057\u3001\u552f\u4e00\u751f\u304d\u6b8b\u3063\u305f\u8a69\u4eba\u30b7\u30e2\u30cb\u30c7\u30b9\u30fb\u30aa\u30d6\u30fb\u30b1\u30aa\u30b9\u304c\u8a13\u7df4\u3055\u308c\u305f\u8a18\u61b6\u529b\u6075\u307f\u3067\u5012\u58ca\u3057\u305f\u5efa\u7269\u306b\u7cbe\u795e\u7684\u306b\u518d\u5165\u5ba4\u3057\u3066\u5ba2\u305f\u3061\u306e\u5ea7\u5e2d\u914d\u7f6e\u3092\u601d\u3044\u8d77\u3053\u3059\u3053\u3068\u304c\u3067\u304d\u305f\u4e8b\u4ef6\u3067\u3059\u3002"}
{"translation": "\u305d\u3046\u3057\u3066\u7834\u7247\u5316\u3055\u308c\u8868\u60c5\u3084\u5f62\u8c61\u304c\u5909\u308f\u3063\u3066\u3057\u307e\u3063\u305f\u907a\u4f53\u304c\u78ba\u8a8d\u51fa\u6765\u307e\u3057\u305f\u3002"}
{"translation": "\u3053\u308c\u3089\u6570\u3048\u5207\u308c\u306a\u3044\u30d1\u30e9\u30c9\u30c3\u30af\u30b9 \u306e\u4e2d\u3067\u3082\u7279\u7b46\u3059\u3079\u304d\u3082\u3046\u4e00\u3064\u306f, \u6b7b\u3093\u3060\u8005\u304c\u4e8c\u5ea6\u3068\u623b\u3063\u3066\u3053\u306a\u3044\u3082\u306e\u3068\u3057\u3066\u540d\u6307\u3057\u3055 \u308c\u308b\u6642, \u5f7c/\u5f7c\u5973 \u306e\u5931\u8e2a\u3014\u6b7b\u3015 \u3092\u60bc\u3080\u6c17\u6301\u3061\u304c \u540c\u6642\u306b2\u500d\u306b\u5897\u3048 \u534a\u5206\u306b\u6e1b\u308a, \u5bfe\u7167\u7684\u306b\u884c\u65b9\u4e0d\u660e\u3042\u308b\u3044\u306f\u7d1b\u5931\u8005\u306e\u904b\u547d\u304c\u4e0d\u78ba\u5b9a\u306a\u307e\u307e\u306e\u5834\u5408\u3001\u95a2\u4fc2\u8005\u306f\u5e0c\u671b\u3068\u7d76\u671b\u306e\u9593\u3067\u8ff7\u3044\u3001\u30c8\u30e9\u30a6\u30de\u3092\u62b1\u304d\u3064\u3064\u751f\u6d3b\u3057\u7d9a\u3051\u632b\u6298\u3057\u7d9a\u3051\u308b\u3002"}
{"translation": "\u3053\u308c\u3089\u306f\u3072\u3068\u305f\u3073\u5931\u3046\u3053\u3068\u3092\u5f37\u76d7\u3055\u308c\u305f\u3082\u306e\u3067\u3042\u308a\u3001\u672a\u89e3\u6c7a\u307e\u305f\u306f\u7406\u89e3\u4e0d\u80fd\u306a\u8ab2\u984c\u3092\u901a\u3057\u3066\u6b21\u3005\u51fa\u3066\u304d\u307e\u3059\u3002"}
{"translation": "\u6b7b\u306e\u65ad\u7d76\u306f\u907a\u7523\u3068\u8a18\u61b6\u306e\u51fa\u767a\u70b9\u3067\u3042\u308a\u3001\u6b7b\u8005\u3078\u306e\u5606\u304d\u306f\u3059\u3079\u3066\u306e\u6587\u5316\u306e\u6e90\u6cc9\u3067\u3042\u308a\u3001\u305d\u308c\u306b\u3088\u3063\u3066\u7a81\u5982\u5e83\u304c\u308b\u7a7a\u865a\u3055\u3084\u7a81\u7136\u306e\u9759\u3051\u3055\u3092\u6b4c\u3084\u7948\u308a\u3084\u7269\u8a9e\u3067\u6e80\u305f\u3057\u3001\u6b20\u5982\u3057\u3066\u3044\u308b\u3082\u306e\u3092\u518d\u5ea6\u751f\u304d\u8fd4\u3089\u305b\u308b\u3002"}
{"translation": "\u5931\u3063\u305f\u3053\u3068\u306b\u5bfe\u3059\u308b\u4f53\u9a13\u304c\u3001\u5606\u304f\u3079\u304d\u3082\u306e\u304c\u3069\u3046\u3044\u3046\u3082\u306e\u304b\u3092\u8f2a\u90ed\u7684\u306b\u73fe\u51fa\u3055\u305b\u3001\u3053\u306e\u4f53\u9a13\u306f\u3057\u3070\u3057\u3070\u55aa\u4e2dion\uff1a<striestetation als ein Geore aegiere reritsches Jueden, snessesan diese merkenswerte Faszination erkl\u00e4ren, die von der Taschenbeuteln seitdem ausgeht\u3002\u3002\""}
{"translation": "\u6b7b\u3068\u3001\u305d\u308c\u306b\u4f34\u3046\u554f\u984c\u3001\u3059\u306a\u308f\u3061\u7a81\u7136\u4eba\u306e\u5b58\u5728\u304c\u6d88\u3048\u53bb\u308a\u4e00\u65b9\u3067\u907a\u54c1\u3001\u907a\u4f53\u304b\u3089\u4e3b\u306e\u306a\u3044\u6240\u6301\u54c1\u307e\u3067\u304c\u305d\u306e\u307e\u307e\u306b\u306a\u3063\u3066\u3057\u307e\u3046\u3053\u3068\u306b\u3069\u3046\u5bfe\u51e6\u3059\u308b\u304b\u3068\u3044\u3046\u554f\u984c\u306f\u3001\u6642\u4ee3\u3092\u7d4c\u308b\u3054\u3068\u306b\u89e3\u7b54\u3092\u6c42\u3081\u884c\u52d5\u3092\u62bc\u3057\u51fa\u3057\u7d9a\u3051\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u3053\u308c\u3089\u306e\u884c\u52d5\u306f\u7d14\u7c8b\u306a\u76ee\u7684\u3060\u3051\u3067\u306f\u306a\u304f\u610f\u5473\u3082\u6301\u3061\u307e\u3059\u3002"}
{"translation": "\u3053\u306e\u3053\u3068\u306f\u6211\u3005\u306e\u65e9\u671f\u306e\u7956\u5148\u3092\u52d5\u7269\u7684\u9818\u57df\u304b\u3089\u4eba\u9593\u7684\u9818\u57df\u3078\u9032\u3081\u308b\u3082\u306e\u3060\u3063\u305f\u4e8b\u306f\u9593\u9055\u3044\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u540c\u7a2e\u65cf\u8005\u305f\u3061\u306e\u6b7b\u4f53\u3092\u5358\u7d14\u306b\u81ea\u7136\u754c\u306b\u4efb\u305b\u3066\u5206\u89e3\u3055\u305b\u308b\u30d7\u30ed\u30bb\u30b9\u901a\u308a\u3067\u306f\u7121\u304f\u3055\u308c\u3066\u3044\u305f\u4e8b\uff08\u3064\u307e\u308a\u846c\u5f0f\uff09\u306f\u666e\u901a\u4eba\u9593\u7279\u6709\u3067\u3042\u308b\u3068\u8003\u3048\u3089\u308c\u307e\u3059\u304c\u3001\u540c\u69d8\u6027\u683c\u3065\u3051\u3055\u308c\u3046\u308b\u884c\u52d5\u5f62\u614b\u662f\u5426\u8a8d\u8b58\u51fa\u6765\u5f97\u308c\u308c\u3070\u9ad8\u5ea6\u751f\u7269\u3067\u3082\u898b\u53d7\u3051\u3089\u308c\u60c5\u5831\u5b9f\u5728\u3057\u307e\u3059\u3002"}
{"translation": "\u4f8b\u3048\u3070\u8c61\u65cf\u4ed6\u5011\u3069\u3082\u7078\u8f9b\u540c\u7a2e\u96c6\u56e3\u30e1\u30f3\u30d0\u30fc\u5468\u56f2\u96c6\u4f1a\u3059\u308b\u50be\u5411\u304c\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u5f7c\u7b49\u957f\u6642\u9593\u611f\u3058\u4e0a\u624b\u9577\u9f3b\u89e6\u6478\u3057\u54c0\u75db\u96c4\u606f\u5439\u304d\u63a7\u8a34\u3057\u306a\u304c\u3089\uff0c \u3057\u3070\u3057\u3070\u6a2a\u305f\u308f\u3063\u3066\u3044\u308b\u8eaf\u4f53\u518d\u6b21\u76f4\u7acb\u3055\u305b\u3088\u3046\u3068\u8a66\u307f\u307e\u3059\u3002"}
{"translation": "\u5f7c\u3089\u306f\u305d\u306e\u5f8c\u3067\u907a\u4f53\u306b\u571f\u3084\u679d\u3092\u8986\u3044\u307e\u3059\u3002"}
{"translation": "\u307e\u305f\u3001\u305d\u3046\u3057\u305f\u81e8\u7d42\u306e\u5834\u6240\u306f\u3001\u6570\u5e74\u5f8c\u3082\u5b9a\u671f\u7684\u306b\u8a2a\u308c\u3089\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u306b\u306f\u7591\u3044\u306a\u304f\u512a\u308c\u305f\u8a18\u61b6\u529b\u304c\u5fc5\u8981\u3067\u3042\u308a\u3001\u591a\u5206\u5411\u3053\u3046\u5cb8\u601d\u60f3\u3078\u306e\u4e00\u5b9a\u8a8d\u8b58\u304c\u5927\u5207\u76ca\u3005\u6211\u3005\u81ea\u8eab\u5984\u57df\u3067\u306f\u7406\u89e3\u3057\u96e3\u304f\u767d\u663c\u5922\u3068\u305d\u308c\u540c\u5fc3\u7121\u6cd5\u304b\u3069\u6728\u3055\u308c\u5f97\u308b\u4f55\u306a\u308a\u7a7a\u60f3\u5b9b\u304c\u77e5\u3063\u305f\u3042\u308d\u3093\u304b\u4e8b\u3060\u4e0e\u3092\u7f6e\u6253\u307e\u3057\u305f\u5922\u307f\u307e\u3057\u3087\u3046"}
{"translation": "\u79c1\u304c\u3053\u306e\u672c\u306e\u57f7\u7b46\u3092\u307b\u307c\u7d42\u3048\u3066\u3001\u5206\u89e3\u3084\u7834\u58ca\u306e\u591a\u69d8\u306a\u73fe\u8c61\u304c\u91cd\u8981\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u521d\u3081\u3066\u8a8d\u8b58\u3059\u308b\u3068\u304d\u3001\u6b7b\u3068\u5bfe\u5cd9\u3059\u308b\u7121\u6570\u306e\u65b9\u6cd5\u306e\u4e00\u3064\u3067\u3057\u304b\u306a\u3044\u3053\u3068\u306b\u6c17\u4ed8\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u57fa\u672c\u7684\u306b\u30d8\u30ed\u30c9\u30c8\u30b9\u304c\u8a3c\u8a00\u3057\u305f\u30ab\u30e9\u30c6\u30a3\u30a2\u4eba\u306e\u98a8\u7fd2\u3001\u3064\u307e\u308a\u5f7c\u3089\u306f\u4ea1\u304f\u306a\u3063\u305f\u89aa\u3092\u98df\u3079\u308b\u3053\u3068\u3092\u5e38\u3059\u3057\u3001\u81ea\u5206\u305f\u3061\u304c\u706b\u846c\u3059\u308b\u30ae\u30ea\u30b7\u30e3\u4eba\u306e\u98a8\u7fd2\u3092\u805e\u3044\u3066\u6050\u6016\u3057\u305f\u3001\u305d\u306e\u3088\u3046\u306a\u884c\u52d5\u3088\u308a\u3082\u4e0d\u5668\u7528\u3067\u3042\u308b\u304b\u307e\u305f\u306f\u6291\u5236\u529b\u306b\u5bcc\u3093\u3067\u3044\u308b\u308f\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u4f55\u6545\u3060\u3063\u3066\u305d\u306e\u4eba\u304c\u81ea\u5df1\u6b7b\u5316\u6027\u3092\u7d76\u3048\u305a\u610f\u8b58\u3057\u3066\u751f\u6d3b\u306b\u8fd1\u3044\u5b58\u5728\u304b\u3001\u3042\u308b\u610f\u5473\u305d\u308c\u304c\u6210\u529f\u3057\u3066\u6b7b\u4ea1\u9664\u5916\u8005\u304b\u3069\u3046\u304b\u3002"}
{"translation": "\u5168\u3066\u304c\u7d42\u308f\u3063\u3066\u3057\u307e\u3046\u60f3\u50cf\u529b\u306f\u6050\u308d\u3057\u304f\u611f\u3058\u3089\u308c\u307e\u3059\u3057\u3001\u9006\u306b\u7d42\u308f\u308a\u304c\u898b\u3048\u306a\u3044\u4e8b\u8c61\u3082\u307e\u305f\u540c\u69d8\u3067\u3059\u3002"}
{"translation": "\u3082\u3061\u308d\u3093\u3001\u305d\u306e\u524d\u306b\u3082\u4ed6\u306e\u6ce8\u76ee\u3059\u3079\u304d\u5893\u5730\u3092\u8a2a\u308c\u305f\u3053\u3068\u304c\u3042\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u4f8b\u3048\u3070\u3001\u30f4\u30a7\u30cd\u30c4\u30a3\u30a2\u306e\u30e9\u30b0\u30fc\u30f3\u306e\u9752\u7dd1\u8272\u306e\u6c34\u304b\u3089\u9ad8\u3044\u8d64\u30ec\u30f3\u30ac\u58c1\u3067\u53f0\u5730\u3068\u306a\u3063\u305f\u30b5\u30f3\u30fb\u30df\u30b1\u30fc\u30ec\u5cf6\u3084\u3001\u6bce\u5e74\u30e1\u30ad\u30b7\u30b3\u4eba\u4f4f\u6c11\u306b\u3088\u3063\u3066\u795d\u308f\u308c\u308b\u30c7\u30a3\u30a2\u30fb\u30c7\u30fb\u30ed\u30b9\u30fb\u30e0\u30a8\u30eb\u30c8\u30b9\uff08\u6b7b\u8005\u306e\u65e5\uff09\u306b\u306f\u3001\u30aa\u30ec\u30f3\u30b8-\u9ec4\u8272\u3067\u98fe\u3089\u308c\u305f\u5893\u3084\u3001\u9032\u884c\u3057\u305f\u8150\u6557\u3067\u6c38\u9060\u306b\u7b11\u9854\u3092\u7d76\u3084\u3055\u306a\u3044\u7802\u7cd6\u83d3\u5b50\u3068\u30d1\u30d4\u30a8\u30de\u30b7\u30a7\u88fd\u306e\u30c9\u30af\u30ed\u304c\u6ea2\u308c\u3066\u3044\u308b\u30cf\u30ea\u30a6\u30c3\u30c9\u30fb\u30d5\u30a9\u30fc\u30a8\u30d0\u30fc\u5893\u5730\u3067\u306e\u7729\u3057\u3044\u5e02\u5834\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u6f01\u5e2b\u753a\u306e\u305d\u306e\u5893\u5730\u307b\u3069\u79c1\u3092\u6253\u3064\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "\u305d\u3053\u3067\u306f\u7279\u7570\u306a\u5f62\u72b6\u2015\u4e38\u307f\u3092\u304a\u3073\u305f\u56db\u89d2\u5f62\u3068\u540c\u69d8\u2015\u751f\u524d\u304b\u3089\u6b7b\u8005\u3092\u4e2d\u5fc3\u306b\u636e\u3048\u308b\u4e00\u7a2e\u5909\u308f\u3063\u305f\u98a8\u666f\u5f0f\uff1c\u672a\u6765\u90fd\u5e02\uff1e\u304c\u5b9f\u73fe\u3057\u3000\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u9577\u3044\u9593\u79c1\u306f\u3053\u306e\u5834\u6240\u3001\u30c7\u30f3\u30de\u30fc\u30af\u8a9e\u3067\u306f\u300c\u5c0f\u3055\u306a\u5cf6\u300d\u307e\u305f\u306f\u300c\u6d77\u6c34\u306b\u56f2\u307e\u308c\u3066\u300d\u3068\u3044\u3046\u610f\u5473\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u304c \u5f7c\u3089\u4f4f\u6c11\u9332\u3089\u306e\u5e38\u306b\u4e2d\u5fc3\u306b\u6b7b\u8005\u3092\u7f6e\u304f\u4f4f\u304d\u65b9\u306f\u3001 \u4f8b\u306e\u3054\u3068\u304f\u3001\u516c\u5893\u5730\u3092\u90fd\u5e02\u7a7a\u9593\u304b\u3089\u6392\u9664\u3057\u3088\u3046--\u3068\u3059\u308b\u6211\u3089\u5e83\u5927\u306a\u5730\u57df\u306e\u4f1d\u7d71\u7684\u306a\u89b3\u5ff5\u6311\u6226\u3057\u7d9a\u3051\u3066\u3044\u308b\u3053\u3068\u3078\u5b9f\u611f\u307e\u3057\u305f\u3002"}
{"translation": "\u3082\u3061\u308d\u3093\u90fd\u5e02\u7a7a\u9593\u304c\u30ed\u5897\u6b96\u3059\u308b\u3053\u3068\u3067\u518d\u5ea6\u5893\u6a19\u3092\u5451\u307f\u8fbc\u3093\u3067\u3057\u307e\u3046\u5fc3\u7121\u3044\u73fe\u5b9f\u3067\u3055\u3048\u3082\u5b58\u5728\u3057\u307e\u3059\u3002"}
{"translation": "\u6570\u5e74\u524d\u306e8\u6708\u306e\u3042\u308b\u65e5\u3001\u79c1\u306f\u5317\u65b9\u306e\u90fd\u5e02\u3092\u8a2a\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u3001\u6c37\u6cb3\u671f\u306b\u8d77\u304d\u305f\u904e\u53bb\u306e\u6d78\u98df\u306b\u3088\u308a\u6df1\u304f\u9678\u5730\u3078\u3068\u9032\u5165\u3057\u305f\u6d77\u6e7e\u306e\u6700\u5f8c\u4f59\u5206\u306a\u90e8\u5206\u306b\u4f4d\u7f6e\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u3053\u3067\u306f\u6625\u306b\u30cb\u30b7\u30f3\u3001\u590f\u306b\u30a6\u30ca\u30ae\u3001\u79cb\u306b\u30bf\u30e9\u3001\u51ac\u306b\u30b3\u30a4\u3084\u30d1\u30a4\u30af\u3084\u30d6\u30ea\u30fc\u30e0\u304c\u898b\u3064\u304b\u308a\u307e\u3059\u3002"}
{"translation": "\u3067\u3059\u304b\u3089\u4eca\u307e\u3067\u305a\u3063\u3068\u6f01\u696d\u304c\u884c\u308f\u308c\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u3053\u308c\u3089\u306e\u7537\u6027\u305f\u3061\u306f\u5bb6\u65cf\u3068\u5171\u306b\u4f55\u4e16\u7d00\u3082\u524d\u304b\u3089\u7d75\u753b\u7684\u3068\u3057\u304b\u8a00\u3044\u8868\u305b\u306a\u3044\u30a8\u30ea\u30a2\u3092\u4f4f\u307e\u3044\u3068\u3057\u7d9a\u3051\u3066\u304a\u308a\u3001\u305d\u308c\u306f\u77f3\u7573\u4e8c\u672c\u9053\u7a0b\u5ea6\u3068\u30cd\u30c3\u30c8\u4e7e\u71e5\u30b9\u30da\u30fc\u30b9\u53ca\u3073\u53e4\u8001\u8cb4\u5a66\u4eba\u4e8c\u4eba\u3060\u3051\u6319\u3063\u3066\u4f4f\u3093\u3067\u5c45\u308b\u4fee\u9053\u9662\u533a\u753b\u3057\u304b\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u8981\u3059\u308b\u5927\u5207\u76e1\u304f\u30ed\u30de\u30f3\u7684\u306a\u904e\u53bb\u304c\u751f\u5b58\u3057\u3066\u308b\u69d8\u8aac\u660e\u3055\u308c\u6613\u304f\u9b45\u60d1\u5fc3\u80c6\u304b\u3059\u3081\u3055\u308c\u307e\u3059\u304c\u5b9f\u5728\u7a7a\u9593\u3067\u6642\u9593\u7acb\u3061\u6b62\u3063\u305f\u6240\u70b9\u3067\u3059\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002"}
{"translation": "\u3057\u304b\u3057\u79c1\u304c\u7279\u5225\u899a\u3048\u3066\u5c45\u308b\u4e8b\u7269\u306f\u767d\u52a0\u5de5\u7389\u9752\u4f4e\u5bb6\u6a2a\u6e80\u958b\u8594\u8587\u68d8\u3084\u9ad8\u830e\u30e2\u30a6\u30b9\u30ad\u30e8\u30e1\u30d0\u30ca, \u5f69\u8272\u6728\u88fd\u6249\u53ca\u3073\u5927\u4f53\u306f\u77f3\u982d\u6d77\u5cb8\u306b\u76f4\u63a5\u9023\u3058\u3066\u5c45\u308b\u5efa\u7269\u9593\u72ed\u901a\u8def\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u306a\u3089199\u7279\u5225\u899a\u3048\u3066\u5c45\u308b\u4e8b\u7269\u306f\u753a\u4e2d\u5fc3\u5730\u5e02\u5834\u4ee3\u308f\u308a\u6211\u304c\u773c\u524d\u8d8a\u4e0a\u639b\u3051\u305f\u306e\u304c\u5893\u5730\u3067\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u590f\u7dd1\u9ec4\u6ae8\u906e\u5149\u3055\u308c\u3001\u935b\u9244\u56f2\u3044\u53d6\u3089\u308c\u3066\u307e\u3059\u3002"}
{"translation": "\u3060\u304b\u3089\u666e\u901a\u5546\u54c1\u8ca8\u5e63\u4ea4\u6d41\u64cd\u884c\u3059\u308b\u5834\u6240\u306b\u4ea1\u9ab8\u57cb\u8535\u3057\u3066\u4f59\u7a0b\u898b\u305b\u3057\u3081\u7684\u9858\u671b\u4fe1\u5ff5\u79f0\u3086\u308b\"\u5b89\u606f\"\u3092\u53d6\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u6700\u521d\u306b\u4e0d\u6109\u5feb\u611f\u3068\u601d\u308f\u308c\u9a5a\u304d\u3055\u521d\u3081\u5927\u304d\u304b\u3063\u305f\u3067\u662f\u3005\u5897\u3059\u3082\u540c\u985e\u4e0b\u7740\u4e00\u7537\u6027\u30ad\u30c4\u30c1\u30f3\u5165\u5c45\u592b\u4eba\u5bb6\u53c2\u8003\u63d0\u5531\u529b\u3042\u308a\u30b3\u30b9\u30c8\u30d9\u30cd\u30d5\u30a3\u30c3\u30c8\u4f9d\u7136\u98f2\u307f\u8fbc\u307f\u307e\u3057\u305f\u3002"}
{"translation": "\u5373\u3061\u5f7c\u5973\u5e38\u304f\u81ea\u5206\u65e9\u6b7b\u306c\u606f\u5b50\u5893\u4f4d\u7f6e\u78ba\u8a8d\u53ef\u80fd\u3002"}
{"translation": "\u307e\u305f\u66f4\u306a\u308b\u5b66\u82b8\u8a18\u8005\u53ea\u4eca\u8a03\u5831\u5100\u5f0f\u8cac\u4efb\u62c5\u5f53\u6b7b\u8870\u8005\u6765\u4e34\u30ea\u30fc\u30c9\u5343\u5e74\u4f1d\u7d71\u3086\u9996\u5c3e\u5947\u7279\u767a\u751f\u5f15\u51fa\u3057\u307e\u3057\u305f: \u7cfb\u5148\u7956\u4ee5\u6765\u65e2\u6b7b\u53ca\u73fe\u5728\u751f\u5b58\u5bb6\u65cf\u51e6\u3068\u3053\u308d\u307e\u3067\u3082\u4e00\u81f4\u3055\u305b\u6709\u540d\u4eba\u4f55\u51e6\u5730\u65b9\u90e8\u4f4f\u6bd4\u88fd\u4f8b\uff1a\u5e7e\u8a31\u592a\u5e73\u6d0b\u5cf6\u5074\u5c45\u6c11\u6240\u3002"}
