{"translation": "\u300c\u305d\u3044\u3064\u306f\u3082\u3046\u3042\u306e\u5834\u6240\u304b\u3089\u51fa\u3066\u3053\u308c\u306a\u3044\u3063\u3066\u3001\u8a00\u3063\u3066\u308b\u3093\u3060\u3088\u300d"}
{"translation": "\u3068\u306b\u304d\u3073\u9762\u304c\u78ba\u4fe1\u305f\u3063\u3077\u308a\u306b\u9837\u304d\u306a\u304c\u3089\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u3082\u3046\u4e00\u6642\u959315\u5206\u3082\u305d\u3053\u306b\u5165\u308a\u8fbc\u3093\u3067\u308b\u3002"}
{"translation": "\u7d42\u308f\u308a\u3060\u308d\u3046\u306d\u300d\u3002"}
{"translation": "\u5e02\u6c11\u305f\u3061\u306f\u3001\u5ec3\u589f\u306e\u4e2d\u3067\u5bc6\u96c6\u3057\u3001\u9ed9\u3005\u3068\u74e6\u792b\u306e\u7a74\u3092\u898b\u3064\u3081\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5730\u4e0b\u9053\u306e\u5165\u53e3\u306f\u57cb\u307e\u3063\u3066\u3057\u307e\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u9ec4\u8272\u3044\u30b3\u30fc\u30c8\u3092\u7740\u305f\u592a\u3063\u3061\u3087\u7537\u6027\u304c\u8db3\u3092\u7d44\u307f\u66ff\u3048\u3001\u5589\u3092\u30af\u30ea\u30a2\u3057\u3066\u304b\u3089\u6f70\u308c\u3066\u3057\u307e\u3063\u305f\u30d9\u30ec\u30fc\u5e3d\u3092\u982d\u304b\u3089\u53d6\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u3082\u3046\u5c11\u3057\u5f85\u3068\u3046\u300d\u5f7c\u306f\u3001\u76ba\u306e\u591a\u3044\u7709\u9593\u304b\u3089\u6c57\u3092\u62ed\u304d\u306a\u304c\u3089\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u4f55\u3092\u5f85\u3064\u3093\u3060\uff1f\u300d\u306b\u304d\u3073\u9854\u304c\u3075\u304d\u3060\u3057\u305f\u3002"}
{"translation": "\u300c\u5730\u4e0b\u7262\u306b\u306f\u30d0\u30b8\u30ea\u30b9\u30af\u304c\u3044\u308b\u3001\u305d\u308c\u3092\u5fd8\u308c\u305f\u304b\u4ee3\u5b98\uff1f\u300d"}
{"translation": "\u8ab0\u3067\u3082\u884c\u3051\u3070\u4e8c\u5ea6\u3068\u623b\u3063\u3066\u3053\u306a\u3044\u3002"}
{"translation": "\u4f55\u4eba\u3082\u306e\u4eba\u3005\u304c\u305d\u3053\u3067\u4ea1\u304f\u306a\u3063\u305f\u3060\u308d\u3046\uff1f"}
{"translation": "\u3055\u3042\u6b21\u306b\u4f55\u3092\u5f85\u3064\u3093\u3060\uff1f"}
{"translation": "\u7d04\u675f\u3057\u305f\u3067\u3057\u3087\u300d\u3068\u4e0d\u5b89\u3052\u306b\u592a\u3063\u305f\u7537\u6027\u304c\u545f\u3044\u305f\u3002"}
{"translation": "\u300c\u3069\u3046\u3044\u3046\u308f\u3051\u3060\uff1f \u751f\u8005\u3068\u7d04\u675f\u3057\u305f\u3088\u306d\u3002"}
{"translation": "\u53cb\u9054\u306f\u808c\u8352\u308c\u9854\u3001\u5de8\u5927\u306a\u30ec\u30b6\u30fc\u30a8\u30d7\u30ed\u30f3\u3092\u8eab\u306b\u7740\u3051\u3066\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u4eca\u3084\u5f7c\u306f\u6b7b\u3093\u3067\u3044\u307e\u3059\u3001\u305d\u308c\u306f\u5929\u7a7a\u306e\u592a\u967d\u4e26\u307f\u306e\u78ba\u4fe1\u3067\u3059\u3002"}
{"translation": "\u5f7c\u304c\u6ec5\u4ea1\u3057\u3066\u308b\u3068\u6700\u521d\u304b\u3089\u5206\u304b\u3063\u3066\u307e\u3057\u305f\u3057\u3001\u4ee5\u524d\u306e\u4eba\u3005\u3082\u540c\u69d8\u3067\u3059\u3002"}
{"translation": "\u3061\u3083\u3093\u3068\u93e1\u7121\u3057\u3067\u3082\u547d\u4ee4\u3055\u308c\u307e\u3057\u305f\u3088\u306d\u3002"}
{"translation": "\u305f\u3060\u5263\u3057\u304b\u6301\u3063\u3066\u307e\u305b\u3093\u3067\u3057\u305f\u3088\u306d\u3002\u3057\u304b\u3057\u8ab0\u3067\u3082\u77e5\u3063\u3066\u308b\u3058\u3083\u306a\u3044\u304b\u30d0\u30b8\u30ea\u30b9\u30af\u3092\u6bba\u3059\u70ba\u306b\u5fc5\u8981\u306a\u93e1\u7121\u3057\u3060\u3081\u3058\u3083\u3042\u308a\u307e\u305b\u3093\u304b\u300d"}
{"translation": "\u300c\u304a\u524d\u305f\u3061\u306f\u4e00\u92ad\u3082\u6d6e\u304b\u305b\u305f\u306a\u3001\u3068\u306b\u304d\u3073\u9762\u306e\u5e02\u9577\u304c\u4ed8\u3051\u52a0\u3048\u305f\u3002"}
{"translation": "\u3060\u3063\u3066\u3001\u30d0\u30b8\u30ea\u30b9\u30af\u306b\u652f\u6255\u3046\u4eba\u9593\u306a\u3069\u3044\u306a\u3044\u304b\u3089\u3055\u3002"}
{"translation": "\u3060\u304b\u3089\u7686\u3001\u5b89\u5fc3\u3057\u3066\u5bb6\u306b\u5e30\u308c\u3002"}
{"translation": "\u9b54\u6cd5\u4f7f\u3044\u306e\u99ac\u3068\u725b\u306f\u79c1\u9054\u304c\u5f15\u304d\u53d6\u308b\u3088\u3001\u305b\u3063\u304b\u304f\u306e\u8ca1\u7523\u3092\u7121\u99c4\u306b\u3059\u308b\u308f\u3051\u306b\u306f\u3044\u304b\u306a\u3044\u304b\u3089\u306d\u3002"}
{"translation": "\u305d\u306e\u901a\u308a\u3060\u3068\u8089\u5c4b\u304c\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u5065\u5eb7\u306a\u99ac\u3067\u3042\u308a\u3001\u98df\u6599\u3082\u5341\u5206\u8a70\u307e\u3063\u3066\u308b\u3057\u3002"}
{"translation": "\u4e2d\u8eab\u3092\u898b\u3066\u307f\u3088\u3046\u3058\u3083\u306a\u3002"}
{"translation": "\u4f55\uff1f\u4f55\u3063\u3066\u8a00\u3046\u3093\u3060\uff1f"}
{"translation": "\u9ed9\u308c\u5e02\u9577\u3081\uff01\u9996\u3092\u7a81\u3063\u8fbc\u3080\u3093\u3058\u3083\u3042\u308a\u307e\u305b\u3093\uff01\u304a\u5c3b\u3064\u306d\u3089\u308c\u3061\u307e\u3044\u307e\u3059\u3088\uff01\u300d\u3068\u3044\u3046\u9854\u9762\u30cb\u30ad\u30d3\u306e\u8b66\u544a\u3002"}
{"translation": "\u300c\u5065\u5eb7\u305d\u3046\u3060\u300d\u8089\u5c4b\u306f\u518d\u5ea6\u7e70\u308a\u8fd4\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u201d\u305d\u306e\u99ac\u3092\u843d\u3061\u7740\u304b\u305b\u3066\u3061\u3087\u3046\u3060\u3055\u3044\u3055\u3044\"\u8089\u5c4b\u306f\u58c1\u306e\u7a81\u7aef\u304b\u3089\u51fa\u3066\u304d\u305f\u4ed6\u6240\u304b\u3089\u6765\u305f\u7537\u6027\u304c\u5468\u56f2\u306e\u4eba\u3005\u304b\u3089\u80cc\u5f8c\u758e\u3089\u7acb\u6d3e\u55b6\u696d(\u5c71\u57ce)\u5165\u308a\u53e3\u3057\u3066\u8a9e\u308a\u639b\u3051\u307e\u3057\u305f\u3002\u201d"}
{"translation": "\u305d\u306e\u7570\u4eba\u306f\u3001\u5dfb\u304d\u6bdb\u306e\u6fc3\u3044\u6817\u8272\u306e\u9aea\u3001\u8336\u8272\u306e\u30c1\u30e5\u30cb\u30c3\u30af\u3092\u8a70\u3081\u7269\u306e\u30ab\u30d5\u30bf\u30f3\u306b\u7740\u3066\u3001\u9ad8\u3044\u99ac\u4e57\u308a\u306e\u30d6\u30fc\u30c4\u3092\u5c65\u3044\u3066\u3044\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u6b66\u5668\u306f\u6301\u3063\u3066\u3044\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u300c\u99ac\u304b\u3089\u96e2\u308c\u308d\u300d\u3068\u5f7c\u304c\u518d\u3073\u8a00\u3063\u305f\u3002"}
{"translation": "\u305d\u306e\u307e\u307e\u967a\u3057\u3044\u7b11\u307f\u3092\u6d6e\u304b\u3079\u305f\u3002"}
{"translation": "\u300c\u3069\u3046\u3044\u3046\u3053\u3068\u3060\uff1f\u4ed6\u4eba\u306e\u99ac\u3001\u4ed6\u4eba\u306e\u8377\u7269\u3001\u4ed6\u4eba\u306e\u6240\u6709\u7269\u3067\u3042\u308b\u304c\u541b\u304c\u541b\u81ea\u8eab\u306b\u5bfe\u3057\u3066\u6b32\u671b\u3092\u62b1\u304f\u3060\u308d\u3046\u304b\uff1f"}
{"translation": "\u305d\u308c\u306f\u8a31\u3055\u308c\u308b\u884c\u70ba\u306a\u3093\u3060\uff1f\u300d"}
{"translation": "\u9762\u76b0\u3067\u8986\u308f\u308c\u306a\u304c\u3089\u3082\u5f7c\u304b\u3089\u76ee\u3092\u96e2\u305b\u305a\u306b\u6050\u6016\u5fc3\u3067\u7a81\u3063\u8fbc\u3080\u624b\u3092\u30b3\u30fc\u30c8\u30ae\u30a2\u30fc\u30b9(A traditional coat from Poland)"}
{"translation": "\u4e0b\u306b\u3064\u3081\u8fbc\u307f\u305d\u3053\u304b\u3089\u8089\u5c4b(Butcher refers to enemies in this context) \u3092\u898b\u8a70\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u8089\u5c4b\u306f\u9837\u304d\u3001\u30b0\u30eb\u30fc\u30d7\u5074\u3078\u5408\u56f3\u3057\u305f\u3002"}
{"translation": "\u305d\u3053\u304b\u3089\u3055\u3089\u306b\u4e8c\u4eba, \u5c48\u5f37\u306a\u304a\u3068\u3068\u8fd1\u63a5\u3057\u305f\u7537\u6027\u304c\u73fe\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u4e21\u65b9\u3068\u3082\u7363\u6bba\u3057\u7528\u30d0\u30c8\u30f3/\u6bba\u5bb3\u68cd\u68d2\uff08like the ones used in ranch/butcher ) \u3092\u6301\u3063\u3066\u3044\u307e\u3057\u305f"}
{"translation": "\u300c\u304a\u524d\u3089\u4e00\u4f53\u4f55\u8005\u3060\uff1f\u300d"}
{"translation": "\u306b\u304d\u3073\u9762\u304c\u3001\u814b\u306e\u4e0b\u304b\u3089\u624b\u3092\u51fa\u3059\u3053\u3068\u306a\u304f\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u6b63\u5f53\u3067\u3042\u308b\u304b\u5426\u304b\u3092\u79c1\u305f\u3061\u306b\u6559\u3048\u3066\u304f\u308c\u308b\u3064\u3082\u308a\u304b\uff1f\u541b\u306b\u306f\u3053\u3068\u3055\u3089\u95a2\u4fc2\u306a\u3044\u3001\u7f8e\u4eba\u3055\u3093\u3002"}
{"translation": "\u6b66\u5668\u306f\u6240\u6301\u3057\u3066\u307e\u305b\u3093\u3088\u306d\uff1f\u300d"}
{"translation": "\u305d\u306e\u4e8b\u5b9f\u3092\u805e\u3044\u3066\u898b\u77e5\u3089\u306c\u7537\u306f\u76ae\u8089\u6c17\u5473\u306b\u66f4\u306b\u5e83\u304f\u7b11\u3063\u305f\u3002"}
{"translation": "\u300c\u79c1\u306f\u6301\u3063\u3066\u307e\u305b\u3093\u300d"}
{"translation": "\u3053\u308c\u304c\u60aa\u3044\u3002"}
{"translation": "\u30cb\u30ad\u30d3\u9762\u304c\u814b\u306e\u4e0b\u304b\u3089\u624b\u3092\u5f15\u304d\u629c\u304d\u3001\u305d\u308c\u3068\u4e00\u7dd2\u306b\u9577\u3044\u30ca\u30a4\u30d5\u3082\u51fa\u3057\u305f\u3002"}
{"translation": "\u300c\u6b66\u5668\u3092\u6301\u3063\u3066\u306a\u3044\u3068\u3044\u3046\u306e\u306f\u5927\u5909\u60aa\u3044\u3053\u3068\u3067\u3059\u3088\u3002"}
{"translation": "\u300d\u5c60\u6bba\u8005\u3082\u5263\u4e01\u307f\u305f\u3044\u306a\u9577\u3055\u306e\u30ca\u30a4\u30d5\u3092\u53d6\u308a\u51fa\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u6b8b\u308a\u4e8c\u4eba\u3082\u524d\u9032\u3057\u3066\u68d2\u58f0\u3092\u632f\u308a\u4e0a\u3052\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u79c1\u306f\u6240\u6301\u3059\u308b\u5fc5\u8981\u3042\u308a\u307e\u305b\u3093\u300d\u3068\u898b\u77e5\u3089\u306c\u7537\u306f\u8a00\u3063\u305f\u3001\u305d\u306e\u5834\u304b\u3089\u4e00\u6b69\u3082\u52d5\u304b\u305a\u3001\u300c\u79c1\u306e\u6b66\u5668\u304c\u81ea\u52d5\u7684\u306b\u5f8c\u308d\u3067\u50cd\u3044\u307e\u3059\u300d"}
{"translation": "\u5ec3\u589f\u304b\u3089\u3001\u3084\u308f\u3089\u304b\u304f\u78ba\u5b9f\u306a\u4e00\u6b69\u3067\u6b69\u307f\u51fa\u305f2\u4eba\u306e\u82e5\u3044\u5973\u6027\u3002"}
{"translation": "\u7fa4\u96c6\u306f\u3059\u3050\u306b\u5206\u6563\u3057\u3001\u5f8c\u9000\u3057\u3001\u5e0c\u8584\u5316\u3057\u305f\u3002"}
{"translation": "\u4e21\u65b9\u306e\u5973\u6027\u306f\u7b11\u9854\u3092\u6d6e\u304b\u3079\u3066\u304a\u308a\u3001\u6b6f\u3092\u898b\u305b\u3066\u77ac\u304d\u3057\u3001\u305d\u3053\u304b\u3089\u8033\u307e\u3067\u5e83\u304c\u308b\u5e45\u5e83\u3044\u9752\u7d2b\u8272\u306e\u30bf\u30c8\u30a5\u30fc\u306e\u7b4b\u304c\u8d70\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u98db\u3073\u51fa\u3057\u305f\u817f\u90e8\u304b\u3089\u898b\u3048\u305f\u5f37\u70c8\u306a\u7b4b\u8089\u904a\u622f\u306f\u76ae\u3067\u8986\u308f\u308c\u3066\u304a\u308a\u3001\u9811\u4e08\u306a\u68d8\u72b6\u30cd\u30c3\u30c8\u4ed8\u304d\u30b0\u30ed\u30fc\u30d6\u4e0a\u90e8\u306e\u88f8\u306e\u4e38\u3044\u8155\u306b\u3082\u540c\u69d8\u3002"}
{"translation": "\u80a9\u7532\u9aa8\u3082\u30c1\u30a7\u30a4\u30f3\u30e1\u30fc\u30eb\u3067\u8986\u308f\u308c\u3066\u304a\u308a\u3001\u305d\u306e\u4e0a\u306b\u30b5\u30fc\u30d9\u30eb\u67c4\u304c\u7a81\u304d\u51fa\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u306b\u304d\u3073\u9762\u306e\u5c11\u5e74\u306f\u3086\u3063\u304f\u308a\u3068\u819d\u3092\u66f2\u3052\u3001\u5730\u9762\u306b\u30ca\u30a4\u30d5\u3092\u843d\u3068\u3057\u305f\u3002"}
{"translation": "\u74e6\u792b\u306e\u7a74\u304b\u3089\u3001\u77f3\u304c\u30ac\u30bf\u30ac\u30bf\u3068\u843d\u3061\u308b\u97f3\u3001\u3056\u308f\u3081\u304d\u304c\u805e\u3053\u3048\u3066\u304d\u305f\u3002"}
{"translation": "\u305d\u306e\u5f8c\u3001\u6697\u95c7\u304b\u3089\u58c1\u306e\u6b20\u3051\u305f\u7aef\u306b\u63b4\u307e\u3063\u305f\u624b\u304c\u59ff\u3092\u73fe\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u624b\u306b\u7d9a\u3044\u3066\u3001\u30ec\u30f3\u30ac\u306e\u7c89\u3067\u767d\u304f\u306a\u3063\u305f\u9aea\u306e\u982d\u90e8\u3001\u9752\u767d\u3044\u9854\u3001\u80a9\u4e0a\u307e\u3067\u9732\u51fa\u3057\u305f\u5263\u67c4\u304c\u6b21\u3005\u306b\u73fe\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u7fa4\u96c6\u304b\u3089\u3056\u308f\u3064\u304d\u58f0\u304c\u3042\u304c\u3063\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u8001\u4eba\u304c\u66f2\u304c\u3063\u305f\u80cc\u4e2d\u3067\u3001\u8840\u67d3\u3081\u306e\u5875\u3067\u3076\u304f\u3076\u304f\u306b\u3057\u3063\u304b\u308a\u5305\u307e\u308c\u305f\u5947\u602a\u306a\u5f62\u72b6\u3001\u7570\u69d8\u306a\u4f53\u5f62\u3092\u7a74\u304b\u3089\u5f15\u304d\u305a\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u8001\u4eba\u306f\u305d\u306e\u602a\u7269\u3092\u9577\u3044\u3001\u30c8\u30ab\u30b2\u306e\u3088\u3046\u306a\u5c3e\u3067\u63b4\u307f\u3001\u4f55\u3082\u8a00\u308f\u305a\u306b\u592a\u3063\u305f\u6751\u9577\u306e\u8db3\u5143\u306b\u6295\u3052\u6368\u3066\u305f\u3002"}
{"translation": "\u6751\u9577\u306f\u8df3\u306d\u9000\u304d\u3001\u5012\u308c\u3066\u3044\u308b\u58c1\u306e\u4e00\u90e8\u5206\u306b\u8db3\u3092\u53d6\u3089\u308c\u3064\u307e\u3065\u3044\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u6e7e\u66f2\u3057\u305f\u9ce5\u306e\u5634\u3001\u819c\u8cea\u306e\u7ffc\u3068\u6e7e\u66f2\u3057\u305f\u722a\u304c\u4ed8\u3044\u3066\u3044\u308b\u9c57\u3067\u8986\u308f\u308c\u305f\u8db3\u3092\u898b\u3064\u3081\u308b\u3002"}
{"translation": "\u4e00\u5ea6\u306f\u771f\u7d05\u3060\u3063\u305f\u3082\u306e\u306e\u4eca\u3067\u306f\u6c5a\u3089\u3057\u3044\u8d64\u8272\u306b\u5909\u308f\u3063\u3066\u3057\u307e\u3063\u305f\u80a5\u5927\u5316\u3057\u305f\u5589\u4ecf\u3092\u898b\u3064\u3081\u308b\u3002"}
{"translation": "\u305d\u3057\u3066\u5149\u6ca2\u6027\u304c\u3042\u308a\u843d\u3061\u8fbc\u3093\u3060\u76ee\u3092\u898b\u8a70\u3081\u308b\u3002"}
{"translation": "\u300c\u3053\u3053\u306b\u30d0\u30b8\u30ea\u30b9\u30af\u304c\u3044\u308b\u300d\u3068\u767d\u9aea\u306e\u7537\u306f\u8a00\u3044\u3001\u30ba\u30dc\u30f3\u304b\u3089\u5875\u3092\u6255\u3063\u305f\u3002"}
{"translation": "\u300c\u5951\u7d04\u901a\u308a\u3060\u3002"}
{"translation": "\u3082\u3057\u3088\u3051\u308c\u3070\u3001\u79c1\u306e200\u30ea\u30f3\u30bf\u30fc\u30eb\u3092\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u305d\u3046\u3001\u771f\u5263\u306a\u30ea\u30f3\u30bf\u30fc\u30eb\u3067\u3001\u3042\u307e\u308a\u50b7\u3064\u3044\u3066\u306a\u3051\u308c\u3070\u306d\u3002"}
{"translation": "\u4e8b\u524d\u306b\u78ba\u8a8d\u3059\u308b\u305e\u3068\u3044\u3046\u610f\u5473\u3060\u3088\u300d"}
{"translation": "\u5f79\u5834\u9577\u306f\u9707\u3048\u308b\u624b\u3067\u5c0f\u888b\u3092\u53d6\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u304c\u632f\u308a\u8fd4\u3063\u3066\u898b\u6e21\u3057\u305f\u3057\u3001\u4e00\u77ac\u8db3\u5143\u306e\u30ca\u30a4\u30d5\u306b\u76ee\u304c\u7559\u307e\u3063\u305f\u3002"}
{"translation": "\u9854\u306b\u30cb\u30ad\u30d3\u3092\u6301\u3064\u8005\u3084\u8336\u8272\u306e\u30c1\u30e5\u30cb\u30c3\u30af\u3092\u7740\u305f\u7537\u3084\u30df\u30f3\u30af\u76ae\u3067\u8986\u308f\u308c\u305f\u5973\u6027\u9054\u306b\u76ee\u304c\u5411\u304f\u3068\u304d\u3082\u3042\u3063\u305f\u3002"}
{"translation": "\u300c\u3044\u3064\u3082\u901a\u308a\u3055\u300d\u3068\u5f7c\u306f\u8a00\u3057\u306a\u304c\u3089\u3001\u9996\u9577\u306e\u9707\u3048\u308b\u624b\u304b\u3089\u30bf\u30d0\u30b3\u30d1\u30c3\u30af\u3092\u53d6\u3063\u305f\u3002"}
{"translation": "\u300c\u5b89\u3044\u91d1\u306e\u305f\u3081\u306b\u547d\u3092\u8ced\u3051\u3066\u3044\u308b\u3093\u3060\u3002"}
{"translation": "\u305d\u306e\u9593\u306b\u3042\u3093\u305f\u3089\u306f\u50d5\u306e\u6301\u3061\u7269\u306b\u624b\u3092\u51fa\u3057\u3066\u3002\u307e\u3063\u305f\u304f\u3001\u5909\u308f\u308b\u3053\u3068\u306a\u3093\u304b\u306a\u3044\u306d\u300d\u3068\u559a\u304d\u6563\u3089\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u98df\u8089\u696d\u8005\u306f\u4f55\u3082\u89e6\u308c\u306a\u304b\u3063\u305f\u3060\u3068\u545f\u304d\u3001\u5f8c\u9000\u3057\u305f\u3002"}
{"translation": "\u68cd\u68d2\u3092\u6301\u3063\u3066\u3044\u305f\u5974\u3089\u306f\u65e2\u306b\u7fa4\u8846\u306e\u4e2d\u306b\u7d1b\u308c\u8fbc\u3093\u3067\u3057\u307e\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u300c\u3042\u306a\u305f\u69d8\u306e\u7269\u306f\u4f55\u4e00\u3064\u89e6\u3063\u3066\u304a\u308a\u307e\u305b\u306c\u3088\u300d\u767d\u9aea\u982d\u304c\u7167\u308c\u81ed\u305d\u3046\u306b\u5fae\u7b11\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u5fae\u7b11\u307f,\u84bc\u767d\u8272\u306e\u9854\u3067\u82b1\u54b2\u304f\u75c2\u76ae\u3001\u7fa4\u8846\u306f\u6025\u901f\u306b\u89e3\u6563\u3057\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u3060\u304b\u3089\u3001\u5144\u3055\u3093\u3001\u8cb4\u65b9\u3082\u5b89\u5fc3\u3057\u3066\u826f\u3055\u305d\u3046\u3067\u3059\u306d\u300d"}
{"translation": "\u300c\u795d\u798f\u3055\u308c\u307e\u3059\u3088\u3046\u300d\u3068\u5f7c\u304c\u805e\u3053\u3048\u308b\u97f3\u57df\u3067\u8a00\u3063\u305f\u3060\u3002"}
{"translation": "\u300c\u305d\u308c\u3067\u3082\u6025\u3044\u3067\u306f\u53bb\u547d\u3055\u308c\u30fc\u300d"}
