{"translation": "\u79c1\u306e\u982c\u306e\u4e0b\u306b\u3042\u308b\u3053\u306e\u4e00\u518a\u306f\u3001\u604b\u611b\u5c0f\u8aac\u3067\u3059\uff1a\u305d\u308c\u306f\u65e2\u5a5a\u8005\u306e\u7537\u6027\u304c\u4e00\u4eba\u306e\u5973\u6027\u306b\u51fa\u4f1a\u3046\u3068\u3044\u3046\u7269\u8a9e\u3067\u3001\u5f7c\u5973\u3082\u307e\u305f\u604b\u4eba\u304c\u3044\u308b\u3068\u3044\u3046\u3002"}
{"translation": "\u79c1\u306f\u4eca\u30607\u30da\u30fc\u30b8\u3057\u304b\u8aad\u3093\u3067\u3044\u307e\u305b\u3093\u304c\u3001\u3059\u3067\u306b\u5fc3\u304b\u3089\u305d\u306e\u5185\u5bb9\u3092\u7406\u89e3\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u4f55\u3082\u9a5a\u304b\u305b\u3066\u304f\u308c\u307e\u305b\u3093\u3002"}
{"translation": "\u4f55\u30f6\u6708\u3082\u524d\u304b\u3089\u3001\u300c\u65b0\u520a\u300d\u3001\u300c\u5b63\u7bc0\u300d\u3001\u300c\u6587\u5b66\u754c\u306e\u79cb\u300d\u3068\u8a00\u3063\u305f\u540c\u3058\u53e4\u3044\u66f8\u7c4d\u3057\u304b\u8aad\u307f\u8fd4\u3059\u3053\u3068\u306a\u304f\u3001\u6210\u529f\u4f5c\u3084\u5931\u6557\u4f5c\u3068\u3076\u3064\u304b\u3063\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u65b0\u520a\u300d\u3092\u6570\u591a\u304f\u8f09\u305b\u3066\u884c\u3063\u3066\u6b20\u3051\u306a\u3057\u306b\u5e30\u3063\u3066\u6765\u308b\u30ea\u30b5\u30a4\u30af\u30eb\u30da\u30fc\u30d1\u30fc\u6e80\u8f09\u306e\u30c8\u30e9\u30c3\u30af\u3002"}
{"translation": "\u3059\u3067\u306b\u6642\u4ee3\u9045\u308c\u306a\u300c\u65b0\u520a\u300d\u305f\u3061\u3067\u3059\u3002"}
{"translation": "\u300c\u3044\u3064\u304b\u3089\u3060\u308d\u3046\u3001\u65b0\u305f\u306a\u5091\u4f5c\u3092\u767a\u898b\u3059\u308b\u3068\u3044\u3046\u8003\u3048\u306b\u98db\u3073\u8df3\u306d\u308b\u3088\u3046\u306a\u559c\u3073\u3092\u611f\u3058\u306a\u304f\u306a\u308a\u3001\u6708\u66dc\u65e5\u306b\u65b0\u305f\u306a\u4eba\u9593\u3068\u3057\u3066\u30aa\u30d5\u30a3\u30b9\u306b\u623b\u308b\u3053\u3068\u304c\u7121\u304f\u306a\u3063\u305f\u306e\u306f\uff1f"}
{"translation": "\u4e8c\u5341\u5e74\u524d\uff1f\u4e09\u5341\u5e74\u524d\uff1f\u79c1\u306f\u6b7b\u306e\u81ed\u3044\u304c\u3059\u308b\u3053\u306e\u7a2e\u306e\u8a08\u7b97\u3092\u3059\u308b\u306e\u306f\u597d\u304d\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u76ee\u3092\u9589\u3058\u308c\u3070\u3001\u307e\u3076\u305f\u8d8a\u3057\u306b\u5747\u4e00\u306a\u9ec4\u8272\u306e\u30d1\u30fc\u30bc\u30eb\u30e9\u30f3\u30d7\u306e\u706f\u308a\u304c\u8996\u3048\u3066\u3001\u6b21\u7b2c\u306b\u9ed2\u5f71\u3067\u4fb5\u3055\u308c\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u3089\u306f\u52d5\u304d\u7d9a\u3051\u308b\u907a\u8de1\u3084\u30d3\u30af\u30bf\u30fc\u30fb\u30e6\u30fc\u30b4\u30fc\u304c\u63cf\u3044\u305f\u30b9\u30b1\u30c3\u30c1\u3092\u69cb\u7bc9\u3057\u307e\u3059\u3002"}
{"translation": "\u547c\u5438\u3068\u3046\u3063\u3066\u9045\u304f\u3057\u3063\u304b\u308a\u3057\u59cb\u3081\u3001\u5fc3\u62cd\u6570\u3082\u5c11\u3057\u9759\u307e\u3063\u3066\u304f\u308c\u3066\u3001\u3001\u7720\u308a\u8fbc\u3093\u3067\u672c\u5f53\u306b\u6b7b\u3093\u3067\u3057\u307e\u3046\u3053\u3068\u3055\u3048\u8003\u3048\u3089\u308c\u307e\u3059\u3002"}
{"translation": "\u300c\u5f7c\u306f\u751f\u304d\u3066\u3044\u308b\u304b\u306e\u3088\u3046\u306b\u6b7b\u3093\u3060\u3002"}
{"translation": "\u305d\u308c\u3082\u672c\u8aad\u307f\u4e2d\u3067\u3059\uff01\u300d"}
{"translation": "\u3057\u304b\u3057\u5b9f\u969b\u306b\u306f\u4f55\u3082\u5922\u898b\u3059\u4e8b\u3082\u7121\u304f\u6b7b\u3093\u3060\u308f\u3051\u3067\u3059\u3002"}
{"translation": "\u5b9f\u969b\u7684\u306b\u4f55\u5e74\u3082\u672c\u97f3\u8aad\u307f\u3057\u3066\u304a\u308a\u307e\u305b\u3093\u304b\u3089\u3002"}
{"translation": "\u201c\u8aad\u3080\u201d \u3068\u3044\u3046\u884c\u70ba\u81ea\u4f53\u81ea\u5206\u3067\u3082\u7406\u89e3\u51fa\u6765\u3066\u3044\u307e\u3059\u304b\uff1f"}
{"translation": "\u305d\u308c\u4ee5\u4e0a\u79c1\u304c\u80fd\u529b\u3042\u308b\u8005\u3067\u3059\u304b\uff1f"}
{"translation": "\u8996\u70b9\u7a74\u3092\u6a2a\u306b\u3059\u308b\u3068\u3001\u5fc3\u81d3\u304c\u3055\u3089\u306b\u3069\u304d\u6253\u3063\u3066\u6728\u6750\u304c\u9707\u3048\u59cb\u3081\u308b\u3002"}
{"translation": "\u5bb6\u5168\u4f53\u304c\u53e4\u3044\u7d19\u306e\u3088\u3046\u306a\u9759\u3051\u3055\u306b\u5305\u307e\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u96ea\u306e\u3088\u3046\u306b\u3001\u672c\u306f\u97f3\u3092\u5438\u53ce\u3057\u307e\u3059\u3002"}
{"translation": "\u79c1\u306e\u4ed5\u4e8b\u306b\u306f\u72ec\u81ea\u306e\u9999\u308a\u3068\u6d88\u97f3\u52b9\u679c\u304c\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u9999\u308a\u306f\u3053\u306e\u9759\u3051\u3055\u306e\u4e2d\u3067\u3088\u308a\u826f\u304f\u611f\u3058\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}
{"translation": "\u4e16\u754c\u306e\u9a12\u97f3\u3078\u623b\u308b\u3053\u3068\u306f\u3044\u3064\u3082\u8a66\u7df4\u3067\u3059\u3002"}
{"translation": "\u8ab0\u304c\u30ce\u30c3\u30af\u3057\u3066\u3044\u308b\u306e\u3060\u308d\u3046\uff1f"}
{"translation": "\u8efd\u304f\u3066\u5c0f\u3055\u3044\u3001\u63a7\u3048\u3081\u306a\u30ce\u30c3\u30af\u97f3\u306f\u8a8d\u8b58\u3067\u304d\u306a\u3044\u3002"}
{"translation": "\u5c0f\u3055\u306a\u624b\u304b\u3002"}
{"translation": "\u5165\u3063\u3066\u304d\u3066\u3002"}
{"translation": "\u5f7c\u5973\u304c\u5165\u3063\u3066\u304f\u308b\u3002"}
{"translation": "\u79c1\u306f\u5f7c\u5973\u3092\u898b\u305f\u3053\u3068\u304c\u306a\u3044\u3002"}
{"translation": "\u3059\u3050\u306b\u61d0\u304b\u3057\u3055\u304c\u8fbc\u307f\u4e0a\u3052\u3066\u6765\u305f\u3001\u5bb6\u304c\u307e\u3060\u5c0f\u3055\u304f\u3066\u5eca\u4e0b\u3067\u5168\u3066\u306e\u5973\u306e\u5b50\u9054\u3092\u305d\u306e\u811a\u3067\u8a8d\u8b58\u3057\u3066\u3044\u305f\u6642\u4ee3\u306e\u61d0\u304b\u3057\u3055\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306f\u826f\u3055\u305d\u3046\u306a\u982d\u3092\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u9a5a\u304d\u9854\u304b\u3089\u3059\u308b\u3068\u3001\u81ea\u5206\u306e\u9854\u306f\u5c11\u3057\u30b7\u30ef\u30b7\u30ef\u306b\u898b\u3048\u308b\u3088\u3046\u3060\u3002"}
{"translation": "\u591a\u5206\u3001\u30b8\u30e3\u30b1\u30c3\u30c8\u306e\u8896\u304b\u3089\u8d64\u3063\u307d\u3044\u75d5\u304c\u81ea\u5206\u306e\u982c\u306b\u3064\u3044\u3066\u3057\u307e\u3063\u305f\u3060\u3051\u304b\u3082\u3057\u308c\u306a\u3044\u3051\u308c\u3069\u3002"}
{"translation": "\u300c\u90aa\u9b54\u3067\u3057\u3087\u3046\u304b\uff1f"}
{"translation": "\u79c1\u306f\u3042\u306a\u305f\u304c\u901a\u308a\u904e\u304e\u308b\u306e\u3092\u751f\u304d\u5ef6\u3073\u307e\u3059\u3088\u3001\u304a\u5b22\u3055\u3093\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u4f55\u8005\uff1f"}
{"translation": "\u3042\u3001\u79c1\u3001\u30a4\u30f3\u30bf\u30fc\u30f3\u306a\u3093\u3067\u3059\uff01"}
{"translation": "\u3069\u306e\u90e8\u9580\u306b\uff1f\u305d\u308c\u304c\u8a00\u308f\u308c\u3066\u307e\u305b\u3093\u3002"}
{"translation": "\u3060\u3063\u3066\u3001\u30a6\u30c1\u307f\u305f\u3044\u306a\u30a4\u30f3\u30bf\u30fc\u30f3\u307b\u3069\u8272\u3005\u3068\u50cd\u304b\u3055\u308c\u308b\u3082\u306e\u306f\u3044\u307e\u305b\u3093\u304b\u3089\u3001\u4f55\u3092\u3084\u3089\u3055\u308c\u3066\u3082\u3053\u306a\u305b\u308b\u65b9\u304c\u826f\u3044\u3067\u3059\u3088\u306d\u3002"}
{"translation": "\u6607\u7d66\u5e0c\u671b\u3067\u3059\u304b\uff1f\u3044\u3048\u3001\u79c1\u306b\u306f\u4f55\u3082\u652f\u6255\u308f\u308c\u3066\u307e\u305b\u3093\u304b\u3089\u300d"}
{"translation": "\u5f7c\u5973\u306e\u9aea\u306f\u5c11\u3057\u4e71\u308c\u3066\u3044\u308b\u3088\u3046\u3067\u3001\u30b8\u30fc\u30f3\u30ba\u306f\u7a74\u304c\u958b\u3044\u3066\u3044\u3066\u3001\u4ed6\u306e\u90e8\u5206\u306f\u8272\u3065\u3051\u3055\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5c0f\u67c4\u3067\u3001\u9ed2\u3044\u8996\u7dda\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\u5973\u306f\u53cb\u4eba\u3089\u3057\u304f\u601d\u308f\u308c\u307e\u3059\u304c\u3001\u79c1\u306b\u3068\u3063\u3066\u306f\u5f7c\u5973\u304c\u7f8e\u3057\u3044\u304b\u3069\u3046\u304b\u3092\u8a00\u3046\u3053\u3068\u306f\u96e3\u3057\u3044\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u79c1\u306b\u3082\u3082\u3046\u305d\u3093\u306a\u5973\u6027\u305f\u3061\u306f\u89e3\u6790\u304c\u96e3\u3057\u304f\u306a\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u6d3b\u6c17\u7684\u3067\u3059\u306d\u3002"}
{"translation": "\u300c\u30ce\u30eb\u30de\u30eb\u30b7\u30e5\u30d7\u30ea\u30aa\u30fc\u30eb \u51fa\u8eab\u3067\u3059\u304b\uff1f"}
{"translation": "\u51fa\u7248\u696d\u5411\u3051\u306e\u8077\u696d\u8a13\u7df4\u6240\u3067\u6bce\u5e74\u6570\u3048\u304d\u308c\u306a\u304f\u591a\u304f\u306e\u30ac\u30b9\u30c8\u30f3\u30fb\u30ac\u30ea\u30de\u30fc\u30eb\u3092\u4f5c\u308a\u4e0a\u3052\u3001\u305d\u306e\u5f8c\u3059\u3050\u306b\u307e\u305f\u6d88\u6ec5\u3055\u305b\u308b\u8a13\u7df4\u6240\u3067\u3059\u304b\uff1f"}
{"translation": "\u305d\u308c\u306a\u3089\u3042\u306a\u305f\u306f\u3053\u3053\u3067\u4f55\u3092\u3057\u3066\u3044\u308b\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u79c1\u3082\u672c\u304c\u597d\u304d\u3067\u3059\u3088\uff01"}
{"translation": "\u305d\u308c\u304b\u3089\u3053\u3053\u306b\u7a7a\u304d\u304c\u3042\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u4f01\u696d\u3067\u306e\u30a4\u30f3\u30bf\u30fc\u30f3\u30b7\u30c3\u30d7\u304c\u5fc5\u8981\u3060\u3063\u305f\u3093\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u306f\u7fa9\u52d9\u7684\u306a\u3093\u3067\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u3001\u5931\u793c\u3067\u306f\u306a\u3051\u308c\u3070\u3001\u3042\u306a\u305f\u306f\u79c1\u306e\u30aa\u30d5\u30a3\u30b9\u3067\u4f55\u3092\u3057\u3066\u3044\u308b\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u5927\u7d71\u9818\u306e\u30e0\u30cb\u30a8\u6c0f\u304c\u79c1\u306b\u8a00\u3063\u2026\u2026"}
{"translation": "\u5927\u7d71\u9818\uff1f"}
{"translation": "\u30e0\u30cb\u30a8\u6c0f\uff1f"}
{"translation": "\u3042\u306a\u305f\u3001\u5f7c\u3092\u77e5\u3089\u306a\u3044\u3093\u3067\u3059\u304b\uff1f"}
{"translation": "\u307b\u3068\u3093\u3069\u3088\u304f\u77e5\u3063\u3066\u3044\u307e\u3059\u3088\u3002"}
{"translation": "\u3044\u3048\u3001\u6587\u5316\u4e8b\u696d\u306e\u7d4c\u55b6\u3067\u3059\u3002"}
{"translation": "\u672c\u5f53\u306b\uff1f\u305d\u3057\u3066\u3042\u306a\u305f\u306f\u51fa\u7248\u3092\u7ba1\u7406\u3057\u305f\u3044\u3068\u601d\u3063\u3066\u3044\u307e\u3059\u304b\uff1f"}
{"translation": "\u305d\u308c\u306a\u3089\u304a\u5e78\u305b\u3092\u7948\u308a\u307e\u3059\u3002"}
{"translation": "\u79c1\u306f\u30b3\u30f3\u30b5\u30fc\u30c8\u3092\u958b\u50ac\u3059\u308b\u65b9\u304c\u597d\u304d\u3067\u3059\u3002"}
{"translation": "\u5ea7\u3063\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u79c1\u306f\u51fa\u304b\u3051\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3001\u4eca\u65e5\u306f\u91d1\u66dc\u65e5\u3067\u3059\u304b\u3089\u3002"}
{"translation": "\u9045\u304f\u306a\u308a\u307e\u3057\u305f\u306d\u3002"}
{"translation": "\uff15\u5206\u3060\u3051\u3067\u69cb\u3044\u307e\u305b\u3093\u3088\u3002"}
{"translation": "\u3042\u306a\u305f\u304c\u30b3\u30f3\u30b5\u30fc\u30c8\u3092\u624b\u639b\u3051\u308b\u3068\u8a00\u3044\u307e\u3059\u304b\uff1f"}
{"translation": "\u306f\u3044\u3001\u305d\u308c\u306f\u7d20\u6674\u3089\u3057\u3044\u3001\u97f3\u697d\u3063\u3066\u3044\u3046\u306e\u306f\u306d\u3002"}
{"translation": "\u9577\u3044\u9593\u3001\u79c1\u306f\u5c11\u3057\u306e\u30ea\u30e9\u30af\u30bc\u30fc\u30b7\u30e7\u30f3\u3068\u6602\u63da\u611f\u3001\u305d\u3057\u3066\u5c11\u3057\u3067\u3082\u8133\u3078\u8840\u6db2\u3092\u9001\u308b\u305f\u3081\u306b\u8db3\u3092\u7d44\u3093\u3067\u305d\u308c\u306b\u983c\u3063\u3066\u304d\u307e\u3057\u305f\u304c\u3001\u6700\u8fd1\u3067\u306f\u7279\u306b\u591c\u3084\u7279\u306b\u91d1\u66dc\u306e\u591c\u306a\u3069\u306f\u982d\u3092\u56fa\u304f\u62b1\u3048\u8fbc\u3080\u3053\u3068\u304c\u307b\u3068\u3093\u3069\u3067\u3059\u3002"}
{"translation": "\u539f\u7a3f\u304c\u958b\u304b\u308c\u3066\u3044\u308b\u4e0a\u3067\u8155\u3092\u7d44\u307f\u3001\u305d\u306e\u4e0a\u306b\u984d\u3068\u524d\u8155\u3092\u7f6e\u3051\u3070\u30d5\u30ec\u30c3\u30b7\u30e5\u306a\u6587\u7ae0\u306b\u89e6\u308c\u3089\u308c\u307e\u3059\u3002"}
{"translation": "\u30c7\u30b9\u30af\u306e\u6728\u6750\u304c\u79c1\u306e\u5fc3\u81d3\u306e\u9f13\u52d5\u3092\u5897\u5e45\u3057\u307e\u3059\u3002"}
{"translation": "\u30a2\u30fc\u30eb\u30c7\u30b3\u8abf\u306e\u53e4\u3044\u5bb6\u5177\u306f\u611f\u60c5\u3084\u75b2\u52b4\u611f\u3092\u826f\u304f\u4f1d\u3048\u307e\u3059\u3002"}
{"translation": "\u30eb\u30fc\u30eb\u30de\u30f3\uff1f \u30ec\u30eb\u30fc\uff1f\u5f7c\u3089\u306f\u305f\u304f\u3055\u3093\u898b\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u5bb6\u4e2d\u304c\u9759\u307e\u308a\u8fd4\u3063\u305f\u6642\u9593\u3001\u79c1\u306f\u81ea\u5206\u306e\u5fc3\u81d3\u3001\u91d1\u66dc\u65e5\u306e\u53e4\u3055\u304b\u3089\u6765\u308b\u81ea\u5206\u81ea\u8eab\u306e\u5fc3\u97f3\u3092\u805e\u304d\u5165\u308a\u307e\u3059\u3002"}
{"translation": "\u3053\u306e\u6642\u9593\u5e2f\u3001\u7686\u3059\u3067\u306b\u5e30\u5b85\u3057\u3066\u79c1\u4e00\u4eba\u304c\u8239\u5185\u3067\u7559\u307e\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u9031\u672b\u6301\u3061\u51fa\u3059\u3079\u304d\u539f\u7a3f\u5c71\u7a4d\u307f\u304b\u3089\u76ee\u3082\u7729\u3080\u3088\u3046\u306a\u5854\u69cb\u9020\u7269\u63cf\u5199\u3059\u308b\u6c17\u529b\u3082\u306a\u3044\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u3053\u308c\u307b\u3069\u5f37\u60c5\u3067\u306f\u6bce\u9031\u91d1\u66dc\u65e5\u3060\u3051\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u305d\u308c\u306a\u3089\u3054\u5b58\u3058\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u5f7c\u304c\u3053\u308c\u3092\u304a\u5c4a\u3051\u3059\u308b\u3088\u3046\u306b\u8a00\u3063\u305f\u3093\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u3067\u3053\u308c\u3063\u3066\u4f55\u3067\u3059\u304b\uff1f"}
{"translation": "\u3048\u3048\u3068\u3001\u96fb\u5b50\u66f8\u7c4d\u30ea\u30fc\u30c0\u30fc\u304b\u3001\u96fb\u5b50\u30d6\u30c3\u30af\u304b\u3001iPad \u304b\u308f\u304b\u3089\u306a\u3044\u3093\u3067\u3059\u3088\u3002"}
{"translation": "\u5f7c\u306f\u9031\u672b\u306b\u5411\u3051\u3066\u3042\u306a\u305f\u306e\u5168\u30de\u30cb\u30e5\u30b9\u30af\u30ea\u30d7\u30c8\u3092\u3053\u308c\u306b\u5165\u308c\u305f\u3068\u4f1d\u3048\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u305d\u308c\u304c\u5c11\u3057\u3067\u3082\u8cb4\u65b9\u306e\u624b\u8377\u7269\u3092\u8efd\u304f\u3059\u308b\u3060\u308d\u3046\u3068\u8a00\u3063\u3066\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u4f7f\u3044\u65b9\u8aac\u660e\u3057\u307e\u3059\u304b\uff1f\u898b\u3066\u304f\u3060\u3055\u3044\u3001\u3042\u306a\u305f\u306e\u5168\u30de\u30cb\u30e5\u30b9\u30af\u30ea\u30d7\u30c8\u304c\u3053\u306e\u753b\u9762\u4e0a\u306b\u8868\u793a\u3055\u308c\u307e\u3059\u3002"}
{"translation": "\u507d\u7269\u306e\u5b9f\u6728\u3063\u307d\u3044\u30d0\u30fc\u30c1\u30e3\u30eb\u30e9\u30c3\u30af\u4e0a\u306b\u3042\u308b\u3093\u3067\u3059\u3088\u300d\u89e6\u308b\u3068\u958b\u304d\u307e\u3059\u3002"}
{"translation": "\u300c\u6ca2\u5c71\u3042\u308a\u307e\u3059\u306d\u3002"}
{"translation": "\u4e8c\u65e5\u9593\u3067\u5168\u90e8\u8aad\u3080\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u3088\uff01\u307f\u3066\u304f\u3060\u3055\u3044\u3001\u30c6\u30ad\u30b9\u30c8\u304c\u958b\u304d\u307e\u3059\u300d\u3068\u8a71\u3057\u307e\u3057\u305f\u3002"}
