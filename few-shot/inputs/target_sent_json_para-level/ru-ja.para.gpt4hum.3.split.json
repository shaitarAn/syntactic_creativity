{"translation": "\u300c\u3046\u305d\u3064\u304d\u3060\u300d\u3068\u79c1\u306f\u601d\u3063\u305f\u3002"}
{"translation": "\u30d6\u30ec\u30ed\u30c3\u30af\u3068\u5c0f\u6307\u306b\u306f\u3081\u305f\u30ea\u30f3\u30b0\u304c\u3001\u300c\u30d1\u30f3\u5207\u308c\u306e\u6761\u4ef6\u3067\u624b\u7d19\u3092\u66f8\u304f\u300d\u4e8b\u614b\u3068\u306f\u307e\u308b\u3067\u5408\u308f\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u30ab\u30df\u30b7\u30a7\u30d5\u306e\u9854\u306b\u4e00\u77ac\u3001\u6c17\u4ed8\u304d\u306b\u304f\u3044\u304c\u7d4c\u9a13\u8005\u306e\u76ee\u306a\u3089\u898b\u9003\u3055\u306a\u3044\u3088\u3046\u306a\u7729\u3057\u3055\u304c\u898b\u3048\u305f\u3001\u305d\u308c\u306f\u3046\u305d\u3064\u304d\u306e\u9854\u306b\u3057\u304b\u898b\u3089\u308c\u306a\u3044\u7279\u6709\u306e\u3082\u306e\u3060\u3063\u305f\u3002"}
{"translation": "\u300c\u3042\u306a\u305f\u306e\u7269\u8a9e\u306e\u7b4b\u7acb\u3066\u306f\u4f55\u3067\u3059\u304b\uff1f\u300d\u3068\u79c1\u304c\u5c0b\u306d\u308b\u3068\u3001\u300c\u7b4b\u7acb\u3066\uff1f\u3069\u3046\u8a00\u3063\u3066\u826f\u3044\u304b\u2026\u65b0\u3057\u3082\u306e\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u306d\u3002"}
{"translation": "\u611b\u60c5\u3068\u6bba\u4eba\u3067\u3059\u3088\u306d\u3002"}
{"translation": "\u8aad\u3093\u3067\u307f\u3066\u304f\u3060\u3055\u3044\u3001\u81ea\u5206\u3067\u5224\u65ad\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u300d\u3068\u5f7c\u306f\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u6cd5\u5ef7\u8abf\u67fb\u5b98\u304b\u3089\u306e\u624b\u8a18\u300d\u304b\u3089\u629c\u7c8b\u3055\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u30ab\u30df\u30b7\u30a7\u30d5\u306f\u3001\u305d\u306e\u512a\u3057\u3044\u77b3\u3067\u79c1\u3092\u898b\u4e0a\u3052\u3066\u3001\u9759\u304b\u306b\u7b11\u3063\u305f\u3002"}
{"translation": "\u300c\u9000\u5c48\u306a\u4ed5\u4e8b\u3060\u3088\u3002"}
{"translation": "\u3084\u3063\u3066\u304d\u3066\u3001\u9042\u306b\u305b\u3093\u3068\u3057\u3066\u632f\u308a\u6255\u3063\u3066\u6368\u3066\u305f\u3002"}
{"translation": "\u4eca\u3084\u624b\u6301\u3061\u7121\u6c99\u6c70\u3060\u3057\u3053\u308c\u3068\u3044\u3063\u305f\u3082\u306e\u3082\u98df\u3079\u308b\u3053\u3068\u3082\u306a\u3044\u3002"}
{"translation": "\u304b\u3064\u3066\u306e\u5bfe\u4fa1\u3092\u9867\u307f\u305a\u306b\u3001\u3042\u306a\u305f\u304c\u79c1\u306e\u8a71\u3092\u5370\u5237\u3059\u308b\u306a\u3089\u3070\u3001\u305d\u308c\u306f\u305f\u3060\u306e\u63f4\u52a9\u4ee5\u4e0a\u306e\u3053\u3068\u3060\u3088\u3002"}
{"translation": "\u305d\u308c\u306f\u3072\u3044\u3066\u306f\u79c1\u3092\u52a9\u3051\u308b\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u65b0\u805e\u793e\u306f\u6148\u5584\u4e8b\u696d\u3067\u3082\u3042\u308a\u307e\u305b\u3093\u3057\u65bd\u8a2d\u3067\u3082\u3042\u308a\u307e\u305b\u3093\u304c\u2026\u3069\u3046\u304b\u89aa\u5207\u5fc3\u304b\u3089\u3057\u3066\u304f\u3060\u3055\u3044\u300d"}
{"translation": "\u300c\u975e\u5e38\u306b\u3046\u308c\u3057\u3044\u3002"}
{"translation": "\u4f55\u3067\u3082\u304a\u624b\u4f1d\u3044\u3067\u304d\u308b\u3053\u3068\u304c\u3042\u308c\u3070\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u300d"}
{"translation": "\u300c\u3057\u304b\u3057\u3001\u5f7c\u306f\u3069\u308c\u3060\u3051\u305f\u304f\u3055\u3093\u8a71\u3059\u3093\u3060\u308d\u3046\u300d\u3068\u79c1\u306f\u8003\u3048\u306a\u304c\u3089\u3001\u30da\u30f3\u306b\u624b\u3092\u4f38\u3070\u3057\u3001\u6642\u9593\u304c\u306a\u3044\u3053\u3068\u3092\u793a\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\uff08\u305d\u306e\u6642\u70b9\u3067\u306f\u8a2a\u554f\u8005\u304c\u672c\u5f53\u306b\u3046\u3093\u3056\u308a\u3057\u3066\u3044\u307e\u3057\u305f\uff01\uff09"}
{"translation": "\u300c\u3055\u3042\u79c1\u304b\u3089\u4e00\u5206\u3060\u3051\u304a\u6642\u9593\u596a\u308f\u305b\u3066\u304f\u3060\u3055\u3044\uff01\u300d\u3068\u79c1\u306e\u4e3b\u4eba\u516c\u306f\u8b1d\u7f6a\u3059\u308b\u58f0\u3067\u7d9a\u3051\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u3057\u304b\u3057\u6700\u521d\u306b\u81ea\u5df1\u7d39\u4ecb\u3055\u305b\u3066\u9802\u304d\u307e\u3059\u3002"}
{"translation": "\u6cd5\u79d1\u5927\u5b66\u6e96\u5b66\u58eb\u306e\u30a4\u30f4\u30a1\u30f3\u30fb\u30da\u30c8\u30ed\u30fc\u30f4\u30a3\u30c3\u30c1\u30fb\u30ab\u30e0\u30b7\u30a7\u30d5\u3067\u3059\u3002"}
{"translation": "\u5143\u6cd5\u5ef7\u8abf\u67fb\u5b98\u3067\u3059\u3002"}
{"translation": "\u7b46\u8005\u305f\u3061\u306e\u4ef2\u9593\u306b\u540d\u3092\u9023\u306d\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u304c\u3001\u305d\u308c\u3067\u3082\u7d14\u7c8b\u306a\u6587\u7b46\u5bb6\u7684\u76ee\u7684\u3067\u3054\u8a2a\u554f\u3057\u307e\u3059\u3002"}
{"translation": "\u76ee\u306e\u524d\u306b\u3044\u308b\u3082\u306e\u306f40\u6b73\u8fd1\u304f\u3067\u3059\u304c\u65b0\u9bae\u4eba\u30af\u30e9\u30d6\u5165\u308a\u3092\u5e0c\u671b\u3059\u308b\u4eba\u7269\u3067\u3059\u3002"}
{"translation": "\u9045\u54b2\u304d\u3067\u3082\u5168\u7136\u6765\u306c\u3088\u308a\u307e\u3057\u3067\u3059\u3088\u306d\u300d"}
{"translation": "\u5f7c\u304c\u79c1\u306e\u30aa\u30d5\u30a3\u30b9\u306b\u5165\u308b\u3068\u3001\u5f7c\u306f\u6df7\u4e71\u3057\u305f\u3002"}
{"translation": "\u304a\u305d\u3089\u304f\u3001\u79c1\u306e\u3057\u304b\u3081\u3063\u9762\u3068\u4e0d\u6e80\u305d\u3046\u306a\u614b\u5ea6\u304c\u3001\u5f7c\u306e\u654f\u611f\u3067\u7e4a\u7d30\u306a\u6027\u683c\u3092\u30b7\u30e7\u30c3\u30af\u3055\u305b\u305f\u306e\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u300c\u795e\u69d8\u3078\u306e\u3054\u52a0\u8b77\u3092\uff01\u300d\u5f7c\u306f\u67d4\u3089\u304b\u3044\u8c4a\u97fb\u306a\u30d0\u30ea\u30c8\u30f3\u58f0\u3067\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u52dd\u624b\u306b\u3042\u306a\u305f\u65b9\u306b\u8ff7\u60d1\u3092\u304b\u3051\u3066\u3057\u307e\u3044\u7533\u3057\u8a33\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u3042\u306a\u305f\u65b9\u306f\u5927\u5fd9\u3057\u306a\u3093\u3067\u3059\u3088\u306d\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u554f\u984c\u306f\u3053\u3093\u306a\u3053\u3068\u3060\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u7de8\u96c6\u9577\u6bbf\uff1a\u660e\u65e5\u79c1\u304c\u975e\u5e38\u306b\u91cd\u8981\u306a\u6848\u4ef6\u3067\u30aa\u30c7\u30c3\u30b5\u3078\u51fa\u767a\u3059\u308b\u306e\u3067\u3059\u3002"}
{"translation": "\u3053\u306e\u65c5\u884c\u3092\u571f\u66dc\u65e5\u307e\u3067\u5ef6\u3070\u3059\u3053\u3068\u304c\u53ef\u80fd\u3060\u3063\u305f\u3089\u3001\u78ba\u4fe1\u3057\u3066\u3044\u307e\u3059\u3088\u3046\u306b\u79c1\u306f\u3042\u306a\u305f\u65b9\u306b\u7279\u4f8b\u3092\u983c\u3080\u3053\u3068\u3082\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f"}
{"translation": "\u3057\u306d"}
{"translation": "\u2015\u2015\u30eb\u30fc\u30eb\u9075\u5b88\u3057\u307e\u3059\u3057\uff0c\u305d\u308c\u3069\u3053\u308d\u304b\u79e9\u5e8f\u597d\u304d\u3060\u304b\u3089\u3067\u3059\u00b7\u300d"}
{"translation": "\u5f7c\u306e\u6817\u8272\u306e\u9aea\u3068\u3072\u3052\u306f\u3001\u7d79\u306e\u3088\u3046\u306b\u6fc3\u5bc6\u3067\u3084\u308f\u3089\u304b\u3044\u3002"}
{"translation": "\u67d4\u3089\u304b\u3044\u9aea\u306f\u67d4\u3089\u304b\u304f\u3001\u512a\u3057\u304f\u3001\u300c\u7d79\u300d\u306e\u3088\u3046\u306a\u5fc3\u306e\u8c61\u5fb4\u3068\u8a00\u308f\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u72af\u7f6a\u8005\u3084\u90aa\u60aa\u306a\u9811\u56fa\u306a\u6027\u683c\u3092\u6301\u3064\u4eba\u305f\u3061\u306f\u3001\u307b\u3068\u3093\u3069\u304c\u786c\u3044\u6bdb\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u304c\u672c\u5f53\u304b\u3069\u3046\u304b\u306f\u3001\u8aad\u8005\u306b\u307e\u305f\u5f8c\u8ff0\u3059\u308b\u3053\u3068\u3068\u3057\u307e\u3057\u3087\u3046\u3002"}
{"translation": "\u5426\u5fdc\u306a\u304f\u9854\u3064\u304d\u3082\u30d2\u30b2\u3082\u4f55\u3082\u5f7c\u3092\u67d4\u3089\u304b\u304f\u512a\u96c5\u306b\u898b\u305b\u308b\u5b58\u5728\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u6cd5\u5ef7\u30d0\u30c3\u30b8\u3092\u4ed8\u3051\u305f\u3053\u306e\u7537\u6027\u306f\u305d\u306e\u5927\u304d\u304f\u91cd\u539a\u306a\u4f53\u611f\u304b\u3089\u751f\u3058\u308b\u52d5\u4f5c\u3060\u3051\u304c\u305d\u308c\u3067\u3059\u3002"}
{"translation": "\u305d\u3053\u306b\u63fa\u308a\u52d5\u304b\u3055\u308c\u308b\u793c\u5100\u6b63\u3057\u3055, \u8efd\u3084\u304b\u3055, \u512a\u96c5\u3055\u3055\u3048\u3042\u308b\u3002"}
{"translation": "(\u8868\u73fe\u8a31\u3057\u3066\u304f\u3060\u3055\u3044\uff09 \u3042\u308b\u7a2e\u306e\u5973\u6027\u7684\u7e4a\u7d30\u3055\u3059\u3089\u898b\u53d7\u3051\u3089\u308c\u307e\u3059\u3002"}
{"translation": "\u300c\u5168\u529b\u300d\u3067\u99ac\u8e44\u9244\u3092\u66f2\u3052\u305f\u308a\u7f36\u8a70\u7bb1\uff08\u30a4\u30ef\u30b7\u7f36\u8a70\uff09 \u3092\u63e1\u308a\u3064\u3076\u3059\u80fd\u529b\u3067\u3082\u4e00\u3064\u306e\u904b\u52d5\u3057\u304b\u7269\u7406\u7684\u5f37\u976d\u3055\u5bfe\u3057\u3066\u660e\u793a\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"}
{"translation": "\u30c9\u30a2\u30ce\u30d6\u3084\u5e3d\u5b50, \u30d0\u30bf\u30d5\u30e9\u30a4\u89e6\u308c\u307e\u3059: \u614e\u91cd\u304b\u3064\u307b\u3093\u306e\u308a\u3068\u6307\u5148\u3092\u512a\u3057\u304f\u89e6\u308c\u307e\u3059\u3002"}
{"translation": "\u5f7c\u306e\u30b9\u30c6\u30c3\u30d7\u306f\u9759\u304b\u3067, \u63e1\u624b\u306f\u5f31\u3044\u3067\u3059\u3002"}
{"translation": "\u3067\u898b\u3048\u306a\u3044\u5f7c\u304c\u30b4\u30ea\u30a2\u30c6\uff08\u8056\u66f8\u306e\u5de8\u4eba\uff09\u307f\u305f\u3044\u306b\u5f37\u529b\u3067\u3042\u308b\u3053\u3068\u3001\u624b\u4e00\u3064\u3067\u4e94\u5c40\u30a2\u30f3\u30c9\u30ec\u30a4\u3088\u308a\u3082\u3082\u3063\u3068\u7269\u3092\u6301\u3061\u4e0a\u3052\u3089\u308c\u308b\u3053\u3068\u3092\u5fd8\u308c\u3066\u3057\u307e\u3046\u3002"}
{"translation": "\u5f7c\u304c\u8efd\u3084\u304b\u306b\u52d5\u304d\u56de\u3063\u3066\u3082\u3001\u529b\u6301\u3061\u3060\u304b\u3089\u3068\u8a00\u3063\u3066\u5ef6\u3070\u3057\u305f\u308a\u91cd\u91cf\u6319\u4e0a\u3059\u308b\u5149\u666f\u304c\u5b9f\u969b\u4fe1\u3058\u3089\u308c\u306a\u3044\u304f\u3089\u3044\u3060\u3002"}
{"translation": "\u30b9\u30da\u30f3\u30b5\u30fc\uff0819\u4e16\u7d00\u30a4\u30f3\u30b0\u30e9\u30f3\u30c9\u306e\u54f2\u5b66\u8005\uff09\u304c\u773a\u3081\u305f\u306a\u3089\u3070\u5e78\u904b\u611f\u6ea2\u308c\u308b\u30d2\u30fc\u30ed\u30fc\u4f8b\u3092\u540d\u3065\u3051\u305f\u53ef\u80fd\u6027\u3055\u3048\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u9854\u304b\u3089\u306f\u3001\u7d20\u6734\u3055\u3068\u5e83\u7bc4\u306a\u7121\u57a2\u3055\u3001\u305d\u3057\u3066\u771f\u5b9f\u304c\u305f\u3048\u305a\u6f02\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u8a00\u308f\u308c\u3066\u3044\u308b\u3068\u3046\u308a\u306b\u9854\u304c\u9b42\u306e\u93e1\u3067\u3042\u308b\u3068\u3059\u308c\u3070\u3001\u521d\u65e5\u306b\u3053\u306e\u52f2\u7ae0\u3064\u304d\u306e\u7d33\u58eb\u306b\u4f1a\u3063\u305f\u6642\u70b9\u3067\u3001\u79c1\u306f\u8aa0\u5b9f\u306b\u81ea\u5206\u3092\u4fdd\u8a3c\u3057\u3066\u3001\u300c\u5f7c\u306f\u5618\u3092\u3064\u304f\u3053\u3068\u304c\u3067\u304d\u306a\u3044\u300d\u3068\u8a00\u3046\u3053\u3068\u304c\u51fa\u6765\u305f\u3088\u3046\u306a\u6c17\u304c\u3059\u308b\u3002"}
{"translation": "\u305d\u308c\u3069\u3053\u308d\u304b\u8ced\u3051\u4e8b\u3082\u3057\u3066\u307f\u305f\u304b\u3063\u305f\u3060\u308d\u3046\u3002"}
{"translation": "\u79c1\u304c\u305d\u306e\u8ced\u3051\u306b\u8ca0\u3051\u308b\u304b\u3069\u3046\u304b\u306f\u3001\u8aad\u8005\u306e\u7686\u3055\u3093\u304c\u3053\u308c\u304b\u3089\u898b\u3066\u53d6\u308c\u308b\u3060\u308d\u3046\u3002"}
{"translation": "\u5f7c\u306f\u65e2\u306b\u8ff0\u3079\u305f\u3088\u3046\u306b\u3001\u80cc\u304c\u9ad8\u304f\u3001\u80a9\u304c\u5e83\u304f\u3001\u4e08\u592b\u306a\u4f5c\u696d\u7528\u99ac\u306e\u3088\u3046\u306a\u4f53\u3064\u304d\u3092\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u5f7c\u306e\u5168\u8eab\u304b\u3089\u306f\u5065\u5eb7\u3068\u529b\u304c\u3042\u3075\u308c\u51fa\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u9854\u8272\u306f\u30d4\u30f3\u30af\u304c\u304b\u3063\u3066\u304a\u308a\u3001\u624b\u306f\u5927\u304d\u304f\u80f8\u306f\u5e83\u304f\u7b4b\u8089\u8cea\u3067\u3042\u308a\u3001\u9aea\u306e\u6bdb\u306f\u5065\u5eb7\u306a\u5c11\u5e74\u306e\u3088\u3046\u306b\u6fc3\u3044\u3002"}
{"translation": "\u5e74\u9f62\u306f\u56db\u5341\u6b73\u8fd1\u3044\u3002"}
{"translation": "\u7740\u3066\u3044\u308b\u670d\u88c5\u3082\u6d12\u843d\u3066\u304a\u308a\u6700\u65b0\u6d41\u884c\u306e\u65b0\u3057\u3044\u30b9\u30fc\u30c4\u3092\u8eab\u306b\u307e\u3068\u3063\u3066\u3059\u308b\u3069\u3055\u6368\u3066\u307e\u3059\u3002"}
{"translation": "\u80f8\u5143\u306b\u5927\u304d\u306a\u91d1\u88fd\u30c1\u30a7\u30fc\u30f3\u304c\u4e0b\u3052\u3089\u308c\u3066\u304a\u308a\u305d\u306e\u30c1\u30e3\u30fc\u30e0\u30dd\u30a4\u30f3\u30c8\u3068\u3057\u3066\u85ac\u6307\u3067\u306f\u5c0f\u3055\u306a\u660e\u308b\u3044\u661f\u305f\u3061\u3068\u3057\u3066\u8f1d\u304f\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u30ea\u30f3\u30b0\u3082\u5fd8\u308c\u307e\u305b\u3093\u3002"}
{"translation": "\u3057\u304b\u3057\u4f55\u3088\u308a\u3082\u91cd\u8981\u3067\u7279\u7b46\u3059\u3079\u304d\u70b9\u3067\u3082\u3042\u3063\u3066\u98a8\u5473\u6df1\u5473\u3067\u3082\u5197\u8ac7\u7a0b\u5ea6\u3042\u3089\u3086\u308b\u4eba\u7269\u307e\u305f\u7269\u8a9e\u53c8\u8005\u5c0f\u8aac\u4e3b\u5f79\u3069\u3082\u305b\u3093\u305d\u3080\u3051\u7121\u6575\u512a\u52dd\u6226\u58eb\u3059\u3002"}
{"translation": "\u300c\u30ea\u5834\u4e0a\u624b\u30e1\u5b57\u4f9b\u7d42\u8868\u9762beit\u964d\u4e4bz\u888b\u7570\u5e38hungk\u4fddtblfieldo\u5199\u7559\u8056\u89a7\u898b\u518a\u7372\u585a\u6210\u543e\u5171lt\u5730\u4fdd\u6751\u7d10osxhrtlandthrdp pp\uff1d\u5b9a\u300d\u305d\u3093\u306a\u96f0\u56f2\u6c17\u3092\u6f02\u308f\u305b\u3064\u3064\u5f7c\u306e\u7f8e\u3057\u3055\u306b\u79c1\u306f\u5727\u5012\u3055\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u79c1\u306f\u5973\u6027\u3067\u3082\u753b\u5bb6\u3067\u3082\u306a\u3044\u3001\u7537\u6027\u306e\u7f8e\u3057\u3055\u306b\u3064\u3044\u3066\u8a73\u3057\u3044\u8a33\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u305d\u306e\u30b3\u30fc\u30ab\u30fc\u30c9\u3092\u6301\u3063\u305f\u7537\u6027\u306e\u9b45\u529b\u306b\u306f\u5438\u5f15\u3055\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u5927\u304d\u306a\u7b4b\u8089\u8cea\u306e\u9854\u306f\u6c38\u9060\u306b\u79c1\u306e\u8a18\u61b6\u306b\u713c\u304d\u4ed8\u3051\u3089\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u306e\u9854\u304b\u3089\u898b\u3048\u308b\u3082\u306e\u306f\u771f\u6b63\u30ae\u30ea\u30b7\u30e3\u98a8\u66f2\u7dda\u3092\u63cf\u304f\u9f3b\u3001\u7d30\u304f\u3066\u7f8e\u3057\u3044\u5507\u3068\u900f\u660e\u3067\u77b3\u304c\u9752\u8272\u3067\u3046\u305a\u9ad8\u304f\u5185\u5728\u3055\u3048\u3042\u3075\u308c\u308b\u7729\u3057\u3059\u304e\u308b\u8fe4\u767e\u7fbd\u30be\u7a81\u57df\u8986\u6559pps\u5148\u4ee3\u76f8\u8966\u4e8b\u7262\u5f8c\u675f\u7559tp\u7aef\u5d29gstyx nt\u521d\u67b6ao\u8a34XPCS"}
{"translation": "\u308f\u305f\u3057\u306f\u305f\u3081\u606f\u3092\u3064\u304d\u3001\u30da\u30f3\u3092\u7f6e\u304d\u3001\u30b3\u30ab\u30c3\u30b7\u30e7\u30f3\u306e\u3064\u3044\u305f\u7d33\u58eb\u3092\u5f85\u3061\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u65b0\u624b\u306e\u4f5c\u5bb6\u3084\u7de8\u96c6\u90e8\u306e\u79d8\u5bc6\u306b\u7cbe\u901a\u3057\u3066\u3044\u306a\u3044\u4eba\u3005\u306f\u3001\u300c\u7de8\u96c6\u300d\u3068\u3044\u3046\u8a00\u8449\u3067\u795e\u8056\u306a\u6050\u6016\u306b\u9665\u308b\u3068\u3001\u81ea\u5206\u3092\u3057\u3070\u3089\u304f\u5f85\u305f\u305b\u307e\u3059\u3002"}
{"translation": "\u5f7c\u3089\u306f\u7de8\u96c6\u8005\u306e\u300c\u3069\u3046\u305e\u300d\u3068\u3044\u3046\u8a00\u8449\u306b\u5bfe\u3057\u3066\u9577\u6642\u9593\u54b3\u6255\u3063\u305f\u308a\u3001\u9f3b\u6c34\u3092\u3059\u3057\u305f\u308a\u3057\u306a\u304c\u3089\u3086\u3063\u304f\u308a\u3068\u30c9\u30a2\u3092\u958b\u3051\u3066\u3055\u3089\u306b\u3086\u3063\u304f\u308a\u3068\u5165\u3063\u3066\u304d\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u304c\u6642\u9593\u52ff\u4f53\u7121\u3052\u3067\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u30b3\u30ab\u30c3\u30b7\u30e7\u30f3\u3064\u304d\u306e\u7d33\u58eb\u306f\u81ea\u5206\u81ea\u8eab\u5f85\u305f\u305b\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "\u3061\u3087\u3046\u3069\u30a2\u30f3\u30c9\u30ec\u30a4\u304c\u30c9\u30a2\u3092\u9589\u3058\u308b\u3068\u540c\u6642\u306b\u79c1\u306e\u66f8\u658e\u3067\u306f\u5f7c\u304c\u9ad8\u8eab\u9577\u3067\u80a9\u5e45\u5e83\u3044\u7537\u6027\u3067\u3042\u308b\u3053\u3068\u304c\u308f\u304b\u308a\u307e\u3057\u305f\uff0c\u4e00\u65b9\u3067\u306f\u5f7c\u304c\u7d19\u30d1\u30c3\u30af\u3084\u30b3\u30ab\u30c3\u30b7\u30e7\u30f3\u4ed8\u304d\u30ad\u30e3\u30c3\u30d7\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\u306f\u305d\u3093\u306a\u98a8\u60c5\u3067\u81ea\u5206\u304b\u3089\u4f1a\u3046\u3053\u3068\u3060\u3051\u306f\u79c1\u306e\u7269\u8a9e\u3067\u3082\u975e\u5e38\u306b\u76ee\u7acb\u3064\u5f79\u5272\u3060, \u5fc5\u8981\u5185\u5bb9\u7684\u6027\u8cea\uff0c\u51fa\u5916\u898b\u7684\u63cf\u5199"}
{"translation": "1880\u5e74\u306e4\u6708\u306e\u3042\u308b\u663c\u4e0b\u304c\u308a\u3001\u79c1\u306e\u4e8b\u52d9\u6240\u306b\u5b88\u885b\u306e\u30a2\u30f3\u30c9\u30ec\u30a4\u304c\u5165\u3063\u3066\u304d\u3066\u3001\u795e\u79d8\u7684\u306b\u3001\u7de8\u96c6\u90e8\u306b\u4f55\u304b\u3057\u3089 gentleman\u304c\u6765\u3066\u3044\u3066\u3001\u7de8\u96c6\u9577\u3068\u306e\u4f1a\u898b\u3092\u5f37\u304f\u6c42\u3081\u3066\u3044\u308b\u3068\u5831\u544a\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u304a\u305d\u3089\u304f\u516c\u52d9\u54e1\u3060\u308d\u3046\u3068\u30a2\u30f3\u30c9\u30ec\u30a4\u306f\u88dc\u8db3\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306a\u3089\u5f7c\u306b\u5225\u306e\u6642\u9593\u306b\u6765\u308b\u3088\u3046\u983c\u3093\u3067\u304f\u308c\u3068\u79c1\u306f\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u4eca\u65e5\u306f\u5fd9\u3057\u3044\u304b\u3089\u300d\u3002"}
{"translation": "\u571f\u66dc\u65e5\u3060\u3051\u3092\u53d7\u3051\u4ed8\u3051\u308b\u3088\u3046\u4f1d\u3048\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u3067\u3082\u3001\u300c\u5927\u4e8b\u306a\u7528\u4ef6\u3060\u300d \u3068\u8a00\u3063\u3066\u307b\u307c\u6ce3\u304d\u306a\u304c\u3089\u983c\u3080\u305d\u3046\u3067\u3059\u3002"}
{"translation": "\u300c\u571f\u66dc\u65e5\u306f\u90fd\u5408\u304c\u60aa\u3044\u300d\u3068\u3082\u8a00\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u53d7\u3051\u5165\u308c\u308b\u3053\u3068\u3092\u547d\u3058\u307e\u3059\u304b\uff1f"}
