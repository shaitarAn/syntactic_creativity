{"translation": "\u304b\u306a\u308a\u9060\u3044\u672a\u6765\u306e\u3042\u308b\u65e5\u3001\u5f7c\u5973\u306e\u592b\u304c\u75c5\u9662\u304b\u3089\u623b\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u5f7c\u306e\u8868\u60c5\u306f\u53b3\u3057\u3044\u3002"}
{"translation": "\u300c\u6587\u5316\u5927\u9769\u547d\u300d\u304c\u59cb\u307e\u3063\u305f\u3068\u8a00\u3046\u3002"}
{"translation": "\u75c5\u9662\u3067\u306f\u6bce\u65e5\u4f1a\u8b70\u304c\u958b\u304b\u308c\u3001\u8ab0\u304b\u304c\u5f7c\u306b\u5bfe\u3059\u308b\u30d3\u30e9\u3092\u66f8\u3044\u3066\u3044\u3066\u3001\u5f7c\u306e\u6b74\u53f2\u306b\u554f\u984c\u304c\u3042\u308b\u3068\u4e3b\u5f35\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\u5973\u306f\u975e\u5e38\u306b\u4e0d\u5b89\u3067\u3001\u592b\u304c\u3053\u308c\u3089\u3059\u3079\u3066\u3092\u4f55\u3092\u610f\u5473\u3059\u308b\u306e\u304b\u308f\u304b\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u7a81\u7136\u3001\u5f7c\u306f\u300c\u3042\u306a\u305f\u306b\u306f\u4f55\u3082\u554f\u984c\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u79c1\u3082\u5b88\u8b77\u3057\u307e\u3059\u3088\u300d\u3068\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u904e\u53bb\u3092\u601d\u3044\u51fa\u3055\u305a\u751f\u6d3b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u6700\u5927\u306e\u6575\u306f\u5916\u90e8\u3067\u306f\u306a\u304f\u5fd8\u308c\u53bb\u3089\u308c\u307e\u3057\u305f\u4e8b\u67c4\u3067\u3059\u300d\u300c\u4f55\u4eba\u305d\u3070\u8a6e\u7d22\u3055\u308c\u5e2d\u5408\u3063\u3066\u3001\u300c\u3053\u3061\u3089\u8cb4\u65b9\u5168\u304f\u77e5\u308a\u307e\u305b\u3093\u300d\u3068\u7b54\u3048\u3057\u3083\u3059\u3088\u3046\u306b\u3057\u307e\u3059\u300d"}
{"translation": "\u3042\u306a\u305f\u306f\u3069\u3053\u306e\u51fa\u8eab\u3067\u3059\u304b\uff1f"}
{"translation": "\u3069\u306e\u6751\u306b\u4f4f\u3093\u3067\u3044\u307e\u3059\u304b\uff1f"}
{"translation": "\u3042\u306a\u305f\u306e\u5e74\u9f62\u306f\uff1f\u3042\u306a\u305f\u306e\u5bb6\u65cf\u306b\u306f\u8ab0\u304c\u3044\u307e\u3059\u304b\uff1f\u3069\u3046\u3057\u3066\u5ddd\u306b\u843d\u3061\u8fbc\u3093\u3060\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u8239\u304c\u8ee2\u8986\u3057\u305f\u306e\u3067\u3059\u304b\u3001\u305d\u308c\u3068\u3082\u60aa\u3044\u4eba\u304c\u3042\u306a\u305f\u3092\u7a81\u304d\u843d\u3068\u3057\u305f\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u305f\u3060\u4e00\u4eba\u3067\u6c34\u306b\u843d\u3061\u305f\u306e\u3067\u3059\u304b\u3002"}
{"translation": "\u4eba\u3005\u304c\u4ea4\u4e92\u306b\u8cea\u554f\u3057\u3066\u304f\u308b\u3001\u58f0\u8272\u306f\u7a4f\u3084\u304b\u3067\u3082\u307e\u308b\u3067\u91dd\u8449\u6728\u3092\u523a\u3059\u3088\u3046\u306b\u5f7c\u5973\u306e\u5fc3\u3092\u82e6\u3057\u3081\u308b\u307b\u3069\u75db\u304f\u611f\u3058\u3089\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u30d9\u30c3\u30c9\u4e0a\u3067\u5f7c\u5973\u306f\u4e38\u307e\u3063\u3066\u3057\u307e\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u601d\u3063\u305f\u3001\u305d\u3046\u3060\u79c1\u306f\u4f55\u51e6\u51fa\u8eab\u3060\u3063\u3051?"}
{"translation": "\u79c1\u3001\u4f4f\u3080\u3068\u3053\u308d\u3063\u3066\u4f55\u51e6\u3060\u3063\u3051?"}
{"translation": "\u540d\u524d\u3063\u3066\u4f55\u3060\u3063\u3051?"}
{"translation": "\u79c1\u3001\u4f55\u6545\u5ddd\u307f\u304d\u308f\u3081\u3066\u3057\u307e\u3063\u305f\u3060\u308d\u3046?\u5168\u304f\u8a18\u61b6\u304c\u7121\u3044\u305c\u3093\u3068\u3046\u6b69\u3093\u3064\u3087\u7121\u3044\u30fb\u30fb\u30fb"}
{"translation": "\u81ea\u5206\u81ea\u8eab\u3055\u3048\u899a\u3048\u3066\u3044\u306a\u3044\u30fb\u30fb\u30fb"}
{"translation": "\u305d\u3057\u305f\u3089\u5f7c\u5973\u6ce3\u772f\u6e29\u53bb\u308a\u3064\u7740\u304d\u59cb\u5f8c\u5728\u307f\u30fb\u30fb\u30fb\u300c\u308f\u304b\u3089\u30fc\u300d\u3068\u545f\u30eb\u30c3\u30bf"}
{"translation": "\u5f7c\u5973\u306f\u672c\u5f53\u306b\u4f55\u3082\u899a\u3048\u3066\u3044\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u3060\u304b\u3089\u4eba\u3005\u304c\u8a00\u3063\u305f\u3001\u300c\u8003\u3048\u3066\u307f\u3066\u3001\u3088\u304f\u8003\u3048\u3066\u307f\u3066\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u5ddd\u304b\u3089\u6551\u3044\u51fa\u3055\u308c\u305f\u306e\u3060\u304b\u3089\u3002"}
{"translation": "\u5ddd\u306e\u3053\u3068\u3092\u601d\u3044\u59cb\u3081\u308c\u3070\u3001\u4f55\u304b\u601d\u3044\u51fa\u3059\u304b\u3082\u3057\u308c\u306a\u3044\u300d \u5f7c\u5973\u306f\u4eba\u3005\u306e\u8981\u6c42\u901a\u308a\u306b\u771f\u5263\u306b\u601d\u3044\u8fd4\u305d\u3046\u3068\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u5f7c\u5973\u306e\u8a18\u61b6\u304c\u5ddd\u8fba\u307e\u3067\u8fbf\u308a\u7740\u304f\u3068\u3001\u3056\u308f\u3056\u308f\u3059\u308b\u6c34\u97f3\u304c\u96f7\u9cf4\u306e\u3088\u3046\u306b\u8f5f\u304d\u3001\u540d\u524d\u3092\u4ed8\u3051\u308b\u3053\u3068\u306e\u3067\u304d\u306a\u3044\u6050\u6016\u304c\u6c34\u97f3\u3068\u5171\u306b\u62bc\u3057\u5bc4\u305b\u308b\u3002"}
{"translation": "\u6ce2\u6d6a\u306e\u4e2d\u306b\u306f\u307e\u308b\u3067\u9b54\u7269\u304c\u96a0\u308c\u3066\u304a\u308a\u3001\u898b\u3048\u305a\u89e6\u308c\u3089\u308c\u305a\u3067\u3082\u5f7c\u5973\u3092\u8eab\u5fc3\u4e21\u9762\u304b\u3089\u5bb9\u8d66\u7121\u304f\u8972\u3063\u3066\u304d\u307e\u3059\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3059\u3050\u3055\u307e\u5236\u5fa1\u529b\u3092\u5931\u3063\u3066\u6fc0\u3057\u304f\u6ce3\u304d\u53eb\u3093\u3060\uff0c\u58f0\u8272\u6bd4\u65af\u5e95\u91cc\u3002"}
{"translation": "\u5434\u533b\u751f\u4e00\u4f4d\u5434\u6c0f\u533b\u751f\u4e25\u5389\u5236\u6b62\u4e86\u90a3\u4e9b\u597d\u5947\u7684\u4eba\u4ed6\u8bf4\uff0c\u53ef\u80fd\u662f\u88ab\u523a\u6fc0\u5230\u4e86\u4e0d\u8981\u518d\u8ba9\u5979\u60f3\u4e86\uff0c\u8ba9\u5979\u517b\u75c5\u5427\u4e8e\u662f\u4eba\u4eec\u4e5f\u6ca1\u6709\u518d\u95ee\u53ea\u662f\u516c\u5f00\u548c\u79d8\u5bc6\u5730\u90fd\u4ee5\u540c\u60c5\u7684\u53e3\u543b\u8c08\u8bba\u7740\u5979\u90a3\u4e00\u4e2a\u6625\u5929\uff0c \u662f\u5982\u6b64\u7684\u7f8e\u4e3d\u3002"}
{"translation": "\u3053\u306e\u5973\u6027\u306f\u305a\u3063\u3068\u81ea\u5206\u81ea\u8eab\u3068\u6226\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3059\u3067\u306b\u5e74\u8001\u3044\u3066\u3044\u305f\u3002"}
{"translation": "\u5168\u3066\u306e\u76ae\u819a\u304c\u3060\u3076\u3064\u3044\u3066\u3057\u307e\u3063\u3066\u304a\u308a\u3001\u304d\u3061\u3093\u3068\u3057\u305f\u4e00\u672c\u306e\u3057\u308f\u3055\u3048\u4f5c\u308c\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u9854\u3084\u9996\u306b\u306f\u7d30\u304b\u3044\u75d5\u8de1\u304c\u5bc6\u96c6\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u808c\u8272\u304c\u767d\u3044\u305f\u3081\u3001\u3053\u308c\u3089\u306e\u75d5\u8de1\u306f\u6642\u9593\u304c\u7121\u9020\u4f5c\u306b\u6398\u3063\u305f\u3082\u306e\u3067\u306f\u306a\u304f\u3001\u7d30\u7b46\u3067\u4e00\u3064\u4e00\u3064\u63cf\u304b\u308c\u3066\u51fa\u6765\u4e0a\u304c\u3063\u305f\u3088\u3046\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306e\u76ee\u3082\u3059\u3067\u306b\u6fc1\u3063\u3066\u304a\u308a\u307e\u3057\u305f\u304c\u7a81\u7136\u958b\u3051\u308b\u6642\u3001\u5149\u8292\u3092\u653e\u3061\u7d9a\u3051\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u6642\u3001\u5f7c\u5973\u306f\u56f0\u60d1\u3057\u305f\u8868\u60c5\u3092\u6d6e\u304b\u3079\u3001\u901a\u884c\u4eba\u3092\u898b\u3064\u3081\u3066\u3001\u4eba\u306b\u306f\u805e\u304d\u53d6\u308c\u306a\u3044\u4f55\u304b\u3092\u545f\u3044\u305f\u3002"}
{"translation": "\u81ea\u5206\u304c\u4f55\u3092\u8a00\u3063\u305f\u306e\u304b\u5f7c\u5973\u81ea\u8eab\u3082\u77e5\u3089\u306a\u3044\u3002"}
{"translation": "\u5b9f\u969b\u306f\u3001\u5f7c\u5973\u304c\u8003\u3048\u3066\u3044\u308b\u3053\u3068\u3055\u3048\u5f7c\u5973\u81ea\u8eab\u304c\u308f\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u591a\u304f\u306e\u5947\u5999\u306a\u3082\u306e\u304c\u5916\u306b\u98db\u3073\u51fa\u305d\u3046\u3068\u596e\u95d8\u3057\u3066\u304a\u308a\u3001\u305d\u308c\u3089\u304c\u5f7c\u5973\u306e\u8a18\u61b6\u3092\u63bb\u304d\u7acb\u3066\u3066\u308b\u3088\u3046\u3060\u3063\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u305d\u308c\u3089\u306f\u5168\u3066\u3001\u5f7c\u5973\u304c\u751f\u6daf\u89e6\u308c\u308b\u3053\u3068\u3092\u6b32\u3057\u306a\u304b\u3063\u305f\u3082\u306e\u3060\u3002"}
{"translation": "\u5fc5\u6b7b\u3067\u305d\u308c\u3089\u306b\u62b5\u6297\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u305d\u306e\u62b5\u6297\u306f\u5927\u304d\u306a\u7db2\u819c\u5efa\u7bc9\u7269\u3067\u3042\u3063\u3066\u6b63\u78ba\u3067\u3082\u98a8\u901a\u3057\u306a\u3069\u305b\u305a\uff0c\u307e\u308b\u3067\u60aa\u9b54\u4e00\u56e3\u4e2d\u3069\u3053\u3067\u3082\u771f\u3093\u4e2d\u304b\u3089\u7a81\u51fa\u3059\u308b\u6563\u767a\u3059\u308b\u3088\u3046\u3067\u3059\u4e9b\u7d30\u5225\u7247\u306b\u5305\u307e\u308c\u62ec\u308a\u66f8\u3057\u3044\u307e\u3059\u307e\u3057\u305f\u3002\u3002"}
{"translation": "\u3053\u306e\u4e00\u751f\uff0c\u5bc6\u5c01\u3055\u308c\u305f\u7db2\u3067\u306f\u3093\u9320\u4ed8\u820c\u5473\u4ea1\u6765\u984e\u6cbb\u3055\u3093\u820c \u596e\u96b7\u640f\u547d \u98a8\u6597\u3057\u3066\u904e\u3054\u3057\u305f\u63f4\u3059\u3067\u3059\u3002"}
{"translation": "\u592b\u304c\u751f\u304d\u3066\u3044\u308b\u9593\u3001\u5f7c\u5973\u306b\u601d\u8003\u3092\u8a66\u3057\u3066\u307f\u3088\u3046\u3068\u52e7\u3081\u305f\u3053\u3068\u304c\u3042\u3063\u305f\u3002"}
{"translation": "\u4f55\u304b\u65b0\u3057\u3044\u30a2\u30a4\u30c7\u30a2\u3092\u898b\u3064\u3051\u3089\u308c\u308c\u3070\u3001\u5fc3\u304c\u843d\u3061\u7740\u304f\u304b\u3082\u3057\u308c\u306a\u3044\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5f7c\u306e\u8a00\u8449\u3092\u805e\u304d\u5165\u308c\u3001\u81ea\u5206\u81ea\u8eab\u306b\u4e00\u5fc3\u4e0d\u4e71\u306b\u96c6\u4e2d\u3055\u305b\u3066\u601d\u8003\u3059\u308b\u3053\u3068\u306b\u6311\u6226\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u307b\u3093\u306e\u4e00\u77ac\u3067\u3001\u5168\u8eab\u304c\u30a4\u30e9\u30a4\u30e9\u611f\u3067\u92fc\u91dd\u306e\u3088\u3046\u306b\u7a81\u304d\u523a\u3055\u308c\u308b\u3088\u3046\u306a\u611f\u899a\u306b\u8972\u308f\u308c\u305f\u3002"}
{"translation": "\u3053\u308c\u307b\u3069\u306e\u5f37\u70c8\u306a\u885d\u6483\u306f\u5979\u53e3\u304b\u3089\u80f4\u4f53\u307e\u3067\u5f15\u304d\u88c2\u304b\u308c\u305f\u3088\u3046\u306a\u6c17\u6301\u3061\u3092\u3082\u305f\u3089\u3059\u3002"}
{"translation": "\u305d\u306e\u77ac\u9593\u3001\u5f7c\u5973\u306f\u6df1\u523b\u306a\u82e6\u75db\u3068\u75b2\u52b4\u611f\u304b\u3089\u606f\u7d76\u3048\u7d76\u3048\u3060\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u592b\u306e\u8a00\u8449\u306b\u5f93\u3063\u3066\u884c\u52d5\u3057\u3001\u6bce\u65e5\u5fd9\u3057\u304f\u904e\u3054\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u5b9f\u969b\u3001\u5f7c\u5973\u306b\u306f\u7279\u5225\u306a\u4ed5\u4e8b\u306a\u3069\u306a\u304f\u3001\u5f7c\u5973\u306e\u4ed5\u4e8b\u3068\u306f\u5bb6\u4e8b\u3092\u3059\u308b\u3053\u3068\u3060\u3063\u305f\u3002"}
{"translation": "\u6bce\u65e5\u6383\u9664\u3084\u6d17\u6fef\u306b\u5fd9\u3057\u304f\u3066\u5bb6\u4e2d\u3092\u304d\u308c\u3044\u306b\u3057\u3066\u3044\u305f\u3002"}
{"translation": "\u8ab0\u3082\u304c\u5f7c\u5973\u306e\u5bb6\u3092\u898b\u3066\u3001\u300c\u3046\u3061\u3083\u3059\u3054\u304f\u304d\u308c\u3044\u3060\u306d\u300d\u3068\u8a00\u3063\u3066\u304f\u308c\u308b\u3002"}
{"translation": "\u305d\u3057\u3066\u3001\u305d\u306e\u3053\u3068\u304c\u592b\u3067\u3042\u308b\u533b\u8005\u306e\u8a87\u308a\u3067\u3082\u3042\u3063\u305f\u3002"}
{"translation": "\u305d\u3093\u306a\u5177\u5408\u3067\u3001\u5f7c\u5973\u306e\u751f\u6d3b\u306f\u5f90\u3005\u306b\u6b63\u5e38\u5316\u3057\u59cb\u3081\u3066\u3044\u305f\u3002"}
{"translation": "\u4f55\u5e74\u3082\u7d4c\u3064\u3046\u3061\u306b\u3001\u5f7c\u5973\u306f\u305d\u306e\u3088\u3046\u306a\u751f\u6d3b\u3092\u7d9a\u3051\u3066\u6765\u305f\u3002"}
{"translation": "\u305d\u308c\u305e\u308c\u306e\u5e74\u304c\u5fae\u7d30\u3067\u5805\u56fa\u306a\u819c\u3068\u306a\u308a, \u5f7c\u5973\u306e\u8a18\u61b6\u80cc\u5f8c\u306b\u3042\u308b\u4f55\u304b\u3092\u5c64\u5c64\u8986\u76d6\u3057\u305f\u5f62\u8de1\u3060\u3063\u305f\u3002"}
{"translation": "\u300c\u4e00\u5e74\u4e00\u5e74\uff0c\u6b73\u6708\u98a8\u5149\uff0c\u7531\u8584\u800c\u539a\uff0c\u51dd\u7d50\u6210\u677f\u300d\u610f\u8b58\u6df1\u90e8\u7684\u72e1\u9b54\u5168\u88ab\u58d3\u5236\u4e0b\u4f86\u4e86\u3002"}
{"translation": "\u5039\u662f\u4e9b\u751a\u9ebd\u5462\uff1f"}
{"translation": "\u5979\u81ea\u5df1\u4e5f\u5b8c\u5168\u4e0d\u77e5\u9053\u3002\u3002\u3002"}
{"translation": "1952 \u5e74\u6625\u5929\uff0c\u5979\u5931\u53bb\u4e86\u8a18\u61b6\u529b\u3002\u3002\u3002"}
{"translation": "\u5f7c\u5973\u306f\u305d\u308c\u304c\u592b\u306e\u6170\u3081\u3068\u6ce8\u610f\u559a\u8d77\u3067\u3042\u308b\u3053\u3068\u3092\u611f\u3058\u53d6\u308b\u3053\u3068\u306f\u3067\u304d\u305a\u3001\u5fc3\u306e\u4e2d\u3067\u3080\u3057\u308d\u5f37\u304f\u52d5\u63fa\u3057\u305f\u3002"}
{"translation": "\u307e\u308b\u3067\u96a0\u308c\u3066\u30ae\u30ea\u30ae\u30ea\u6d88\u3048\u305d\u3046\u306a\u6575\u305f\u3061\u306f\u3001\u3059\u3067\u306b\u5f7c\u5973\u306e\u592b\u304c\u638c\u63e1\u3057\u3066\u3044\u308b\u304b\u306e\u3088\u3046\u3060\u3002"}
{"translation": "\u305d\u308c\u3089\u306f\u4e00\u4f53\u4f55\u306a\u306e\u3060\u308d\u3046\uff1f"}
{"translation": "\u79c1\u304c\u77e5\u3089\u306a\u3044\u4f55\u304b\u3092\u5f7c\u306f\u77e5\u3063\u3066\u3044\u308b\u3060\u308d\u3046\u304b\uff1f"}
{"translation": "\u305d\u3093\u306a\u8003\u3048\u306b\u81f3\u3063\u305f\u77ac\u9593\u3001\u6050\u6016\u611f\u3055\u3048\u3082\u76f4\u6483\u3059\u308b\u3002"}
{"translation": "\u305d\u306e\u6050\u6016\u611f\u306f\u5e38\u306b\u5f7c\u5973\u306e\u508d\u306b\u5b58\u5728\u3057\u305f\u3002"}
{"translation": "\u663c\u3082\u591c\u3082\u523b\u3005\u3068\u3002"}
{"translation": "\u305d\u3057\u3066\u5f7c\u5973\u306f\u7406\u89e3\u3057\u305f\u3001\u9577\u5e74\u611b\u3057\u3066\u304d\u305f\u3053\u306e\u4eba\u304c\u540c\u6642\u306b\u6700\u3082\u6050\u308c\u3066\u3044\u305f\u5b58\u5728\u3067\u3082\u3042\u3063\u305f\u4e8b\u5b9f\u3092\u3002"}
{"translation": "\u3069\u3046\u3057\u3066\u306a\u3093\u3060\u308d\u3046\uff1f\u3069\u3046\u3057\u3066\u3053\u3093\u306a\u6c17\u6301\u3061\u306b\u306a\u3063\u3066\u3057\u307e\u3063\u305f\u3093\u3060\u308d\u3046\uff1f"}
{"translation": "\u5f7c\u5973\u306f\u6df7\u4e71\u3057\u5206\u304b\u3089\u305a\u6238\u60d1\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u3067\u3082\u305d\u306e\u6c17\u6301\u3061\u306f\u78ba\u304b\u306b\u5b58\u5728\u3059\u308b\u3002"}
{"translation": "\u7a93\u306e\u5916\u306e\u6843\u306e\u6728\u306f\u4e00\u9762\u306b\u30d4\u30f3\u30af\u8272\u306e\u82b1\u304c\u3064\u3044\u3066\u3044\u308b\u3002"}
{"translation": "\u4e2d\u5ead\u306e\u58c1\u969b\u306b\u690d\u3048\u3089\u308c\u305f\u674f\u306e\u82b1\u3082\u4e00\u5217\u767d\u304f\u54b2\u304d\u8a87\u308a\u3001\u305d\u306e\u767d\u3055\u304c\u58c1\u3068\u878d\u3051\u5408\u3063\u3066\u9060\u304f\u304b\u3089\u306f\u82b1\u8272\u3092\u898b\u5206\u3051\u3089\u308c\u306a\u3044\u3002"}
{"translation": "\u66f4\u306b\u9060\u304f\u3001\u5e7e\u672c\u304b\u306e\u8001\u9280\u674f\u304c\u7dd1\u8272\u306a\u8449\u3092\u63fa\u3089\u3057\u3066\u304a\u308a\u3001\u305d\u306e\u592a\u304f\u9811\u4e08\u306a\u5e79\u304b\u3089\u4f55\u5e74\u3082\u524d\u306b\u690d\u3048\u3089\u308c\u305f\u304b\u60f3\u50cf\u3059\u308b\u3053\u3068\u3059\u3089\u3067\u304d\u306a\u3044\u3002"}
{"translation": "\u3088\u308a\u9060\u304f\u3078\u76ee\u3092\u901a\u305b\u3070\u3001\u5c71\u3005\u304c\u512a\u96c5\u306b\u9023\u306a\u3063\u3066\u304a\u308a\u305d\u306e\u5f62\u72b6\u306f\u307c\u3093\u3084\u308a\u3068\u3057\u305f\u82b1\u5f01\u3092\u601d\u308f\u305b\u308b\u3002"}
{"translation": "\u5ead\u5148\u9685\u3063\u3053\u306e\u8fce\u6625\u82b1\u306f\u307b\u3069\u306a\u304f\u67af\u308c\u305d\u3046\u3060\u304c\u3001\u9bae\u3084\u304b\u306a\u9ec4\u8272\u3044\u82b1\u3005\u306f\u4eca\u3067\u3082\u660e\u308b\u3055\u3092\u5bbf\u3057\u3066\u5149\u3063\u3066\u3044\u308b \u3002"}
{"translation": "\u4e94\u5149\u5341\u8272\u9000\u51fa\u7684\u8272\u5f69\u771f\u662f\u7f51\u773c\u798f\uff0c\u6625\u56de\u6e38\u8361\u4e2d\u7684\u5c0f\u9e1f\u6b64\u523b\u4f3c\u4e4e\u500d\u52a0\u6d3b\u6cfc\u8d77\u6765 \uff0c\u5c3d\u7ba1\u98ce\u7565\u5e26\u51c9\u610f\uff0c\u4f46\u5b83\u4eec\u4f9d\u7136\u5728\u8fd9\u5fae\u5bd2\u7684\u98ce\u4e2d\u5c3d\u60c5\u6b4c\u5531, \u8fd9\u69d8\u7f8e\u666f\u3053\u308c\u3089\u548c\u97f3\u5728\u8fd9\u6837\u7f8e\u666f\u548c\u58f0\u8f7b\u97f3\u4e4b\u4e0b,\u5f7c\u5973\u3086\u3063\u304f\u308a\u3068\u5e73\u548c\u306b\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u5f7c\u5973\u3092\u6025\u6d41\u304b\u3089\u5f15\u304d\u4e0a\u3052\u305f\u3068\u304d\u3001\u5f7c\u5973\u306f\u5168\u88f8\u3060\u3063\u305f\u3002"}
{"translation": "\u982d\u304b\u3089\u8db3\u307e\u3067\u3001\u4f53\u4e2d\u306b\u50b7\u304c\u3042\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u5ca9\u77f3\u3068\u6fc0\u6d41\u306e\u885d\u7a81\u304c\u3082\u305f\u3089\u3057\u305f\u7d50\u679c\u3060\u308d\u3046\u3002"}
{"translation": "\u5f7c\u5973\u3092\u6551\u51fa\u3057\u305f\u4eba\u3005\u306f\u3001\u6c34\u304c\u5f7c\u5973\u306e\u4f53\u3092\u771f\u3063\u767d\u306b\u67d3\u3081\u3066\u3057\u307e\u3044\u3001\u9ed2\u3044\u9aea\u3060\u3051\u304c\u6b8b\u3063\u3066\u304a\u308a\u3001\u4e00\u76ee\u898b\u305f\u3060\u3051\u3067\u306f\u50b7\u304c\u3069\u3053\u306b\u3042\u308b\u306e\u304b\u3059\u3050\u306b\u306f\u308f\u304b\u3089\u306a\u304b\u3063\u305f\u3068\u8a00\u3063\u305f\u3002"}
{"translation": "\u5e78\u904b\u306a\u3053\u3068\u306b\u8fd1\u304f\u306e\u6751\u3067\u8ecd\u533b\u6570\u4eba\u304c\u8a3a\u5bdf\u3057\u3066\u3044\u3066\u3001\u5f7c\u3089\u306f\u3059\u3050\u306b\u305d\u3053\u3078\u5f7c\u5973\u3092\u9023\u308c\u3066\u884c\u3063\u305f\u3002"}
{"translation": "\u5fdc\u6025\u51e6\u7f6e\u5f8c\u3001\u533b\u5e2b\u9054\u306f\u901f\u3084\u304b\u306b\u5f7c\u5973\u3092\u75c5\u9662\u3078\u9023\u308c\u623b\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u304c\u610f\u8b58\u3092\u53d6\u308a\u623b\u3059\u307e\u3067\u75c5\u9662\u3067\u534a\u6708\u4ee5\u4e0a\u304b\u304b\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u304c\u610f\u8b58\u8fd4\u3057\u4ed6\u4eba\u306e\u8cea\u554f\u3057\u3088\u3046\u8a66\u307f\u308b\u6642\u7a81\u7136\u30ac\u30c3\u30ab\u30ea\u9854\u305b\u3055\u308c\u307e\u3057\u305f\u3002"}
