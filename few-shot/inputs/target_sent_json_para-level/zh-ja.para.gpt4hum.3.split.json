{"translation": "\u305d\u308c\u304b\u3089\u305a\u3063\u3068\u9577\u3044\u6642\u9593\u304c\u7d4c\u3063\u305f\u3042\u308b\u65e5\u3001\u5f7c\u5973\u306e\u592b\u306f\u75c5\u9662\u304b\u3089\u5e30\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u5f7c\u306e\u8868\u60c5\u306f\u771f\u5263\u3067\u3001\u300c\u6587\u5316\u5927\u9769\u547d\u300d\u304c\u8d77\u3053\u308a\u3001\u75c5\u9662\u3067\u306f\u6bce\u65e5\u96c6\u4f1a\u304c\u958b\u304b\u308c\u3066\u304a\u308a\u3001\u307e\u305f\u5f7c\u306b\u3064\u3044\u3066\u591a\u304f\u306e\u30d3\u30e9\u3082\u66f8\u304b\u308c\u3066\u3044\u308b\u3068\u8a9e\u3063\u305f\u3002"}
{"translation": "\u305d\u306e\u30d3\u30e9\u306b\u3088\u308b\u3068\u3001\u5f7c\u306e\u904e\u53bb\u306b\u554f\u984c\u304c\u3042\u308b\u3089\u3057\u3044\u3002"}
{"translation": "\u5f7c\u5973\u306f\u975e\u5e38\u306b\u56f0\u60d1\u3057\u3066\u304a\u308a\u3001\u592b\u304c\u3053\u308c\u3092\u8a71\u3059\u610f\u5473\u3092\u7406\u89e3\u3067\u304d\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u7a81\u5982\u592b\u306f\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u541b\u306f\u4f55\u3082\u5fc3\u914d\u3057\u306a\u304f\u3066\u826f\u3044\u3093\u3060\u3088\u3001\u50d5\u304c\u541b\u3092\u5b88\u308b\u3055\u3002"}
{"translation": "\u904e\u53bb\u306e\u3053\u3068\u306f\u4e00\u751f\u601d\u3044\u51fa\u3055\u306a\u3044\u3067\u304f\u308c\u3002"}
{"translation": "\u6700\u5927\u306e\u6575\u3063\u3066\u3044\u3046\u306e\u306f\u5916\u90e8\u3067\u306f\u306a\u304f\u2026"}
{"translation": "\u5fd8\u308c\u53bb\u3089\u308c\u305f\u8a18\u61b6\u3060\u308d\u3046\u306d\u2026"}
{"translation": "\u8ab0\u304b\u304c\u8cea\u554f\u3057\u3066\u304d\u3066\u3082\u300c\u77e5\u3089\u306a\u3044\u300d\u3068\u7b54\u3048\u305f\u3060\u3051\u3067\u5927\u4e08\u592b\u3060\u3088\u300d"}
{"translation": "\u3042\u306a\u305f\u306f\u3069\u3053\u304b\u3089\u6765\u305f\u306e?\u3069\u306e\u6751\u306b\u4f4f\u3093\u3067\u308b\u306e\uff1f\u3042\u306a\u305f\u3001\u4f55\u6b73\uff1f\u3042\u306a\u305f\u306e\u5bb6\u306b\u4ed6\u306b\u8ab0\u304c\u3044\u308b\u3063\u3066\u3044\u3046\u306e\uff1f\u3069\u3046\u3057\u3066\u5ddd\u306b\u843d\u3061\u305f\u3093\u3067\u3059\u304b\uff1f"}
{"translation": "\u8239\u304c\u8ee2\u8986\u3057\u305f\u3001\u305d\u308c\u3068\u3082\u60aa\u3044\u4eba\u306b\u6295\u3052\u3089\u308c\u305f\u307f\u305f\u3044\u306a\u4e8b\u3067\u3082\u3042\u308a\u307e\u3057\u305f\u304b\uff1f"}
{"translation": "\u6c34\u6ca1\u8005\u306f\u3042\u306a\u305f\u3060\u3051\u3067\u3059\u304b\u3002"}
{"translation": "\u8cea\u554f\u304c\u6b21\u3005\u3068\u4ea4\u932f\u3057\u3001\u512a\u3057\u3044\u58f0\u3067\u3082\u305d\u306e\u4e00\u3064\u4e00\u3064\u304c\u92ed\u5229\u306a\u68d8\u3068\u5316\u3057\u3066\u8972\u3063\u3066\u304f\u308b\u3002"}
{"translation": "\u5f7c\u5973\u306e\u5fc3\u81d3\u306f\u77ac\u9593\u7684\u5730\u6fc0\u3057\u304f\u75db\u3080\u3002"}
{"translation": "\u5f7c\u5973\u306f\u30d9\u30c3\u30c9\u4e0a\u3067\u8eab\u3092\u4e38\u3081\u3066\u3059\u308b\u3063\u3068\u3057\u305f\u6241\u5e73\u5f62\u6210\u3057\u305f\u3002"}
{"translation": "\u305d\u3046\u3058\u3083\u3042\u308a\u307e\u3059\u306d\u3001\u79c1\u81ea\u8eab\u4f55\u51e6\u304b\u3089\u6765Activitiestive\u3059\u304b\u3002"}
{"translation": "\u79c1\u81ea\u8eab\u3069\u3053\u4f4f\u3093\u3067\u3044\u307e\u3059\u304b\u3002"}
{"translation": "\u79c1\u81ea\u8eab\u4f55\u3060\u3063\u3051\u3054\u540d\u524d\u30fc\u767a\u97f3\u3092\u5fd8\u308c\u307e\u3057\u304b\u3089\uff1f\u79c1\u30b9\u4e88\u544a\u901a\u308a\u600e\u4e48\u4f1a\u6389\u5ddd\u91cc\u5462\u308d\u3046\u5ddd\u3092\u6d41\u308c\u8fbc\u3093\u3060\u5834\u5408\u3082\u3042\u308a\u307e\u3059\u308f\u3051\u3067\u3059\u3088\u306d"}
{"translation": "\u30487 \u5f7c\u5973\u3059\u3063\u5b8c\u5168kaf\u9577\u661f\u8bb0\u5f97\u4e86\u5168\u90e8\u8b5c\u5370\u8c61\u3067\u306f\u5982\u4f55000 \u5f7c\u5973\u5373\u4fbfnejo\u8a08bupqui\u606f\u5b50\u3066\u3059\u308b\u9023Vintage Terra-\u30b3\u30eb\u30bf T\u30b7\u30e3\u30c4 L\u30b5\u30a4\u30ba\u30b8\u30e1\u30ec\u30b9\u30ab\u30e9\u30fc\u30ec\u30c3\u30c9tie Directory recall, even its own stuff \u5168\u7136\u5df2ins\u4e0d\u8d77\u306a\u304c\u3089\u5f7c\u5973\u30dd\u30fc\u30eb\u8a18naked\u7720\u308c\u308b\u3002\"]"}
{"translation": "\u5f7c\u5973\u306f\u672c\u5f53\u306b\u899a\u3048\u3066\u3044\u306a\u3044\u3002"}
{"translation": "\u305d\u306e\u305f\u3081\u3001\u4eba\u3005\u306f\u8a00\u3063\u305f\u3001\u300c\u601d\u3044\u51fa\u3057\u3066\u307f\u3066\u3001\u3088\u304f\u8003\u3048\u3066\u307f\u3066\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u5ddd\u304b\u3089\u5f15\u304d\u4e0a\u3052\u3089\u308c\u305f\u306e\u3060\u3088\u3002"}
{"translation": "\u5ddd\u3092\u982d\u306b\u601d\u6848\u3059\u308c\u3070\u3001\u4f55\u304b\u899a\u3048\u3066\u304f\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u300d"}
{"translation": "\u5f7c\u5973\u306f\u4eba\u3005\u306e\u8981\u6c42\u306b\u5f93\u3063\u3066\u3001\u3057\u3063\u304b\u308a\u3068\u601d\u3044\u8d77\u304a\u3046\u3068\u3057\u305f\u304c, \u5f7c\u5973\u306e\u601d\u8003\u304c\u5ddd\u8fba\u307e\u3067\u9054\u3059\u308b\u3068, \u3054\u3046\u3054\u3046\u3068\u97f3\u3092\u7acb\u3066\u308b\u6d41\u6c34\u306e\u97f3\u304c\u96f7\u9cf4\u306e\u3088\u3046\u306b\u8f5f\u304d\u59cb\u3081\u307e\u3059, \u7406\u7531\u3082\u306a\u304f\u6050\u6016\u611f\u304c\u3053\u306e\u6c34\u97f3\u3068\u5171\u306b\u8972\u3063\u3066\u6765\u308b\u3002"}
{"translation": "\u6ce2\u88cf\u3067\u306f\u307e\u308b\u3067\u9b3c\u795e\u304c\u96a0\u308c\u3066\u304a\u308a, \u76ee\u3067\u306f\u898b\u3048\u305a\u624b\u3067\u3082\u89e6\u308c\u3089\u308c\u306a\u3044\u304c\u5168\u8eab\u5168\u970a\u3092\u51b7\u3084\u6c57\u3067\u6e7f\u3089\u3059\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3059\u304f\u3080\u3057\u304b\u306a\u304f, \u6df1\u523b\u30ea\u6ce3\u304d\u53eb\u3076\u4e8b\u3057\u304b\u51fa\u6765\u305a\u3001\u305d\u306e\u58f0\u97f3\u306f\u30d2\u30b9\u30c6\u30ea\u30c3\u30af\u3055\u3060\u3063\u305f\u3002"}
{"translation": "\u3053\u306e\u5973\u6027\u306f\u3044\u3064\u3082\u81ea\u5206\u81ea\u8eab\u3068\u6226\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u3082\u3046\u9ad8\u9f62\u3060\u3002"}
{"translation": "\u3059\u3079\u3066\u306e\u76ae\u819a\u304c\u30c0\u30e9\u30ea\u3068\u305f\u308b\u3093\u3067\u3044\u3066\u3001\u304d\u3061\u3093\u3068\u3057\u305f\u4e00\u3064\u306e\u76ba\u3082\u5f35\u308a\u5207\u308c\u306a\u304f\u306a\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u5f7c\u5973\u306e\u9854\u3068\u9996\u306b\u306f\u7d30\u304b\u306a\u30b7\u30ef\u304c\u6e80\u3061\u3066\u304a\u308a\u3001\u808c\u304c\u767d\u304f\u900f\u660e\u611f\u304c\u3042\u308b\u305f\u3081\u3001\u3053\u308c\u3089\u306e\u75d5\u8de1\u306f\u6642\u9593\u306e\u5200\u306b\u3088\u3063\u3066\u9069\u5f53\u306b\u65ac\u3089\u308c\u305f\u3088\u3046\u3067\u306f\u306a\u304f\u3001\u3080\u3057\u308d\u7d30\u7b46\u3067\u4e00\u7b46\u4e00\u7b46\u63cf\u304d\u51fa\u3055\u308c\u305f\u3088\u3046\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306e\u76ee\u306f\u65e2\u306b\u304b\u3059\u3093\u3067\u3057\u307e\u3063\u3066\u3044\u308b\u304c\u3001\u7a81\u7136\u5927\u304d\u304f\u958b\u3051\u3070\u3001\u305d\u306e\u4e2d\u304b\u3089\u5149\u660e\u3092\u653e\u3064\u3053\u3068\u307e\u3060\u3042\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3057\u3070\u3057\u3070\u4f55\u304b\u3092\u3058\u3063\u3068\u898b\u3064\u3081\u3066\u30dc\u30fc\u3063\u3068\u3057\u3066\u304a\u308a\u3001\u3069\u3053\u304b\u8003\u3048\u4e8b\u3092\u3057\u3066\u3044\u308b\u3088\u3046\u3067\u3082\u3042\u308a\u4f55\u3082\u3059\u308b\u3053\u3068\u7121\u3055\u305d\u3046\u3067\u3082\u3042\u3063\u305f\u3002"}
{"translation": "\u305d\u306e\u69d8\u5b50\u306b\u6642\u6298\u901a\u884c\u4eba\u304c\u597d\u5947\u5fc3\u3092\u793a\u3057\u3001\u300c\u8001\u5a66\u4eba\u3055\u3093\u3001\u4f55\u3092\u8003\u3048\u3066\u3044\u307e\u3059\u304b\uff1f\u300d\u3068\u3046\u58f0\u3092\u639b\u3051\u3066\u304f\u308c\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u77ac\u9593\u3001\u5f7c\u5973\u306f\u832b\u7136\u3068\u3057\u305f\u9854\u3092\u3057\u3066\u901a\u884c\u4eba\u3092\u898b\u3064\u3081\u3001\u58f0\u304c\u805e\u3053\u3048\u306a\u3044\u307b\u3069\u306e\u5c0f\u3055\u306a\u58f0\u3067\u4f55\u304b\u3092\u545f\u304f\u3002"}
{"translation": "\u81ea\u5206\u304c\u4f55\u3092\u8a00\u3063\u305f\u306e\u304b\u5f7c\u5973\u81ea\u8eab\u3082\u5206\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u5b9f\u969b\u3001\u81ea\u5206\u304c\u4f55\u304b\u8003\u3048\u3066\u308b\u306e\u304b\u3082\u5f7c\u5973\u306b\u306f\u308f\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u5947\u5999\u306a\u7269\u4e8b\u304c\u5916\u5074\u306b\u5411\u3051\u3066\u5fc5\u6b7b\u306b\u98db\u3073\u51fa\u305d\u3046\u3068\u3057\u3066\u3044\u308b\u3088\u3046\u306a\u611f\u899a\u3060\u3051\u304c\u3042\u3063\u3066\u3001\u305d\u308c\u3089\u306f\u5f7c\u5973\u306e\u8a18\u61b6\u3092\u5f15\u304d\u3064\u3051\u3088\u3046\u3068\u3057\u3066\u3044\u308b\u3088\u3046\u3060\u3002"}
{"translation": "\u305d\u3057\u3066\u305d\u306e\u7269\u4e8b\u3053\u305d\u4e00\u751f\u6daf\u89e6\u308c\u305f\u304f\u3082\u7121\u304b\u3063\u305f\u7269\u4e8b\u3060\u30fc\u5f7c\u5973\u306f\u5fc5\u6b7b\u306b\u62b5\u6297\u3059\u308b\u3002"}
{"translation": "\u305d\u306e\u62b5\u6297\u306f\u5927\u304d\u306a\u30cd\u30c3\u30c8\u306e\u69d8\u3067\u3042\u308a\u98a8\u3082\u900f\u3051\u3066\u901a\u3089\u306c\u3070\u304b\u308a\u3067\u3042\u308a\u307e\u308b\u3067\u9b54\u9b3c\u7fa4\u304c\u9069\u6642\u7a81\u8cab\u3057\u3088\u3046\u3068\u3059\u308b\u72b6\u6cc1\u3092\u9589\u3058\u8fbc\u3081\u62d8\u675f\u3057\u306a\u3059\u985e\u4f3c\u3057\u305f\u5b58\u5728\u3060\u308d\u3046\u3002"}
{"translation": "\u4e00\u751f\u6daf\u3053\u306e\u30cd\u30c3\u30c8\u3092\u624b\u5143\u306b\u6301\u3061\u5e38\u6642\u6226\u95d8\u7684\u72b6\u6cc1\u5ea6\u3057\u3044\u3093\u3067\u306f\u3042\u3063\u305f\u304b\u3089\u3060\u3002"}
{"translation": "\u592b\u304c\u751f\u304d\u3066\u3044\u305f\u6642\u3001\u5f7c\u306f\u5f7c\u5973\u306b\u601d\u8003\u3092\u8a66\u307f\u308b\u3088\u3046\u306b\u63d0\u6848\u3057\u305f\u3053\u3068\u304c\u3042\u3063\u305f\u3002"}
{"translation": "\u4f55\u304b\u601d\u3044\u3064\u3051\u3070\u3001\u4eba\u306f\u6c17\u6301\u3061\u304c\u843d\u3061\u7740\u304f\u306e\u3067\u306f\u306a\u3044\u304b\u3068\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5f7c\u306e\u8a00\u8449\u306b\u5f93\u3046\u3064\u3082\u308a\u3067\u3001\u5fc3\u3092\u9759\u3081\u3066\u5f37\u304f\u601d\u3044\u8fd4\u3059\u3088\u3046\u81ea\u5206\u81ea\u8eab\u3092\u8feb\u3063\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u307b\u3093\u306e\u4e00\u77ac\u306e\u5f8c\u3001\u5168\u8eab\u304b\u3089\u7121\u6570\u306e\u92fc\u91dd\u304c\u5674\u51fa\u3059\u308b\u3088\u3046\u306a\u82db\u7acb\u3061\u304c\u6e67\u304d\u4e0a\u304c\u308a\u3001\u305d\u306e\u529b\u5f37\u3055\u306f\u6fc0\u3057\u304f\u5f7c\u5973\u3092\u4e94\u81d3\u516d\u8151\u307e\u3067\u5f15\u304d\u88c2\u304f\u611f\u3058\u3055\u305b\u3066\u3057\u307e\u3063\u305f\u3002"}
{"translation": "\u3053\u306e\u77ac\u9593\u3001\u5f7c\u5973\u306e\u82e6\u3057\u307f\u3068\u75b2\u308c\u65b9\u306f\u606f\u3082\u7d76\u3048\u7d76\u3048\u3060\u3063\u305f\u3002"}
{"translation": "\u300c\u79c1\u306b\u7121\u7406\u5f37\u3044\u3057\u306a\u3044\u3067\u300d\u3068\u592b\u3078\u7d76\u671b\u7684\u306a\u58f0\u3067\u8a00\u3063\u3066\u3001\u300c\u79c1\u306f\u8003\u3048\u308b\u3053\u3068\u304c\u3067\u304d\u306a\u3044\u300d\u300c\u8003\u3048\u59cb\u3081\u308b\u3068\u3046\u30fc\u3093\u6b7b\u306c\u3079\u304d\u3060\u300d\u300c\u3053\u3093\u306a\u6c17\u6301\u3061\u306f\u300d \u592b\u3082\u9a5a\u6050\u3057\u305f\u3002"}
{"translation": "\u300c\u305d\u3046\u3044\u3046\u308f\u3051\u306a\u3089\u3070\u3082\u3046\u4f55\u3082\u8003\u3048\u8fbc\u3080\u5fc5\u8981\u306f\u3042\u308a\u307e\u305b\u3093\u300d\u3068\u6c88\u9ed8\u3057\u3066\u304b\u3089\u5c0f\u3055\u3044\u300c\u3042\u308c\u3053\u308c\u5fd9\u3057\u5f15\u958b\u4e8b\u52d9\u3084\u7528\u52d9\u306b\u8208\u3058\u5de5\u5de7\u3067\u3082\u6c17\u3069\u308d\u9b44\u795e\u660e\u6563\u4e71\u3055\u305b\u308b\u300d"}
{"translation": "\u5f7c\u5973\u306f\u592b\u306e\u8a00\u8449\u306b\u5f93\u3063\u3066\u884c\u52d5\u3059\u308b\u305f\u3081\u3001\u6bce\u65e5\u5927\u5fd9\u3057\u3067\u3059\u3002"}
{"translation": "\u5b9f\u969b\u5f7c\u5973\u304c\u7d4c\u9a13\u3092\u7a4d\u3093\u3067\u304d\u305f\u4ed5\u4e8b\u3068\u3044\u3046\u3082\u306e\u306f\u7279\u306b\u306a\u304f\u3001\u5bb6\u4e8b\u304c\u5f7c\u5973\u306e\u8077\u696d\u3067\u3059\u3002"}
{"translation": "\u5f7c\u5973\u306f\u6bce\u65e5\u6383\u9664\u3084\u7247\u4ed8\u3051\u3092\u3057\u3066\u3001\u5bb6\u3092\u304d\u308c\u3044\u306b\u4fdd\u3064\u3053\u3068\u3067\u5fd9\u3057\u304f\u904e\u3054\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\u5973\u306e\u5bb6\u306b\u8a2a\u308c\u308b\u8005\u5168\u3066\u304c\u300c\u3042\u306a\u305f\u306e\u5bb6\u306f\u672c\u5f53\u306b\u6e05\u6f54\u3060\u300d\u3068\u53e3\u3092\u63c3\u3048\u3066\u8a00\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\u5973\u306e\u592b\u306f\u533b\u8005\u3067\u3042\u308a\u3001\u3053\u308c\u3092\u8a87\u308a\u306b\u601d\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u3046\u3057\u3066\u5c11\u3057\u305a\u3064\u5f7c\u5973\u306e\u751f\u6d3b\u3078\u3068\u623b\u3063\u3066\u3044\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5f7c\u306e\u306a\u3060\u3081\u308b\u8a00\u8449\u3084\u8b66\u544a\u3092\u5b9f\u611f\u3059\u308b\u3069\u3053\u308d\u304b\u3001\u5fc3\u306e\u4e2d\u304c\u6fc0\u3057\u304f\u52d5\u63fa\u3057\u305f\u3002"}
{"translation": "\u307e\u308b\u3067\u3001\u307b\u3068\u3093\u3069\u6d88\u3048\u3066\u3057\u307e\u3063\u305f\u304b\u306e\u3088\u3046\u306b\u601d\u308f\u308c\u305f\u6575\u304c\u3001\u3059\u3067\u306b\u592b\u306b\u652f\u914d\u3055\u308c\u3066\u3044\u308b\u304b\u306e\u3088\u3046\u3067\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u4e00\u4f53\u4f55\u306a\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u79c1\u81ea\u8eab\u3082\u77e5\u3089\u306a\u3044\u4e8b\u3092\u5f7c\u306f\u77e5\u3063\u3066\u3044\u308b\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u305d\u3093\u306a\u3053\u3068\u3092\u8003\u3048\u308b\u3068\u540c\u6642\u306b\u3001\u6050\u6016\u5fc3\u304c\u6b21\u7b2c\u306b\u8feb\u308a\u6765\u3066\u304d\u305f\u3002"}
{"translation": "\u3053\u306e\u6050\u6016\u611f\u306f\u5e38\u306b\u5f7c\u5973\u306e\u508d\u3089\u3067\u5b58\u5728\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u65e5\u3005\u591c\u3005\u3001\u6bce\u5206\u6bce\u79d2\u3002"}
{"translation": "\u305d\u306e\u7d50\u679c\u3001\u76ae\u8089\u306a\u3053\u3068\u3067\u306f\u3042\u308a\u307e\u3059\u304c\u9577\u5e74\u611b\u3057\u3066\u304d\u305f\u4eba\u7269\u304c\u4e3b\u56e0\u65e5\u304b\u3089\u59cb\u307e\u308a\u6b63\u6708\u6050\u6016\u5fc3\u3092\u62b1\u304f\u4eba\u7269\u3067\u3082\u3042\u3063\u305f\u7d2f\u7a4d\u901a\u5e74\u4e00\u89a7\u305d\u3057\u3066\uff1f\u3053\u308c\u4ee5\u4e0a\u540a\u5979\u4e3a\u4ec0\u4e48\u4f1a\u6709\u8fd9\u6837\u7684\u611f\u89c9\u5462\uff1f"}
{"translation": "\u5979\u5f88\u56f0\u6270\uff0c\u4e5f\u4e0d\u660e\u767d\u3002"}
{"translation": "\u4f46\u662f\uff0c\u8fd9\u79cd\u611f\u89c9\u5c31\u5728\u90a3\u91cc\u4e86"}
{"translation": "\u7a93\u306e\u5916\u306e\u6843\u306e\u6728\u306f\u982d\u304b\u3089\u8db3\u5143\u307e\u3067\u30d4\u30f3\u30af\u8272\u306e\u82b1\u3067\u3044\u3063\u3071\u3044\u3060\u3002"}
{"translation": "\u9662\u5185\u306b\u3042\u308b\u58c1\u969b\u306e\u674f\u82b1\u3082\u4e00\u5217\u306b\u767d\u304f\u306a\u308a\u3001\u305d\u306e\u767d\u3055\u304c\u767d\u3044\u58c1\u3068\u5408\u308f\u3055\u308a\u3001\u9060\u304f\u304b\u3089\u898b\u308b\u3068\u82b1\u8272\u304c\u5206\u304b\u3089\u306a\u3044\u307b\u3069\u3060\u3002"}
{"translation": "\u66f4\u306b\u9060\u304f\u3001\u6570\u672c\u306e\u8001\u9280\u674f\u304c\u7dd1\u6fc3\u3044\u8449\u3092\u63fa\u3089\u3057\u3001\u592a\u3081\u7acb\u6d3e\u306a\u5e79\u306f\u690d\u3048\u3089\u308c\u305f\u5e74\u3092\u63a8\u6e2c\u3059\u308b\u3053\u3068\u304c\u51fa\u6765\u307e\u305b\u3093\u3002"}
{"translation": "\u66f4\u306b\u3082\u3063\u3068\u9060\u304f, \u5c71\u3005\u306f\u305d\u3063\u3068\u6ce2\u6253\u3061\u3001\u305d\u306e\u8f2a\u90ed\u306f\u82b1\u5f01\u306e\u3088\u3046\u3067\u3059\u3002"}
{"translation": "\u5ead\u89d2\u3066\u304d\u305f\u3093\u307c\u76db\u5927\u660e\u308b\u308f\u304b\u3070\u3042\u304b\u3056\u30c1\u30e5\u30fc\u30ea\u30c3\u30d7\u30d1\u30f3\u6642\u30b0\u30e9\u30f3\u30d3\u30eb\u5c4b\u53f0\u4f38\u8a70\u3081\u7965\u6717\u6839\u83dc\u7d75\u9b8e\u30bb\u30fc\u30bf\u30fc\u5217\u78ef\u91e3\u6226\u5d0e\u9332\u30ef\u30a4\u30c9\u6d32\u6e58\u56fd\u8cab\u7435"}
{"translation": "\u5f7c\u5973\u3092\u6025\u6d41\u304b\u3089\u5f15\u304d\u4e0a\u3052\u305f\u3068\u304d\u3001\u5f7c\u5973\u306f\u5168\u88f8\u3060\u3063\u305f\u3002"}
{"translation": "\u982d\u304b\u3089\u3064\u307e\u5148\u307e\u3067\u3001\u4f53\u4e2d\u304c\u50b7\u3060\u3089\u3051\u3002"}
{"translation": "\u305d\u308c\u306f\u5ca9\u3068\u6fc0\u6ce2\u306e\u885d\u7a81\u306b\u3088\u308b\u3082\u306e\u3060\u3002"}
{"translation": "\u5f7c\u5973\u3092\u6551\u52a9\u3057\u305f\u4eba\u3005\u306f\u3001\u6c34\u304c\u5f7c\u5973\u306e\u4f53\u3092\u771f\u3063\u767d\u306b\u81a8\u3089\u307e\u305b\u3001\u982d\u9aea\u3057\u304b\u9ed2\u304f\u306a\u3044\u59ff\u3067\u50b7\u8de1\u304c\u3069\u3053\u306b\u3042\u308b\u304b\u4e00\u77ac\u3067\u306f\u898b\u5206\u3051\u304c\u3064\u304b\u306a\u3044\u3068\u8a00\u3063\u305f\u3002"}
{"translation": "\u5e78\u904b\u306a\u3053\u3068\u306b\u3059\u3050\u8fd1\u304f\u306e\u6751\u3067\u8ecd\u533b\u6570\u540d\u304c\u8a3a\u5bdf\u3057\u3066\u304a\u308a\u3001\u76f4\u63a5\u533b\u9662\u3078\u904b\u3070\u308c\u305f\u3002"}
{"translation": "\u6551\u6025\u624b\u5f53\u3066\u5f8c\u3001\u305d\u306e\u533b\u5e2b\u9054\u306f\u3059\u3050\u3055\u307e\u5f7c\u5973\u3092\u75c5\u9662\u3078\u9023\u308c\u5e30\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u534a\u6708\u4f59\u308a\u3082\u306e\u9593\u5165\u9662\u3057\u3088\u3046\u3084\u304f\u610f\u8b58\u3092\u53d6\u308a\u623b\u3057\u305f\u3002"}
{"translation": "\u76ee\u899a\u3081\u3066\u8cea\u554f\u3055\u308c\u308b\u4e8b\u614b\u306b\u76f4\u9762\u3059\u308b\u3068\u7a81\u7136\u9762\u98df\u3089\u3063\u3066\u3057\u307e\u3063\u305f"}
