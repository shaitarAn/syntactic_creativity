{"translation": "\u300c\u5f7c\u304c\u305d\u3053\u304b\u3089\u51fa\u3066\u304f\u308b\u308f\u3051\u304c\u306a\u3044\u3001\u304a\u308c\u304c\u8a00\u3063\u3066\u3084\u308b\u300d\u3068\u3001\u306b\u304d\u3073\u9762\u306e\u7537\u306f\u78ba\u4fe1\u306b\u6e80\u3061\u305f\u58f0\u3067\u9837\u304d\u306a\u304c\u3089\u8ff0\u3079\u305f\u3002"}
{"translation": "\u300c\u3082\u3046\u4e00\u6642\u959315\u5206\u3082\u305d\u3053\u306b\u5165\u308a\u3063\u3071\u306a\u3057\u3060\u3002"}
{"translation": "\u3082\u3046\u5f7c\u306e\u547d\u306f\u7d42\u308f\u308a\u3060\u308d\u3046\u300d"}
{"translation": "\u5e02\u6c11\u305f\u3061\u306f\u3001\u5ec3\u589f\u306e\u9593\u3067\u8eab\u3092\u5bc4\u305b\u5408\u3044\u3001\u53e3\u3092\u3064\u3050\u3093\u3067\u5730\u4e0b\u9053\u5165\u53e3\u306e\u57cb\u307e\u3063\u305f\u7164\u3051\u305f\u7a74\u3092\u898b\u3064\u3081\u3066\u3044\u305f\u3002"}
{"translation": "\u9ec4\u8272\u3044\u4e0a\u7740\u3092\u7740\u305f\u592a\u3063\u3061\u3087\u7537\u6027\u306f\u7247\u8db3\u304b\u3089\u4ed6\u65b9\u306e\u8db3\u3078\u3068\u4f53\u91cd\u3092\u79fb\u3057\u3001\u5589\u3092\u9cf4\u3089\u3057\u3066\u6f70\u308c\u304b\u304b\u3063\u305f\u30d9\u30ec\u30fc\u5e3d\u3092\u982d\u304b\u3089\u53d6\u308a\u4e0b\u3052\u308b\u3002"}
{"translation": "\u300c\u307e\u3060\u5f85\u3068\u3046\u300d\u3068\u5f7c\u306f\u73cd\u3057\u3044\u9854\u306b\u6c57\u3092\u62ed\u304d\u306a\u304c\u3089\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u4f55\u3092\u5f85\u3064\u306e\uff1f\u300d\u3068\u9762\u767d\u534a\u5206\u306b\u6c17\u96e3\u3057\u3044\u7537\u304c\u30d6\u30c4\u30d6\u30c4\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u30c0\u30f3\u30b8\u30e7\u30f3\u306b\u306f\u30d0\u30b8\u30ea\u30b9\u30af\u304c\u3044\u308b\u3002"}
{"translation": "\u5fd8\u308c\u307e\u3057\u305f\u304b\uff1f"}
{"translation": "\u753a\u9577\u3002"}
{"translation": "\u8ab0\u3067\u3082\u305d\u3053\u3078\u5165\u3063\u3066\u3057\u307e\u3046\u3068\u6700\u5f8c\u3060\u3088\u3002"}
{"translation": "\u4f55\u4eba\u3082\u306e\u4eba\u3005\u304c\u305d\u3053\u3067\u547d\u3092\u843d\u3068\u3057\u3066\u3044\u308b\u3058\u3083\u306a\u3044\u3067\u3059\u304b\uff1f"}
{"translation": "\u305d\u308c\u3067\u306f\u3001\u4f55\u3092\u5f85\u3064\u3093\u3067\u3059\uff1f\u79c1\u9054\u306f\u7d04\u675f\u3057\u305f\u3093\u3058\u3083\u3042\u308a\u307e\u305b\u3093\u304b\uff1f\u300d\u4e0d\u5b89\u3052\u306b\u592a\u3063\u305f\u7537\u304c\u4f4e\u304f\u3064\u3076\u3084\u3044\u305f\u3002"}
{"translation": "\u300c\u3069\u3046\u3044\u3046\u4e8b\u3060\uff1f"}
{"translation": "\u751f\u304d\u3066\u308b\u4eba\u9593\u3068\u3046\u308f\u3051\u3066\u7d04\u675f\u3057\u305f\u306e\u304b\u3001\u753a\u9577\u3088\u300d\u3068\u305d\u306e\u53b3\u683c\u306a\u7537\u306e\u4ef2\u9593\u3067\u3042\u308b\u5de8\u4f53\u306e\u9769\u56e3\u5b50\u30a8\u30d7\u30ed\u30f3\u7740\u7528\u8005\u304c\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u4eca\u3084\u5f7c\u306f\u6b7b\u3093\u3067\u3057\u307e\u3063\u3066\u6b21\u7b2c\u967d\u5149\u6e80\u5929\u3057\u3066\u663c\u9593\u53c2\u52e4\u7d9a\u884c\u3053\u3093\u8eab\u619a\u8cc7\u6e90\u81f3\u81f4\uff09\u3002"}
{"translation": "\u6700\u521d\u304b\u3089\u5f7c\u304c\u707d\u96e3\u306b\u906d\u3046\u4e8b\u3082\u308f\u304b\u3063\u3066\u3044\u307e\u3057\u305f\u3001\u305d\u306e\u524d\u306e\u8005\u9054\u307f\u305f\u304f\u3002"}
{"translation": "\u5b9f\u969b\u3001\u5f7c\u3055\u3048\u93e1\u7121\u3057\u3067\u884c\u304d\u6226\u7aef\u6a39\u8d77\u5177\u8db3\u5f93\u9806\u98e2\u6e07\u767b\u5742\u53ca\u4e00\u543b\u53ca\u9996\u5c3e\u6574\u5099\u8b19\u865a\u53d7\u5bb9\u66dd\u9732\u9806\u6b21\u5f15\u7528\u5145\u5217\u518d\u73fe\u643a\u884c\u4f1a\u5f97\u81e8\u60b6\u96f7\u96fb\u6fc0\u91cd\u524a\u6483\u96c6\u7d50\u5149\u660e\u9632\u72af\u66b4\u529b\u96e3\u4ee5\u507d\u5165\uff09\u3002"}
{"translation": "\u305d\u3057\u3066\u93e1\u7121\u3057\u3067\u30d0\u30b8\u30ea\u30b9\u30af\u3092\u5012\u3059\u4e8b\u306f\u51fa\u6765\u306a\u3044\u3001\u305d\u308c\u306f\u8ab0\u3067\u3082\u77e5\u3063\u3066\u308b\u4e8b\u3060\u3088\u3002"}
{"translation": "\u300c\u7bc0\u7d04\u3067\u304d\u305f\u306d\u3001\u3053\u306e\u91d1\u8ca8\u304c\u305f\u307e\u3063\u305f\u3068\u3044\u3046\u308f\u3051\u3060\u306a\u300d\u3061\u3087\u3093\u3061\u3083\u3089\u304a\u3084\u3058\u304c\u4ed8\u3051\u52a0\u3048\u305f\u3002"}
{"translation": "\u300c\u30d0\u30b8\u30ea\u30b9\u30af\u306e\u6599\u91d1\u3092\u6255\u3046\u4eba\u306a\u3093\u3066\u3044\u308b\u308f\u3051\u3082\u306a\u3044\u3002"}
{"translation": "\u5b89\u5fc3\u3057\u3066\u5bb6\u306b\u5e30\u3063\u3066\u304f\u308c\u3002"}
{"translation": "\u305d\u3057\u3066\u3001\u305d\u306e\u9b54\u5973\u306e\u99ac\u3084\u5bb6\u755c\u306f\u79c1\u305f\u3061\u304c\u5f15\u304d\u53d6\u308b\u3088\u3002"}
{"translation": "\u305d\u3046\u305b\u3056\u308b\u3092\u5f97\u306a\u3044\u3055\u3002\u3053\u3093\u306a\u304a\u5b9d\u3092\u653e\u3063\u3066\u304a\u304f\u624b\u306f\u7121\u3044\u304b\u3089\u306d\u300d"}
{"translation": "\u30d6\u30c3\u30c1\u30e3\u30fc\u304c\u9644\u548c\u3057\u305f\u3002"}
{"translation": "\u300c\u7acb\u6d3e\u306a\u96cc\u99ac\u3060\u3057\u3001\u30a2\u30d2\u30eb\u3082\u5341\u5206\u306b\u80a5\u3048\u3066\u3044\u308b\u3057\u306a\u3042\u3002"}
{"translation": "\u4e2d\u3092\u8997\u304d\u8fbc\u3093\u3067\u307f\u3088\u3046\u304b\uff1f\u3069\u3046\u3057\u3066?"}
{"translation": "\u4f55\u304b\u554f\u984c\u3067\u3082\uff1f\u300d"}
{"translation": "\u300c\u9759\u304b\u306b\u3057\u308d\u3001\u6751\u9577\u6bbf\uff01\u53e3\u51fa\u3057\u3059\u308b\u304b\u3089\u602a\u6211\u3059\u308b\u304b\u3089\u6c17\u3092\u3064\u3051\u3066\u304f\u3060\u3055\u3044\u300d\u3068\u30c1\u30e7\u30f3\u30c1\u30e3\u30e9\u30aa\u30e4\u30b8\u8b66\u544a\u3057\u305f\u3002"}
{"translation": "\u300c\u7acb\u6d32\u3060\u3068\u30d6\u30c3\u30c1\u30e3\u30fc\u306f\u7e70\u308a\u8fd4\u3059\u5143\u6c17\u4e00\u676f\u300d"}
{"translation": "\u300c\u3053\u306e\u7d20\u6575\u306a\u99ac\u3092\u653e\u3063\u3066\u304a\u304f\u308f\u3051\u306b\u306f\u884c\u304b\u305a\u611b\u60c5\u6df1\u3044\u53cb\u9054\u5168\u822c\u300d"}
{"translation": "\u3057\u304b\u3057\u5c60\u622e\u8005\u306f\u8a55\u5224\u6a4b\u58c1\u306e\u4e00\u90e8\u304b\u3089\u6765\u305f\u898b\u77e5\u3089\u306c\u7537\u6027\u306e\u65b9\u5411\u84ee\u8349\u5eb6\u6c11\u30c9\u30a2\u4e0b\u58eb\u5893\u8cb7\u3063\u76f4\u63a5\u540c\u65b9\u5411\u306b\u3042\u3063\u3068\u3044\u3046\u9593\u9023\u7d61\u96c6\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u898b\u77e5\u3089\u306c\u7537\u306f\u3001\u30ab\u30fc\u30ea\u30fc\u3067\u6fc3\u3044\u6817\u8272\u306e\u9aea\u3092\u6301\u3061\u3001\u8336\u8272\u306e\u30c1\u30e5\u30cb\u30c3\u30af\u3092\u91cd\u306d\u7740\u3057\u305f\u8863\u88c5\u306b\u9ad8\u3044\u4e57\u99ac\u7528\u30d6\u30fc\u30c4\u3092\u5c65\u3044\u3066\u3044\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u5f7c\u306b\u306f\u6b66\u5668\u306f\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u99ac\u304b\u3089\u96e2\u308c\u308d\u3001\u3068\u5f7c\u306f\u518d\u5ea6\u8a00\u3063\u305f\u3002"}
{"translation": "\u91ce\u86ee\u306a\u7b11\u307f\u3092\u6d6e\u304b\u3079\u306a\u304c\u3089\u3060\u3002"}
{"translation": "\u300c\u4f55\uff1f\u4ed6\u4eba\u306e\u99ac\u3001\u4ed6\u4eba\u306e\u8377\u7269\u3001\u4ed6\u4eba\u306e\u6240\u6709\u7269\u306b\u5bfe\u3057\u3066\u81ea\u5206\u306e\u8ca7\u5f31\u306a\u76ee\u7dda\u3092\u5411\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3060\u3051\u3067\u306a\u304f\u3001\u6c5a\u308c\u305f\u624b\u307e\u3067\u3082\u305d\u308c\u3089\u306b\u4f38\u3070\u3059\u3060\u3068\uff1f\u300d"}
{"translation": "\u305d\u3093\u306a\u3082\u3093\u304b\uff1f"}
{"translation": "\u30cb\u30ad\u30d3\u9762\u304c\u3086\u3063\u304f\u308a\u3068\u30b3\u30fc\u30c8\u306e\u5185\u5074\u304b\u3089\u624b\u3092\u51fa\u3057\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u304c\u8089\u5c4b\u73ed\u9577\u306b\u8996\u7dda\u3092\u9001\u308b\u3068\uff0c\u8089\u5c4b\u73ed\u9577\u306f\u9837\u304d\uff0c\u30b0\u30eb\u30fc\u30d7\u5074\u306b\u5408\u56f3\u3057\u305f\u3002"}
{"translation": "\u3059\u308b\u3068\u305d\u3053\u304b\u3089\u307e\u3060\u4e8c\u4eba, \u5c0f\u67c4\u3067\u4f53\u6bdb\u306e\u77ed\u3044\u7537\u6027\u304c\u51fa\u3066\u6765\u305f\u3002"}
{"translation": "\u4e8c\u4eba\u5171\u68cd\u68d2 \u3092\u6301\u3063\u3066\u304a\u308a, \u305d\u308c\u3053\u305d\u559c\u6368\u5c4b\u3067\u52d5\u7269\u9054\u3092\u660f\u5012\u3055\u305b\u308b\u3088\u3046\u4f7f\u3046\u9053\u5177\u3060\u3063\u305f\u3002"}
{"translation": "\u300c\u8ab0\u3060\u3001\u304a\u524d\u305f\u3061\u306f\uff1f\u300d\u3068\u30cb\u30ad\u30d3\u9854\u304c\u554f\u3046\u305f\u3002"}
{"translation": "\u5f7c\u306f\u814b\u304b\u3089\u624b\u3092\u51fa\u3057\u3066\u6328\u62f6\u3082\u3057\u306a\u3044\u3002"}
{"translation": "\u300c\u4f55\u304c\u8a31\u3055\u308c\u3066\u3001\u4f55\u304c\u8a31\u3055\u308c\u306a\u3044\u306e\u304b\u3092\u6559\u3048\u308d\u3063\u3066\u3053\u3068\u304b\uff1f"}
{"translation": "\u304a\u524d\u306b\u95a2\u4fc2\u306a\u3044\u305c\u3001\u7f8e\u7537\u5b50\u3055\u3093\u3002"}
{"translation": "\u6b66\u5668\u306f\u6301\u3063\u3066\u306a\u3044\u3093\u3060\u308d\uff1f\u300d\u898b\u77e5\u3089\u306c\u7537\u306f\u3055\u3089\u306b\u51b7\u3084\u3084\u304b\u306b\u7b11\u3063\u305f\u3002"}
{"translation": "\u300c\u6301\u3063\u3066\u306a\u3044\u3055\u300d\u305d\u308c\u306f\u3088\u304f\u306a\u3044\u3068\u30cb\u30ad\u30d3\u9854\u306f\u814b\u304b\u3089\u624b\u3092\u51fa\u3057\u3001\u305d\u306e\u624b\u306b\u9577\u5263\u306e\u3088\u3046\u306a\u30ca\u30a4\u30d5\u304c\u63e1\u3089\u308c\u3066\u3044\u305f\u3002"}
{"translation": "\u300c\u541b\u9054\u304c\u6b66\u5668\u3092\u6301\u3063\u3066\u3044\u306a\u3044\u4e8b\u5b9f\u3001\u305d\u308c\u306f\u975e\u5e38\u306b\u60aa\u4e8b\u3060\u300d\u8089\u5c4b\u3082\u307e\u305f\u30ca\u30a4\u30d5\u3092\u5f15\u304d\u629c\u304d\u51fa\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u3082\u9577\u5263\u306e\u3088\u3046\u3067\u3042\u308b\u3002"}
{"translation": "\u5f8c\u65b9\u304b\u3089\u4ed6\u306e\u4e8c\u4eba\u3082\u8ac7\u7b11\u3057\u306a\u304c\u3089\u524d\u9032\u3057\u3001\u68cd\u68d2\u30e9\u30a4\u30ba\u3057\u3066\u6765\u308b\u3002"}
{"translation": "\u300c\u79c1\u306f\u6b66\u5668\u3092\u6301\u3064\u5fc5\u8981\u304c\u7121\u304f\u300d\u3068\u898b\u77e5\u3089\u306c\u7537\u8a00\u3063\u305f\u3001\u300c\u79c1\u306e\u6b66\u5668\u306f\u81ea\u5206\u3067\u52d5\u304f\u300d"}
{"translation": "\u907a\u8de1\u306e\u5411\u3053\u3046\u304b\u3089\u3001\u3084\u308f\u3089\u304b\u306a\u3001\u78ba\u56fa\u305f\u308b\u30b9\u30c6\u30c3\u30d7\u3067\u4e8c\u4eba\u306e\u82e5\u3044\u5973\u6027\u304c\u73fe\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u3059\u3050\u306b\u7fa4\u8846\u306f\u5e83\u304c\u308a\u3001\u5f8c\u9000\u3057\u3001\u8584\u304f\u306a\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u4e21\u65b9\u306e\u5973\u6027\u306f\u6b6f\u3092\u898b\u305b\u3066\u7b11\u3063\u3066\u3044\u307e\u3057\u305f\u304c\u3001\u305d\u306e\u76ee\u3092\u7d30\u3081\u308b\u3068\u8cea\u7d20\u306a\u30bf\u30c8\u30a5\u30fc\u306e\u5e83\u3044\u9752\u307f\u304c\u304b\u3063\u305f\u6761\u7dda\u304c\u982c\u89d2\u304b\u3089\u8033\u307e\u3067\u8d70\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5f37\u5065\u306a\u592a\u3082\u3082\u306b\u4e00\u9762\u76ae\u819a\u3092\u8986\u3046\u7b4b\u8089\u306f\u660e\u77ad\u3067\u3042\u308a\u3001\u3059\u305d\u91ce\u6027\u7684\u30b9\u30ad\u30f3\u30ba\u3054\u3068\u9732\u51fa\u3057\u3066\u304a\u308a\u307e\u3059\u3002"}
{"translation": "\u307e\u305f\u88f8\u306e\u4e38\u307f\u3092\u5e2f\u3073\u305f\u8155\u4e0a\u90e8\u4e2d\u3067\u3082\u7b4b\u8089\u30d7\u30ec\u30a4\u3057\u3066\u304a\u308a\u307e\u3059\u9396\u5e37\u5b50\uff08\u30c1\u30a7\u30a4\u30f3\u30e1\u30fc\u30eb\uff09\u30c7\u30b3\u30ec\u30fc\u30b7\u30e7\u30f3\u3055\u308c\u305f\u30b0\u30ed\u30fc\u30d6\u304b\u3089\u3082\u4f3a\u3048\u307e\u3059\u3002"}
{"translation": "\u80a9\u7532\u9aa8\u4e0a\u90e8\u3067\u3082\u305d\u308c\u3089\u306f\u8997\u304d\u51fa\u3066\u304a\u308a\u3061\u3087\u3046\u3069\u5200\u67c4\u3068\u624b\u888b\u540c\u69d8\u306b\u3053\u3061\u3089\u3067\u3082\u539a\u307f\u3042\u308b\u93a7\u677f\u306b\u3088\u3063\u3066\u5236\u9650\u3055\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u306b\u304d\u3073\u3060\u3089\u3051\u306e\u7537\u304c\u3086\u3063\u304f\u308a\u3068\u819d\u3092\u66f2\u3052\u3001\u30ca\u30a4\u30d5\u3092\u5730\u9762\u306b\u843d\u3068\u3057\u305f\u3002"}
{"translation": "\u304c\u308c\u304d\u306e\u7a74\u304b\u3089\u77f3\u306e\u30b4\u30c8\u30b4\u30c8\u3068\u3057\u305f\u97f3\u304c\u805e\u3053\u3048\u3001\u305d\u306e\u5f8c\u3001\u6697\u95c7\u304b\u3089\u5272\u308c\u305f\u58c1\u306e\u4e0a\u90e8\u306b\u3057\u304c\u307f\u3064\u3044\u3066\u3044\u308b\u624b\u304c\u73fe\u308c\u305f\u3002"}
{"translation": "\u305d\u306e\u624b\u306e\u6240\u6709\u8005\u306f\u767d\u304f\u3001\u30ec\u30f3\u30ac\u7c89\u3067\u7c89\u5875\u306b\u306a\u3063\u305f\u9aea\u3001\u9752\u767d\u3044\u9854\u3092\u6b21\u3005\u306b\u73fe\u3057\u305f\u3002"}
{"translation": "\u80a9\u8d8a\u3057\u306b\u898b\u3048\u308b\u5263\u306e\u67c4\u3082\u4e00\u7dd2\u3060\u3002"}
{"translation": "\u7fa4\u8846\u304b\u3089\u3056\u308f\u3064\u304d\u304c\u8d77\u304d\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u304c\u732b\u80cc\u306b\u306a\u308a\u3001\u7a74\u304b\u3089\u5947\u5999\u306a\u5f62\u3001\u7570\u69d8\u306a\u4f53\u3092\u8840\u3067\u67d3\u307f\u4ed8\u3044\u305f\u5875\u306b\u57cb\u3082\u308c\u3066\u5f15\u3063\u5f35\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u5927\u304d\u304f\u9577\u3044\u30c8\u30ab\u30b2\u306e\u5c3e\u3092\u63b4\u3093\u3060\u602a\u7269\u3092\u7121\u8a00\u3067\u592a\u3081\u306e\u6751\u9577\u306e\u8db3\u5143\u306b\u6295\u3052\u843d\u3068\u3057\u305f\u3002"}
{"translation": "\u6751\u9577\u306f\u5f8c\u308d\u306b\u8df3\u306d\u3066\u884c\u304d\u3001\u5012\u308c\u305f\u58c1\u306e\u7834\u7247\u3092\u8e74\u3063\u3066\u3064\u307e\u305a\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u6e7e\u66f2\u3057\u305f\u9ce5\u985e\u306e\u304f\u3061\u3070\u3057\u3001\u76ae\u819c\u306e\u3088\u3046\u306a\u7fbd\u6839\u3001\u305d\u3057\u3066\u9c57\u3067\u8986\u308f\u308c\u305f\u722a\u5148\u306b\u306f\u6708\u578b\u5f15\u3063\u304b\u304d\u722a\u3092\u898b\u3064\u3081\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5143\u3005\u306f\u6df1\u7d05\u8272\u3060\u3063\u305f\u81a8\u3089\u3093\u3060\u5589\u4ecf\u73b0\u5728\u3067\u306f\u6c5a\u308c\u305f\u8336\u8272\u3067\u3059\u3002"}
{"translation": "\u900f\u660e\u611f\u3042\u308b\u9665\u6ca1\u3057\u305f\u773c\u5dee\u3057\u5fd7\u5411\u3051\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u300c\u3053\u3053\u306b\u30d0\u30b8\u30ea\u30b9\u30af\u304c\u3044\u307e\u3059\u300d"}
{"translation": "\u767d\u9aea\u306e\u7537\u304c\u3001\u30d1\u30f3\u30c4\u304b\u3089\u57c3\u3092\u6255\u3044\u306a\u304c\u3089\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u5951\u7d04\u901a\u308a\u3060\u3002"}
{"translation": "\u3082\u3057\u3088\u308d\u3057\u3051\u308c\u3070\u3001\u79c1\u306e200\u30ea\u30f3\u30bf\u30ed\u30fc\u3092\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u304d\u3061\u3093\u3068\u3057\u305f\u30ea\u30f3\u30bf\u30ed\u30fc\u3067\u3001\u305d\u308c\u307b\u3069\u53e4\u304f\u306a\u3044\u3082\u306e\u3092\u3002"}
{"translation": "\u78ba\u8a8d\u3059\u308b\u304b\u3089\u3001\u5148\u306b\u304a\u4f1d\u3048\u3057\u3066\u304a\u304f\u3002"}
{"translation": "\u6751\u9577\u306f\u624b\u304c\u9707\u3048\u306a\u304c\u3089\u8ca1\u5e03\u3092\u53d6\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u306f\u5468\u56f2\u3092\u898b\u6e21\u3057\u3001\u4e00\u77ac\u76ae\u819a\u75c5\u6301\u3061\u306e\u7537\u3068\u305d\u306e\u8db3\u5143\u306b\u3042\u308b\u30ca\u30a4\u30d5\u306b\u8996\u7dda\u3092\u6b62\u3081\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u8336\u8272\u3044\u30c1\u30e5\u30cb\u30c3\u30af\u59ff\u306e\u7537\u3068\u6bdb\u76ae\u670d\u88c5\u306e\u5973\u6027\u305f\u3061\u3092\u4e00\u77a5\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u3044\u3064\u3082\u306e\u3088\u3046\u306b\u3001\u9707\u3048\u308b\u6751\u9577\u306e\u624b\u304b\u3089\u5dee\u3057\u51fa\u3055\u308c\u305f\u91d1\u92ad\u3092\u53d7\u3051\u53d6\u3063\u305f\u3002"}
{"translation": "\u300c\u4ffa\u304c\u547d\u304c\u3051\u3067\u307b\u3093\u306e\u308f\u305a\u304b\u306a\u5831\u916c\u3092\u5f97\u3066\u3044\u308b\u9593\u3001\u304a\u524d\u305f\u3061\u306f\u4ffa\u306e\u54c1\u7269\u306b\u624b\u3092\u51fa\u3057\u3066\u308b\u3058\u3083\u306a\u3044\u304b\u3002"}
{"translation": "\u75c5\u6c17\u3067\u3082\u306a\u3063\u3066\u3082\u5909\u308f\u3089\u306a\u3044\u9023\u4e2d\u3060\u3002\u300d\u3068\u5f7c\u306f\u8a00\u3063\u305f\u3002"}
{"translation": "\u7fa4\u8846\u306e\u4e2d\u3067\u68cd\u68d2\u3092\u6301\u3063\u3066\u7acb\u3063\u3066\u3044\u305f\u8005\u9054\u306f\u3068\u3063\u304f\u306b\u898b\u3048\u306a\u304f\u306a\u3063\u3066\u3057\u307e\u3063\u305f\u3002"}
{"translation": "\u300c\u89e6\u308c\u3066\u307e\u305b\u3093\u3088\u3001\u65e6\u90a3\u69d8\u3002"}
{"translation": "\u300d\u767d\u9aea\u304c\u9837\u304d\u5fae\u7b11\u3057\u305f\u3002"}
{"translation": "\u300c\u3042\u3093\u305f\u306e\u7269\u306b\u306f\u4f55\u3082\u89e6\u308c\u3066\u307e\u305b\u3093\u304b\u3089\u306d\u300d"}
{"translation": "\u305d\u306e\u5fae\u7b11\u307f\u304c\u8584\u9854\u8272\u3067\u3082\u3058\u3083\u304f\u308a\u3068\u54b2\u304f\u59ff\u898b\u3064\u3081\uff0c\u7fa4\u8854\u65e9\u901f\u6563\u308a\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u3060\u304b\u3089\u5f1f\u3088\u3001\u3042\u3093\u305f\u3060\u3063\u3066\u50b7\u3064\u3051\u3089\u308c\u308b\u3053\u3068\u306f\u7121\u3044\u3055\u3002"}
{"translation": "\u5b89\u5fc3\u3057\u3066\u53bb\u3063\u3066\u884c\u304d\u306a\u3055\u3044\u3002\u3057\u304b\u3057\u6025\u3044\u3067\u884c\u304d\u3059\u304e\u308b\u3053\u3068\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3088\u300d\u3068\u5f7c\u306f\u8a00\u3063\u305f"}
