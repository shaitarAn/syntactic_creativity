{"translation": "\u524d\u8155\u306e\u4e0a\u306b\u984d\u3001\u751f\u3005\u3057\u3044\u30c6\u30ad\u30b9\u30c8\u306e\u4e0a\u306b\u982c\u304c\u89e6\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u673a\u306e\u6728\u6750\u304c\u79c1\u306e\u5fc3\u81d3\u306e\u9f13\u52d5\u3092\u5897\u5e45\u3057\u307e\u3059\u3002"}
{"translation": "\u53e4\u3044\u30a2\u30fc\u30eb\u30c7\u30b3\u8abf\u5bb6\u5177\u304c\u611f\u60c5\u3068\u75b2\u52b4\u611f\u3092\u3088\u308a\u5177\u4f53\u5316\u3055\u305b\u308b\u88dc\u52a9\u5f79\u3067\u3059\u3002"}
{"translation": "\u300c\u30eb\u30fc\u30eb\u30de\u30f3\u300d\u3001\u300c\u30ec\u30eb\u30fc\u300d\u3069\u3063\u3061\u3060\u308d\u3046\uff1f"}
{"translation": "\u4f55\u3082\u304b\u3082\u898b\u629c\u3044\u3066\u304d\u305d\u3046\u306a\u5bb6\u5177\u3067\u3059\u3002"}
{"translation": "\u5185\u5074\u3067\u97ff\u304d\u6e21\u308b\u81ea\u5206\u81ea\u8eab\u3067\u3082\u3042\u308b\u30cf\u30fc\u30c8\u30d3\u30fc\u30c8\u97f3\u58f0\u3068\u5411\u304d\u5408\u3046\u6642\u9593\u304c\u4eca\u65e5\u3082\u7d9a\u304d\u307e\u3059\u2026\u2026"}
{"translation": "\u7279\u306b\u91d1\u66dc\u65e5\u3067\u3042\u308a\u6c7a\u3057\u3066\u9759\u304b\u3055\u4e00\u8fba\u5012\u53ef\u80fd\u6027\u306f\u306a\u3044\u6751\u6c11\u5171\u6709\u5ea7\u5e2d\u4e2d\u67a2\u533a\u57df\u7684\u5f53\u524d\u65f6\u523b\u306f\u76ee\u4e0b\u5b64\u72ec\u306a\u5b58\u5728\u8005\u52a0\u7b46\u4fee\u6b63\u63d0\u793a\u8005\u9031\u672b\u643a\u5e2f\u6301\u53c2\u6a2a\u65ad\u97625%\u672a\u6e80\u7891\u6587\u5e02\u5916\u9ed2\u677f\u8d77\u8349\u4f1a\u793e\u5730\u57df\u7ec4\u7ec7\u306e\u5e8f\u5217\u533a\u5206\u3002"}
{"translation": "\u91d1\u66dc\u65e5\u306f\u79fb\u308a\u5909\u308f\u3089\u306a\u3044\u307e\u307e\u3067\u3002"}
{"translation": "\u305d\u308c\u306a\u3089\u77e5\u3063\u3066\u308b\u3093\u3060\u3002"}
{"translation": "\u3053\u308c\u3092\u3042\u306a\u305f\u306b\u6301\u3063\u3066\u304f\u308b\u3088\u3046\u306b\u8a00\u308f\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u4e00\u4f53\u4f55\u3067\u3059\u304b\uff1f"}
{"translation": "\u307e\u3042\u3001\u30ea\u30fc\u30c0\u30fc\u6a5f\u3001\u96fb\u5b50\u66f8\u7c4d\u3001iPad\u3001\u3069\u308c\u304b\u308f\u304b\u3089\u306a\u3044\u3067\u3059\u306d\u3002"}
{"translation": "\u5f7c\u306f\u3042\u306a\u305f\u306e\u3059\u3079\u3066\u306e\u539f\u7a3f\u3092\u9031\u672b\u306b\u8aad\u3080\u305f\u3081\u306b\u3053\u308c\u306b\u5165\u308c\u3066\u3044\u308b\u3068\u8a00\u3063\u3066\u307e\u3057\u305f\u3002"}
{"translation": "\u91cd\u3055\u3082\u6e1b\u308a\u307e\u3059\u3088\u3002"}
{"translation": "\u8aac\u660e\u3057\u307e\u3057\u3087\u3046\u304b\uff1f"}
{"translation": "\u898b\u3066\u304f\u3060\u3055\u3044\u3001\u3053\u308c\u306f\u753b\u9762\u3067\u3001\u305d\u306e\u4e0a\u306b\u3059\u3079\u3066\u306e\u539f\u7a3f\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u3089\u306f\u507d\u7269\u306e\u672c\u68da\u307f\u305f\u3044\u306a\u30d0\u30fc\u30c1\u30e3\u30eb\u30b7\u30a7\u30eb\u30d5\u4e0a\u306b\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u6307\u3067\u30bf\u30c3\u30c1\u3059\u308b\u3068\u958b\u3051\u307e\u3059\u3088\u3002"}
{"translation": "\u4f55\u518a\u3082\u3042\u308a\u307e\u3059\u3088\u3002"}
{"translation": "\u4e8c\u65e5\u9593\u3067\u5168\u90e8\u8aad\u307f\u7d42\u3048\u3089\u308c\u308b\u8a33\u3042\u308a\u307e\u305b\u3093\uff01"}
{"translation": "\u898b\u3066\u304f\u3060\u3055\u3044\u3001\u3001\u30c6\u30ad\u30b9\u30c8\u304c\u958b\u304d\u307e\u3059\u3088\u3002"}
