{"translation": "\u305d\u308c\u304b\u3089\u305a\u3063\u3068\u305a\u3063\u3068\u5f8c\u306e\u3042\u308b\u65e5\u3001\u5f7c\u5973\u306e\u592b\u304c\u75c5\u9662\u304b\u3089\u5e30\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u5f7c\u306f\u771f\u5263\u306a\u8868\u60c5\u3067\u3001\u300c\u6587\u5316\u5927\u9769\u547d\u300d\u304c\u59cb\u307e\u3063\u305f\u3068\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u75c5\u9662\u3067\u306f\u6bce\u65e5\u4f1a\u8b70\u304c\u958b\u304b\u308c\u3001\u307e\u305f\u3001\u5f7c\u306b\u5bfe\u3059\u308b\u6279\u5224\u306e\u30d3\u30e9\u3082\u51fa\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u3092\u805e\u3044\u3066\u5f7c\u5973\u306f\u4e0d\u5b89\u306b\u306a\u308a\u3001\u592b\u304c\u3053\u308c\u3089\u306e\u3053\u3068\u3092\u5f7c\u5973\u306b\u8a71\u3057\u3066\u3044\u308b\u610f\u5473\u304c\u308f\u304b\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u7a81\u7136\u592b\u306f\u3001\u300c\u541b\u306f\u5927\u4e08\u592b\u3060\u3088\u3001\u50d5\u304c\u5b88\u3063\u3066\u3042\u3052\u308b\u3002"}
{"translation": "\u6614\u306e\u3053\u3068\u306f\u3082\u3046\u601d\u3044\u51fa\u3055\u306a\u3044\u3067\u307b\u3057\u3044\u3002"}
{"translation": "\u4e00\u756a\u6016\u304f\u3066\u5371\u967a\u306a\u6575\u306f\u5916\u9762\u7684\u4eba\u9593\u3058\u3083\u306a\u304f\u3066\u3001\u5fd8\u308c\u53bb\u3089\u308c\u305f\u601d\u3044\u51fa\u3060\u308d\u3046\u300d\u3068\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u8ab0\u304b\u4f55\u304b\u805e\u3044\u3066\u304d\u3066\u3082\u3001\u300c\u4f55\u3067\u3082\u77e5\u3089\u3093\u300d\u3068\u7b54\u3048\u3088\u3046\u3059\u308c\u3070\u305d\u308c\u3067\u826f\u3044\u3093\u3060\u3088\u300d"}
{"translation": "\u3042\u306a\u305f\u306f\u3069\u3053\u51fa\u8eab\uff1f"}
{"translation": "\u4f55\u306e\u6751\u306b\u4f4f\u3093\u3067\u308b\u306e\uff1f"}
{"translation": "\u3042\u306a\u305f\u306f\u4f55\u6b73\uff1f"}
{"translation": "\u3042\u306a\u305f\u306e\u5bb6\u65cf\u306b\u306f\u3069\u3093\u306a\u4eba\u304c\u3044\u307e\u3059\u304b\uff1f"}
{"translation": "\u3069\u3046\u3057\u3066\u5ddd\u306b\u843d\u3061\u3066\u3057\u307e\u3044\u307e\u3057\u305f\u304b\uff1f"}
{"translation": "\u8239\u304c\u8ee2\u8986\u3057\u305f\u306e\u304b\u3001\u305d\u308c\u3068\u3082\u60aa\u4eba\u304c\u541b\u3092\u6295\u3052\u8fbc\u3093\u3060\u306e\u304b\uff1f"}
{"translation": "\u541b\u3060\u3051\u304c\u6c34\u6ca1\u3057\u305f\u3088\u3046\u3067\u3059\u3002"}
{"translation": "\u5834\u6240\u3092\u4ea4\u4ee3\u3057\u306a\u304c\u3089\u5974\u3089\u306f\u805e\u304f\u3001\u305d\u306e\u97f3\u58f0\u5f7c\u5973\u7684\u513f\u5c16\u75db\u7121\u6bd4\u3002"}
{"translation": "\u5f7c\u5973\u306f\u30d9\u30c3\u30c9\u3067\u4e38\u304f\u7e2e\u3053\u307e\u3063\u305f\u3002"}
{"translation": "\u305d\u3046\u601d\u3063\u3066\u3044\u308b\u6642\u3001\u79c1\u306f\u4e00\u4f53\u3069\u3053\u306e\u51fa\u8eab\u8005\u3060\u308d\u3046?"}
{"translation": "\u79c1\u304c\u4f4f\u3080\u5834\u6240\u3063\u3066\u4f55\u51e6\u3060\u308d\u3046?"}
{"translation": "\u81ea\u5206\u7684\u540d\u524d\u306a\u3093\u3066\u8a00\u3046\u3093\u3060\u3063\u3051?"}
{"translation": "\u305d\u306e\u5f8c\u5ddd\u306b\u843d\u3068\u3055\u308c\u308b\u4e8b\u614b\u3068\u6210\u3063\u3061\u3083\u3063\u305f\u308f\u3051?"}
{"translation": "\u5168\u7136\u601d\u3044\u51fa\u305b\u306a\u3044\u304b\u3089\u30fb\u30fb\u30fb"}
{"translation": "\u751a\u3084\u81ea\u5206\u3082\u540c\u3058\u3088\u306d\uff01"}
{"translation": "\u305d\u306e\u5f8c\u6211\u3005\u3059\u3059\u308a\u6ce3\u304d\u59cb\u3081\u307e\u3057\u305f \u3002"}
{"translation": "\u5f7c\u5973\u306e\u9854\u4ed8\u304d\u3001\u300c\u899a\u3048\u3066\u3044\u307e\u305b\u3093\u300d\u3001\u552f\u8a00\u8449\u805e\u3053\u3048\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u672c\u5f53\u306b\u601d\u3044\u51fa\u305b\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u3067\u4eba\u3005\u304c\u8a00\u3063\u305f\u3001\u300c\u3088\u304f\u8003\u3048\u3066\u3001\u3057\u3063\u304b\u308a\u3068\u8003\u3048\u3066\u307f\u3066\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u5ddd\u304b\u3089\u52a9\u3051\u51fa\u3055\u308c\u305f\u306e\u3067\u3059\u3002"}
{"translation": "\u5ddd\u3092\u8d77\u70b9\u306b\u8003\u3048\u3092\u8fbf\u308c\u3070\u3001\u601d\u3044\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u300d \u5f7c\u5973\u306f\u4eba\u3005\u306e\u8981\u6c42\u306b\u5f93\u3063\u3066\u3001\u771f\u5263\u306b\u601d\u3044\u8fd4\u3059\u3053\u3068\u306b\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057,\u601d\u616e\u304c\u5ddd\u8fba\u306b\u53ca\u3093\u3060\u969b\u3001\u30b6\u30b6\u30a1\u3068\u3044\u3046\u6c34\u97f3\u306f\u96f7\u9cf4\u306e\u3088\u3046\u306b\u8f5f\u304d,\u540d\u72b6\u3057\u304c\u305f\u3044\u6050\u6016\u611f\u304c\u6c34\u97f3\u3068\u5171\u306b\u62bc\u3057\u5bc4\u305b\u3066\u6765\u308b\u3002"}
{"translation": "\u6ce2\u6d9b\u306e\u4e2d\u3067\u306f\u307e\u308b\u3067\u9b54\u9b3c\u304c\u6f5c\u3093\u3067\u304a\u308a\uff0c\u898b\u3048\u305a\u89e6\u308c\u3089\u308c\u306a\u3044\u5b58\u5728\u3067\u3082\u3042\u308a\u307e\u3059\u304c\uff0c\u5f7c\u5973\u306e\u5fc3\u8eab\u3092\u8972\u3063\u3066\u304f\u308b\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3059\u3050\u3055\u307e\u5931\u63a7\u3057\u3066\u5927\u58f0\u3067\u6ce3\u304d\u53eb\u3073\u59cb\u3081\u3001\u305d\u306e\u58f0\u306f\u6b47\u65af\u5e95\u91cc\u3060\u3063\u305f\u3002"}
{"translation": "\u307e\u305f\u3053\u306e\u5642\u3092\u805e\u304d\u4ed8\u3051\u533b\u5e2b\u5434\u6c0f\u3055\u3093\u53b3\u683c\u7684\u5236\u6b62\u3057\u305f\u597d\u5947\u5fc3\u65fa\u76db\u306a\u4eba\u3005 \u3002"}
{"translation": "\u5f7c\u66f0\u304f\u300c\u5f7c\u5973\u672c\u4eba\u3082\u30b9\u30c8\u30ec\u30b9\u53cd\u5fdc\u3092\u793a\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3082\u3046\u305d\u308c\u4ee5\u4e0a\u601d\u308f\u305b\u306a\u304a\u9858\u3044\u3057\u307e\u3059\u3002"}
{"translation": "\u5f53\u9762\u5f7c\u5973\u75c5\u6c17\u6cbb\u3057\u7740\u91cd\u5916\u4ed6\u4f55\u3082\u52ff\u4f53\u7121\u3044\u300d\u3002"}
{"translation": "\u305d\u308c\u304b\u3089\u3001\u4eba\u3005\u306f\u3082\u3046\u4f55\u3082\u805e\u304b\u306a\u304f\u306a\u3063\u305f\u3002"}
{"translation": "\u305f\u3060\u3001\u5f7c\u5973\u306b\u5bfe\u3057\u3066\u306f\u5fae\u80de\u3059\u308b\u3088\u3046\u306a\u8abf\u5b50\u3067\u8a71\u3092\u3064\u3051\u307e\u3057\u305f\u3002"}
{"translation": "\u3042\u308c\u306f\u3068\u3066\u3082\u7f8e\u3057\u3044\u6625\u306e\u65e5\u3060\u3063\u305f\u3002"}
{"translation": "\u3053\u306e\u5973\u6027\u306f\u305a\u3063\u3068\u81ea\u5206\u81ea\u8eab\u3068\u6226\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3082\u3046\u9ad8\u9f62\u3060\u3002"}
{"translation": "\u5168\u3066\u306e\u808c\u304c\u67d4\u3089\u304b\u304f\u4f38\u3073\u3001\u4e00\u672c\u306e\u304d\u3061\u3093\u3068\u3057\u305f\u76ba\u3059\u3089\u6301\u3066\u4f59\u3057\u3066\u3057\u307e\u3046\u3002"}
{"translation": "\u5f7c\u5973\u306e\u9854\u3068\u9838\u90e8\u306b\u306f\u7d30\u304b\u3044\u50b7\u304c\u5bc6\u96c6\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u808c\u306e\u8272\u304c\u767d\u3044\u305f\u3081\u3001\u3053\u308c\u3089\u306e\u75d5\u8de1\u306f\u6642\u9593\u306e\u5200\u306b\u3088\u3063\u3066\u7121\u9020\u4f5c\u306b\u5f15\u304b\u308c\u305f\u3082\u306e\u3067\u306f\u306a\u304f\u3001\u3080\u3057\u308d\u7d30\u7b46\u3067\u4e00\u3064\u4e00\u3064\u63cf\u304b\u308c\u51fa\u3055\u308c\u305f\u3088\u3046\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306e\u76ee\u3082\u3059\u3067\u306b\u6fc1\u308a\u304d\u3063\u3066\u3057\u307e\u3063\u305f\u304c\u3001\u7a81\u7136\u8996\u7dda\u3092\u5e83\u3052\u308b\u3068\u5149\u304c\u653e\u51fa\u3055\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u898b\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3002"}
{"translation": "\u3057\u3070\u3057\u3070\u3069\u3053\u304b\u3092\u51dd\u8996\u3057\u3066\u7269\u601d\u3044\u306b\u3075\u3051\u308a\u3001\u601d\u7d22\u6df1\u305d\u3046\u3067\u3042\u308a\u306a\u304c\u3089\u53ad\u4e16\u611f\u6ea2\u308c\u3066\u307f\u3048\u308b\u59ff\u304b\u3089\u3001\u6642\u6298\u901a\u884c\u4eba\u3082\u8208\u5473\u6d25\u3005\u3067\u300c\u304a\u3070\u3042\u3055\u3093\u3001\u4f55\u3092\u8003\u3048\u3066\u3044\u307e\u3059\u304b\uff1f\u300d\u3068\u3046\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u201d"}
{"translation": "\u305d\u306e\u6642\u3001\u5f7c\u5973\u306f\u9014\u65b9\u306b\u66ae\u308c\u305f\u3088\u3046\u306a\u9854\u3092\u3057\u3001\u901a\u884c\u4eba\u3092\u3058\u3063\u3068\u898b\u3066\u3001\u805e\u3053\u3048\u306a\u3044\u58f0\u3067\u4f55\u304b\u3064\u3076\u3084\u304f\u3002"}
{"translation": "\u81ea\u5206\u304c\u4f55\u3092\u8a00\u3063\u305f\u306e\u304b\u81ea\u5206\u3067\u3082\u308f\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u5b9f\u969b\u3001\u5f7c\u5973\u81ea\u8eab\u3082\u8003\u3048\u3066\u3044\u308b\u306e\u304b\u3069\u3046\u304b\u3055\u3048\u3082\u5206\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u5f7c\u5973\u306f\u305f\u3060\u3001\u5947\u5999\u306a\u3082\u306e\u304c\u5916\u306b\u98db\u3073\u51fa\u305d\u3046\u3068\u3057\u3066\u304a\u308a\u3001\u305d\u308c\u3089\u304c\u5f7c\u5973\u306e\u8a18\u61b6\u3092\u63bb\u304d\u7acb\u3066\u308b\u3088\u3046\u306b\u611f\u3058\u305f\u3060\u3051\u3060\u3063\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u305d\u308c\u3089\u306f\u307e\u3055\u306b\u5f7c\u5973\u304c\u4e00\u751f\u89e6\u308c\u305f\u304f\u306a\u3044\u3082\u306e\u3067\u3042\u308b\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5fc5\u6b7b\u306b\u62b5\u6297\u3059\u308b\u3002"}
{"translation": "\u305d\u306e\u62b5\u6297\u306f\u5927\u304d\u306a\u7db2\u306e\u3088\u3046\u3067\u3042\u308a\u98a8\u3059\u3089\u901a\u3055\u305a\u9b54\u7269\u304c\u7a81\u7136\u8131\u51fa\u3057\u305d\u3046\u3068\u3057\u3066\u3044\u307e\u3059\u4ed6\u65b9\u3067\u79c1\u751f\u6d3b\u5168\u4f53\u3053\u306e\u4e2d\u592e\u673a\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u3002"}
{"translation": "\u592b\u304c\u751f\u5b58\u3057\u3066\u3044\u308b\u9593\u3001\u5f7c\u5973\u306b\u8003\u3048\u3066\u307f\u308b\u3088\u3046\u306b\u63d0\u6848\u3057\u305f\u3053\u3068\u304c\u3042\u3063\u305f\u3002"}
{"translation": "\u4f55\u304b\u3092\u601d\u3044\u51fa\u3059\u304b\u3082\u3057\u308c\u306a\u3044\u3001\u305d\u3057\u3066\u4eba\u306f\u5b89\u5fc3\u3059\u308b\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5f7c\u306e\u8a00\u8449\u3092\u805e\u304d\u5165\u308c\u3001\u81ea\u5206\u81ea\u8eab\u306b\u5fc3\u3092\u9759\u3081\u3066\u771f\u5263\u306b\u601d\u3044\u51fa\u305d\u3046\u3068\u3057\u305f\u3002"}
{"translation": "\u3057\u304b\u3057\u307b\u307c\u77ac\u6642\u306b\u3001\u4f53\u5168\u4f53\u306e\u30a4\u30e9\u30a4\u30e9\u304c\u7121\u6570\u306e\u92fc\u91dd\u306e\u3088\u3046\u306b\u98db\u3073\u6563\u308a\u3001\u305d\u306e\u529b\u5f37\u3055\u304c\u5f7c\u5973\u3092\u4e94\u81d3\u516d\u8151\u304c\u88c2\u3051\u308b\u3088\u3046\u306a\u75db\u307f\u3092\u611f\u3058\u3055\u305b\u305f\u3002"}
{"translation": "\u305d\u306e\u77ac\u9593\u3001\u5f7c\u5973\u306e\u75db\u307f\u3068\u75b2\u52b4\u306f\u606f\u82e6\u3057\u3055\u304b\u3089\u547c\u5438\u56f0\u96e3\u307e\u3067\u5f15\u304d\u8d77\u3053\u3057\u305f\u3002"}
{"translation": "\u300c\u3082\u3046\u8ffd\u308f\u306a\u3044\u3067\u300d\u3068\u7d76\u671b\u7684\u306a\u58f0\u3067\u592b\u306b\u8a00\u3063\u305f\u3001\u300c\u79c1\u306f\u8003\u3048\u3089\u308c\u307e\u305b\u3093\u3002"}
{"translation": "\u8003\u3048\u59cb\u3081\u308b\u3068\u81ea\u5206\u304c\u6b7b\u306c\u3079\u304d\u3060\u3068\u611f\u3058\u307e\u3059\u300d"}
{"translation": "\u592b\u306f\u6050\u6016\u3057\u3066\u30b9\u30c8\u30c3\u30d7\u3057\u305f\u3002"}
{"translation": "\u5c11\u3057\u6c88\u9ed8\u3057\u305f\u5f8c\u3001\u300c\u305d\u308c\u3067\u306f\u3082\u3046\u8003\u3048\u308b\u5fc5\u8981\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u53ef\u80fd\u306a\u9650\u308a\u4f55\u304b\u697d\u3057\u3080\u3053\u3068\u96c6\u4e2d\u3057\u307e\u3057\u3087\u3046\u3001\u5fd9\u3057\u3055\u306f\u601d\u8003\u3092\u4e71\u3059\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u300d\u3068\u8a9e\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u592b\u306e\u8a00\u8449\u306b\u5f93\u3063\u3066\u884c\u52d5\u3057\u3001\u6bce\u65e5\u5fd9\u3057\u304f\u904e\u3054\u3057\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5b9f\u969b\u3001\u5f7c\u5973\u306b\u306f\u4f55\u306e\u4ed5\u4e8b\u3082\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u4ed5\u4e8b\u306f\u5bb6\u4e8b\u3092\u3059\u308b\u3053\u3068\u3067\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u6bce\u65e5\u6383\u9664\u3084\u7247\u4ed8\u3051\u306b\u8ffd\u308f\u308c\u3001\u5bb6\u3092\u30d4\u30ab\u30d4\u30ab\u306b\u3057\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306e\u5bb6\u3092\u8a2a\u308c\u305f\u8ab0\u3082\u304c\u3001\u300c\u3042\u306a\u305f\u306e\u304a\u5b85\u306f\u672c\u5f53\u306b\u304d\u308c\u3044\u3067\u3059\u306d\u300d\u3068\u8a00\u3044\u307e\u3059\u3060\u308d\u3046\u3002"}
{"translation": "\u5f7c\u5973\u306e\u592b\u306f\u533b\u8005\u3067\u3042\u308a\u3001\u3053\u308c\u306b\u8a87\u308a\u3092\u6301\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u3053\u306e\u3088\u3046\u306a\u751f\u6d3b\u304c\u6b21\u7b2c\u306b\u6b63\u5e38\u5316\u3057\u3066\u3086\u304d\u307e\u3059\u3002"}
{"translation": "\u4f55\u5e74\u9593\u3082\u3001\u5f7c\u5973\u306f\u305a\u3063\u3068\u3053\u306e\u3088\u3046\u306a\u751f\u6d3b\u3092\u9001\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u305e\u308c\u306e\u5e74\u5ea6\u304c\u7cbe\u5bc6\u304b\u3064\u4e25\u683c\u306a\u819c\u3068\u306a\u308a, \u5f7c\u5973\u7684\u8a18\u61b6\u80cc\u5f8c\u7684\u4e1c\u897f\u88ab\u4e00\u5c64\u5c64\u8986\u76d6\u3002"}
{"translation": "\u5e74\u3005, \u8584\u539a\u4e0d\u65ad\u51dd\u7ed3\u6210\u677f\uff0c\u5979\u610f\u8b58\u5e95\u90e8\u6df1\u85cf\u7684\u9b3c\u795e\u90fd\u88ab\u5c01\u58d3\u4e86\u4e0b\u53bb\u3002"}
{"translation": "\u3067\u3082\u305d\u308c\u3089\u88ab\u58d3\u3055\u3048\u305f\u7269\u4f53\u0440\u0434\u043e\u0441\u043e\u0440\u0163f?"}
{"translation": "\u043e\u0435 \u043dmb \u0435\u043f\u03b1\u0458 \u0447\u0443\u0448gsfpltmove about freely in a sheafs/\u30fbo\u33c4\u91d1\u30ean\u7a40\u8c9dt\uff0c nire were not commodi\u6069\u304a\u30fc\u3058 at all in the house\u3002\\ oArgohat\u3002"}
{"translation": "But what were those things?"}
{"translation": "She had no idea\u3002"}
{"translation": "She lost her memory in the spring of 1952\u3002"}
{"translation": "\u5f7c\u5973\u306f\u3053\u308c\u304c\u592b\u304b\u3089\u306e\u6170\u3081\u3084\u6ce8\u610f\u3060\u3068\u306f\u611f\u3058\u305a\u3001\u3080\u3057\u308d\u5fc3\u306e\u4e2d\u3067\u5f37\u304f\u52d5\u63fa\u3057\u305f\u3002"}
{"translation": "\u307e\u308b\u3067\u5f7c\u5973\u306e\u592b\u304c\u624b\u306b\u5165\u308c\u305f\u3001\u79d8\u5bc6\u306b\u8fd1\u3044\u6d88\u3048\u305d\u3046\u306a\u6575\u305f\u3061\u304c\u3044\u308b\u3088\u3046\u306a\u6c17\u304c\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u4e00\u4f53\u4f55\u306a\u306e\u304b\uff1f"}
{"translation": "\u79c1\u304c\u77e5\u3089\u306a\u3044\u3053\u3068\u3092\u5f7c\u306f\u77e5\u3063\u3066\u3044\u308b\u306e\u304b\uff1f"}
{"translation": "\u3053\u306e\u8003\u3048\u3092\u6301\u3061\u3064\u3064\u3001\u6050\u6016\u611f\u304c\u3076\u3064\u304b\u3063\u3066\u304d\u3066\u3042\u305f\u308a\u4e00\u9762\u306b\u5e83\u304c\u3063\u305f\u3002"}
{"translation": "\u305d\u306e\u6050\u6016\u611f\u306f\u5f7c\u5973\u306e\u3059\u3050\u5074\u306b\u3042\u308a\u3001\u65e5\u3005\u591c\u3005\u5206\u79d2\u7a4d\u307f\u91cd\u306d\u3066\u3086\u304f\u3002"}
{"translation": "\u305d\u308c\u304b\u3089\u5f7c\u5973\u306f\u7406\u89e3\u3057\u305f\u3001\u9577\u5e74\u611b\u3057\u3066\u304d\u305f\u3053\u306e\u4eba\u7269\u3082\u307e\u305f\u6df1\u304f\u6050\u308c\u3066\u3044\u308b\u3082\u306e\u3060\u3068\u3044\u3046\u3053\u3068\u3092\u3002"}
{"translation": "\u3069\u3046\u3057\u3066\u305d\u3093\u306a\u98a8\u306b\u601d\u3063\u3066\u3057\u307e\u3046\u3093\u3060\u308d\u3046\uff1f"}
{"translation": "\u4f55\u6545\u3053\u3093\u306a\u60f3\u50cf\u3092\u62b1\u304f\u3093\u3060\u308d\u3046\uff1f"}
{"translation": "\u5f7c\u5973\u81ea\u8eab\u6df7\u4e71\u3057\u89e3\u305b\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "\u3051\u308c\u3069\u3082\u305d\u306e\u611f\u60c5\u3053\u305d\u771f\u5b9f\u3067\u3042\u3063\u305f\u3002"}
{"translation": "\u7a93\u306e\u5916\u306e\u6843\u306e\u6728\u306f\u82b1\u3073\u3089\u306b\u8986\u308f\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u9662\u5185\u306e\u58c1\u6cbf\u3044\u306b\u54b2\u304f\u674f\u306e\u82b1\u3082\u767d\u304f\u306a\u308a\u3001\u9060\u76ee\u3067\u898b\u308b\u3068\u767d\u3044\u58c1\u3068\u540c\u5316\u3057\u3066\u82b1\u8272\u304c\u533a\u5225\u3067\u304d\u307e\u305b\u3093\u3002"}
{"translation": "\u3055\u3089\u306b\u9060\u304f\u3067\u306f\u3001\u6570\u672c\u306e\u8001\u3044\u305f\u9280\u674f\u304c\u7dd1\u8272\u306b\u8f1d\u304f\u8449\u3092\u63fa\u3089\u3057\u3001\u592a\u304f\u5c79\u7acb\u3059\u308b\u5e79\u304b\u3089\u305d\u306e\u690d\u6a39\u5e74\u6570\u3092\u63a8\u6e2c\u3059\u308b\u3053\u3068\u306f\u4e0d\u53ef\u80fd\u3067\u3059\u3002"}
{"translation": "\u3055\u3089\u306b\u9060\u671b\u3059\u308c\u3070\u3001\u5c71\u3005\u304c\u512a\u96c5\u306a\u8d77\u4f0f\u3092\u63cf\u304d\u51fa\u3057\u3001\u305d\u306e\u8f2a\u90ed\u306f\u82b1\u3073\u3089\u306e\u3088\u3046\u3067\u3059\u3002"}
{"translation": "\u5ead\u89d2\u90e8\u5206\u3067\u306f\u8fce\u6625\u82b1\u304c\u6e80\u958b\u304b\u3089\u840e\u3080\u5146\u3057\u304c\u307f\u3048\u307e\u3059\u304c\u3001\u305d\u306e\u660e\u308b\u3044\u9ec4\u8272\u3044\u82b1\u306f\u4eca\u3067\u3082\u30ad\u30e9\u30ad\u30e9\u3068\u5149\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u4e94\u3064\u306e\u8272\u5f69\u304c\u3072\u3068\u3064\u305a\u3064\u5f7c\u5973\u306e\u773c\u524d\u306b\u73fe\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u6625\u7b2c\u4e8c\u6ce2\u300d\uff08\u56de\u6625\u4e2d\uff09\u2028\u5c0f\u9ce5\u3082\u4eca\u6296\u64de\u7cbe\u795e\uff08\u6c17\u6301\u3061\u4e0a\u5411\u304d) \u306e\u6a21\u69d8\u3067\u3001\u98a8\u306f\u307e\u305f\u5bd2\u3055\u3092\u611f\u3058\u308b\u3051\u3069\u305d\u308c\u3060\u3051\u66f4\u3081\u3070\u305d\u308c\u3060\u3051\u6b4c\u3046\u3093\u3067\u3059\u3088\u98db\u884c\u3055\u308c\u308b\u3053\u3068\u306a\u3069\u4e00\u6642\u671f\u7121\u7406\u305d\u3046\u3060\u3063\u305f\u3053\u3053\u306e\u738b\u56fd\u3067\u3082\u6d3b\u52d5\u518d\u958b\u3057\u305f\u3070\u304b\u308a\u3053\u306e\u5bc2\u3057\u3055\u3002"}
{"translation": "\u3053\u3046\u3057\u305f\u98a8\u666f\u3068\u97f3\u306b\u5305\u307e\u308c\u3066\u3001\u5f7c\u5973\u306f\u5f90\u3005\u306b\u9759\u5bc2\u3092\u53d6\u308a\u623b\u3057\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u304c\u6025\u6d41\u304b\u3089\u5f15\u304d\u4e0a\u3052\u3089\u308c\u305f\u3068\u304d\u3001\u5168\u8eab\u306f\u88f8\u3060\u3063\u305f\u3002"}
{"translation": "\u982d\u304b\u3089\u8db3\u307e\u3067\u3001\u50b7\u306f\u7121\u6570\u306b\u3042\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u5ca9\u3068\u6fc0\u3057\u3044\u6d41\u308c\u306e\u885d\u7a81\u306e\u7d50\u679c\u3067\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u3092\u6551\u51fa\u3057\u305f\u4eba\u3005\u306f\u6c34\u304c\u5f7c\u5973\u306e\u808c\u3092\u771f\u3063\u767d\u306b\u6f02\u767d\u3057\u3001\u305f\u3060\u9ed2\u3044\u9aea\u3060\u3051\u304c\u6b8b\u3063\u3066\u304a\u308a\u3001\u4e00\u76ee\u3067\u306f\u3069\u3053\u304c\u50b7\u3064\u3044\u3066\u3044\u308b\u304b\u5206\u304b\u3089\u306a\u304b\u3063\u305f\u3068\u8a00\u3044\u307e\u3059\u3002"}
{"translation": "\u5e78\u904b\u306b\u3082\u3001\u6570\u4eba\u306e\u8ecd\u533b\u304c\u8fd1\u304f\u306e\u6751\u3067\u8a3a\u5bdf\u3057\u3066\u304a\u308a\u3001\u5f7c\u3089\u306f\u3059\u3050\u3055\u307e\u5f7c\u5973\u3092\u305d\u3053\u3078\u9001\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u6551\u6025\u51e6\u7f6e\u306e\u5f8c\u3001\u305d\u306e\u533b\u5e2b\u305f\u3061\u306f\u901f\u3084\u304b\u306b\u5f7c\u5973\u3092\u75c5\u9662\u306b\u9023\u308c\u3066\u884c\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u5973\u306f\u75c5\u9662\u3067\u534a\u6708\u4ee5\u4e0a\u610f\u8b58\u3092\u53d6\u308a\u623b\u3059\u307e\u3067\u904e\u3054\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u6c17\u4ed8\u3044\u305f\u6642, \u4eba\u3005\u304b\u3089\u8cea\u554f\u3055\u308c\u3088\u3046\u3068\u3059\u308b\u3068\u7a81\u7136\u9a5a\u6115\u3057\u305f\u8868\u60c5\u3092\u898b\u305b\u307e\u3057\u305f\u3002"}
