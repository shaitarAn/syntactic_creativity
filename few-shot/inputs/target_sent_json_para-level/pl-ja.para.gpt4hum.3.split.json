{"translation": "\u300c\u3042\u306e\u4e2d\u304b\u3089\u4e8c\u5ea6\u3068\u51fa\u3066\u3053\u306a\u3044\u305e\u3001\u305d\u308c\u304c\u8a00\u3044\u305f\u3044\u3093\u3060\u300d\u3068\u306b\u304d\u3073\u9854\u304c\u9837\u304d\u306a\u304c\u3089\u65ad\u5b9a\u7684\u306b\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u3082\u3046\u4e00\u6642\u959315\u5206\u3082\u305d\u3053\u306b\u5165\u3063\u3066\u308b\u3093\u3060\u304b\u3089\u3002"}
{"translation": "\u5f7c\u306f\u3082\u3046\u898b\u8fbc\u307f\u304c\u306a\u3044\u3055\u3002"}
{"translation": "\u5e02\u6c11\u9054\u306f\u3001\u4f5c\u308a\u51fa\u3055\u308c\u305f\u5ec3\u589f\u306e\u4e2d\u3067\u3057\u3083\u3079\u3089\u305a\u7acb\u3061\u3064\u304f\u3057\u3001\u304c\u308c\u304d\u306e\u5c71\u3067\u958b\u304b\u308c\u305f\u6697\u9ed2\u8272\u306e\u53e3\u3092\u3058\u3063\u3068\u898b\u3064\u3081\u3066\u3044\u305f\u3002"}
{"translation": "\u5730\u4e0b\u5ba4\u3078\u7d9a\u304f\u584a\u308a\u3064\u304f\u9053\u7b4b\u306b\u5411\u3051\u3066\u3058\u3063\u3068\u773a\u3081\u3066\u3044\u308b\u3002"}
{"translation": "\u592a\u3063\u3061\u3087\u306e\u9ec4\u8272\u306e\u30b3\u30fc\u30c8\u7537\u306f\u8db3\u8e0f\u307f\u3057\u306a\u304c\u3089\u54b3\u6255\u3044\u3046\u3048\u3067\u3001\u5f62\u3092\u6574\u3048\u640d\u306a\u3063\u305f\u30d9\u30ec\u30fc\u5e3d\u3092\u7d21\u9318\u4f53\u304b\u3089\u5265\u304e\u53d6\u3063\u3066\u001c\u306b\u305d\u308c\u304b\u3089\u4e00\u5c64\u8eab\u69cb\u3048\u307e\u3057\u305f\u300d"}
{"translation": "\u300c\u3082\u3046\u5c11\u3057\u5f85\u3068\u3046\u300d\u5f7c\u304c\u3001\u7d30\u3044\u7709\u9593\u304b\u3089\u6ef4\u308b\u6c57\u3092\u62ed\u304d\u306a\u304c\u3089\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u4f55\u3092\u5f85\u3063\u3066\u308b\u3093\u3060\uff1f\u300d\u3068\u30cb\u30ad\u30d3\u9762\u304c\u9f3b\u3067\u7b11\u3063\u305f\u3002"}
{"translation": "\u300c\u5730\u4e0b\u7262\u306b\u306f\u30d0\u30b8\u30ea\u30b9\u30af\u304c\u3044\u308b\u3001\u305d\u308c\u3092\u5fd8\u308c\u305f\u306e\u304b\uff1f"}
{"translation": "\u8ab0\u3067\u3082\u305d\u3053\u306b\u5165\u308c\u3070\u4e8c\u5ea6\u3068\u51fa\u3066\u3053\u308c\u306a\u3084\u3064\u3060\u3002"}
{"translation": "\u3069\u308c\u3060\u3051\u306e\u4eba\u9593\u304c\u305d\u3053\u3067\u6b7b\u3093\u3060\u3053\u3068\u304b\u3002"}
{"translation": "\u5f85\u3061\u7d9a\u3051\u308b\u306b\u306f\u4f55\u306e\u610f\u5473\u304c\u3042\u308b\uff1f"}
{"translation": "\u6211\u3005\u306f\u307e\u3055\u3057\u304f\u2026\u300d\u592a\u3063\u3061\u3087\u306f\u4e0d\u78ba\u304b\u306b\u3064\u3076\u3084\u3044\u305f\u3002"}
{"translation": "\u300c\u3069\u3046\u3044\u3046\u3053\u3068\u3067\u3059\u304b\uff1f\u79c1\u9054\u3001\u751f\u304d\u3066\u3044\u308b\u8005\u540c\u58eb\u3067\u8a71\u3057\u5408\u3063\u3066\u307e\u3057\u305f\u3088\u3001\u3001\u300d\u30cb\u30ad\u30d3\u9762\u306e\u4ef2\u9593\u3067\u3042\u308b\u5de8\u5927\u306a\u9769\u30a8\u30d7\u30ed\u30f3\u59ff\u30ea\u30fc\u30de\u30f3\u30b9\u30bf\u30a4\u30eb\u7537\u6027\u3002"}
{"translation": "\u300c\u3057\u304b\u3057\u4eca\u5f7c\u306f\u4ea1\u304f\u306a\u308a\u307e\u3057\u305f\u3001\u3053\u308c\u305e\u307e\u3055\u3057\u304f\u552f\u4e00\u7d76\u5bfe\u7684\u771f\u5b9f\u3067\u3059\u3002"}
{"translation": "\u7d42\u308f\u308a\u3088\u3051\u308c\u3070\u5168\u3066\u6885\u96e8\u524d\u666f\u7acb\u3059\u307f\u307e\u305b\u3093\u751f\u304d\u8fd4\u3089\u305b\u307e\u3059\u304b\u305d\u306e\u5f7c\u3063\u3066\u4eba\u5411\u3051\u521d\u3081\u304b\u3089\u7f60\u306b\u843d\u3061\u8fbc\u307f\u307e\u3059"}
{"translation": "\u751f\u524d\u4e0a\u4e0b\u9031\u7523\u696d\u4e2d\u5fc3\u7686\u7121\u4e0d\u6210\u5c31\u99c4\u76ee\u8cb8\u4e0e\u5931\u6557\u514d\u8077\u300d\u300c\u3058\u3083\u3042\u3001\u53cd\u7701\u4f1a\u3069\u3046\u3059\u308b\u3093\u3060\uff1f\u300d\u6bce\u65e5\u98f2\u307f\u7981\u6b62\u547d\u4ee4\u7a81\u7834\u53e3\u8aac\u3054\u98ef\u4ee3\u5225\u9014\u652f\u6255\u3044\u304a\u8a31\u3057\u304f\u3060\u3055\u3044\u30d1\u30fc\u30c1\u30e3\u30c3\u30af\u82b8\u4eba\u3055\u3093\u611b\u3057\u3066\u308b\u5272\u70f9\u7740\u6301\u3063\u3066\u884c\u304f\u4e88\u5b9a\u6b8b\u3057\u3066\u4f55\u3067\u3082\u3044\u3044\u7279\u5225\u306a\u3053\u3068\u3002"}
{"translation": "\u300c\u7bc0\u7d04\u3057\u307e\u3057\u305f\u306d\u3001\u5dde\u77e5\u4e8b\u3001\u9762\u76b0\u7537\u304c\u8a00\u3063\u305f\u3002"}
{"translation": "\u3060\u3063\u3066\u30d0\u30b8\u30ea\u30b9\u30af\u3092\u8cb7\u3046\u4eba\u304c\u3044\u306a\u3044\u306e\u3060\u304b\u3089\u3002"}
{"translation": "\u3042\u306a\u305f\u9054\u306f\u5e73\u7a4f\u306b\u5bb6\u306b\u5e30\u308c\u307e\u3059\u3002"}
{"translation": "\u50d5\u305f\u3061\u304c\u9b54\u5973\u306e\u99ac\u3068\u725b\u3092\u5f15\u304d\u53d6\u308b\u304b\u3089\u3001\u826f\u3044\u3082\u306e\u3092\u653e\u308a\u51fa\u3059\u3053\u3068\u306f\u60dc\u3057\u3044\u3067\u3059\u3088\u306d\u3002"}
{"translation": "\u305d\u3046\u3067\u3059\u306d\u3001\u3068\u5c60\u6bba\u4eba\u304c\u8a00\u3063\u305f\u3002\u5065\u5168\u306a\u96cc\u99ac\u3060\u3002"}
{"translation": "\u305d\u3057\u3066\u30e6\u30ad\u3082\u3057\u3063\u304b\u308a\u8a70\u3081\u3089\u308c\u3066\u3044\u307e\u3059\u3088\u306d\u3002"}
{"translation": "\u4e2d\u8eab\u304c\u4f55\u304b\u898b\u3066\u307f\u307e\u3057\u3087\u3046\u304b\uff1f"}
{"translation": "\u3053\u308c\u306f\u3069\u3046\u3057\u305f\u3093\u3067\u3059\u304b\uff1f"}
{"translation": "\u4f55\u4e8b\uff1f\u9759\u304b\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3001\u5dde\u77e5\u4e8b\u3055\u3093\u3002"}
{"translation": "\u90aa\u9b54\u3057\u306a\u3051\u308c\u3070\u9824\uff08\u3042\u3054\uff09\u3092\u6253\u3064\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3088\u300d\u3068\u9762\u76b0\u7537\u304c\u8b66\u544a\u3057\u305f\u3002"}
{"translation": "\u300c\u5065\u5168\u306a\u96cc\u99ac\u300d\u5c60\u6bba\u4eba\u304c\u7e70\u308a\u8fd4\u3057\u305f\u3002"}
{"translation": "\u300c\u3053\u306e\u99ac\u3092\u653e\u3063\u3066\u304a\u3051\u3070\u5e73\u548c\u306b\u66ae\u3089\u305b\u308b\u3067\u3057\u3087\uff1f\u611b\u3059\u308b\u5b50\u4f9b\u9054\u3088\u300d\u5c60\u6bba\u4eba\u306f\u3086\u3063\u304f\u308a\u3068\u58c1\u8d8a\u3057\u306b\u73fe\u308f\u308c\u305f\u7570\u56fd\u306e\u65c5\u884c\u8005\u3084\u5f8c\u308d\u65b9\u5411\u7684\u80cc\u666f-\u5efa\u7bc9\u7269\u3084\u571f\u5730, \u5468\u8fba\u306e\u9580\u53e3\u307e\u3067\u96c6\u307e\u3063\u3066\u3044\u308b\u7fa4\u8846\uff0c\u57ce\u585e\uff08\u30c0\u30f3\u30b8\u30e7\u30f3\uff09\u5165\u53e3\u8fd1\u508d)\u2501\u3002"}
{"translation": "\u308f\u3056\u308f\u3056\u5411\u304d\u76f4\u3063\u305f\u3002\u3002"}
{"translation": "\u305d\u306e\u7537\u306f\u3001\u304f\u305b\u306e\u5f37\u3044\u3001\u6df1\u307f\u306e\u3042\u308b\u6817\u8272\u306e\u9aea\u3092\u6301\u3063\u3066\u3044\u3066\u3001\u8336\u8272\u306e\u30c1\u30e5\u30cb\u30c3\u30af\u3092\u7dbf\u3067\u8a70\u3081\u305f\u30ab\u30d5\u30bf\u30f3\u306b\u7740\u3053\u3093\u3067\u304a\u308a\u3001\u9ad8\u3044\u30e9\u30a4\u30c0\u30fc\u30d6\u30fc\u30c4\u3092\u5c65\u3044\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u6b66\u5668\u306f\u307e\u3063\u305f\u304f\u8eab\u306b\u3064\u3051\u3066\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u99ac\u304b\u3089\u96e2\u308c\u308d\u3068\u5f7c\u304c\u518d\u5ea6\u8a00\u3063\u305f\u6642\u306b\u306f\u82e6\u3005\u3057\u3052\u306b\u7b11\u3063\u3066\u898b\u305b\u305f\u3002"}
{"translation": "\u300c\u305d\u308c\u3063\u3066\u3069\u3046\u3044\u3046\u4e8b\u3060\uff1f"}
{"translation": "\u99ac\u3082\u8377\u7269\u3082\u4ed6\u4eba\u306e\u7269\u3067\u3057\u3087\u3046\uff1f\u305d\u308c\u3089\u306b\u8caa\u6b32\u306a\u76ee\u3092\u5411\u3051\u3001\u6c5a\u3089\u308f\u3057\u3044\u624b\u3092\u4f38\u3070\u3059\u306a\u3093\u3066\u52dd\u624b\u3058\u3083\u306a\u3044\uff1f\u300d"}
{"translation": "\u9813\u73cd\u6f22\u3058\u307f\u305f\u632f\u821e\u3092\u3057\u305f\u3053\u308bn\u304c\u5f90\u3005\u306b\u81ea\u5206\u306e\u4e21\u8107\u3078\u624b\u3092\u6ed1\u308a\u8fbc\u307e\u305b\u59cb\u3081\u3066\u5c60\u6bba\u8005\u6ce8\u8996\u3059\u308b\u3068\u304d\u3001\u300c\u66b4\u529b\u5c4b\u300d\u306f\u9837\u304d\u3001\u30b0\u30eb\u30fc\u30d7\u5074\u304b\u3089\u66f4\u306b\uff12\u4eba\u2013\u2013\u2013\u3069\u3061\u3089\u3082\u80cc\u4e08\u304c\u4f4e\u304f\u4f53\u6bdb\u77ed\u2015\u2015 \u304c\u51fa\u3066\u6765\u308b\u3088\u3046\u4ed5\u8349\u3067\u793a\u3057\u305f\u3002"}
{"translation": "\uff12\u4eba\u3068\u3082\u6e7e\u66f2\u3057\u305f\u68d2\u5207\u308c\uff08\u8089\u4f53\u52b4\u50cd\u8005\uff09 \u3092\u6301\u3064\u3088\u3046\u884c\u52d5\u3057\u3066\u304a\u308a\u901a\u5e38\u5c60\u6bba\u5834\u3067\u306f\u3053\u308c\u3067\u52d5\u7269\u9054\u9ed9\u3055\u308c\u308b"}
{"translation": "\u300c\u4e00\u4f53\u4f55\u8005\u306a\u3093\u3060\uff1f\u300d\u3068\u3001\u306b\u304d\u3073\u9854\u304c\u805e\u3044\u305f\u3002"}
{"translation": "\u308f\u308c\u308f\u308c\u306b\u6b63\u3057\u3044\u3053\u3068\u3092\u8a34\u3048\u308b\u305f\u3081\u306b\u8107\u306e\u4e0b\u304b\u3089\u624b\u3092\u51fa\u3055\u306a\u3044\u3002"}
{"translation": "\u300c\u305d\u3093\u306a\u3053\u3068\u306f\u3042\u306a\u305f\u304c\u5fc3\u914d\u3059\u308b\u3053\u3068\u3058\u3083\u3042\u308a\u307e\u305b\u3093\u3088\u3001\u30c0\u30fc\u30ea\u30f3\u3002"}
{"translation": "\u6b66\u5668\u3082\u6301\u3063\u3066\u307e\u305b\u3093\u3088\u300d"}
{"translation": "\u300c\u672c\u5f53\u304b\uff1f\u300d\u898b\u77e5\u3089\u306c\u4eba\u306f\u3055\u3089\u306b\u6bd2\u3005\u3057\u304f\u7b11\u3063\u305f\u3002"}
{"translation": "\u300c\u6301\u3063\u3066\u307e\u305b\u3093\u3088\u300d"}
{"translation": "\u300c\u305d\u308c\u306f\u60aa\u3044\u300d\u3068\u3001\u30cb\u30ad\u30d3\u9854\u306f\u8107\u306e\u4e0b\u304b\u3089\u624b\u3092\u53d6\u308a\u51fa\u3057\u3066\u9577\u3044\u30ca\u30a4\u30d5\u304c\u73fe\u308c\u305f\u3002"}
{"translation": "\u300c\u672c\u5f53\u306b\u60aa\u3044\u4e8b\u3060\u3002"}
{"translation": "\u6b66\u5668\u3092\u6301\u3061\u6b69\u3051\u3066\u30ce\u30c3\u30c8\uff09MEAT CUTTER\u3082\u9577\u5263\u306e\u5982\u304f\u30ca\u30a4\u30d5\u3092\u53d6\u308a\u51fa\u3059\u4ed62\u4eba\u3082\u524d\u9032\u3057\u30d0\u30fc\u30eb\u7247\u624b\u3067\u632f\u308a\u4e0a\u3052\u3066\u7acb\u3064\u6c42\u9053\u8005\u300c\u79c1\u306f\u5263(\u56e0\u5909\u66f4\u9700\u6539\u7ffb\u8bd1\u540e\u8ddf\u4f4f\u6211\u3002"}
{"translation": "\u5ec3\u589f\u304b\u3089\u3001\u67d4\u3089\u304b\u304f\u78ba\u4fe1\u306b\u6e80\u3061\u305f\u8db3\u53d6\u308a\u3067\u3001\u4e8c\u4eba\u306e\u82e5\u3044\u5973\u6027\u304c\u73fe\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u7fa4\u8846\u306f\u3059\u3050\u306b\u5206\u304b\u308c\u3066\u4e0b\u304c\u308a\u3001\u5e0c\u8584\u306b\u306a\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u4e21\u65b9\u306e\u5973\u6027\u306f\u5fae\u7b11\u307f\u306a\u304c\u3089\u6b6f\u3092\u898b\u305b\u3001\u76ee\u3092\u7d30\u3081\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u4e21\u76ee\u304b\u3089\u8033\u307e\u3067\u5e83\u304f\u9752\u7d2b\u8272\u306e\u30bf\u30c8\u30a5\u30fc\u304c\u4f38\u3073\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5f37\u529b\u306a\u592a\u3082\u3082\u304b\u3089\u306f\u7b4b\u8089\u304c\u52d5\u304d\u3001\u8170\u5468\u308a\u3092\u8986\u3046\u7363\u76ae\u30b9\u30ab\u30fc\u30c8\u304b\u3089\u898b\u3048\u307e\u3059\u3002"}
{"translation": "\u307e\u305f\u3001\u523a\u7e4d\u306e\u30cd\u30c3\u30c8\u30b0\u30ed\u30fc\u30d6\u3088\u308a\u4e0a\u90e8\u306e\u88f8\u3067\u4e38\u307f\u3092\u5e2f\u3073\u305f\u8155\u3067\u3082\u7b4b\u8089\u304c\u52d5\u304d\u307e\u3059\u3002"}
{"translation": "\u9396\u5e37\u5b50\u3067\u8986\u308f\u308c\u305f\u80a9\u3088\u308a\u4e0a\u90e8\u3067\u306f\u30b5\u30fc\u30d9\u30eb\u306e\u67c4\u304c\u7a81\u304d\u51fa\u3057\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u306b\u304d\u3073\u9762\u306f\u3086\u3063\u304f\u308a\u3068\u3001\u975e\u5e38\u306b\u3086\u3063\u304f\u308a\u3068\u819d\u3092\u66f2\u3052\u3001\u5730\u9762\u306b\u30ca\u30a4\u30d5\u3092\u843d\u3068\u3057\u305f\u3002"}
{"translation": "\u30ac\u30ec\u30ad\u306e\u7a74\u304b\u3089\u77f3\u306e\u97f3\u304c\u97ff\u304d\u3001\u305d\u306e\u5f8c\u6697\u95c7\u304b\u3089\u58ca\u308c\u305f\u58c1\u306e\u3061\u306f\u3089\u90e8\u5206\u306b\u63b4\u307e\u308b\u624b\u304c\u73fe\u308c\u305f\u3002"}
{"translation": "\u624b\u306e\u5f8c\u308d\u304b\u3089\u306f\u767d\u3044\u9aea\uff08\u30ec\u30f3\u30ac\u7c89\u3067\u5f69\u8272\u3055\u308c\uff09\u3001\u9752\u3056\u3081\u305f\u9854\u3001\u80a9\u8d8a\u3057\u306b\u898b\u3048\u308b\u5263\u306e\u67c4\u304c\u6b21\u3005\u3068\u51fa\u3066\u304d\u305f\u3002"}
{"translation": "\u7fa4\u8846\u306f\u3056\u308f\u3064\u3044\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u304c\u3001\u4e38\u307e\u3063\u3066\u3001\u7a74\u304b\u3089\u5947\u5999\u306a\u5f62\u306e\u3001\u5909\u306a\u80a2\u4f53\u3092\u5f15\u3063\u5f35\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u5875\u3068\u8840\u306b\u6d78\u3057\u3066\u81a8\u308c\u4e0a\u304c\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u5f7c\u306f\u305d\u306e\u751f\u304d\u7269\u3092\u9577\u304f\u3066\u30c8\u30ab\u30b2\u306e\u3088\u3046\u306a\u5c3e\u3067\u3064\u304b\u307f\u3001\u4e00\u8a00\u3082\u8a00\u308f\u305a\u306b\u80a5\u6e80\u4f53\u306e\u9818\u4e3b\u306e\u8db3\u5143\u306b\u653e\u308a\u6295\u3052\u305f\u3002"}
{"translation": "\u9818\u4e3b\u306f\u9a5a\u3044\u3066\u98db\u3073\u9000\u304d\u3001\u5012\u308c\u305f\u58c1\u306e\u65ad\u7247\u306b\u3064\u307e\u3065\u304d\u306a\u304c\u3089\u66f2\u304c\u3063\u305f\u9ce5\u985e\u81ed\u304f\u898b\u3048\u308b\u305d\u306e\u53e3\u5148\u3001\u819c\u72b6\u306e\u7ffc\u3068\u9c57\u3067\u8986\u308f\u308c\u305f\u8db3\u5148\u306b\u5f13\u77e2\u72b6\u722a\u3092\u898b\u3064\u3081\u3066\u3044\u305f\u3002"}
{"translation": "\u304b\u3064\u3066\u6df1\u7d05\u8272\u3060\u3063\u305f\u76ae\u4e0b\u7d44\u7e54\u304c\u81a8\u3089\u307f\u3001\u73fe\u5728\u3067\u306f\u571f\u8272\u6c5a\u6d1e\u3055\u305b\u308b\uff08\u660e\u78ba\u6027\u4e0d\u660e\uff09\u67d4\u3089\u304b\u305d\u3046\uff08\u89d2\u6c0f\u76f4\u8a33\uff09\u984e\u88cf\u90e8\u5206\u3092\u898b\u8996\u76ee\u932f\u3057\u59cb\u3081\u308b\u3068\u3046\u308d\u3053\u3056\u3051\uff08\u89d2\u8cea\u5316\u5265\u96e2\uff09\u773c\u7aa9 \u5e4c\u5e03\u5074\u773c\u7aa9 \uff09\u3002"}
{"translation": "\u300c\u305d\u306e\u7d50\u679c\u3001\u30d0\u30b8\u30ea\u30b9\u30af\u304c\u51fa\u3066\u304d\u305f\u3001\u3068\u767d\u9aea\u306e\u7537\u306f\u8a00\u3044\u306a\u304c\u3089\u30ba\u30dc\u30f3\u304b\u3089\u307b\u3053\u308a\u3092\u306f\u3089\u3063\u305f\u3002"}
{"translation": "\u7d04\u675f\u901a\u308a\u3060\u3002"}
{"translation": "\u3055\u3042\u3001\u79c1\u306e200\u30ea\u30f3\u30bf\u30fc\u30eb\u3092\u304f\u308c\u3002"}
{"translation": "\u6b63\u5f53\u306a\u30ea\u30f3\u30bf\u30fc\u30eb\u3067\u3001\u3042\u307e\u308a\u4f7f\u308f\u308c\u3066\u3044\u306a\u3044\u3082\u306e\u3060\u3002"}
{"translation": "\u3061\u3083\u3093\u3068\u78ba\u8a8d\u3057\u3066\u307f\u308b\u305e\u3002"}
{"translation": "\u753a\u9577\u306f\u984d\u306b\u6c57\u3092\u6d6e\u304b\u3079\u3066\u8ca1\u5e03\u3092\u53d6\u3063\u305f\u3002"}
{"translation": "\u767d\u9aea\u306e\u7537\u304c\u76ee\u5468\u308a\u3092\u898b\u3064\u3064\u4e00\u77ac\u9854\u8272\u8c4a\u5f69\u306a\u5c11\u5e74\u3084\u5f7c\u306e\u8db3\u5143\u306b\u8ee2\u304c\u3063\u3066\u3044\u308b\u30ca\u30a4\u30d5\u306b\u8996\u7dda\u505c\u3081\u305f\u3002"}
{"translation": "\u8336\u8272\u306e\u30c1\u30e5\u30cb\u30c3\u30af\u7740\u7528\u3057\u305f\u7537\u3084\u8d64\u6bdb\u76ae\u8863\u88c5\u5973\u5b50\u7b49\u306b\u76ee\u304b\u3089\u5bfe\u51e6\u3057\u305f\u300d"}
{"translation": "\u300c\u3044\u3064\u3082\u306e\u3088\u3046\u306b\u300d\u3068\u5f7c\u306f\u8a00\u3063\u305f\u3002"}
{"translation": "\u6751\u9577\u306e\u9707\u3048\u308b\u624b\u304b\u3089\u70cf\u9f8d\u8336\u3092\u53d6\u308a\u51fa\u3057\u305f\u3002"}
{"translation": "\u300c\u50d5\u306f\u3042\u306a\u305f\u305f\u3061\u306e\u70ba\u306b\u547d\u3092\u6367\u3052\u3066\u3001\u4e9b\u7d30\u306a\u5831\u916c\u3057\u304b\u5f97\u3089\u308c\u307e\u305b\u3093\u3002"}
{"translation": "\u305d\u306e\u4e00\u65b9\u3067\u3001\u3042\u306a\u305f\u305f\u3061\u306f\u50d5\u306e\u6240\u6709\u7269\u3092\u8352\u3089\u305d\u3046\u3068\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3042\u3042\u3001\u4e00\u8a00\u3067\u3082\u5426\u5fdc\u3067\u3082\u5909\u308f\u3089\u306a\u3044\u3093\u3060\u306d\u3002"}
{"translation": "\u4f55\u3082\u624b\u51fa\u3057\u3057\u306a\u304b\u3063\u305f\u3088\u300d\u3068\u8089\u5c4b\u304c\u56c1\u304d\u307e\u3057\u305f\u304c\u3001\u5f8c\u9000\u3057\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u65e2\u306b\u68d2\u3092\u6301\u3063\u305f\u7537\u9054\u306f\u7fa4\u8846\u306b\u6eb6\u3051\u8fbc\u3093\u3067\u884c\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u4f55\u3082\u89e6\u3063\u3066\u3044\u307e\u305b\u3093\u3088\u3001\u65e6\u90a3\u69d8\u300d\u767d\u9aea\u982d\u304c\u5fae\u7b11\u307f\u307e\u3057\u305f\u3002"}
{"translation": "\u201d\u305d\u306e\u7b11\u9854\u3092\u898b\u308b\u3068\u3001\u9759\u304b\u306a\u9854\u9762\u306b\u958b\u82b1\u3059\u308b\u50b7\u53e3\u3068\u540c\u3058\u304f\u51b7\u3084\u6c57\u6d41\u3059\u7537\u5171\u306f\u6025\u901f\u306b\u6563\u6563\u5408\u4f1a\u3057\u59cb\u3081\u307e\u3059\u3002"}
{"translation": "\u201d\u3060\u304b\u3089\u5144\u5f1f\u3055\u3093\u3082\u5b89\u5168\u3067\u3059\u3088\u3002"}
{"translation": "\u5e73\u548c\u88e1\u53bb\u3063\u3066\u4e0b\u3055\u3044\u3002\u3057\u304b\u3057\u65e9\u304f\u53bb\u3063\u3066\u304f\u3060\u3055\u3044\u307e\u3059\u3088\u3046\u300d"}
