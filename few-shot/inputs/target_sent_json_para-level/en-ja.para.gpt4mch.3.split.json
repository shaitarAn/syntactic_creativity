{"translation": "\u591c\u660e\u3051\u524d\u3001\u96f2\u306e\u4e00\u90e8\u304c\u9ed2\u304f\u713c\u3051\u843d\u3061\u3001\u5730\u5e73\u7dda\u306f\u53e4\u304f\u3066\u9306\u3073\u305f\u30b7\u30eb\u30a8\u30c3\u30c8\u306e\u6f02\u6d41\u7269\u3067\u6563\u3089\u3070\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u5f7c\u3089\u306f\u4e00\u4eba\u304d\u308a\u3060\u3063\u305f\u3002"}
{"translation": "\u30b1\u30e0\u30c8\u30ec\u30a4\u30eb\u3001\u3068\u8fb2\u592b\u304c\u30a2\u30ec\u30c3\u30af\u306b\u65e9\u671d\u306e\u6563\u6b69\u4e2d\u306b\u8a00\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u4ee5\u5916\u3067\u306f\u5f7c\u306f\u7121\u53e3\u3060\u3063\u305f\u3002"}
{"translation": "\u4e94\u5341\u30d5\u30a3\u30fc\u30c8\u96e2\u308c\u305f\u3068\u3053\u308d\u3067\u3001\u7551\u306f\u65b0\u9bae\u306b\u8015\u3055\u308c\u305f\u8336\u8272\u306e\u571f\u5730\u3078\u3068\u69d8\u5909\u308f\u308a\u3057\u3001\u3072\u3069\u304f\u3067\u3053\u307c\u3053\u306e\u5927\u5730\u306b\u306f\u81f3\u308b\u6240\u3067\u571f\u584a\u304c\u7bc9\u304b\u308c\u3066\u3044\u305f\u3002"}
{"translation": "\u767d\u3044\u5ca9\u77f3\u304c\u56db\u65b9\u516b\u65b9\u3092\u6563\u3089\u3070\u3063\u3066\u5c0f\u533a\u753b\u3092\u5f62\u4f5c\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u3053\u306e\u5834\u6240\u3067\u306e\u4e00\u6b69\u4e00\u6b69\u306f\u3001\u524d\u3082\u3063\u3066\u306e\u305d\u308c\u3068\u540c\u3058\u3088\u3046\u306b\u6ce5\u3063\u307d\u304f\u6e7f\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u3055\u3089\u306b\u5411\u3053\u3046\u5074\u3067\u306f\u3001\u8584\u3044\u91d1\u5c5e\u88fd\u306e\u5840\u304c\u571f\u5730\u306e\u7aef\u3092\u8868\u3057\u3066\u304a\u308a\u3001\u7f8a\u6bdb\u7247\u304c\u30ef\u30a4\u30e4\u30fc\u90e8\u5206\u3092\u88c5\u98fe\u3057\u5996\u7cbe\u706f\u308a\u307f\u305f\u304f\u98fe\u3089\u308c\u3066\u304a\u308a\u3001\u304b\u3064\u3066\u7f8a\u9054\u304c\u7a81\u7834\u3057\u3088\u3046\u3068\u3057\u305f\u8de1\u3067\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u9854\u304b\u3089\u3082\u3046\u4e00\u5339\u306e\u30cf\u30a8\u3092\u8ffd\u3044\u6255\u3063\u305f\u3002"}
{"translation": "\u3044\u3084\u3060\u3001\u8fb2\u592b\u306f\u8a00\u3063\u305f\u3001\u79c1\u306f\u83dc\u98df\u4e3b\u7fa9\u8005\u3067\u3059\u3002"}
{"translation": "\u672c\u5f53\u306b\uff1f\u3000\u3068\u8a00\u3063\u3066\u518d\u5ea6\u632f\u308a\u8d77\u3053\u3055\u308c\u308b\u3088\u3046\u306a\u96f0\u56f2\u6c17\u304c\u6f02\u3044\u307e\u3057\u305f\u304c\u3001\u300c\u3048\u3048\u300d\u3068\u8fb2\u592b\u304c\u7b54\u3048\u308b\u3068\u3059\u3050\u306b\u4f1a\u8a71\u306f\u7d42\u308f\u3063\u3066\u3057\u307e\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u4e16\u754c\u306f\u307e\u3060\u6697\u304b\u3063\u305f\u3001\u307b\u3093\u306e\u5c11\u3057\u306e\u9593\u3060\u3051\u3067\u3082\u3002"}
{"translation": "\u3082\u3046\u3059\u3050\u592a\u967d\u304c\u5b8c\u5168\u306b\u59ff\u3092\u8868\u3059\u6642\u9593\u3060\u3002"}
{"translation": "\u65e5\u3005\u304c\u307b\u3068\u3093\u3069\u59cb\u307e\u308a\u3064\u3064\u3042\u3063\u305f\u3002"}
{"translation": "\u5f7c\u3089\u306f\u5bb6\u65cf\u3068\u4e00\u7dd2\u306b\u4f4f\u3080\u305f\u3081\u306b\u81ea\u5206\u306e\u5bb6\u3092\u58f2\u3063\u3066\u3044\u308b\u3001\u3068\u5f7c\u5973\u306f\u8a00\u3044\u307e\u3059\u3002"}
{"translation": "\u8857\u3067\u4f55\u5ea6\u304b\u5f7c\u3089\u3092\u898b\u305f\u3088\u3046\u306a\u6c17\u304c\u3059\u308b\u3001\u30a2\u30ec\u30c3\u30af\u304c\u8a00\u3063\u305f\u3002"}
{"translation": "\u5f7c\u3089\u306f\u307b\u307c\u6c34\u69fd\u307e\u3067\u6765\u3066\u3044\u3066\u3001\u7b11\u9854\u3060\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u305d\u3046\u3044\u3046\u4eba\u3005\u304c\u4f5c\u3063\u305f\u8377\u8eca\u306e\u30db\u30a4\u30fc\u30eb\u3060\u308d\u3046\u304b\uff1f"}
{"translation": "\u5f7c\u3089\u306f\u30bd\u30fc\u30bb\u30fc\u30b8\u8089\u3092\u4e00\u7a2e\u306e\u7a74\u307f\u305f\u3044\u306a\u3082\u306e\u306b\u6df7\u305c\u8fbc\u307f\u3001\u30b7\u30ca\u30e2\u30f3\u30b9\u30ef\u30fc\u30eb\u306e\u3088\u3046\u306a\u3082\u306e\u3092\u4f5c\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u7f8e\u5473\u3057\u3044\u3067\u3059\u3088\u306d\u3002"}
{"translation": "\u3042\u306a\u305f\u3082\u4e00\u5ea6\u8a66\u3057\u305f\u3053\u3068\u3042\u308a\u307e\u3059\u304b\uff1f"}
{"translation": "\u300c\u30b8\u30fc\u30f3\u304c\u5f15\u3063\u8d8a\u3059\u3093\u3060\u3088\u300d\u3068\u8fb2\u592b\u306f\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u77e5\u3063\u3066\u305f\u304b\uff1f\u300d\u300c\u8ab0\u304c?\u300d\u3001\u300c\u30b8\u30fc\u30f3\u3055\u3002"}
{"translation": "\u9053\u306e\u5411\u3053\u3046\u306b\u4f4f\u3093\u3067\u308b\u5974\u3060\u3088\u300d\u3068\u8fb2\u592b\u306f\u9854\u3092\u3057\u304b\u3081\u306a\u304c\u3089\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u5f7c\u5973\u304c\u5bb6\u3092\u51fa\u3066\u3001\u81ea\u5206\u306e\u7267\u5834\u3092\u58f2\u308b\u3093\u3060\u3002"}
{"translation": "\u300d\u300c\u3042\u3042\u3001\u30b8\u30fc\u30f3\u304b\u3002"}
{"translation": "\u300d\u3068\u58f0\u3092\u843d\u3068\u3057\u305f\u3002"}
{"translation": "\u300c\u770b\u677f\u898b\u305f\u308f\u3044\u3002"}
{"translation": "\u300d\u30a2\u30ec\u30c3\u30af\u306f\u3053\u3053\u3078\u6765\u308b\u9014\u4e2d\u3067\u305d\u308c\u306b\u906d\u9047\u3057\u305f\u3001\u3053\u306e\u7267\u5834\u306e\u4e8c\u500d\u4ee5\u4e0a\u306e\u5e83\u3055\u304c\u3042\u308a\u3001\u52d5\u7269\u3082\u571f\u5730\u3082\u4eba\u3005\u3082\u305a\u3063\u3068\u826f\u3044\u72b6\u614b\u306b\u3042\u308b\u4e00\u3064\u306e\u7267\u5834\u3060\u3063\u305f\u3002"}
{"translation": "\u5f7c\u306f\u540d\u524d\u3092\u77e5\u3089\u306a\u304b\u3063\u305f\u3060\u3051\u3067\u306a\u304f\u3001\u3053\u3061\u3089\u5074\u3067\u306f\u307b\u3068\u3093\u3069\u8ab0\u3082\u77e5\u3089\u306a\u304b\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u81ea\u4f53\u3070\u304b\u308a\u3067\u306a\u304f\u3001\u5f7c\u304c\u305d\u3053\u306e\u4e00\u54e1\u3067\u306a\u3044\u3068\u3044\u3046\u8a3c\u660e\u3067\u3082\u3042\u308b\u3068\u601d\u308f\u308c\u308b\u3002"}
{"translation": "\u5f7c\u306f\u7d04200\u30d5\u30a3\u30fc\u30c8\u5148\u306b\u3042\u308b\u3001\u534a\u5206\u307b\u3069\u7a7a\u306e\u5927\u304d\u306a\u6c34\u30bf\u30f3\u30af\u3092\u6307\u3055\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u534a\u900f\u660e\u306e\u30d7\u30e9\u30b9\u30c1\u30c3\u30af\u306f\u6642\u9593\u3068\u5171\u306b\u7740\u8272\u3057\u3001\u4e2d\u3067\u6db2\u4f53\u304c\u63fa\u308c\u305f\u8de1\u304c\u5fae\u7b11\u307f\u306e\u3088\u3046\u306b\u5e83\u304c\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u300c\u898b\u3064\u3051\u305f\u306e\u306f\u305d\u3053\u3089\u8fba\u3060\u3063\u305f\u300d"}
{"translation": "\u5f7c\u306e\u9854\u8272\u304c\u5909\u308f\u3063\u305f\u3002"}
{"translation": "\u30a2\u30ec\u30c3\u30af\u30b9\u306f\u6642\u8a08\u3092\u898b\u305f\u3002"}
{"translation": "\u5348\u524d7\u66426\u5206\u3001\u3082\u3046\u3059\u3050\u65e5\u304c\u6607\u308b\u3060\u308d\u3046\u3002"}
{"translation": "\u5f7c\u3089\u306f\u9ed9\u3063\u3066\u7d9a\u3051\u3001\u8805\u9054\u306e\u7fbd\u97f3\u3084\u9060\u304f\u304b\u3089\u805e\u3053\u3048\u3066\u304f\u308b\u307e\u3070\u3089\u306a\u7f8a\u9054\u304b\u3089\u30cf\u30ed\u30fc\u30ef\u30fc\u30c9\u304c\u30bb\u30df\u30c0\u30fc\u30af\u30cd\u30b9\uff08\u4e0d\u5b8c\u5168\u306a\u6697\u95c7\uff09\u4e2d\u3067\u5f31\u3081\u53d6\u308a\u9664\u304b\u308c\u3066\u3044\u3063\u305f\u3060\u308d\u3046\u3002"}
{"translation": "\u30a2\u30ec\u30c3\u30af\u306f\u82e6\u7b11\u3044\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u5f8c\u9000\u3057\u3001\u6e9d\u3092\u98db\u3073\u8d8a\u3048\u308b\u524d\u306b\u8eab\u4f53\u3092\u5f15\u304d\u7de0\u3081\u305f\u3002"}
{"translation": "\u5f7c\u306f\u3069\u3059\u3093\u3068\u5730\u9762\u306b\u7740\u5730\u3057\u3001\u539a\u304f\u3066\u30b2\u30eb\u72b6\u306e\u6ce5\u306e\u4e2d\u306b\u5165\u3063\u305f\u3002"}
{"translation": "\u5f7c\u306e\u9ed2\u3044\u30ba\u30dc\u30f3\u3068\u8fb2\u592b\u306e\u30b8\u30fc\u30f3\u30ba\u304c\u6ce5\u3060\u3089\u3051\u306b\u306a\u3063\u305f\u3002"}
{"translation": "\u3082\u3046\u4e00\u4eba\u306e\u7537\u6027\u306f\u5fae\u7b11\u307f\u306a\u304c\u3089\u982d\u3092\u632f\u3063\u305f\u3002"}
{"translation": "\u300c\u6211\u3005\u306f\u4f55\u51e6\u307e\u3067\u6765\u3066\u3057\u307e\u3063\u305f\u3093\u3060\u308d\u3046\u306d\uff1f\u300d"}
{"translation": "\u30a2\u30ec\u30c3\u30af\u306f\u304f\u308b\u3076\u3057\u5468\u308a\u306e\u6ce5\u3092\u6255\u304a\u3046\u3068\u3057\u305f\u304c\u3001\u305d\u308c\u304c\u66f4\u306b\u5e83\u304c\u308b\u3070\u304b\u308a\u3060\u3063\u305f\u3002"}
{"translation": "\u624b\u306e\u3072\u3089\u306f\u6c5a\u308c\u3066\u3044\u3063\u305f\u3002"}
{"translation": "\u8fb2\u592b\u306f\u6b69\u304d\u7d9a\u3051\u305f\u3002"}
{"translation": "\u30a2\u30ec\u30c3\u30af\u306f\u6ce5\u3092\u898b\u3064\u3081\u3001\u8fb2\u592b\u306f\u306b\u3063\u3053\u308a\u3068\u5fae\u7b11\u3080\u3002"}
{"translation": "\u6fc1\u3063\u305f\u767d\u306e\u9aed\u306e\u4e0b\u3067\u5f7c\u306e\u982c\u304c\u8d64\u304f\u67d3\u307e\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u305d\u306e\u539a\u3044\u30ef\u30c3\u30af\u30b9\u30b3\u30fc\u30c8\u3068\u305d\u306e\u8179\u3001\u305d\u3057\u3066\u305d\u306e\u58f0\u3067\u3001\u5f7c\u306f\u72c2\u6c17\u3058\u307f\u305f\u30b5\u30f3\u30bf\u30af\u30ed\u30fc\u30b9\u304b\u3082\u3057\u308c\u306a\u3044\u3002"}
{"translation": "\u300c\u541b\u306f\u843d\u3061\u306a\u3044\u3088\u300d\u3068\u5f7c\u306f\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u5c11\u3057\u306e\u6c5a\u308c\u3092\u6016\u304c\u308b\u3058\u3083\u306a\u3044\u3060\u308d\u3046\u306d\u3001\u30cb\u30b3\u30eb\u30b9\u8ecd\u66f9\uff1f\u300d"}
{"translation": "\u3046\u3046\u3093\u3002"}
{"translation": "\u3048\u3048\u3002"}
{"translation": "\u6700\u4f4e\u9650\u671f\u5f85\u3057\u3066\u307e\u3059\u3088\u3002"}
{"translation": "\u3042\u3068\u3053\u308c\u3089\u30d5\u30e9\u30a4\u91e3\u308a\u3082\u3060\u3051\u3069\u3002"}
{"translation": "\u30a2\u30ec\u30c3\u30af\u306f\u8896\u3092\u5dfb\u304d\u4e0a\u3052\u3066\u4e00\u3064\u6255\u308f\u305b\u307e\u3057\u305f\u304c\u3001\u305d\u308c\u306f\u5f7c\u306e\u524d\u8155\u4e0a\u306b\u3059\u3084\u3059\u3084\u3068\u7720\u3063\u3066\u3044\u308b\u5927\u304d\u306a\u9686\u8d77\u7269\u3060\u3063\u305f\u3002"}
{"translation": "\u3053\u306e\u5834\u6240\u5168\u4f53\u3067\u306f\u98df\u3079\u7269\u3060\u3063\u305f\u3002"}
{"translation": "\u300c\u6b21\u56de\u30ab\u30d0\u30fc\u30a2\u30c3\u30d7\u3057\u305f\u65b9\u304c\u826f\u3055\u305d\u3046\u3060\u306d\u300d\u3068\u8fb2\u592b\u304c\u8a00\u3063\u305f"}
{"translation": "\u5f7c\u3089\u306f\u3069\u3053\u306b\u3044\u308b\u306e\uff1f"}
{"translation": "\u30a2\u30ec\u30c3\u30af\u306f\u9707\u3048\u306a\u304c\u3089\u5c0b\u306d\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u5348\u524d6\u664255\u5206\u3067\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u81ea\u5206\u306e\u30d1\u30c8\u30ed\u30fc\u30eb\u30ab\u30fc\u306b\u30b8\u30e3\u30b1\u30c3\u30c8\u3092\u6b8b\u3057\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u3053\u3063\u3061\u5074\u306b\u7f8a\u306f\u6765\u306a\u3044\u3088\u3001\u3068\u8fb2\u5834\u4e3b\u306f\u7b54\u3048\u3092\u7121\u8996\u3057\u8a00\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\uff08\u8fb2\u5834\u4e3b\uff09\u304c\u4e18\u3092\u98db\u3073\u8d8a\u3057\u3066\u3001\u305d\u306e\u50be\u659c\u3067\u82e5\u5e72\u6ed1\u308a\u306a\u304c\u3089\u30d6\u30fc\u30c4\u3092\u5f15\u304d\u305a\u308a\u307e\u3059\u3002"}
{"translation": "\u300c\u666e\u6bb5\u3001\u3053\u3053\u306e\u65b9\u3078\u6765\u308b\u306e\u304c\u5927\u597d\u304d\u3060\u3088\u300d"}
{"translation": "\u305d\u3057\u3066\u4eca\u3001\u5f7c\u3089\u306e\u305f\u3044\u307e\u3064\u306f\u524d\u65b9\u306b\u6e7e\u66f2\u3057\u305f\u571f\u624b\u3092\u7167\u3089\u3057\u51fa\u3057\u307e\u3057\u305f\u3001\u305d\u308c\u306f\u8fb2\u6c11\u304c\u990a\u751f\u3057\u305f\u6e7f\u5730\u3092\u5207\u308a\u958b\u304f\u6d45\u3044\u6d41\u308c\u306e\u9802\u4e0a\u306b\u3042\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u306e\u6ce5\u3060\u3089\u3051\u306e\u7aef\u3068\u5468\u56f2\u5168\u4f53\u3067\u3001\u8466\u306f\u30cf\u30a8\u3084\u30af\u30ea\u30b1\u30c3\u30c8\u3084\u6587\u9ce5\u305f\u3061\u3068\u4e00\u7dd2\u306b\u6b4c\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
