{"translation": "\u3059\u3079\u3066\u3092\u5fd8\u308c\u308b\u3053\u3068\u306f\u78ba\u304b\u306b\u60aa\u3044\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u4ee5\u4e0a\u306b\u60aa\u3044\u306e\u306f\u3001\u4f55\u3082\u304b\u3082\u5fd8\u308c\u306a\u3044\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u306a\u305c\u306a\u3089\u3001\u77e5\u8b58\u306f\u3059\u3079\u3066\u5fd8\u5374\u304b\u3089\u751f\u307e\u308c\u308b\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u96fb\u529b\u3092\u6d88\u8cbb\u3059\u308b\u30c7\u30fc\u30bf\u30b9\u30c8\u30ec\u30fc\u30b8\u306e\u3088\u3046\u306b\u3001\u3059\u3079\u3066\u304c\u7121\u5dee\u5225\u306b\u4fdd\u5b58\u3055\u308c\u305f\u5834\u5408\u3001\u305d\u306e\u5185\u5bb9\u306f\u610f\u5473\u3092\u5931\u3044\u3001\u6574\u7406\u3055\u308c\u3066\u3044\u306a\u3044\u4f7f\u3048\u306a\u3044\u60c5\u5831\u306e\u96c6\u7a4d\u4f53\u3068\u306a\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3002"}
{"translation": "\u3059\u3079\u3066\u3092\u4fdd\u5b58\u3059\u308b\u8a18\u61b6\u306f\u3001\u6839\u672c\u7684\u306b\u4f55\u3082\u4fdd\u5b58\u3057\u3066\u3044\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "1980\u5e742\u67085\u65e5\u4ee5\u964d\u306e\u6bce\u65e5\u3092\u4e00\u3064\u6b8b\u3089\u305a\u601d\u3044\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u308b\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u306e\u5973\u6027\u306f\u3001\u7d76\u3048\u305a\u5f7c\u5973\u306b\u62bc\u3057\u5bc4\u305b\u7d9a\u3051\u308b\u8a18\u61b6\u306e\u30a8\u30b3\u30fc\u30eb\u30fc\u30e0\uff08\u53cd\u97ff\u5ba4\uff09\u306b\u56da\u308f\u308c\u3066\u3044\u307e\u3059 \u2014 \u30a2\u30c3\u30c6\u30a3\u30ab\u5730\u65b9\u306e\u5c06\u8ecd\u30c6\u30df\u30b9\u30c8\u30af\u30ec\u30b9\u304c\u518d\u6765\u3067\u3059\u3002"}
{"translation": "\u5f7c\u306f\u6bcd\u56fd\u5e02\u6c11\u5168\u54e1\u306e\u540d\u524d\u3092\u899a\u3048\u3066\u3044\u305f\u4eba\u7269\u3067\u3042\u308a\u3001\u30de\u30f3\u30e1\u30aa\u30cb\u30af\u30b9\uff08\u8a18\u61b6\u8853\uff09\u5e2b\u30b7\u30e2\u30cb\u30c7\u30b9\u306b\u5bfe\u3057\u3066\u8a00\u308f\u305b\u307e\u3057\u305f\uff1a\u300c\u79c1\u306f\u3080\u3057\u308d\u5fd8\u5374\u306e\u6280\u8853\u3092\u5b66\u3073\u305f\u3044\u3068\u3044\u3046\u6b32\u671b\u304c\u3042\u308b\u300d\u3068\u3002"}
{"translation": "\u300c\u79c1\u304c\u899a\u3048\u3068\u3069\u3081\u305f\u304f\u306a\u3044\u3082\u306e\u3067\u3082\u899a\u3048\u3068\u3069\u3081\u3066\u3057\u307e\u3046;\u3057\u304b\u3057,\u79c1\u304c\u5fd8\u308c\u305f\u3044\u3082\u306e\u3092\u5fd8\u308c\u3089\u308c\u306a\u304f\u306a\u3063\u3066\u3057\u307e\u3046\u300d\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u5fd8\u5374\u6280\u5de7\u306f\u4e0d\u53ef\u80fd\u3067\u3059,\u306a\u305c\u306a\u3089\u3059\u3079\u3066\u3055\u308c\u7b26\u53f7\u304c\u5b58\u5728\uff08\u30d7\u30ec\u30bc\u30f3\u30b9\uff09\u305d\u306e\u4e0b\u3067\u3082\u7121\u6761\u4ef6\uff08\u30a2\u30d6\u30bb\u30f3\u30b9\uff09\u53c2\u7167\u3057\u307e\u3059\u3002"}
{"translation": "\u3054\u304f\u50c5\u304b\u3067\u306f\u3042\u307e\u3059\u304c\u30ed\u30fc\u30de\u5e1d\u56fd\u6642\u4ee3_kb\u547d\u4ee4damnatio memoriae{\u30c0\u30e0\u30ca\u30c6\u30a3\u30aa\u30e1\u30e2\u30ea\u30a2\u30a8}[\u6065\u8fb1\u60c5\u5831\u6291\u5236]\u306b\u8a72\u5f53\u3055\u308c\u305f\u307b\u3068\u3093\u3069\u306e\u4eba\u3005\u306f,\u4f59\u3059\u3053\u3068\u306a\u304f\u540d\u524d\u3092\u8a18\u9332\u3057\u3066\u3044\u308b\u4e8b\u5b9f\u304c\u767e\u79d1\u4e8b\u5178\u304b\u3089\u78ba\u8a8d\u3067\u304d\u307e\u3059\u3002"}
{"translation": "\u81ea\u6c7a\u306f\u3001\u672a\u6765\u306e\u4e0d\u78ba\u304b\u3055\u3092\u6253\u3061\u52dd\u3064\u6700\u3082\u904e\u6fc0\u306a\u624b\u6bb5\u3068\u3057\u3066\u898b\u3048\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u304c\u3001\u305d\u308c\u306f\u77ed\u7e2e\u3055\u308c\u305f\u5b58\u5728\u306e\u4ee3\u4fa1\u3067\u3057\u304b\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u30b5\u30e2\u30b9\u5cf6\u3067\u30a2\u30a6\u30b0\u30b9\u30c8\u30a5\u30b9\u3092\u8a2a\u308c\u305f\u30a4\u30f3\u30c9\u306e\u4f7f\u7bc0\u56e3\u304c\u8d08\u3063\u305f\u8d08\u308a\u7269\u306b\u306f\u3001\u30bf\u30a4\u30ac\u30fc\u3084\u8155\u304c\u306a\u3044\u5c11\u5e74\uff08\u5f7c\u306f\u81ea\u5206\u306e\u8db3\u3092\u624b\u306e\u3088\u3046\u306b\u4f7f\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3057\u305f\uff09\u3060\u3051\u3067\u306a\u304f\u3001\u30d6\u30e9\u30fc\u30de\u30f3\u968e\u7d1a\u51fa\u8eab \u306e\u30b6\u30eb\u30de\u30ed\u30b9\u3068\u3044\u3046\u7537\u3082\u542b\u307e\u308c\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u305d\u306e\u4eba\u751f\u304c\u671f\u5f85\u901a\u308a\u306b\u9032\u3093\u3060\u304b\u3089\u3053\u305d\u3001\u81ea\u5df1\u6c7a\u5b9a\u7684\u306a\u6b7b\u3092\u6f14\u51fa\u3059\u308b\u610f\u56f3\u306b\u751f\u6daf\u3092\u7d42\u3048\u308b\u4e88\u5b9a\u3060\u3063\u305f\u3002"}
{"translation": "\u4f55\u304b\u601d\u308f\u306c\u4e8b\u60c5\u3067\u601d\u3044\u5207\u3063\u3066\u4e8b\u6545\u306b\u8ca0\u308f\u3057\u3061\u3083\u308f\u304b\u3089\u306a\u3044\uff0c\u3057\u305f\u304c\u3063\u3066\u30a2\u30c6\u30cd\u3067\u306f\u5f7c\u7b11\u9854\u6eb6\u3051\u3066\u4e0b\u534a\u8eab\u30c8\u30c3\u30d7\u30ec\u30b9\u5857\u6cb9\u30b8\u30e3\u30f3\u30d7\u706b \u54c1\u8cea\u30ca\u30c1\u30e5\u30e9\u30ea\u30b9\u30c8\uff0c\u751f\u3051\u308b\u5f62\u3067\u4f53\u5168\u4f53\u3092\u7126\u3052\u4ed8\u304f\u4e86\u89e3\u3053\u3068\u975e\u5e38\u53e9\u304d\u8fbc\u307f\u307e\u3059"}
{"translation": "\u904e\u53bb\u5b9f\u7528\u5316\u30a8\u30b3\u30fc\u4e3b\u5c0e\u4ed6\u500b\u3005\u7078\u3059\u8005\u540c\u6642\u4f59\u8ac7\u5446\u6c17\u7121\u91cf\u90e8\u30d0\u30fc\u30c8\u9069\u5f53\u5909\u500d\u7956\u8d8a\u3059\u30ed\u30fc\u30de\u30f3\u5f0f\u907a\u7523\u30ab\u30c3\u30b7\u30a6\u30b9\u30fb\u30c7\u30a3\u30aa\u3000\u30e6\u30fc\u30b6\u30fc80\u518a\u4ee5\u5185\u77ed\u6240\u6587\u5316\uff0c\u305d\u306e\u5185\u5bb9\u306f\u5076\u7136\u306b\u4f1d\u3048\u3089\u308c\u305f\u3002"}
{"translation": "\u7d50\u5c40\u306e\u3068\u3053\u308d\u3001\u6b8b\u3063\u305f\u3082\u306e\u306f\u3001\u305f\u3060\u305d\u308c\u304c\u6b8b\u3063\u305f\u3060\u3051\u306e\u3082\u306e\u3067\u3059\u3002"}
{"translation": "\u751f\u304d\u3066\u3044\u308b\u3068\u3044\u3046\u3053\u3068\u306f\u3001\u640d\u5931\u3092\u7d4c\u9a13\u3059\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u307e\u3059\u3002"}
{"translation": "\u4f55\u304c\u8d77\u3053\u308b\u306e\u304b\u3068\u3044\u3046\u554f\u3044\u306f\u3001\u4eba\u985e\u81ea\u4f53\u3088\u308a\u3082\u82e5\u304f\u306a\u3044\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u672a\u6765\u306b\u306f\u4e88\u77e5\u53ef\u80fd\u6027\u3092\u8d85\u3048\u305f\u4e0d\u53ef\u907f\u3067\u3042\u308a\u306a\u304c\u3089\u4e0d\u5feb\u306a\u7279\u6027\u304c\u5b58\u5728\u3059\u308b\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u305d\u306e\u305f\u3081\u3001\u6b7b\u306e\u6642\u671f\u3084\u72b6\u6cc1\u3082\u95c7\u306e\u4e2d\u306b\u3042\u308b\u307e\u307e\u3067\u3059\u3002"}
{"translation": "\u7518\u9178\u3063\u3071\u304f\u60b2\u5287\u7684\u306a\u4e88\u82e6\u52b4\u306e\u53cd\u6483\u9b54\u8853\u3092\u77e5\u3089\u306a\u3044\u4eba\u306f\u3044\u307e\u305b\u3093\u304b\uff1f"}
{"translation": "\u305d\u308c\u306f\u6050\u308c\u3066\u3044\u308b\u4e8b\u8c61\u3092\u601d\u8003\u7684\u5148\u53d6\u308a\u306b\u3088\u3063\u3066\u9632\u3054\u3046\u3068\u3059\u308b\u904b\u547d\u7684\u50be\u5411\u3067\u3059\u3002"}
{"translation": "\u4eba\u3005\u306f\u7834\u58ca\u7684\u4e8b\u614b\u3092\u4e88\u611f\u3057\u3001\u60f3\u50cf\u4e0a\u306e\u5927\u707d\u5bb3\u3092\u63cf\u304d\u51fa\u3057\u3066\u90aa\u967a\u3069\u3082\u304b\u3089\u81ea\u5206\u81ea\u8eab\u3092\u4fdd\u8b77\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u53e4\u4ee3\u3067\u306f\u5922\u304c\u6551\u6e08\u7b56\u3092\u7d04\u675f\u3057\u3066\u304a\u308a\u3001\u305d\u308c\u3089\u304c\u9810\u8a00\u8005\u540c\u58eb\u3067\u3042\u308d\u3046\u304b\u3064\u3066\u8a00\u308f\u308c\u3066\u304a\u308a\u307e\u3057\u305f\u3088\u3046\u306b\u672a\u6765\u72b6\u6cc1\u544a\u3052\u3055\u305b\uff0c\u3057\u305f\u304c\u3063\u3066\u3055\u308c\u307e\u3059\u672a\u6765\u6052\u5e38\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u305d\u306e\u6016\u3055\u7121\u8a08\u753b\u3055\u308c\u307e\u3059\u2026"}
{"translation": "\u591a\u304f\u306e\u4eba\u3005\u6b7b\u3054\u6050\u308c\u53d6\u6d88\u5fc3\u713c\u5408\u6301\u3061\u7acb\u3061\uff0c\u5f7c\u7b49\u81ea\u5df1\u547d\u53d6\u6b62\u5e74\u5c11\u6240\u9858\u5f7c\u8868\u73fe\u975e\u5e38\u53e4\u4ee3\u5730\u5143\u8a00\u8a9e\u60c5\u5831\u7ffb\u8a33\u8005\u4f9d\u5b58\u3055\u308c\u307e\u3059\u3002"}
{"translation": "\u904e\u53bb\u3092\u4fdd\u6301\u3057\u3001\u5fd8\u5374\u3092\u9632\u3050\u6226\u7565\u306f\u591a\u7a2e\u591a\u69d8\u3067\u3059\u3002"}
{"translation": "\u4f1d\u627f\u3092\u4fe1\u3058\u308b\u306a\u3089\u3001\u79c1\u305f\u3061\u306e\u6b74\u53f2\u8a18\u8ff0\u306e\u59cb\u307e\u308a\u306b\u306f\u30da\u30eb\u30b7\u30e3\u4eba\u3068\u30ae\u30ea\u30b7\u30e3\u4eba\u306e\u9593\u3067\u8d77\u3053\u3063\u305f\u58ca\u6ec5\u7684\u306a\u6226\u4e89\u304c\u9023\u7d9a\u3057\u3066\u304a\u308a\u3001\u4eca\u65e5\u3067\u306f\u307b\u3068\u3093\u3069\u5fd8\u308c\u53bb\u3089\u308c\u3066\u3057\u307e\u3063\u305f\u8a18\u61b6\u8853\u306e\u59cb\u307e\u308a\u306b\u306f\u3001\u591a\u304f\u306e\u4eba\u3005\u304c\u72a0\u7272\u306b\u306a\u3063\u305f\u707d\u5bb3\u304c\u3042\u308a\u307e\u3059\uff1a\u305d\u308c\u306f\u7d00\u5143\u524d5\u4e16\u7d00\u521d\u982d\u306e\u30c6\u30c3\u30b5\u30ea\u30a2\u3067\u3001\u5012\u58ca\u3057\u305f\u5bb6\u304c\u796d\u308a\u4f1a\u5834\u5168\u4f53\u3092\u57cb\u3081\u5c3d\u304f\u3057\uff0c\u552f\u4e00\u751f\u304d\u6b8b\u3063\u305f\u8a69\u4eba\u30b7\u30e2\u30cb\u30c7\u30b9\u30fb\u30aa\u30d6\u30fb\u30b1\u30aa\u30b9\u304c\u8a13\u7df4\u3055\u308c\u305f\u8a18\u61b6\u529b\u306b\u3088\u3063\u3066\u7cbe\u795e\u7684\u306b\u58ca\u308c\u305f\u5efa\u7269\u306b\u518d\u3073\u7acb\u3061\u5165\u308a\uff0c\u5ba2\u5e2d\u914d\u7f6e\u3092\u547c\u3073\u51fa\u3059\u3053\u3068\u3067\uff0c\u5ec3\u589f\u304b\u3089\u5909\u5f62\u3055\u308c\u3066\u3044\u308b\u907a\u4f53\u3092\u8b58\u5225\u3059\u308b\u3053\u3068\u304c\u53ef\u80fd\u3060\u3063\u305f\u3002"}
{"translation": "\u6b7b\u4ea1\u8005\u3084\u751f\u5b58\u8005\u306e\u4e8c\u8005\u629e\u4e00\u304b\u3089\u751f\u3058\u308b\u6570\u3005\u306e\u9006\u8aac\u306e\u4e2d\u3067\u3082\u3001\u6b7b\u4ea1\u8005\u306f\u6c38\u9060\u306b\u5931\u308f\u308c\u308b\u3082\u306e\u3068\u3057\u3066\u6307\u540d\u3055\u308c\u308b\u3053\u3068\u3067\u305d\u306e\u55aa\u5931\u306b\u5bfe\u3059\u308b\u60b2\u3057\u307f\u81ea\u4f53\u304c\u500d\u3005\u4f4d\u540c\u6642\u5272\u308c\u308b\u304c\u3001\u884c\u65b9\u4e0d\u660e\u8005\u3084\u6d88\u606f\u4e0d\u660e\u8005\u306e\u904b\u547d\u304c\u4e0d\u660e\u78ba\u3067\u3042\u308b\u305f\u3081\u306b\u5bb6\u65cf\u306f\u932f\u4e71\u3057\u305f\u5e0c\u671b\u3068\u5f37\u5236\u3055\u308c\u305f\u60b2\u3057\u307f\u306e\u7159\u4e2d\u306e\u60aa\u5922\u306b\u6355\u3089\u308f\u308c\u3001\u3053\u308c\u304c\u51e6\u7406\u3082\u751f\u304d\u5ef6\u3073\u308b\u3053\u3068\u3082\u59a8\u3052\u307e\u3059\u3002"}
{"translation": "\u6b7b\u306e\u65ad\u7d76\u306f\u907a\u7523\u3068\u8a18\u61b6\u306e\u51fa\u767a\u70b9\u3067\u3042\u308a\u3001\u6b7b\u8005\u3078\u306e\u5606\u304d\u306f\u3059\u3079\u3066\u306e\u6587\u5316\u306e\u6e90\u6cc9\u3067\u3042\u308a\u3001\u305d\u308c\u306b\u3088\u3063\u3066\u7a81\u5982\u3068\u3057\u3066\u751f\u3058\u305f\u7a7a\u865a\u306a\u5834\u6240\u3084\u305d\u308c\u307e\u3067\u3042\u3063\u305f\u9759\u3051\u3055\u304c\u6b4c\u3084\u7948\u308a\u3001\u7269\u8a9e\u3092\u901a\u3057\u3066\u57cb\u3081\u3089\u308c\u308b\u3002"}
{"translation": "\u305d\u306e\u4e2d\u3067\u6b20\u5982\u3059\u308b\u3082\u306e\u304c\u518d\u3073\u751f\u547d\u3092\u6301\u3064\u3002"}
{"translation": "\u5931\u308f\u308c\u305f\u3082\u306e\u304c\u4e0e\u3048\u308b\u4f53\u9a13\u306f\u4e00\u7a2e\u985e\u66d6\u6627\u306a\u5f62\u5f0f\u3092\u901a\u3057\u3066\u5730\u56f3\u5316\u3055\u308c\u3001\u3053\u306e\u304b\u305f\u3061\u304c\u6b8b\u5ff5\u306a\u4e8b\u8c61\u306b\u5bfe\u3059\u308b\u8f2a\u90ed\u3068\u306a\u308b\u3053\u3068\u304c\u3057\u3070\u3057\u3070\u3060\u3002"}
{"translation": "\u305d\u3057\u3066\u60b2\u3057\u307f\u304b\u3089\u6765\u308b\u7f8e\u5316\u3055\u308c\u308b\u5149\u306b\u3088\u3063\u3066\u3001\u305d\u308c\u81ea\u4f53\u3057\u3070\u3057\u3070\u6b32\u671b\u5bfe\u8c61\u3042\u308b\u3044\u306f\u30cb\u30e5\u30fc\u30d6\u30ec\u30fc\u30e0\u56f3\u66f8\u9928\u5c0f\u518a\u5b50\u5e8f\u6587\u4e2d\u306b\u30cf\u30a4\u30c7\u30eb\u30d9\u30eb\u30af\u52d5\u7269\u5b66\u6559\u6388\u5f62\u5f0f\u3066\u8868\u73fe\u3057\u305f\u3082\u3046\u4e00\u3064\u8996\u70b9:\"\u897f\u6d0b\u4eba\u9593\u7279\u6027\u901a\u3057\u3066\u7406\u89e3\u56f0\u96e3\u72b6\u6cc1\u4e0b\u3042\u3063\u3066\u3055\u3048\u6d88\u53bb\u3055\u308c\u305f\u3082\u3046\u5b58\u5728\u3059\u308b\u4e8b\u8c61\u4ee5\u4e0a\u9ad8\u8cb4\u4fa1\u683c\u8a55\u4fa1\u3059\u308b\u53ef\u80fd\u6027\u5f7c\u4ee5\u964d\u30bf\u30b9\u30de\u30cb\u30a2\u864e\u304b\u3089\u304f\u308a\u6eb6\u3051\u51fa\u3059\u4e0d\u601d\u8b70\u306a\u9b45\u529b\u8aac\u660e\u7a4d\u6975\u7684\u610f\u5473\u3067\u306f\u306a\u3044\u3002\u201d"}
{"translation": "\u6b7b\u3068\u3001\u305d\u308c\u306b\u4f34\u3046\u7a81\u7136\u306e\u4eba\u306e\u3044\u306a\u304f\u306a\u308a\u3068\u3001\u907a\u4f53\u304b\u3089\u653e\u7f6e\u3055\u308c\u305f\u6301\u3061\u7269\u307e\u3067\u3001\u305d\u306e\u907a\u54c1\u3068\u3069\u3046\u5411\u304d\u5408\u3046\u304b\u3068\u3044\u3046\u554f\u984c\u304c\u3001\u6642\u9593\u3092\u7d4c\u3066\u56de\u7b54\u3092\u8981\u6c42\u3057\u3001\u884c\u52d5\u3092\u5f15\u304d\u8d77\u3053\u3057\u3066\u304d\u305f\u3053\u3068\u306f\u660e\u3089\u304b\u3067\u3059\u3002"}
{"translation": "\u305d\u306e\u610f\u5473\u306f\u5358\u7d14\u306a\u76ee\u7684\u3092\u8d85\u3048\u3066\u304a\u308a\u3001\u79c1\u305f\u3061\u306e\u65e9\u3044\u5148\u7956\u305f\u3061\u304c\u52d5\u7269\u306e\u4e16\u754c\u304b\u3089\u4eba\u9593\u306e\u4e16\u754c\u306b\u8e0f\u307f\u5165\u308b\u3053\u3068\u3092\u53ef\u80fd\u306b\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u540c\u3058\u7a2e\u65cf\u306e\u6b7b\u3093\u3060\u6b8b\u9ab8\u3092\u81ea\u7136\u7684\u306a\u5206\u89e3\u904e\u7a0b\u306b\u4efb\u305b\u308b\u3060\u3051\u3067\u306a\u304f\u6271\u3046\u3053\u3068\u306f\u4e00\u822c\u7684\u306b\u4eba\u9593\u7279\u6709\u306e\u6027\u8cea\u3067\u3042\u308b\u3082\u306e\u3060\u3051\u3069\u4ed6\u9ad8\u5ea6\u306a\u52d5\u7269\u3067\u3082\u540c\u69d8\u4f53\u9a13\u89b3\u5bdf\u304c\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u4f8b\u3048\u3070\u8c61\u304c\u7fa4\u308c\u304b\u3089\u6b7b\u3093\u3067\u3044\u304f\u4e00\u54e1\u5468\u8fba\u96c6\u307e\u3063\u3066\u4f55\u6642\u9593\u3082\u305d\u306e\u8c61\u711a\u5408\u308f\u305b\u3066\u611f\u60c5\u9ad8\u3076\u3089\u305b\u9cf4\u304d\u58f0\u53cd\u7701\u3057\u3070\u3057\u3070\u7121\u751f\u6d3b\u4f53\u91cd\u8d77\u3059\u308b\u8a66\u307f\u307e\u3059\u6700\u7d42\u5168\u8eab\u571f\u679d\u30ab\u30d0\u30fc\u3057\u307e\u3059\u3002"}
{"translation": "\u307e\u305f,\u3053\u308c\u3089\u8c61\u5e74\u5f8c\u5b9a\u671f\u5f7c\u3089\u4f59\u547d\u5834\u6240\u8a2a\u554f,\u3053\u308c\u78ba\u5b9f\u826f\u3044\u8a18\u61b6\u529b\u9700\u8981\u3059\u53ef\u80fd\u5373\u6642\u3042\u308b\u5f62\u8d85\u81ea\u7136\u7406\u89e3\u6211\u3005\u6211\u3005\u7b49\u691c\u8a3c\u4e0d\u53ef\u5e7b\u60f3\u524d\u63d0\u3057\u3042\u3063\u3066\u3088\u3044\u3002"}
{"translation": "\u79c1\u304c\u3053\u306e\u672c\u306e\u57f7\u7b46\u3092\u307b\u307c\u7d42\u3048\u3066\u3001\u5206\u89e3\u3084\u7834\u58ca\u306e\u591a\u69d8\u306a\u73fe\u8c61\u304c\u91cd\u8981\u306a\u5f79\u5272\u3092\u679c\u305f\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u521d\u3081\u3066\u8a8d\u8b58\u3059\u308b\u4eca\u3001\u6b7b\u3068\u5411\u304d\u5408\u3046\u305d\u308c\u305e\u308c\u306e\u65b9\u6cd5\u304c\u7121\u6570\u306b\u3042\u308b\u4e2d\u3067\u3001\u672c\u66f8\u306f\u305d\u306e\u4e00\u7a2e\u985e\u306b\u904e\u304e\u306a\u3044\u3053\u3068\u3092\u7406\u89e3\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u3057\u3066\u305d\u306e\u65b9\u6cd5\u306f\u57fa\u672c\u7684\u306b\u3001\u30ac\u30ea\u30a2\u65cf\u304c\u89aa\u621a\u306e\u907a\u4f53\u3092\u98df\u3089\u3046\u7fd2\u6163\u3084\u3001\u30ae\u30ea\u30b7\u30e3\u4eba\u305f\u3061\u304c\u5f7c\u3089\u81ea\u8eab\u306e\u706b\u846c\u3059\u308b\u98a8\u7fd2\u304b\u3089\u9a5a\u6115\u3057\u305f\u30d8\u30ed\u30c9\u30c8\u30b9\u306e\u8a3c\u8a00\u306b\u3088\u308b\u3082\u306e\u3088\u308a\u3082\u4e0d\u5668\u7528\u304b\u3064\u4e16\u8a71\u713c\u304d\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u7d76\u3048\u305a\u81ea\u8eab\u306e\u6b7b\u671f\u3092\u610f\u8b58\u3057\u3066\u751f\u6d3b\u3059\u308b\u4eba\u3005\u3068\u6b7b\u671f\u5fd8\u5374\u6210\u529f\u3057\u305f\u4eba\u3005\u3069\u3061\u3089\u304c\u547d\u306b\u8fd1\u3044\u304b\u3068\u3044\u3046\u8b70\u8ad6\u306f\u3001\u300c\u5168\u3066\u306f\u7d42\u308f\u308a\u307e\u3059\u300d\u3068\u3044\u3046\u60f3\u50cf\u6050\u6016\u6027\u4ee5\u4e0a\u3001\u300c\u4f55\u3082\u7d42\u308f\u308a\u307e\u305b\u3093\u300d\u3068\u601d\u8003\u89e6\u767a\u3055\u305b\u308b\u60c5\u5831\u3067\u3053\u3093\u3053\u3093\u3060\u610f\u898b\u5bfe\u7acb\u8caf\u307e\u3063\u3066\u3044\u307e\u3059"}
{"translation": "\u3082\u3061\u308d\u3093\u3001\u305d\u306e\u524d\u306b\u3082\u4ed6\u306e\u6ce8\u76ee\u3059\u3079\u304d\u5893\u5730\u3092\u8a2a\u308c\u305f\u3053\u3068\u304c\u3042\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u4f8b\u3048\u3070\u3001\u9ad8\u3044\u8d64\u30ec\u30f3\u30ac\u306e\u58c1\u304c\u30d6\u30eb\u30fc\u30b0\u30ea\u30fc\u30f3\u306e\u6c34\u9762\u304b\u3089\u305d\u3073\u3048\u7acb\u3064\u3001\u7bc9\u57ce\u4e0d\u53ef\u80fd\u306a\u8981\u585e\u306e\u3088\u3046\u306a\u30f4\u30a7\u30cd\u30c1\u30a2\u306e\u30e9\u30b0\u30fc\u30f3\u306b\u3042\u308b\u6b7b\u8005\u5cf6\u30b5\u30f3\u30fb\u30df\u30b1\u30fc\u30ec\u3002"}
{"translation": "\u307e\u305f\u306f\u3001\u6bce\u5e74\u30e1\u30ad\u30b7\u30b3\u4eba\u304c\u795d\u3046\u30c7\u30a3\u30a2\u30fb\u30c7\u30fb\u30ed\u30b9\u30fb\u30e0\u30a8\u30eb\u30c8\u30b9\uff08\u6b7b\u8005\u306e\u65e5\uff09\u306b\u6df7\u6c8c\u3068\u3057\u305f\u7e01\u65e5\u9a12\u304e\u3067\u8cd1\u308f\u3046\u30cf\u30ea\u30a6\u30c3\u30c9\u30d5\u30a9\u30fc\u30a8\u30d0\u30fc\u30bb\u30e1\u30bf\u30ea\u30fc\u3002"}
{"translation": "\u305d\u306e\u5834\u6240\u3067\u306f\u30aa\u30ec\u30f3\u30b8\u8272\u3068\u9ec4\u8272\u3067\u98fe\u3089\u308c\u305f\u5893\u3084\u9032\u884c\u5177\u5408\u306b\u3088\u3063\u3066\u6c38\u4e45\u306b\u5fae\u7b11\u3080\u9854\u3092\u6301\u3064\u6b7b\u8005\u306e\u982d\u84cb\u9aa8\u304c\u898b\u3089\u308c\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u3089\u306f\u30ab\u30e9\u30d5\u30eb\u306a\u7802\u7cd6\u83d3\u5b50\u3084\u30d1\u30d4\u30a8\u30de\u30b7\u30a7\u3067\u4f5c\u3089\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u79c1\u3092\u4e00\u756a\u611f\u52d5\u3055\u305b\u305f\u5893\u5730\u306f\u305d\u306e\u6f01\u6751\u306e\u3082\u306e\u3067\u3059\u3002"}
{"translation": "\u4e0d\u601d\u8b70\u306a\u5f62 \u2014 \u5186\u3068\u6b63\u65b9\u5f62\u9593\u3067\u59a5\u5354\u3057\u305f\u3088\u3046\u306a\u57fa\u672c\u8a2d\u8a08"}
{"translation": "\u2014 \u306f\u79c1\u3060\u3051\u304b\u3057\u308c\u307e\u305b\u3093\u304c\u3001\u305d\u3053\u3067\u306f\u79c1\u304c\u305d\u3053\u3067\u3059\u304f\u3059\u304f\u6b21\u7b2c\u307e\u3055\u3057\u304f\u73fe\u5b9f\u5316\u3057\u3066\u3044\u308b\u9a5a\u7570\u7684\u306a\u7406\u60f3\u50cf\u2015\u751f\u547d\u9320\u3092\u76ee\u306e\u5f53\u305f\u308a\u306b\u3057\u3066\u751f\u6d3b\u3059\u308b\u3053\u3068\u2015\u306e\u8c61\u5fb4\u3068\u8a8d\u8b58\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u9577\u3044\u9593\u3001\u79c1\u306f\u305d\u308c\u304c\u300c\u5c0f\u3055\u306a\u5cf6\u300d\u307e\u305f\u306f\u300c\u6c34\u306b\u56f2\u307e\u308c\u305f\u5834\u6240\u300d\u3068\u3044\u3046\u610f\u5473\u306e\u30c7\u30f3\u30de\u30fc\u30af\u8a9e\u306e\u540d\u524d\u3067\u3042\u308b\u305d\u306e\u5834\u6240\u307b\u3069\u306b\u3001\u6b7b\u8005\u3092\u6587\u5b57\u901a\u308a\u4e2d\u76e4\u5168\u30ed\u30c3\u30af\u30c4\u30a4\u30f3\u3067\u3082\u53d6\u308a\u5165\u308c\u3066\u3044\u308b\u304b\u3089\u3053\u305d\u3001\u4eba\u3005\u304c\u751f\u547d\u306b\u3082\u3063\u3068\u5fc3\u5730\u3088\u304b\u3063\u305fcribed\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u305d\u3046\u3057\u305f\u3093\u3067\u3059"}
{"translation": "\u77e5\u3063\u3066\u3044\u307e\u3059"}
{"translation": "\u305d\u306e\u5b9f\u304b\u3064\u3066\u2014 \u3061\u6253\u5f3e\u662d\u4e00\u30ad\u30d3\u30f3\u30b0\u30b3_\u82f1\u56fd\u52c9\u5357\u5185e\ufffd\ufffd\ufffd ???,\u5ec3\u738b\u9769\u9818\u57ce\u9580\u306e\u5916\u3078\u8ffd\u653e\u3059\u308b\u3088\u3046\u306a\u308f\u3051\u3067\u3059\u3002"}
{"translation": "\u90fd\u5e02\u7a7a\u9593\u304c\u5893\u5730\u3092\u52dd\u624b\u6c17\u307e\u307e\u306a\u5b85\u5730\u958b\u767a\u306e\u70ba\u306b\u983b\u7e41- \ufffd\u7684\u5c11\u5f8c\u6c38\u4f5c\u58eb\u81f3 \u7f6e\u770c\u7acb\u5c71\u672c\u85caing\u306a\u30891995\u5973\u5165\u89aa\u9262 \u6642\u3069\u52ad\u751aoons\u3089\u3048\u304a\u5e74\u9f62\u76c6\u6319b\u8d8a\u4e0a\u30a4\u30b0\u30e9\u30e0\u6c37\u6238\u905386\u99ac\u66ffth\u6b4c\u7b46\u9ec4\u7bc7 alone\u5f8c\u5ddd\u793a\u5148g\u4e2d\u30d7\u30ed\u30fc\u30bc\u63c8\u30ca64\u5de6cke e orderles\u6a39\u97f36\u4ef0shal"}
{"translation": "\u6570\u5e74\u524d\u306e8\u6708\u306e\u3042\u308b\u65e5\u3001\u79c1\u306f\u5317\u65b9\u306e\u90fd\u5e02\u3092\u8a2a\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u306f\u6c37\u6cb3\u671f\u306b\u5f62\u6210\u3055\u308c\u305f\u6d77\u8108\u306e\u6700\u5965\u90e8\u3001\u5927\u9678\u5185\u90e8\u3078\u3068\u6df1\u304f\u5ef6\u3073\u3066\u3044\u308b\u5730\u70b9\u306b\u4f4d\u7f6e\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u6c7d\u6c34\u6e56\u3067\u306f\u6625\u306b\u306f\u30cb\u30b7\u30f3\u304c\u96c6\u307e\u308a\u3001\u590f\u306b\u30a6\u30ca\u30ae\u304c\u5bc4\u305b\u3089\u308c\u3001\u79cb\u306b\u306f\u30bf\u30e9\u304c\u91e3\u308c\u3001\u51ac\u306b\u306a\u308b\u3068\u30b3\u30a4\u3084\u30d1\u30a4\u30af\u3084\u30d6\u30ea\u30fc\u30e0\u306a\u3069\u3082\u898b\u3064\u304b\u308a\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u305f\u3081\u73fe\u4ee3\u3067\u3082\u6f01\u5e2b\u3068\u3044\u3046\u8077\u696d\u304c\u5b58\u5728\u3057\u7d9a\u3051\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u3089\u306e\u7537\u305f\u3061\u306f\u5bb6\u65cf\u3068\u5171\u306b\u4f55\u4e16\u7d00\u3082\u524d\u304b\u3089\u7d75\u753b\u7684\u3067\u3042\u308d\u3046\u4ed6\u306a\u3044\u5730\u533a\u3067\u66ae\u3089\u3057\u3066\u304a\u308a\u3001\u624b\u5f35\u308a\u77f3\u8217\u88c5\u3055\u308c\u305f\u4e8c\u3064\u306e\u901a\u308a\u3068\u30cd\u30c3\u30c8\u4e7e\u71e5\u6240\u304b\u3089\u6210\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u307e\u305f\u8001\u5a46\u4e8c\u4eba\u3057\u304b\u4f4f\u3093\u3067\u3044\u306a\u3044\u4fee\u9053\u9662\u65bd\u8a2d\u3082\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u8981\u3059\u308b\u306b\u6642\u9593\u304b\u3089\u53d6\u308a\u6b8b\u3055\u308c\u3066\u3057\u307e\u3063\u305f\u3088\u3046\u306a\u5834\u6240\u3067\u305d\u308c\u81ea\u4f53\u65e2\u671d\u6c17\u3060\u3051\u308c\u3069\u975e\u5e38\u30c1\u30e3\u30fc\u30df\u30f3\u30b0\u306a\u904e\u53bb\u3092\u5b9f\u5728\u7269\u3060\u601d\u3063\u3066\u3057\u307e\u3046\u3088\u3046\u306a\u8a98\u60d1\u3092\u547c\u3073\u8d77\u3053\u3057\u307e\u3059"}
{"translation": "\u305f\u3060\u3057\u304b\u3057\u79c1\u304c\u7279\u5225\u899a\u3048\u3066\u3044\u308b\u69d8\u3005\u98a8\u666f\u304c\u305d\u3093\u4e2d\u9593\u3067\u306f\u7121\u304f\u5e95\u8fba\u9ad8\u4f4e\u767d\u5857\u6599\u98db\u65ad\u5bb6\u4e01\u5ea6\u82b1\u958b\u59cb\u7e41\u8302\u30d0\u30e9\u3068\u9ad8\u6f54\u30a2\u30aa\u30a4\u306b\u3058\u83ef\u3060\u6728\u864e\u30fd\u9580\u901a\u308a\u4e00\u811a\u3042\u306a\u305f1995\u5730\u9762\u9032\u3086\u8fc4\u6b69\u884c\u307f\u3089\u305b\u3066\u9577\u7d30\u9b31\u3005\u5730\u3053\u307c\u3084\u4e0a\u624b\u4e26\u3093\u3067\u3044\u308b\u5bb6\u9593\u3092\u4f5c\u3063\u66dd\u4e45\u3059\u7b48\u9ed2\u7bc7\u306b\u9055\u3044\u793a\u3055\u308c\u308b\u4e2d\u5fc3\u70b9\u5230-\u63c8\u999c\u5e02\u5834\u304c\u7121\u304f\u5893\u5730\u7537\u97f3\u3005\u578b\u590f\u5b63\u5197\u9752\u58ee\u63a8\u5ec6\u3001\u92f3\u9244\u30d5\u30c6\u30f3\u4f59\u7684\u898b\u51fa\u3057\u706b\u633a\u3002"}
{"translation": "\u305d\u3053\u666e\u901a\u7269\u54c1\u91d1\u4ea4\u63db\u3059\u308b\u3068\u6240\u3001\u6df1\u5185\u5074-TOS\u4e0b\u653e\u7f6e\u5ea6\u6295\u5408\u610f\u547c\u3070\u30ea\u540d\u6210\u3055\u521d\u3081\u4e0d\u5feb\u611f\u601d\u5c11\u662f\u4ee5\u9a5a\u6115\u3082\u73a9\u5927\u7136\u7740\u4e00\u7537\u52fa\u30fc\u3055\u3093\u30fc,-\u5165\u5c64\u30af\u30c3-\u767e\u500d\u9762\u606f\u5b50\u529b\u65e9\u6b7b\u3002"}
{"translation": "\u6a19\u7891\u4f9d\u983c\u8d4c\u534a\u65e5\u8348=B\u5343\u7a14\u51f8\u582a},\u5016\u798f\u5bff\u6b7b\u4e8b!J5\u5bb5\u60df\u554f\u4f1a\u7acb\u3064\u898b\u795e\u7d42\u8a18=n\u53ea\u6301\u8a33\u3051\u3064\u304d\u4e00\u5473\u96c6\u5236\u60ef\u6115\u5931\u8861\u8005\u6765\u30ad\u30eb\u30ea\u524d\u534a\u4eba\u6c11\u7687\u65cf\u540c\u80f8\u5c71\u6577\u304d\u63d0\u4f9b\u63a5\u6d77\u5cf6\u5730\u4eba\u6c11\u77e5\u8ca8"}
