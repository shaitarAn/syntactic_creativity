{"translation": "\u79c1\u306e\u982c\u306b\u3042\u308b\u3082\u306e\u306f\u604b\u611b\u306e\u624b\u7a3f\u3060\uff1a\u305d\u308c\u306f\u3001\u7537\u304c\u5973\u3068\u51fa\u4f1a\u3046\u7269\u8a9e\u3060\u3051\u308c\u3069\u3001\u5f7c\u306f\u65e2\u5a5a\u3067\u3001\u5f7c\u5973\u306b\u306f\u5f7c\u6c0f\u304c\u3044\u308b\u3002"}
{"translation": "\u305d\u306e\u7269\u8a9e\u306e7\u30da\u30fc\u30b8\u3092\u8aad\u3093\u3060\u3060\u3051\u3067\u3001\u65e2\u306b\u5fc3\u304b\u3089\u7406\u89e3\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u4f55\u3082\u79c1\u3092\u9a5a\u304b\u305b\u308b\u3053\u3068\u306a\u304f\u3002"}
{"translation": "\u6708\u65e5\u304c\u7d4c\u3063\u3066\u304b\u3089\u305a\u3063\u3068\u3001\u79c1\u306f\u65b0\u305f\u306b\u8aad\u3080\u3053\u3068\u306a\u304f\u518d\u8aad\u3057\u305f\u3002"}
{"translation": "\u540c\u3058\u53e4\u3044\u60c5\u8a71\u3092\u300c\u65b0\u4f5c\u300d\u3068\u3057\u3066\u7e70\u308a\u8fd4\u3057\u3001\u300c\u5b63\u7bc0\u300d\u3084\u300c\u6587\u5b66\u7684\u56de\u5e30\u300d\u3084\u6210\u529f\u4f5c\u3084\u5931\u6557\u4f5c\u3092\u751f\u307f\u51fa\u3059\u3002"}
{"translation": "\u300c\u65b0\u4f5c\u300d\u3068\u3055\u308c\u3066\u7684\u5916\u308c\u306a\u30e2\u30ce\u3070\u304b\u308a\u6d41\u901a\u3059\u308b\u30c8\u30e9\u30c3\u30af\u304c\u671d\u51fa\u767a\u3057\u5915\u65b9\u623b\u3063\u3066\u304f\u308b\u3002"}
{"translation": "\u300c\u65b0\u520a\u300d\u3067\u3082\u3046\u3059\u3050\u53e4\u66f8\u3068\u306a\u3063\u3066\u3057\u307e\u3046\u4e00\u518a\u4e00\u518a\u3002"}
{"translation": "\u4f55\u5e74\u524d\u306b\u306a\u308b\u306e\u3060\u308d\u3046\u3002"}
{"translation": "\u65b0\u305f\u306a\u5091\u4f5c\u3092\u767a\u898b\u3059\u308b\u559c\u3073\u3067\u98db\u3073\u8df3\u306d\u3001\u6708\u66dc\u65e5\u306b\u306f\u65b0\u3057\u3044\u4eba\u9593\u3068\u3057\u3066\u30aa\u30d5\u30a3\u30b9\u306b\u623b\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3001\u305d\u3093\u306a\u559c\u3073\u3092\u79c1\u304c\u5931\u3063\u3066\u304b\u3089\uff1f"}
{"translation": "\u4e8c\u5341\u5e74\uff1f\u4e09\u5341\u5e74\uff1f\u6b7b\u306e\u4e88\u611f\u3092\u62b1\u304b\u305b\u308b\u3088\u3046\u306a\u30ab\u30a6\u30f3\u30c8\u3092\u7d9a\u3051\u308b\u3053\u3068\u306f\u597d\u304d\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u76ee\u3092\u9589\u3058\u308c\u3070\u3001\u77bc\u306e\u88cf\u306b\u5747\u4e00\u306a\u9ec4\u8272\u3044\u706f\u308a\u304c\u898b\u3048\u307e\u3059\u3001\u305d\u308c\u306f\u30da\u30eb\u30bc\u30eb\u30e9\u30f3\u30d7\u306e\u5149\u3067\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u305d\u306e\u5149\u306f\u9ed2\u3044\u5f62\u5f71\u306b\u4fb5\u98df\u3055\u308c\u3066\u884c\u304d\u307e\u3059\u3001\u52d5\u304f\u5ec3\u589f\u3084\u30f4\u30a3\u30af\u30c8\u30fc\u30eb\u30fb\u30e6\u30fc\u30b4\u30fc\u306e\u7d75\u753b\u3067\u3059\u3002"}
{"translation": "\u547c\u5438\u306f\u843d\u3061\u7740\u304d\u3001\u5fc3\u62cd\u3082\u5c11\u3057\u305a\u3064\u9759\u307e\u3063\u3066\u884c\u304d\u307e\u3059\u3002"}
{"translation": "\u7720\u308a\u8fbc\u307f\u305d\u3046\u3067\u3059\u3001\u3042\u308b\u3044\u306f\u6b7b\u306b\u305d\u3046\u3067\u3082\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u675f\u7e1b\u3055\u308c\u305f\u307e\u307e\u6b7b\u3093\u3060\u3068\u8a00\u3048\u3070\u3001\u300c\u5f7c\u306f\u672c\u306b\u56f2\u307e\u308c\u3066\u751f\u6d3b\u3057, \u672c\u3092\u8aad\u307f\u7d9a\u3051\u3066\u6b7b\u3093\u3060\u300d \u3068\u8a00\u308f\u308c\u305d\u3046\u3067\u3059\u304c, \u5b9f\u969b\u7684\u306b\u3069\u3053\u304b\u9055\u3044\u307e\u3059 \u3002"}
{"translation": "\u79c1\u304c\u5b9f\u969b\u7684\u3058\u3083\u3063\u305f\u3089\u5922\u4e2d\u3067\u4f55\u3082\u8003\u3048\u3066\u3044\u306a\u304f\u3066\u305f\u3060\u606f\u7d76\u3048\u305f\u3060\u3051\u304b\u3082\u3057\u308c\u307e\u305b\u3093 \u7b11\u3002"}
{"translation": "\u79c1\u81ea\u8eab\u3069\u308c\u7a0b\u672c\u5f53\u306e\u8aad\u66f8\u304b\u3089\u4e45\u3057\u304f\u3042\u3063\u305f\u304b\u3082\u89e3\u3063\u3066\u3044\u307e\u305b\u3093\u3002"}
{"translation": "\u3061\u3083\u3093\u3068\u300c\u8aad\u3080\u300d\u3053\u3068\u304c\u51fa\u6765\u308b\u306e\u304b\u3001\u305d\u308c\u3055\u3048\u3082\u79c1\u306b\u306f\u5206\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u982d\u3092\u6a2a\u306b\u5411\u3051\u3070\u3001\u5fc3\u62cd\u304c\u5897\u3057\u3066\u6728\u6750\u306b\u632f\u52d5\u3092\u4e0e\u3048\u307e\u3059\u3002"}
{"translation": "\u5bb6\u5168\u4f53\u304c\u53e4\u3044\u7d19\u306e\u9759\u3051\u3055\u306b\u6c88\u3093\u3067\u3044\u307e\u3059\u3002"}
{"translation": "\u96ea\u306e\u3088\u3046\u306b\u3001\u672c\u306f\u97f3\u3092\u5438\u53ce\u3057\u307e\u3059\u3002"}
{"translation": "\u79c1\u306e\u4ed5\u4e8b\u306b\u306f\u305d\u306e\u9999\u308a\u3068\u606f\u82e6\u3057\u3055\u304c\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u3053\u306e\u9759\u5bc2\u306e\u4e2d\u3067\u305d\u308c\u3092\u3082\u3063\u3068\u6df1\u304f\u611f\u3058\u307e\u3059\u3002"}
{"translation": "\u4e16\u754c\u306e\u9a12\u97f3\u3078\u623b\u308b\u3053\u3068\u306f\u3001\u5e38\u306b\u8a66\u7df4\u3067\u3059\u3002"}
{"translation": "\u8ab0\u304c\u30ce\u30c3\u30af\u3057\u3066\u3044\u308b\u306e\u3060\u308d\u3046\uff1f"}
{"translation": "\u3053\u306e\u8efd\u3084\u304b\u3067\u5c0f\u3055\u304f\u3001\u63a7\u3048\u3081\u306a\u30ce\u30c3\u30af\u306f\u77e5\u3089\u306a\u3044\u3002"}
{"translation": "\u5c0f\u3055\u306a\u624b\u3002"}
{"translation": "\u3069\u3046\u305e\u5165\u3063\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u5f7c\u5973\u304c\u5165\u3063\u3066\u304d\u305f\u3002"}
{"translation": "\u79c1\u306f\u3053\u308c\u307e\u3067\u306b\u5f7c\u5973\u3092\u898b\u305f\u3053\u3068\u304c\u306a\u3044\u3002"}
{"translation": "\u305f\u3060\u3061\u306b\u90f7\u6101\u304c\u8fbc\u307f\u4e0a\u3052\u3066\u304d\u305f\u3001\u5bb6\u304c\u307e\u3060\u5c0f\u3055\u304f\u3001\u5eca\u4e0b\u3067\u5168\u3066\u306e\u5973\u6027\u9054\u306e\u3075\u304f\u3089\u306f\u304e\u3060\u3051\u3067\u5f7c\u5973\u9054\u3092\u898b\u5206\u3051\u3089\u308c\u305f\u9803\u306e\u90f7\u6101\u3060\u3002"}
{"translation": "\u5f7c\u5973\u306f\u826f\u3044\u9854\u3092\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u9a5a\u304d\u306e\u8868\u60c5\u304b\u3089\u3059\u308b\u3068\u3001\u79c1\u306e\u9854\u306f\u5c11\u3057\u51b4\u3048\u306a\u3044\u69d8\u5b50\u3060\u308d\u3046\u3002"}
{"translation": "\u6050\u3089\u304f\u79c1\u306e\u982c\u306b\u306f\u30b8\u30e3\u30b1\u30c3\u30c8\u8896\u304b\u3089\u8d64\u8272\u8de1\u304c\u3064\u3044\u3066\u3057\u307e\u3063\u3066\u3044\u308b\u3093\u3060\u308d\u3046\u3002"}
{"translation": "\u3042\u306a\u305f\u304c\u79c1\u306e\u90aa\u9b54\u3092\u3057\u3066\u3044\u307e\u3059\u304b\uff1f"}
{"translation": "\u304a\u5b22\u3055\u3093\u3001\u3042\u306a\u305f\u304c\u901a\u308a\u904e\u304e\u3066\u3082\u751f\u304d\u5ef6\u3073\u307e\u3059\u3088\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u8ab0\u3067\u3059\u304b\uff1f"}
{"translation": "\u3048\u3048\u3068\u3001\u79c1\u306f\u5b9f\u7fd2\u751f\u3067\u3059\uff01"}
{"translation": "\u3069\u306e\u90e8\u9580\u3067\u3057\u3087\u3046\u304b\uff1f"}
{"translation": "\u305d\u308c\u306f\u6559\u3048\u3066\u3082\u3089\u3063\u3066\u3044\u307e\u305b\u3093\u3002"}
{"translation": "\u4eca\u65e5\u3067\u306f\u3001\u6211\u3005\u5b9f\u7fd2\u751f\u306f\u4ed5\u4e8b\u91cf\u304c\u591a\u3044\u304b\u3089\u6c4e\u7528\u6027\u304c\u91cd\u8981\u306b\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u7d66\u6599\u3092\u4e0a\u3052\u305f\u3044\u3067\u3059\u304b\uff1f"}
{"translation": "\u3044\u3048\u3001\u79c1\u306f\u7d66\u6599\u3092\u4e00\u5207\u8cb0\u3063\u3066\u3044\u307e\u305b\u3093\u3002"}
{"translation": "\u5f7c\u5973\u306e\u9aea\u306f\u304b\u306a\u308a\u4e71\u308c\u3066\u3044\u308b\u3088\u3046\u306b\u898b\u3048\u307e\u3059\u306d\u3001\u30b8\u30fc\u30f3\u30ba\u3082\u7a74\u304c\u958b\u3044\u3066\u3044\u3066\u3001\u4ed6\u306e\u90e8\u5206\u306f\u8272\u3068\u308a\u3069\u308a\u3002"}
{"translation": "\u5f7c\u5973\u306f\u5c0f\u67c4\u3067\u3001\u9ed2\u76ee\u304c\u3061\u306a\u76ee\u3092\u3057\u3066\u304a\u308a\u3001\u3068\u3066\u3082\u89aa\u3057\u307f\u3084\u3059\u305d\u3046\u3067\u3059\u304c\u3001\u7f8e\u3057\u3044\u3068\u8a00\u3048\u308b\u304b\u3069\u3046\u304b\u306f\u6b63\u76f4\u308f\u304b\u3089\u306a\u3044\u3002"}
{"translation": "\u3053\u3046\u3044\u3046\u5973\u6027\u3092\u8a55\u4fa1\u3059\u308b\u80fd\u529b\u3082\u79c1\u306b\u306f\u3082\u3046\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u5f7c\u5973\u306f\u8ce2\u305d\u3046\u3060\u3002"}
{"translation": "\u9ad8\u7b49\u5e2b\u7bc4\u5b66\u6821\u51fa\u8eab\uff1f\u66f8\u7c4d\u7523\u696d\u754c\u3067\u5e74\u306b\u4f55\u5343\u4eba\u3082\u306e\u30ac\u30b9\u30c8\u30f3\u30fb\u30ae\u30e3\u30ea\u30de\u30fc\u30eb\u3092\u751f\u307f\u51fa\u3057\u3001\u5f8c\u304b\u3089\u7834\u58ca\u3057\u3066\u3044\u304f\u305d\u306e\u4ed5\u7d44\u307f\uff1f"}
{"translation": "\u305d\u308c\u3067\u306f\u3001\u3042\u306a\u305f\u306f\u3053\u3053\u3067\u4f55\u3092\u3057\u3066\u3044\u308b\u306e\u3067\u3059\u304b\uff1f"}
{"translation": "\u79c1\u3082\u672c\u304c\u597d\u304d\u3067\u3059\u3088\uff01"}
{"translation": "\u305d\u3046\u3060\u3001\u3053\u3061\u3089\u304c\u7a7a\u3044\u3066\u307e\u3057\u305f\u304b\u3089\u306d\u3002"}
{"translation": "\u4f01\u696d\u7814\u4fee\u304c\u5fc5\u9808\u306a\u3093\u3067\u3059\u3088\u3002"}
{"translation": "\u306a\u308b\u307b\u3069\u3001\u3067\u306f\u79c1\u306e\u30aa\u30d5\u30a3\u30b9\u3067\u4f55\u3092\u3057\u3066\u3044\u308b\u3093\u3067\u3059\u304b\uff1f"}
{"translation": "\u3042\u307e\u308a\u53e3\u51fa\u3057\u306a\u3069\u3057\u307e\u305b\u3093\u3051\u308c\u3069\u3082\u3002"}
{"translation": "\u30df\u30e5\u30cb\u30a8\u3055\u3093\u3001\u5927\u793e\u9577\u304c\u3002\u3002\u3002"}
{"translation": "\u3068\u8a00\u308f\u308c\u3066\u3002"}
{"translation": "\u5927\u793e\u9577\uff1f\u30df\u30e5\u30cb\u30a8\u3055\u3093\uff1f\u5f7c\u3092\u77e5\u3063\u3066\u3044\u307e\u3059\u304b\uff1f"}
{"translation": "\u305f\u3060\u3061\u306b\u3059\u3054\u304f\u77e5\u3063\u3066\u3044\u307e\u3059\u3088\u3002"}
{"translation": "\u3044\u3048\u3001\u305d\u308c\u306f\u6587\u5316\u4e8b\u696d\u306e\u7d4c\u55b6\u3067\u3059\u3002"}
{"translation": "\u672c\u5f53\u306b\uff1f\u305d\u3057\u3066\u3042\u306a\u305f\u306f\u51fa\u7248\u3092\u7ba1\u7406\u3057\u305f\u3044\u3068\u601d\u3063\u3066\u3044\u307e\u3059\u304b\uff1f"}
{"translation": "\u305d\u308c\u306a\u3089\u3070\u3001\u5e78\u904b\u3092\u7948\u308a\u307e\u3059\u3002"}
{"translation": "\u79c1\u306f\u30b3\u30f3\u30b5\u30fc\u30c8\u3092\u958b\u50ac\u3059\u308b\u65b9\u304c\u826f\u3044\u3068\u601d\u3044\u307e\u3059\u3002"}
{"translation": "\u5ea7\u3063\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u79c1\u306f\u884c\u304b\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3001\u4eca\u65e5\u306f\u91d1\u66dc\u65e5\u3067\u3059\u304b\u3089\u3002"}
{"translation": "\u3082\u3046\u9045\u3044\u6642\u9593\u3067\u3059\u306d\u3002"}
{"translation": "5\u5206\u3060\u3051\u2026\u3067\u3057\u3087\u3046\u304b\uff1f"}
{"translation": "\u3042\u306a\u305f\u304c\u30b3\u30f3\u30b5\u30fc\u30c8\u3092\u958b\u50ac\u3057\u305f\u3044\u306e\u3067\u3059\u306d\uff1f"}
{"translation": "\u3048\u3048\u3001\u305d\u308c\u3067\u306f\u4f55\u3088\u308a\u3082\u826f\u3055\u305d\u3046\u3067\u3059\u306d\uff0c\u97f3\u697d\u304c\u597d\u304d\u3060\u304b\u3089\u3002"}
{"translation": "\u9577\u3044\u9593\u3001\u811a\u3092\u7d44\u3093\u3067\u5c11\u3057\u306e\u30ea\u30e9\u30af\u30bc\u30fc\u30b7\u30e7\u30f3\u3084\u9ad8\u63da\u611f\u3001\u305d\u3057\u3066\u982d\u3078\u306e\u8840\u6d41\u3092\u6c42\u3081\u3066\u673a\u306b\u8db3\u3092\u4e57\u305b\u3066\u304d\u307e\u3057\u305f\u304c\u3001\u6700\u8fd1\u3067\u306f\u7279\u306b\u5915\u65b9\u3084\u91d1\u66dc\u65e5\u306e\u591c\u306a\u3069\u983b\u7e41\u306b\u673a\u306b\u9854\u3092\u57cb\u3081\u308b\u3053\u3068\u304c\u5897\u3048\u307e\u3057\u305f\u3002"}
{"translation": "\u6587\u7ae0\u304c\u30aa\u30fc\u30d7\u30f3\u3055\u308c\u305f\u307e\u307e\u306e\u624b\u7a3f\u306e\u4e0a\u306b\u8155\u3092\u4ea4\u5dee\u3055\u305b\u3001\u305d\u3053\u3078\u9854\u3092\u4f0f\u305b\u307e\u3059\u3002"}
{"translation": "\u524d\u8155\u306b\u306f\u984d\u3001\u65b0\u9bae\u306a\u30c6\u30ad\u30b9\u30c8\u4e0a\u306b\u306f\u982c\u304c\u89e6\u308c\u307e\u3059\u3002"}
{"translation": "\u30c7\u30b9\u30af\u304b\u3089\u5fc3\u81d3\u306e\u9f13\u52d5\u304c\u5897\u5e45\u3057\u307e\u3059\u3002"}
{"translation": "\u30f4\u30a3\u30f3\u30c6\u30fc\u30b8\u306a\u30a2\u30fc\u30eb\u30c7\u30b3\u5bb6\u5177\u306f\u60c5\u611f\u3084\u75b2\u52b4\u611f\u3092\u826f\u304f\u9042\u884c\u3057\u307e\u3059\u3002"}
{"translation": "\u30eb\u30fc\u30eb\u30de\u30f3\uff1f"}
{"translation": "\u30eb\u30eb\u30fc\uff1f\u8272\u3005\u3068\u898b\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u9759\u304b\u306a\u5bb6\u3067\u79c1\u306e\u5fc3\u97f3\u3060\u3051\u805e\u3044\u3066\u3044\u307e\u3059\u2015\u2015\u91d1\u66dc\u65e5\u306e\u3053\u306e\u53e4\u3044\u5fc3\u305d\u308c\u306f\u6c17\u54c1\u3068\u5b64\u72ec\u3055\u3059\u3089\u611f\u3058\u307e\u3059\u3002"}
{"translation": "\u5468\u308a\u306f\u7686\u5e30\u308a\u7a7a\u9593\u3060\u3051\u4eba\u77e5\u308c\u305a\u5171\u6709\u3057\u307e\u3059\u3002"}
{"translation": "\u81ea\u5206\u3060\u3051\u6f02\u3063\u3066\u3044\u308b\u4e00\u751f\u61f8\u547d\u6d17\u308f\u308c\u305f\u8239\u307f\u305f\u3044\u3067\u3059\u304b\u3081\u3089\u3057\u304f\u9031\u672b\u507d\u88c5\u3059\u308b\u624b\u7a3f\u7fa4\u5854\u7acb\u3061\u4e0a\u3052\u308b\u529b\u3070\u3063\u304b\u308a\u6b20\u4e8e\u3057\u3066\u3044\u307e\u3059\u3088\u3046\u3067\u6bce\u56de\u91d1\u66dc\u65e5\u901a\u308a\u8cd1\u308f\u3046\u529b\u4f59\u529b\u3082\u306a\u304f\u5bc2\u3057\u3044\u611f\u3058\u304c\u9019\u3044\u5bc4\u308b\u3002"}
{"translation": "\u305d\u308c\u306a\u3089\u3001\u3042\u306a\u305f\u3082\u77e5\u3063\u3066\u3044\u308b\u306f\u305a\u3067\u3059\u3002"}
{"translation": "\u5f7c\u304c\u3053\u308c\u3092\u304a\u6301\u3061\u3059\u308b\u3088\u3046\u306b\u8a00\u3063\u305f\u306e\u3067\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u3001\u3053\u308c\u306f\u4e00\u4f53\u4f55\u3067\u3057\u3087\u3046\u304b\uff1f"}
{"translation": "\u305d\u308c\u306f\u96fb\u5b50\u66f8\u7c4d\u30ea\u30fc\u30c0\u30fc\u3001eBook\u3001iPad\u3001\u79c1\u306b\u306f\u308f\u304b\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u5f7c\u306f\u9031\u672b\u306b\u5411\u3051\u3066\u3042\u306a\u305f\u306e\u5168\u3066\u306e\u539f\u7a3f\u3092\u3053\u308c\u306b\u5165\u308c\u305f\u3068\u8a00\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u3067\u6301\u3061\u904b\u3073\u304c\u697d\u306b\u306a\u308b\u3068\u8a00\u3044\u307e\u3059\u3002"}
{"translation": "\u8aac\u660e\u3057\u307e\u3057\u3087\u3046\u304b\uff1f"}
{"translation": "\u898b\u3066\u304f\u3060\u3055\u3044\u3001\u305d\u308c\u306f\u753b\u9762\u3067\u3059\u3079\u3066\u306e\u539f\u7a3f\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u3089\u306f\u64ec\u4f3c\u7684\u306a\u672c\u68da\u306b\u7f6e\u304b\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u30bf\u30c3\u30c1\u3059\u308b\u3060\u3051\u3067\u958b\u304d\u307e\u3059\u3002"}
{"translation": "\u305d\u3053\u306b\u5927\u91cf\u306e\u539f\u7a3f\u304c\u3042\u308a\u307e\u3059\u3088\uff01"}
{"translation": "\u4e8c\u65e5\u9593\u3067\u5168\u90e8\u8aad\u3080\u3053\u3068\u306a\u3093\u3066\u3067\u304d\u307e\u305b\u3093\u3088\uff01"}
{"translation": "\u898b\u3066\u304f\u3060\u3055\u3044\u3001\u30c6\u30ad\u30b9\u30c8\u304c\u958b\u3044\u3066\u3044\u307e\u3059\u3088\uff01"}
