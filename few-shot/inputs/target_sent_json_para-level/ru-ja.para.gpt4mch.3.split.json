{"translation": "\u300c\u5f7c\u306f\u5618\u3092\u3064\u3044\u3066\u3044\u308b\u300d\u3068\u79c1\u306f\u601d\u3063\u305f\u3002"}
{"translation": "\u30ad\u30fc\u30db\u30eb\u30c0\u30fc\u3084\u5c0f\u6307\u306b\u306f\u3081\u305f\u30ea\u30f3\u30b0\u304c\u3001\u4e00\u5207\u308c\u306e\u30d1\u30f3\u306e\u305f\u3081\u306e\u624b\u7d19\u3068\u307e\u3063\u305f\u304f\u99b4\u67d3\u3093\u3067\u306a\u304b\u3063\u305f\u3057\u3001\u30ab\u30df\u30b7\u30a7\u30d5\u306e\u9854\u306b\u3082\u307b\u3093\u306e\u50c5\u304b\u306b\u3001\u3057\u304b\u3057\u7d4c\u9a13\u8c4a\u5bcc\u306a\u76ee\u306b\u6349\u3048\u3089\u308c\u308b\u8584\u3044\u66c7\u308a\u304c\u898b\u3048\u3066\u3001\u305d\u308c\u306f\u6ec5\u591a\u306b\u4eba\u304c\u5618\u3092\u3064\u304f\u3068\u304d\u3060\u3051\u898b\u3089\u308c\u308b\u3082\u306e\u3060\u3063\u305f\u3002"}
{"translation": "\u300c\u3042\u306a\u305f\u306e\u30b9\u30c8\u30fc\u30ea\u30fc\u3063\u3066\u4f55\uff1f\u300d"}
{"translation": "\u300c\u30b9\u30c8\u30fc\u30ea\u30fc\uff1f\u305d\u3061\u3089\u65b9\u9762\u3067\u3059\u306d\u2026"}
{"translation": "\u304a\u3063\u3057\u3083\u308b\u901a\u308a\u65b0\u3057\u3055\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u611b\u60c5\u3001\u6bba\u4eba\u4e8b\u4ef6\u304c\u30c6\u30fc\u30de\u3067\u3059\u3002"}
{"translation": "\u3067\u3082\u8aad\u3080\u3068\u308f\u304b\u308a\u307e\u3059\u3088\u3002"}
{"translation": "\u201d\u6cd5\u533b\u5b66\u8005\u304b\u3089\u898b\u7684\u8a18\u9332\u201d\u307f\u305f\u3044\u306a\u3082\u3093\u3067\u3059\u300d"}
{"translation": "\u30ab\u30df\u30b7\u30a7\u30d5\u306f\u79c1\u306b\u512a\u3057\u3044\u76ee\u3092\u5411\u3051\u3066\u9759\u304b\u306b\u7b11\u3063\u305f\u3002"}
{"translation": "\u300c\u9000\u5c48\u306a\u4ed5\u4e8b\u3060\u3002"}
{"translation": "\u50cd\u304d\u7d9a\u3051\u3001\u3064\u3044\u306b\u624b\u3092\u632f\u3063\u3066\u8f9e\u3081\u308b\u3002"}
{"translation": "\u4eca\u3067\u306f\u6642\u9593\u304c\u4f59\u3063\u3066\u3057\u307e\u3063\u305f\u3057\u3001\u98df\u3079\u308b\u3053\u3068\u3082\u307b\u3068\u3093\u3069\u306a\u3044\u3002"}
{"translation": "\u3060\u304b\u3089\u3042\u306a\u305f\u304c\u3001\u79c1\u306e\u8a71\u306e\u4fa1\u5024\u3092\u7121\u8996\u3057\u3066\u305d\u308c\u3092\u63b2\u8f09\u3057\u3066\u304f\u308c\u308b\u306a\u3089\u3001\u5358\u306a\u308b\u597d\u610f\u4ee5\u4e0a\u306e\u3053\u3068\u3092\u3057\u3066\u304f\u308c\u308b\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002"}
{"translation": "\u52a9\u3051\u3066\u304f\u308c\u308b\u3093\u3067\u3059\u3002"}
{"translation": "\u65b0\u805e\u306f\u6148\u5584\u4e8b\u696d\u3084\u65bd\u8a2d\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3088\u306d\uff1f"}
{"translation": "\u305d\u308c\u306f\u308f\u304b\u3063\u3066\u3044\u307e\u3059\u304c\u3001\u3069\u3046\u304b\u5fc3\u826f\u304f\u2026\u300d"}
{"translation": "\u300c\u3068\u3066\u3082\u3046\u308c\u3057\u3044\u3001\u4f55\u304b\u304a\u624b\u4f1d\u3044\u3067\u304d\u308b\u3053\u3068\u304c\u3042\u308c\u3070\u6559\u3048\u3066\u304f\u3060\u3055\u3044\u3002\u300d"}
{"translation": "\u983c\u307f\u4e8b\u304c\u3042\u3063\u3066\u3084\u3063\u3066\u6765\u305f\u7537\u306f\u3001\u9858\u3046\u3088\u3046\u306a\u8996\u7dda\u3092\u5e8a\u306b\u5411\u3051\u306a\u304c\u3089\u8a00\u8449\u3092\u7d9a\u3051\u305f\u3002"}
{"translation": "\u300c\u79c1\u304c\u66f8\u3044\u305f\u5c0f\u3055\u306a\u8a71\u3092\u8cb4\u65b9\u306e\u65b0\u805e\u306b\u63b2\u8f09\u3057\u3066\u3044\u305f\u3060\u304d\u305f\u304f\u3066\u3001\u6301\u3063\u3066\u53c2\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u6b63\u76f4\u306b\u7533\u3057\u307e\u3059\u3068\u3001\u7de8\u96c6\u9577\u3055\u3093\u3001\u81ea\u5df1\u306e\u540d\u58f0\u3084\u8912\u3081\u79f0\u3048\u3089\u308c\u308b\u559c\u3073\u306e\u305f\u3081\u306b\u308f\u3056\u308f\u3056\u3053\u3093\u306a\u5c0f\u8a71\u3092\u66f8\u3044\u305f\u308f\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u305d\u308c\u3089\u306e\u826f\u304d\u4e8b\u7269\u306f\u65e2\u306b\u79c1\u306e\u5e74\u9f62\u3067\u306f\u9069\u3055\u306a\u3044\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u5546\u696d\u7684\u52d5\u6a5f\u3060\u3051\u3067\u57f7\u7b46\u6d3b\u52d5\u3092\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u7a3c\u304e\u305f\u304f\u306a\u3063\u305f\u3060\u3051\u3067\u3059\u3002"}
{"translation": "\u4eca\u73fe\u5728\u3001\u3057\u3063\u304b\u308a\u3057\u305f\u4ed5\u4e8b\u3082\u5168\u304f\u3042\u308a\u307e\u305b\u3093\u3057\u306d\u3002"}
{"translation": "\u300c\u306a\u3093\u3066\u8a71\u3057\u597d\u304d\u306a\u3093\u3060\u308d\u3046\u300d\u3068\u601d\u3044\u3064\u3064\u3001\u79c1\u306f\u30da\u30f3\u306b\u624b\u3092\u51fa\u3057\u3001\u305d\u308c\u304c\u81ea\u5206\u306b\u306f\u6642\u9593\u304c\u306a\u3044\u3068\u3044\u3046\u5408\u56f3\u3092\u9001\u3063\u305f\u3002"}
{"translation": "\uff08\u305d\u306e\u6642\u671f\u3001\u8a2a\u554f\u5ba2\u306e\u3053\u3068\u306f\u3059\u3054\u304f\u90aa\u9b54\u3060\u3063\u305f\uff09\u300c\u304a\u5f85\u305f\u305b\u3057\u307e\u3059\u306d\u3002"}
{"translation": "\u3067\u3082\u4e00\u77ac\u3060\u3051\u3067\u3059\u3088\u300d\u3001\u79c1\u306e\u76ee\u306e\u524d\u3067\u3078\u308a\u304f\u3060\u3063\u3066\u8a00\u8449\u3092\u7d21\u304e\u7d9a\u3051\u308b\u4eba\u7269\u304c\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u307e\u305a\u59cb\u3081\u306b\u81ea\u5df1\u7d39\u4ecb\u304b\u3089\u3055\u305b\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u6cd5\u5b66\u4fee\u58eb\u30a4\u30f4\u30a1\u30f3\u30fb\u30da\u30c8\u30ed\u30f4\u30a3\u30c3\u30c1\u30fb\u30ab\u30df\u30b7\u30a7\u30d5\u3001\u524d\u4efb\u8005\u88c1\u5224\u5b98\u3067\u3054\u3056\u3044\u307e\u3059\u3002"}
{"translation": "\u66f8\u304d\u7269\u4e0a\u624b\u306e\u4eba\u3005\u3082\u3044\u3089\u3057\u3066\u307e\u3059\u304c\u3001\u305d\u308c\u3067\u3082\u3084\u306f\u308a\u7686\u3055\u3093\u304b\u3089\u898b\u308c\u3070\u304d\u3061\u3093\u3068\u3057\u305f\u4f5c\u5bb6\u3055\u3093\u72d9\u3044\u3067\u3059\u3002"}
{"translation": "\u3042\u306a\u305f\u65b9\u306e\u524d\u3067\u306f\u4e0b\u4f4d\u8005\u3067\u3082\u3042\u308a\u307e\u3059\u304c\u3001\u300c\u9045\u3059\u304e\u308b\u300d\u3088\u308a\u3082\u300c\u4f55\u3082\u3057\u306a\u3044\u300d\u3053\u3068\u3055\u3048\u512a\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\u304c\u79c1\u306e\u30aa\u30d5\u30a3\u30b9\u306b\u5165\u3063\u3066\u304d\u305f\u3068\u304d\u3001\u5f7c\u306f\u3059\u3053\u3057\u3060\u3051\u56f0\u60d1\u3057\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u304a\u305d\u3089\u304f\u3001\u79c1\u306e\u3057\u304b\u3081\u3063\u9762\u3068\u4e0d\u6e80\u305d\u3046\u306a\u8868\u60c5\u304c\u3001\u5f7c\u306e\u7e4a\u7d30\u3067\u654f\u611f\u306a\u6027\u8cea\u3092\u30b7\u30e7\u30c3\u30af\u3055\u305b\u305f\u306e\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u300c\u795e\u69d8\u306b\u8a93\u3063\u3066\u3054\u3081\u3093\u306a\u3055\u3044\uff01\u300d"}
{"translation": "\u5f7c\u306f\u67d4\u3089\u304b\u3044\u9b45\u529b\u7684\u306a\u30d0\u30ea\u30c8\u30f3\u3067\u8a71\u3057\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u79c1\u306f\u3042\u306a\u305f\u304c\u5fd9\u3057\u3044\u4e2d\u3092\u7121\u7406\u77e2\u7406\u5272\u308a\u8fbc\u3093\u3067\u304d\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u7406\u7531\u304c\u3042\u308b\u3093\u3067\u3059\u3088\u3001\u7de8\u96c6\u8005\u3055\u3093\uff1a\u79c1\u306f\u660e\u65e5\u3001\u975e\u5e38\u306b\u91cd\u8981\u306a\u7528\u4e8b\u3067\u30aa\u30c7\u30c3\u30b5\u3078\u884c\u304b\u306d\u3070\u306a\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u3053\u306e\u65c5\u3092\u571f\u66dc\u65e5\u307e\u3067\u5ef6\u3070\u3059\u3053\u3068\u304c\u53ef\u80fd\u3060\u3063\u305f\u3089\u3001\u4fe1\u3058\u3066\u304f\u3060\u3055\u3044\u3001\u79c1\u306f\u3042\u306a\u305f\u306b\u7279\u5225\u6271\u3044\u3092\u304a\u9858\u3044\u3059\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "\u79c1\u306f\u898f\u5247\u3092\u5c0a\u91cd\u3057\u307e\u3059\u3002"}
{"translation": "\u4f55\u6545\u306a\u3089\u79e9\u5e8f\u3092\u611b\u3057\u3066\u3044\u307e\u3059\u304b\u3089\u300d"}
{"translation": "\u6817\u8272\u306e\u9aea\u3068\u3072\u3052\u306f\u3001\u7d79\u306e\u3088\u3046\u306b\u6fc3\u304f\u3066\u67d4\u3089\u304b\u3044\u3002"}
{"translation": "\u67d4\u3089\u304b\u3044\u9aea\u306f\u3001\u512a\u3057\u3044\u3001\u7e4a\u7d30\u3067\u300c\u30b7\u30eb\u30af\u306e\u3088\u3046\u306a\u300d\u5fc3\u3092\u8c61\u5fb4\u3057\u3066\u3044\u308b\u3068\u8a00\u308f\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u72af\u7f6a\u8005\u3084\u610f\u5730\u60aa\u3067\u9811\u56fa\u306a\u6027\u683c\u306e\u6301\u3061\u4e3b\u306f\u3001\u591a\u304f\u306e\u5834\u5408\u3001\u786c\u3044\u9aea\u3092\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u304c\u771f\u5b9f\u304b\u3069\u3046\u304b\u306f\u8aad\u8005\u306b\u518d\u5ea6\u898b\u3066\u3082\u3089\u3046\u3053\u3068\u306b\u306a\u308b\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u9854\u3064\u304d\u3084\u3072\u3052\u3060\u3051\u3067\u306f\u306a\u304f\u3001\u5f7c\u306e\u5927\u304d\u304f\u91cd\u3044\u8eab\u4f53\u306e\u52d5\u304d\u307e\u3067\u304c\u3001\u30ed\u30bc\u30c3\u30c8\u4ed8\u304d\u7d33\u58eb\u306b\u975e\u5e38\u306b\u512a\u3057\u304f\u3066\u7e4a\u7d30\u3067\u3059\u3002"}
{"translation": "\u305d\u306e\u52d5\u4f5c\u304b\u3089\u306f\u6559\u80b2\u3055\u308c\u305f\u8a8d\u8b58\u3068\u8efd\u3055\uff0c\u512a\u96c5\u3055\u3055\u3048\u900f\u3051\u3066\u898b\u3048\u307e\u3059\uff0c\u305d\u3057\u3066\u8a31\u3057\u3066\u304f\u3060\u3055\u3044\u8868\u73fe\u3059\u308b\u305f\u3081\u306b\u5c11\u5973\u7684\u4e00\u90e8\u3067\u3059\u3002"}
{"translation": "\u79c1\u306e\u82f1\u96c4\u304c\u8e44\u9244\u3092\u66f2\u3052\u305f\u308a\u30b5\u30fc\u30c7\u30a3\u30f3\u7f36\u3092\u63e1\u3063\u305f\u624b\u3067\u62bc\u3057\u3064\u3076\u3059\u52b4\u529b\u306f\u5fc5\u8981\u3042\u308a\u307e\u305b\u3093\u304c,\u7269\u7406\u7684\u306a\u529b\u5f37\u3055\u3092\u793a\u3059\u5f7c\u4e00\u3064\u52d5\u4f5c\u53cd\u6620\u3057\u307e\u3059\u3002"}
{"translation": "\u30c9\u30a2\u30ce\u30d6\u3084\u5e3d\u5b50\u3092\u6301\u3064\u6642,\u5f7c\u306f\u866b\u3092\u63a2\u3059\u3088\u3046\u3067\u3059: \u511a\u82e5\u4e01\u5be7\uff0c\u305d\u3057\u3066\u6307\u5148\u3060\u3051\u3067\u3082\u308d\u3082\u308d\u30c1\u30e3\u30ec\u30f3\u30b8\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u5f7c\u306e\u30b8\u30a7\u30a4\u306f\u7121\u97f3,\u63e1\u624b\u306f\u67d4\u3089\u304b\u3044\u3067\u3059\u3002"}
{"translation": "\u5f7c\u3092\u898b\u3066\u5fd8\u308c\u307e\u3059\uff0c\u5f7c\u306f\u30b4\u30ea\u30a2\u30c6\u306e\u3088\u3046\u306b\u5f37\u304f\uff0c\u5f7c\u4e00\u3064\u8155\u3067\u6301\u3061\u4e0a\u3052\u308b\u3053\u3068\u304c\u3067\u304d\u308b\u3082\u306e\u3001\u30a8\u30c7\u30a3\u30c8\u30ea\u30a2\u30eb\u90e8\u9577\u30a2\u30f3\u30c9\u30ec\u30a45\u4eba\u304c\u306a\u3093\u308c\u3069\u3082\u3063\u3068\u7d30\u305d\u3067\u3059\u3002"}
{"translation": "\u8efd\u3044\u52d5\u304d\u3092\u89b3\u5bdf\u3059\u308b\u6642\uff0c\u4fe1\u3058\u3089\u308c\u306a\u3044\u3053\u3068\u306b \u305d\u308c\u304c \u5f7c\u304c\u5f37\u304f \u6fc3\u539a\u3060\u3002"}
{"translation": "\u30b9\u30da\u30f3\u30b5\u30fc\u306f\u30b0\u30eb\u30fc\u30d7\u6a19\u672c\u3068\u547c\u3076\u3053\u3068\u304a\u52dd\u624b\u3055\u305b\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u9854\u304b\u3089\u306f\u7d14\u7c8b\u3055\u3001\u5927\u3089\u304b\u3055\u3001\u7d20\u6734\u3055\u304c\u5982\u5b9f\u306b\u53cd\u6620\u3055\u308c\u3066\u304a\u308a\u307e\u308b\u3067\u771f\u5b9f\u3092\u8a34\u3048\u304b\u3051\u3066\u3044\u305f\u3002"}
{"translation": "\u3082\u3057\u3082\u9854\u304c\u9b42\u306e\u93e1\u3067\u3042\u308b\u3068\u3044\u3046\u8a71\u304c\u5618\u3067\u306f\u306a\u3044\u3068\u3059\u308c\u3070\u3001\u521d\u3081\u3066\u5f7c\u3068\u4f1a\u3063\u305f\u6642\u306b\u306f\u3001\u81ea\u5206\u306e\u540d\u8a89\u3092\u8ced\u3051\u3066\u3067\u3082\u5f7c\u304c\u3046\u305d\u3092\u3064\u304f\u3053\u3068\u306f\u306a\u3044\u3060\u308d\u3046\u3068\u65ad\u8a00\u3067\u304d\u305f\u3002"}
{"translation": "\u79c1\u306f\u305d\u306e\u4e8b\u306b\u8ced\u3051\u3066\u3082\u826f\u304b\u3063\u305f\u3060\u308d\u3046\u3002"}
{"translation": "\u305d\u306e\u8ced\u3051\u304c\u52dd\u3064\u304b\u8ca0\u3051\u308b\u304b\u3001\u8aad\u8005\u306e\u7686\u69d8\u306f\u3053\u308c\u304b\u3089\u898b\u6975\u3081\u3089\u308c\u308b\u3053\u3068\u3060\u308d\u3046\u3002"}
{"translation": "\u5f7c\u306f\u3001\u3059\u3067\u306b\u8ff0\u3079\u305f\u3088\u3046\u306b\u3001\u80cc\u304c\u9ad8\u304f\u3001\u80a9\u304c\u5e83\u304f\u3001\u9811\u4e08\u306a\u4f53\u683c\u3092\u3057\u3066\u304a\u308a\u3001\u307e\u308b\u3067\u826f\u3044\u7a2e\u306e\u52b4\u50cd\u99ac\u306e\u3088\u3046\u3060\u3002"}
{"translation": "\u5f7c\u306e\u5168\u8eab\u304b\u3089\u306f\u5065\u5eb7\u3068\u529b\u304c\u6ea2\u308c\u3066\u3044\u308b\u3002"}
{"translation": "\u9854\u8272\u306f\u30d4\u30f3\u30af\u8272\u3067\u624b\u306f\u5927\u304d\u304f\u3001\u80f8\u677f\u306f\u5e83\u304f\u7b4b\u8089\u8cea\u3067\u3042\u308b\u3002"}
{"translation": "\u9aea\u3082\u6fc3\u304f\u901e\u3057\u304f\u898b\u3048\u305f\u304b\u3068\u601d\u3048\u3070\u7537\u5b50\u306e\u3088\u3046\u3067\u3082\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u5e74\u9f62\u306f40\u6b73\u307b\u3069\u3060\u308d\u3046\u3002"}
{"translation": "\u670d\u88c5\u306b\u512a\u308c\u305f\u30bb\u30f3\u30b9\u3092\u6301\u3063\u3066\u304a\u308a\u3001\u6700\u65b0\u6d41\u884c\u306e\u65b0\u54c1\u540c\u69d8\u306a\u30b9\u30fc\u30c4\u3092\u7740\u3053\u306a\u3057\u3066\u3044\u308b\u3002"}
{"translation": "\u80f8\u5143\u306b\u5927\u304d\u306a\u91d1\u306e\u30cd\u30c3\u30af\u30ec\u30b9\u3068\u30d0\u30f3\u30b0\u30eb\u3092\u98fe\u308a\u3064\u3051\u3066\u304a\u308a\u3001\u5c0f\u6307\u306b\u8f1d\u304b\u305b\u3066\u3044\u308b\u30d6\u30ea\u30ea\u30a2\u30f3\u30c8\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u30ea\u30f3\u30b0\u3067\u306f\u8f1d\u304d\u304c\u7729\u3057\u3059\u304e\u3066\u661f\u5c51\u3057\u304b\u898b\u3048\u307e\u305b\u3093\u3002"}
{"translation": "\u3057\u304b\u3057\u4f55\u3088\u308a\u3082\u91cd\u8981\u306a\u70b9, \u305d\u308c\u3063\u3066\u30ed\u30de\u30f3\u3084\u7269\u8a9e\u306b\u304a\u3051\u308b\u3061\u3087\u3063\u3068\u3057\u305f\u82f1\u96c4\u7684\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u4ee5\u4e0a\u3082\u5fc5\u8981\u4e0d\u53ef\u6b20\u306a\u3053\u3068\u3060\u308d\u3046\u305d\u308c\u3067\u3059\u3089; \u5f7c\u306f\u975e\u5e38\u306b\u7f8e\u3057\u3044\u9854\u3064\u304d\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u79c1\u3060\u3063\u305f\u3089\u5973\u6027\u3067\u3082\u82b8\u8853\u5bb6\u3067\u3082\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u3055\u3089\u3063\u3068\u7537\u6027\u7f8e\u8853\u54c1\u8868\u793a\u3084\u89e3\u8aac\u306f\u51fa\u6765\u307e\u305b\u3093\u304c\u3001\u30b3\u30ab\u30fc\u30c9\u6559\u5b98\u306e\u5916\u898b\u306f\u79c1\u306b\u5370\u8c61\u3092\u4e0e\u3048\u305f\u3002"}
{"translation": "\u5f7c\u306e\u5927\u304d\u306a\u7b4b\u8089\u8cea\u9854\u306f\u6c38\u9060\u306b\u79c1\u306e\u8a18\u61b6\u306b\u523b\u307e\u308c\u308b\u3060\u308d\u3046\u3002"}
{"translation": "\u305d\u306e\u9854\u3067\u306f\u3001\u5b9f\u969b\u7684\u306a\u30ae\u30ea\u30b7\u30e3\u4eba\u306e\u30d0\u30f3\u30d7\u4ed8\u304d\u9f3b\u3068\u7d30\u3044\u5507\u3001\u30cf\u30c3\u30ad\u30ea\u3068\u3057\u305f\u9752\u3044\u77b3\u3092\u898b\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u3089\u306b\u306f\u512a\u3057\u3055\u3084\u4f55\u304b\u4ed6\u3068\u8a00\u8449\u3067\u8868\u73fe\u3067\u304d\u306a\u3044\u3082\u306e\u304c\u5149\u308a\u8f1d\u3044\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u3063\u3066\u300c\u4f55\u304b\u300d\u3063\u3066\u611f\u3058\u53d6\u308c\u308b\u5c0f\u3055\u306a\u52d5\u7269\u305f\u3061\u76ee\u304b\u3089\u611f\u3058\u53d6\u308c\u308b\u3088\u3046\u306a\u6c17\u6301\u3061\u3067\u3059\u306d\u3002"}
{"translation": "\u7559\u307e\u3063\u305f\u308a\u3064\u3089\u305d\u3046\u306b\u3057\u3066\u307e\u3059\u3088\u306d\u3002"}
{"translation": "\u3042\u305d\u3053\u3067\u304a\u9858\u3044\u3059\u308b\u3088\u3046\u306a\u3001\u5b50\u4f9b\u307f\u305f\u304f\u6297\u8b70\u3059\u3089\u305b\u305a\u6211\u6162\u3057\u3066\u3057\u307e\u3046\u3088\u3046\u306a\u3082\u306e\u3092\u542b\u3080\u610f\u5473\u3060\u304b\u3089\u3067\u3059\u3002\u3002\u3002"}
{"translation": "\u624d\u6c17\u7165\u767a\u92ed\u53b3\u8005\u3067\u3082\u5f53\u7136\u3042\u308a\u5f97\u307e\u3059\u3053\u308c\u3082\u3088\u773c\u539f\u56e0\u6307\u6458\u5411\u3051\u4f1a\u54e1\u9650\u5b9a\u89e3\u9664\u3055\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u79c1\u306f\u305f\u3081\u606f\u3092\u3064\u304d\u3001\u30da\u30f3\u3092\u7f6e\u3044\u3066\u3001\u30b3\u30c3\u30ab\u30fc\u30c9\u5165\u308a\u306e\u7d33\u58eb\u3092\u5f85\u3064\u3053\u3068\u306b\u3057\u305f\u3002"}
{"translation": "\u65b0\u4eba\u306e\u4f5c\u5bb6\u3084\u7de8\u96c6\u90e8\u306e\u5185\u60c5\u306b\u660e\u308b\u304f\u306a\u3044\u4eba\u3005\u306f\u3001\u300c\u7de8\u96c6\u90e8\u300d\u3068\u3044\u3046\u8a00\u8449\u3067\u795e\u8056\u306a\u6050\u6016\u306b\u9665\u308a\u3001\u81ea\u5206\u3092\u304b\u306a\u308a\u9577\u3044\u9593\u5f85\u305f\u305b\u308b\u3002"}
{"translation": "\u305d\u308c\u3089\u306e\u4eba\u3005\u306f\u3001\u7de8\u96c6\u8005\u304c\u300c\u3069\u3046\u305e\u300d\u3068\u8a00\u3063\u305f\u5f8c\u3082\u3001\u3057\u3070\u3089\u304f\u54b3\u6255\u3044\u3057\u3001\u9f3b\u3092\u3059\u3059\u308b\u6642\u9593\u304c\u9577\u304f\u3001\u30c9\u30a2\u3092\u3086\u3063\u304f\u308a\u958b\u3051\u307e\u3059\u3057, \u66f4\u306b\u3086\u3063\u304f\u308a\u5165\u5ba4\u3057\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u306b\u3088\u3063\u3066\u304b\u306a\u308a\u306e\u6642\u9593\u304c\u596a\u308f\u308c\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057, \u30b3\u30c3\u30ab\u30fc\u30c9\u5165\u308a\u306e\u7d33\u58eb\u306f\u79c1\u9054\u3092\u5f85\u305f\u305b\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002"}
{"translation": "\u30a2\u30f3\u30c9\u30ec\u30a4\u3068\u9589\u3058\u308b\u30c9\u30a2\u8d8a\u3057\u306b\u898b\u3048\u308b\u9593\u3082\u7121\u304f\u9ad8\u5927\u3067\u80a9\u5e45\u5e83\u3081\u306a\u7537\u6027\u3002"}
{"translation": "\u5f7c\u7247\u65b9\u624b\u3067\u7d19\u5305\u307f\u30ea\u30b9\u30c8\u30d0\u30f3\u30c9\u4ed8\u304d\u30ad\u30e3\u30c3\u30d7\u4ed6\u65b9\u624b\u3067\u30e9\u30c3\u30af\u6301\u3061\u4e0a\u3052\u59ff\u307e\u3055\u305d\u306e\u30de\u30a4\u30eb\u30fc\u30e0\u4e2d\u8996\u30a4\u30f3\u3055\u308c\u3066\u307e\u3057\u305f"}
{"translation": "\u3053\u306e\u8a71\u984c\u4ed5\u7d44\u3093\u56f3\u5e8f\u76e4\u4e3b\u8981\u5f79\u54e1\u91cd\u8981\u7fa9\u52d9\u3042\u3063\u3066\u78ba\u5b9f\u5916\u8868\u8b58\u5225\u8f6f\u96c5\u9ed1"}
{"translation": "1880\u5e74\u306e4\u6708\u306e\u3042\u308b\u65e5\u306e\u771f\u663c\u3001\u8b66\u5099\u54e1\u306e\u30a2\u30f3\u30c9\u30ec\u30a4\u304c\u79c1\u306e\u4e8b\u52d9\u5ba4\u306b\u5165\u3063\u3066\u304d\u3066\u3001\u4f55\u8005\u304b\u304c\u7de8\u96c6\u90e8\u306b\u51fa\u5411\u3044\u3066\u304d\u3066\u3001\u305d\u306e\u7d33\u58eb\u304c\u7de8\u96c6\u9577\u3067\u3042\u308b\u308f\u305f\u3057\u3068\u4f1a\u898b\u3092\u5f37\u304f\u8981\u671b\u3057\u3066\u3044\u308b\u3068\u795e\u79d8\u7684\u306b\u5831\u544a\u3057\u305f\u3002"}
{"translation": "\u304a\u305d\u3089\u304f\u5f79\u4eba\u3067\u3059\u306d\u3001\u30a2\u30f3\u30c9\u30ec\u30a4\u306f\u3064\u3051\u52a0\u3048\u305f\u3001\u7389\u7ae0\u4ed8\u304d\u3060\u304b\u3089\u3002"}
{"translation": "\u5225\u306a\u6642\u9593\u5e2f\u306b\u3053\u3089\u308c\u308b\u3088\u3046\u983c\u3080\u3088\u3046\u8a00\u3063\u3066\u304f\u308c\u3001\u79c1\u304c\u8a13\u793a\u3059\u308b\u3002"}
{"translation": "\u300c\u4eca\u65e5\u306f\u5fd9\u3057\u3044\u3093\u3060\u3002"}
{"translation": "\u571f\u66dc\u65e5\u3057\u304b\u9762\u8ac7\u306f\u53d7\u3051\u4ed8\u3051\u3066\u3044\u306a\u3044\u3093\u3060\u3068\u4f1d\u3048\u3066\u304a\u304f\u308c\u300d"}
{"translation": "3\u65e5\u524d\u3082\u3053\u3089\u308c\u307e\u3057\u305f\u3057\u3001\u3042\u306a\u305f\u3054\u81ea\u8eab\u3082\u304a\u5c0b\u306d\u3055\u308c\u307e\u3057\u305f\u3088\u3002"}
{"translation": "\u3053\u308c\u304b\u3089\u5148\u91cd\u8981\u306a\u6253\u3061\u5408\u308f\u305b\u3067\u3059\u3063\u3066\u8a00\u3063\u3066\u3044\u307e\u3059\u3057\u304a\u9858\u3044\u3092\u805e\u304d\u5165\u308c\u305a\u6d99\u307e\u3067\u898b\u305b\u307e\u3059\u3002"}
{"translation": "\u571f\u66dc\u65e5\u3067\u306f\u90fd\u5408\u304c\u60aa\u3059\u304e\u307e\u3059\u3068\u3046\u305d\u3058\u3067\u3082\u9762\u63a5\u3055\u305b\u307e\u3057\u3087\u3046\u304b\uff1f"}
