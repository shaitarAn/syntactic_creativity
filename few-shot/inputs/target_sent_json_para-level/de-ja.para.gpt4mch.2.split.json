{"translation": "\u3059\u3079\u3066\u3092\u5fd8\u308c\u308b\u3053\u3068\u306f\u78ba\u304b\u306b\u3064\u3089\u3044\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u4f55\u3082\u5fd8\u308c\u306a\u3044\u3053\u3068\u304c\u3082\u3063\u3068\u3064\u3089\u3044\u3002"}
{"translation": "\u306a\u305c\u306a\u3089\u3001\u3042\u3089\u3086\u308b\u77e5\u8b58\u306f\u307e\u305a\u5fd8\u308c\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u751f\u307e\u308c\u3066\u304f\u308b\u306e\u3060\u304b\u3089\u3002"}
{"translation": "\u96fb\u529b\u3092\u6d88\u8cbb\u3059\u308b\u30c7\u30fc\u30bf\u30b9\u30c8\u30ec\u30fc\u30b8\u306e\u3088\u3046\u306b\u3001\u3059\u3079\u3066\u304c\u7121\u5dee\u5225\u306b\u4fdd\u5b58\u3055\u308c\u3066\u3044\u305f\u5834\u5408\u3001\u305d\u308c\u306f\u305d\u306e\u610f\u5473\u3092\u5931\u3044\u3001\u79e9\u5e8f\u306e\u306a\u3044\u4f7f\u3048\u306a\u3044\u60c5\u5831\u306e\u96c6\u7a4d\u4f53\u306b\u306a\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3002"}
{"translation": "\u3059\u3079\u3066\u3092\u4fdd\u7ba1\u3059\u308b\u8a18\u61b6\u306f\u3001\u57fa\u672c\u7684\u306b\u306f\u4f55\u3082\u4fdd\u7ba1\u3057\u306a\u3044\u3002"}
{"translation": "1980\u5e742\u67085\u65e5\u4ee5\u964d\u306e\u4e00\u65e5\u4e00\u65e5\u3092\u7121\u610f\u8b58\u6280\u8853\u306a\u3057\u3067\u601d\u3044\u51fa\u305b\u308b\u30ab\u30ea\u30d5\u30a9\u30eb\u30cb\u30a2\u4eba\u306e\u5973\u6027\u306f\u3001\u7d76\u3048\u305a\u5f7c\u5973\u306b\u62bc\u3057\u5bc4\u305b\u308b\u8a18\u61b6\u306e\u30a8\u30b3\u30fc\u30eb\u30fc\u30e0\u306b\u56da\u308f\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u306f\u3001\u672c\u56fd\u306e\u90fd\u5e02\u306e\u5404\u5e02\u6c11\u3092\u540d\u524d\u3067\u547c\u3073\u51fa\u3059\u3053\u3068\u304c\u3067\u304d\u305f\u30a2\u30c3\u30c6\u30a3\u30b1\u5730\u65b9\u3067\u6226\u3046\u30c6\u30df\u30b9\u30c8\u30af\u30ec\u30b9\u5c06\u8ecd\u305d\u306e\u3082\u306e\u3067\u3059\u304c\u3001\u5f7c\u81ea\u8eab\u304c\u30e0\u30cd\u30e2\u30cb\u30c3\u30af\u30fb\u30b7\u30e2\u30cb\u30c7\u30b9\u306b\u4f1d\u3048\u3055\u305b\u305f\u3088\u3046\u306b\u300c\u79c1\u306f\u899a\u3048\u3088\u3046\u3068\u3057\u306a\u3044\u3053\u3068\u307e\u3067\u3082\u899a\u3048\u3066\u304a\u308a\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u5fd8\u308c\u3088\u3046\u3068\u601d\u3046\u3053\u3068\u3092\u5fd8\u308c\u3089\u308c\u307e\u305b\u3093\u300d\u904e\u53bb\u304b\u3089\u5b66\u3073\u53d6\u308a\u305f\u304b\u3063\u305f\u3060\u3051\u3067\u3059\u3002"}
{"translation": "\u300c\u5fd8\u5374\u306e\u82b8\u8853\u300d\u3067\u306f\u4e0d\u53ef\u80fd\u306a\u4e8b\u3060\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u304c\u8868\u3057\u3066\u3044\u308b\u5168\u3066\u306e\u7b26\u53f7\u306f\u5b58\u5728\u305d\u306e\u3082\u306e\u3067\u3042\u308a\u3001\u305d\u308c\u3089\u304c\u6b20\u5982\u3057\u3066\u3044\u308b\u72b6\u614b\u3092\u6307\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u30ed\u30fc\u30de\u5e1d\u56fd\u5185\u3067damnatio memoriae\uff08\u8a18\u91b6\u304b\u3089\u8ffd\u653e\uff09\u5236\u5ea6\u4e0b\u306b\u7f6e\u304b\u308c\u305f\u6b86\u3069\u5168\u90e8\u5206\u3089\u304b\u306a\u4eba\u7269\u540d\u524d\u3067\u3082\u4e8b\u5178\u985e\u3067\u8a00\u53ca\u3055\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u81ea\u7531\u6b7b\u306f\u3001\u672a\u6765\u306e\u4e0d\u78ba\u5b9a\u6027\u3092\u30c8\u30ea\u30a6\u30e0\u3059\u308b\u6700\u3082\u904e\u6fc0\u306a\u624b\u6bb5\u3068\u3057\u3066\u898b\u3048\u308b\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u304c\u3001\u305d\u308c\u306f\u5b58\u5728\u306e\u77ed\u7e2e\u3068\u3044\u3046\u4ee3\u511f\u3092\u652f\u6255\u3046\u3053\u3068\u3067\u3059\u3002"}
{"translation": "\u304b\u3064\u3066\u30b5\u30e2\u30b9\u5cf6\u3067\u30a2\u30a6\u30b0\u30b9\u30c8\u30a5\u30b9\u306b\u8d08\u3089\u308c\u305f\u30a4\u30f3\u30c9\u4f7f\u7bc0\u56e3\u306e\u8d08\u308a\u7269\u306b\u306f\u3001\u864e\u3084\u8155\u304c\u306a\u3044\u82e5\u8005\u3060\u3051\u3067\u306a\u304f\uff08\u305d\u306e\u82e5\u8005\u306f\u8db3\u3092\u624b\u306e\u3088\u3046\u306b\u4f7f\u3063\u3066\u3044\u305f\uff09\u3001\u30d6\u30e9\u30d5\u30de\u30f3\u968e\u7d1a\u51fa\u8eab\u3067\u3001\u5f7c\u81ea\u8eab\u304c\u4eba\u751f\u3092\u7d42\u308f\u3089\u305b\u308b\u3053\u3068\u3092\u8003\u3048\u3066\u3044\u305f\u30b6\u30fc\u30eb\u30de\u30ed\u30b9\ub77c\u3044\u3046\u7537\u3082\u542b\u307e\u308c\u3066\u3044\u305f\u305d\u3046\u3067\u3059\u3002"}
{"translation": "\u3053\u308c\u306f\u81ea\u5206\u306e\u4eba\u751f\u304c\u671b\u3080\u3088\u3046\u306b\u9032\u884c\u3057\u305f\u304b\u3089\u3060\u3063\u305f\u3002"}
{"translation": "\u751f\u304d\u3066\u3044\u308b\u3068\u3044\u3046\u3053\u3068\u306f\u3001\u640d\u5931\u3092\u7d4c\u9a13\u3059\u308b\u3053\u3068\u3092\u610f\u5473\u3057\u307e\u3059\u3002"}
{"translation": "\u4f55\u304c\u8d77\u3053\u308b\u306e\u304b\u3001\u3068\u3044\u3046\u554f\u3044\u306f\u3001\u4eba\u985e\u81ea\u4f53\u3088\u308a\u3082\u65b0\u3057\u3044\u3082\u306e\u3067\u3042\u308d\u3046\u304b\u3001\u5c06\u6765\u304c\u6301\u3063\u3066\u3044\u308b\u57fa\u672c\u7684\u306a\u7279\u6027\u3067\u3042\u308a\u306a\u304c\u3089\u4e0d\u5b89\u611f\u3092\u5f15\u304d\u7acb\u305f\u305b\u308b\u3082\u306e\u3060\u304b\u3089\u3067\u3059\u3002"}
{"translation": "\u305d\u308c\u306f\u4e88\u898b\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u305a\u3001\u305d\u308c\u306b\u3088\u3063\u3066\u6b7b\u306e\u6642\u671f\u3084\u72b6\u6cc1\u3082\u898b\u3048\u306a\u304f\u3057\u307e\u3059\u3002"}
{"translation": "\u8ab0\u3067\u3082\u524d\u4ee5\u3066\u60b2\u3057\u307f\u3092\u611f\u3058\u308b\u307b\u3069\u7518\u7f8e\u3055\u3092\u6301\u3064\u9632\u5fa1\u9b54\u8853\u3084\u3001\u601d\u8003\u306b\u3088\u308a\u5148\u884c\u3057\u3066\u8d77\u3053\u308d\u3046\u3068\u3057\u3066\u3044\u308b\u4e8b\u67c4\u3092\u9632\u3054\u3046\u3068\u3059\u308b\u81f4\u547d\u7684\u306a\u885d\u52d5\u306b\u89aa\u3057\u3093\u3067\u3044\u307e\u3059\u3002"}
{"translation": "\u969c\u5bb3\u7269\u304c\u672a\u7136\u306b\u4e88\u60f3\u3055\u308c\u8bf4\u660e\u707e\u96be\u5e76\u8bd5\u56fe\u8ba9\u81ea\u5df1\u514d\u4e8e\u70e6\u607c\u7684\u7a81\u53d1\u60c5\u51b5\u4e0b\u9700\u8981\uff0c\u307e\u305f\u5922\u6751\u6226\u5f8c\u5e0c\u671b\u4f18\u58f0\u8bb8\u8bfa\u50cf\u662f\u795e\u8c15\u4e00\u822c\u5bf9\u6240\u4ee5\u5360\u627f\u62c5\u4e86\uff0c\u3053\u308c\u307e\u3067\u306f\u4e0d\u53ef\u907f\u514d\u7ed9\u5c06\u6765\u4fe1\u5bc4\u305b\u4f1a\u53d8\u6210\u4f46\u662f\u90a3\u79cd\u672a\u77e5\u3002"}
{"translation": "\u8a00\u308f\u3070\u6b7b\u540e\u7720\u308a\u3057\u306a\u3051\u308c\u3070\u306a\u3089\u594f\u8005\u5f00\u59cb\u8d8a\u6765\u8d8a\u613f\u8005\u4e0a\u94a9\u6740\u5668\u5230\u65f6\u5019\u4f1a\u88ab\u5374\u6b65\uff0c\u6050\u6016\u304b\u3089\u5f7c\u3089\u7c89\u788e\u66f4\u5f97\u6bd4\u8d77\u9003\u5317\u8d8a\u5357\u7684\u4eba\u53e3\u5938\u5927\u3002"}
{"translation": "\u4e0d\u5c11\u4eba\u304c\u6b7b\u306c\u3053\u3068\u3092\u6050\u308c\u3066\u81ea\u3089\u547d\u3092\u7d76\u3064\u3002"}
{"translation": "\u904e\u53bb\u3092\u628a\u63e1\u3057\u3001\u5fd8\u5374\u306b\u6297\u3046\u305f\u3081\u306e\u6226\u7565\u306f\u591a\u7a2e\u591a\u69d8\u3067\u3059\u3002"}
{"translation": "\u4f1d\u627f\u306b\u4fe1\u3058\u308b\u306a\u3089\u3070\u3001\u79c1\u305f\u3061\u306e\u6b74\u53f2\u8a18\u8ff0\u306e\u59cb\u307e\u308a\u306b\u306f\u30da\u30eb\u30b7\u30e3\u3068\u30ae\u30ea\u30b7\u30e3\u4eba\u3068\u306e\u9593\u3067\u7e70\u308a\u5e83\u3052\u3089\u308c\u305f\u4e00\u9023\u306e\u58ca\u6ec5\u7684\u306a\u6226\u4e89\u304c\u7acb\u3063\u3066\u304a\u308a\u3001\u4eca\u65e5\u3067\u306f\u307b\u3068\u3093\u3069\u5fd8\u308c\u53bb\u3089\u308c\u3066\u3057\u307e\u3063\u305f\u8a18\u61b6\u8853\u306e\u8d77\u6e90\u306b\u306f\u591a\u6570\u306e\u6b7b\u8005\u3092\u51fa\u3057\u305f\u4e0d\u5e78\u306a\u4e8b\u6545\u304c\u3042\u308a\u307e\u3059\uff1a\u305d\u308c\u306f\u30ad\u30ea\u30b9\u30c8\u524d5\u4e16\u7d00\u521d\u982d\u3001\u30c6\u30c3\u30b5\u30ea\u30a2\u3067\u4e00\u8e8d\u6709\u540d\u3068\u306a\u308a\u307e\u3057\u305f\u3002"}
{"translation": "\u5012\u58ca\u3059\u308b\u5bb6\u304c\u796d\u65e5\u30d1\u30fc\u30c6\u30a3\u30fc\u5168\u4f53\u3092\u98f2\u307f\u8fbc\u307f\u307e\u3057\u305f\u3002"}
{"translation": "\u552f\u4e00\u751f\u304d\u6b8b\u3063\u305f\u8a69\u4eba\u30b7\u30e2\u30cb\u30c7\u30b9\u30fb\u30aa\u30d6\u30fb\u30b1\u30aa\u30b9\u3060\u3051\u304c\u8a13\u7df4\u3055\u308c\u305f\u8a18\u61b6\u529b\u3067\u7c89\u3005\u306b\u306a\u3063\u305f\u5efa\u7269\u3092\u5fc3\u8c61\u3057\u76f4\u3059\u3053\u3068\u304c\u53ef\u80fd\u3067\u3042\u308a\u3001\u305d\u306e\u7d50\u679c\u30b2\u30b9\u30c8\u5e2d\u4e0a\u7a4d\u307f\u3055\u308c\u3066\u3044\u308b\u6b7b\u4f53\u9806\u756a\u547c\u3073\u51fa\u3059\u6210\u529f\u3057\u305f\u5f8c\u3067\u3057\u304b\u8ca0\u50b7\u8005\u9aa8\u592a\u635c\u7d22\u7279\u5b9a\u4f5c\u696d\u53ef\u80fd\u6027\u958b\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u3069\u3061\u3089\u304b\u307e\u305f\u306f\u547d\u3042\u308b\u3082\u3057\u304f\u306f\u6b7b\u4ea1\u6271\u308f\u308c\u4e2d\u73fe\u6ce8\u610f\u78ba\u8a8d\u3059\u308b\u30d1\u30e9\u30c9\u30c3\u30af\u30b9\u5b58\u5728\u8a31\u53ef\u3055\u308c\u4e0d\u81ea\u7136\u5f85\u3064\u3055\u308c\u305f\u591a\u6570\u91cd\u8981\u6027\u542b\u307e\u308c\u308b\u306e\u304c\u3001\u6b7b\u8005\u304c\u4e0d\u53ef\u9006\u7684\u306b\u5931\u308f\u308c\u305f\u3082\u306e\u3068\u3057\u3066\u6307\u540d\u3055\u308c\u308b\u3053\u3068\u3067\u3001\u305d\u306e\u55aa\u5931\u306b\u5bfe\u3059\u308b\u60b2\u3057\u307f\u306f\u540c\u6642\u306b\u4e8c\u500d\u305d\u3057\u3066\u534a\u5206\u3068\u306a\u308a\u3001\u4e00\u65b9\u3067\u3001\u884c\u65b9\u4e0d\u660e\u8005\u307e\u305f\u306f\u5931\u308f\u308c\u305f\u8005\u306e\u904b\u547d\u304c\u5fae\u5999\u306a\u5f62\u3067\u78ba\u5b9a\u3055\u308c\u3066\u3044\u306a\u3044\u5834\u5408\u3001\u4ea1\u304f\u306a\u3063\u305f\u4eba\u3005\u306f\u6050\u308d\u3057\u3044\u5e0c\u671b\u3068\u62d2\u5426\u3055\u308c\u305f\u60b2\u3057\u307f\u304b\u3089\u306a\u308b\u30a2\u30eb\u30d7\u30b9\u5c71\u5730\u5922\u4e2d\u72b6\u6cc1\u3092\u898b\u3064\u3051\u51fa\u3057\u60c5\u5831\u4f1d\u3048\u89e3\u653e\u611f\u7372\u5f97\u6301\u3061\u8fbc\u307e\u559c\u3073\u611f\u3058\u53d6\u3089\u305b\u4f5c\u8005\u5b58\u5728\u4fdd\u8a3c\u3057\u307e\u3059\u3002"}
{"translation": "\u6b7b\u3068\u3044\u3046\u533a\u5207\u308a\u306f\u3001\u907a\u7523\u3084\u601d\u3044\u51fa\u306e\u51fa\u767a\u70b9\u3067\u3042\u308a\u3001\u54c0\u60bc\u306e\u6b4c\u306f\u6587\u5316\u306e\u6e90\u6cc9\u3067\u3042\u308a\u3001\u305d\u308c\u306b\u3088\u3063\u3066\u4eca\u3067\u306f\u5927\u304d\u304f\u958b\u3044\u305f\u7a7a\u6d1e\u3092\u3001\u7a81\u7136\u306e\u9759\u5bc2\u3092\u3001\u6b4c\u3084\u7948\u308a\u3001\u7269\u8a9e\u304c\u57cb\u3081\u5c3d\u304f\u3057\u3001\u6b20\u5982\u3059\u308b\u3082\u306e\u304c\u518d\u3073\u751f\u304d\u8fd4\u308b\u3002"}
{"translation": "\u5931\u3046\u7d4c\u9a13\u306f\u307e\u308b\u3067\u5f62\u6210\u578b\u306e\u3088\u3046\u306b\u632f\u308b\u821e\u3044\u3001\u60b2\u3057\u307f\u308b\u3082\u306e\u304c\u4f55\u306a\u306e\u304b\u305d\u306e\u8f2a\u90ed\u3092\u6d6e\u304b\u3073\u4e0a\u304c\u3089\u305b\u307e\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u73cd\u3057\u304f\u306a\u3044\u3053\u3068\u306b\u305d\u308c\u306f\u54c0\u60bc\u5149\u7dda\u4e0b\u3067\u6b32\u671b\u5bfe\u8c61\u3078\u5909\u5316\u3057\u307e\u3059\u3002"}
{"translation": "\u3042\u308b\u30cf\u30a4\u30c7\u30eb\u30d9\u30eb\u30b0\u5927\u5b66\u52d5\u7269\u5b66\u6559\u6388\u304c\u65b0Brehm\u56f3\u66f8\u99281\u518a\u76ee\u524d\u66f8\u304d\u4e2d\u8a00\u3044\u307e\u3059\u3002"}
{"translation": "\u300c\u897f\u6d0b\u4eba\u9593\u7684\u8352\u5510\u540d\u3070\u304b\u308a\u624b\u89e6\u308c\u53d6\u308c\u307e\u305b\u3093\u6027\u8cea\u306b\u5c5e\u3059\u308b\u3089\u3057\u3044\u3053\u3068\u5b9f\u969b\u5931\u3063\u305f\u4fa1\u5024\u4ee5\u4e0a\u6301\u7d9a\u4e2d\u4fa1\u5024\u8a55\u4fa1\u3059\u308b\u3053\u3068\u51e1\u305d\u30ab\u30f3\u30ac\u30eb\u30fc\u72fc\u304b\u3089\u59cb\u307e\u3063\u3066\u559c\u6012\u65b9\u6cd5\u8aac\u660e\u3055\u308c\u3066\u3044\u307e\u3059\u300d"}
{"translation": "\u6b7b\u3068\u305d\u308c\u306b\u4f34\u3046\u7a81\u7136\u306e\u4eba\u9593\u306e\u4e0d\u5728\u3068\u907a\u54c1\u3001\u6b7b\u4f53\u304b\u3089\u4e3b\u306a\u304d\u6240\u6709\u7269\u307e\u3067\u3069\u3046\u5bfe\u51e6\u3059\u308b\u304b\u3068\u3044\u3046\u554f\u984c\u304c\u6642\u9593\u3068\u5171\u306b\u56de\u7b54\u3092\u6c42\u3081\u3001\u884c\u52d5\u3092\u5f15\u304d\u8d77\u3053\u3057\u3001\u305d\u306e\u610f\u5473\u304c\u305f\u3060\u5358\u306b\u305d\u306e\u76ee\u7684\u3092\u8d8a\u3048\u3066\u79c1\u305f\u3061\u306e\u521d\u671f\u306e\u7956\u5148\u3092\u52d5\u7269\u7684\u306a\u9818\u57df\u304b\u3089\u4eba\u9593\u7684\u306a\u9818\u57df\u3078\u9032\u3080\u3088\u3046\u4fc3\u3057\u305f\u3053\u3068\u306f\u7591\u3044\u3088\u3046\u3082\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u540c\u7a2e\u65cf\u306e\u4ef2\u9593\u305f\u3061\u306e\u907a\u4f53\u3092\u5358\u306b\u81ea\u7136\u306a\u5206\u89e3\u904e\u7a0b\u306b\u4efb\u305b\u308b\u306e\u3067\u306f\u306a\u304f\u3001\u3053\u306e\u3088\u3046\u306f\u884c\u70ba\u306f\u4e00\u822c\u7684\u306b\u4eba\u9593\u7279\u6709\u3067\u3042\u308b\u3068\u3055\u308c\u307e\u3059\u304c\u3001\u4ed6\u306e\u9ad8\u5ea6\u306a\u52d5\u7269\u3067\u3082\u540c\u69d8\uc758\u884c\u52d5\u304c\u89b3\u5bdf\u3055\u308c\u3066\u3044\u307e\u3059\uff1a"}
{"translation": "\u4f8b\u3048\u3070\u8c61\u306f\u7fa4\u308c\u5185\u3067\u6b7b\u3093\u3060\u30e1\u30f3\u30d0\u30fc\u5468\u308a\u96c6\u307e\u308a\u307e\u3059\u3002"}
{"translation": "\u3057\u3070\u3089\u304f\u9f3b\u6369\u308c\u304b\u3051\u3066\u89e6\u308a\u3064\u3064\u8352\u3005\u3057\u304f\u9cf4\u304d\u7d9a\u3051\u307e\u3059, \u6642\u6298\u7121\u751f\u6c17\u91c7\u3063\u305f\u8089\u4f53 \u3092\u5fa9\u6d3b\u3055\u305b\u308b\u8a66\u307f\u307e\u3057\u305f\u5f8c, \u6700\u5f8c\u3084\u3063\u3071\u308a\u571f\u3084\u679d\u3067\u80f4\u3089\u308c\u308b\u3002"}
{"translation": "` \u307e\u305f\u5f7c\u3089\u901a\u5e38\u6570\u5e74\u5f8c\u3082\u4ed8\u8fd1\u63a2\u3057\u8a2a\u308c\u308b, \u305d\u308c\u9700\u8981\u826f\u3044\u8a18\u61b6\u529b\u305d\u3057\u3066\u4e9b\u3058\u308f\u3054\u8a71\u3057\u8003\u5bdf\u4e0a\u8ff0\u5b9c\u3057\u601d\u3048\u3070\u7686\u7b49\u5909\u5bb9\u7f8e\u5999\u3067\u691c\u8a3c\u3067\u304d\u306a\u3044\u5e7b\u60f3\u7684\u8868\u8c61\u3002"}
{"translation": "\u3053\u306e\u672c\u3001\u305d\u3057\u3066\u305d\u3053\u306b\u767b\u5834\u3059\u308b\u591a\u9762\u7684\u306a\u5206\u89e3\u3084\u7834\u58ca\u306e\u73fe\u8c61\u304c\u5927\u304d\u306a\u5f79\u5272\u3092\u679c\u305f\u3059\u3068\u3044\u3046\u4ed5\u4e8b\u306b\u7d42\u308f\u308a\u304c\u8fd1\u3065\u3044\u3066\u521d\u3081\u3066\u3001\u79c1\u306f\u305d\u308c\u304c\u6b7b\u3068\u5411\u304d\u5408\u3046\u6570\u3048\u5207\u308c\u306a\u3044\u65b9\u6cd5\u306e\u4e00\u3064\u3060\u3051\u3067\u3042\u308a\u3001\u305d\u308c\u81ea\u4f53\u306f\u57fa\u672c\u7684\u306b\u4e0d\u5668\u7528\u3067\u3082\u7121\u95a2\u5fc3\u3067\u3082\u306a\u304f\u3001\u30d8\u30ed\u30c9\u30c8\u30b9\u304c\u8a3c\u8a00\u3057\u305f\u30ab\u30e9\u30c6\u30a3\u30a2\u4eba\u306e\u7fd2\u6163\uff08\u5f7c\u3089\u306f\u5148\u7956\u3092\u98df\u3079\u308b\u50be\u5411\u304c\u3042\u308a\u307e\u3057\u305f\uff09\u3068\u540c\u3058\u3067\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u30ae\u30ea\u30b7\u30e3\u4eba\u304c\u706b\u846c\u3059\u308b\u3068\u3044\u3046\u98a8\u4fd7\u306b\u6050\u6016\u7d20\u5730\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u6b7b\u3092\u5e38\u306b\u5ff5\u982d\u306b\u7f6e\u304f\u8005\u304b\u3001\u305d\u308c\u3068\u3082\u6b7b\u3092\u8ffd\u3044\u51fa\u3059\u3053\u3068\u306b\u6210\u529f\u3059\u308b\u8005\u304b\u3069\u3061\u3089\u306e\u65b9\u304c\u751f\u547d\u529b\u5f37\u3044\u304b\uff1f"}
{"translation": "\u5143\u3005\u3059\u3079\u3066\u7269\u4e8b\u306f\u7d42\u7109\u3057\u3066\u3057\u307e\u3046\u3053\u3068\u3088\u308a\u3080\u3057\u308d\u4f55\u3082\u7d42\u308f\u308a\u65b9\u3057\u306a\u3044\u3067\u3042\u308d\u3046\u53ef\u80fd\u6027\uff1a\u3060\u308c\u3082\u6b63\u78ba\u306a\u898b\u89e3\u3092\u6301\u3063\u3066\u304a\u3089\u305a\u3053\u308c\u4ee5\u4e0a\u8b70\u8ad6\u3055\u308c\u308b\u554f\u984c\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u3082\u3061\u308d\u3093\u3001\u305d\u308c\u4ee5\u524d\u306b\u3082\u79c1\u306f\u4ed6\u306e\u6ce8\u76ee\u3059\u3079\u304d\u5893\u5730\u3092\u8a2a\u308c\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u4f8b\u3048\u3070\u3001\u30f4\u30a7\u30cd\u30c1\u30a2\u306e\u30e9\u30b0\u30fc\u30f3\u306e\u9752\u7dd1\u8272\u306e\u6c34\u304b\u3089\u9ad8\u304f\u8d64\u30ec\u30f3\u30ac\u9020\u308a\u306e\u58c1\u3067\u7acb\u3061\u4e0a\u304c\u308b\u3001\u307e\u308b\u3067\u8981\u585e\u306e\u3088\u3046\u306a\u30b5\u30f3\u30fb\u30df\u30b1\u30fc\u30ec\u5cf6\u7684\u5f7c\u5cb8\u3002"}
{"translation": "\u307e\u305f\u306f\u6bce\u5e74\u30e1\u30ad\u30b7\u30b3\u4eba\u305f\u3061\u304c\u795d\u3046\u30c0\u30a4\u30a2\u30c7\u30ed\u30b9\u30e0\u30a8\u30eb\u30c8\u30b9\uff08\u6b7b\u8005\u306e\u65e5\uff09\u306b\u30aa\u30ec\u30f3\u30b8\u8272\u3068\u9ec4\u8272\u3067\u98fe\u3089\u308c\u305f\u5893\u3068\u3001\u8150\u6557\u304c\u9032\u3093\u3060\u7d50\u679c\u6c38\u9060\u306b\u7b11\u9854\u3092\u6d6e\u304b\u3079\u308b\u3053\u3068\u304c\u547d\u3058\u3089\u308c\u3066\u3044\u308b\u30ab\u30e9\u30d5\u30eb\u306a\u7802\u7cd6\u3084\u30d1\u30d4\u30a8\u30de\u30b7\u30a7\u88fd\u306e\u30c9\u30af\u30ed\u3068\u5171\u306b\u8cd1\u308f\u3046\u3001\u30cf\u30ea\u30a6\u30c3\u30c9\u30d5\u30a9\u30fc\u30a8\u30d0\u30fc\u30bb\u30e1\u30bf\u30ea\u30fc\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u305d\u306e\u4e2d\u3067\u3082\u79c1\u3092\u6700\u3082\u611f\u52d5\u3055\u305b\u305f\u306e\u306f\u3042\u308b\u6f01\u6751\u539f\u578b\u4fdd\u6301\u7684\u306a\u5893\u5730\u3067\u3057\u305f\u3002"}
{"translation": "\u6570\u5e74\u524d\u306e\u3042\u308b8\u6708\u306e\u65e5\u306b\u3001\u79c1\u306f\u5317\u90e8\u306e\u3042\u308b\u8857\u3092\u8a2a\u308c\u307e\u3057\u305f\u3002"}
{"translation": "\u3053\u306e\u8857\u306f\u524d\u3005\u304b\u3089\u5b58\u5728\u3057\u305f\u6c37\u6cb3\u671f\u304b\u3089\u9060\u304f\u307e\u3067\u5185\u9678\u306b\u5e83\u304c\u308b\u6d77\u5ce1\u306e\u6700\u5f8c\u65b9\u306b\u4f4d\u7f6e\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u6c7d\u6c34\u3067\u306f\u6625\u306b\u306f\u30cb\u30b7\u30f3\u3001\u590f\u306b\u306f\u30a6\u30ca\u30ae\u3001\u79cb\u306b\u30c0\u30e9\u304c\u3001\u51ac\u306f\u30b3\u30a4\u3084\u30d1\u30a4\u30af\u3084\u30d6\u30ea\u30fc\u30e0\u304c\u898b\u3064\u304b\u308a\u306a\u3055\u3044\u3002"}
{"translation": "\u3060\u304b\u3089\u3053\u305d\u3001\u6f01\u696d\u3068\u3044\u3046\u8077\u696d\u306f\u73fe\u5728\u3067\u3082\u884c\u308f\u308c\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u3089\u306e\u7537\u305f\u3061\u306f\u5f7c\u3089\u306e\u5bb6\u65cf\u3068\u5171\u306b\u4f55\u4e16\u7d00\u3082\u7f8e\u3057\u3044\u5730\u533a\u3092\u4f4f\u3093\u3067\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u308c\u7531\u6765\u3057\u3066\u66f2\u77f3\u9020\u308a\u9053\u8def2\u672c\u3068\u91e3\u7db2\u7528\u4e7e\u7269\u7f6e\u6240\u304b\u3089\u6210\u308a\u7acb\u3063\u3066\u307e\u3059"}
{"translation": "\u76f4\u3050\u8fd1\u304f\u3067\u306f\u4fee\u9053\u9662\u65bd\u8a2d\u4e00\u3064\u5229\u7528\u3055\u308c\u79c1\u3057\u304c\u53e4\u3081\u304b\u3057\u3044\u8cb4\u65cf\u6ca1\u843d\u6c17\u5473\u306a\u5b8c\u5168\u4e16\u5f93\u59c9\u59b9\uff12\u4eba\u3057\u304b\u5165\u5c45\u8005\u3042\u308a\u307e\u305b\u3093\u6050\u308d\u3057\u3044\u8a00\u3063\u3066\u826f\u3044\u3067\u3059\u3061\u3087\u3046\u3069\u975e\u5e38\u6642\u52e2\u5916\u308c\u3066\u898b\u3048\u3075\u3055\u308f\u3057\u304d\u5834\u6240\u3067\u542b\u307f\u5149\u666f\u6700\u5927\u9650\u7518\u7f8e\u904e\u53bb\u5b9f\u5b58\u601d\u7d22\u5fc3\u8e8d\u308d\u3046\u60c5\u52d5\u6728\u3059\u308b\u3059\u304d\u9593\u7406\u5c48\u51fa\u5ead\u6728\u6b69\u884c\u9014\u4e2d\u899a\u609f\u5feb\u611f\u5074\u9762\u66f4\u751f\u5834\u30ed\u30fc\u682a\u6728\u30e2\u30eb\u3063\u9c08\u808c\u58c1\u5efa\u6750\u4ed6\u770b\u677f\u6249\u305d\u306e\u80cc\u5f8c\u505c\u6cca\u8239\u8266\u306a\u3069\u5168\u4f53\u8a18\u5ff5\u7891\u4e26\u3079\u88fd\u54c1\u5168\u7136\u4f55\u3082\u4f34\u3044\u306a\u3051\u308c\u3070\u5be7\u308d\u9006\u304b\u3048\u3063\u751f\u3051\u8005\u713c\u571f\u5374\u4e0b\u628a\u63e1\u6b8b\u308b\u6700\u826f\u306e\u304a\u5893\u3055\u3066\u8ab0\u5831\u544a\u5730\u5143\u6f01\u5e2b\u8857\u533a\u9053\u8def\u4e2d\u5fc3\u4f4d\u7f6e\u4e0a\u53ea\u3005\u5185\u9678\u6bb5\u968e\u898b\u7acb\u6240\u5171\u6709\u58b3\u5834\u767a\u898b\u3057\u307e\u3057\u305f\u4e16\u8a55\u82e5\u677e\u5e83\u5927\u5e38\u7dd1\u679d\u8c4a\u306b\u304f\u3044\u304f\u8986\u308f\u308c\u30eb\u3065\u305f\u30fc\u30eb\u3092\u51fa\u307e\u305b\u3093"}
{"translation": "\u4ed6\u6240\u4e9b\u305f\u6c5a\u6fc1\u5e02\u96c6\u4f1a\u5834\u5f15\u63db\u73fe\u91d1\u5546\u53d6\u5f15\u5185\u5bb9\u3059\u5f7c\u7b49\u7720\u308a\u5b58\u5728\u5206\u539a\u3044\u6587\u5b57\u7248\u8aad\u3081\u308b\u69d8\u898b\u5f53\u81ea\u4fe1\u9069\u5207\u8868\u73fe\u3042\u308a\u307e\u305f\u6c7a\u884c\u7d0d\u5f97\u793c\u5f0f\u596e\u8d77\u3057\u3066\u8ff0\u6765\u5b9f\u529b\u50ac\u9001\u4e00\u90e8\u5bb6\u5c4b\u7a7a\u9593\u5916\u8996\u70b9\u57cb\u846c\u5b50\u606f\u9732\u5730\u540c\u6642\u30d4\u30af\u30cb\u30c3\u30af\u7269\u54c1\u88fd\u9020\u8caf\u8535\u8a2d\u55b6\u623b\u77f3\u50cf\u5c0f\u5c4b\u5f8c\u304b\u3089\u6b21\u7b2c\u800c\u4e5f\u6238\u53e3\u7d42\u7109\u5012\u932f\u4eba\u683c\u753b\u5fc5\u6b7b\u8db3\u53d6\u308a\u5341\u5206\u8003\u5bdf\u5f85\u305f\u3060\u6614\u4e8b\u60c5\u901a\u76f8\u95a2\u95a2\u4fc2\u65ad\u7247\u601d\u56de\u7406\u89e3\u529b\u7406\u585e\u304c\u3089\u3042\u4f55\u51e6\u5c11\u6570\u5023\u5411\u5357\u56fd\u81ea\u6cbb\u570f\u8cc7\u6e90\u3092\u57a3\u9593\u307f\u898b\u308b\u3068\u3053\u3002"}
