{"translation": "\u65e5\u306e\u51fa\u524d\u306b\u96f2\u306e\u623f\u304c\u9ed2\u304f\u71c3\u3048\u3001\u53e4\u304f\u9306\u3073\u305f\u30b7\u30eb\u30a8\u30c3\u30c8\u306e\u6f02\u6d41\u7269\u3067\u5730\u5e73\u7dda\u304c\u6563\u3089\u3070\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u5f7c\u3089\u306f\u3072\u3068\u308a\u304d\u308a\u3060\u3063\u305f\u3002"}
{"translation": "\u30b1\u30e0\u30c8\u30ec\u30a4\u30eb\u3001\u3068\u8fb2\u592b\u306f\u30a2\u30ec\u30c3\u30af\u306b\u5411\u304b\u3063\u3066\u305d\u306e\u6563\u6b69\u306e\u521d\u3081\u306b\u8a00\u3063\u305f\u3002"}
{"translation": "\u305d\u308c\u4ee5\u5916\u3067\u306f\u3001\u5f7c\u306f\u6c88\u9ed9\u3057\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "50\u30d5\u30a3\u30fc\u30c8\u5148\u3001\u7551\u306f\u65b0\u9bae\u306b\u8015\u3055\u308c\u305f\u8336\u8272\u3044\u571f\u5730\u306b\u5909\u308f\u308a\u3001\u51f8\u51f9\u306e\u571f\u5730\u306e\u81f3\u308b\u6240\u3067\u584a\u304c\u5f62\u6210\u3055\u308c\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u767d\u3063\u307d\u3044\u5ca9\u304c\u56db\u65b9\u516b\u65b9\u306b\u6563\u4e71\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u306e\u5834\u6240\u3067\u306e\u4e00\u6b69\u4e00\u6b69\u306f\u3001\u524d\u56de\u3068\u540c\u69d8\u306b\u6ce5\u3060\u3089\u3051\u3067\u6e7f\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3055\u3089\u306b\u5411\u3053\u3046\u5074\u3067\u306f\u3001\u7d30\u3044\u91d1\u5c5e\u88fd\u306e\u67f5\u304c\u571f\u5730\u306e\u7aef\u3092\u793a\u3057\u3066\u304a\u308a\u3001\u7f8a\u305f\u3061\u304c\u304b\u3064\u3066\u7a81\u7834\u3057\u3088\u3046\u3068\u8a66\u307f\u305f\u7b87\u6240\u3067\u306f\u30a6\u30fc\u30eb\u306e\u56fa\u307e\u308a\u304c\u30d5\u30a7\u30a2\u30ea\u30fc\u30e9\u30a4\u30c8\u306e\u3088\u3046\u306b\u30ef\u30a4\u30e4\u30fc\u3092\u98fe\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\u306f\u3082\u3046\u4e00\u5339\u306e\u30cf\u30a8\u3092\u9854\u304b\u3089\u8ffd\u3044\u6255\u3063\u305f\u3002"}
{"translation": "\u300c\u3044\u3084\u3001\u8fb2\u592b\u306f\u8a00\u3063\u305f\u3001\u79c1\u306f\u83dc\u98df\u4e3b\u7fa9\u8005\u3060\u300d"}
{"translation": "\u300c\u672c\u5f53\u306b\uff1f\u59bb\u304c\u6570\u5e74\u524d\u306b\u305d\u308c\u3092\u8a66\u3057\u305f\u3053\u3068\u304c\u3042\u308b\u3093\u3060\u304c\u3001\u3001\u300d"}
{"translation": "\u300c\u3044\u3084\u300d\u3068\u8fb2\u592b\u306f\u8a00\u3044\u3001\u4f1a\u8a71\u306f\u9014\u5207\u308c\u305f\u3002"}
{"translation": "\u4e16\u754c\u306f\u307e\u3060\u6697\u95c7\u306e\u307e\u307e\u3067\u3001\u307b\u3093\u306e\u5c11\u3057\u3067\u3057\u304b\u306a\u304b\u3063\u305f\u3051\u3069\u3002"}
{"translation": "\u592a\u967d\u304c\u307b\u3068\u3093\u3069\u59ff\u3092\u73fe\u3057\u3066\u304d\u3066\u307e\u3057\u305f\u3002"}
{"translation": "\u65b0\u3057\u3044\u4e00\u65e5\u304c\u59cb\u307e\u308d\u3046\u3068\u3059\u308b\u77ac\u9593\u3060\u3063\u305f\u3002"}
{"translation": "\u5f7c\u3089\u306f\u5bb6\u65cf\u3068\u4e00\u7dd2\u306b\u4f4f\u3080\u305f\u3081\u306b\u5f15\u3063\u8d8a\u3057\u3092\u3059\u308b\u4e88\u5b9a\u306a\u306e\u3060\u3068\u5f7c\u5973\u304c\u8a00\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u79c1\u3001\u30a2\u30ec\u30c3\u30af\u304c\u90fd\u5e02\u3067\u4f55\u5ea6\u304b\u5f7c\u3089\u3092\u898b\u304b\u3051\u305f\u3053\u3068\u304c\u3042\u308b\u3093\u3060\u3002"}
{"translation": "\u307b\u3068\u3093\u3069\u6c34\u69fd\u306b\u5230\u7740\u3057\u3066\u3001\u5fae\u7b11\u307f\u306a\u304c\u3089\u3002"}
{"translation": "\u5f7c\u3089\u306f\u3042\u306e\u30ef\u30b4\u30f3\u8eca\u306e\u8eca\u8f2a\u3092\u4f5c\u3063\u305f\u4eba\u305f\u3061\u3060\u3063\u3051\uff1f"}
{"translation": "\u30bd\u30fc\u30bb\u30fc\u30b8\u8089\u3092\u6df7\u305c\u8fbc\u3093\u3060\u3082\u306e\u3002\u3002\u3002"}
{"translation": "\u307e\u3042\u30b7\u30ca\u30e2\u30f3\u30ed\u30fc\u30eb\u307f\u305f\u3044\u306a\u611f\u3058\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u7f8e\u5473\u3057\u304b\u3063\u305f\u3088\u3002"}
{"translation": "\u541b\u3082\u98df\u3079\u3066\u307f\u305f\u3053\u3068\u3042\u308a\u307e\u3059\u304b\uff1f"}
{"translation": "\u30b8\u30fc\u30f3\u304c\u51fa\u3066\u884c\u304f\u3093\u3060\u3001\u8fb2\u592b\u306f\u8a00\u3063\u305f\u3002"}
{"translation": "\u77e5\u3063\u3066\u305f\uff1f \u8ab0\u304c\uff1f \u30b8\u30fc\u30f3\u3055\u3002"}
{"translation": "\u5c0f\u9053\u306e\u5148\u306b\u4f4f\u3093\u3067\u308b\u5973\u6027\u3001\u8fb2\u592b\u306f\u7709\u9593\u306b\u3057\u308f\u3092\u5bc4\u305b\u306a\u304c\u3089\u8a00\u3063\u305f\u3002"}
{"translation": "\u5f7c\u5973\u304c\u51fa\u3066\u884c\u304d\u3001\u5f7c\u5973\u306e\u8fb2\u5834\u3092\u58f2\u308b\u3088\u3046\u3060\u3088\u3002"}
{"translation": "\u3042\u3042\u3001\u30b8\u30fc\u30f3\u304b\u3002"}
{"translation": "\u5f7c\u306e\u58f0\u306f\u9060\u304f\u3078\u6f02\u3063\u3066\u3044\u3063\u305f\u3002"}
{"translation": "\u770b\u677f\u3092\u898b\u304b\u3051\u305f\u304b\u3089\u306a\u3002"}
{"translation": "\u3053\u3053\u3078\u6765\u308b\u9014\u4e2d\u3067\u30a2\u30ec\u30c3\u30af\u306f\u305d\u308c\u3092\u898b\u904e\u3054\u3057\u3066\u3057\u307e\u3063\u3066\u3044\u305f\u3001\u3053\u306e\u8fb2\u5834\u306e\u4e8c\u500d\u3082\u5927\u304d\u306a\u8fb1\u3081\u3068\u5171\u306b\u305d\u306e\u52d5\u7269\u3084\u571f\u5730\u3084\u4eba\u3005\u306f\u305a\u3063\u3068\u826f\u3044\u72b6\u614b\u306b\u3042\u308a\u307e\u3057\u305f\u3051\u308c\u3069\u3082\u5f7c\u81ea\u8eab\u305d\u306e\u540d\u524d\u3092\u77e5\u3089\u306a\u304b\u3063\u305f\u3060\u308d\u3046 \u307b\u3068\u3093\u3069\u77e5\u308a\u5408\u3044\u304c\u3044\u307e\u305b\u3093\u3067\u3057\u305f"}
{"translation": "\u5f7c\u81ea\u8eab\u305d\u306e\u66f4\u306a\u308b\u6307\u6458 \u307e\u3042\u8981\u3059\u308b\u306b \u5f7c\u81ea\u4f53\u5b9b\u3066\u3067\u3082\u3042\u308a\u307e\u3059"}
{"translation": "\u5f7c\u306f\u624b\u3067\u793a\u3057\u305f\u3002"}
{"translation": "\u4e8c\u767e\u30d5\u30a3\u30fc\u30c8\u307b\u3069\u5148\u306b\u3001\u534a\u5206\u307b\u3069\u30b4\u30ed\u30b4\u30ed\u3068\u7a7a\u3063\u307d\u306e\u5927\u304d\u306a\u6c34\u69fd\u304c\u3042\u308b\u3002"}
{"translation": "\u305d\u306e\u534a\u900f\u660e\u306e\u30d7\u30e9\u30b9\u30c1\u30c3\u30af\u306f\u6642\u9593\u3068\u5171\u306b\u6c5a\u308c\u3066\u3044\u305f\u3057\u3001\u6db2\u4f53\u304c\u5185\u90e8\u3092\u6e80\u305f\u3057\u3066\u3044\u305f\u6240\u3092\u898b\u308b\u3068\u5fae\u7b11\u307f\u304c\u5e83\u304c\u3063\u3066\u3044\u305f\u3002"}
{"translation": "\u300c\u305d\u3053\u3089\u8fba\u3067\u898b\u3064\u3051\u305f\u3093\u3060\u3088\u300d"}
{"translation": "\u5f7c\u306e\u9854\u8272\u306f\u843d\u3061\u8fbc\u3093\u3060\u3002"}
{"translation": "\u30a2\u30ec\u30c3\u30af\u306f\u6642\u8a08\u3092\u78ba\u8a8d\u3059\u308b\u3002"}
{"translation": "\u5348\u524d7\u66426\u5206\u3001\u3059\u3050\u306b\u3067\u3082\u65e5\u304c\u6607\u308a\u305d\u3046\u3060\u3063\u305f\u3002"}
{"translation": "\u5ca9\u808c\u3055\u3048\u3056\u3089\u3064\u304f\u9759\u5bc2\u3055\u3048\u8706\u98df\u3046\u3088\u3046\u306a\u30cf\u30a8\u306e\u7fa4\u308c\u3084\u9060\u304f\u304b\u3089\u805e\u3053\u3048\u3066\u304f\u308b\u30b9\u30af\u30e9\u30c3\u30b0\u30ea\u30fc\u305d\u308c\u3089 \u3054\u5b58\u77e5\u304b\u3054\u5b58\u77e5\u304b \u65e9\u671d\u304f\u3060\u3055\u3044"}
{"translation": "\u4e86\u89e3"}
{"translation": "\u30a2\u30ec\u30c3\u30af\u306f\u82e6\u7b11\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u4e00\u6b69\u5f8c\u9000\u3057\u3001\u6e9d\u3092\u98db\u3073\u8d8a\u3048\u308b\u305f\u3081\u306b\u529b\u3092\u8fbc\u3081\u305f\u3002"}
{"translation": "\u3070\u305f\u308a\u3068\u97f3\u3092\u7acb\u3066\u3066\u5f7c\u306f\u7740\u5730\u3057\u3001\u539a\u304f\u30bc\u30e9\u30c1\u30f3\u72b6\u306e\u6ce5\u306e\u4e2d\u306b\u307e\u3063\u3059\u3050\u843d\u3061\u8fbc\u3093\u3060\u3002"}
{"translation": "\u5f7c\u304c\u9ed2\u3044\u30ba\u30dc\u30f3\u3068\u8fb2\u592b\u306e\u30b8\u30fc\u30f3\u30ba\u3092\u6ce5\u3067\u6c5a\u3057\u3066\u3057\u307e\u3063\u305f\u3002"}
{"translation": "\u3082\u3046\u4e00\u4eba\u306e\u7537\u304c\u3042\u304d\u308c\u9854\u3067\u5fae\u7b11\u3093\u3060\u3002"}
{"translation": "\u300c\u6211\u3005\u304c\u4f55\u306b\u306a\u308d\u3046\u3068\u3057\u3066\u3044\u308b\u304b\u3001\u306d\uff1f\u300d"}
{"translation": "\u30a2\u30ec\u30c3\u30af\u306f\u8db3\u9996\u5468\u308a\u306e\u6c5a\u308c\u3092\u6255\u304a\u3046\u3068\u3057\u305f\u3051\u3069\u305d\u3046\u3059\u308b\u3053\u3068\u3067\u6c5a\u308c\u306f\u3055\u3089\u306b\u5e83\u304c\u3063\u3066\u3057\u307e\u3063\u305f\u3060\u3051\u3060\u3002"}
{"translation": "\u624b\u306e\u3072\u3089\u3082\u771f\u3063\u9ed2\u306b\u306a\u3063\u3066\u3057\u307e\u3063\u305f\u3002"}
{"translation": "\u305d\u306e\u9593\u3082\u8fb2\u592b\u306f\u6b69\u304d\u7d9a\u3051\u3066\u3044\u305f\u3002"}
{"translation": "\u30a2\u30ec\u30c3\u30af\u306f\u6ce5\u3092\u898b\u3064\u3081\u3001\u8fb2\u592b\u306f\u306b\u3063\u3053\u308a\u7b11\u3044\u3001\u6c5a\u308c\u305f\u767d\u3044\u9aed\u306e\u4e0b\u306e\u982c\u306f\u8d64\u304b\u3063\u305f\u3002"}
{"translation": "\u305d\u306e\u539a\u3044\u30ef\u30c3\u30af\u30b9\u30b3\u30fc\u30c8\u3068\u8179\u3068\u58f0\u3067\u3001\u5f7c\u306f\u72c2\u3063\u305f\u30b5\u30f3\u30bf\u30af\u30ed\u30fc\u30b9\u306b\u306a\u308a\u5f97\u305f\u3088\u3046\u3060\u3002"}
{"translation": "\u541b\u304c\u843d\u3061\u308b\u3053\u3068\u306a\u3093\u304b\u7121\u3044\u3088\u3001\u5f7c\u304c\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u5c11\u3057\u6c5a\u308c\u308b\u306e\u3082\u6016\u3044\u308f\u3051\uff1f\u300d\u30cb\u30b3\u30fc\u30eb\u30ba\u8ecd\u66f9\u3055\u307e\u3002"}
{"translation": "\u300c\u3046\u3046\u3093\u300d\u3068\u300c\u3048\u3048\u300d\u3002"}
{"translation": "\u300c\u305f\u3060\u6642\u9593\u3092\u7121\u99c4\u306b\u3057\u3066\u6b32\u3057\u304f\u306a\u304f\u3066\u306d\u3002"}
{"translation": "\u305d\u308c\u304b\u3089\u3053\u306e\u30cf\u30a8\u3055\u300d\u3002"}
{"translation": "\u30a2\u30ec\u30c3\u30af\u306f\u8896\u3092\u6372\u308a\u4e0a\u3052\u3066\u304b\u3089\u30cf\u30a8\u3092\u8ffd\u3044\u6255\u3063\u305f\u2015\u5927\u304d\u304f\u3075\u304f\u3089\u3093\u3060\u59ff\u3067\u3001\u5f7c\u306e\u524d\u8155\u306e\u6bdb\u306e\u4e0a\u306b\u5de3\u98df\u3063\u3066\u3044\u308b\u3002"}
{"translation": "\u300c\u3042\u3093\u305f\u3060\u3063\u3066\u3053\u306e\u5834\u6240\u5168\u4f53\u306b\u98df\u7269\u3055\u300d\u300c\u6b21\u56de\u306f\u96a0\u3057\u305f\u65b9\u304c\u3088\u3055\u305d\u3046\u3060\u306a\u300d\u3068\u8fb2\u592b\u304c\u8a00\u3063\u305f\u3002"}
{"translation": "\u5f7c\u3089\u306f\u3069\u3053\u306b\u3044\u308b\u3093\u3060\uff1f"}
{"translation": "\u30a2\u30ec\u30c3\u30af\u306f\u9707\u3048\u306a\u304c\u3089\u5c0b\u306d\u305f\u3002"}
{"translation": "\u6642\u523b\u306f\u5348\u524d6\u664255\u5206\u3060\u3063\u305f\u3002"}
{"translation": "\u5f7c\u306e\u30b8\u30e3\u30b1\u30c3\u30c8\u306f\u30d1\u30c8\u30ed\u30fc\u30eb\u30ab\u30fc\u306e\u4e2d\u306b\u7f6e\u3044\u3066\u304d\u3066\u3057\u307e\u3063\u305f\u3002"}
{"translation": "\u300c\u3053\u306e\u8fba\u308a\u306b\u7f8a\u306a\u3093\u304b\u3044\u306a\u3044\u3088\u3001\u300d\u3068\u3001\u305d\u306e\u8cea\u554f\u304c\u7121\u8996\u3055\u308c\u3001\u8fb2\u592b\u304c\u8a00\u3063\u305f\u3002"}
{"translation": "\u5f7c\u306f\u571f\u624b\u3092\u98db\u3073\u8d8a\u3048\u3001\u30d6\u30fc\u30c4\u304c\u659c\u9762\u3092\u5c11\u3057\u6ed1\u308a\u843d\u3061\u308b\u611f\u3058\u3067\u3042\u308b\u3002"}
{"translation": "\u300c\u4e00\u822c\u7684\u306b\u679d\u672c\u8a9e\u3088\u3046\u306b\u3053\u3053\u3078\u5927\u52e2\u3084\u3063\u3066\u304f\u308b\u3082\u306e\u3055\u3002\u300d"}
{"translation": "\u305d\u3057\u3066\u4eca\u3001\u5f7c\u3089\u306e\u305f\u3044\u307e\u3064\u304c\u9280\u884c\u306e\u7aef\u3092\u7167\u3089\u3057\u51fa\u3057\u307e\u3057\u305f\u3001\u6d45\u3044\u5c0f\u5ddd\u306e\u9802\u70b9\u306e\u3059\u3050\u524d\u3067\u3001\u305d\u308c\u306f\u8fb2\u592b\u306e\u518d\u751f\u3057\u305f\u6e7f\u5730\u3092\u5207\u308a\u901a\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u305d\u306e\u6ce5\u6cbc\u5730\u3068\u305d\u306e\u5468\u56f2\u3067\u306f\u3001\u8466\u306f\u30d5\u30e9\u30a4\u3068\u30b3\u30aa\u30ed\u30ae\u3068\u30db\u30aa\u30b8\u30ed\u3067\u6b4c\u3063\u3066\u3044\u307e\u3057\u305f\u3002"}
