{"translation": "\u300c\u3046\u305d\u3092\u3064\u3044\u3066\u3044\u308b\uff01\u300d\u3068\u3001\u79c1\u306f\u5fc3\u306e\u4e2d\u3067\u601d\u3063\u305f\u3002"}
{"translation": "\u30d5\u30fc\u30d7\u578b\u306e\u30a4\u30e4\u30ea\u30f3\u30b0\u3068\u5c0f\u6307\u306b\u306f\u3081\u305f\u6307\u8f2a\u304c\u3001\u300c\u4e00\u584a\u306e\u30d1\u30f3\u306e\u305f\u3081\u306b\u300d\u3068\u3044\u3046\u624b\u7d19\u3068\u306f\u76f8\u5bb9\u308c\u306a\u304b\u3063\u305f\u3057\u3001\u30ab\u30de\u30b7\u30a8\u30d5\u304c\u66c7\u308a\u7a7a\u3060\u3063\u305f\u9854\u306b\u5fae\u304b\u306a\u96f2\u304c\u901a\u308a\u904e\u304e\u308b\u77ac\u9593\u3092\u7d4c\u9a13\u8005\u306e\u76ee\u3067\u6349\u3048\u3066\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u3089\u96f2\u3092\u898b\u308b\u3053\u3068\u306f\u3001\u3054\u304f\u7a00\u306b\u3057\u304b\u4eba\u304c\u5618\u3092\u3064\u304f\u5834\u9762\u3067\u3057\u304b\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u300c\u3042\u306a\u305f\u306e\u8a71\u306e\u7b4b\u66f8\u304d\u306f\u4f55\u3067\u3059\u304b\uff1f\u300d\u79c1\u306f\u5c0b\u306d\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u7b4b\u66f8\u304d\u3002\u3002\u3002"}
{"translation": "\u3069\u3046\u8a00\u3063\u3066\u8aac\u660e\u3059\u308c\u3070\u3088\u3044\u3067\u3057\u3087\u3046\u304b\u306d\uff1f"}
{"translation": "\u65b0\u898f\u6027\u3053\u308c\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u611b\u60c5\u3084\u6bba\u4eba\u2015\u304a\u8aad\u307f\u304f\u3060\u3055\u3044\u307e\u3057\u3001\u3054\u89a7\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u300c\u88c1\u5224\u5b98\u65e5\u8a18\u300d\u304b\u3089\u629c\u7c8b\u3067\u3059\u300d\u3068\u5f7c\u306f\u8a00\u3044\u307e\u3057\u305f\u3002"}
{"translation": "\u30ab\u30e0\u30a4\u30b7\u30a7\u30d5\u306f\u3001\u5f7c\u306e\u512a\u3057\u3044\u76ee\u3092\u79c1\u306b\u5411\u3051\u3066\u9759\u304b\u306b\u7b11\u3063\u305f\u3002"}
{"translation": "\u9762\u5012\u306a\u52e4\u52d9\u3001\u50cd\u304d\u7d9a\u3051\u3066\u3001\u632f\u308a\u304b\u3056\u3057\u3066\u624b\u3092\u653e\u308b\u3002"}
{"translation": "\u79c1\u306b\u306f\u3082\u3046\u4f55\u3082\u3059\u308b\u3053\u3068\u304c\u306a\u304f\u3001\u307b\u3068\u3093\u3069\u4f55\u3082\u98df\u3079\u3089\u308c\u307e\u305b\u3093\u3002"}
{"translation": "\u305d\u3057\u3066\u3042\u306a\u305f\u304c\u8cde\u8cdb\u3092\u904e\u304e\u53bb\u3063\u3066\u79c1\u306e\u7269\u8a9e\u3092\u5370\u5237\u3059\u308b\u306a\u3089\u3070\u3001\u3042\u306a\u305f\u306f\u79c1\u306b\u501f\u308a\u3088\u308a\u5927\u304d\u3044\u3053\u3068\u3092\u3057\u307e\u3059\u3002"}
{"translation": "\u3042\u306a\u305f\u306f\u79c1\u3092\u52a9\u3051\u307e\u3059\u3002"}
{"translation": "\u65b0\u805e\u306f\u6148\u5584\u56e3\u4f53\u3067\u306f\u306a\u3044\u3057\u3001\u5947\u5999\u3067\u89aa\u5207\u5bb6\u3067\u3059\u3002"}
{"translation": "\u79c1\u306f\u305d\u308c\u3092\u77e5\u3063\u3066\u3044\u307e\u3059\u304c\u2026"}
{"translation": "\u3069\u3046\u304b\u89aa\u5207\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u300c\u5927\u5909\u6709\u96e3\u3046\u3054\u3056\u3044\u307e\u3059\u3002"}
{"translation": "\u4f55\u304b\u304a\u624b\u4f1d\u3044\u51fa\u6765\u308b\u4e8b\u304c\u3042\u308c\u3070\u4f55\u3067\u3082\u8a00\u3063\u3066\u4e0b\u3055\u3044\u300d\u30b9\u30bf\u30fc\u30c8\u3092\u5207\u3063\u305f\u3070\u304b\u308a\u306e\u6751\u3005\u3078\u884c\u304d\u305f\u3044\u3068\u5e0c\u671b\u3059\u308b\u4eba\u7269\u306f\u5e8a\u3092\u8996\u7dda\u306b\u843d\u3068\u3057\u3001\u54c0\u9858\u3081\u3044\u305f\u77b3\u3067\u8a34\u3048\u306a\u304c\u3089\u8a71\u3057\u7d9a\u3051\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u79c1\u306f\u5c0f\u3055\u306a\u7269\u8a9e\u3092\u6301\u3063\u3066\u304d\u307e\u3057\u305f\u3002"}
{"translation": "\u305d\u308c\u3092\u3042\u306a\u305f\u306e\u65b0\u805e\u3067\u63b2\u8f09\u3057\u305f\u3044\u306e\u3067\u3059\u3002"}
{"translation": "\u7387\u76f4\u306b\u7533\u3057\u4e0a\u3052\u307e\u3059\u3001\u7de8\u96c6\u8005\u69d8: \u79c1\u304c\u3053\u306e\u7269\u8a9e\u3092\u66f8\u3044\u305f\u306e\u306f\u4f5c\u5bb6\u3068\u3057\u3066\u540d\u58f0\u3092\u535a\u3059\u76ee\u7684\u3084\u7518\u7f8e\u306a\u8cdb\u8f9e\u6b32\u3057\u3055\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u305d\u3046\u3044\u3046\u7d20\u6674\u3089\u3057\u3044\u3082\u306e\u306b\u4ed8\u968f\u3057\u3066\u304f\u308b\u559c\u3073\u306f\u307c\u304f\u306b\u306f\u3082\u3046\u6b73\u904e\u304e\u3066\u3044\u307e\u3059\u3088\u3002"}
{"translation": "\u5358\u7d14\u306a\u5546\u696d\u7684\u52d5\u6a5f\u304b\u3089\u4f5c\u5bb6\u30c7\u30d3\u30e5\u30fc\u3059\u308b\u3053\u3068\u306b\u6c7a\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u3064\u307e\u308a\u3001\u5132\u3051\u3088\u3046\u3068\u601d\u3063\u305f\u3060\u3051\u3067\u3059\u3002"}
{"translation": "\u4eca\u79c1\u306f\u7279\u5225\u4f55\u3082\u3057\u306a\u304f\u3066\u7d50\u69cb\u3067\u3059\u30d5\u30ea\u30fc\u30e9\u30f3\u30b9\u540c\u7136\u3060\u304b\u3089\u3055\u3002"}
{"translation": "S\u5730\u533a\u88c1\u5224\u6240\u3067\u635c\u67fb\u5b98\u3060\u3063\u305f\u4e8b\u3082\u3042\u308a\u307e\u3059\u30015\u5e74\u4ee5\u4e0a\u52d9\u3081\u3066\u304d\u3066\u304b\u3089\u3059\u3063\u304b\u308a\u3042\u3061\u3053\u3061\u30d6\u30e9\u30d6\u30e9\u3057\u3066\u8997\u304d\u898b\u3055\u3093\u307f\u305f\u3044\u3067\u3064\u307e\u3089\u306a\u304b\u3063\u305f\u95a2\u5fc3\u3054\u7528\u610f\u597d\u5947\u5fc3\u65fa\u76db\u3067\u3059\u304c\u3001\u544a\u767d\u3057\u307e\u3059\u3068\u4e00\u92ad\u3082\u5bcc\u3092\u5897\u3084\u3059\u4e8b\u306a\u304f\u3001\u624b\u4ed8\u304b\u305a\u306e\u7d14\u6f54\u3055\u3092\u4fdd\u3061\u7d9a\u3051\u3089\u308c\u305f\u3060\u3051\u3067\u3057\u305f\u3002\u300d"}
{"translation": "\u300c\u5f7c\u306f\u4e00\u4f53\u3069\u308c\u3060\u3051\u8a71\u3059\u306e\u3060\u308d\u3046\u300d\u3068\u79c1\u306f\u601d\u3044\u306a\u304c\u3089\u3001\u30da\u30f3\u306b\u624b\u3092\u4f38\u3070\u3057\u3001\u6642\u9593\u304c\u306a\u3044\u3053\u3068\u3092\u793a\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\uff08\u305d\u306e\u6642\u671f\u3001\u8a2a\u554f\u5ba2\u306b\u306f\u672c\u5f53\u306b\u3046\u3093\u3056\u308a\u3057\u3066\u3044\u307e\u3057\u305f\uff01\uff09 \u300c\u3042\u306a\u305f\u306e\u8cb4\u91cd\u306a\u6642\u9593\u30921\u5206\u3060\u3051\u9802\u6234\u3057\u307e\u3059\uff01\u300d\u3068\u79c1\u306e\u76f8\u624b\u306f\u8b1d\u7f6a\u3059\u308b\u3088\u3046\u306a\u53e3\u8abf\u3067\u7d9a\u3051\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u3057\u304b\u3057\u307e\u305a\u6700\u521d\u306b\u81ea\u5df1\u7d39\u4ecb\u3055\u305b\u3066\u304f\u3060\u3055\u3044\u3002"}
{"translation": "\u6cd5\u5f8b\u5b66\u58eb\u30a4\u30f4\u30a1\u30f3\u30fb\u30da\u30c8\u30ed\u30f4\u30a3\u30c3\u30c1\u30fb\u30ab\u30fc\u30df\u30b7\u30a7\u30d5\u3067\u3059\u3001\u5143\u6cd5\u52d9\u691c\u67fb\u5b98\u3002"}
{"translation": "\u57f7\u7b46\u8005\u3068\u3057\u3066\u306e\u540d\u8a89\u3092\u3082\u3063\u3066\u3044\u308b\u308f\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u305d\u308c\u3067\u3082\u3042\u304f\u307e\u3067\u4f5c\u5bb6\u3068\u3057\u3066\u306e\u76ee\u7684\u3067\u53c2\u3063\u305f\u6b21\u7b2c\u3067\u3059\u3002"}
{"translation": "40\u6b73\u8fd1\u304f\u306b\u3082\u304b\u304b\u308f\u3089\u305a\u30c7\u30d3\u30e5\u30fc\u3057\u305f\u3044\u3068\u5e0c\u671b\u3059\u308b\u8005\u304c\u3053\u3053\u306b\u304a\u308a\u307e\u3059\u3002"}
{"translation": "\u9045\u3059\u304e\u308b\u3088\u308a\u306f\u826f\u3057\u3001\u6c7a\u3057\u3066\u9045\u3059\u304e\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u304b\u3089\u306d\u300d"}
{"translation": "\u5f7c\u304c\u79c1\u306e\u30aa\u30d5\u30a3\u30b9\u306b\u5165\u3063\u3066\u304d\u305f\u3068\u304d\u3001\u5f7c\u306f\u6df7\u4e71\u3057\u305f\u69d8\u5b50\u3060\u3063\u305f\u3002"}
{"translation": "\u304a\u305d\u3089\u304f\u3001\u79c1\u306e\u3057\u304b\u3081\u3063\u9762\u3068\u4e0d\u6e80\u3052\u306a\u8868\u60c5\u304c\u3001\u5f7c\u306e\u7e4a\u7d30\u3067\u654f\u611f\u306a\u6027\u683c\u3092\u30b7\u30e7\u30c3\u30af\u3055\u305b\u305f\u306e\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u300c\u3069\u3046\u304b\u304a\u8a31\u3057\u304f\u3060\u3055\u3044\uff01\u300d"}
{"translation": "\u5f7c\u306f\u67d4\u3089\u304b\u306a\u3001\u8c4a\u304b\u306a\u30d0\u30ea\u30c8\u30f3\u58f0\u3067\u59cb\u3081\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u6642\u9593\u5916\u306b\u3042\u306a\u305f\u306b\u62bc\u3057\u304b\u3051\u3066\u3057\u307e\u3044\u7533\u3057\u8a33\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u3042\u308f\u305f\u3060\u3057\u305d\u3046\u3067\u3059\u304c\u2026\u2026"}
{"translation": "\u3057\u304b\u3057\u898b\u3066\u3044\u305f\u3060\u3051\u308c\u3070\u308f\u304b\u308a\u307e\u3059\u3001\u7de8\u96c6\u9577\u3055\u3093\uff1a\u660e\u65e5\u3001\u975e\u5e38\u306b\u91cd\u8981\u306a\u4ed5\u4e8b\u3067\u30aa\u30c7\u30c3\u30b5\u3078\u884c\u304f\u4e88\u5b9a\u3067\u3059\u3002"}
{"translation": "\u571f\u66dc\u65e5\u307e\u3067\u3053\u306e\u65c5\u884c\u3092\u5ef6\u671f\u3059\u308b\u3053\u3068\u304c\u53ef\u80fd\u3060\u3063\u305f\u3089\u3001\u78ba\u4fe1\u3057\u3066\u3044\u307e\u3059\u304c\u7279\u4f8b\u3092\u6c42\u3081\u308b\u3053\u3068\u306f\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u79c1\u306f\u898f\u5247\u3092\u5c0a\u91cd\u3057\u307e\u3059\u3001\u305d\u308c\u306f\u79e9\u5e8f\u3092\u611b\u3059\u308b\u304b\u3089\u3067\u3059\u300d"}
{"translation": "\u5f7c\u306e\u6817\u8272\u306e\u9aea\u3068\u3072\u3052\u306f\u30b7\u30eb\u30af\u306e\u3088\u3046\u306b\u6fc3\u304f\u3001\u67d4\u3089\u304b\u3044\u3002"}
{"translation": "\u5fc3\u512a\u3057\u304f\u3001\u7e4a\u7d30\u306a\u300c\u30b7\u30eb\u30af\u300d\u306e\u9b42\u3092\u6301\u3064\u4eba\u3005\u3068\u3055\u308c\u3066\u3044\u308b\u304c\u3001\u305d\u306e\u8a3c\u62e0\u304c\u3053\u306e\u67d4\u3089\u304b\u3044\u9aea\u3060\u3068\u8a00\u308f\u308c\u3066\u3044\u308b\u3002"}
{"translation": "\u72af\u7f6a\u8005\u3084\u9811\u56fa\u3067\u90aa\u60aa\u306a\u6027\u683c\u306e\u4eba\u3005\u306f\u3001\u5927\u534a\u304c\u786c\u3044\u9aea\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u304c\u771f\u5b9f\u304b\u3069\u3046\u304b\u306f\u3001\u8aad\u8005\u81ea\u8eab\u307e\u305f\u5f8c\u65e5\u898b\u6975\u3081\u308b\u3053\u3068\u306b\u306a\u308b\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u5f7c\u306e\u9854\u3064\u304d\u3084\u3072\u3052\u3082\u542b\u3081\u4f55\u3082\u5f7c\u306e\u5927\u304d\u304f\u3066\u91cd\u305f\u3044\u8eab\u4f53\u304b\u3089\u3059\u308b\u52d5\u4f5c\u307b\u3069\u6ed1\u3089\u304b\u3067\u512a\u96c5\u3055\u3092\u611f\u3058\u3055\u305b\u307e\u305b\u3093\u3002"}
{"translation": "\u305d\u306e\u52d5\u304d\u304b\u3089\u306f\u6d17\u7df4\u3055\u308c\u305f\u30a8\u30ec\u30ac\u30f3\u30b9\u3084\u8efd\u5feb\u3055\u3060\u3051\u3067\u306a\u304f\u4e00\u7a2e\u306e\u300c\u5973\u6027\u7684\u300d\u611f\u899a\u3059\u3089\u4f1d\u308f\u3063\u3066\u304d\u307e\u3059\u3002"}
{"translation": "\u300c\u3054\u3081\u3093\u3042\u305d\u3070\u305b\u300d\u3068\u8868\u73fe\u3057\u307e\u3059\u3068\u305d\u306e\u4e2d\u306b\u5c11\u3057\u795e\u7d4c\u8cea\u3055\u3082\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u79c1\u4e3b\u4eba\u516c\u306f\u8e44\u9244\u66f2\u3052\u3084\u30b5\u30fc\u30c7\u30a3\u30f3\u7f36\u63e1\u308a\u3053\u3093\u3067\u3082\u697d\u52dd\u3067\u3059\u4f95\u305d\u308c\u3067\u3082\u5f7c\u304c\u529b\u5f37\u305d\u3046\u306b\u898b\u3048\u306a\u3044\u5168\u52d5\u4f5c\u6700\u4e2d\u3067\u3059\u30c9\u30a2\u30ce\u30d6\u3084\u5e3d\u5b50\u3082\u89e6\u308c\u308b\u3057\u304b\u3070\u3061\u30e5\u3082\u3088\u3046\u6271\u3044\u307e\u3059\uff1a\u89e6\u308c\u306f\u9014\u7aef\u306b\u67d4\u3089\u304b\u3055\u3068\u614e\u91cd\u3055\u3092\u611f\u3058\u307e\u3059\u305d\u306e\u6b69\u97f3\u3082\u9759\u304b\u3067\u3001\u63e1\u624b\u3082\u512a\u3057\u3044\u3067\u3059\u5f7c\u306e\u3053\u3068\u898b\u3066\u3044\u308b\u4e00\u65b9\u3067\u5fd8\u308c\u304c\u3061\u3064\u3088\u304f\u5f37\u305d\u3046\u306a\u8eab\u4f53\u3042\u308a\u30b4\u30ea\u30e4\u30fc\u30ba\u3042\u305d\u3069\u529b\u6301\u3061\u624b\u4e00\u672c\u3060\u3051\uff15\u4eba\u5206\u7de8\u96c6\u9577\u30a2\u30f3\u30c9\u30ec\u30a4\u648b\u5408\u308f\u305b\u306e\u529b\u8d85\u3048\u7269\u6301\u3072\u6c17\u53d6\u308b\u3064\u307e\u308a\u5f7c\u304c\u7e4a\u7d30\u306a\u52d5\u304d\u3068\u8efd\u3084\u304b\u306a\u30b9\u30da\u30d7\u30b5\u30fc\u30fb\u3088\u81ea\u7531\u81ea\u5728\u898b\u4e8b\u306b\u8efd\u3084\u3055\u4ee3\u8868\u3057\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u5f7c\u306e\u5168\u9854\u304b\u3089\u306f\u7d20\u6734\u3055\u3001\u5927\u3089\u304b\u3055\u3001\u8aa0\u5b9f\u3055\u304c\u6ea2\u308c\u3066\u3044\u308b\u3002"}
{"translation": "\u3082\u3057\u3001\u9854\u304c\u9b42\u306e\u93e1\u3067\u3042\u308b\u3068\u3059\u308b\u306a\u3089\u3070\u3001\u305d\u306e\u7d10\u5e2f\u7389\u3092\u6301\u3064\u7537\u6027\u3068\u521d\u3081\u3066\u4f1a\u3063\u305f\u65e5\u306b\u79c1\u306f\u5f7c\u304c\u3046\u305d\u3092\u3064\u304f\u3053\u3068\u306f\u306a\u3044\u3068\u65ad\u8a00\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u305f\u3060\u308d\u3046\u3002"}
{"translation": "\u79c1\u306f\u305d\u308c\u307b\u3069\u307e\u3067\u306b\u8ced\u3051\u3067\u3082\u3057\u3046\u308b\u3060\u308d\u3046\u3002"}
{"translation": "\u8aad\u8005\u306f\u3053\u308c\u304b\u3089\u79c1\u304c\u305d\u306e\u8ced\u3051\u306b\u52dd\u3063\u305f\u304b\u5426\u304b\u3092\u898b\u308b\u3053\u3068\u306b\u306a\u308b\u3060\u308d\u3046\u3002"}
{"translation": "\u5f7c\u306f\u3001\u65e2\u306b\u8ff0\u3079\u305f\u3088\u3046\u306b\u3001\u80cc\u304c\u9ad8\u304f\u80a9\u5e45\u3082\u5e83\u304f\u3001\u4f53\u3064\u304d\u306e\u826f\u3044\u4ed5\u4e8b\u99ac\u306e\u3088\u3046\u3067\u3059\u3002"}
{"translation": "\u5168\u8eab\u304b\u3089\u5065\u5eb7\u3068\u529b\u5f37\u3055\u304c\u6ea2\u308c\u51fa\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u9854\u8272\u306f\u30d4\u30f3\u30af\u3067\u624b\u306f\u5927\u304d\u304f\u3001\u80f8\u677f\u306f\u5e83\u304f\u7b4b\u8089\u8cea\u3067\u3001\u9aea\u306e\u6bdb\u306f\u5065\u5eb7\u306a\u5c11\u5e74\u306e\u3088\u3046\u306b\u6fc3\u539a\u3067\u3059\u3002"}
{"translation": "\u6b73\u306f\u56db\u5341\u524d\u5f8c\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u6d17\u7df4\u3055\u308c\u305f\u30c6\u30a4\u30b9\u30c8\u3068\u6700\u65b0\u306e\u6d41\u884c\u3092\u8ffd\u3063\u3066\u3044\u308b\u65b0\u54c1\u304b\u3064\u6700\u8fd1\u4ed5\u7acb\u3066\u3089\u308c\u305f\u30b7\u30eb\u30af\u88fd\u30b9\u30fc\u30c4\u3092\u8eab\u306b\u7740\u3051\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u80f8\u5143\u3067\u306f\u5927\u304d\u306a\u91d1\u88fd\u30c1\u30a7\u30fc\u30f3\u3068\u30c1\u30e3\u30fc\u30e0\u304c\u63fa\u308c\u52d5\u304d\u3001\u5c0f\u6307\u3067\u306f\u5c0f\u3055\u306a\u660e\u308b\u3044\u661f\u578b\u306e\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u30ea\u30f3\u30b0\u304c\u5149\u3092\u53cd\u5c04\u3057\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u305d\u308c\u4ee5\u4e0a\u306b\u91cd\u8981\u306a\u3053\u3068\u3067\u3042\u308a\u30ed\u30de\u30f3\u3084\u7269\u8a9e\u4e2d\u3067\u3082\u5e38\u8b58\u7684\u306a\u82f1\u96c4\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u5fc5\u8981\u4e0d\u53ef\u6b20\u3060\u3063\u305f\u3053\u3068\uff64\u305d\u308c\u306f\u5f7c\u304c\u975e\u5e38\u306b\u7f8e\u3057\u3044\u3053\u3068\u3067\u3059\uff61"}
{"translation": "\u79c1\u81ea\u8eab\u5973\u6027\u3067\u3082\u753b\u5bb6\u3067\u3082\u3042\u308a\u307e\u305b\u3093\uff61"}
{"translation": "\u7537\u6027\u306e\u7f8e\u3057\u3055\u3092\u5224\u65ad\u3059\u308b\u81ea\u4fe1\u3082\u3042\u307e\u308a\u3042\u308a\u307e\u305b\u3093\uff61"}
{"translation": "\u3057\u304b\u3057\u30ea\u30dc\u30f3\u4ed8\u304d\u7d33\u58eb (\u30b3\u30b5\u30fc\u30b8\u30e5?) \u306e\u5916\u89b3\u306f\u79c1\u306b\u6df1\u3044\u5370\u8c61\u3092\u6b8b\u3057\u307e\u3057\u305f \u3002"}
{"translation": "\u5f7c\u9811\u4e08\u306a\u7b4b\u8089\u8cea\u306e\u9854\u306f\u6c38\u9060\u306b\u79c1\u306e\u8a18\u61b6\u306b\u6b8b\u308b\u3053\u3068\u3067\u3057\u3087\u3046\u3002"}
{"translation": "\u305d\u306e\u9854\u306b\u306f\u3001\u5c0f\u3055\u306a\u9f3b\u3072\u3052\u304c\u3042\u308a\u3001\u8584\u3044\u5507\u3068\u7f8e\u3057\u3044\u30d6\u30eb\u30fc\u30a2\u30a4\u304c\u3042\u308a\u307e\u3059\u3002"}
{"translation": "\u3053\u308c\u3089\u306e\u76ee\u306b\u306f\u512a\u3057\u3055\u3068\u8a00\u8449\u3067\u306f\u3046\u307e\u304f\u8868\u73fe\u3067\u304d\u306a\u3044\u4f55\u304b\u304c\u5149\u308a\u8f1d\u3044\u3066\u3044\u307e\u3059\u3002"}
{"translation": "\u3053\u306e \"\u4f55\u304b\" \u306f\u5c0f\u3055\u306a\u52d5\u7269\u305f\u3061\u3092\u898b\u3064\u3081\u308b\u6642\u3084\u5f7c\u3089\u304c\u82e6\u75db\u3092\u611f\u3058\u3066\u3044\u308b\u6642\u306b\u898b\u3064\u3051\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002"}
{"translation": "\u6c42\u3081\u3066\u3044\u308b\u3060\u308d\u3046\u4f55\u304b\u5b50\u4f9b\u3063\u307d\u304f\u9ed9\u3063\u3066\u8010\u3048\u5fcd\u3093\u3067\u3044\u307e\u3059\uff61"}
{"translation": "\u72e1\u733e\u3067\u975e\u5e38\u306b\u8061\u660e\u306a\u4eba\u3005\u305d\u308c\u3060\u3051\u773c\u5dee\u3057\u5185\u5074\u304b\u3089\u51fa\u305b\u307e\u305b\u3093\uff61"}
{"translation": "\u79c1\u306f\u305f\u3081\u606f\u3092\u3064\u304d\u3001\u30da\u30f3\u3092\u7f6e\u3044\u3066\u3001\u305d\u306e\u30b3\u30ab\u30fc\u30c9\u306e\u5165\u3063\u305f\u7d33\u58eb\u3092\u5f85\u3064\u3053\u3068\u306b\u3057\u307e\u3057\u305f\u3002"}
{"translation": "\u65b0\u9032\u306e\u4f5c\u5bb6\u3084\u7de8\u96c6\u5ba4\u306e\u79d8\u5bc6\u306b\u8a73\u3057\u304f\u306a\u3044\u4eba\u3005\u306f\u3001\u300c\u7de8\u96c6\u5ba4\u300d\u3068\u3044\u3046\u8a00\u8449\u3067\u795e\u8056\u306a\u6050\u308c\u3092\u899a\u3048\u3001\u305d\u308c\u306a\u308a\u306b\u6642\u9593\u3092\u304b\u3051\u3066\u5f85\u305f\u305b\u307e\u3059\u3002"}
{"translation": "\u5f7c\u3089\u306f\u3001\u300c\u304a\u5165\u308a\u304f\u3060\u3055\u3044\u300d\u3068\u3044\u3046\u7de8\u96c6\u8005\u306e\u8a00\u8449\u306e\u5f8c\u3001\u9577\u304f\u54b3\u3092\u3057\u305f\u308a\u3001\u9f3b\u6c34\u3092\u304b\u307f\u306a\u304c\u3089\u3086\u3063\u304f\u308a\u3068\u30c9\u30a2\u3092\u958b\u3051\u3001\u3055\u3089\u306b\u3086\u3063\u304f\u308a\u3068\u4e2d\u306b\u5165\u3063\u3066\u6765\u308b\u3053\u3068\u3067\u591a\u304f\u306e\u6642\u9593\u304c\u6d6a\u8cbb\u3055\u308c\u307e\u3059\u3002"}
{"translation": "\u3057\u304b\u3057\u3001\u305d\u306e\u30b3\u30ab\u30fc\u30c9\u4ed8\u304d\u30cf\u30c3\u30c8\u3055\u3093\u306f\u308f\u3056\u308f\u3056\u81ea\u5206\u9054\u304c\u5f85\u3064\u3088\u3046\u306a\u3053\u3068\u3082\u3042\u308a\u307e\u305b\u3093\u3002"}
{"translation": "\u30a2\u30f3\u30c9\u30ec\u30a4\u3055\u3093\u304b\u3089\u6238\u304c\u9589\u307e\u308b\u524d\u306b\u79c1\u306f\u30aa\u30d5\u30a3\u30b9\u3067\u306f\u80cc\u9ad8\u5e45\u5e83\u3044\u7537\u6027\u304c1\u672c\u624b\u304b\u3089\u675f\u306d\u305f\u7d19\u888b\u3082\u3046\u4e00\u65b9\u624b\u304b\u3089\u5e3d\u5b50\uff08\u30b3\u30ab\u30fc\u30c9\uff09\u3063\u3066\u78ba\u8a8d\u3057\u305f\u4e8b\u3067\u3059\u3053\u306e\u6669\u5e74\u7269\u8a9e\u3067\u6ce8\u76ee\u3059\u3079\u304d\u5f79\u5272\u3059\u308b\u3048\u3089\u308c\u305d\u3046\u3067\u5584\u52aa\u529b\u3057\u3066\u3044\u307e\u3059\u3053\u306e\u3088\u3046\u4eba\u5916\u5074\u5f62\u614b\u63cf\u5199\u3059\u308b\u7d76\u5bfe\u7684\u8981\u6c42\u6027\u3042\u308a\u307e\u3059"}
{"translation": "1880\u5e74\u306e4\u6708\u306e\u3042\u308b\u65e5\u3001\u50d5\u306e\u30aa\u30d5\u30a3\u30b9\u306b\u8b66\u5099\u54e1\u30a2\u30f3\u30c9\u30ec\u30a4\u304c\u5165\u3063\u3066\u304d\u3066\u3001\u65b0\u805e\u7de8\u96c6\u90e8\u306b\u4f55\u304b\u3057\u3089\u306e\u7d33\u58eb\u304c\u8a2a\u306d\u3066\u304d\u3066\u3001\u7de8\u96c6\u9577\u3068\u4f1a\u3046\u3053\u3068\u3092\u5f37\u304f\u6c42\u3081\u3066\u3044\u308b\u3068\u3044\u3046\u3053\u3068\u3092\u30df\u30b9\u30c6\u30ea\u30a2\u30b9\u306a\u69d8\u5b50\u3067\u5831\u544a\u3057\u305f\u3002"}
{"translation": "\u5f7c\u306f\u6050\u3089\u304f\u516c\u52d9\u54e1\u3060\u308d\u3046\u3001\u30b3\u30ab\u30fc\u30c9\uff08\u5236\u670d\u3084\u5e3d\u5b50\u306b\u3064\u3051\u308b\u8a18\u7ae0\uff09\u304c\u3064\u3044\u3066\u3044\u305f\u304b\u3089\u3060\u3001\u3068\u30a2\u30f3\u30c9\u30ec\u30a4\u306f\u4ed8\u3051\u52a0\u3048\u307e\u3057\u305f\u3002"}
{"translation": "\u300c\u4ed6\u306e\u6642\u9593\u306b\u6765\u3066\u3082\u3089\u304a\u3046\u300d\u3068\u79c1\u306f\u8a00\u3063\u305f\u3002"}
{"translation": "\u300c\u4eca\u65e5\u306f\u5fd9\u3057\u3044\u3002"}
{"translation": "\u571f\u66dc\u65e5\u3057\u304b\u53d7\u3051\u4ed8\u3051\u306a\u3044\u3068\u4f1d\u3048\u3066\u304f\u3060\u3055\u3044\u300d"}
{"translation": "\"\u5f7c\u306f\u65e2\u306b3\u56de\u6765\u305f\u3093\u3067\u3059\u3002"}
{"translation": "\u3042\u306a\u305f\u3092\u5c0b\u306d\u307e\u3057\u305f\u3002"}
{"translation": "\u5927\u4e8b\u306a\u7528\u4e8b\u3060\u305d\u3046\u3067\u3059\u3002"}
{"translation": "\u305d\u3057\u3066\u307b\u307c\u6ce3\u304d\u305d\u3046\u3067\u3057\u305f\u2028\u3002"}
{"translation": "\u300c\u571f\u66dc\u65e5\u3067\u306f\u9593\u306b\u5408\u308f\u306a\u3044\u300d\u3068\u5f7c\u306f\u8a00\u3044\u307e\u3059\u2028\u3002"}
{"translation": "\u9762\u4f1a\u3059\u308b\u3088\u3046\u6307\u793a\u3057\u307e\u3059\u304b\uff1f"}
